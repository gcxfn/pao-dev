# pao 本体（pi fork，独立 git 仓库，备份另配）
/PAO/
/desktop/
# 凭证与本地环境（不入库）
.env
.env.*
*.local
# 验收所用隔离认证文件不入库，原始本地证据仍保留。
/.pao/**/auth.json
/.pao/**/私有配置/
# 证据目录大件不入库（本地保留：会话转录、隔离环境副本、安装包与浏览器缓存）
/.pao/**/*.jsonl
/.pao/**/*.zip
/.pao/**/*.tar
/.pao/**/*.exe
/.pao/**/agent/
/.pao/**/bin/
/.pao/**/profile/
# 依赖目录不入库
node_modules/
# 评估用的上游源码快照是本地输入，不随项目版本库复制
/.pao/**/pi-desktop-source/
# Python 运行缓存不属于基准源码或验收报告。
__pycache__/
*.py[cod]
.pytest_cache/
# 本地临时目录与运行缓存（工作产物不入库）
/临时文件夹/
/pip-cache/
/.dsh-acl-recovery/
/.t-fail-*
/.tmp-*
/run-w8-copy-failure-test.py
/发行包回执-默认收起.ps1
# 系统杂物
Thumbs.db
Desktop.ini
