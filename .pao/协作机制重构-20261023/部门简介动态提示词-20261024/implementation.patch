+function deptDescription(entry: DeptCatalogEntry): string {
+	if (!entry.配方存在) return "不可读取（配方缺失或不可读）";
+	const persona = entry.人设?.trim();
+	return persona && !/^<待填(?:[:：>]|$)/.test(persona) ? persona : "未填写";
+}
+
+/** 一个部门在系统提示里的简介,只含选部门所需事实与真实派发状态。 */
+function renderDeptCatalogEntry(entry: DeptCatalogEntry, blockingProblems: readonly string[]): string {
+	const description = deptDescription(entry);
+	const parts = [`${entry.名字}｜职责简介：${description}`];
+	if (entry.标签.length > 0) parts.push(`标签：${entry.标签.join("、")}`);
+	parts.push(
+		blockingProblems.length === 0 ? "派发状态：可派发" : `派发状态：不可派发（${blockingProblems.join("；")}）`,
+	);
+	return `- ${parts.join("｜")}`;
+}
+
+/**
+ * 部门目录 → 主控系统提示片段(纯函数)。
+ *
+ * 只从 catalog 取名称、人设和注册表标签;完整配方、工具、技能、知识库都不进常驻提示。
+ * catalog 的阻止项决定派发状态;缺失/不可读配方与其它阻止项不会被描述成可派发。
+ */
+export function renderDeptCatalogSnapshot(catalog: DeptCatalog, asOf: string): string {
+	const registryFailure = catalog.问题.find(
+		(issue) => issue.级别 === "阻止启动" && issue.类别 === "注册表" && issue.问题.startsWith("部门注册表不可读"),
+	);
+	if (registryFailure) {
+		return [
+			`截至 ${asOf}:部门名单读取失败,不能视为没有已登记部门。`,
+			`原因:${registryFailure.问题}`,
+			`证据:${registryFailure.证据}`,
+		].join("\n");
+	}
+	if (catalog.部门.length === 0) {
+		return `截至 ${asOf}:当前没有已登记部门,暂无可派发部门。`;
+	}
+
+	const names = new Set(catalog.部门.map((entry) => entry.名字));
+	const blockingByDept = new Map<string, string[]>(
+		catalog.部门.map((entry) => [entry.名字, entry.配方存在 ? [] : ["配方文件缺失或不可读"]]),
+	);
+	for (const issue of catalog.问题) {
+		if (issue.级别 !== "阻止启动" || !names.has(issue.部门)) continue;
+		const problems = blockingByDept.get(issue.部门) ?? [];
+		if (!problems.includes(issue.问题)) problems.push(issue.问题);
+		blockingByDept.set(issue.部门, problems);
+	}
+	const commonBlockers = [
+		...new Set(
+			catalog.问题.filter((issue) => issue.级别 === "阻止启动" && !names.has(issue.部门)).map((issue) => issue.问题),
+		),
+	];
+	for (const entry of catalog.部门) {
+		if (commonBlockers.length === 0) continue;
+		blockingByDept.set(entry.名字, [...(blockingByDept.get(entry.名字) ?? []), ...commonBlockers]);
+	}
+	return [
+		`截至 ${asOf},已登记部门如下(按具体任务选择;派发状态以目录实读为准):`,
+		"",
+		...catalog.部门.map((entry) => renderDeptCatalogEntry(entry, blockingByDept.get(entry.名字) ?? [])),
+	].join("\n");
+}
+
+/** 读 <paoHome>/部门 并渲染职责简介;注册表不存在是明确空名单,读取失败则明确报错。 */
 export function renderRegistryFromHome(paoHome: string, asOf: string = today()): string {
-	const registryPath = join(paoHome, DEPT_DIR_NAME, REGISTRY_FILE_NAME);
-	const text = existsSync(registryPath) ? readFileSync(registryPath, "utf8") : "";
-	return renderRegistryText(text, asOf);
+	return renderDeptCatalogSnapshot(readDeptCatalog(paoHome), asOf);
 }
 
