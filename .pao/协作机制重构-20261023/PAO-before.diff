+async function runGitWithEnv(
+	args: string[],
+	cwd: string,
+	env: NodeJS.ProcessEnv,
+	signal?: AbortSignal,
+): Promise<{ code: number; stdout: string; stderr: string }> {
+	return runCardProcess(
+		"git",
+		["-c", "core.quotepath=off", "-c", "core.autocrlf=false", "--literal-pathspecs", ...args],
+		cwd,
+		60000,
+		env,
+		signal,
+	);
+}
