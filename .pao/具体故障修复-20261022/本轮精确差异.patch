+import paoExtension from "../../../src/pao/index.ts";
+import { createTestExtensionsResult, createTestResourceLoader } from "../../utilities.ts";
+
+const testRoot = process.argv[2];
+if (!testRoot) throw new Error("缺少测试根目录参数");
+
+const cardsDir = process.env.PAO_CARDS_DIR;
+const cardRef = process.env.PAO_WORKER_CARD;
+const attempt = Number(process.env.PAO_WORKER_ATTEMPT);
+const cardNo = Number(/^卡0*(\d+)$/.exec(cardRef ?? "")?.[1]);
+const cardPath = listCards(cardsDir ?? "").find((card) => card.card_no === cardNo)?.path;
+if (!cardsDir || !cardRef || !cardPath || !Number.isSafeInteger(attempt)) {
+	throw new Error(
+		`缺少真实派发身份: cardsDir=${cardsDir ?? "(空)"}, card=${cardRef ?? "(空)"}, path=${cardPath ?? "(空)"}, attempt=${attempt}`,
+	);
+}
+const cardText = readFileSync(cardPath, "utf8");
+const node = /<!-- pao-workflow:流=[^/]+\/节点=([^ ]+) -->/.exec(cardText)?.[1];
+if (node !== "实施" && node !== "审核") throw new Error(`未知 worker 节点:${node ?? "(空)"}`);
+
+const startedPath = join(testRoot, `worker.started-${node}`);
+const releasePath = join(testRoot, `worker.release-${node}`);
+writeFileSync(startedPath, `${process.pid}\n`, "utf8");
+while (!existsSync(releasePath)) await new Promise((resolve) => setTimeout(resolve, 20));
+
+const outputPath = node === "实施" ? "业务/闭环结果.txt" : "业务/审核结论.txt";
+const outputText = node === "实施" ? "四部门闭环通过" : "审核通过";
+const acceptance =
+	node === "实施"
+		? [
+				"存在: 业务/闭环结果.txt",
+				"包含: 业务/闭环结果.txt :: 四部门闭环通过",
+				"负责部长确认结果内容",
+			]
+		: [
+				"存在: 业务/审核结论.txt",
+				"包含: 业务/审核结论.txt :: 审核通过",
+				"负责部长确认审核证据",
+			];
+const receipt = JSON.stringify({
+	result: "success",
+	artifact_path: [outputPath],
+	summary: node === "实施" ? "实施写入并自验完成" : "审核写入并自验完成",
+	任务态: "completed",
+	verification: acceptance.map((condition) => ({
+		条件: condition,
+		结论: "pass",
+		证据: condition.startsWith("存在:") ? "真实 write 工具已创建文件" : "文件正文与要求一致",
+	})),
+	changes: [
+		{
+			类型: "created",
+			路径: outputPath,
+			说明: node === "实施" ? "四部门闭环产物" : "审核结论产物",
+		},
+	],
+});
+
+const runtime = await ModelRuntime.create({
+	credentials: AuthStorage.inMemory(),
+	modelsStore: new InMemoryModelsStore(),
+	modelsPath: null,
+	allowModelNetwork: false,
+});
+const faux = fauxProvider({ tokensPerSecond: 1_000_000 });
+runtime.registerNativeProvider(faux.provider);
+await runtime.refresh({ allowNetwork: false });
+faux.setResponses([
+	fauxAssistantMessage(fauxToolCall("write", { path: outputPath, content: `${outputText}\n` }), {
+		stopReason: "toolUse",
+	}),
+	fauxAssistantMessage(receipt),
+]);
+
+const extensionsResult = await createTestExtensionsResult(
+	[
+		(pi) =>
+			paoExtension(pi, {
+				resolveProjectRoot: () => process.cwd(),
+				resolveCardsDir: () => join(process.cwd(), ".pao", "卡"),
+				resolvePaoHome: () => process.env.PAO_HOME ?? testRoot,
+			}),
+	],
+	process.cwd(),
+);
+const { session } = await createAgentSession({
+	cwd: process.cwd(),
+	agentDir: testRoot,
+	modelRuntime: runtime,
+	model: faux.getModel(),
+	sessionManager: SessionManager.inMemory(process.cwd()),
+	settingsManager: SettingsManager.inMemory({ compaction: { enabled: false }, retry: { enabled: false } }),
+	resourceLoader: createTestResourceLoader({ extensionsResult }),
+	tools: ["write", "pao_save_dispatch_recon"],
+});
+await session.bindExtensions({});
+session.subscribe((event) => {
+	process.stdout.write(`${JSON.stringify(toJsonEvent(event))}\n`);
+});
+
+const prompt = `你是 pao worker，执行卡 ${cardPath} 的尝试 ${attempt}。先用真实 write 工具写入 ${outputPath}，下一轮只输出 JSON 回执。`;
+await session.prompt(prompt);
+session.dispose();
+await new Promise<void>((resolve) => process.stdout.write("", () => resolve()));
+process.exit(0);
+
