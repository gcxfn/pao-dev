+		try {
+			parsed = JSON.parse(record.理由);
+		} catch {
+			continue;
+		}
+		if (parsed && typeof parsed === "object" && (parsed as { requestId?: unknown }).requestId === requestId)
+			return record.理由;
+	}
+	return undefined;
