$ env PATH="/c/Windows/System32:/c/Windows" ELECTRON_RUN_AS_NODE=1 "D:/AI/workspace/pao-dev/desktop/node_modules/electron/dist/electron.exe" "D:/AI/workspace/pao-dev/desktop/apps/desktop/release/win-unpacked/resources/app.asar/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js" --version
