+            if not _replacement_is_temporarily_blocked(error):
+                raise
+            first_error = first_error or error
+            last_error = error
+            if time.monotonic() >= deadline or attempts >= _REPLACE_MAX_ATTEMPTS:
+                break
+            remaining = deadline - time.monotonic()
+            time.sleep(min(_REPLACE_INTERVAL_SECONDS, max(0.0, remaining)))
