# pao 本体（pi fork，独立 git 仓库，备份另配）
/PAO/
/desktop/
# 凭证与本地环境（不入库）
.env
.env.*
*.local
# 验收所用隔离认证文件不入库，原始本地证据仍保留。
/.pao/**/auth.json
/.pao/**/私有配置/
# 证据目录大件不入库（本地保留：会话转录、隔离环境副本、安装包与浏览器缓存）
/.pao/**/*.jsonl
/.pao/**/*.zip
/.pao/**/*.exe
/.pao/**/agent/
/.pao/**/bin/
/.pao/**/profile/
# 依赖目录不入库
node_modules/
# 系统杂物
Thumbs.db
Desktop.ini
