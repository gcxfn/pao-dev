+def _replacement_is_temporarily_blocked(error: OSError) -> bool:
+    """只把真实平台探测到的目标占用错误视为可等待。"""
+    if not isinstance(error, PermissionError) or error.errno != errno.EACCES:
+        return False
+    if os.name == "nt":
+        return getattr(error, "winerror", None) == 5
+    return True
+
+
+def _replace_with_bounded_wait(temporary: Path, target: Path) -> None:
+    """等待目标文件释放；时限与尝试次数是防止时钟和极小间隔失控的双重边界。"""
+    deadline = time.monotonic() + _REPLACE_TIMEOUT_SECONDS
+    first_error = None
+    last_error = None
+    attempts = 0
+    while attempts < _REPLACE_MAX_ATTEMPTS:
+        attempts += 1
+        try:
+            os.replace(temporary, target)
+            return
+        except OSError as error:
+            if not _replacement_is_temporarily_blocked(error):
+                raise
+            first_error = first_error or error
+            last_error = error
+            if time.monotonic() >= deadline or attempts >= _REPLACE_MAX_ATTEMPTS:
+                break
+            remaining = deadline - time.monotonic()
+            time.sleep(min(_REPLACE_INTERVAL_SECONDS, max(0.0, remaining)))
+    message = (
+        f"原子替换在 {attempts} 次尝试后仍失败："
+        f"目标={target}；临时文件={temporary}；"
+        f"首次异常={first_error!r}；最后异常={last_error!r}"
+    )
+    failure = PermissionError(last_error.errno, message)
+    failure.filename = str(target)
+    failure.filename2 = str(temporary)
+    failure.first_error = first_error
+    failure.last_error = last_error
+    failure.target = str(target)
+    failure.attempts = attempts
+    failure.temporary = str(temporary)
+    failure.winerror = getattr(last_error, "winerror", None)
+    raise failure from first_error
+
