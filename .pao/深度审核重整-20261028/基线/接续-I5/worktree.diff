+            attempt_ids.add((instance_id, normalized_cards_dir, card_no, attempt))
+        return (
+            len(instance_ids) if not errors else None,
+            len(attempt_ids) if not errors else None,
+            len(instance_paths),
+            len(attempt_paths),
+            errors,
+        )
