+	if (live.snapshotDigest !== expected.snapshotDigest) return "实时输入快照摘要与原绑定不一致";
+	if (live.worktree.bindingDigest !== expected.worktree.bindingDigest) {
+		return "实时宿主工作树摘要与原绑定不一致";
+	}
+	return undefined;
