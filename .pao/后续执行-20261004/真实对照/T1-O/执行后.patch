diff --git a/packages/coding-agent/src/pao/workflow/recipe.ts b/packages/coding-agent/src/pao/workflow/recipe.ts
index a7b693470..baaf8f73a 100644
--- a/packages/coding-agent/src/pao/workflow/recipe.ts
+++ b/packages/coding-agent/src/pao/workflow/recipe.ts
@@ -107,13 +107,13 @@ export function recipePath(paoHome: string, 名字: string): string {
 	return join(paoHome, "工作流", `${名字}.md`);
 }
 
-/** 列出可用配方名字（文件名去 .md，按名字排序）。目录不存在视为空。 */
+/** 列出可用配方名字（仅 .md 文件，文件名去 .md，按名字排序）。目录不存在视为空；目录名叫 xxx.md 不算配方；读取错误原样上抛。 */
 export function listRecipes(paoHome: string): string[] {
 	const dir = join(paoHome, "工作流");
 	if (!existsSync(dir)) return [];
-	return readdirSync(dir)
-		.filter((name) => name.endsWith(".md"))
-		.map((name) => name.slice(0, -3))
+	return readdirSync(dir, { withFileTypes: true })
+		.filter((entry) => !entry.isDirectory() && entry.name.endsWith(".md"))
+		.map((entry) => entry.name.slice(0, -3))
 		.sort();
 }
 
diff --git a/packages/coding-agent/test/pao/workflow-recipe.test.ts b/packages/coding-agent/test/pao/workflow-recipe.test.ts
index 304f15a84..5011086f1 100644
--- a/packages/coding-agent/test/pao/workflow-recipe.test.ts
+++ b/packages/coding-agent/test/pao/workflow-recipe.test.ts
@@ -83,6 +83,25 @@ describe("合法配方解析", () => {
 		expect(listRecipes(paoHome)).toEqual(["大活流程", "小活流程"]);
 	});
 
+	test("listRecipes：名字以 .md 结尾的目录不算配方，只列 .md 文件且有序", () => {
+		writeFileSync(recipePath(paoHome, "a"), "---\n名字: a\n---\n说明\n", "utf8");
+		writeFileSync(recipePath(paoHome, "z"), "---\n名字: z\n---\n说明\n", "utf8");
+		mkdirSync(join(paoHome, "工作流", "fake.md"));
+		writeFileSync(join(paoHome, "工作流", "note.txt"), "不是配方", "utf8");
+		expect(listRecipes(paoHome)).toEqual(["a", "z"]);
+	});
+
+	test("listRecipes：工作流目录不存在返回空", () => {
+		rmSync(join(paoHome, "工作流"), { recursive: true, force: true });
+		expect(listRecipes(paoHome)).toEqual([]);
+	});
+
+	test("listRecipes：真实读取错误上抛不吞（工作流是文件而非目录）", () => {
+		rmSync(join(paoHome, "工作流"), { recursive: true, force: true });
+		writeFileSync(join(paoHome, "工作流"), "占位文件", "utf8");
+		expect(() => listRecipes(paoHome)).toThrow();
+	});
+
 	test("substituteParams：代入声明参数，缺值原样保留", () => {
 		expect(substituteParams("侦察 {仓库}（期限 {期限}）", { 仓库: "pao" })).toBe("侦察 pao（期限 {期限}）");
 	});
