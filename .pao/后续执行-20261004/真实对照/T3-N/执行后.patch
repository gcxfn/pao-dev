+
+	it("节点「说明」透传到报告行并在终端复盘可读（多行取首行）;无说明节点不加行", () => {
+		const cardsDir = makeDir();
+		writeCard(
+			cardsDir,
+			1,
+			"侦察",
+			{ 目标: "扫仓库", 部门: "侦察", 验收: "包含: 扫", 尝试: 1 },
+			[
+				workflowMarker("说明复盘流", "侦察"),
+				serializeReceipt({
+					卡号: 1,
+					尝试号: 1,
+					时间: "2026-10-03 10:20",
+					结果: "成功",
+					摘要: "产出地图",
+				}),
+			].join("\n\n"),
+		);
+		const recipeText = [
+			"---",
+			'名字: "说明复盘流"',
+			"自动执行: false",
+			"参数: []",
+			"节点:",
+			'  - 名字: "侦察"',
+			'    目标: "扫仓库"',
+			'    部门: "侦察"',
+			'    验收: "包含: 扫"',
+			'    说明: "这步是给仓库画地图的第一步。\\n后面这行是给审的人看的提醒。"',
+			"    depends_on: []",
+			"    人工确认: false",
+			'  - 名字: "文档"',
+			'    目标: "写文档"',
+			'    部门: "文档"',
+			'    验收: "包含: 文档"',
+			'    说明: ""',
+			"    depends_on: [\"侦察\"]",
+			"    人工确认: false",
+			"---",
+			"说明",
+		].join("\n");
+		const recipe = parseRecipe(recipeText, join("工作流", "说明复盘流.md"));
+		const report = buildReviewReport(recipe, cardsDir, undefined);
+		expect(report.节点[0].说明).toBe("这步是给仓库画地图的第一步。\n后面这行是给审的人看的提醒。");
+		expect(report.节点[1].说明).toBe(""); // 空串也透传（区别于缺省）
+		const text = renderReviewReport(report);
+		expect(text).toContain("说明:这步是给仓库画地图的第一步。");
+		// 多行只取首行（与末次成功摘要同款）,第二行不进报告
+		expect(text).not.toContain("后面这行是给审的人看的提醒。");
+		// 只有侦察一行说明行;空串/缺省不加说明行,节点行序不受影响
+		expect((text.match(/^  说明:/gm) ?? []).length).toBe(1);
+		expect(report.节点.map((row) => row.节点)).toEqual(["侦察", "文档"]);
+	});
 });
