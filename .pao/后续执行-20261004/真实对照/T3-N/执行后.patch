diff --git a/packages/coding-agent/test/pao/workflow-recipe.test.ts b/packages/coding-agent/test/pao/workflow-recipe.test.ts
index 304f15a84..032628ea0 100644
--- a/packages/coding-agent/test/pao/workflow-recipe.test.ts
+++ b/packages/coding-agent/test/pao/workflow-recipe.test.ts
@@ -285,3 +285,85 @@ describe("坏配方被拒（结构化错误）", () => {
 		expect(() => parseRecipe("就是一段正文", "某目录/某流.md")).toThrowError(WorkflowRecipeError);
 	});
 });
+
+describe("节点「说明」字段（可选,只供人读）", () => {
+	test("中文/换行/引号/反斜杠/空串逐字解析;缺省为 undefined", () => {
+		const recipeText = [
+			"---",
+			"名字: 说明流",
+			"节点:",
+			"  - 名字: 甲",
+			"    部门: 规划部",
+			'    目标: "干活"',
+			"    验收: 落盘",
+			'    说明: "这一步给仓库画地图，先扫后写。\\n第二行提醒：别动别的模块。"',
+			"  - 名字: 乙",
+			"    部门: 规划部",
+			'    目标: "干活"',
+			"    验收: 落盘",
+			'    说明: "带\\"引号\\"与\\\\反斜杠"',
+			"  - 名字: 丙",
+			"    部门: 规划部",
+			'    目标: "干活"',
+			"    验收: 落盘",
+			'    说明: ""',
+			"  - 名字: 丁",
+			"    部门: 规划部",
+			'    目标: "干活"',
+			"    验收: 落盘",
+			"---",
+			"",
+		].join("\n");
+		const recipe = parseRecipe(recipeText, join(paoHome, "工作流", "说明流.md"));
+		expect(recipe.节点[0].说明).toBe("这一步给仓库画地图，先扫后写。\n第二行提醒：别动别的模块。");
+		expect(recipe.节点[1].说明).toBe('带"引号"与\\反斜杠');
+		expect(recipe.节点[2].说明).toBe("");
+		expect(recipe.节点[3].说明).toBeUndefined();
+		// 缺省行为保持:目标/验收/依赖/人工门不受说明字段影响
+		expect(recipe.拓扑序).toEqual(["甲", "乙", "丙", "丁"]);
+	});
+
+	test("说明非字符串 → RECIPE_FIELD,problems 点名字段「说明」", () => {
+		writeRecipe(
+			"坏说明流",
+			`---
+名字: 坏说明流
+节点:
+  - 名字: 甲
+    部门: 规划部
+    目标: 干活
+    验收: 落盘
+    说明: [不是, 字符串]
+---
+`,
+		);
+		try {
+			loadRecipe(paoHome, "坏说明流");
+			expect.unreachable("应抛 RECIPE_FIELD");
+		} catch (error) {
+			const err = error as WorkflowRecipeError;
+			expect(err.code).toBe("RECIPE_FIELD");
+			expect((err.details.problems as string[]).some((p) => p.includes("「说明」"))).toBe(true);
+		}
+	});
+
+	test("说明含 {占位符} 不触发参数声明校验（只供人读,不参与机械执行）", () => {
+		writeRecipe(
+			"占位说明流",
+			`---
+名字: 占位说明流
+参数: [仓库]
+节点:
+  - 名字: 甲
+    部门: 规划部
+    目标: "扫 {仓库}"
+    验收: 落盘
+    说明: "给 {仓库} 用的备注,{别的} 也照写不校验"
+---
+`,
+		);
+		const recipe = loadRecipe(paoHome, "占位说明流");
+		expect(recipe.占位符).toEqual(["仓库"]); // 占位符只扫目标/验收等机械字段,说明不进
+		expect(recipe.节点[0].说明).toBe("给 {仓库} 用的备注,{别的} 也照写不校验");
+	});
+});
diff --git a/packages/coding-agent/test/pao/workflow-review.test.ts b/packages/coding-agent/test/pao/workflow-review.test.ts
