+describe("节点「说明」序列化往返（emitRecipeMarkdown ↔ parseRecipe）", () => {
+	it("中文/换行/引号/反斜杠/空串逐字往返;缺省不发射且回读 undefined;回读后再发射字节一致", () => {
+		const 节点 = [
+			{ 名字: "甲", 目标: "a", 部门: "前端", 验收: "包含: a", 说明: "中文说明：先扫后写", depends_on: [], 人工确认: false },
+			{ 名字: "乙", 目标: "b", 部门: "前端", 验收: "包含: b", 说明: "第一行\n第二行", depends_on: ["甲"], 人工确认: false },
+			{ 名字: "丙", 目标: "c", 部门: "前端", 验收: "包含: c", 说明: '带"引号"与\\反斜杠', depends_on: [], 人工确认: false },
+			{ 名字: "丁", 目标: "d", 部门: "前端", 验收: "包含: d", 说明: "", depends_on: [], 人工确认: false },
+			{ 名字: "戊", 目标: "e", 部门: "前端", 验收: "包含: e", depends_on: [], 人工确认: false },
+		];
+		const content = emitRecipeMarkdown({ 名字: "往返流", 自动执行: false, 参数: [], 节点, 说明: "正文" });
+		// 空串也发射（""）,与缺省（不发射）区分
+		expect((content.match(/^    说明: /gm) ?? []).length).toBe(4);
+		const recipe = parseRecipe(content, join("工作流", "往返流.md"));
+		expect(recipe.节点.map((node) => node.说明)).toEqual([
+			"中文说明：先扫后写",
+			"第一行\n第二行",
+			'带"引号"与\\反斜杠',
+			"",
+			undefined,
+		]);
+		// 回读后再发射:字节逐字一致（含空串与缺省的区分,往返稳定）
+		const again = emitRecipeMarkdown({
+			名字: recipe.名字,
+			自动执行: recipe.自动执行,
+			参数: recipe.参数,
+			节点: recipe.节点,
+			说明: recipe.说明,
