+
+describe("节点「说明」字段（给人读,经发射器序列化）", () => {
+	function emitWith说明(说明: string): string {
+		return emitRecipeMarkdown({
+			名字: "说明往返流",
+			自动执行: false,
+			参数: [],
+			节点: [{ 名字: "甲", 目标: "a", 部门: "前端", 验收: "包含: a", 说明, depends_on: [], 人工确认: false }],
+			说明: "正文",
+		});
+	}
+
+	it("中文/换行/引号/空串:发射→解析逐字往返,再发射内容逐字一致", () => {
+		const values = [
+			"为什么这步在前：先摸清库再动手",
+			"第一行\n第二行（含换行）",
+			'带"引号" 与反斜杠\\ 及冒号: 破折号-',
+			"",
+		];
+		for (const value of values) {
+			const content = emitWith说明(value);
+			const recipe = parseRecipe(content, join("工作流", "说明往返流.md"));
+			expect(recipe.节点[0].说明).toBe(value); // 往返逐字
+			expect(emitWith说明(value)).toBe(content); // 再发射逐字一致
+		}
+	});
+
+	it("缺省:不发射节点「说明:」行,解析回 undefined;蒸馏草稿不从卡面猜说明", () => {
+		const content = emitRecipeMarkdown({
+			名字: "无说明流",
+			自动执行: false,
+			参数: [],
+			节点: [{ 名字: "甲", 目标: "a", 部门: "前端", 验收: "包含: a", depends_on: [], 人工确认: false }],
+			说明: "正文",
+		});
+		expect(content).not.toMatch(/^ {4}说明: /m);
+		expect(parseRecipe(content, join("工作流", "无说明流.md")).节点[0].说明).toBeUndefined();
+		const cardsDir = makeDir();
+		card(cardsDir, 1, "侦察", { 目标: "a", 部门: "前端", 验收: "包含: a" });
+		expect(distillRecipe(cardsDir, "蒸馏无说明流", "t").content).not.toMatch(/^ {4}说明: /m);
+	});
+});
