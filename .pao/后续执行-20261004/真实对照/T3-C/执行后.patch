diff --git a/packages/coding-agent/test/pao/workflow-recipe.test.ts b/packages/coding-agent/test/pao/workflow-recipe.test.ts
index 304f15a84..00ecf9d26 100644
--- a/packages/coding-agent/test/pao/workflow-recipe.test.ts
+++ b/packages/coding-agent/test/pao/workflow-recipe.test.ts
@@ -285,3 +285,69 @@ describe("坏配方被拒（结构化错误）", () => {
 		expect(() => parseRecipe("就是一段正文", "某目录/某流.md")).toThrowError(WorkflowRecipeError);
 	});
 });
+
+describe("节点「说明」可选字段（给人读,不参与机械执行）", () => {
+	const 带说明 = (说明行: string) =>
+		`---
+名字: 说明流
+节点:
+  - 名字: 侦察
+    部门: 核心机制
+    目标: 侦察
+    验收: 落盘
+${说明行}---
+正文
+`;
+
+	test("中文/换行/引号/空字符串照收,缺省 undefined（空串不视为缺失）", () => {
+		const cases: Array<[string, string | undefined]> = [
+			['    说明: "为什么这步在前：先摸清库再动手"\n', "为什么这步在前：先摸清库再动手"],
+			['    说明: "第一行\\n第二行（含换行）"\n', "第一行\n第二行（含换行）"],
+			['    说明: "带\\"引号\\" 与反斜杠\\\\"\n', '带"引号" 与反斜杠\\'],
+			['    说明: ""\n', ""],
+			["", undefined],
+		];
+		for (const [说明行, expected] of cases) {
+			writeRecipe("说明流", 带说明(说明行));
+			const recipe = loadRecipe(paoHome, "说明流");
+			expect(recipe.节点[0].说明).toBe(expected);
+			rmSync(recipePath(paoHome, "说明流"));
+		}
+	});
+
+	test("非字符串（数字/数组/null）→ RECIPE_FIELD,problems 点名字段「说明」", () => {
+		for (const 说明行 of ["    说明: 42\n", "    说明: [a, b]\n", "    说明:\n"]) {
+			writeRecipe("说明流", 带说明(说明行));
+			try {
+				loadRecipe(paoHome, "说明流");
+				expect.unreachable("非字符串说明应拒");
+			} catch (error) {
+				const err = error as WorkflowRecipeError;
+				expect(err.code).toBe("RECIPE_FIELD");
+				expect((err.details.problems as string[]).some((p) => p.includes("说明") && p.includes("字符串"))).toBe(
+					true,
+				);
+			}
+			rmSync(recipePath(paoHome, "说明流"));
+		}
+	});
+
+	test("说明里的 {参数} 不占位不校验（不参与派发目标）", () => {
+		writeRecipe(
+			"说明流",
+			`---
+名字: 说明流
+节点:
+  - 名字: 侦察
+    部门: 核心机制
+    目标: 侦察
+    验收: 落盘
+    说明: "这步吃 {仓库} 的语境（说明给人读,不是模板）"
+---
+正文
+`,
+		);
+		const recipe = loadRecipe(paoHome, "说明流");
+		expect(recipe.占位符).toEqual([]);
+	});
+});
