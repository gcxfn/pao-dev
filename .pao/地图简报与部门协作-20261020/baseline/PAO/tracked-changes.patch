+
+/** 把某会话的 owner 条目写进 owners，并把该会话 id 记进本 pi 的集合。 */
+function remember(pi: ExtensionAPI, ctx: ExtensionContext, sessionId: string, options: RegistrationOptions): void {
+	owners.set(sessionId, {
