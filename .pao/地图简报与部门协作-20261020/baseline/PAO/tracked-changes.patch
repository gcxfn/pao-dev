+		ctx,
+		getMinisters: options.getMinisters ?? (() => []),
+		getWorkerActivity: options.getWorkerActivity ?? (() => []),
+		getSilenceMinutes: options.getSilenceMinutes ?? (() => 0),
+	});
+	sessionsOf(pi).add(sessionId);
