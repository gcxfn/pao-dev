+/** Windows PowerShell 5.1 会按系统代码页读取无 BOM 脚本，本地 .ps1 统一写 UTF-8 BOM。 */
+function encodeLocalWriteContent(path: string, content: string): string {
+	if (process.platform !== "win32" || !/\.ps1$/i.test(path) || content.startsWith("\uFEFF")) return content;
+	return `\uFEFF${content}`;
+}
+
