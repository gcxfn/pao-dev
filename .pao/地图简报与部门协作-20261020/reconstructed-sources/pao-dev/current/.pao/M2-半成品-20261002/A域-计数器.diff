+/**
+ * 计数器落点统一（摩擦日志 2026-10-02「卡号计数器双写」修复）：
+ * 写入只写项目编排目录 `<...>/.pao/卡号.txt`——沿卡目录向上找最近的 `.pao` 路径段，
+ * 计数器落在该 `.pao` 目录下（同一项目多任务工作区共用一个号池，天然不重号）；
+ * 卡目录不在 .pao 下时退回卡目录上级（编排目录约定由调用方自担）。
+ */
+export function resolveCounterPath(cardsDir: string): string {
+	const parts = resolve(cardsDir).split(/[\\/]+/).filter((p) => p.length > 0);
+	for (let i = parts.length - 1; i >= 0; i--) {
+		if (parts[i] === ".pao") {
+			return join(...parts.slice(0, i + 1), "卡号.txt");
+		}
+	}
+	return join(resolve(cardsDir), "..", "卡号.txt");
+}
