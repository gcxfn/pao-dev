+/** 造 v2 配方＋实例选项：sub 省略＝实例落 .pao 顶层,给出＝落 .pao/<sub> 任务工作区（两层布局各造一份用）。 */
+function v2Setup(项目根: string, sub: string | undefined, 名字: string) {
+	const workspace = sub === undefined ? join(项目根, ".pao") : join(项目根, ".pao", sub);
+	const recipe = parseRecipe(
+		`---\n${stringify({
+			版本: 2,
+			名字,
+			参数: [],
+			节点: [{ 名字: "开发", 部门: "开发", 目标: "改代码", 验收: "文件存在" }],
+		})}---\n`,
+		join(项目根, `${名字}.md`),
+	);
+	const options = {
+		cardsDir: join(workspace, "卡"),
+		ownerSessionId: "firstrun-owner",
+		counterPath: join(workspace, "卡号.txt"),
+	};
+	return { recipe, options };
+}
+
+/** 绑定部长并返回生产身份（实例/轮次从盘上正本现读）。 */
+async function bind开发(
+	recipe: ReturnType<typeof v2Setup>["recipe"],
+	options: ReturnType<typeof v2Setup>["options"],
+) {
+	await bindMinister(recipe, options, "开发", "firstrun-部长");
+	const flow = readControl(recipe, options);
+	return {
+		实例: flow.实例,
+		节点: "开发",
+		轮次: flow.节点.find((node) => node.名字 === "开发")!.轮次,
+		部长会话: "firstrun-部长",
+	};
+}
+
+/** 改卡状态（模拟机械交付/失败,同 workflow-control.test.ts 的 deliver 写法）。 */
+function setCardStatus(cardsDir: string, ref: string, 状态: CardStatus): void {
+	const card = loadCard(cardsDir, parseCardRef(ref));
+	writeFileSync(card.路径, serializeCard({ ...card.frontmatter, 状态 }, card.正文));
+}
+
+/** 前后文件树＋内容哈希快照（preflight.test.ts 同款纯读断言辅具）。 */
+function snapshot(root: string): string[] {
+	return readdirSync(root, { withFileTypes: true }).flatMap((entry) => {
+		const path = join(root, entry.name);
+		return entry.isDirectory() ? [path, ...snapshot(path)] : [`${path}:${createHash("sha256").update(readFileSync(path)).digest("hex")}`];
+	});
+}
