+/**
+ * 只负责存储的桌面适配器。共享宿主负责跨进程锁和读改写事务；
+ * 本对象保留桌面原有的备份与原子写行为。
+ */
+export function createPaoDesktopWorktreeHostStateAdapter(
+  userDataDir: string,
+): PaoDesktopWorktreeHostStateAdapter {
+  return {
+    lockTarget: statePath(userDataDir),
+    async load() {
+      const saved = await loadPaoWorktreeHostState(userDataDir);
+      if (saved.corrupted && !saved.recovered)
+        throw new Error("工作目录宿主记录损坏；已保留原文件，拒绝覆盖。");
+      return saved.value;
+    },
+    async save(state) {
+      await savePaoWorktreeHostState(userDataDir, state, (value) => value);
+    },
+  };
+}
+
 function statePath(userDataDir: string): string {
