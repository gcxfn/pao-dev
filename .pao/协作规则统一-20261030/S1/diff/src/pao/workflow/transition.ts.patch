 import {
 	type ControlResult,
+	type ControlStop,
 	type PendingKind,
 	pendingKey,
 	type WorkflowPending,
 	type WorkflowPendingItem,
 } from "./policy.ts";
 
+/** 同一待决的展示文字和可操作性分离；构造函数只绑定已有事实。 */
+export function decisionStop(pending: WorkflowPending, route: "rule" | "resolve_pending"): ControlStop {
+	return {
+		category: pending.phase === "待处理" ? "decision" : "terminal_block",
+		identity: {
+			instance: pending.instance,
+			node: pending.node,
+			round: pending.round,
+			...(pending.card_ref !== undefined ? { cardRef: pending.card_ref, attempt: pending.attempt } : {}),
+		},
+		reason: pendingSummary(pending),
+		pending: structuredClone(pending),
+		route,
+	};
+}
+
+export function formatControlStop(stop: ControlStop | undefined): string | undefined {
+	return stop?.reason;
+}
+
+/** 旧裁定公开回包的只读投影，不保存第二份裁定事实。 */
+export function rulingProjection(stop: ControlStop | undefined) {
+	if (!stop || stop.route !== "rule" || !stop.identity.node || stop.identity.round === undefined) return undefined;
+	const channel = stop.pending?.channel ?? stop.legacyChannel;
+	return channel
+		? {
+				节点: stop.identity.node,
+				轮次: stop.identity.round,
+				理由: stop.pending?.reason ?? stop.reason,
+				通道: channel,
+			}
+		: undefined;
+}
