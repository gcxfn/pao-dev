:[440,446]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[684,696]}}},{"diffOp":{"insert":{"range":[455,469]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[820,830]}}},{"diffOp":{"delete":{"range":[1013,1029]}}},{"diffOp":{"insert":{"range":[696,714]}}},{"diffOp":{"equal":{"range":[566,567]}}},{"diffOp":{"delete":{"range":[1029,1054]}}},{"diffOp":{"equal":{"range":[418,440]}}},{"diffOp":{"delete":{"range":[446,455]}}},{"diffOp":{"insert":{"range":[440,446]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[597,608]}}},{"diffOp":{"insert":{"range":[731,750]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[820,830]}}},{"diffOp":{"delete":{"range":[714,731]}}},{"diffOp":{"insert":{"range":[1054,1071]}}},{"diffOp":{"equal":{"range":[566,567]}}},{"diffOp":{"insert":{"range":[1071,1087]}}},{"diffOp":{"equal":{"range":[418,440]}}},{"diffOp":{"delete":{"range":[446,455]}}},{"diffOp":{"insert":{"range":[440,446]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[750,759]}}},{"diffOp":{"insert":{"range":[589,597]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[820,828]}}},{"diffOp":{"insert":{"range":[1054,1059]}}},{"diffOp":{"equal":{"range":[759,761]}}},{"diffOp":{"delete":{"range":[771,791]}}},{"diffOp":{"insert":{"range":[644,655]}}},{"diffOp":{"equal":{"range":[566,589]}}},{"diffOp":{"delete":{"range":[446,455]}}},{"diffOp":{"insert":{"range":[440,446]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[807,820]}}},{"diffOp":{"insert":{"range":[676,684]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[820,828]}}},{"diffOp":{"insert":{"range":[1054,1059]}}},{"diffOp":{"equal":{"range":[759,761]}}},{"diffOp":{"delete":{"range":[401,417]}}},{"diffOp":{"insert":{"range":[761,771]}}},{"diffOp":{"equal":{"range":[566,589]}}},{"diffOp":{"delete":{"range":[446,455]}}},{"diffOp":{"insert":{"range":[791,798]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[469,482]}}},{"diffOp":{"insert":{"range":[798,807]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[1087,1172]}}},{"equalLines":{"line_count":846}},{"diffOp":{"equal":{"range":[1172,1181]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o10.test.ts"},"span":[1230,1302],"sourceCode":"/**\n * O10 定向测试：单次进化作业入口 / 真实身份幂等 / 选择顺序 / 基础正文与停止条件。\n *\n * 对应任务书 o10-实施任务书.md「测试与回归」新增用例 1-5：\n * 1. E02：同一 evidenceRef 重报不增 occurrence_count；不同 evidenceRef 命中同\n *    problem 才 +1；摩擦问题带真实 projectId（经 recordFrictionDraft 入口）。\n * 2. E04：classify→select→freeze 完整顺序跑通；delete/merge/no_change/\n *    development_suggestion 各自终态与动作保留。\n * 3. E05：propose 请求体含 baseVersion 文件正文与真实诊断（截获 streamSimple\n *    输入断言）；缺版本返回 source_missing。\n * 4. E10：autoEvolutionEnabled=false、holdout 失败、已取消 → 不发模型请求；\n *    付费尝试计数 paid_attempts 生效。\n * 5. E01：登记 → 空闲领取 evolve job → 产出 proposed 候选或明确终态；\n *    前台忙时不新领。\n *\n * 标注：模型路由走 fakeRegistry 预设 JSON（机制验证，非真实模型输出）；\n * 真实模型闭环归 O11/O15。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o10.test.ts --maxWorkers=1\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport {\n\tenqueueEvolveJob,\n\tregisterMaintenanceScheduler,\n\ttype MaintenanceSchedulerDeps,\n} from \"../../src/pao/memory/maintenance.ts\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope } from \"../../src/pao/memory/types.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { drainFrictionDraftWrites, recordFrictionDraft } from \"../../src/pao/friction/drafts.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { classifyProblem, declareImprovementIntent } from \"../../src/pao/evolution/problems.ts\";\nimport { selectImprovement } from \"../../src/pao/evolution/select.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getEvolveMaintenanceHandlersForTest } from \"./fixtures/evolve-handler.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-o10-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const s of schedulers.splice(0)) {\n\t\ttry {\n\t\t\ts.unmount();\n\t\t} catch {\n\t\t\t// 已卸\n\t\t}\n\t}\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-15T10:00:00.000Z\";\nconst AT2 = \"2026-11-15T10:01:00.000Z\";\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\nconst SKILL_BASELINE = \"# test-skill\\n\\n步骤一: 输入\\n步骤二: 处理\\n\";\nconst SKILL_FIXED = \"# test-skill\\n\\n步骤一: 输入\\n步骤二: 处理\\n步骤三: 验证输出\\n\";\n\n/** 种 skill 资源 + 预算文件 + baseVersion 快照（与 e2e 夹具同口径）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), SKILL_BASELINE, \"utf8\");\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(\n\t\tjoin(home, \"总预算账.json\"),\n\t\tJSON.stringify({\n\t\t\tversion: 1,\n\t\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\t\treservations: [],\n\t\t}),\n\t);\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedSource(store: MemoryStore, sourceId = \"src-o10-001\") {\n\tstore.db\n\t\t.prepare(`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at) VALUES (?, ?, ?, ?, ?)`)\n\t\t.run(sourceId, \"o10-session\", \"ev-001\", \"tool_call\", AT);\n\treturn sourceId;\n}\n\n/** 直插一条 classified 问题（带 paid_attempts 默认 0）。 */\nfunction seedClassifiedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; action?: string; resourceId?: string; baseVersion?: string; kind?: string; projectId?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-o10\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tproject_id, status, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\tover.kind ?? \"implementation_defect\",\n\t\t\tover.action ?? \"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-o10-001\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.projectId ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 用例 1（E02）：同一 evidenceRef 重报幂等；不同 evidenceRef 命中同 problem +1；\n//              摩擦入口带真实 projectId。\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"E02 真实身份与幂等计数\", () => {\n\tit(\"同一 evidenceRef 重报不增 occurrence_count；新 evidenceRef 命中同 problem 才 +1\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 首次登记：evidenceRef = friction:打回:卡0001::evt-1\n\t\tconst first = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"机械校验拒绝\",\n\t\t\texpectedBehavior: \"放行\",\n\t\t\tactualBehavior: \"部门不存在\",\n\t\t\tevidenceRefs: [\"friction:打回:卡0001::evt-1\"],\n\t\t\tprojectId: \"proj-a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.problemId) return;\n\t\tconst problemId = first.problemId;\n\n\t\tconst count = () =>\n\t\t\t(store.db.prepare(`SELECT occurrence_count FROM evolution_problems WHERE problem_id = ?`).get(problemId) as {\n\t\t\t\toccurrence_count: number;\n\t\t\t}).occurrence_count;\n\t\texpect(count()).toBe(1);\n\n\t\t// 同一 evidenceRef 重报：merged 但不 bump（同一事件重放）。\n\t\tconst replay = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"机械校验拒绝\",\n\t\t\texpectedBehavior: \"放行\",\n\t\t\tactualBehavior: \"部门不存在\",\n\t\t\tevidenceRefs: [\"friction:打回:卡0001::evt-1\"],\n\t\t\tprojectId: \"proj-a\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(replay.ok && replay.accepted).toBe(true);\n\t\tif (!replay.ok) return;\n\t\texpect(replay.disposition).toBe(\"merged\");\n\t\texpect(count()).toBe(1); // 重放不增\n\n\t\t// 不同真实事件命中同 problem：申报同时带已关联引用（命中合并键）+\n\t\t// 新事件引用 → merged 且 +1（合并触发须本批含已链引用；全新引用单独\n\t\t// 申报只会另开 problem）。\n\t\tconst second = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"机械校验拒绝\",\n\t\t\texpectedBehavior: \"放行\",\n\t\t\tactualBehavior: \"部门不存在\",\n\t\t\tevidenceRefs: [\"friction:打回:卡0001::evt-1\", \"friction:打回:卡0001::evt-2\"],\n\t\t\tprojectId: \"proj-a\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok && second.accepted).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.disposition).toBe(\"merged\");\n\t\texpect(second.problemId).toBe(problemId);\n\t\texpect(count()).toBe(2);\n\t});\n\n\tit(\"recordFrictionDraft 经 identity 落真实 projectId（问题按 projectId 可查）\", async () => {\n\t\tconst home = tempHome();\n\t\tprocess.env.PAO_HOME = home;\n\t\ttry {\n\t\t\tawait recordFrictionDraft(\"打回\", \"卡0007\", \"部门「X」不在注册表\", join(home, \"项目甲\", \".pao\", \"卡\"), {\n\t\t\t\teventId: \"evt-friction-1\",\n\t\t\t\tprojectId: \"proj-real\",\n\t\t\t\ttaskId: \"task-9\",\n\t\t\t\tsessionId: \"sess-9\",\n\t\t\t\ttoolCallId: \"tc-9\",\n\t\t\t});\n\t\t\tawait drainFrictionDraftWrites();\n\t\t} finally {\n\t\t\tdelete process.env.PAO_HOME;\n\t\t}\n\t\tconst store = openStore(home);\n\t\tconst rows = store.db\n\t\t\t.prepare(`SELECT problem_id, project_id, task_id, session_id, tool_call_id, occurrence_count FROM evolution_problems`)\n\t\t\t.all() as Array<{\n\t\t\tproblem_id: string;\n\t\t\tproject_id: string | null;\n\t\t\ttask_id: string | null;\n\t\t\tsession_id: string | null;\n\t\t\ttool_call_id: string | null;\n\t\t\toccurrence_count: number;\n\t\t}>;\n\t\texpect(rows).toHaveLength(1);\n\t\texpect(rows[0].project_id).toBe(\"proj-real\");\n\t\texpect(rows[0].task_id).toBe(\"task-9\");\n\t\texpect(rows[0].session_id).toBe(\"sess-9\");\n\t\texpect(rows[0].tool_call_id).toBe(\"tc-9\");\n\t\t// evolve 作业已按项目登记（scopeKey 幂等）。\n\t\tconst job = store.db\n\t\t\t.prepare(`SELECT job_kind, scope_key, status FROM extraction_jobs WHERE scope_key = ?`)\n\t\t\t.get(\"evolve:proj-real\") as { job_kind: string; scope_key: string; status: string } | undefined;\n\t\texpect(job).toBeDefined();\n\t\texpect(job!.job_kind).toBe(\"evolve\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 用例 2（E04）：classify→select→freeze 完整顺序；delete/merge/no_change/\n//              development_suggestion 各自终态与动作保留。\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"E04 选择后保持 classified、动作不被覆盖\", () => {\n\tit(\"classify→select→freeze 顺序跑通：select 保持 classified，freeze 受理\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"test-skill 缺步骤三\",\n\t\t\texpectedBehavior: \"应含步骤三\",\n\t\t\tactualBehavior: \"只有步骤一二\",\n\t\t\tevidenceRefs: [\"src-o10-001\"],\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.problemId) return;\n\n\t\texpect(classifyProblem(store, { problemId: declared.problemId, classifiedAt: AT }).ok).toBe(true);\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId, selectedAt: AT });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.disposition).toBe(\"candidate\");\n\t\t// O10/E04：select 不抢写 candidate——保持 classified 等 freeze/propose 推进。\n\t\tconst statusRow = store.db\n\t\t\t.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t.get(declared.problemId) as { status: string };\n\t\texpect(statusRow.status).toBe(\"classified\");\n\n\t\t// freeze 只收 classified——select 保持 classified 后链路不再冻死。\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId: declared.problemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"检查步骤三\", initialFiles: {}, allowedTools: [], acceptance: \"含步骤三\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(frozen.ok).toBe(true);\n\t\tif (!frozen.ok) return;\n\t\texpect(frozen.testPlanId).toContain(baseVersion);\n\t});\n\n\tit.each([\n\t\t[\"delete\", \"no_change\"],\n\t\t[\"merge\", \"no_change\"],\n\t\t[\"no_change\", \"no_change\"],\n\t] as const)(\"登记动作 %s → 终态 %s，动作保留不被覆盖为 modify\", (action, expectedDisposition) => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { action, resourceId, baseVersion });\n\n\t\tconst selected = selectImprovement(store, { problemId: \"prob-o10\", selectedAt: AT });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(action);\n\t\texpect(selected.disposition).toBe(expectedDisposition);\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT status, action, disposition FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t.get(\"prob-o10\") as { status: string; action: string; disposition: string };\n\t\texpect(row.status).toBe(\"no_change\");\n\t\texpect(row.action).toBe(action); // 动作保留\n\t});\n\n\tit(\"core_issue → development_suggestion 终态，建议带真实定位（资源/版本/现场）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { kind: \"core_issue\", resourceId, baseVersion });\n\n\t\tconst selected = selectImprovement(store, { problemId: \"prob-o10\", selectedAt: AT });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.disposition).toBe(\"development_suggestion\");\n\t\texpect(selected.suggestion).toBeDefined();\n\t\t// O10/E04：建议带真实定位（资源@版本），不只泛化禁止对象。\n\t\texpect(selected.suggestion).toContain(resourceId);\n\t\texpect(selected.suggestion).toContain(baseVersion);\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT status, action FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t.get(\"prob-o10\") as { status: string; action: string };\n\t\texpect(row.status).toBe(\"development_suggestion\");\n\t\texpect(row.action).toBe(\"development_suggestion\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 用例 3（E05）：propose 请求体含 baseVersion 文件正文与真实诊断；\n//              版本缺失返回 source_missing。\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"E05 生成读取基础正文与真实诊断\", () => {\n\tit(\"提示词 {BASE_FILES} 含 baseVersion 文件正文，{PROBLEM} 含真实摘要/预期/实际\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion });\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"检查步骤三\", initialFiles: {}, allowedTools: [], acceptance: \"含步骤三\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\n\t\tlet capturedSystem = \"\";\n\t\tconst reply = JSON.stringify({ rationale: \"补步骤三\", edits: [{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED }] });\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply, (context) => {\n\t\t\t\tcapturedSystem = context.systemPrompt ?? \"\";\n\t\t\t}),\n\t\t\tledger: fakeLedger() as never,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\ttierConfig: TIER,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"检查步骤三\", failure: \"缺步骤三\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\n\t\t// {BASE_FILES}：模型可见 baseVersion 实际正文（SKILL.md 内容）。\n\t\texpect(capturedSystem).toContain(\"基础资源正文\");\n\t\texpect(capturedSystem).toContain(\"--- SKILL.md ---\");\n\t\texpect(capturedSystem).toContain(\"步骤一: 输入\"); // 真实文件内容\n\t\t// {PROBLEM}：真实字段，不再只放 ID。\n\t\texpect(capturedSystem).toContain(\"摘要:测试问题\");\n\t\texpect(capturedSystem).toContain(\"预期行为:应输出 A\");\n\t\texpect(capturedSystem).toContain(\"实际行为:实际输出 B\");\n\t\texpect(capturedSystem).toContain(\"类别:implementation_defect\");\n\t\t// holdout 不进提示词（本例 holdout 空，devCases 只给 reproduction 组）。\n\t\texpect(capturedSystem).not.toContain(\"holdout\");\n\t});\n\n\tit(\"baseVersion 目录缺失 → source_missing（透传 readResourceVersion 错误码）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\t// 问题登记一个不存在的 baseVersion。\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion: \"v-000000000000\" });\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion: \"v-000000000000\",\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(\"{}\"),\n\t\t\tledger: fakeLedger() as never,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\ttierConfig: TIER,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion: \"v-000000000000\",\n\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"source_missing\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 用例 4（E10）：停用/holdout 失败/已取消 → 不发模型请求；付费计数生效。\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"E10 生成前停止条件\", () => {\n\tfunction seedProblemWithValidation(\n\t\tstore: MemoryStore,\n\t\tover: { resourceId: string; baseVersion: string; holdoutVerdict?: string },\n\t) {\n\t\tseedClassifiedProblem(store, { resourceId: over.resourceId, baseVersion: over.baseVersion });\n\t\t// evolution_validations.candidate_id 有外键指向 candidates——先补一行\n\t\t// failed 候选（上一轮被拒的产物），验证行才挂得上。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"cand-o10\",\n\t\t\t\t\"prob-o10\",\n\t\t\t\tover.resourceId,\n\t\t\t\tover.baseVersion,\n\t\t\t\t\"tp-o10\",\n\t\t\t\t\"[]\",\n\t\t\t\t\"上轮候选\",\n\t\t\t\t\"[]\",\n\t\t\t\t\"failed\",\n\t\t\t\tAT,\n\t\t\t\tAT,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"val-o10\",\n\t\t\t\t\"tp-o10\",\n\t\t\t\t\"cand-o10\",\n\t\t\t\t\"prob-o10\",\n\t\t\t\tover.resourceId,\n\t\t\t\tover.baseVersion,\n\t\t\t\tJSON.stringify([\n\t\t\t\t\t{ caseId: \"reproduction-0\", verdict: \"passed\" },\n\t\t\t\t\t{ caseId: \"holdout-0\", verdict: over.holdoutVerdict ?? \"passed\" },\n\t\t\t\t]),\n\t\t\t\t\"failed\",\n\t\t\t\tnull,\n\t\t\t\tAT,\n\t\t\t\tAT,\n\t\t\t);\n\t}\n\n\tfunction proposeDeps(home: string, onRequest?: () => void) {\n\t\treturn {\n\t\t\tmodelRegistry: fakeRegistry(JSON.stringify({ rationale: \"x\", edits: [{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED }] }), onRequest),\n\t\t\tledger: fakeLedger() as never,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\ttierConfig: TIER,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t};\n\t}\n\n\tit(\"资源已停用自动进化 → rejected，不发模型请求、不占预算\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion });\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT });\n\n\t\tlet requested = false;\n\t\tconst result = await proposeCandidate(store, proposeDeps(home, () => { requested = true; }), {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\texpect(requested).toBe(false); // 未发请求\n\t\tconst paid = (store.db.prepare(`SELECT paid_attempts FROM evolution_problems WHERE problem_id = ?`).get(\"prob-o10\") as { paid_attempts: number }).paid_attempts;\n\t\texpect(paid).toBe(0); // 未占付费尝试\n\t});\n\n\tit(\"已有验证的保留组 failed/incomplete → rejected 本轮终止，不再生成\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedProblemWithValidation(store, { resourceId, baseVersion, holdoutVerdict: \"failed\" });\n\n\t\tlet requested = false;\n\t\tconst result = await proposeCandidate(store, proposeDeps(home, () => { requested = true; }), {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\tif (result.status === \"rejected\") expect(result.reason).toContain(\"保留组\");\n\t\texpect(requested).toBe(false);\n\t});\n\n\tit(\"已取消（signal aborted）→ rejected，不发模型请求\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion });\n\t\tconst controller = new AbortController();\n\t\tcontroller.abort(\"测试取消\");\n\n\t\tlet requested = false;\n\t\tconst result = await proposeCandidate(store, proposeDeps(home, () => { requested = true; }), {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t\tsignal: controller.signal,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\texpect(requested).toBe(false);\n\t});\n\n\tit(\"付费尝试达上限（paid_attempts=3）→ rejected；每次预留成功都递增计数\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion });\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\n\t\t// paid_attempts 预置到上限。\n\t\tstore.db.prepare(`UPDATE evolution_problems SET paid_attempts = 3 WHERE problem_id = ?`).run(\"prob-o10\");\n\t\tlet requested = false;\n\t\tconst capped = await proposeCandidate(store, proposeDeps(home, () => { requested = true; }), {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t});\n\t\texpect(capped.ok).toBe(true);\n\t\tif (!capped.ok) return;\n\t\texpect(capped.status).toBe(\"rejected\");\n\t\tif (capped.status === \"rejected\") expect(capped.reason).toContain(\"付费生成尝试已达上限\");\n\t\texpect(requested).toBe(false);\n\n\t\t// 计数语义：预算预留成功即 +1（模型请求无论成败都计一次付费尝试）。\n\t\tstore.db.prepare(`UPDATE evolution_problems SET paid_attempts = 0 WHERE problem_id = ?`).run(\"prob-o10\");\n\t\tconst once = await proposeCandidate(store, proposeDeps(home), {\n\t\t\tproblemId: \"prob-o10\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\tallowedFiles: [],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(once.ok).toBe(true);\n\t\tconst paid = (store.db.prepare(`SELECT paid_attempts FROM evolution_problems WHERE problem_id = ?`).get(\"prob-o10\") as { paid_attempts: number }).paid_attempts;\n\t\texpect(paid).toBe(1);\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 用例 5（E01）：登记 → 空闲领取 evolve job → 产出 proposed 候选或明确终态；\n//              前台忙时不新领。\n// ════════════════════════════════════════════════════════════════════════\n\ntype Handler = (event: never, ctx: unknown) => unknown;\n\nfunction capturePi(): { handlers: Map<string, Handler[]>; pi: ExtensionAPI } {\n\tconst handlers = new Map<string, Handler[]>();\n\tconst pi = {\n\t\ton(event: string, handler: Handler) {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\thandlers.set(\n\t\t\t\t\tevent,\n\t\t\t\t\tlist.filter((h) => h !== handler),\n\t\t\t\t);\n\t\t\t};\n\t\t},\n\t} as unknown as ExtensionAPI;\n\treturn { handlers, pi };\n}\n\nasync function emit(captured: { handlers: Map<string, Handler[]> }, event: string, ctx: ExtensionContext): Promise<void> {\n\tfor (const handler of captured.handlers.get(event) ?? []) {\n\t\tawait handler({ type: event } as never, ctx);\n\t}\n}\n\nfunction flushMicrotasks(): Promise<void> {\n\treturn new Promise((resolve) => setTimeout(resolve, 0));\n}\n\n/** 轮询条件——drain 在 pi.on 回调外分离运行，固定 flush 次数不能保证\n *  异步 handler（proposeCandidate await 模型结果）跑完；轮询到状态收敛。 */\nasync function waitFor(check: () => boolean, timeoutMs = 3000): Promise<boolean> {\n\tconst deadline = Date.now() + timeoutMs;\n\twhile (Date.now() < deadline) {\n\t\tif (check()) return true;\n\t\tawait new Promise((resolve) => setTimeout(resolve, 10));\n\t}\n\treturn check();\n}\n\nconst schedulers: Array<{ unmount: () => void }> = [];\nfunction trackScheduler<T extends { unmount: () => void }>(s: T): T {\n\tschedulers.push(s);\n\treturn s;\n}\n\ndescribe(\"E01 单次进化作业入口\", () => {\n\tconst PROJECT_ID = \"proj-evolve-1\";\n\n\tfunction testCtx(sessionId = \"sess-evolve\", modelRegistry?: unknown): ExtensionContext {\n\t\treturn {\n\t\t\tcwd: process.cwd(),\n\t\t\tsessionManager: { getSessionId: () => sessionId },\n\t\t\tmodelRegistry,\n\t\t\tsignal: undefined,\n\t\t} as unknown as ExtensionContext;\n\t}\n\n\tfunction deps(home: string, store: MemoryStore, handlers: MaintenanceSchedulerDeps[\"handlers\"]): MaintenanceSchedulerDeps {\n\t\treturn {\n\t\t\tstore,\n\t\t\tpaoHome: home,\n\t\t\tresolveScope: (): MemoryScope => resolveMemoryScope(process.cwd(), {}, home),\n\t\t\thandlers,\n\t\t\tnow: () => AT,\n\t\t};\n\t}\n\n\tit(\"登记问题 → 空闲 settled 领取 evolve job → 走通 propose→验证→评估→发布全链\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store);\n\t\t// 已登记问题（observed）挂到本项目；补 problem 级来源关联（publish 门核对四级关联）。\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion, projectId: PROJECT_ID });\n\t\tstore.db.prepare(`UPDATE evolution_problems SET status = 'observed' WHERE problem_id = ?`).run(\"prob-o10\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-o10\", \"prob-o10\", sourceId, AT);\n\n\t\tconst reply = JSON.stringify({ rationale: \"补步骤三\", edits: [{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED }] });\n\t\tconst registry = fakeRegistry(reply);\n\t\tconst captured = capturePi();\n\t\t// O11 续段：注入假 processRunner——baseline（旧版）exit 1、candidate（修复版）\n\t\t// exit 0（按调用序：每个用例先 baseline 后 candidate）；机制真实，进程假。\n\t\tlet callCount = 0;\n\t\tconst fakeProcessRunner = () => {\n\t\t\tcallCount += 1;\n\t\t\treturn Promise.resolve({ code: callCount % 2 === 1 ? 1 : 0, stdout: \"\", stderr: \"\" });\n\t\t};\n\t\ttrackScheduler(registerMaintenanceScheduler(\n\t\t\tcaptured.pi,\n\t\t\tdeps(home, store, getEvolveMaintenanceHandlersForTest({\n\t\t\t\tpaoHome: home,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\toutbound: OUTBOUND,\n\t\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\t\tprocessRunner: fakeProcessRunner as never,\n\t\t\t})),\n\t\t));\n\t\t// 登记 evolve 作业（模拟 declareImprovementIntent 受理后的 enqueue）。\n\t\tenqueueEvolveJob(store, { paoHome: home, projectId: PROJECT_ID, now: AT });\n\n\t\t// 空闲 settled：drain 领取 evolve job 并跑编排链（分离运行——轮询收敛）。\n\t\tconst jobStatus = () =>\n\t\t\t(store.db\n\t\t\t\t.prepare(`SELECT status FROM extraction_jobs WHERE scope_key = ?`)\n\t\t\t\t.get(`evolve:${PROJECT_ID}`) as { status: string } | undefined)?.status;\n\t\tawait emit(captured, \"agent_settled\", testCtx(\"sess-evolve\", registry));\n\t\tconst done = await waitFor(() => jobStatus() === \"done\" || jobStatus() === \"failed\");\n\t\texpect(done).toBe(true);\n\t\texpect(jobStatus()).toBe(\"done\");\n\n\t\t// O11 续段走通：problem 推进到 candidate；候选经假双侧 run 评估 passed 并发布。\n\t\tconst problem = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(\"prob-o10\") as { status: string };\n\t\texpect(problem.status).toBe(\"candidate\");\n\t\tconst candidate = store.db\n\t\t\t.prepare(`SELECT status FROM evolution_candidates WHERE problem_id = ?`)\n\t\t\t.get(\"prob-o10\") as { status: string } | undefined;\n\t\texpect(candidate).toBeDefined();\n\t\texpect(candidate!.status).toBe(\"passed\");\n\t\t// 发布 activation 落库（验证与候选指纹、四级来源关联、能力覆盖全部通过）。\n\t\tconst acts = store.db\n\t\t\t.prepare(`SELECT kind, to_version FROM evolution_activations WHERE resource_id = ?`)\n\t\t\t.all(resourceId) as Array<{ kind: string; to_version: string }>;\n\t\texpect(acts.some((a) => a.kind === \"publish\")).toBe(true);\n\n\t\t// O13/E15：publish 后自动激活——effective_version 前进到发布版，\n\t\t// 生效凭据（kind='publish' + source_links_json.activation='effective'）落库。\n\t\tconst resource = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string | null };\n\t\texpect(resource.effective_version).not.toBeNull();\n\t\texpect(resource.effective_version).not.toBe(baseVersion);\n\t\tconst publishRow = acts.find((a) => a.kind === \"publish\");\n\t\texpect(publishRow!.to_version).toBe(resource.effective_version);\n\t\t// 同一 to_version 有两行：落盘凭据（无 activation 字段）+ 生效凭据\n\t\t// （activation='effective'）——按 activation 过滤取生效行。\n\t\tconst credRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_links_json FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'publish' AND to_version = ?`,\n\t\t\t)\n\t\t\t.all(resourceId, resource.effective_version) as Array<{ source_links_json: string }>;\n\t\tconst effectiveCred = credRows\n\t\t\t.map((r) => JSON.parse(r.source_links_json) as { activation?: string })\n\t\t\t.find((links) => links.activation === \"effective\");\n\t\texpect(effectiveCred).toBeDefined();\n\t});\n\n\tit(\"前台忙（agent_start 未 settled）时 enqueue 不触发领取\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedClassifiedProblem(store, { resourceId, baseVersion, projectId: PROJECT_ID });\n\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED }] });\n\t\tconst registry = fakeRegistry(reply);\n\t\tconst captured = capturePi();\n\t\ttrackScheduler(registerMaintenanceScheduler(\n\t\t\tcaptured.pi,\n\t\t\tdeps(home, store, getEvolveMaintenanceHandlersForTest({ paoHome: home, tierConfig: TIER, outbound: OUTBOUND, outboundProjects: [...OUTBOUND_PROJECTS] })),\n\t\t));\n\n\t\t// 先 settled 一次让调度器见到 ctx，再 agent_start 置前台忙。