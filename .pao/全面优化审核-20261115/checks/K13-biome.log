 逐项比较预期行为、输出、退出码和受影响文件。\n * - 判定规则（S8 任务书 §5）：\n *   **原问题从失败到通过 + 关键正常用法及保留样例全部通过 + 范围检查通过 → `passed`**；\n *   启动失败/环境缺依赖/进程停止未确认 → `incomplete`（保留原因并停止发布）；\n *   业务结果不符 → `failed`。\n * - 候选定稿后才运行独立保留样例（reproduction+normal 在定稿前跑，\n *   holdout 在定稿后跑——由调用方传入的 caseResults 分组保证）。\n * - 模型随机性使同一用例前后结论矛盾时才补做该用例成对运行；\n *   证据仍不稳定则不宣称改善。\n * - 总分仅用于报告，不能覆盖关键失败；开发样例通过不直接标 passed。\n * - 完整费用归因到该候选（evolution_candidates.usage_refs_json 追加）；\n *   写 evolution_validations 行 + evolution_source_links（owner_kind='validation'）。\n * - 推进 candidate 状态机 proposed→testing→passed|failed|cancelled。\n *\n * 契约（S8-11）：\n * - `passed ≠ active`；不自动发布正式资源。\n * - 验证失败/取消/额度不足分别写状态，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\n\ttype ValidationPlan,\n\ttype ValidationRunResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `evaluateCandidate` 的输入：调用方已跑完 baseline/candidate 对照，逐项组装结果。 */\nexport interface EvaluateCandidateInput {\n\t/** 已生成候选 ID。 */\n\tcandidateId: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/**\n\t * PAO_HOME 根（O11/E06）：eval 读取 `<paoHome>/evolution/validations/\n\t * <testPlanId>/plan.json` 核对结果完整集合（plan 每个 caseId×side 都要有\n\t * 回执）。与 `plan` 互斥——注入其一即可。\n\t */\n\tpaoHome?: string;\n\t/** 直接注入计划对象（测试夹具可传；与 paoHome 互斥）。 */\n\tplan?: ValidationPlan;\n\t/** 逐项对照结果：reproduction + normal 在候选定稿前已跑完；holdout 在定稿后跑完。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 总费用/用量引用（候选生成+验证的全部 usageRefs 汇总）。 */\n\ttotalUsageRef?: string;\n\t/** 评估时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/**\n\t * 是否补做过成对运行（同 case 前后矛盾时由调用方重跑并替换旧结果）。\n\t * 补做后仍不稳定的用例在 verdict 标 incomplete 而非宣称改善。\n\t */\n\trepairedContradictions?: boolean;\n\t/** 来源引用（写入 evolution_source_links owner_kind='validation'）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `evaluateCandidate` 的输出。 */\nexport interface EvaluateCandidateResult {\n\t/** 验证记录 ID（evolution_validations.validation_id）。 */\n\tvalidationId: string;\n\t/** 总体判定。 */\n\tverdict: \"passed\" | \"failed\" | \"incomplete\";\n\t/** 逐项判定汇总（与输入 caseResults 一致）。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 各组通过率（报告用，不覆盖关键失败）。 */\n\tscore: {\n\t\treproduction: { passed: number; failed: number; incomplete: number; total: number };\n\t\tnormal: { passed: number; failed: number; incomplete: number; total: number };\n\t\tholdout: { passed: number; failed: number; incomplete: number; total: number };\n\t\t/** 总分：仅作报告摘要，不用于覆盖关键失败。 */\n\t\ttotal: { passed: number; failed: number; incomplete: number; total: number };\n\t};\n\t/** 完整验证记录。 */\n\tvalidation: EvolutionValidation;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 判定一个用例是否「关键失败」：reproduction 组失败 + normal/holdout 组任何非 passed。 */\nfunction isCriticalFailure(result: ValidationCaseResult): boolean {\n\tif (result.verdict === \"incomplete\") return true;\n\tif (result.verdict === \"failed\") {\n\t\t// reproduction 组失败永远是关键失败；normal/holdout 组失败也是关键失败。\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n/** 逐组统计通过率。 */\nfunction computeScore(caseResults: ValidationCaseResult[]): EvaluateCandidateResult[\"score\"] {\n\tconst group = (name: string) => {\n\t\tconst items = caseResults.filter((r) => r.caseId.startsWith(`${name}-`));\n\t\treturn {\n\t\t\tpassed: items.filter((r) => r.verdict === \"passed\").length,\n\t\t\tfailed: items.filter((r) => r.verdict === \"failed\").length,\n\t\t\tincomplete: items.filter((r) => r.verdict === \"incomplete\").length,\n\t\t\ttotal: items.length,\n\t\t};\n\t};\n\tconst reproduction = group(\"reproduction\");\n\tconst normal = group(\"normal\");\n\tconst holdout = group(\"holdout\");\n\tconst total = {\n\t\tpassed: reproduction.passed + normal.passed + holdout.passed,\n\t\tfailed: reproduction.failed + normal.failed + holdout.failed,\n\t\tincomplete: reproduction.incomplete + normal.incomplete + holdout.incomplete,\n\t\ttotal: reproduction.total + normal.total + holdout.total,\n\t};\n\treturn { reproduction, normal, holdout, total };\n}\n\n/**\n * 判断运行结果是否为「环境/启动失败」（O11/E07）：\n * 凭结构化 `executionFailure` 字段判定（start/timeout/cancel），不再靠\n * output/exitCode 启发式——启动失败/超时的进程也可能带 output 和 exitCode\n * （如 127/124），启发式会把启动故障误当业务失败或通过。\n * 环境失败标 incomplete，不画成业务失败或通过。\n */\nfunction isEnvironmentFailure(run: ValidationRunResult): boolean {\n\treturn run.executionFailure !== undefined;\n}\n\n/**\n * 读取冻结计划（O11/E06）：plan 对象优先，其次 `<paoHome>/evolution/\n * validations/<testPlanId>/plan.json`；都拿不到返回 undefined。\n */\nfunction readValidationPlan(input: EvaluateCandidateInput): ValidationPlan | undefined {\n\tif (input.plan !== undefined) return input.plan;\n\tif (input.paoHome === undefined) return undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, input.testPlanId, \"plan.json\");\n\tif (!existsSync(planPath)) return undefined;\n\ttry {\n\t\treturn JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/** plan 全部 caseId（三组展开）。 */\nfunction planCaseIds(plan: ValidationPlan): string[] {\n\treturn [...plan.reproduction, ...plan.normal, ...plan.holdout].map((c) => c.caseId);\n}\n\n/**\n * 解析 validation 的 sourceRefs（O12/E11）：显式传入优先；否则先取候选自身\n * links（O12 起 proposeCandidate 已从 problem 继承），候选无 links 时回退\n * problem 的 links（兼容 O12 之前生成的旧候选行）。\n */\nfunction resolveValidationSourceRefs(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): Array<{ sourceId: string; memoryId?: string; revision?: number }> {\n\tif (input.sourceRefs !== undefined) return input.sourceRefs;\n\tconst problemId = (\n\t\tstore.db\n\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { problem_id: string } | undefined\n\t)?.problem_id;\n\tconst readLinks = (ownerKind: string, ownerId: string) =>\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(ownerKind, ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\tlet rows = readLinks(\"candidate\", input.candidateId);\n\tif (rows.length === 0 && problemId !== undefined) rows = readLinks(\"problem\", problemId);\n\treturn rows.map((link) => ({\n\t\tsourceId: link.source_id,\n\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t}));\n}\n\n/**\n * O11/E06：完整集合不齐时收尾——写一条 verdict=incomplete 的验证记录，\n * 逐项 caseResults 原样落库，候选状态推 cancelled，返回 incomplete。\n * 不抛错（这是业务结论「验收不完整」，不是系统故障）。\n */\nfunction completeWithIncompleteVerdict(\n\tstore: MemoryStore,\n\tover: {\n\t\tcandidateId: string;\n\t\ttestPlanId: string;\n\t\tcandidateRow: { problem_id: string; resource_id: string; base_version: string; usage_refs_json: string };\n\t\tcurrentStatus: string;\n\t\tcaseResults: ValidationCaseResult[];\n\t\treason: string;\n\t\ttotalUsageRef?: string;\n\t\tsourceRefs: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n\t\tnow: string;\n\t},\n): MemoryResult<EvaluateCandidateResult> {\n\tconst validationId = `val-${randomUUID()}`;\n\tconst normalized = over.caseResults.map((r) => ({\n\t\t...r,\n\t\tverdict: \"incomplete\" as const,\n\t\treason: r.reason ?? `回执不完整:${over.reason}`,\n\t}));\n\tconst score = computeScore(normalized);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: over.testPlanId,\n\t\tcandidateId: over.candidateId,\n\t\tproblemId: over.candidateRow.problem_id,\n\t\tresourceId: over.candidateRow.resource_id,\n\t\tbaseVersion: over.candidateRow.base_version,\n\t\tcaseResults: normalized,\n\t\tverdict: \"incomplete\",\n\t\t...(over.totalUsageRef === undefined ? {} : { totalUsageRef: over.totalUsageRef }),\n\t\tcreatedAt: over.now,\n\t\tupdatedAt: over.now,\n\t};\n\tconst candidateUsageRefs = JSON.parse(over.candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs =\n\t\tover.totalUsageRef !== undefined ? [...new Set([...candidateUsageRefs, over.totalUsageRef])] : candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tover.testPlanId,\n\t\t\t\tover.candidateId,\n\t\t\t\tover.candidateRow.problem_id,\n\t\t\t\tover.candidateRow.resource_id,\n\t\t\t\tover.candidateRow.base_version,\n\t\t\t\tJSON.stringify(normalized),\n\t\t\t\t\"incomplete\",\n\t\t\t\tover.totalUsageRef ?? null,\n\t\t\t\tover.now,\n\t\t\t\tover.now,\n\t\t\t);\n\t\tfor (const ref of over.sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tover.now,\n\t\t\t\t);\n\t\t}\n\t\tif (over.currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(over.now, over.candidateId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = 'cancelled', failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(`验证未完成:${over.reason}`, JSON.stringify(nextUsageRefs), over.now, over.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict: \"incomplete\",\n\t\tcaseResults: normalized,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 逐项评估候选：原问题改善且关键正常/保留样例通过才 passed。\n *\n * 判定：\n * - 任一 incomplete → 总体 incomplete（保留原因并停止发布）。\n * - reproduction 组未全部从失败到通过 → failed（即使总分提高也不宣称改善）。\n * - normal/holdout 组任一失败 → failed（关键用法退步）。\n * - reproduction+normal+holdout 全部通过 + 范围检查通过 → passed。\n *\n * 开发样例通过不直接标 passed（开发样例是 devCases，不是验收样例）。\n */\nexport function evaluateCandidate(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): MemoryResult<EvaluateCandidateResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst validationId = `val-${randomUUID()}`;\n\n\t// 1. 校验 candidate：必须存在且状态允许进入 testing。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, usage_refs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tusage_refs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.test_plan_id !== input.testPlanId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 登记的 testPlanId 与输入不一致`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst currentStatus = candidateRow.status as import(\"./types.ts\").EvolutionCandidateStatus;\n\tif (!isCandidateTransitionAllowed(currentStatus, \"testing\")) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 状态 ${currentStatus} 不允许进入 testing`,\n\t\t\tinput.candidateId,\n\t\t);\n\t}\n\n\t// 1b. O11/E06：核对冻结计划完整集合——plan 每个 caseId×side 都要有回执。\n\t// 空集、缺项、未知/重复 caseId 一律不接受（标 incomplete 不落 passed）。\n\tif (input.caseResults.length === 0) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`caseResults 为空集——空验收不允许 passed（E06：plan 每个 caseId 双侧回执必须齐全）`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst plan = readValidationPlan(input);\n\tconst completenessViolations: string[] = [];\n\tif (plan === undefined) {\n\t\tcompletenessViolations.push(\n\t\t\t`未提供 plan（注入 paoHome 或 plan 对象）且读不到 plan.json，无法核对完整集合`,\n\t\t);\n\t} else {\n\t\tconst expectedIds = planCaseIds(plan);\n\t\tconst seen = new Map<string, number>();\n\t\tfor (const r of input.caseResults) {\n\t\t\tseen.set(r.caseId, (seen.get(r.caseId) ?? 0) + 1);\n\t\t\tif (!expectedIds.includes(r.caseId)) {\n\t\t\t\tcompletenessViolations.push(`未知 caseId:${r.caseId}（不在冻结计划内）`);\n\t\t\t}\n\t\t}\n\t\tfor (const [caseId, count] of seen) {\n\t\t\tif (count > 1) completenessViolations.push(`重复 caseId:${caseId}（出现 ${count} 次）`);\n\t\t}\n\t\tfor (const caseId of expectedIds) {\n\t\t\tif (!seen.has(caseId)) completenessViolations.push(`缺 caseId:${caseId} 的回执（漏跑/未交付）`);\n\t\t}\n\t}\n\tif (completenessViolations.length > 0) {\n\t\t// 完整集合不齐 → 不落 passed：写一条 incomplete 验证记录并把候选标 cancelled。\n\t\treturn completeWithIncompleteVerdict(store, {\n\t\t\tcandidateId: input.candidateId,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tcandidateRow,\n\t\t\tcurrentStatus,\n\t\t\tcaseResults: input.caseResults,\n\t\t\treason: completenessViolations.join(\"；\"),\n\t\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\t\tsourceRefs: resolveValidationSourceRefs(store, input),\n\t\t\tnow,\n\t\t});\n\t}\n\n\t// 2. 逐项判定：环境失败标 incomplete；reproduction 组必须「失败→通过」才算改善。\n\t//    逐项 verdict 已由调用方给定（调用方跑完 baseline/candidate 后组装），\n\t//    这里核对每个 case 的判定一致性：若某项 baseline 也 passed，\n\t//    reproduction 组不能宣称「修复了原问题」。\n\tconst normalizedCaseResults: ValidationCaseResult[] = input.caseResults.map((result) => {\n\t\t// 环境失败统一标 incomplete（不画成业务失败或通过）。\n\t\tif (isEnvironmentFailure(result.baseline) || isEnvironmentFailure(result.candidate)) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\treason: result.reason ?? `环境/启动失败:${result.baseline.failureReason ?? result.candidate.failureReason ?? \"进程停止未确认\"}`,\n\t\t\t};\n\t\t}\n\t\t// 调用方已标 incomplete（不稳定/无法定论，如补做成对运行后仍矛盾）\n\t\t// 不升级为 failed——incomplete 是「证据不足」结论，不是「候选未过」；\n\t\t// 本层只对「调用方没下结论或结论与双侧结果矛盾」的项做判定。\n\t\tif (result.verdict === \"incomplete\") {\n\t\t\treturn { ...result, verdict: \"incomplete\" as const };\n\t\t}\n\t\t// reproduction 组：baseline 必须先真失败，candidate 后通过才算修复。\n\t\tif (result.caseId.startsWith(\"reproduction-\")) {\n\t\t\tif (result.baseline.passed === true) {\n\t\t\t\t// baseline 未失败——复现不了原问题，验证前提不成立，标 incomplete 而非宣称改善。\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\t\treason: result.reason ?? \"baseline 未复现原问题（baseline.passed=true），验证前提不成立\",\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (result.candidate.passed !== true) {\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\t\treason: result.reason ?? \"原问题未修复：候选未通过复现样例\",\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn { ...result, verdict: \"passed\" as const };\n\t\t}\n\t\t// normal / holdout 组：candidate 未通过即关键失败。\n\t\tif (result.candidate.passed !== true) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\treason: result.reason ?? `候选未通过${result.caseId.startsWith(\"normal-\") ? \"正常用法\" : \"保留\"}样例`,\n\t\t\t};\n\t\t}\n\t\treturn { ...result, verdict: \"passed\" as const };\n\t});\n\n\t// 3. 总体判定：任一 incomplete → incomplete；任一关键失败 → failed；全过 → passed。\n\tconst hasIncomplete = normalizedCaseResults.some((r) => r.verdict === \"incomplete\");\n\tconst hasFailed = normalizedCaseResults.some((r) => r.verdict === \"failed\");\n\tlet verdict: EvolutionValidation[\"verdict\"];\n\tif (hasIncomplete) {\n\t\tverdict = \"incomplete\";\n\t} else if (hasFailed) {\n\t\tverdict = \"failed\";\n\t} else {\n\t\tverdict = \"passed\";\n\t}\n\n\t// 补做成对运行后仍不稳定（有 incomplete）→ 不宣称改善，保留 incomplete 结论。\n\t// 调用方传入 repairedContradictions=true 时，若结果仍含 incomplete，\n\t// 说明证据不稳定，verdict 保持 incomplete（已由上面逻辑覆盖）。\n\n\tconst score = computeScore(normalizedCaseResults);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: input.testPlanId,\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\tcaseResults: normalizedCaseResults,\n\t\tverdict,\n\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\n\t// 4. 写库：evolution_validations 行 + evolution_source_links + 候选状态推进。\n\t//    完整费用归因到该候选（usage_refs_json 追加）。\n\tconst sourceRefs = resolveValidationSourceRefs(store, input);\n\tconst candidateUsageRefs = JSON.parse(candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs = input.totalUsageRef !== undefined\n\t\t? [...new Set([...candidateUsageRefs, input.totalUsageRef])]\n\t\t: candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\t// evolution_validations 行：候选 ID 此时已存在（外键满足）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tinput.candidateId,\n\t\t\t\tcandidateRow.problem_id,\n\t\t\t\tcandidateRow.resource_id,\n\t\t\t\tcandidateRow.base_version,\n\t\t\t\tJSON.stringify(normalizedCaseResults),\n\t\t\t\tverdict,\n\t\t\t\tinput.totalUsageRef ?? null,\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 来源关联：evolution_source_links owner_kind='validation'。\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\n\t\t// 候选状态推进：proposed → testing → passed | failed | cancelled。\n\t\t// 先推到 testing（若尚未在 testing），再推到终态。\n\t\tif (currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(now, input.candidateId);\n\t\t}\n\t\tconst nextCandidateStatus =\n\t\t\tverdict === \"passed\" ? \"passed\" : verdict === \"failed\" ? \"failed\" : \"cancelled\";\n\t\t// 状态机校验：testing → passed|failed|cancelled 全部合法。\n\t\tconst statusBeforeUpdate = currentStatus === \"proposed\" ? \"testing\" : currentStatus;\n\t\tif (!isCandidateTransitionAllowed(statusBeforeUpdate, nextCandidateStatus)) {\n\t\t\tthrow new Error(\n\t\t\t\t`候选 ${input.candidateId} 状态机不允许 ${statusBeforeUpdate} → ${nextCandidateStatus}`,\n\t\t\t);\n\t\t}\n\t\tconst failureReason =\n\t\t\tverdict === \"incomplete\"\n\t\t\t\t? `验证未完成:${normalizedCaseResults.find((r) => r.verdict === \"incomplete\")?.reason ?? \"环境/启动失败\"}`\n\t\t\t\t: verdict === \"failed\"\n\t\t\t\t\t? `验证失败:${normalizedCaseResults.find((r) => r.verdict === \"failed\")?.reason ?? \"业务结果不符\"}`\n\t\t\t\t\t: null;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = ?, failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(nextCandidateStatus, failureReason, JSON.stringify(nextUsageRefs), now, input.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict,\n\t\tcaseResults: normalizedCaseResults,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化任务绑定的宿主装配桥（S9-04/05 装配侧）。\n * * - 本模块只做解析与分流，不开 store、不碰 loader；store 由调用方开闭。\n */\nimport { existsSync } from \"node:fs\";\nimport type { MemoryResultMemoryStore } from \"../memory/types.tsstore.ts\";\nimport { bindTaskResources, listTaskBindings, resolveTaskResourceVersion, type TaskBinding } from \"./binding.ts\";\nimport { getResource } from \"./resources.ts\";\treturn resolveTaskBoundResourcePaths(store, { taskId: input.taskId, paoHome: input.paoHome });\n}\n","ops":[{"diffOp":{"equal":{"range":[0,82]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[82,220]}}},{"diffOp":{"equal":{"range":[220,235]}}},{"diffOp":{"delete":{"range":[235,247]}}},{"diffOp":{"insert":{"range":[247,258]}}},{"diffOp":{"equal":{"range":[258,277]}}},{"diffOp":{"delete":{"range":[277,285]}}},{"diffOp":{"insert":{"range":[285,293]}}},{"diffOp":{"equal":{"range":[293,295]}}},{"diffOp":{"equal":{"range":[220,235]}}},{"diffOp":{"delete":{"range":[247,258]}}},{"diffOp":{"insert":{"range":[235,247]}}},{"diffOp":{"equal":{"range":[258,277]}}},{"diffOp":{"delete":{"range":[285,293]}}},{"diffOp":{"insert":{"range":[277,285]}}},{"diffOp":{"equal":{"range":[293,295]}}},{"diffOp":{"equal":{"range":[295,455]}}},{"equalLines":{"line_count":175}},{"diffOp":{"equal":{"range":[455,553]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\host-mount.ts"},"span":[1080,1117],"sourceCode":"/**\n * 受控自进化任务绑定的宿主装配桥（S9-04/05 装配侧）。\n *\n * 职责：宿主（CLI createRuntime / 桌面 session-supervisor）在装配会话的\n * resourceLoaderOptions 前，把该任务的 active 绑定解析成要挂进加载链路的\n * 版本目录清单——按 `loadMethod` 分流到 skill/extension 两个通道，\n * 不参与绑定的其余四类 loadMethod 显式跳过并留痕。\n *\n * 契约：\n * - `taskId = sessionId`：绑定表按会话 ID 定位，宿主不改这个口径。\n * - 只接 `skill-path` / `extension-path` 两类；`template-file` /\n *   `command-registry` / `policy-resource` / `recipe-file` 不支持绑定换版，\n *   进 `skipped` 列表由调用方记诊断，不静默挂错通道。\n * - 绑定存在但版本目录缺失 → 进 `missing` 列表：调用方决定降级口径\n *   （本批宿主侧按「不挂 versionDir、沿用资源根 + 记诊断」处理，不伪装成\n *   已用绑定版本）。\n * - 本模块只做解析与分流，不开 store、不碰 loader；store 由调用方开闭。\n */\nimport { existsSync } from \"node:fs\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { bindTaskResources, listTaskBindings, resolveTaskResourceVersion, type TaskBinding } from \"./binding.ts\";\nimport { getResource } from \"./resources.ts\";\nimport type { EvolutionLoadMethod } from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一条已解析、可直接挂进加载链路的绑定版本。 */\nexport interface MountedTaskResource {\n\t/** 绑定行（含 bindingId，供 recordUsed 观察回传）。 */\n\tbinding: TaskBinding;\n\t/** 资源 ID。 */\n\tresourceId: string;\n\t/** 本任务固定使用的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录绝对路径。 */\n\tversionDir: string;\n\t/** 分流通道（本批只放行这两类）。 */\n\tloadMethod: \"skill-path\" | \"extension-path\";\n}\n\n/** 一条被跳过的绑定（loadMethod 不在本批支持范围）。 */\nexport interface SkippedTaskBinding {\n\tresourceId: string;\n\tloadMethod: EvolutionLoadMethod | \"unknown\";\n\treason: string;\n}\n\n/** 一条绑定存在但版本目录不可用的记录（调用方据此降级到资源根）。 */\nexport interface MissingTaskBinding {\n\tresourceId: string;\n\tversionId: string;\n\tversionDir: string;\n\treason: string;\n}\n\n/** `resolveTaskBoundResourcePaths` 的输出。 */\nexport interface TaskBoundResourcePaths {\n\t/** 可挂 additionalSkillPaths / prioritySkillPaths 的版本目录。 */\n\tskillPaths: string[];\n\t/** 可挂 additionalExtensionPaths / priorityExtensionPaths 的版本目录。 */\n\textensionPaths: string[];\n\t/** 已挂载明细（同序对应上面两数组的并集来源）。 */\n\tmounted: MountedTaskResource[];\n\t/** loadMethod 不支持、显式跳过的绑定。 */\n\tskipped: SkippedTaskBinding[];\n\t/** 绑定在但目录缺失、已降级的绑定。 */\n\tmissing: MissingTaskBinding[];\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. resolveTaskBoundResourcePaths\n// ════════════════════════════════════════════════════════════════════════\n\n/** 本批装配侧支持绑定换版的 loadMethod 集合；其余显式跳过。 */\nconst MOUNTABLE_LOAD_METHODS = new Set<EvolutionLoadMethod>([\"skill-path\", \"extension-path\"]);\n\n/**\n * 读任务的 active 绑定，按 loadMethod 分流成可挂加载链路的版本目录清单。\n *\n * - 无 active 绑定 → 返回全空清单（新任务的初始绑定由派发/激活流程触发，\n *   不在装配侧做全量资源登记）。\n * - 每条绑定先查资源登记拿 loadMethod：资源行缺失（登记被删但绑定残留）\n *   按 unknown 进 skipped，不猜通道。\n * - versionDir 由 `resolveTaskResourceVersion` 拼出；再用 existsSync 核对\n *   实际存在——运行中目录被删属环境故障，进 missing 由调用方降级，\n *   不把不存在的路径挂进加载链路伪装成已生效。\n */\nexport function resolveTaskBoundResourcePaths(\n\tstore: MemoryStore,\n\tinput: { taskId: string; paoHome: string },\n): MemoryResult<TaskBoundResourcePaths> {\n\tconst bindings = listTaskBindings(store, { taskId: input.taskId, activeOnly: true });\n\tif (!bindings.ok) return bindings;\n\n\tconst result: TaskBoundResourcePaths = {\n\t\tskillPaths: [],\n\t\textensionPaths: [],\n\t\tmounted: [],\n\t\tskipped: [],\n\t\tmissing: [],\n\t};\n\n\tfor (const binding of bindings.items) {\n\t\tconst resourceId = binding.resourceId;\n\n\t\tconst resource = getResource(store, resourceId);\n\t\tconst loadMethod: EvolutionLoadMethod | \"unknown\" = resource.ok ? resource.loadMethod : \"unknown\";\n\t\tif (!resource.ok || !MOUNTABLE_LOAD_METHODS.has(loadMethod as EvolutionLoadMethod)) {\n\t\t\t// 本批不支持绑定换版的四类：template-file / command-registry /\n\t\t\t// policy-resource / recipe-file；资源行缺失按 unknown 同样跳过。\n\t\t\tresult.skipped.push({\n\t\t\t\tresourceId,\n\t\t\t\tloadMethod,\n\t\t\t\treason: resource.ok\n\t\t\t\t\t? `loadMethod=${loadMethod} 不支持绑定换版（本批只接 skill-path/extension-path）`\n\t\t\t\t\t: `资源登记缺失（${resource.error.message}），无法确定 loadMethod`,\n\t\t\t});\n\t\t\tcontinue;\n\t\t}\n\n\t\tconst resolved = resolveTaskResourceVersion(store, {\n\t\t\ttaskId: input.taskId,\n\t\t\tresourceId,\n\t\t\tpaoHome: input.paoHome,\n\t\t});\n\t\tif (!resolved.ok) return resolved;\n\n\t\tif (!existsSync(resolved.versionDir)) {\n\t\t\tresult.missing.push({\n\t\t\t\tresourceId,\n\t\t\t\tversionId: resolved.versionId,\n\t\t\t\tversionDir: resolved.versionDir,\n\t\t\t\treason: `绑定版本目录不存在:${resolved.versionDir}（降级沿用资源根，不挂 versionDir）`,\n\t\t\t});\n\t\t\tcontinue;\n\t\t}\n\n\t\tconst mounted: MountedTaskResource = {\n\t\t\tbinding,\n\t\t\tresourceId,\n\t\t\tversionId: resolved.versionId,\n\t\t\tversionDir: resolved.versionDir,\n\t\t\tloadMethod: loadMethod as \"skill-path\" | \"extension-path\",\n\t\t};\n\t\tresult.mounted.push(mounted);\n\t\tif (mounted.loadMethod === \"skill-path\") {\n\t\t\tresult.skillPaths.push(resolved.versionDir);\n\t\t} else {\n\t\t\tresult.extensionPaths.push(resolved.versionDir);\n\t\t}\n\t}\n\n\treturn { ok: true, ...result };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. ensureTaskBindings（O13/E14：新任务初始绑定）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 新任务装配期的初始绑定：把「已登记且 effective_version 非空」的资源绑进\n * 本任务（或按显式 resourceIds 清单绑），落 task_bindings 行后再解析成\n * 可挂加载链路的版本目录清单。\n *\n * 口径（O13/E14）：\n * - `resourceIds` 缺省 = 主会话口径：全量已生效资源都绑（语义是「本任务若用\n *   该资源就固定用这个版本」——绑了但会话没装该资源不算伪造使用）；\n *   显式传入 = 派发口径：只绑本任务实际会装载的受控技能。\n * - bindTaskResources 同事务整批：任一资源无 effective_version 即全拒——\n *   调用方按「已登记+effective 非空」传清单，残余失败（竞态删除）由宿主\n *   决定（主会话上抛、派发记警告不拒派）。\n * - 已有绑定的任务重进 ensure：bindTaskResources 对 (task_id, resource_id)\n *   冲突行走 UPDATE 同行 reset active=1（恢复会话语义），不另建行。\n * - 落绑定后返回 resolveTaskBoundResourcePaths 同形结果，宿主零分叉。\n */\nexport function ensureTaskBindings(\n\tstore: MemoryStore,\n\tinput: { taskId: string; paoHome: string; resourceIds?: string[] },\n): MemoryResult<TaskBoundResourcePaths> {\n\tlet resourceIds = input.resourceIds;\n\tif (resourceIds === undefined) {\n\t\t// 主会话口径：全量已生效资源。读库失败如实上抛（绑定读不出来时静默\n\t\t// 降级会让会话拿错版本无留痕）。\n\t\tconst rows = store.db\n\t\t\t.prepare(`SELECT resource_id FROM evolution_resources WHERE effective_version IS NOT NULL`)\n\t\t\t.all() as Array<{ resource_id: string }>;\n\t\tresourceIds = rows.map((r) => r.resource_id);\n\t}\n\tif (resourceIds.length > 0) {\n\t\tconst bound = bindTaskResources(store, {\n\t\t\ttaskId: input.taskId,\n\t\t\tresourceIds,\n\t\t});\n\t\tif (!bound.ok) return bound;\n\t}\n\treturn resolveTaskBoundResourcePaths(store, { taskId: input.taskId, paoHome: input.paoHome });\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *import { existsSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tisCandidateTransitionAllowedtype EvolutionCandidateStatus,\n\t,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,76]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[76,233]}}},{"diffOp":{"equal":{"range":[233,241]}}},{"diffOp":{"delete":{"range":[241,246]}}},{"diffOp":{"equal":{"range":[246,247]}}},{"diffOp":{"delete":{"range":[247,260]}}},{"diffOp":{"equal":{"range":[247,248]}}},{"diffOp":{"delete":{"range":[260,272]}}},{"diffOp":{"insert":{"range":[272,286]}}},{"diffOp":{"equal":{"range":[286,305]}}},{"diffOp":{"delete":{"range":[305,313]}}},{"diffOp":{"insert":{"range":[313,321]}}},{"diffOp":{"equal":{"range":[321,323]}}},{"diffOp":{"equal":{"range":[323,378]}}},{"diffOp":{"equal":{"range":[323,331]}}},{"diffOp":{"insert":{"range":[241,246]}}},{"diffOp":{"equal":{"range":[378,380]}}},{"diffOp":{"delete":{"range":[272,286]}}},{"diffOp":{"insert":{"range":[380,405]}}},{"diffOp":{"equal":{"range":[286,305]}}},{"diffOp":{"delete":{"range":[313,321]}}},{"diffOp":{"insert":{"range":[305,313]}}},{"diffOp":{"equal":{"range":[321,323]}}},{"diffOp":{"equal":{"range":[405,416]}}},{"diffOp":{"delete":{"range":[416,444]}}},{"diffOp":{"insert":{"range":[444,473]}}},{"diffOp":{"equal":{"range":[473,476]}}},{"diffOp":{"delete":{"range":[444,473]}}},{"diffOp":{"insert":{"range":[416,444]}}},{"diffOp":{"equal":{"range":[476,498]}}},{"diffOp":{"equal":{"range":[498,719]}}},{"equalLines":{"line_count":758}},{"diffOp":{"equal":{"range":[719,813]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\observe.ts"},"span":[1203,1244],"sourceCode":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *\n * 职责：\n * - **来源删除处理**：沿 `evolution_source_links` 清除候选输入/回执里的目标正文；\n *   清理未完成保持未完成状态，只保留排除所需定位。\n * - **依据失效/基础版本过期处理**：纠正、停用或 baseVersion 变动导致依据失效时标待重评估；\n *   **旧候选不得直接重新排发布**。\n * - **观察骨架**：viewed/used/patched 三态计数与关联（S9-06 才接 taskBinding，\n *   本阶段先落数据结构与只读计数入口）。\n * - **验证失败/取消/额度不足分别写状态**，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n *\n * 契约（S8 任务书 §5 / 计划 §S8-11）：\n * - 清理未完成保持未完成状态，只保留排除所需定位（sourceId/候选 ID/版本号）。\n * - 旧候选不绕过删除及纠正语义重新入库；依据失效的旧候选不重新排发布。\n * - 来源删除时沿关联清除候选输入中的目标正文（evidenceRefs、devCases 引用）。\n * - `passed ≠ active`；本阶段不自动发布正式资源。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCandidateStatus,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 0. outcome 编码约定（S9-06）\n// ════════════════════════════════════════════════════════════════════════\n//\n// `evolution_observations` 表无 outcome 列；`recordUsed` 的成败编进\n// `receipt_ref` 前缀：`<outcome>:<回执引用>`（outcome ∈ success|failure）。\n// 选前缀而不加列：CREATE TABLE IF NOT EXISTS 不能给已有库追加列，加列要另走\n// ALTER 迁移；当前 outcome 只被 countUsageByVersion 读，前缀方案改动最小。\n// 无 outcome 的 used 行（receipt_ref 无前缀或为空）不计入 success/failure。\nconst OUTCOME_PREFIXES = [\"success\", \"failure\"] as const;\ntype UsedOutcome = (typeof OUTCOME_PREFIXES)[number];\n\n/** 把 outcome 编进 receipt_ref；无 outcome 或无回执时原样返回。 */\nfunction encodeReceiptRef(receiptRef: string | undefined, outcome: UsedOutcome | undefined): string | undefined {\n\tif (outcome === undefined) return receiptRef;\n\treturn `${outcome}:${receiptRef ?? \"\"}`;\n}\n\n/** 从 receipt_ref 拆 outcome；无前缀 → undefined（不算成功/失败）。 */\nexport function decodeObservationOutcome(receiptRef: string | null): UsedOutcome | undefined {\n\tif (receiptRef === null) return undefined;\n\tfor (const prefix of OUTCOME_PREFIXES) {\n\t\tif (receiptRef.startsWith(`${prefix}:`)) return prefix;\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 来源删除：沿关联清理候选输入/回执里的目标正文\n// ════════════════════════════════════════════════════════════════════════\n\n/** `cleanupSourceReferences` 的输入。 */\nexport interface CleanupSourceReferencesInput {\n\t/** 被删除/排除的来源 ID。 */\n\tsourceId: string;\n\t/** 清理时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 是否保留最小定位（默认 true：保留 sourceId/候选 ID，清正文）。 */\n\tkeepExclusionLocator?: boolean;\n}\n\n/** `cleanupSourceReferences` 的输出。 */\nexport interface CleanupSourceReferencesResult {\n\t/** 被清理的问题数。 */\n\tproblemsCleaned: number;\n\t/** 被清理的候选数（状态被标 cancelled 或内容被清除）。 */\n\tcandidatesCleaned: number;\n\t/** 被清理的验证数（未完成验证保留 incomplete，已完成的不动）。 */\n\tvalidationsCleaned: number;\n\t/** 仍保持未完成状态的对象（清理无法完成时）。 */\n\tpendingObjects: Array<{ kind: \"problem\" | \"candidate\" | \"validation\"; id: string; reason: string }>;\n}\n\n/**\n * 沿 `evolution_source_links` 清除来源删除后残留的目标正文（db 级，无自身事务）。\n *\n * 供两处调用：\n * - 外层 `cleanupSourceReferences`（包 store.transaction 的公开 API，兼容旧调用）；\n * - `memory/deletion.ts applyDatabasePlan` 的事务内（store.transaction 是裸\n *   BEGIN IMMEDIATE 不能嵌套，故拆出本函数）。\n *\n * 对每个关联对象（O12/E11 清理范围扩到受管正文与盘文件）：\n * - **problem**：缩减 evidenceRefs；若全部证据被清空，summary/reason/\n *   expected/actual 是受该来源支撑的受管正文——清空标 `[cleared]`，\n *   状态回 pending_classification 待重新分类（依据已失效）。清不掉记 limitation。\n * - **candidate**：未终态的取消（不再排发布），failureReason 注明来源已删除；\n *   受该来源支撑的 diffs/rationale 是受管正文——清空为 `[]`/`[cleared]`；\n *   传了 paoHome 时候选目录盘文件按既有删除惯例 rmSync 移除（不再作为可发布\n *   内容）。已 passed/failed 的不改状态但同样清受管正文与盘文件。\n * - **validation**：owner_id 为 tp-*（冻结计划）时 plan.json 重写标 invalidated\n *   （来源已删除，验收依据失效）；owner_id 为 val-*（运行验证）时已完成的保留\n *   结论，未完成保持 incomplete。\n *\n * 清理未完成保持未完成状态，只保留排除所需定位；清不掉的如实计\n * pendingObjects（limitation），不伪装成功。\n */\nexport function dbCleanupSourceReferences(\n\tdb: DatabaseSync,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): CleanupSourceReferencesResult {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst keepLocator = input.keepExclusionLocator ?? true;\n\tconst pendingObjects: CleanupSourceReferencesResult[\"pendingObjects\"] = [];\n\n\t// 1. 查该来源关联的全部对象。\n\tconst links = db\n\t\t.prepare(\n\t\t\t`SELECT link_id, owner_kind, owner_id FROM evolution_source_links\n\t\t\t WHERE source_id = ?`,\n\t\t)\n\t\t.all(input.sourceId) as Array<{ link_id: string; owner_kind: string; owner_id: string }>;\n\n\tlet problemsCleaned = 0;\n\tlet candidatesCleaned = 0;\n\tlet validationsCleaned = 0;\n\t// 候选目录清理要去重（同一候选可能多条 links 指向该来源）。\n\tconst cleanedCandidateDirs = new Set<string>();\n\n\tfor (const link of links) {\n\t\tif (link.owner_kind === \"problem\") {\n\t\t\t// problem：缩减 evidenceRefs（只保留非本来源的引用）。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT evidence_refs_json FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t\t.get(link.owner_id) as { evidence_refs_json: string } | undefined;\n\t\t\tif (row) {\n\t\t\t\tconst refs = JSON.parse(row.evidence_refs_json) as string[];\n\t\t\t\tconst remaining = refs.filter((r) => r !== input.sourceId);\n\t\t\t\tif (remaining.length < refs.length) {\n\t\t\t\t\tif (remaining.length === 0) {\n\t\t\t\t\t\t// 全部证据被清空：summary/reason/expected/actual 是受该来源支撑\n\t\t\t\t\t\t// 的受管正文——清空标 [cleared]，状态回 observed + disposition\n\t\t\t\t\t\t// pending_classification（重新分类的起点；'pending_classification'\n\t\t\t\t\t\t// 是 disposition 值，不是 status 合法值——CHECK 约束拒绝）。\n\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t\t\t\t\t SET evidence_refs_json = '[]', summary = '[cleared]',\n\t\t\t\t\t\t\t\t     reason = NULL, expected_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     actual_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     status = 'observed', disposition = 'pending_classification', updated_at = ?\n\t\t\t\t\t\t\t\t WHERE problem_id = ?`,\n\t\t\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\t\tkind: \"problem\",\n\t\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t} else {\n\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t`UPDATE evolution_problems SET evidence_refs_json = ?, updated_at = ? WHERE problem_id = ?`,\n\t\t\t\t\t\t).run(JSON.stringify(remaining), now, link.owner_id);\n\t\t\t\t\t}\n\t\t\t\t\tproblemsCleaned += 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 删除该 link（排除所需定位已由 keepLocator 控制）。\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"candidate\") {\n\t\t\t// candidate：未终态的取消（不再排发布）；受管正文清空 + 盘文件移除。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT status, resource_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t.get(link.owner_id) as { status: string; resource_id: string } | undefined;\n\t\t\tif (row && row.status !== \"passed\" && row.status !== \"failed\" && row.status !== \"cancelled\") {\n\t\t\t\tconst reason = `来源 ${input.sourceId} 已删除，候选依据失效`;\n\t\t\t\tdb.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates SET status = 'cancelled', failure_reason = ?, updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t).run(reason, now, link.owner_id);\n\t\t\t\tcandidatesCleaned += 1;\n\t\t\t}\n\t\t\tif (row) {\n\t\t\t\t// 受管正文：diffs_json/rationale 是该来源支撑的内容——清空标 [cleared]。\n\t\t\t\ttry {\n\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t`UPDATE evolution_candidates SET diffs_json = '[]', rationale = '[cleared]', updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\t// 盘文件：候选目录按既有删除惯例移除（去重防重复 rm）。\n\t\t\t\tif (input.paoHome !== undefined && !cleanedCandidateDirs.has(link.owner_id)) {\n\t\t\t\t\tcleanedCandidateDirs.add(link.owner_id);\n\t\t\t\t\tconst dirSafeResourceId = row.resource_id.replace(/:/g, \"_\");\n\t\t\t\t\tconst candidateDir = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).candidates,\n\t\t\t\t\t\tdirSafeResourceId,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(candidateDir)) {\n\t\t\t\t\t\t\trmSync(candidateDir, { recursive: true, force: true });\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `候选目录清理失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"validation\") {\n\t\t\t// validation 两类 owner：testPlanId（tp-*，冻结计划）与 validationId\n\t\t\t// （val-*，运行验证）。已完成的保留结论；未完成保持 incomplete。\n\t\t\tif (link.owner_id.startsWith(\"tp-\")) {\n\t\t\t\t// testPlan 形态：plan.json 重写标 invalidated（验收依据已失效）。\n\t\t\t\tif (input.paoHome !== undefined) {\n\t\t\t\t\tconst planPath = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).validations,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t\t\"plan.json\",\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(planPath)) {\n\t\t\t\t\t\t\tlet planJson: unknown = {};\n\t\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\t\tplanJson = JSON.parse(readFileSync(planPath, \"utf8\"));\n\t\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\t\t// plan.json 已损坏：仍写 invalidated 包装。\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tconst invalidated = {\n\t\t\t\t\t\t\t\tinvalidated: true,\n\t\t\t\t\t\t\t\tinvalidatedReason: `来源 ${input.sourceId} 已删除，验收依据失效`,\n\t\t\t\t\t\t\t\tinvalidatedAt: now,\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t\twriteFileSync(\n\t\t\t\t\t\t\t\tplanPath,\n\t\t\t\t\t\t\t\tJSON.stringify(\n\t\t\t\t\t\t\t\t\ttypeof planJson === \"object\" && planJson !== null\n\t\t\t\t\t\t\t\t\t\t? { ...(planJson as Record<string, unknown>), ...invalidated }\n\t\t\t\t\t\t\t\t\t\t: invalidated,\n\t\t\t\t\t\t\t\t\tnull,\n\t\t\t\t\t\t\t\t\t2,\n\t\t\t\t\t\t\t\t),\n\t\t\t\t\t\t\t\t\"utf8\",\n\t\t\t\t\t\t\t);\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `plan.json 标 invalidated 失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t} else {\n\t\t\t\tconst row = db\n\t\t\t\t\t.prepare(`SELECT verdict FROM evolution_validations WHERE validation_id = ?`)\n\t\t\t\t\t.get(link.owner_id) as { verdict: string } | undefined;\n\t\t\t\tif (row && row.verdict === \"incomplete\") {\n\t\t\t\t\t// 未完成验证保持 incomplete（清理未完成保持未完成状态）。\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: \"验证未完成，保留 incomplete 状态供排除定位\",\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t}\n\t}\n\n\treturn {\n\t\tproblemsCleaned,\n\t\tcandidatesCleaned,\n\t\tvalidationsCleaned,\n\t\tpendingObjects,\n\t};\n}\n\n/**\n * `cleanupSourceReferences` 的公开 API：包 store.transaction 调 db 级实现。\n * 兼容旧调用（不带 paoHome 时跳过盘文件清理，只清库内受管正文与 links）。\n */\nexport function cleanupSourceReferences(\n\tstore: MemoryStore,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): MemoryResult<CleanupSourceReferencesResult> {\n\treturn store.transaction(() => ({ ok: true, ...dbCleanupSourceReferences(store.db, input) }));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 依据失效/基础版本过期：标待重评估\n// ════════════════════════════════════════════════════════════════════════\n\n/** `markStaleCandidates` 的输入。 */\nexport interface MarkStaleCandidatesInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 当前基础版本（新的 baseVersion；旧候选的 baseVersion 若与此不同即过期）。 */\n\tcurrentBaseVersion: string;\n\t/** 判定时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 具体失效原因（可选，人读）。 */\n\treason?: string;\n}\n\n/** `markStaleCandidates` 的输出。 */\nexport interface MarkStaleCandidatesResult {\n\t/** 被标过期的候选数。 */\n\tstaleCount: number;\n\t/** 被标过期的候选 ID。 */\n\tstaleCandidateIds: string[];\n}\n\n/**\n * 基础版本变动导致依据失效时标待重评估。\n *\n * 规则：\n * - 同 resourceId 下 base_version ≠ currentBaseVersion 的候选，\n *   若状态为 proposed/testing（未终态），标为 cancelled，\n *   failureReason 注明「基础版本已变动，待重评估」。\n * - **旧候选不得直接重新排发布**：即使回到同一 baseVersion，\n *   旧候选的验证证据已失效，不自动恢复为 proposed。\n */\nexport function markStaleCandidates(\n\tstore: MemoryStore,\n\tinput: MarkStaleCandidatesInput,\n): MemoryResult<MarkStaleCandidatesResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst reason = input.reason ?? `基础版本已变动:${input.currentBaseVersion}，待重评估`;\n\n\treturn store.transaction(() => {\n\t\tconst staleRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT candidate_id, base_version, status FROM evolution_candidates\n\t\t\t\t WHERE resource_id = ? AND base_version != ? AND status IN ('proposed', 'testing')`,\n\t\t\t)\n\t\t\t.all(input.resourceId, input.currentBaseVersion) as Array<{\n\t\t\tcandidate_id: string;\n\t\t\tbase_version: string;\n\t\t\tstatus: string;\n\t\t}>;\n\n\t\tfor (const row of staleRows) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\n\t\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t\t)\n\t\t\t\t.run(`${reason}（旧候选不得直接重新排发布）`, now, row.candidate_id);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstaleCount: staleRows.length,\n\t\t\tstaleCandidateIds: staleRows.map((r) => r.candidate_id),\n\t\t};\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 观察骨架：viewed/used/patched 三态计数与关联\n// ════════════════════════════════════════════════════════════════════\n\n/** 观察动作三态（S9-06 才接 taskBinding，本阶段先落计数入口）。 */\nexport const EVOLUTION_OBSERVATION_ACTIONS = [\n\t/** 查看详情是 viewed。 */\n\t\"viewed\",\n\t/** 任务明确选择该技能并引用 taskBinding 是 used（S9-06 接入）。 */\n\t\"used\",\n\t/** 新版本发布是 patched（S9 接入）。 */\n\t\"patched\",\n] as const;\n\nexport type EvolutionObservationAction = (typeof EVOLUTION_OBSERVATION_ACTIONS)[number];\n\n/** 一条观察记录。 */\nexport interface EvolutionObservation {\n\t/** 观察 ID。 */\n\tobservationId: string;\n\t/** 观察动作。 */\n\taction: EvolutionObservationAction;\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 关联的版本 ID（used 时为 taskBinding 绑定的 versionId；patched 时为新版本）。 */\n\tversionId?: string;\n\t/** 关联候选 ID（viewed 详情时定位候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 关联任务 ID（S9-06 接 taskBinding 后填充）。 */\n\ttaskId?: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/** 执行回执引用（used 时关联成功/失败）。 */\n\treceiptRef?: string;\n\t/** 观察时间。 */\n\tcreatedAt: string;\n}\n\n/** `recordEvolutionObservation` 的输入。 */\nexport interface RecordEvolutionObservationInput {\n\taction: EvolutionObservationAction;\n\tresourceId: string;\n\tversionId?: string;\n\tcandidateId?: string;\n\tproblemId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\treceiptRef?: string;\n\tcreatedAt?: string;\n}\n\n/** `recordEvolutionObservation` 的输出。 */\nexport interface RecordEvolutionObservationResult {\n\tobservationId: string;\n}\n\n/**\n * 记录一次资源观察（只读计数入口；S9-06 接 taskBinding）。\n *\n * - `viewed`：详情查看，关联 candidateId/problemId。\n * - `used`：实际使用（S9-06 才有 taskBinding），关联 versionId + receiptRef；\n *   本阶段只登记数据，不关联执行回执。\n * - `patched`：新版本发布（S9 接入），关联 versionId。\n *\n * 只有带实际执行回执的 used 才可关联成功/失败；仅资源已加载不能算实际采用。\n */\nexport function recordEvolutionObservation(\n\tstore: MemoryStore,\n\tinput: RecordEvolutionObservationInput,\n): MemoryResult<RecordEvolutionObservationResult> {\n\tif (!EVOLUTION_OBSERVATION_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知观察动作:${String(input.action)}`, String(input.action));\n\t}\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst observationId = `obs-${randomUUID()}`;\n\n\t// 观察落 evolution_observations 表（SCHEMA_SQL 建表；S9-06 接 taskBinding\n\t// 时复用同一表）。表缺失属环境异常，直接抛出不伪装成功。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_observations (\n\t\t\t\tobservation_id, action, resource_id, version_id, candidate_id, problem_id,\n\t\t\t\ttask_id, session_id, receipt_ref, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tobservationId,\n\t\t\tinput.action,\n\t\t\tinput.resourceId,\n\t\t\tinput.versionId ?? null,\n\t\t\tinput.candidateId ?? null,\n\t\t\tinput.problemId ?? null,\n\t\t\tinput.taskId ?? null,\n\t\t\tinput.sessionId ?? null,\n\t\t\tinput.receiptRef ?? null,\n\t\t\tnow,\n\t\t);\n\n\treturn { ok: true, observationId };\n}\n\n/** `countEvolutionObservations` 的输入。 */\nexport interface CountEvolutionObservationsInput {\n\tresourceId: string;\n\t/** 按动作过滤；缺省返回三态汇总。 */\n\taction?: EvolutionObservationAction;\n\t/** 按候选过滤。 */\n\tcandidateId?: string;\n\t/** 按版本过滤。 */\n\tversionId?: string;\n\t/** 按任务过滤（S9-06 后有效）。 */\n\ttaskId?: string;\n}\n\n/** `countEvolutionObservations` 的输出。 */\nexport interface CountEvolutionObservationsResult {\n\t/** 三态各自计数。 */\n\tcounts: Record<EvolutionObservationAction, number>;\n\t/** 总观察数。 */\n\ttotal: number;\n\t/** 是否从持久化表读取（恒为 true：SCHEMA_SQL 保证表存在）。 */\n\tpersisted: boolean;\n}\n\n/**\n * 只读观察计数：按 resourceId 汇总 viewed/used/patched 三态。\n *\n * 数据来自 SCHEMA_SQL 建的 evolution_observations 表；表缺失属环境异常，直接抛出。\n */\nexport function countEvolutionObservations(\n\tstore: MemoryStore,\n\tinput: CountEvolutionObservationsInput,\n): MemoryResult<CountEvolutionObservationsResult> {\n\tconst where: string[] = [\"resource_id = ?\"];\n\tconst params: unknown[] = [input.resourceId];\n\tif (input.action !== undefined) {\n\t\twhere.push(\"action = ?\");\n\t\tparams.push(input.action);\n\t}\n\tif (input.candidateId !== undefined) {\n\t\twhere.push(\"candidate_id = ?\");\n\t\tparams.push(input.candidateId);\n\t}\n\tif (input.versionId !== undefined) {\n\t\twhere.push(\"version_id = ?\");\n\t\tparams.push(input.versionId);\n\t}\n\tif (input.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(input.taskId);\n\t}\n\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, COUNT(*) AS n FROM evolution_observations\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t GROUP BY action`,\n\t\t)\n\t\t.all(...(params as never[])) as Array<{ action: string; n: number }>;\n\n\tconst counts: Record<EvolutionObservationAction, number> = {\n\t\tviewed: 0,\n\t\tused: 0,\n\t\tpatched: 0,\n\t};\n\tlet total = 0;\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\" || row.action === \"used\" || row.action === \"patched\") {\n\t\t\tcounts[row.action] = row.n;\n\t\t\ttotal += row.n;\n\t\t}\n\t}\n\treturn { ok: true, counts, total, persisted: true };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. S9-06：used / patched 写入入口与按版本计数\n// ════════════════════════════════════════════════════════════════════════\n\n/** `recordUsed` 的输入。 */\nexport interface RecordUsedInput {\n\t/** 被使用的资源 ID。 */\n\tresourceId: string;\n\t/** 实际使用该资源的任务 ID。 */\n\ttaskId: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/**\n\t * 使用的版本 ID；缺省取该任务对该资源的 active 绑定值。\n\t * 显式传值但 ≠ 绑定值 → 照实记录，返回 `versionMismatch:true` 供调用方区分\n\t * （绑定版本与实际加载版本不一致属宿主装配问题，不归因到绑定版本）。\n\t */\n\tversionId?: string;\n\t/** 执行回执引用（用于关联成功/失败与定位日志）。 */\n\treceiptRef?: string;\n\t/** 使用结果；写入时编进 receipt_ref 前缀（见文件头约定）。 */\n\toutcome?: \"success\" | \"failure\";\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `recordUsed` 的输出。 */\nexport interface RecordUsedResult {\n\tobservationId: string;\n\t/** 实际落库的 versionId（缺省时取自绑定）。 */\n\tversionId: string;\n\t/** 显式传入的 versionId 与绑定值不一致时为 true（照实记录，不归因绑定版）。 */\n\tversionMismatch: boolean;\n}\n\n/**\n * 记一次实际使用（action='used'）。\n *\n * 校验「已加载 ≠ 实际采用」：必须存在该 (taskId, resourceId) 的 active\n * task_binding 才写；绑定不存在或已停用 → 业务错误（invalid_input），不硬写。\n * 「未使用候选的错误不归因」即由此保证：无绑定任务的失败不进 observations。\n */\nexport function recordUsed(\n\tstore: MemoryStore,\n\tinput: RecordUsedInput,\n): MemoryResult<RecordUsedResult> {\n\tif (input.outcome !== undefined && !OUTCOME_PREFIXES.includes(input.outcome)) {\n\t\treturn fail(\"invalid_input\", `未知 outcome:${String(input.outcome)}`, input.resourceId);\n\t}\n\tconst binding = store.db\n\t\t.prepare(\n\t\t\t`SELECT version_id, active FROM evolution_task_bindings\n\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as { version_id: string; active: number } | undefined;\n\tif (!binding) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}：已加载 ≠ 实际采用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tif (binding.active !== 1) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst versionId = input.versionId ?? binding.version_id;\n\tconst versionMismatch = input.versionId !== undefined && input.versionId !== binding.version_id;\n\n\tconst written = recordEvolutionObservation(store, {\n\t\taction: \"used\",\n\t\tresourceId: input.resourceId,\n\t\tversionId,\n\t\ttaskId: input.taskId,\n\t\t...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),\n\t\treceiptRef: encodeReceiptRef(input.receiptRef, input.outcome),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n\tif (!written.ok) return { ok: false, error: written.error };\n\treturn { ok: true, observationId: written.observationId, versionId, versionMismatch };\n}\n\n/** `recordPatched` 的输入。 */\nexport interface RecordPatchedInput {\n\t/** 被发布的资源 ID。 */\n\tresourceId: string;\n\t/** 新发布/新生效的版本 ID。 */\n\tversionId: string;\n\t/** 关联候选 ID（activation 路径可定位到候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/**\n * 记一次版本发布/生效（action='patched'）。\n *\n * 由 activation.ts `activateCandidate` 成功事务内调用（同事务：patched 是\n * 生效历史的一部分，activation 行与 used/patched 观察同生同死）；也可由\n * 宿主在其他生效路径（restore 等）调用。本函数只 INSERT 一行观察，不开\n * 自己的事务——调用方决定事务边界。\n */\nexport function recordPatched(\n\tstore: MemoryStore,\n\tinput: RecordPatchedInput,\n): MemoryResult<{ observationId: string }> {\n\treturn recordEvolutionObservation(store, {\n\t\taction: \"patched\",\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.versionId,\n\t\t...(input.candidateId === undefined ? {} : { candidateId: input.candidateId }),\n\t\t...(input.problemId === undefined ? {} : { problemId: input.problemId }),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n}\n\n/** `countUsageByVersion` 的输出。 */\nexport interface UsageByVersionCounts {\n\t/** 三态各自计数。 */\n\tviewed: number;\n\tused: number;\n\tpatched: number;\n\t/** used 行中 outcome=success 的计数（receipt_ref 前缀解析）。 */\n\tsuccess: number;\n\t/** used 行中 outcome=failure 的计数。 */\n\tfailure: number;\n}\n\n/**\n * 按 (resourceId, versionId) 汇总观察计数（界面「实际观察」区用）。\n *\n * success/failure 从 used 行的 receipt_ref 前缀解析（见文件头约定）；\n * 无 outcome 的 used 行只计入 used 总数，不进 success/failure。\n */\nexport function countUsageByVersion(\n\tstore: MemoryStore,\n\tinput: { resourceId: string; versionId: string },\n): MemoryResult<UsageByVersionCounts> {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, receipt_ref FROM evolution_observations\n\t\t\t WHERE resource_id = ? AND version_id = ?`,\n\t\t)\n\t\t.all(input.resourceId, input.versionId) as Array<{ action: string; receipt_ref: string | null }>;\n\n\tconst counts: UsageByVersionCounts = { viewed: 0, used: 0, patched: 0, success: 0, failure: 0 };\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\") counts.viewed += 1;\n\t\telse if (row.action === \"patched\") counts.patched += 1;\n\t\telse if (row.action === \"used\") {\n\t\t\tcounts.used += 1;\n\t\t\tconst outcome = decodeObservationOutcome(row.receipt_ref);\n\t\t\tif (outcome === \"success\") counts.success += 1;\n\t\t\telse if (outcome === \"failure\") counts.failure += 1;\n\t\t}\n\t}\n\treturn { ok: true, ...counts };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 必要来源失效检测（O12/E11 可复用 helper）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `checkOwnerSourceLinksIntact` 的输入。 */\nexport interface OwnerSourceLinkCheckInput {\n\t/** owner 清单（按 problem→candidate→testPlan→validation 顺序给出最直观）。 */\n\towners: Array<{ ownerKind: \"problem\" | \"candidate\" | \"validation\"; ownerId: string; label: string }>;\n}\n\n/**\n * 核对一组 owner 的 source links 仍有效（必要来源失效检测）。\n *\n * 与 activation.ts checkSourceLinksIntact / control.ts\n * checkRestoreSourceLinksIntact 同口径——供 publish 门、activation、control\n * 三处共用，避免各写一份发散：\n * - 任一 owner 没有任何 link 行 → 返回「{label}没有登记任何来源关联」；\n * - src- 前缀 link 查 sources 行存在、source_exclusions 无命中；\n * - 带 memory_id 的 link 查 memories 行存在且 current_revision ≥ link.revision。\n * 返回首个失效原因；全部有效返回 undefined。\n */\nexport function checkOwnerSourceLinksIntact(\n\tdb: DatabaseSync,\n\tinput: OwnerSourceLinkCheckInput,\n): string | undefined {\n\tconst memoryCheck = db.prepare(`SELECT id, current_revision FROM memories WHERE id = ?`);\n\tconst sourceCheck = db.prepare(`SELECT source_id FROM sources WHERE source_id = ?`);\n\tconst exclusionCheck = db.prepare(\n\t\t`SELECT 1 AS hit FROM source_exclusions WHERE source_id = ? LIMIT 1`,\n\t);\n\tfor (const owner of input.owners) {\n\t\tconst links = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(owner.ownerKind, owner.ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\t\tif (links.length === 0) {\n\t\t\treturn `${owner.label}没有登记任何来源关联（空关联不能代替有效依据）`;\n\t\t}\n\t\tfor (const link of links) {\n\t\t\tif (link.source_id.startsWith(\"src-\") && !sourceCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被删除`;\n\t\t\t}\n\t\t\tif (exclusionCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被排除`;\n\t\t\t}\n\t\t\tif (link.memory_id !== null) {\n\t\t\t\tconst mem = memoryCheck.get(link.memory_id) as\n\t\t\t\t\t| { id: string; current_revision: number }\n\t\t\t\t\t| undefined;\n\t\t\t\tif (!mem) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 已被删除排除`;\n\t\t\t\t}\n\t\t\t\tif (link.revision !== null && mem.current_revision < link.revision) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 当前修订 r${mem.current_revision} 低于关联修订 r${link.revision}`;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *import type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\t isCandidateTransitionAllowed,type EvolutionCandidateStatus,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\t\t\t\t\tcleanedCandidateDirs.add(link.owner_id);\n\t\t\t\t\tconst dirSafeResourceId = row.resource_id.replace(/:/g, \"_\");\n\t\t\t\t\tconst candidateDir = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).candidates,dirSafeResourceId,link.owner_id,\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(candidateDir)) {\t\t\t\t// testPlan 形态：plan.json 重写标 invalidated（验收依据已失效）。\n\t\t\t\tif (input.paoHome !== undefined) {\n\t\t\t\t\tconst planPath = join(evolutionPaths(input.paoHome).validations,link.owner_id,\"plan.json\");\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(planPath)) { * 「未使用候选的错误不归因」即由此保证：无绑定任务的失败不进 observations。\n */\nexport function recordUsed(store: MemoryStore,input: RecordUsedInput): MemoryResult<RecordUsedResult> {\n\tif (input.outcome !== undefined && !OUTCOME_PREFIXES.includes(input.outcome)) {\n\t\treturn fail(\"invalid_input\", `未知 outcome:${String(input.outcome)}`, input.resourceId); * 自己的事务——调用方决定事务边界。\n */\nexport function recordPatched(input: RecordPatchedInput): MemoryResult<{ observationId: string }> {\n\treturn recordEvolutionObservation(store, {\n\t\taction: \"patched\", * 返回首个失效原因；全部有效返回 undefined。\n */\nexport function checkOwnerSourceLinksIntact(db: DatabaseSync,input: OwnerSourceLinkCheckInput): string | undefined {\n\tconst memoryCheck = db.prepare(`SELECT id, current_revision FROM memories WHERE id = ?`);\n\tconst sourceCheck = db.prepare(`SELECT source_id FROM sources WHERE source_id = ?`);\n\tconst exclusionCheck = db.prepare(`SELECT 1 AS hit FROM source_exclusions WHERE source_id = ? LIMIT 1`);\n\tfor (const owner of input.owners) {\n\t\tconst links = db\t\t\t}\n\t\t\tif (link.memory_id !== null) {\n\t\t\t\tconst mem = memoryCheck.get(link.memory_id) as\n\t\t\t\t\t| { id: string; current_revision: number }| undefined;\n\t\t\t\tif (!mem) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 已被删除排除`;\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,76]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[76,192]}}},{"diffOp":{"delete":{"range":[192,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[195,224]}}},{"diffOp":{"delete":{"range":[192,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[224,253]}}},{"diffOp":{"delete":{"range":[253,255]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[255,496]}}},{"equalLines":{"line_count":167}},{"diffOp":{"equal":{"range":[496,640]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"equal":{"range":[647,688]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[688,706]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[706,719]}}},{"diffOp":{"delete":{"range":[719,726]}}},{"diffOp":{"equal":{"range":[726,777]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[777,930]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"equal":{"range":[930,972]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[972,986]}}},{"diffOp":{"delete":{"range":[640,647]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[986,997]}}},{"diffOp":{"delete":{"range":[719,726]}}},{"diffOp":{"equal":{"range":[997,1044]}}},{"equalLines":{"line_count":359}},{"diffOp":{"equal":{"range":[1044,1182]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"equal":{"range":[1182,1201]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"insert":{"range":[1044,1045]}}},{"diffOp":{"equal":{"range":[1201,1223]}}},{"diffOp":{"delete":{"range":[719,721]}}},{"diffOp":{"equal":{"range":[1223,1432]}}},{"equalLines":{"line_count":57}},{"diffOp":{"equal":{"range":[1432,1521]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"equal":{"range":[1182,1201]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"insert":{"range":[1432,1433]}}},{"diffOp":{"equal":{"range":[1521,1546]}}},{"diffOp":{"delete":{"range":[719,721]}}},{"diffOp":{"equal":{"range":[1546,1655]}}},{"equalLines":{"line_count":70}},{"diffOp":{"equal":{"range":[1655,1765]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"equal":{"range":[1765,1782]}}},{"diffOp":{"delete":{"range":[640,642]}}},{"diffOp":{"insert":{"range":[1655,1656]}}},{"diffOp":{"equal":{"range":[1782,1814]}}},{"diffOp":{"delete":{"range":[719,721]}}},{"diffOp":{"equal":{"range":[1814,2050]}}},{"diffOp":{"delete":{"range":[640,643]}}},{"diffOp":{"equal":{"range":[2050,2118]}}},{"diffOp":{"delete":{"range":[719,722]}}},{"diffOp":{"equal":{"range":[2118,2176]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[2176,2265]}}},{"diffOp":{"delete":{"range":[2265,2272]}}},{"diffOp":{"equal":{"range":[2272,2313]}}},{"diffOp":{"delete":{"range":[2265,2271]}}},{"diffOp":{"insert":{"range":[2272,2273]}}},{"diffOp":{"equal":{"range":[2313,2451]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[2451,2545]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\observe.ts"},"span":null,"sourceCode":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *\n * 职责：\n * - **来源删除处理**：沿 `evolution_source_links` 清除候选输入/回执里的目标正文；\n *   清理未完成保持未完成状态，只保留排除所需定位。\n * - **依据失效/基础版本过期处理**：纠正、停用或 baseVersion 变动导致依据失效时标待重评估；\n *   **旧候选不得直接重新排发布**。\n * - **观察骨架**：viewed/used/patched 三态计数与关联（S9-06 才接 taskBinding，\n *   本阶段先落数据结构与只读计数入口）。\n * - **验证失败/取消/额度不足分别写状态**，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n *\n * 契约（S8 任务书 §5 / 计划 §S8-11）：\n * - 清理未完成保持未完成状态，只保留排除所需定位（sourceId/候选 ID/版本号）。\n * - 旧候选不绕过删除及纠正语义重新入库；依据失效的旧候选不重新排发布。\n * - 来源删除时沿关联清除候选输入中的目标正文（evidenceRefs、devCases 引用）。\n * - `passed ≠ active`；本阶段不自动发布正式资源。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCandidateStatus,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 0. outcome 编码约定（S9-06）\n// ════════════════════════════════════════════════════════════════════════\n//\n// `evolution_observations` 表无 outcome 列；`recordUsed` 的成败编进\n// `receipt_ref` 前缀：`<outcome>:<回执引用>`（outcome ∈ success|failure）。\n// 选前缀而不加列：CREATE TABLE IF NOT EXISTS 不能给已有库追加列，加列要另走\n// ALTER 迁移；当前 outcome 只被 countUsageByVersion 读，前缀方案改动最小。\n// 无 outcome 的 used 行（receipt_ref 无前缀或为空）不计入 success/failure。\nconst OUTCOME_PREFIXES = [\"success\", \"failure\"] as const;\ntype UsedOutcome = (typeof OUTCOME_PREFIXES)[number];\n\n/** 把 outcome 编进 receipt_ref；无 outcome 或无回执时原样返回。 */\nfunction encodeReceiptRef(receiptRef: string | undefined, outcome: UsedOutcome | undefined): string | undefined {\n\tif (outcome === undefined) return receiptRef;\n\treturn `${outcome}:${receiptRef ?? \"\"}`;\n}\n\n/** 从 receipt_ref 拆 outcome；无前缀 → undefined（不算成功/失败）。 */\nexport function decodeObservationOutcome(receiptRef: string | null): UsedOutcome | undefined {\n\tif (receiptRef === null) return undefined;\n\tfor (const prefix of OUTCOME_PREFIXES) {\n\t\tif (receiptRef.startsWith(`${prefix}:`)) return prefix;\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 来源删除：沿关联清理候选输入/回执里的目标正文\n// ════════════════════════════════════════════════════════════════════════\n\n/** `cleanupSourceReferences` 的输入。 */\nexport interface CleanupSourceReferencesInput {\n\t/** 被删除/排除的来源 ID。 */\n\tsourceId: string;\n\t/** 清理时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 是否保留最小定位（默认 true：保留 sourceId/候选 ID，清正文）。 */\n\tkeepExclusionLocator?: boolean;\n}\n\n/** `cleanupSourceReferences` 的输出。 */\nexport interface CleanupSourceReferencesResult {\n\t/** 被清理的问题数。 */\n\tproblemsCleaned: number;\n\t/** 被清理的候选数（状态被标 cancelled 或内容被清除）。 */\n\tcandidatesCleaned: number;\n\t/** 被清理的验证数（未完成验证保留 incomplete，已完成的不动）。 */\n\tvalidationsCleaned: number;\n\t/** 仍保持未完成状态的对象（清理无法完成时）。 */\n\tpendingObjects: Array<{ kind: \"problem\" | \"candidate\" | \"validation\"; id: string; reason: string }>;\n}\n\n/**\n * 沿 `evolution_source_links` 清除来源删除后残留的目标正文（db 级，无自身事务）。\n *\n * 供两处调用：\n * - 外层 `cleanupSourceReferences`（包 store.transaction 的公开 API，兼容旧调用）；\n * - `memory/deletion.ts applyDatabasePlan` 的事务内（store.transaction 是裸\n *   BEGIN IMMEDIATE 不能嵌套，故拆出本函数）。\n *\n * 对每个关联对象（O12/E11 清理范围扩到受管正文与盘文件）：\n * - **problem**：缩减 evidenceRefs；若全部证据被清空，summary/reason/\n *   expected/actual 是受该来源支撑的受管正文——清空标 `[cleared]`，\n *   状态回 pending_classification 待重新分类（依据已失效）。清不掉记 limitation。\n * - **candidate**：未终态的取消（不再排发布），failureReason 注明来源已删除；\n *   受该来源支撑的 diffs/rationale 是受管正文——清空为 `[]`/`[cleared]`；\n *   传了 paoHome 时候选目录盘文件按既有删除惯例 rmSync 移除（不再作为可发布\n *   内容）。已 passed/failed 的不改状态但同样清受管正文与盘文件。\n * - **validation**：owner_id 为 tp-*（冻结计划）时 plan.json 重写标 invalidated\n *   （来源已删除，验收依据失效）；owner_id 为 val-*（运行验证）时已完成的保留\n *   结论，未完成保持 incomplete。\n *\n * 清理未完成保持未完成状态，只保留排除所需定位；清不掉的如实计\n * pendingObjects（limitation），不伪装成功。\n */\nexport function dbCleanupSourceReferences(\n\tdb: DatabaseSync,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): CleanupSourceReferencesResult {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst keepLocator = input.keepExclusionLocator ?? true;\n\tconst pendingObjects: CleanupSourceReferencesResult[\"pendingObjects\"] = [];\n\n\t// 1. 查该来源关联的全部对象。\n\tconst links = db\n\t\t.prepare(\n\t\t\t`SELECT link_id, owner_kind, owner_id FROM evolution_source_links\n\t\t\t WHERE source_id = ?`,\n\t\t)\n\t\t.all(input.sourceId) as Array<{ link_id: string; owner_kind: string; owner_id: string }>;\n\n\tlet problemsCleaned = 0;\n\tlet candidatesCleaned = 0;\n\tlet validationsCleaned = 0;\n\t// 候选目录清理要去重（同一候选可能多条 links 指向该来源）。\n\tconst cleanedCandidateDirs = new Set<string>();\n\n\tfor (const link of links) {\n\t\tif (link.owner_kind === \"problem\") {\n\t\t\t// problem：缩减 evidenceRefs（只保留非本来源的引用）。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT evidence_refs_json FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t\t.get(link.owner_id) as { evidence_refs_json: string } | undefined;\n\t\t\tif (row) {\n\t\t\t\tconst refs = JSON.parse(row.evidence_refs_json) as string[];\n\t\t\t\tconst remaining = refs.filter((r) => r !== input.sourceId);\n\t\t\t\tif (remaining.length < refs.length) {\n\t\t\t\t\tif (remaining.length === 0) {\n\t\t\t\t\t\t// 全部证据被清空：summary/reason/expected/actual 是受该来源支撑\n\t\t\t\t\t\t// 的受管正文——清空标 [cleared]，状态回 observed + disposition\n\t\t\t\t\t\t// pending_classification（重新分类的起点；'pending_classification'\n\t\t\t\t\t\t// 是 disposition 值，不是 status 合法值——CHECK 约束拒绝）。\n\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t\t\t\t\t SET evidence_refs_json = '[]', summary = '[cleared]',\n\t\t\t\t\t\t\t\t     reason = NULL, expected_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     actual_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     status = 'observed', disposition = 'pending_classification', updated_at = ?\n\t\t\t\t\t\t\t\t WHERE problem_id = ?`,\n\t\t\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\t\tkind: \"problem\",\n\t\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t} else {\n\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t`UPDATE evolution_problems SET evidence_refs_json = ?, updated_at = ? WHERE problem_id = ?`,\n\t\t\t\t\t\t).run(JSON.stringify(remaining), now, link.owner_id);\n\t\t\t\t\t}\n\t\t\t\t\tproblemsCleaned += 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 删除该 link（排除所需定位已由 keepLocator 控制）。\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"candidate\") {\n\t\t\t// candidate：未终态的取消（不再排发布）；受管正文清空 + 盘文件移除。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT status, resource_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t.get(link.owner_id) as { status: string; resource_id: string } | undefined;\n\t\t\tif (row && row.status !== \"passed\" && row.status !== \"failed\" && row.status !== \"cancelled\") {\n\t\t\t\tconst reason = `来源 ${input.sourceId} 已删除，候选依据失效`;\n\t\t\t\tdb.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates SET status = 'cancelled', failure_reason = ?, updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t).run(reason, now, link.owner_id);\n\t\t\t\tcandidatesCleaned += 1;\n\t\t\t}\n\t\t\tif (row) {\n\t\t\t\t// 受管正文：diffs_json/rationale 是该来源支撑的内容——清空标 [cleared]。\n\t\t\t\ttry {\n\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t`UPDATE evolution_candidates SET diffs_json = '[]', rationale = '[cleared]', updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\t// 盘文件：候选目录按既有删除惯例移除（去重防重复 rm）。\n\t\t\t\tif (input.paoHome !== undefined && !cleanedCandidateDirs.has(link.owner_id)) {\n\t\t\t\t\tcleanedCandidateDirs.add(link.owner_id);\n\t\t\t\t\tconst dirSafeResourceId = row.resource_id.replace(/:/g, \"_\");\n\t\t\t\t\tconst candidateDir = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).candidates,\n\t\t\t\t\t\tdirSafeResourceId,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(candidateDir)) {\n\t\t\t\t\t\t\trmSync(candidateDir, { recursive: true, force: true });\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `候选目录清理失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"validation\") {\n\t\t\t// validation 两类 owner：testPlanId（tp-*，冻结计划）与 validationId\n\t\t\t// （val-*，运行验证）。已完成的保留结论；未完成保持 incomplete。\n\t\t\tif (link.owner_id.startsWith(\"tp-\")) {\n\t\t\t\t// testPlan 形态：plan.json 重写标 invalidated（验收依据已失效）。\n\t\t\t\tif (input.paoHome !== undefined) {\n\t\t\t\t\tconst planPath = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).validations,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t\t\"plan.json\",\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(planPath)) {\n\t\t\t\t\t\t\tlet planJson: unknown = {};\n\t\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\t\tplanJson = JSON.parse(readFileSync(planPath, \"utf8\"));\n\t\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\t\t// plan.json 已损坏：仍写 invalidated 包装。\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tconst invalidated = {\n\t\t\t\t\t\t\t\tinvalidated: true,\n\t\t\t\t\t\t\t\tinvalidatedReason: `来源 ${input.sourceId} 已删除，验收依据失效`,\n\t\t\t\t\t\t\t\tinvalidatedAt: now,\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t\twriteFileSync(\n\t\t\t\t\t\t\t\tplanPath,\n\t\t\t\t\t\t\t\tJSON.stringify(\n\t\t\t\t\t\t\t\t\ttypeof planJson === \"object\" && planJson !== null\n\t\t\t\t\t\t\t\t\t\t? { ...(planJson as Record<string, unknown>), ...invalidated }\n\t\t\t\t\t\t\t\t\t\t: invalidated,\n\t\t\t\t\t\t\t\t\tnull,\n\t\t\t\t\t\t\t\t\t2,\n\t\t\t\t\t\t\t\t),\n\t\t\t\t\t\t\t\t\"utf8\",\n\t\t\t\t\t\t\t);\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `plan.json 标 invalidated 失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t} else {\n\t\t\t\tconst row = db\n\t\t\t\t\t.prepare(`SELECT verdict FROM evolution_validations WHERE validation_id = ?`)\n\t\t\t\t\t.get(link.owner_id) as { verdict: string } | undefined;\n\t\t\t\tif (row && row.verdict === \"incomplete\") {\n\t\t\t\t\t// 未完成验证保持 incomplete（清理未完成保持未完成状态）。\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: \"验证未完成，保留 incomplete 状态供排除定位\",\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t}\n\t}\n\n\treturn {\n\t\tproblemsCleaned,\n\t\tcandidatesCleaned,\n\t\tvalidationsCleaned,\n\t\tpendingObjects,\n\t};\n}\n\n/**\n * `cleanupSourceReferences` 的公开 API：包 store.transaction 调 db 级实现。\n * 兼容旧调用（不带 paoHome 时跳过盘文件清理，只清库内受管正文与 links）。\n */\nexport function cleanupSourceReferences(\n\tstore: MemoryStore,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): MemoryResult<CleanupSourceReferencesResult> {\n\treturn store.transaction(() => ({ ok: true, ...dbCleanupSourceReferences(store.db, input) }));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 依据失效/基础版本过期：标待重评估\n// ════════════════════════════════════════════════════════════════════════\n\n/** `markStaleCandidates` 的输入。 */\nexport interface MarkStaleCandidatesInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 当前基础版本（新的 baseVersion；旧候选的 baseVersion 若与此不同即过期）。 */\n\tcurrentBaseVersion: string;\n\t/** 判定时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 具体失效原因（可选，人读）。 */\n\treason?: string;\n}\n\n/** `markStaleCandidates` 的输出。 */\nexport interface MarkStaleCandidatesResult {\n\t/** 被标过期的候选数。 */\n\tstaleCount: number;\n\t/** 被标过期的候选 ID。 */\n\tstaleCandidateIds: string[];\n}\n\n/**\n * 基础版本变动导致依据失效时标待重评估。\n *\n * 规则：\n * - 同 resourceId 下 base_version ≠ currentBaseVersion 的候选，\n *   若状态为 proposed/testing（未终态），标为 cancelled，\n *   failureReason 注明「基础版本已变动，待重评估」。\n * - **旧候选不得直接重新排发布**：即使回到同一 baseVersion，\n *   旧候选的验证证据已失效，不自动恢复为 proposed。\n */\nexport function markStaleCandidates(\n\tstore: MemoryStore,\n\tinput: MarkStaleCandidatesInput,\n): MemoryResult<MarkStaleCandidatesResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst reason = input.reason ?? `基础版本已变动:${input.currentBaseVersion}，待重评估`;\n\n\treturn store.transaction(() => {\n\t\tconst staleRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT candidate_id, base_version, status FROM evolution_candidates\n\t\t\t\t WHERE resource_id = ? AND base_version != ? AND status IN ('proposed', 'testing')`,\n\t\t\t)\n\t\t\t.all(input.resourceId, input.currentBaseVersion) as Array<{\n\t\t\tcandidate_id: string;\n\t\t\tbase_version: string;\n\t\t\tstatus: string;\n\t\t}>;\n\n\t\tfor (const row of staleRows) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\n\t\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t\t)\n\t\t\t\t.run(`${reason}（旧候选不得直接重新排发布）`, now, row.candidate_id);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstaleCount: staleRows.length,\n\t\t\tstaleCandidateIds: staleRows.map((r) => r.candidate_id),\n\t\t};\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 观察骨架：viewed/used/patched 三态计数与关联\n// ════════════════════════════════════════════════════════════════════\n\n/** 观察动作三态（S9-06 才接 taskBinding，本阶段先落计数入口）。 */\nexport const EVOLUTION_OBSERVATION_ACTIONS = [\n\t/** 查看详情是 viewed。 */\n\t\"viewed\",\n\t/** 任务明确选择该技能并引用 taskBinding 是 used（S9-06 接入）。 */\n\t\"used\",\n\t/** 新版本发布是 patched（S9 接入）。 */\n\t\"patched\",\n] as const;\n\nexport type EvolutionObservationAction = (typeof EVOLUTION_OBSERVATION_ACTIONS)[number];\n\n/** 一条观察记录。 */\nexport interface EvolutionObservation {\n\t/** 观察 ID。 */\n\tobservationId: string;\n\t/** 观察动作。 */\n\taction: EvolutionObservationAction;\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 关联的版本 ID（used 时为 taskBinding 绑定的 versionId；patched 时为新版本）。 */\n\tversionId?: string;\n\t/** 关联候选 ID（viewed 详情时定位候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 关联任务 ID（S9-06 接 taskBinding 后填充）。 */\n\ttaskId?: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/** 执行回执引用（used 时关联成功/失败）。 */\n\treceiptRef?: string;\n\t/** 观察时间。 */\n\tcreatedAt: string;\n}\n\n/** `recordEvolutionObservation` 的输入。 */\nexport interface RecordEvolutionObservationInput {\n\taction: EvolutionObservationAction;\n\tresourceId: string;\n\tversionId?: string;\n\tcandidateId?: string;\n\tproblemId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\treceiptRef?: string;\n\tcreatedAt?: string;\n}\n\n/** `recordEvolutionObservation` 的输出。 */\nexport interface RecordEvolutionObservationResult {\n\tobservationId: string;\n}\n\n/**\n * 记录一次资源观察（只读计数入口；S9-06 接 taskBinding）。\n *\n * - `viewed`：详情查看，关联 candidateId/problemId。\n * - `used`：实际使用（S9-06 才有 taskBinding），关联 versionId + receiptRef；\n *   本阶段只登记数据，不关联执行回执。\n * - `patched`：新版本发布（S9 接入），关联 versionId。\n *\n * 只有带实际执行回执的 used 才可关联成功/失败；仅资源已加载不能算实际采用。\n */\nexport function recordEvolutionObservation(\n\tstore: MemoryStore,\n\tinput: RecordEvolutionObservationInput,\n): MemoryResult<RecordEvolutionObservationResult> {\n\tif (!EVOLUTION_OBSERVATION_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知观察动作:${String(input.action)}`, String(input.action));\n\t}\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst observationId = `obs-${randomUUID()}`;\n\n\t// 观察落 evolution_observations 表（SCHEMA_SQL 建表；S9-06 接 taskBinding\n\t// 时复用同一表）。表缺失属环境异常，直接抛出不伪装成功。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_observations (\n\t\t\t\tobservation_id, action, resource_id, version_id, candidate_id, problem_id,\n\t\t\t\ttask_id, session_id, receipt_ref, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tobservationId,\n\t\t\tinput.action,\n\t\t\tinput.resourceId,\n\t\t\tinput.versionId ?? null,\n\t\t\tinput.candidateId ?? null,\n\t\t\tinput.problemId ?? null,\n\t\t\tinput.taskId ?? null,\n\t\t\tinput.sessionId ?? null,\n\t\t\tinput.receiptRef ?? null,\n\t\t\tnow,\n\t\t);\n\n\treturn { ok: true, observationId };\n}\n\n/** `countEvolutionObservations` 的输入。 */\nexport interface CountEvolutionObservationsInput {\n\tresourceId: string;\n\t/** 按动作过滤；缺省返回三态汇总。 */\n\taction?: EvolutionObservationAction;\n\t/** 按候选过滤。 */\n\tcandidateId?: string;\n\t/** 按版本过滤。 */\n\tversionId?: string;\n\t/** 按任务过滤（S9-06 后有效）。 */\n\ttaskId?: string;\n}\n\n/** `countEvolutionObservations` 的输出。 */\nexport interface CountEvolutionObservationsResult {\n\t/** 三态各自计数。 */\n\tcounts: Record<EvolutionObservationAction, number>;\n\t/** 总观察数。 */\n\ttotal: number;\n\t/** 是否从持久化表读取（恒为 true：SCHEMA_SQL 保证表存在）。 */\n\tpersisted: boolean;\n}\n\n/**\n * 只读观察计数：按 resourceId 汇总 viewed/used/patched 三态。\n *\n * 数据来自 SCHEMA_SQL 建的 evolution_observations 表；表缺失属环境异常，直接抛出。\n */\nexport function countEvolutionObservations(\n\tstore: MemoryStore,\n\tinput: CountEvolutionObservationsInput,\n): MemoryResult<CountEvolutionObservationsResult> {\n\tconst where: string[] = [\"resource_id = ?\"];\n\tconst params: unknown[] = [input.resourceId];\n\tif (input.action !== undefined) {\n\t\twhere.push(\"action = ?\");\n\t\tparams.push(input.action);\n\t}\n\tif (input.candidateId !== undefined) {\n\t\twhere.push(\"candidate_id = ?\");\n\t\tparams.push(input.candidateId);\n\t}\n\tif (input.versionId !== undefined) {\n\t\twhere.push(\"version_id = ?\");\n\t\tparams.push(input.versionId);\n\t}\n\tif (input.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(input.taskId);\n\t}\n\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, COUNT(*) AS n FROM evolution_observations\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t GROUP BY action`,\n\t\t)\n\t\t.all(...(params as never[])) as Array<{ action: string; n: number }>;\n\n\tconst counts: Record<EvolutionObservationAction, number> = {\n\t\tviewed: 0,\n\t\tused: 0,\n\t\tpatched: 0,\n\t};\n\tlet total = 0;\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\" || row.action === \"used\" || row.action === \"patched\") {\n\t\t\tcounts[row.action] = row.n;\n\t\t\ttotal += row.n;\n\t\t}\n\t}\n\treturn { ok: true, counts, total, persisted: true };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. S9-06：used / patched 写入入口与按版本计数\n// ════════════════════════════════════════════════════════════════════════\n\n/** `recordUsed` 的输入。 */\nexport interface RecordUsedInput {\n\t/** 被使用的资源 ID。 */\n\tresourceId: string;\n\t/** 实际使用该资源的任务 ID。 */\n\ttaskId: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/**\n\t * 使用的版本 ID；缺省取该任务对该资源的 active 绑定值。\n\t * 显式传值但 ≠ 绑定值 → 照实记录，返回 `versionMismatch:true` 供调用方区分\n\t * （绑定版本与实际加载版本不一致属宿主装配问题，不归因到绑定版本）。\n\t */\n\tversionId?: string;\n\t/** 执行回执引用（用于关联成功/失败与定位日志）。 */\n\treceiptRef?: string;\n\t/** 使用结果；写入时编进 receipt_ref 前缀（见文件头约定）。 */\n\toutcome?: \"success\" | \"failure\";\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `recordUsed` 的输出。 */\nexport interface RecordUsedResult {\n\tobservationId: string;\n\t/** 实际落库的 versionId（缺省时取自绑定）。 */\n\tversionId: string;\n\t/** 显式传入的 versionId 与绑定值不一致时为 true（照实记录，不归因绑定版）。 */\n\tversionMismatch: boolean;\n}\n\n/**\n * 记一次实际使用（action='used'）。\n *\n * 校验「已加载 ≠ 实际采用」：必须存在该 (taskId, resourceId) 的 active\n * task_binding 才写；绑定不存在或已停用 → 业务错误（invalid_input），不硬写。\n * 「未使用候选的错误不归因」即由此保证：无绑定任务的失败不进 observations。\n */\nexport function recordUsed(\n\tstore: MemoryStore,\n\tinput: RecordUsedInput,\n): MemoryResult<RecordUsedResult> {\n\tif (input.outcome !== undefined && !OUTCOME_PREFIXES.includes(input.outcome)) {\n\t\treturn fail(\"invalid_input\", `未知 outcome:${String(input.outcome)}`, input.resourceId);\n\t}\n\tconst binding = store.db\n\t\t.prepare(\n\t\t\t`SELECT version_id, active FROM evolution_task_bindings\n\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as { version_id: string; active: number } | undefined;\n\tif (!binding) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}：已加载 ≠ 实际采用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tif (binding.active !== 1) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst versionId = input.versionId ?? binding.version_id;\n\tconst versionMismatch = input.versionId !== undefined && input.versionId !== binding.version_id;\n\n\tconst written = recordEvolutionObservation(store, {\n\t\taction: \"used\",\n\t\tresourceId: input.resourceId,\n\t\tversionId,\n\t\ttaskId: input.taskId,\n\t\t...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),\n\t\treceiptRef: encodeReceiptRef(input.receiptRef, input.outcome),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n\tif (!written.ok) return { ok: false, error: written.error };\n\treturn { ok: true, observationId: written.observationId, versionId, versionMismatch };\n}\n\n/** `recordPatched` 的输入。 */\nexport interface RecordPatchedInput {\n\t/** 被发布的资源 ID。 */\n\tresourceId: string;\n\t/** 新发布/新生效的版本 ID。 */\n\tversionId: string;\n\t/** 关联候选 ID（activation 路径可定位到候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/**\n * 记一次版本发布/生效（action='patched'）。\n *\n * 由 activation.ts `activateCandidate` 成功事务内调用（同事务：patched 是\n * 生效历史的一部分，activation 行与 used/patched 观察同生同死）；也可由\n * 宿主在其他生效路径（restore 等）调用。本函数只 INSERT 一行观察，不开\n * 自己的事务——调用方决定事务边界。\n */\nexport function recordPatched(\n\tstore: MemoryStore,\n\tinput: RecordPatchedInput,\n): MemoryResult<{ observationId: string }> {\n\treturn recordEvolutionObservation(store, {\n\t\taction: \"patched\",\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.versionId,\n\t\t...(input.candidateId === undefined ? {} : { candidateId: input.candidateId }),\n\t\t...(input.problemId === undefined ? {} : { problemId: input.problemId }),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n}\n\n/** `countUsageByVersion` 的输出。 */\nexport interface UsageByVersionCounts {\n\t/** 三态各自计数。 */\n\tviewed: number;\n\tused: number;\n\tpatched: number;\n\t/** used 行中 outcome=success 的计数（receipt_ref 前缀解析）。 */\n\tsuccess: number;\n\t/** used 行中 outcome=failure 的计数。 */\n\tfailure: number;\n}\n\n/**\n * 按 (resourceId, versionId) 汇总观察计数（界面「实际观察」区用）。\n *\n * success/failure 从 used 行的 receipt_ref 前缀解析（见文件头约定）；\n * 无 outcome 的 used 行只计入 used 总数，不进 success/failure。\n */\nexport function countUsageByVersion(\n\tstore: MemoryStore,\n\tinput: { resourceId: string; versionId: string },\n): MemoryResult<UsageByVersionCounts> {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, receipt_ref FROM evolution_observations\n\t\t\t WHERE resource_id = ? AND version_id = ?`,\n\t\t)\n\t\t.all(input.resourceId, input.versionId) as Array<{ action: string; receipt_ref: string | null }>;\n\n\tconst counts: UsageByVersionCounts = { viewed: 0, used: 0, patched: 0, success: 0, failure: 0 };\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\") counts.viewed += 1;\n\t\telse if (row.action === \"patched\") counts.patched += 1;\n\t\telse if (row.action === \"used\") {\n\t\t\tcounts.used += 1;\n\t\t\tconst outcome = decodeObservationOutcome(row.receipt_ref);\n\t\t\tif (outcome === \"success\") counts.success += 1;\n\t\t\telse if (outcome === \"failure\") counts.failure += 1;\n\t\t}\n\t}\n\treturn { ok: true, ...counts };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 必要来源失效检测（O12/E11 可复用 helper）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `checkOwnerSourceLinksIntact` 的输入。 */\nexport interface OwnerSourceLinkCheckInput {\n\t/** owner 清单（按 problem→candidate→testPlan→validation 顺序给出最直观）。 */\n\towners: Array<{ ownerKind: \"problem\" | \"candidate\" | \"validation\"; ownerId: string; label: string }>;\n}\n\n/**\n * 核对一组 owner 的 source links 仍有效（必要来源失效检测）。\n *\n * 与 activation.ts checkSourceLinksIntact / control.ts\n * checkRestoreSourceLinksIntact 同口径——供 publish 门、activation、control\n * 三处共用，避免各写一份发散：\n * - 任一 owner 没有任何 link 行 → 返回「{label}没有登记任何来源关联」；\n * - src- 前缀 link 查 sources 行存在、source_exclusions 无命中；\n * - 带 memory_id 的 link 查 memories 行存在且 current_revision ≥ link.revision。\n * 返回首个失效原因；全部有效返回 undefined。\n */\nexport function checkOwnerSourceLinksIntact(\n\tdb: DatabaseSync,\n\tinput: OwnerSourceLinkCheckInput,\n): string | undefined {\n\tconst memoryCheck = db.prepare(`SELECT id, current_revision FROM memories WHERE id = ?`);\n\tconst sourceCheck = db.prepare(`SELECT source_id FROM sources WHERE source_id = ?`);\n\tconst exclusionCheck = db.prepare(\n\t\t`SELECT 1 AS hit FROM source_exclusions WHERE source_id = ? LIMIT 1`,\n\t);\n\tfor (const owner of input.owners) {\n\t\tconst links = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(owner.ownerKind, owner.ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\t\tif (links.length === 0) {\n\t\t\treturn `${owner.label}没有登记任何来源关联（空关联不能代替有效依据）`;\n\t\t}\n\t\tfor (const link of links) {\n\t\t\tif (link.source_id.startsWith(\"src-\") && !sourceCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被删除`;\n\t\t\t}\n\t\t\tif (exclusionCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被排除`;\n\t\t\t}\n\t\t\tif (link.memory_id !== null) {\n\t\t\t\tconst mem = memoryCheck.get(link.memory_id) as\n\t\t\t\t\t| { id: string; current_revision: number }\n\t\t\t\t\t| undefined;\n\t\t\t\tif (!mem) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 已被删除排除`;\n\t\t\t\t}\n\t\t\t\tif (link.revision !== null && mem.current_revision < link.revision) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 当前修订 r${mem.current_revision} 低于关联修订 r${link.revision}`;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化授权策略（S8-01）。\n * */\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\tEVOLUTION_RESOURCE_OPS,\n\ttype EvolutionFileDiff,\n\ttype EvolutionProblemAction,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tEVOLUTION_RESOURCE_OPS,\n\ttype EvolutionResourceOp,\n\tformatResourceId,\n\tparseResourceId,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[51,157]}}},{"diffOp":{"equal":{"range":[157,195]}}},{"diffOp":{"insert":{"range":[195,220]}}},{"diffOp":{"equal":{"range":[220,326]}}},{"diffOp":{"delete":{"range":[326,351]}}},{"diffOp":{"equal":{"range":[351,437]}}},{"diffOp":{"equal":{"range":[437,658]}}},{"equalLines":{"line_count":304}},{"diffOp":{"equal":{"range":[658,663]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\policy.ts"},"span":[735,768],"sourceCode":"/**\n * 受控自进化授权策略（S8-01）。\n *\n * 职责：把已授权类别（C4）落实为 resourceId/资源根/允许操作，并钉死\n * 固定禁止对象；候选越界一律拒绝并给具体理由。\n *\n * 契约（S8 任务书 §2/§5）：\n * - `FORBIDDEN_EVOLUTION_TARGETS`：固定禁止对象，候选改这些即拒。\n * - `resolveEvolutionResource`：类别+目标名 → resourceId/资源根/允许操作；\n *   不在已授权类别内返回拒绝理由，不伪造授权。\n * - `assertCandidateWithinScope`：核对候选文件清单与策略引用未扩大授权；\n *   越界返回具体拒绝理由。\n * - 资源登记不重复请求已授予的类别权限（同一 resourceId 幂等复用）。\n */\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\ttype EvolutionFileDiff,\n\ttype EvolutionProblemAction,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tEVOLUTION_RESOURCE_OPS,\n\ttype EvolutionResourceOp,\n\tformatResourceId,\n\tparseResourceId,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 固定禁止对象（S8 任务书 §2 冻结清单）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 固定禁止对象：任何候选改动这些位置一律拒绝。\n * 使用前缀匹配（相对 PAO_HOME 或项目根的 POSIX 路径）。\n */\nexport const FORBIDDEN_EVOLUTION_TARGETS = [\n\t/** 内核/pi 源码与上游文件。 */\n\t\"src/\",\n\t\"packages/\",\n\t\"node_modules/\",\n\t\"dist/\",\n\t/** memory.sqlite 表结构（SCHEMA_SQL 本身不可被候选修改）。 */\n\t\"memory/memory.sqlite\",\n\t/** 权限/角色门控。 */\n\t\"src/pao/role.ts\",\n\t/** 预算上限、用量账正本、档位.json 数值、记忆后台预算.json。 */\n\t\"pao配置/档位.json\",\n\t\"pao配置/记忆后台预算.json\",\n\t\"usage/\",\n\t\"memory/budget-ledger\",\n\t/** 资源加载与更新机制本身。 */\n\t\"src/core/resource-loader.ts\",\n\t\"src/pao/evolution/policy.ts\",\n\t\"src/pao/evolution/resources.ts\",\n\t/** 正式决定与授权范围变更。 */\n\t\"plans/\",\n\t\".agents/notes/\",\n] as const;\n\n/**\n * 固定禁止对象的人类可读描述（拒绝理由用）。\n */\nexport const FORBIDDEN_TARGET_REASONS: Record<string, string> = {\n\t\"src/\": \"内核/pi 源码属于固定禁止对象，不可由候选修改\",\n\t\"packages/\": \"上游包源码属于固定禁止对象\",\n\t\"node_modules/\": \"依赖目录属于固定禁止对象\",\n\t\"dist/\": \"构建产物属于固定禁止对象\",\n\t\"memory/memory.sqlite\": \"memory.sqlite 表结构属于固定禁止对象\",\n\t\"src/pao/role.ts\": \"权限/角色门控属于固定禁止对象\",\n\t\"pao配置/档位.json\": \"档位配置数值属于固定禁止对象\",\n\t\"pao配置/记忆后台预算.json\": \"记忆后台预算配置属于固定禁止对象\",\n\t\"usage/\": \"用量账正本属于固定禁止对象\",\n\t\"memory/budget-ledger\": \"预算账正本属于固定禁止对象\",\n\t\"src/core/resource-loader.ts\": \"资源加载与更新机制本身属于固定禁止对象\",\n\t\"src/pao/evolution/policy.ts\": \"策略机制本身属于固定禁止对象\",\n\t\"src/pao/evolution/resources.ts\": \"资源登记机制本身属于固定禁止对象\",\n\t\"plans/\": \"正式决定/计划文件属于固定禁止对象\",\n\t\".agents/notes/\": \"授权范围变更记录属于固定禁止对象\",\n};\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 授权类别 → 资源落点（S8 任务书 §2 冻结表）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 每种类别的资源根模板与允许操作。 */\ninterface CategoryProfile {\n\t/** 资源根相对路径模板（`{name}` 为占位符）。 */\n\trelativeRootTemplate: string;\n\t/** 允许操作集。 */\n\tallowedOps: EvolutionResourceOp[];\n\t/** 能力范围描述。 */\n\tcapabilityScope: string[];\n\t/** 加载方式。 */\n\tloadMethod: import(\"./types.ts\").EvolutionLoadMethod;\n\t/** 禁止改的内容（人读描述）。 */\n\tforbidden: string[];\n}\n\nconst CATEGORY_PROFILES: Record<EvolutionResourceKind, CategoryProfile> = {\n\tskill: {\n\t\trelativeRootTemplate: \"pao配置/skills/{name}\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"SKILL.md 正文\", \"示例\", \"局部步骤\"],\n\t\tloadMethod: \"skill-path\",\n\t\tforbidden: [\"权限\", \"预算\", \"验收条件\"],\n\t},\n\ttemplate: {\n\t\trelativeRootTemplate: \"工作流/{name}.md\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"模板正文\", \"目标\", \"约束\"],\n\t\tloadMethod: \"template-file\",\n\t\tforbidden: [\"frontmatter 预算对象\", \"验收字段\"],\n\t},\n\tcommand: {\n\t\trelativeRootTemplate: \"pao配置/commands/{name}\",\n\t\tallowedOps: [\"adjust-params\"],\n\t\tcapabilityScope: [\"参数组织\"],\n\t\tloadMethod: \"command-registry\",\n\t\tforbidden: [\"工具能力授予\", \"可写边界\"],\n\t},\n\textension: {\n\t\trelativeRootTemplate: \"pao配置/extensions/{name}\",\n\t\tallowedOps: [\"edit-content\", \"adjust-params\"],\n\t\tcapabilityScope: [\"工具实现\", \"参数组织\"],\n\t\tloadMethod: \"extension-path\",\n\t\tforbidden: [\"能力授予\", \"宿主权限检查\"],\n\t},\n\t\"memory-policy\": {\n\t\trelativeRootTemplate: \"memory/{name}\",\n\t\tallowedOps: [\"adjust-policy\"],\n\t\tcapabilityScope: [\"检索参数\", \"条件选择\", \"提炼提示\"],\n\t\tloadMethod: \"policy-resource\",\n\t\tforbidden: [\"表结构\", \"来源可信分类\", \"纠正优先\", \"删除语义\"],\n\t},\n\trecipe: {\n\t\trelativeRootTemplate: \"部门/{name}/配方.md\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"人设\", \"职责边界描述\"],\n\t\tloadMethod: \"recipe-file\",\n\t\tforbidden: [\"工具清单授权\", \"默认档位越权\"],\n\t},\n};\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `resolveEvolutionResource` 的输入。 */\nexport interface ResolveEvolutionResourceInput {\n\t/** 已授权类别。 */\n\tkind: EvolutionResourceKind;\n\t/** 目标名（如技能名、部门名、命令名）。 */\n\tname: string;\n\t/** PAO_HOME 根（用于校验资源根确实落在 home 内）。 */\n\tpaoHome: string;\n}\n\n/** `resolveEvolutionResource` 的成功结果。 */\nexport interface ResolveEvolutionResourceResult {\n\tresourceId: string;\n\trelativeRoot: string;\n\tabsoluteRoot: string;\n\tallowedOps: EvolutionResourceOp[];\n\tcapabilityScope: string[];\n\tloadMethod: EvolutionResource[\"loadMethod\"];\n}\n\n/** `assertCandidateWithinScope` 的输入。 */\nexport interface AssertCandidateScopeInput {\n\t/** 候选声明要改的文件差异。 */\n\tdiffs: EvolutionFileDiff[];\n\t/** 候选声明的动作。 */\n\taction?: EvolutionProblemAction;\n\t/** 已登记的资源（含允许范围）。 */\n\tresource: EvolutionResource;\n\t/** 候选给出的策略引用（如 memory-policy 的检索参数名）。 */\n\tpolicyRefs?: string[];\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 实现\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction normalizeRelativePath(path: string): string {\n\treturn path.replace(/\\\\/g, \"/\").replace(/^\\.\\//, \"\").replace(/\\/+/g, \"/\");\n}\n\n/** 检查相对路径是否命中固定禁止对象；命中返回理由，未命中返回 undefined。 */\nexport function checkForbiddenTarget(relativePath: string): string | undefined {\n\tconst normalized = normalizeRelativePath(relativePath);\n\t// 最长前缀优先：具体条目（如 src/pao/role.ts）先于泛前缀（如 src/）给出准确理由。\n\tconst sorted = [...FORBIDDEN_EVOLUTION_TARGETS].sort((a, b) => b.length - a.length);\n\tfor (const target of sorted) {\n\t\tconst normalizedTarget = normalizeRelativePath(target);\n\t\tif (normalized === normalizedTarget || normalized.startsWith(normalizedTarget)) {\n\t\t\treturn FORBIDDEN_TARGET_REASONS[target] ?? `路径 ${normalized} 属于固定禁止对象`;\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 检查相对路径是否落在资源根内。 */\nfunction isPathUnderRoot(relativePath: string, relativeRoot: string): boolean {\n\tconst normalized = normalizeRelativePath(relativePath);\n\tconst normalizedRoot = normalizeRelativePath(relativeRoot);\n\treturn normalized === normalizedRoot || normalized.startsWith(`${normalizedRoot}/`);\n}\n\n/**\n * 把类别+目标名解析为 resourceId/资源根/允许操作。\n * 不在已授权类别内返回拒绝理由；不展开、不猜测、不自动授权新类别。\n */\nexport function resolveEvolutionResource(\n\tinput: ResolveEvolutionResourceInput,\n): MemoryResult<ResolveEvolutionResourceResult> {\n\tif (!EVOLUTION_RESOURCE_KINDS.includes(input.kind)) {\n\t\treturn fail(\"invalid_input\", `未授权的进化资源类别:${String(input.kind)}`, String(input.kind));\n\t}\n\tif (typeof input.name !== \"string\" || input.name.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"资源目标名不能为空\", input.kind);\n\t}\n\tconst profile = CATEGORY_PROFILES[input.kind];\n\tconst relativeRoot = profile.relativeRootTemplate.replace(\"{name}\", input.name.trim());\n\tconst resourceId = formatResourceId(input.kind, input.name.trim());\n\tconst absoluteRoot = join(input.paoHome, relativeRoot);\n\treturn {\n\t\tok: true,\n\t\tresourceId,\n\t\trelativeRoot,\n\t\tabsoluteRoot,\n\t\tallowedOps: [...profile.allowedOps],\n\t\tcapabilityScope: [...profile.capabilityScope],\n\t\tloadMethod: profile.loadMethod,\n\t};\n}\n\n/**\n * 核对候选是否在已授权范围内。\n *\n * 检查项：\n * 1. 每条 diff 的 path 必须在 resource.relativeRoot 内；\n * 2. 每条 diff 的 path 不能命中固定禁止对象；\n * 3. 候选动作必须与资源允许操作一致（modify→edit-content，等）；\n * 4. policyRefs 不能声明超出 capabilityScope 的策略名。\n *\n * 越界返回具体拒绝理由；全部通过返回 `{ ok: true }`。\n */\nexport function assertCandidateWithinScope(input: AssertCandidateScopeInput): MemoryResult<{ checked: number }> {\n\tconst { diffs, action, resource, policyRefs } = input;\n\tconst profile = CATEGORY_PROFILES[resource.kind];\n\n\t// 动作与允许操作核对\n\tif (action !== undefined) {\n\t\tconst requiredOp = actionToRequiredOp(action);\n\t\tif (requiredOp !== undefined && !resource.allowedOps.includes(requiredOp)) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`候选动作 ${action} 需要操作 ${requiredOp}，但资源 ${resource.resourceId} 仅允许 ${resource.allowedOps.join(\"、\")}`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t}\n\n\t// 文件范围核对\n\tfor (const diff of diffs) {\n\t\tconst normalized = normalizeRelativePath(diff.path);\n\t\tconst forbiddenReason = checkForbiddenTarget(normalized);\n\t\tif (forbiddenReason !== undefined) {\n\t\t\treturn fail(\"invalid_input\", `候选越界:${forbiddenReason}`, normalized);\n\t\t}\n\t\tif (!isPathUnderRoot(normalized, resource.relativeRoot)) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`候选文件 ${normalized} 超出资源根 ${resource.relativeRoot}（资源 ${resource.resourceId} 的可写范围）`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t}\n\n\t// 策略引用核对（memory-policy 专用；其他类别传 policyRefs 直接拒绝）\n\tif (policyRefs !== undefined && policyRefs.length > 0) {\n\t\tif (resource.kind !== \"memory-policy\") {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`资源 ${resource.resourceId} 非记忆策略类别，不接受 policyRefs`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t\tfor (const ref of policyRefs) {\n\t\t\tif (!profile.capabilityScope.includes(ref)) {\n\t\t\t\treturn fail(\n\t\t\t\t\t\"invalid_input\",\n\t\t\t\t\t`策略引用 ${ref} 超出记忆策略能力范围（允许:${profile.capabilityScope.join(\"、\")}）`,\n\t\t\t\t\tresource.resourceId,\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\treturn { ok: true, checked: diffs.length };\n}\n\n/**\n * 检查候选是否未扩大授权（简版：只传文件清单与 resourceId）。\n * 供调用方在尚未拿到完整 resource 对象时做快速前置检查。\n */\nexport function assertCandidatePathsWithinScope(\n\tresource: EvolutionResource,\n\tpaths: string[],\n): MemoryResult<{ checked: number }> {\n\treturn assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: paths.map((path) => ({ path, kind: \"edit\" })),\n\t});\n}\n\n/** 把问题动作映射为所需资源操作。 */\nfunction actionToRequiredOp(action: EvolutionProblemAction): EvolutionResourceOp | undefined {\n\tswitch (action) {\n\t\tcase \"modify\":\n\t\tcase \"delete\":\n\t\tcase \"merge\":\n\t\t\treturn \"edit-content\";\n\t\tcase \"no_change\":\n\t\tcase \"development_suggestion\":\n\t\t\treturn undefined;\n\t\tdefault:\n\t\t\treturn undefined;\n\t}\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n * * - 登记后资源文件未改；模型验证调用为零。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { MemoryError,MemoryResultgetSource } from \"../memory/types.tssources.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tEVOLUTION_PROBLEM_ACTIONS,\treturn rows.map(rowToProblem);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[63,171]}}},{"diffOp":{"equal":{"range":[171,179]}}},{"diffOp":{"delete":{"range":[179,184]}}},{"diffOp":{"equal":{"range":[184,185]}}},{"diffOp":{"delete":{"range":[185,198]}}},{"diffOp":{"equal":{"range":[185,186]}}},{"diffOp":{"delete":{"range":[198,210]}}},{"diffOp":{"insert":{"range":[210,219]}}},{"diffOp":{"equal":{"range":[219,238]}}},{"diffOp":{"delete":{"range":[238,246]}}},{"diffOp":{"insert":{"range":[246,256]}}},{"diffOp":{"equal":{"range":[256,258]}}},{"diffOp":{"equal":{"range":[258,313]}}},{"diffOp":{"equal":{"range":[258,266]}}},{"diffOp":{"insert":{"range":[179,184]}}},{"diffOp":{"equal":{"range":[313,315]}}},{"diffOp":{"delete":{"range":[210,219]}}},{"diffOp":{"insert":{"range":[315,340]}}},{"diffOp":{"equal":{"range":[219,238]}}},{"diffOp":{"delete":{"range":[246,256]}}},{"diffOp":{"insert":{"range":[238,246]}}},{"diffOp":{"equal":{"range":[256,258]}}},{"diffOp":{"equal":{"range":[340,377]}}},{"equalLines":{"line_count":603}},{"diffOp":{"equal":{"range":[377,411]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\problems.ts"},"span":[1320,1361],"sourceCode":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n *\n * 职责：\n * - `declareImprovementIntent`：统一问题登记入口。输入含 kind/action/summary/\n *   expectedBehavior/actualBehavior/evidenceRefs；宿主补 projectId/taskId/\n *   sessionId/entryId/toolCallId，**不信模型自报身份**。返回\n *   `{accepted, problemId?, disposition, reason?}`。\n * - `collectEvolutionProblem`：从失败回执/用户纠正/使用记录取得事实输入，\n *   只读事实，已有同来源问题复用 ID。\n * - `classifyProblem`：S8-04 分类——先查是否未采用已有经验（unused_experience，\n *   优先改检索/提示策略），再查调用参数/实现版本（invocation/implementation_defect），\n *   核心缺陷输出 development_suggestion。\n * - 来源关联写入 `evolution_source_links`（owner_kind='problem'）。\n *\n * 契约（S8 任务书 §5）：\n * - `occurrenceCount` 只由独立事实来源计算，不算摘要指纹；模型单次申报不能标\n *   「重复失败」。\n * - 同 sourceId + resourceId + action 重复申报复用已有 problemId，返回\n *   disposition='merged'。\n * - 证据为空且非「有依据的机会」类时返回不受理理由，不伪造失败记录。\n * - 登记后资源文件未改；模型验证调用为零。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getSource } from \"../memory/sources.ts\";\nimport {\n\tEVOLUTION_PROBLEM_ACTIONS,\n\tEVOLUTION_PROBLEM_KINDS,\n\tEVOLUTION_PROBLEM_STATUSES,\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemKind,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 行映射\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * evolution_problems 全列行形状与映射：本模块唯一正本。\n * select.ts 等其他模块需要完整 Problem 时复用本行读取（O14：字段增补只改这里）。\n */\nexport interface EvolutionProblemDbRow {\n\tproblem_id: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpected_behavior: string;\n\tactual_behavior: string;\n\tevidence_refs_json: string;\n\toccurrence_count: number;\n\tresource_id: string | null;\n\tbase_version: string | null;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsession_id: string | null;\n\tentry_id: string | null;\n\ttool_call_id: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\nexport function rowToProblem(row: EvolutionProblemDbRow): EvolutionProblem {\n\treturn {\n\t\tproblemId: row.problem_id,\n\t\tkind: row.kind as EvolutionProblemKind,\n\t\t...(row.action === null ? {} : { action: row.action as EvolutionProblemAction }),\n\t\tsummary: row.summary,\n\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\texpectedBehavior: row.expected_behavior,\n\t\tactualBehavior: row.actual_behavior,\n\t\tevidenceRefs: JSON.parse(row.evidence_refs_json) as string[],\n\t\toccurrenceCount: row.occurrence_count,\n\t\t...(row.resource_id === null ? {} : { resourceId: row.resource_id }),\n\t\t...(row.base_version === null ? {} : { baseVersion: row.base_version }),\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t...(row.session_id === null ? {} : { sessionId: row.session_id }),\n\t\t...(row.entry_id === null ? {} : { entryId: row.entry_id }),\n\t\t...(row.tool_call_id === null ? {} : { toolCallId: row.tool_call_id }),\n\t\tstatus: row.status as EvolutionProblemStatus,\n\t\tdisposition: row.disposition as EvolutionProblemDisposition,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. declareImprovementIntent —— 统一问题登记\n// ════════════════════════════════════════════════════════════════════════\n\n/** `declareImprovementIntent` 的输入。 */\nexport interface DeclareImprovementIntentInput {\n\t/** 问题类别（宿主/模型申报）。 */\n\tkind: EvolutionProblemKind;\n\t/** 建议动作（可选；登记时未分类可缺省）。 */\n\taction?: EvolutionProblemAction;\n\t/** 一句话摘要。 */\n\tsummary: string;\n\t/** 发生原因（模型推测标 model_inference）。 */\n\treason?: string;\n\t/** 预期行为。 */\n\texpectedBehavior: string;\n\t/** 实际行为（有真实回执时必填）。 */\n\tactualBehavior: string;\n\t/** 证据引用：sourceId / memoryId / revision / toolCallId / receiptRef。 */\n\tevidenceRefs: string[];\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本（问题发生时的资源版本）。 */\n\tbaseVersion?: string;\n\t/** 宿主补的项目 ID。 */\n\tprojectId?: string;\n\t/** 宿主补的任务 ID。 */\n\ttaskId?: string;\n\t/** 宿主补的会话 ID。 */\n\tsessionId?: string;\n\t/** 宿主补的会话条目 ID。 */\n\tentryId?: string;\n\t/** 宿主补的工具调用 ID。 */\n\ttoolCallId?: string;\n\t/** 登记时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1，不给模型自报「重复」。 */\n\toccurrenceCount?: number;\n}\n\n/** `declareImprovementIntent` 的输出。 */\nexport interface DeclareImprovementIntentResult {\n\t/** 是否受理。 */\n\taccepted: boolean;\n\t/** 已登记/复用的问题 ID。 */\n\tproblemId?: string;\n\t/** 处置结果。 */\n\tdisposition?: EvolutionProblemDisposition;\n\t/** 不受理理由。 */\n\treason?: string;\n}\n\n/**\n * 统一问题登记。\n *\n * 证据校验：evidenceRefs 为空且非「有依据的机会」类时返回不受理理由。\n * 去重：同 sourceId + resourceId + action 复用已有 problemId（查\n * evolution_source_links + evolution_problems），不算摘要指纹。\n * occurrenceCount 只由独立事实来源计算；不给模型自报「重复」。\n */\nexport function declareImprovementIntent(\n\tstore: MemoryStore,\n\tinput: DeclareImprovementIntentInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\t// 基础输入校验\n\tif (!EVOLUTION_PROBLEM_KINDS.includes(input.kind)) {\n\t\treturn fail(\"invalid_input\", `未知问题类别:${String(input.kind)}`, String(input.kind));\n\t}\n\tif (input.action !== undefined && !EVOLUTION_PROBLEM_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知问题动作:${String(input.action)}`, String(input.action));\n\t}\n\tif (typeof input.summary !== \"string\" || input.summary.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"问题摘要不能为空\", input.kind);\n\t}\n\tif (typeof input.expectedBehavior !== \"string\" || input.expectedBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"预期行为不能为空\", input.kind);\n\t}\n\tif (typeof input.actualBehavior !== \"string\" || input.actualBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"实际行为不能为空\", input.kind);\n\t}\n\n\t// 证据校验：evidenceRefs 为空且非「有依据的机会」类时不受理。\n\t// 「有依据的机会」类（unused_experience / invocation / implementation_defect / core_issue）\n\t// 都须至少一条证据；空证据的泛化建议不伪造失败记录。\n\tif (input.evidenceRefs.length === 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: \"无证据引用：evidenceRefs 至少一条，不接受空证据的泛化建议\",\n\t\t};\n\t}\n\n\t// 证据引用分两类：\n\t// - src- 前缀：sources 表已登记来源，校验存在性（缺失即整体拒绝）。\n\t// - 其他（friction:/toolcall:/mem-*@rev-* 等）：宿主给的稳定引用，不入 sources 表\n\t//   但同样作为去重键写 evolution_source_links。\n\tconst realSourceIds = input.evidenceRefs.filter((ref) => ref.startsWith(\"src-\"));\n\tconst missingSources = realSourceIds.filter((id) => !getSource(store.db, id));\n\tif (missingSources.length > 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: `来源不存在:${missingSources.join(\"、\")}——不伪造失败记录`,\n\t\t};\n\t}\n\n\t// 去重：同来源引用（任一 evidenceRef）+ 同 resourceId + 同 action 复用已有 problemId。\n\t// 「同来源」指同一稳定证据引用，不限 src- 前缀——摩擦草稿、回执、toolcall 等\n\t// 宿主生成的稳定引用同样算来源。不算摘要指纹。\n\tconst normalizedResourceId = input.resourceId?.trim() || null;\n\tconst normalizedAction = input.action ?? null;\n\tlet mergedProblemId: string | undefined;\n\tfor (const ref of input.evidenceRefs) {\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT p.problem_id FROM evolution_source_links l\n\t\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t\t   AND COALESCE(p.resource_id, '') = COALESCE(?, '')\n\t\t\t\t   AND COALESCE(p.action, '') = COALESCE(?, '')\n\t\t\t\t LIMIT 1`,\n\t\t\t)\n\t\t\t.get(ref, normalizedResourceId, normalizedAction) as { problem_id: string } | undefined;\n\t\tif (row) {\n\t\t\tmergedProblemId = row.problem_id;\n\t\t\tbreak;\n\t\t}\n\t}\n\n\treturn store.transaction(() => {\n\t\tif (mergedProblemId !== undefined) {\n\t\t\t// 同来源重复申报：复用已有 problemId，返回 merged。\n\t\t\t// 把本次全部证据引用补进关联（UNIQUE 约束幂等防重），后续任一引用再申报都能命中。\n\t\t\t// O10/E02 幂等口径：同一 evidenceRef 重报 = 同一事件重放，不累计\n\t\t\t// occurrence_count；只有本次申报带「尚未关联到该 problem 的新引用」\n\t\t\t// （不同真实事件命中同 problem）才 +1——本次申报本身是「再次发生」\n\t\t\t// 的证据，不依赖模型自报（缺省 1）。\n\t\t\tlet hasNewRef = false;\n\t\t\tfor (const ref of input.evidenceRefs) {\n\t\t\t\tif (insertProblemSourceLink(store, mergedProblemId, ref, now)) hasNewRef = true;\n\t\t\t}\n\t\t\tif (hasNewRef) {\n\t\t\t\tconst bump = input.occurrenceCount ?? 1;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(`UPDATE evolution_problems SET occurrence_count = occurrence_count + ?, updated_at = ? WHERE problem_id = ?`)\n\t\t\t\t\t.run(bump, now, mergedProblemId);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\taccepted: true,\n\t\t\t\tproblemId: mergedProblemId,\n\t\t\t\tdisposition: \"merged\" as const,\n\t\t\t};\n\t\t}\n\n\t\tconst problemId = `prob-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tproject_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tproblemId,\n\t\t\t\tinput.kind,\n\t\t\t\tnormalizedAction,\n\t\t\t\tinput.summary.trim(),\n\t\t\t\tinput.reason ?? null,\n\t\t\t\tinput.expectedBehavior.trim(),\n\t\t\t\tinput.actualBehavior.trim(),\n\t\t\t\tJSON.stringify(input.evidenceRefs),\n\t\t\t\tinput.occurrenceCount ?? 1,\n\t\t\t\tnormalizedResourceId,\n\t\t\t\tinput.baseVersion ?? null,\n\t\t\t\tinput.projectId ?? null,\n\t\t\t\tinput.taskId ?? null,\n\t\t\t\tinput.sessionId ?? null,\n\t\t\t\tinput.entryId ?? null,\n\t\t\t\tinput.toolCallId ?? null,\n\t\t\t\t\"observed\",\n\t\t\t\t\"pending_classification\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 全部证据引用写入 evolution_source_links（owner_kind='problem'）：\n\t\t// src- 前缀是真 sources 行；其他是宿主稳定引用（friction:/toolcall: 等），\n\t\t// 都作去重键。来源删除回查按 src- ID 查，不受其他引用影响。\n\t\tfor (const ref of input.evidenceRefs) {\n\t\t\tinsertProblemSourceLink(store, problemId, ref, now);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: true,\n\t\t\tproblemId,\n\t\t\tdisposition: \"pending_classification\" as const,\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形引用解析为记忆修订坐标；不匹配返回 undefined。 */\nconst MEMORY_REVISION_REF_RE = /^mem-(.+?)@rev-(\\d+)$/;\n\n/**\n * 插入 problem → source 关联；同 (owner_kind, owner_id, source_id) 幂等跳过。\n * 返回 true = 本次新插入（此前未关联）；false = 关联已存在（同事件重放）。\n * O10/E02：mem-*@rev-* 形引用补写 memory_id/revision 列，供详情页按记忆回读。\n */\nfunction insertProblemSourceLink(store: MemoryStore, problemId: string, sourceId: string, createdAt: string): boolean {\n\tconst mem = MEMORY_REVISION_REF_RE.exec(sourceId);\n\ttry {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-${randomUUID()}`, problemId, sourceId, mem?.[1] ?? null, mem?.[2] === undefined ? null : Number(mem[2]), createdAt);\n\t\treturn true;\n\t} catch (error) {\n\t\t// UNIQUE(owner_kind, owner_id, source_id) 冲突：同来源重复申报的幂等补链，跳过。\n\t\tif (error instanceof Error && error.message.includes(\"UNIQUE\")) return false;\n\t\tthrow error;\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. collectEvolutionProblem —— 从失败回执/用户纠正收集事实\n// ════════════════════════════════════════════════════════════════════════\n\n/** `collectEvolutionProblem` 的输入。 */\nexport interface CollectEvolutionProblemInput {\n\t/** 失败条件/实际行为描述。 */\n\tactualBehavior: string;\n\t/** 预期行为描述。 */\n\texpectedBehavior: string;\n\t/** 问题摘要。 */\n\tsummary: string;\n\t/** 问题类别（可选；缺省 implementation_defect 先登记待分类）。 */\n\tkind?: EvolutionProblemKind;\n\t/** 建议动作（可选）。 */\n\taction?: EvolutionProblemAction;\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本。 */\n\tbaseVersion?: string;\n\t/** 已用记忆修订（sourceId 列表）。 */\n\tmemoryRevisionRefs?: string[];\n\t/** 宿主补的 taskId。 */\n\ttaskId?: string;\n\t/** 宿主补的 sessionId。 */\n\tsessionId?: string;\n\t/** 宿主补的 entryId。 */\n\tentryId?: string;\n\t/** 宿主补的 toolCallId。 */\n\ttoolCallId?: string;\n\t/** 来源 ID 列表（稳定引用；至少一条）。 */\n\tsourceIds: string[];\n\t/** 登记时间（夹具注入）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1。 */\n\toccurrenceCount?: number;\n}\n\n/**\n * 从失败回执/用户纠正/使用记录收集问题事实。\n *\n * 只读事实输入：sourceIds 是已登记来源；memoryRevisionRefs 是已用记忆修订。\n * 已有同来源问题复用 ID；不凭模型建议造「重复发生」。\n */\nexport function collectEvolutionProblem(\n\tstore: MemoryStore,\n\tinput: CollectEvolutionProblemInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\t// 组装证据引用：sourceIds + memoryRevisionRefs + toolCallId（若有）。\n\tconst evidenceRefs = [...input.sourceIds];\n\tif (input.memoryRevisionRefs) evidenceRefs.push(...input.memoryRevisionRefs);\n\tif (input.toolCallId) evidenceRefs.push(`toolcall:${input.toolCallId}`);\n\n\treturn declareImprovementIntent(store, {\n\t\t// O10：真实 kind 透传（unused_experience 等登记时已知类别的申报不再被\n\t\t// 压成 implementation_defect）；缺省先标实现缺陷，分类时再纠正。\n\t\tkind: input.kind ?? \"implementation_defect\",\n\t\taction: input.action,\n\t\tsummary: input.summary,\n\t\texpectedBehavior: input.expectedBehavior,\n\t\tactualBehavior: input.actualBehavior,\n\t\tevidenceRefs,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\ttaskId: input.taskId,\n\t\tsessionId: input.sessionId,\n\t\tentryId: input.entryId,\n\t\ttoolCallId: input.toolCallId,\n\t\tcreatedAt: input.createdAt,\n\t\toccurrenceCount: input.occurrenceCount,\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. classifyProblem —— S8-04 分类\n// ════════════════════════════════════════════════════════════════════════\n\n/** `classifyProblem` 的输入。 */\nexport interface ClassifyProblemInput {\n\tproblemId: string;\n\t/** 分类时判定的原因（覆盖登记时的 reason）。 */\n\treason?: string;\n\t/** 分类时间（夹具注入）。 */\n\tclassifiedAt?: string;\n}\n\n/** `classifyProblem` 的输出。 */\nexport interface ClassifyProblemResult {\n\tproblemId: string;\n\tkind: EvolutionProblemKind;\n\taction?: EvolutionProblemAction;\n\treason: string;\n}\n\n/**\n * 对已登记问题分类（S8-04）。\n *\n * 顺序：\n * 1. 查当时是否召回/注入正确经验（unused_experience）——优先改检索/提示策略；\n * 2. 查调用参数/实现版本（invocation / implementation_defect）；\n * 3. 核心缺陷输出 development_suggestion。\n *\n * 只读事实：用 memory_usage 表核对同 task/session 下相关记忆是否被\n * search/inject/expand/used；有命中且未 used 则倾向 unused_experience。\n * O10/E03 收窄：仅当问题与某条记忆修订**明确关联**（evidenceRefs 含该\n * memoryId/mem-*@rev-N，或 taskId/toolCallId 与未采用记录的 request_id\n * 重合）才改判 unused_experience；同 task/session 下无关的未采用记忆不覆盖\n * 原分类——禁止对象判断先于可改资源选择。\n */\nexport function classifyProblem(\n\tstore: MemoryStore,\n\tinput: ClassifyProblemInput,\n): MemoryResult<ClassifyProblemResult> {\n\tconst now = input.classifiedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态不再分类。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn fail(\"invalid_input\", `问题已终态(${problem.status})，不再分类`, input.problemId);\n\t\t}\n\n\t\t// 1) 先查是否未采用已有经验：\n\t\t//    同 task/session 下，若有 memory_usage 记录显示某记忆被 search/inject/expand\n\t\t//    但未被 used，说明已有经验没被采用——问题类别应为 unused_experience。\n\t\tlet kind: EvolutionProblemKind = problem.kind;\n\t\tlet action: EvolutionProblemAction | undefined = problem.action;\n\t\tlet reason = input.reason ?? problem.reason ?? \"\";\n\n\t\tconst unused = detectUnusedExperience(store, problem);\n\t\tif (unused !== undefined) {\n\t\t\tkind = \"unused_experience\";\n\t\t\taction = \"modify\"; // 优先改检索/提示策略（memory-policy 资源）\n\t\t\treason = reason || `已有经验 ${unused.memoryId}@rev${unused.revision} 未被采用`;\n\t\t} else if (kind === \"core_issue\") {\n\t\t\t// 2) 核心缺陷：动作固定 development_suggestion。\n\t\t\taction = \"development_suggestion\";\n\t\t} else if (kind === \"invocation\") {\n\t\t\t// 3) 调用方式问题：参数误用/上下文组织错误，动作 modify（改命令/扩展参数组织）。\n\t\t\taction = action ?? \"modify\";\n\t\t} else if (kind === \"implementation_defect\") {\n\t\t\t// 4) 资源实现缺陷：动作 modify（改资源正文/实现）。\n\t\t\taction = action ?? \"modify\";\n\t\t}\n\n\t\t// 写回分类结果并推进状态机。\n\t\tconst nextStatus: EvolutionProblemStatus = \"classified\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET kind = ?, action = ?, reason = ?, status = ?, disposition = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(kind, action ?? null, reason || null, nextStatus, \"pending_classification\", now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\tkind,\n\t\t\t...(action === undefined ? {} : { action }),\n\t\t\treason: reason || \"分类完成\",\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形证据引用解析；也容忍裸 memoryId 引用。 */\nconst EVIDENCE_MEMORY_REV_RE = /mem-(.+?)@rev-(\\d+)/;\n\n/**\n * 检测与问题**明确关联**的「已召回但未采用」记忆（O10/E03 收窄）。\n *\n * 关联判据（任一满足才算明确关联，缺省不覆盖原分类）：\n * - 问题 evidenceRefs 含 `mem-<id>@rev-<n>` 引用；\n * - 问题 taskId/toolCallId 命中该未采用记录的 request_id（同一调用上下文）；\n * - 问题与该未采用记录同 session 且 request_id 也命中 taskId/toolCallId\n *   （问题只有 sessionId 时的最窄依据——同请求注入未采用即「当时没用它」）。\n * 同 task/session 下与问题无关的未采用记录不再把问题改判 unused_experience。\n */\nfunction detectUnusedExperience(\n\tstore: MemoryStore,\n\tproblem: EvolutionProblem,\n): { memoryId: string; revision: number } | undefined {\n\tif (problem.taskId === undefined && problem.sessionId === undefined) return undefined;\n\tconst where: string[] = [];\n\tconst params: unknown[] = [];\n\tif (problem.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(problem.taskId);\n\t}\n\tif (problem.sessionId !== undefined) {\n\t\twhere.push(\"session_id = ?\");\n\t\tparams.push(problem.sessionId);\n\t}\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT memory_id, revision, action, request_id, session_id FROM memory_usage\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t ORDER BY created_at`,\n\t\t)\n\t\t.all(...(params as never[])) as unknown as Array<{\n\t\tmemory_id: string;\n\t\trevision: number;\n\t\taction: string;\n\t\trequest_id: string | null;\n\t\tsession_id: string | null;\n\t}>;\n\n\t// 按 memoryId+revision 分组：有 search/inject/expand 但无 used → 未采用。\n\tconst byKey = new Map<\n\t\tstring,\n\t\t{ memoryId: string; revision: number; actions: Set<string>; requestIds: Set<string>; sessionIds: Set<string> }\n\t>();\n\tfor (const row of rows) {\n\t\tconst key = `${row.memory_id}@${row.revision}`;\n\t\tconst entry =\n\t\t\tbyKey.get(key) ?? {\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t\tactions: new Set(),\n\t\t\t\trequestIds: new Set(),\n\t\t\t\tsessionIds: new Set(),\n\t\t\t};\n\t\tentry.actions.add(row.action);\n\t\tif (row.request_id !== null) entry.requestIds.add(row.request_id);\n\t\tif (row.session_id !== null) entry.sessionIds.add(row.session_id);\n\t\tbyKey.set(key, entry);\n\t}\n\n\t// 问题侧关联键：evidenceRefs 里解析出的 mem-*@rev-* 坐标，\n\t// 以及能与 memory_usage.request_id 对齐的身份键（taskId/toolCallId）。\n\tconst refKeys = new Set<string>();\n\tfor (const ref of problem.evidenceRefs) {\n\t\tconst match = EVIDENCE_MEMORY_REV_RE.exec(ref);\n\t\tif (match) refKeys.add(`${match[1]}@${match[2]}`);\n\t}\n\tconst identityKeys = [problem.taskId, problem.toolCallId].filter((value): value is string => value !== undefined);\n\n\tfor (const [key, entry] of byKey.entries()) {\n\t\tif (\n\t\t\t!(entry.actions.has(\"search\") || entry.actions.has(\"inject\") || entry.actions.has(\"expand\")) ||\n\t\t\tentry.actions.has(\"used\")\n\t\t) {\n\t\t\tcontinue;\n\t\t}\n\t\t// 明确关联判据：证据引用指向该修订；身份键与某条记录的 request_id 重合；\n\t\t// 或问题与该记录同 session 且 request_id 也命中身份键——同会话同请求\n\t\t// 注入未采用即「当时没用它」。纯同 task/session 的无关记录不关联。\n\t\tconst linkedByRef = refKeys.has(key);\n\t\tconst linkedByRequest = identityKeys.some((id) => entry.requestIds.has(id));\n\t\tconst linkedBySession =\n\t\t\tproblem.sessionId !== undefined && entry.sessionIds.has(problem.sessionId) && entry.requestIds.size > 0;\n\t\tif (linkedByRef || linkedByRequest || linkedBySession) {\n\t\t\treturn { memoryId: entry.memoryId, revision: entry.revision };\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 内部 SQL\n// ════════════════════════════════════════════════════════════════════════\n\n/** 按 problemId 取完整行（select 等模块的行读取统一走这里）。 */\nexport function getProblemRow(store: MemoryStore, problemId: string): EvolutionProblemDbRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t        project_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t        status, disposition, created_at, updated_at\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(problemId) as EvolutionProblemDbRow | undefined;\n}\n\n/** 按 problemId 取已登记问题（公开查询）。 */\nexport function getEvolutionProblem(store: MemoryStore, problemId: string): MemoryResult<EvolutionProblem> {\n\tconst row = getProblemRow(store, problemId);\n\tif (!row) return fail(\"invalid_input\", `问题未登记:${problemId}`, problemId);\n\treturn { ok: true, ...rowToProblem(row) };\n}\n\n/** 取某来源关联的全部问题（沿删除入口回查用）。 */\nexport function problemsForSource(store: MemoryStore, sourceId: string): EvolutionProblem[] {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT p.problem_id, p.kind, p.action, p.summary, p.reason, p.expected_behavior, p.actual_behavior,\n\t\t\t        p.evidence_refs_json, p.occurrence_count, p.resource_id, p.base_version,\n\t\t\t        p.project_id, p.task_id, p.session_id, p.entry_id, p.tool_call_id,\n\t\t\t        p.status, p.disposition, p.created_at, p.updated_at\n\t\t\t FROM evolution_source_links l\n\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t ORDER BY p.created_at`,\n\t\t)\n\t\t.all(sourceId) as unknown as EvolutionProblemDbRow[];\n\treturn rows.map(rowToProblem);\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n *\t\t\t\tconst bump = input.occurrenceCount ?? 1;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`UPDATE evolution_problems SET occurrence_count = occurrence_count + ?, updated_at = ? WHERE problem_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(bump, now, mergedProblemId);\n\t\t\t}\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-${randomUUID()}`, problemId,sourceId,mem?.[1] ?? null,mem?.[2] === undefined ? null : Number(mem[2]),createdAt);\n\t\treturn true;\n\t} catch (error) { * 原分类——禁止对象判断先于可改资源选择。\n */\nexport function classifyProblem(store: MemoryStore,input: ClassifyProblemInput): MemoryResult<ClassifyProblemResult> {\n\tconst now = input.classifiedAt ?? new Date().toISOString();\n\tfor (const row of rows) {\n\t\tconst key = `${row.memory_id}@${row.revision}`;\n\t\tconst entry =byKey.get(key) ?? {\n\t\t\tmemoryId: row.memory_id,\n\t\t\trevision: row.revision,\n\t\t\tactions: new Set(),\n\t\t\trequestIds: new Set(),\n\t\t\tsessionIds: new Set(),\n\t\t};\n\t\tentry.actions.add(row.action);\n\t\tif (row.request_id !== null) entry.requestIds.add(row.request_id);\treturn rows.map(rowToProblem);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":240}},{"diffOp":{"equal":{"range":[63,135]}}},{"diffOp":{"insert":{"range":[135,142]}}},{"diffOp":{"equal":{"range":[142,250]}}},{"diffOp":{"insert":{"range":[250,257]}}},{"diffOp":{"equal":{"range":[257,302]}}},{"equalLines":{"line_count":71}},{"diffOp":{"equal":{"range":[302,359]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[359,382]}}},{"diffOp":{"delete":{"range":[382,383]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[383,393]}}},{"diffOp":{"delete":{"range":[382,383]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[393,402]}}},{"diffOp":{"delete":{"range":[382,383]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[402,419]}}},{"diffOp":{"delete":{"range":[382,383]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[419,466]}}},{"diffOp":{"delete":{"range":[382,383]}}},{"diffOp":{"insert":{"range":[135,140]}}},{"diffOp":{"equal":{"range":[466,475]}}},{"diffOp":{"insert":{"range":[250,255]}}},{"diffOp":{"equal":{"range":[475,511]}}},{"equalLines":{"line_count":113}},{"diffOp":{"equal":{"range":[511,611]}}},{"diffOp":{"delete":{"range":[135,137]}}},{"diffOp":{"equal":{"range":[611,630]}}},{"diffOp":{"delete":{"range":[135,137]}}},{"diffOp":{"insert":{"range":[511,512]}}},{"diffOp":{"equal":{"range":[630,657]}}},{"diffOp":{"delete":{"range":[250,252]}}},{"diffOp":{"equal":{"range":[657,759]}}},{"equalLines":{"line_count":103}},{"diffOp":{"equal":{"range":[759,851]}}},{"diffOp":{"delete":{"range":[135,139]}}},{"diffOp":{"insert":{"range":[511,512]}}},{"diffOp":{"equal":{"range":[851,874]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[874,899]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[899,929]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[929,949]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[949,978]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[978,1001]}}},{"diffOp":{"delete":{"range":[759,760]}}},{"diffOp":{"equal":{"range":[1001,1107]}}},{"equalLines":{"line_count":72}},{"diffOp":{"equal":{"range":[1107,1141]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\problems.ts"},"span":null,"sourceCode":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n *\n * 职责：\n * - `declareImprovementIntent`：统一问题登记入口。输入含 kind/action/summary/\n *   expectedBehavior/actualBehavior/evidenceRefs；宿主补 projectId/taskId/\n *   sessionId/entryId/toolCallId，**不信模型自报身份**。返回\n *   `{accepted, problemId?, disposition, reason?}`。\n * - `collectEvolutionProblem`：从失败回执/用户纠正/使用记录取得事实输入，\n *   只读事实，已有同来源问题复用 ID。\n * - `classifyProblem`：S8-04 分类——先查是否未采用已有经验（unused_experience，\n *   优先改检索/提示策略），再查调用参数/实现版本（invocation/implementation_defect），\n *   核心缺陷输出 development_suggestion。\n * - 来源关联写入 `evolution_source_links`（owner_kind='problem'）。\n *\n * 契约（S8 任务书 §5）：\n * - `occurrenceCount` 只由独立事实来源计算，不算摘要指纹；模型单次申报不能标\n *   「重复失败」。\n * - 同 sourceId + resourceId + action 重复申报复用已有 problemId，返回\n *   disposition='merged'。\n * - 证据为空且非「有依据的机会」类时返回不受理理由，不伪造失败记录。\n * - 登记后资源文件未改；模型验证调用为零。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getSource } from \"../memory/sources.ts\";\nimport {\n\tEVOLUTION_PROBLEM_ACTIONS,\n\tEVOLUTION_PROBLEM_KINDS,\n\tEVOLUTION_PROBLEM_STATUSES,\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemKind,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 行映射\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * evolution_problems 全列行形状与映射：本模块唯一正本。\n * select.ts 等其他模块需要完整 Problem 时复用本行读取（O14：字段增补只改这里）。\n */\nexport interface EvolutionProblemDbRow {\n\tproblem_id: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpected_behavior: string;\n\tactual_behavior: string;\n\tevidence_refs_json: string;\n\toccurrence_count: number;\n\tresource_id: string | null;\n\tbase_version: string | null;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsession_id: string | null;\n\tentry_id: string | null;\n\ttool_call_id: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\nexport function rowToProblem(row: EvolutionProblemDbRow): EvolutionProblem {\n\treturn {\n\t\tproblemId: row.problem_id,\n\t\tkind: row.kind as EvolutionProblemKind,\n\t\t...(row.action === null ? {} : { action: row.action as EvolutionProblemAction }),\n\t\tsummary: row.summary,\n\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\texpectedBehavior: row.expected_behavior,\n\t\tactualBehavior: row.actual_behavior,\n\t\tevidenceRefs: JSON.parse(row.evidence_refs_json) as string[],\n\t\toccurrenceCount: row.occurrence_count,\n\t\t...(row.resource_id === null ? {} : { resourceId: row.resource_id }),\n\t\t...(row.base_version === null ? {} : { baseVersion: row.base_version }),\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t...(row.session_id === null ? {} : { sessionId: row.session_id }),\n\t\t...(row.entry_id === null ? {} : { entryId: row.entry_id }),\n\t\t...(row.tool_call_id === null ? {} : { toolCallId: row.tool_call_id }),\n\t\tstatus: row.status as EvolutionProblemStatus,\n\t\tdisposition: row.disposition as EvolutionProblemDisposition,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. declareImprovementIntent —— 统一问题登记\n// ════════════════════════════════════════════════════════════════════════\n\n/** `declareImprovementIntent` 的输入。 */\nexport interface DeclareImprovementIntentInput {\n\t/** 问题类别（宿主/模型申报）。 */\n\tkind: EvolutionProblemKind;\n\t/** 建议动作（可选；登记时未分类可缺省）。 */\n\taction?: EvolutionProblemAction;\n\t/** 一句话摘要。 */\n\tsummary: string;\n\t/** 发生原因（模型推测标 model_inference）。 */\n\treason?: string;\n\t/** 预期行为。 */\n\texpectedBehavior: string;\n\t/** 实际行为（有真实回执时必填）。 */\n\tactualBehavior: string;\n\t/** 证据引用：sourceId / memoryId / revision / toolCallId / receiptRef。 */\n\tevidenceRefs: string[];\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本（问题发生时的资源版本）。 */\n\tbaseVersion?: string;\n\t/** 宿主补的项目 ID。 */\n\tprojectId?: string;\n\t/** 宿主补的任务 ID。 */\n\ttaskId?: string;\n\t/** 宿主补的会话 ID。 */\n\tsessionId?: string;\n\t/** 宿主补的会话条目 ID。 */\n\tentryId?: string;\n\t/** 宿主补的工具调用 ID。 */\n\ttoolCallId?: string;\n\t/** 登记时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1，不给模型自报「重复」。 */\n\toccurrenceCount?: number;\n}\n\n/** `declareImprovementIntent` 的输出。 */\nexport interface DeclareImprovementIntentResult {\n\t/** 是否受理。 */\n\taccepted: boolean;\n\t/** 已登记/复用的问题 ID。 */\n\tproblemId?: string;\n\t/** 处置结果。 */\n\tdisposition?: EvolutionProblemDisposition;\n\t/** 不受理理由。 */\n\treason?: string;\n}\n\n/**\n * 统一问题登记。\n *\n * 证据校验：evidenceRefs 为空且非「有依据的机会」类时返回不受理理由。\n * 去重：同 sourceId + resourceId + action 复用已有 problemId（查\n * evolution_source_links + evolution_problems），不算摘要指纹。\n * occurrenceCount 只由独立事实来源计算；不给模型自报「重复」。\n */\nexport function declareImprovementIntent(\n\tstore: MemoryStore,\n\tinput: DeclareImprovementIntentInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\t// 基础输入校验\n\tif (!EVOLUTION_PROBLEM_KINDS.includes(input.kind)) {\n\t\treturn fail(\"invalid_input\", `未知问题类别:${String(input.kind)}`, String(input.kind));\n\t}\n\tif (input.action !== undefined && !EVOLUTION_PROBLEM_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知问题动作:${String(input.action)}`, String(input.action));\n\t}\n\tif (typeof input.summary !== \"string\" || input.summary.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"问题摘要不能为空\", input.kind);\n\t}\n\tif (typeof input.expectedBehavior !== \"string\" || input.expectedBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"预期行为不能为空\", input.kind);\n\t}\n\tif (typeof input.actualBehavior !== \"string\" || input.actualBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"实际行为不能为空\", input.kind);\n\t}\n\n\t// 证据校验：evidenceRefs 为空且非「有依据的机会」类时不受理。\n\t// 「有依据的机会」类（unused_experience / invocation / implementation_defect / core_issue）\n\t// 都须至少一条证据；空证据的泛化建议不伪造失败记录。\n\tif (input.evidenceRefs.length === 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: \"无证据引用：evidenceRefs 至少一条，不接受空证据的泛化建议\",\n\t\t};\n\t}\n\n\t// 证据引用分两类：\n\t// - src- 前缀：sources 表已登记来源，校验存在性（缺失即整体拒绝）。\n\t// - 其他（friction:/toolcall:/mem-*@rev-* 等）：宿主给的稳定引用，不入 sources 表\n\t//   但同样作为去重键写 evolution_source_links。\n\tconst realSourceIds = input.evidenceRefs.filter((ref) => ref.startsWith(\"src-\"));\n\tconst missingSources = realSourceIds.filter((id) => !getSource(store.db, id));\n\tif (missingSources.length > 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: `来源不存在:${missingSources.join(\"、\")}——不伪造失败记录`,\n\t\t};\n\t}\n\n\t// 去重：同来源引用（任一 evidenceRef）+ 同 resourceId + 同 action 复用已有 problemId。\n\t// 「同来源」指同一稳定证据引用，不限 src- 前缀——摩擦草稿、回执、toolcall 等\n\t// 宿主生成的稳定引用同样算来源。不算摘要指纹。\n\tconst normalizedResourceId = input.resourceId?.trim() || null;\n\tconst normalizedAction = input.action ?? null;\n\tlet mergedProblemId: string | undefined;\n\tfor (const ref of input.evidenceRefs) {\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT p.problem_id FROM evolution_source_links l\n\t\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t\t   AND COALESCE(p.resource_id, '') = COALESCE(?, '')\n\t\t\t\t   AND COALESCE(p.action, '') = COALESCE(?, '')\n\t\t\t\t LIMIT 1`,\n\t\t\t)\n\t\t\t.get(ref, normalizedResourceId, normalizedAction) as { problem_id: string } | undefined;\n\t\tif (row) {\n\t\t\tmergedProblemId = row.problem_id;\n\t\t\tbreak;\n\t\t}\n\t}\n\n\treturn store.transaction(() => {\n\t\tif (mergedProblemId !== undefined) {\n\t\t\t// 同来源重复申报：复用已有 problemId，返回 merged。\n\t\t\t// 把本次全部证据引用补进关联（UNIQUE 约束幂等防重），后续任一引用再申报都能命中。\n\t\t\t// O10/E02 幂等口径：同一 evidenceRef 重报 = 同一事件重放，不累计\n\t\t\t// occurrence_count；只有本次申报带「尚未关联到该 problem 的新引用」\n\t\t\t// （不同真实事件命中同 problem）才 +1——本次申报本身是「再次发生」\n\t\t\t// 的证据，不依赖模型自报（缺省 1）。\n\t\t\tlet hasNewRef = false;\n\t\t\tfor (const ref of input.evidenceRefs) {\n\t\t\t\tif (insertProblemSourceLink(store, mergedProblemId, ref, now)) hasNewRef = true;\n\t\t\t}\n\t\t\tif (hasNewRef) {\n\t\t\t\tconst bump = input.occurrenceCount ?? 1;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(`UPDATE evolution_problems SET occurrence_count = occurrence_count + ?, updated_at = ? WHERE problem_id = ?`)\n\t\t\t\t\t.run(bump, now, mergedProblemId);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\taccepted: true,\n\t\t\t\tproblemId: mergedProblemId,\n\t\t\t\tdisposition: \"merged\" as const,\n\t\t\t};\n\t\t}\n\n\t\tconst problemId = `prob-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tproject_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tproblemId,\n\t\t\t\tinput.kind,\n\t\t\t\tnormalizedAction,\n\t\t\t\tinput.summary.trim(),\n\t\t\t\tinput.reason ?? null,\n\t\t\t\tinput.expectedBehavior.trim(),\n\t\t\t\tinput.actualBehavior.trim(),\n\t\t\t\tJSON.stringify(input.evidenceRefs),\n\t\t\t\tinput.occurrenceCount ?? 1,\n\t\t\t\tnormalizedResourceId,\n\t\t\t\tinput.baseVersion ?? null,\n\t\t\t\tinput.projectId ?? null,\n\t\t\t\tinput.taskId ?? null,\n\t\t\t\tinput.sessionId ?? null,\n\t\t\t\tinput.entryId ?? null,\n\t\t\t\tinput.toolCallId ?? null,\n\t\t\t\t\"observed\",\n\t\t\t\t\"pending_classification\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 全部证据引用写入 evolution_source_links（owner_kind='problem'）：\n\t\t// src- 前缀是真 sources 行；其他是宿主稳定引用（friction:/toolcall: 等），\n\t\t// 都作去重键。来源删除回查按 src- ID 查，不受其他引用影响。\n\t\tfor (const ref of input.evidenceRefs) {\n\t\t\tinsertProblemSourceLink(store, problemId, ref, now);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: true,\n\t\t\tproblemId,\n\t\t\tdisposition: \"pending_classification\" as const,\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形引用解析为记忆修订坐标；不匹配返回 undefined。 */\nconst MEMORY_REVISION_REF_RE = /^mem-(.+?)@rev-(\\d+)$/;\n\n/**\n * 插入 problem → source 关联；同 (owner_kind, owner_id, source_id) 幂等跳过。\n * 返回 true = 本次新插入（此前未关联）；false = 关联已存在（同事件重放）。\n * O10/E02：mem-*@rev-* 形引用补写 memory_id/revision 列，供详情页按记忆回读。\n */\nfunction insertProblemSourceLink(store: MemoryStore, problemId: string, sourceId: string, createdAt: string): boolean {\n\tconst mem = MEMORY_REVISION_REF_RE.exec(sourceId);\n\ttry {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-${randomUUID()}`, problemId, sourceId, mem?.[1] ?? null, mem?.[2] === undefined ? null : Number(mem[2]), createdAt);\n\t\treturn true;\n\t} catch (error) {\n\t\t// UNIQUE(owner_kind, owner_id, source_id) 冲突：同来源重复申报的幂等补链，跳过。\n\t\tif (error instanceof Error && error.message.includes(\"UNIQUE\")) return false;\n\t\tthrow error;\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. collectEvolutionProblem —— 从失败回执/用户纠正收集事实\n// ════════════════════════════════════════════════════════════════════════\n\n/** `collectEvolutionProblem` 的输入。 */\nexport interface CollectEvolutionProblemInput {\n\t/** 失败条件/实际行为描述。 */\n\tactualBehavior: string;\n\t/** 预期行为描述。 */\n\texpectedBehavior: string;\n\t/** 问题摘要。 */\n\tsummary: string;\n\t/** 问题类别（可选；缺省 implementation_defect 先登记待分类）。 */\n\tkind?: EvolutionProblemKind;\n\t/** 建议动作（可选）。 */\n\taction?: EvolutionProblemAction;\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本。 */\n\tbaseVersion?: string;\n\t/** 已用记忆修订（sourceId 列表）。 */\n\tmemoryRevisionRefs?: string[];\n\t/** 宿主补的 taskId。 */\n\ttaskId?: string;\n\t/** 宿主补的 sessionId。 */\n\tsessionId?: string;\n\t/** 宿主补的 entryId。 */\n\tentryId?: string;\n\t/** 宿主补的 toolCallId。 */\n\ttoolCallId?: string;\n\t/** 来源 ID 列表（稳定引用；至少一条）。 */\n\tsourceIds: string[];\n\t/** 登记时间（夹具注入）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1。 */\n\toccurrenceCount?: number;\n}\n\n/**\n * 从失败回执/用户纠正/使用记录收集问题事实。\n *\n * 只读事实输入：sourceIds 是已登记来源；memoryRevisionRefs 是已用记忆修订。\n * 已有同来源问题复用 ID；不凭模型建议造「重复发生」。\n */\nexport function collectEvolutionProblem(\n\tstore: MemoryStore,\n\tinput: CollectEvolutionProblemInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\t// 组装证据引用：sourceIds + memoryRevisionRefs + toolCallId（若有）。\n\tconst evidenceRefs = [...input.sourceIds];\n\tif (input.memoryRevisionRefs) evidenceRefs.push(...input.memoryRevisionRefs);\n\tif (input.toolCallId) evidenceRefs.push(`toolcall:${input.toolCallId}`);\n\n\treturn declareImprovementIntent(store, {\n\t\t// O10：真实 kind 透传（unused_experience 等登记时已知类别的申报不再被\n\t\t// 压成 implementation_defect）；缺省先标实现缺陷，分类时再纠正。\n\t\tkind: input.kind ?? \"implementation_defect\",\n\t\taction: input.action,\n\t\tsummary: input.summary,\n\t\texpectedBehavior: input.expectedBehavior,\n\t\tactualBehavior: input.actualBehavior,\n\t\tevidenceRefs,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\ttaskId: input.taskId,\n\t\tsessionId: input.sessionId,\n\t\tentryId: input.entryId,\n\t\ttoolCallId: input.toolCallId,\n\t\tcreatedAt: input.createdAt,\n\t\toccurrenceCount: input.occurrenceCount,\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. classifyProblem —— S8-04 分类\n// ════════════════════════════════════════════════════════════════════════\n\n/** `classifyProblem` 的输入。 */\nexport interface ClassifyProblemInput {\n\tproblemId: string;\n\t/** 分类时判定的原因（覆盖登记时的 reason）。 */\n\treason?: string;\n\t/** 分类时间（夹具注入）。 */\n\tclassifiedAt?: string;\n}\n\n/** `classifyProblem` 的输出。 */\nexport interface ClassifyProblemResult {\n\tproblemId: string;\n\tkind: EvolutionProblemKind;\n\taction?: EvolutionProblemAction;\n\treason: string;\n}\n\n/**\n * 对已登记问题分类（S8-04）。\n *\n * 顺序：\n * 1. 查当时是否召回/注入正确经验（unused_experience）——优先改检索/提示策略；\n * 2. 查调用参数/实现版本（invocation / implementation_defect）；\n * 3. 核心缺陷输出 development_suggestion。\n *\n * 只读事实：用 memory_usage 表核对同 task/session 下相关记忆是否被\n * search/inject/expand/used；有命中且未 used 则倾向 unused_experience。\n * O10/E03 收窄：仅当问题与某条记忆修订**明确关联**（evidenceRefs 含该\n * memoryId/mem-*@rev-N，或 taskId/toolCallId 与未采用记录的 request_id\n * 重合）才改判 unused_experience；同 task/session 下无关的未采用记忆不覆盖\n * 原分类——禁止对象判断先于可改资源选择。\n */\nexport function classifyProblem(\n\tstore: MemoryStore,\n\tinput: ClassifyProblemInput,\n): MemoryResult<ClassifyProblemResult> {\n\tconst now = input.classifiedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态不再分类。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn fail(\"invalid_input\", `问题已终态(${problem.status})，不再分类`, input.problemId);\n\t\t}\n\n\t\t// 1) 先查是否未采用已有经验：\n\t\t//    同 task/session 下，若有 memory_usage 记录显示某记忆被 search/inject/expand\n\t\t//    但未被 used，说明已有经验没被采用——问题类别应为 unused_experience。\n\t\tlet kind: EvolutionProblemKind = problem.kind;\n\t\tlet action: EvolutionProblemAction | undefined = problem.action;\n\t\tlet reason = input.reason ?? problem.reason ?? \"\";\n\n\t\tconst unused = detectUnusedExperience(store, problem);\n\t\tif (unused !== undefined) {\n\t\t\tkind = \"unused_experience\";\n\t\t\taction = \"modify\"; // 优先改检索/提示策略（memory-policy 资源）\n\t\t\treason = reason || `已有经验 ${unused.memoryId}@rev${unused.revision} 未被采用`;\n\t\t} else if (kind === \"core_issue\") {\n\t\t\t// 2) 核心缺陷：动作固定 development_suggestion。\n\t\t\taction = \"development_suggestion\";\n\t\t} else if (kind === \"invocation\") {\n\t\t\t// 3) 调用方式问题：参数误用/上下文组织错误，动作 modify（改命令/扩展参数组织）。\n\t\t\taction = action ?? \"modify\";\n\t\t} else if (kind === \"implementation_defect\") {\n\t\t\t// 4) 资源实现缺陷：动作 modify（改资源正文/实现）。\n\t\t\taction = action ?? \"modify\";\n\t\t}\n\n\t\t// 写回分类结果并推进状态机。\n\t\tconst nextStatus: EvolutionProblemStatus = \"classified\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET kind = ?, action = ?, reason = ?, status = ?, disposition = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(kind, action ?? null, reason || null, nextStatus, \"pending_classification\", now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\tkind,\n\t\t\t...(action === undefined ? {} : { action }),\n\t\t\treason: reason || \"分类完成\",\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形证据引用解析；也容忍裸 memoryId 引用。 */\nconst EVIDENCE_MEMORY_REV_RE = /mem-(.+?)@rev-(\\d+)/;\n\n/**\n * 检测与问题**明确关联**的「已召回但未采用」记忆（O10/E03 收窄）。\n *\n * 关联判据（任一满足才算明确关联，缺省不覆盖原分类）：\n * - 问题 evidenceRefs 含 `mem-<id>@rev-<n>` 引用；\n * - 问题 taskId/toolCallId 命中该未采用记录的 request_id（同一调用上下文）；\n * - 问题与该未采用记录同 session 且 request_id 也命中 taskId/toolCallId\n *   （问题只有 sessionId 时的最窄依据——同请求注入未采用即「当时没用它」）。\n * 同 task/session 下与问题无关的未采用记录不再把问题改判 unused_experience。\n */\nfunction detectUnusedExperience(\n\tstore: MemoryStore,\n\tproblem: EvolutionProblem,\n): { memoryId: string; revision: number } | undefined {\n\tif (problem.taskId === undefined && problem.sessionId === undefined) return undefined;\n\tconst where: string[] = [];\n\tconst params: unknown[] = [];\n\tif (problem.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(problem.taskId);\n\t}\n\tif (problem.sessionId !== undefined) {\n\t\twhere.push(\"session_id = ?\");\n\t\tparams.push(problem.sessionId);\n\t}\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT memory_id, revision, action, request_id, session_id FROM memory_usage\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t ORDER BY created_at`,\n\t\t)\n\t\t.all(...(params as never[])) as unknown as Array<{\n\t\tmemory_id: string;\n\t\trevision: number;\n\t\taction: string;\n\t\trequest_id: string | null;\n\t\tsession_id: string | null;\n\t}>;\n\n\t// 按 memoryId+revision 分组：有 search/inject/expand 但无 used → 未采用。\n\tconst byKey = new Map<\n\t\tstring,\n\t\t{ memoryId: string; revision: number; actions: Set<string>; requestIds: Set<string>; sessionIds: Set<string> }\n\t>();\n\tfor (const row of rows) {\n\t\tconst key = `${row.memory_id}@${row.revision}`;\n\t\tconst entry =\n\t\t\tbyKey.get(key) ?? {\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t\tactions: new Set(),\n\t\t\t\trequestIds: new Set(),\n\t\t\t\tsessionIds: new Set(),\n\t\t\t};\n\t\tentry.actions.add(row.action);\n\t\tif (row.request_id !== null) entry.requestIds.add(row.request_id);\n\t\tif (row.session_id !== null) entry.sessionIds.add(row.session_id);\n\t\tbyKey.set(key, entry);\n\t}\n\n\t// 问题侧关联键：evidenceRefs 里解析出的 mem-*@rev-* 坐标，\n\t// 以及能与 memory_usage.request_id 对齐的身份键（taskId/toolCallId）。\n\tconst refKeys = new Set<string>();\n\tfor (const ref of problem.evidenceRefs) {\n\t\tconst match = EVIDENCE_MEMORY_REV_RE.exec(ref);\n\t\tif (match) refKeys.add(`${match[1]}@${match[2]}`);\n\t}\n\tconst identityKeys = [problem.taskId, problem.toolCallId].filter((value): value is string => value !== undefined);\n\n\tfor (const [key, entry] of byKey.entries()) {\n\t\tif (\n\t\t\t!(entry.actions.has(\"search\") || entry.actions.has(\"inject\") || entry.actions.has(\"expand\")) ||\n\t\t\tentry.actions.has(\"used\")\n\t\t) {\n\t\t\tcontinue;\n\t\t}\n\t\t// 明确关联判据：证据引用指向该修订；身份键与某条记录的 request_id 重合；\n\t\t// 或问题与该记录同 session 且 request_id 也命中身份键——同会话同请求\n\t\t// 注入未采用即「当时没用它」。纯同 task/session 的无关记录不关联。\n\t\tconst linkedByRef = refKeys.has(key);\n\t\tconst linkedByRequest = identityKeys.some((id) => entry.requestIds.has(id));\n\t\tconst linkedBySession =\n\t\t\tproblem.sessionId !== undefined && entry.sessionIds.has(problem.sessionId) && entry.requestIds.size > 0;\n\t\tif (linkedByRef || linkedByRequest || linkedBySession) {\n\t\t\treturn { memoryId: entry.memoryId, revision: entry.revision };\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 内部 SQL\n// ════════════════════════════════════════════════════════════════════════\n\n/** 按 problemId 取完整行（select 等模块的行读取统一走这里）。 */\nexport function getProblemRow(store: MemoryStore, problemId: string): EvolutionProblemDbRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t        project_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t        status, disposition, created_at, updated_at\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(problemId) as EvolutionProblemDbRow | undefined;\n}\n\n/** 按 problemId 取已登记问题（公开查询）。 */\nexport function getEvolutionProblem(store: MemoryStore, problemId: string): MemoryResult<EvolutionProblem> {\n\tconst row = getProblemRow(store, problemId);\n\tif (!row) return fail(\"invalid_input\", `问题未登记:${problemId}`, problemId);\n\treturn { ok: true, ...rowToProblem(row) };\n}\n\n/** 取某来源关联的全部问题（沿删除入口回查用）。 */\nexport function problemsForSource(store: MemoryStore, sourceId: string): EvolutionProblem[] {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT p.problem_id, p.kind, p.action, p.summary, p.reason, p.expected_behavior, p.actual_behavior,\n\t\t\t        p.evidence_refs_json, p.occurrence_count, p.resource_id, p.base_version,\n\t\t\t        p.project_id, p.task_id, p.session_id, p.entry_id, p.tool_call_id,\n\t\t\t        p.status, p.disposition, p.created_at, p.updated_at\n\t\t\t FROM evolution_source_links l\n\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t ORDER BY p.created_at`,\n\t\t)\n\t\t.all(sourceId) as unknown as EvolutionProblemDbRow[];\n\treturn rows.map(rowToProblem);\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n * * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,input: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (rr.effective_version !== null &&view.dirOk &&versionState.get(rr.effective_version)?.effective !== true) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":132}},{"diffOp":{"equal":{"range":[51,186]}}},{"diffOp":{"delete":{"range":[186,188]}}},{"diffOp":{"equal":{"range":[188,207]}}},{"diffOp":{"delete":{"range":[186,188]}}},{"diffOp":{"insert":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[207,233]}}},{"diffOp":{"delete":{"range":[233,235]}}},{"diffOp":{"equal":{"range":[235,360]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[360,403]}}},{"diffOp":{"delete":{"range":[403,407]}}},{"diffOp":{"equal":{"range":[407,492]}}},{"diffOp":{"delete":{"range":[492,496]}}},{"diffOp":{"equal":{"range":[496,576]}}},{"equalLines":{"line_count":74}},{"diffOp":{"equal":{"range":[576,660]}}},{"diffOp":{"delete":{"range":[403,407]}}},{"diffOp":{"equal":{"range":[660,692]}}},{"diffOp":{"delete":{"range":[403,407]}}},{"diffOp":{"insert":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[692,705]}}},{"diffOp":{"delete":{"range":[403,407]}}},{"diffOp":{"insert":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[705,763]}}},{"diffOp":{"delete":{"range":[576,579]}}},{"diffOp":{"equal":{"range":[763,832]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[832,867]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":null,"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n * */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[51,136]}}},{"diffOp":{"equal":{"range":[136,144]}}},{"diffOp":{"delete":{"range":[144,149]}}},{"diffOp":{"equal":{"range":[149,151]}}},{"diffOp":{"delete":{"range":[151,163]}}},{"diffOp":{"insert":{"range":[163,177]}}},{"diffOp":{"equal":{"range":[177,196]}}},{"diffOp":{"delete":{"range":[196,204]}}},{"diffOp":{"insert":{"range":[204,212]}}},{"diffOp":{"equal":{"range":[212,214]}}},{"diffOp":{"equal":{"range":[214,269]}}},{"diffOp":{"equal":{"range":[214,222]}}},{"diffOp":{"insert":{"range":[144,149]}}},{"diffOp":{"equal":{"range":[149,151]}}},{"diffOp":{"delete":{"range":[163,177]}}},{"diffOp":{"insert":{"range":[151,163]}}},{"diffOp":{"equal":{"range":[177,196]}}},{"diffOp":{"delete":{"range":[204,212]}}},{"diffOp":{"insert":{"range":[196,204]}}},{"diffOp":{"equal":{"range":[212,214]}}},{"diffOp":{"equal":{"range":[269,327]}}},{"equalLines":{"line_count":253}},{"diffOp":{"equal":{"range":[327,362]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":[1180,1227],"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化退步判定与回退编排（S9-07/08/09）。\n * *   换版历史供人工核对，本批不推断具体业务文件（无来源则空数组）。\n */\n\nimport type { MemoryError,MemoryStoreMemoryResult } from \"../memory/types.tsstore.ts\";\nimport type { \nimport { rollbackResource } from \"./activation.ts\";\n\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,72]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[72,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[176,190]}}},{"diffOp":{"delete":{"range":[190,202]}}},{"diffOp":{"insert":{"range":[202,213]}}},{"diffOp":{"equal":{"range":[72,73]}}},{"diffOp":{"delete":{"range":[213,226]}}},{"diffOp":{"equal":{"range":[226,244]}}},{"diffOp":{"delete":{"range":[244,252]}}},{"diffOp":{"insert":{"range":[252,260]}}},{"diffOp":{"equal":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[262,277]}}},{"diffOp":{"delete":{"range":[202,213]}}},{"diffOp":{"insert":{"range":[190,202]}}},{"diffOp":{"equal":{"range":[72,73]}}},{"diffOp":{"insert":{"range":[213,226]}}},{"diffOp":{"equal":{"range":[226,244]}}},{"diffOp":{"delete":{"range":[252,260]}}},{"diffOp":{"insert":{"range":[244,252]}}},{"diffOp":{"equal":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[277,330]}}},{"equalLines":{"line_count":588}},{"diffOp":{"equal":{"range":[330,336]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\regression.ts"},"span":[1865,1933],"sourceCode":"/**\n * 受控自进化退步判定与回退编排（S9-07/08/09）。\n *\n * 职责：\n * - `judgeRegression`：把一次新失败按结构化关联判成三种 regression（可复现\n *   原问题回归 / 正常用法破坏 / 用户明确退步），或判为无关失败不乱归因。\n * - `handleRegression`：judge 为真时编排回退——找上一有效版 → `rollbackResource`\n *   事务切回 → 找受影响任务列「待切换」→ 标坏版同 base 的未终态候选 cancelled\n *   → 组通知载荷（资源、原因、当前有效版、受影响任务、待人工核对清单）。\n *\n * 契约（S9 任务书 §5）：\n * - 判定依据是**结构化关联**（调用方给的 problemId/任务绑定/used 行存在性），\n *   不做语义相似度判断，不凭模型偏好回滚；条件不符/无关失败返回\n *   `isRegression=false` 并保留调查说明。\n * - 「上一有效版」口径：坏版 `activation='effective'` 凭据行的 `from_version`\n *   （坏版生效前资源实际指向的版本；baseVersion 快照不走 activation 表，\n *   但生效行的 from_version 照实记了它）。前版自身已被「停用:」标记则沿\n *   该版本 effective 凭据的 from_version 向前追溯到首个未停用版。\n * - 回退执行只走 `rollbackResource` 事务体：当前指向仍是坏版才切回；\n *   指向已非坏版（另一修复已生效）→ `no_change` 不覆盖，通知照发说明现状。\n * - 不碰宿主：任务换版走 `switchTaskResourceAtSafePoint`（宿主在安全点调用）、\n *   通知展示归界面——本模块只出 `affectedTasks` 清单与 `notification` 载荷。\n * - 已发生业务动作不盲目撤销：`needsReviewFiles` 列出受影响绑定任务的\n *   换版历史供人工核对，本批不推断具体业务文件（无来源则空数组）。\n */\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { rollbackResource } from \"./activation.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 退步类别（判定的结构化口径）。 */\nexport const REGRESSION_KINDS = [\n\t/** 可复现原问题回归：已解决原问题在新版本上复现。 */\n\t\"original_problem\",\n\t/** 正常用法破坏：曾过验证/用过的正常用法在新版本上报失败。 */\n\t\"normal_breakage\",\n\t/** 用户明确退步：调用方显式标记 userReported。 */\n\t\"user_reported\",\n] as const;\nexport type RegressionKind = (typeof REGRESSION_KINDS)[number];\n\n/** `judgeRegression` 的输入。 */\nexport interface JudgeRegressionInput {\n\t/** 被怀疑退步的资源 ID。 */\n\tresourceId: string;\n\t/** 报失败的任务 ID（有绑定时用于查 used 行与受影响范围）。 */\n\ttaskId?: string;\n\t/** 会话 ID（审计定位）。 */\n\tsessionId?: string;\n\t/** 失败现象描述（人读，进 reason；不做语义匹配）。 */\n\tfailureDescription: string;\n\t/**\n\t * 失败关联的原问题 ID（调用方给的结构化线索）：\n\t * 该 problem 有候选已发布/生效过当前坏版 → 判 original_problem。\n\t */\n\tproblemId?: string;\n\t/**\n\t * 失败版本 ID（缺省取资源当前 effective_version）：\n\t * 判定与回退都以「当前指向的坏版」为准。\n\t */\n\tversionId?: string;\n\t/**\n\t * 用户明确标记退步（用户控制面直报）；true 时直接判 user_reported，\n\t * 不再查结构化证据。\n\t */\n\tuserReported?: boolean;\n\t/**\n\t * 退步证据来源 ID（写进 rollback 行 source_links_json 与通知）；\n\t * 缺省时用 problemId/taskId 拼最小来源集。\n\t */\n\tsourceIds?: string[];\n\t/** 判定时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `judgeRegression` 的输出。 */\nexport interface RegressionJudgement {\n\t/** 是否构成 regression（三种 kind 任一成立）。 */\n\tisRegression: boolean;\n\t/** 判定时锁定的坏版（= 资源当前 effective_version 或显式 versionId）。 */\n\tbadVersion?: string;\n\t/** 退步类别（isRegression=true 时必给）。 */\n\tkind?: RegressionKind;\n\t/** 判定说明（人读；false 时说明为何不归因，供保留调查）。 */\n\treason: string;\n\t/** 证据来源 ID 集（供 rollback 行与通知）。 */\n\tsourceIds: string[];\n\t/** 关联的原问题 ID（判出 original_problem 时给出）。 */\n\tproblemId?: string;\n}\n\n/** 一个受回退影响的任务绑定（待切换）。 */\nexport interface AffectedTaskBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 该任务当前绑定的坏版。 */\n\tversionId: string;\n\t/** 回退后应切到的版本（= previousVersion）。 */\n\ttargetVersion: string;\n}\n\n/** 回退通知载荷（宿主/界面决定怎么展示；本模块只组数据）。 */\nexport interface RegressionNotification {\n\t/** 退步资源。 */\n\tresourceId: string;\n\t/** 被判停用的坏版。 */\n\tbadVersion: string;\n\t/** 回退原因（判定 reason 透传）。 */\n\treason: string;\n\t/** 回退后当前有效版（rolled_back 时 = previousVersion；no_change 时 = 实际当前值）。 */\n\tcurrentVersion: string;\n\t/** 受影响任务清单（active 且绑坏版；宿主据此在安全点换版）。 */\n\taffectedTaskIds: string[];\n\t/**\n\t * 已发生业务动作待人工核对的文件清单。\n\t * 本批只能给出绑定任务的换版历史（switch_history）作线索，\n\t * 无法推断具体业务文件；没有线索时为空数组，注释如实说明。\n\t */\n\tneedsReviewFiles: string[];\n\t/** 用户是否需复核（needsReviewFiles 非空或 affectedTaskIds 非空时 true）。 */\n\tneedsReview: boolean;\n}\n\n/** `handleRegression` 的输出。 */\nexport interface HandleRegressionResult {\n\t/** 是否执行了回退写（rolled_back=true；no_change/未判定=false）。 */\n\trolledBack: boolean;\n\t/** 判定的坏版。 */\n\tbadVersion?: string;\n\t/** 回退目标版本（上一有效版）。 */\n\tpreviousVersion?: string;\n\t/** 受影响任务清单。 */\n\taffectedTasks: AffectedTaskBinding[];\n\t/** 通知载荷（isRegression=true 时必给，无论 rolledBack 与否）。 */\n\tnotification?: RegressionNotification;\n\t/** 判定（透传 judgeRegression 结果，isRegression=false 时说明保留调查原因）。 */\n\tjudgement: RegressionJudgement;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：行读取与上一有效版口径\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 上一有效版口径：坏版 `activation='effective'` 凭据行的 `from_version`——\n * 它就是坏版生效前资源实际指向的版本（可能是 baseVersion 快照：快照不走\n * activation 表，但生效行的 from_version 照实记了它）。\n *\n * 坏版无 effective 凭据或 from_version 为 NULL → 无上一版可回退。\n * 候选前版自身已被「停用:」标记（也被回退过）→ 继续沿该版本的\n * effective 凭据 from_version 向前追溯，直到找到未停用版本或链断。\n */\nfunction findPreviousEffectiveVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tbadVersion: string,\n): string | undefined {\n\t// 查坏版的 activation='effective' 行（kind='publish'），取 from_version。\n\tconst effectiveRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, to_version, from_version, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND kind = 'publish' AND to_version = ?\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, badVersion) as unknown as Array<ActivationRow & { from_version: string | null }>;\n\tlet fromVersion: string | null = null;\n\tfor (const row of effectiveRows) {\n\t\tif (row.source_links_json === null) continue;\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\n\t\t\tif (links.activation === \"effective\") {\n\t\t\t\tfromVersion = row.from_version;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 非 JSON 行跳过。\n\t\t}\n\t}\n\tif (fromVersion === null) return undefined;\n\n\t// 前版自身若已被「停用:」标记（也被回退过），沿它的 effective 凭据\n\t// from_version 继续向前追溯；链上的停用版跳过。\n\tconst visited = new Set<string>([badVersion]);\n\tlet cursor: string | null = fromVersion;\n\twhile (cursor !== null && !visited.has(cursor)) {\n\t\tvisited.add(cursor);\n\t\tconst disabled = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish' AND reason LIKE '停用:%'`,\n\t\t\t)\n\t\t\t.get(resourceId, cursor) as { n: number };\n\t\tif (disabled.n === 0) return cursor;\n\t\t// 该前版也停用了：沿它的 effective 凭据 from_version 再往前找。\n\t\tconst prevRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT from_version, source_links_json FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'publish' AND to_version = ?\n\t\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t\t)\n\t\t\t.all(resourceId, cursor) as Array<{ from_version: string | null; source_links_json: string | null }>;\n\t\tlet next: string | null = null;\n\t\tfor (const row of prevRows) {\n\t\t\tif (row.source_links_json === null) continue;\n\t\t\ttry {\n\t\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\n\t\t\t\tif (links.activation === \"effective\") {\n\t\t\t\t\tnext = row.from_version;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 非 JSON 行跳过。\n\t\t\t}\n\t\t}\n\t\tcursor = next;\n\t}\n\treturn undefined;\n}\n\ninterface BindingRow {\n\tbinding_id: string;\n\ttask_id: string;\n\tversion_id: string;\n\tswitch_history_json: string | null;\n}\n\n/** 找该资源 active 且绑定指定版本的全部任务绑定（待切换清单）。 */\nfunction findActiveBindingsOnVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): BindingRow[] {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, version_id, switch_history_json\n\t\t\t FROM evolution_task_bindings\n\t\t\t WHERE resource_id = ? AND version_id = ? AND active = 1\n\t\t\t ORDER BY bound_at ASC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as BindingRow[];\n}\n\n/**\n * 标坏版同 base 的未终态候选 cancelled（markStaleCandidates 同口径：\n * proposed/testing → cancelled + failure_reason；passed 终态不动）。\n * 防止「失败候选不被同一后台任务再发布」：坏版的 publish 凭据已被\n * rollbackResource 标「停用:」，这里再把同源未终态候选清掉。\n */\nfunction cancelPendingCandidatesForBadVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tbadVersion: string,\n\treason: string,\n\tnow: string,\n): number {\n\t// 找生产坏版的候选（publish-落盘凭据 source_links_json.candidateId），\n\t// 取其 base_version 作为「同源候选」口径。\n\tconst publishCred = store.db\n\t\t.prepare(\n\t\t\t`SELECT source_links_json FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, badVersion) as Array<{ source_links_json: string | null }>;\n\tlet baseVersion: string | undefined;\n\tfor (const row of publishCred) {\n\t\tif (row.source_links_json === null) continue;\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\tif (links.candidateId !== undefined) {\n\t\t\t\tconst cand = store.db\n\t\t\t\t\t.prepare(`SELECT base_version FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t\t.get(links.candidateId) as { base_version: string } | undefined;\n\t\t\t\tif (cand) {\n\t\t\t\t\tbaseVersion = cand.base_version;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// 非 JSON 行跳过。\n\t\t}\n\t}\n\tif (baseVersion === undefined) return 0;\n\tconst result = store.db\n\t\t.prepare(\n\t\t\t`UPDATE evolution_candidates\n\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\n\t\t\t WHERE resource_id = ? AND base_version = ? AND status IN ('proposed','testing')`,\n\t\t)\n\t\t.run(\n\t\t\t`${reason}（关联版本 ${badVersion} 已停用，同源未终态候选不得直接重新排发布）`,\n\t\t\tnow,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t);\n\treturn Number(result.changes);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. judgeRegression\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 把一次失败按结构化关联判成 regression 或保留调查。\n *\n * 判据（按优先级）：\n * 1. `userReported=true` → kind='user_reported'（用户控制面直报，无需其他证据）。\n * 2. `problemId` 指向的 problem 其候选曾发布且当前坏版就是该候选产出的版本\n *    → kind='original_problem'（可复现原问题回归）。\n * 3. 坏版上有 used 行（说明真实任务用过）且本次报失败的任务有 active 绑定绑坏版\n *    → kind='normal_breakage'（正常用法破坏）。\n * 4. 以上都不满足 → isRegression=false，reason 说明缺的关联，不乱归因。\n *\n * 不做语义相似度：problemId 是调用方给的结构化关联，失败文本只进 reason 不参与判定。\n */\nexport function judgeRegression(\n\tstore: MemoryStore,\n\tinput: JudgeRegressionInput,\n): MemoryResult<RegressionJudgement> {\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tconst badVersion = input.versionId ?? resource.effective_version ?? undefined;\n\tif (badVersion === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tisRegression: false,\n\t\t\treason: `资源 ${input.resourceId} 当前无生效版本，失败无法归因到具体版本`,\n\t\t\tsourceIds: input.sourceIds ?? [],\n\t\t};\n\t}\n\n\tconst sourceIds = input.sourceIds ?? [\n\t\t...(input.problemId === undefined ? [] : [input.problemId]),\n\t\t...(input.taskId === undefined ? [] : [`task:${input.taskId}`]),\n\t];\n\n\t// 1. 用户明确退步（用户控制面直报）。\n\tif (input.userReported === true) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tisRegression: true,\n\t\t\tbadVersion,\n\t\t\tkind: \"user_reported\",\n\t\t\treason: `用户明确报告退步:${input.failureDescription}`,\n\t\t\tsourceIds,\n\t\t\t...(input.problemId === undefined ? {} : { problemId: input.problemId }),\n\t\t};\n\t}\n\n\t// 2. 可复现原问题回归：problemId 的候选发布过当前坏版。\n\tif (input.problemId !== undefined) {\n\t\tconst problem = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT problem_id, status, disposition FROM evolution_problems\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.get(input.problemId) as\n\t\t\t| { problem_id: string; status: string; disposition: string }\n\t\t\t| undefined;\n\t\tif (problem) {\n\t\t\t// 该 problem 的候选是否发布过 badVersion（publish-落盘凭据 source_links.candidateId\n\t\t\t// 指向 evolution_candidates.problem_id === input.problemId）。\n\t\t\tconst publishRows = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT source_links_json FROM evolution_activations\n\t\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'`,\n\t\t\t\t)\n\t\t\t\t.all(input.resourceId, badVersion) as Array<{ source_links_json: string | null }>;\n\t\t\tfor (const row of publishRows) {\n\t\t\t\tif (row.source_links_json === null) continue;\n\t\t\t\ttry {\n\t\t\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\t\t\tif (links.candidateId === undefined) continue;\n\t\t\t\t\tconst cand = store.db\n\t\t\t\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t\t\t.get(links.candidateId) as { problem_id: string } | undefined;\n\t\t\t\t\tif (cand?.problem_id === input.problemId) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tok: true,\n\t\t\t\t\t\t\tisRegression: true,\n\t\t\t\t\t\t\tbadVersion,\n\t\t\t\t\t\t\tkind: \"original_problem\",\n\t\t\t\t\t\t\treason:\n\t\t\t\t\t\t\t\t`可复现原问题回归:${input.failureDescription}` +\n\t\t\t\t\t\t\t\t`（问题 ${input.problemId} 的候选发布过版本 ${badVersion}，新失败与之关联）`,\n\t\t\t\t\t\t\tsourceIds,\n\t\t\t\t\t\t\tproblemId: input.problemId,\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行跳过。\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// 3. 正常用法破坏：坏版有 used 行 + 报失败任务有 active 绑定绑坏版。\n\tif (input.taskId !== undefined) {\n\t\tconst binding = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, version_id, active FROM evolution_task_bindings\n\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.taskId, input.resourceId) as\n\t\t\t| { binding_id: string; version_id: string; active: number }\n\t\t\t| undefined;\n\t\tif (binding && binding.active === 1 && binding.version_id === badVersion) {\n\t\t\tconst usedCount = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_observations\n\t\t\t\t\t WHERE resource_id = ? AND version_id = ? AND action = 'used'`,\n\t\t\t\t)\n\t\t\t\t.get(input.resourceId, badVersion) as { n: number };\n\t\t\tif (usedCount.n > 0) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tisRegression: true,\n\t\t\t\t\tbadVersion,\n\t\t\t\t\tkind: \"normal_breakage\",\n\t\t\t\t\treason:\n\t\t\t\t\t\t`正常用法破坏:${input.failureDescription}` +\n\t\t\t\t\t\t`（任务 ${input.taskId} 绑定版本 ${badVersion}，该版本有 ${usedCount.n} 条 used 行，失败可归因该版本）`,\n\t\t\t\t\tsourceIds,\n\t\t\t\t};\n\t\t\t}\n\t\t}\n\t}\n\n\t// 4. 无关失败：结构化关联不成立，保留调查不乱归因。\n\tconst why: string[] = [];\n\tif (input.problemId === undefined) why.push(\"未给 problemId\");\n\tif (input.taskId === undefined) why.push(\"未给 taskId\");\n\treturn {\n\t\tok: true,\n\t\tisRegression: false,\n\t\tbadVersion,\n\t\treason:\n\t\t\t`不满足 regression 判定口径（${why.length > 0 ? why.join(\"、\") : \"结构化关联不成立\"}），` +\n\t\t\t`失败「${input.failureDescription}」保留调查，不归因到版本 ${badVersion}`,\n\t\tsourceIds,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. handleRegression\n// ════════════════════════════════════════════════════════════════════════\n\n/** `handleRegression` 的输入（比 judge 多执行参数）。 */\nexport interface HandleRegressionInput extends JudgeRegressionInput {\n\t/** PAO_HOME 根（找版本目录与核对需要；本批通知载荷不读盘，留给宿主用）。 */\n\tpaoHome: string;\n\t/** 显式指定回退目标（缺省时自动找上一有效版）。 */\n\tpreviousVersion?: string;\n\t/** 回退执行时间（夹具注入；缺省取当前）。 */\n\trollbackAt?: string;\n}\n\n/**\n * 判定为 regression 后执行回退编排。\n *\n * 流程：\n * 1. `judgeRegression` 判定；false → 直接返回（rolledBack=false，带 reason）。\n * 2. 找上一有效版（findPreviousEffectiveVersion）；无 → 返回不回退（通知说明）。\n * 3. `rollbackResource` 事务：指向仍是坏版 → rolled_back；已非坏版 → no_change。\n * 4. 找受影响任务（active 绑定绑坏版）→ 列待切换清单（宿主走安全点换版）。\n * 5. 标坏版同 base 的未终态候选 cancelled（防止失败候选被同后台任务再发布）。\n * 6. 组通知载荷：资源、原因、当前有效版、受影响任务、needsReviewFiles（绑定\n *    换版历史里的 from/to 文件路径线索；本批不能推断业务文件则空数组）。\n */\nexport function handleRegression(\n\tstore: MemoryStore,\n\tinput: HandleRegressionInput,\n): MemoryResult<HandleRegressionResult> {\n\tconst now = input.rollbackAt ?? input.createdAt ?? new Date().toISOString();\n\n\tconst judged = judgeRegression(store, input);\n\tif (!judged.ok) return judged;\n\tif (!judged.isRegression || judged.badVersion === undefined || judged.kind === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\trolledBack: false,\n\t\t\taffectedTasks: [],\n\t\t\tjudgement: judged,\n\t\t};\n\t}\n\tconst badVersion = judged.badVersion;\n\n\t// 找上一有效版。\n\tconst previousVersion =\n\t\tinput.previousVersion ?? findPreviousEffectiveVersion(store, input.resourceId, badVersion);\n\tif (previousVersion === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\trolledBack: false,\n\t\t\tbadVersion,\n\t\t\taffectedTasks: [],\n\t\t\tjudgement: judged,\n\t\t\tnotification: {\n\t\t\t\tresourceId: input.resourceId,\n\t\t\t\tbadVersion,\n\t\t\t\treason: `${judged.reason}；但找不到上一有效版可回退（全部历史版均被停用或无 effective 凭据）`,\n\t\t\t\tcurrentVersion: badVersion,\n\t\t\t\taffectedTaskIds: [],\n\t\t\t\tneedsReviewFiles: [],\n\t\t\t\tneedsReview: true,\n\t\t\t},\n\t\t};\n\t}\n\n\t// 事务回退（rollbackResource 内已含指向核对与「停用:」标记）。\n\tconst rb = rollbackResource(store, {\n\t\tresourceId: input.resourceId,\n\t\tbadVersion,\n\t\tpreviousVersion,\n\t\tsourceIds: judged.sourceIds,\n\t\treason: judged.reason,\n\t\tcreatedAt: now,\n\t});\n\tif (!rb.ok) return rb;\n\n\tconst rolledBack = rb.status === \"rolled_back\";\n\tconst currentVersion = rolledBack\n\t\t? previousVersion\n\t\t: (rb.status === \"no_change\" ? rb.currentEffectiveVersion : undefined) ?? badVersion;\n\n\t// 受影响任务（绑定坏版的 active 绑定）→ 列待切换；宿主决定何时安全点换版。\n\tconst bindings = findActiveBindingsOnVersion(store, input.resourceId, badVersion);\n\tconst affectedTasks: AffectedTaskBinding[] = bindings.map((b) => ({\n\t\tbindingId: b.binding_id,\n\t\ttaskId: b.task_id,\n\t\tversionId: b.version_id,\n\t\ttargetVersion: previousVersion,\n\t}));\n\n\t// 标坏版同 base 的未终态候选 cancelled（在回退成功后做；no_change 时也做，\n\t// 因为坏版确实被判退步，同源未终态候选不应被再发布）。\n\tlet cancelledCount = 0;\n\tif (rolledBack || rb.status === \"no_change\") {\n\t\tcancelledCount = cancelPendingCandidatesForBadVersion(\n\t\t\tstore,\n\t\t\tinput.resourceId,\n\t\t\tbadVersion,\n\t\t\tjudged.reason,\n\t\t\tnow,\n\t\t);\n\t}\n\n\t// needsReviewFiles：列绑定任务的换版历史 from/to 路径线索。\n\t// 本批只能给出「哪些任务在坏版上有过换版动作」供人工核对其业务文件，\n\t// 不推断具体文件；无线索时为空数组。\n\tconst needsReviewFiles: string[] = [];\n\tfor (const b of bindings) {\n\t\tif (b.switch_history_json === null) continue;\n\t\ttry {\n\t\t\tconst history = JSON.parse(b.switch_history_json) as Array<{ from?: string; to?: string }>;\n\t\t\tfor (const h of history) {\n\t\t\t\tif (h.from === badVersion || h.to === badVersion) {\n\t\t\t\t\tneedsReviewFiles.push(`task:${b.task_id}:switch:${h.from ?? \"?\"}->${h.to ?? \"?\"}`);\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// 历史行损坏跳过。\n\t\t}\n\t}\n\n\treturn {\n\t\tok: true,\n\t\trolledBack,\n\t\tbadVersion,\n\t\tpreviousVersion,\n\t\taffectedTasks,\n\t\tjudgement: judged,\n\t\tnotification: {\n\t\t\tresourceId: input.resourceId,\n\t\t\tbadVersion,\n\t\t\treason:\n\t\t\t\tjudged.reason +\n\t\t\t\t(rb.status === \"no_change\"\n\t\t\t\t\t? `；当前指向已变为 ${currentVersion}（另一修复已生效），未覆盖回退`\n\t\t\t\t\t: \"\") +\n\t\t\t\t(cancelledCount > 0 ? `；同源未终态候选 ${cancelledCount} 个已标待重评估` : \"\"),\n\t\t\tcurrentVersion,\n\t\t\taffectedTaskIds: affectedTasks.map((t) => t.taskId),\n\t\t\tneedsReviewFiles,\n\t\t\tneedsReview: needsReviewFiles.length > 0 || affectedTasks.length > 0,\n\t\t},\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化退步判定与回退编排（S9-07/08/09）。\n * * effective 凭据 from_version 向前追溯，直到找到未停用版本或链断。\n */\nfunction findPreviousEffectiveVersion(\n\tstore: MemoryStore,resourceId: string,badVersion: string,\n): string | undefined {\n\t// 查坏版的 activation='effective' 行（kind='publish'），取 from_version。\n\tconst effectiveRows = store.db\n/** 找该资源 active 且绑定指定版本的全部任务绑定（待切换清单）。 */\nfunction findActiveBindingsOnVersion(versionId: string): BindingRow[] {\n\treturn store.db\n\t\t.prepare( * 不做语义相似度：problemId 是调用方给的结构化关联，失败文本只进 reason 不参与判定。\n */\nexport function judgeRegression(input: JudgeRegressionInput): MemoryResult<RegressionJudgement> {\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.get(input.problemId) as\n\t\t\t| { problem_id: string; status: string; disposition: string }| undefined;\n\t\tif (problem) {\n\t\t\t// 该 problem 的候选是否发布过 badVersion（publish-落盘凭据 source_links.candidateId\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.taskId, input.resourceId) as { binding_id: string; version_id: string; active: number }| undefined;\n\t\tif (binding && binding.active === 1 && binding.version_id === badVersion) {\n\t\t\tconst usedCount = store.db\n\t// 找上一有效版。\n\tconst previousVersion =input.previousVersion ?? findPreviousEffectiveVersion(store, input.resourceId, badVersion);\n\tif (previousVersion === undefined) {\n\t\treturn {\tconst currentVersion = rolledBack\n\t\t? previousVersion\n\t\t: ((rb.status === \"no_change\" ? rb.currentEffectiveVersion : undefined) ?? badVersion;\n\n\t// 受影响任务（绑定坏版的 active 绑定）→ 列待切换；宿主决定何时安全点换版。\tlet cancelledCount = 0;\n\tif (rolledBack || rb.status === \"no_change\") {\n\t\tcancelledCount = cancelPendingCandidatesForBadVersion(store,input.resourceId,badVersion,judged.reason,now,\n\t\t);\n\t}\n\t\t\treason:\n\t\t\t\tjudged.reason +\n\t\t\t\t(rb.status === \"no_change\"\n\t\t\t\t\t? `；当前指向已变为 ${currentVersion}（另一修复已生效），未覆盖回退`: \"\") +\n\t\t\t\t(cancelledCount > 0 ? `；同源未终态候选 ${cancelledCount} 个已标待重评估` : \"\"),\n\t\t\tcurrentVersion,\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,72]}}},{"equalLines":{"line_count":175}},{"diffOp":{"equal":{"range":[72,202]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"equal":{"range":[204,223]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"insert":{"range":[72,73]}}},{"diffOp":{"equal":{"range":[223,242]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"insert":{"range":[72,73]}}},{"diffOp":{"equal":{"range":[242,260]}}},{"diffOp":{"delete":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[262,403]}}},{"equalLines":{"line_count":67}},{"diffOp":{"equal":{"range":[403,535]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"equal":{"range":[204,223]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"insert":{"range":[72,73]}}},{"diffOp":{"equal":{"range":[223,242]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"insert":{"range":[72,73]}}},{"diffOp":{"equal":{"range":[535,552]}}},{"diffOp":{"delete":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[552,598]}}},{"equalLines":{"line_count":79}},{"diffOp":{"equal":{"range":[598,752]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"equal":{"range":[204,223]}}},{"diffOp":{"delete":{"range":[202,204]}}},{"diffOp":{"insert":{"range":[598,599]}}},{"diffOp":{"equal":{"range":[752,779]}}},{"diffOp":{"delete":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[779,894]}}},{"equalLines":{"line_count":35}},{"diffOp":{"equal":{"range":[894,954]}}},{"diffOp":{"delete":{"range":[954,959]}}},{"diffOp":{"equal":{"range":[959,1019]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[1019,1150]}}},{"equalLines":{"line_count":40}},{"diffOp":{"equal":{"range":[1150,1242]}}},{"diffOp":{"delete":{"range":[954,959]}}},{"diffOp":{"equal":{"range":[1242,1301]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[1301,1421]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[1421,1472]}}},{"diffOp":{"delete":{"range":[954,957]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[1472,1612]}}},{"equalLines":{"line_count":29}},{"diffOp":{"equal":{"range":[1612,1672]}}},{"diffOp":{"insert":{"range":[1672,1673]}}},{"diffOp":{"equal":{"range":[1673,1754]}}},{"diffOp":{"insert":{"range":[262,263]}}},{"diffOp":{"equal":{"range":[1754,1866]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[1866,1995]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"equal":{"range":[1995,2001]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2001,2018]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2018,2029]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2029,2043]}}},{"diffOp":{"delete":{"range":[954,958]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2043,2046]}}},{"diffOp":{"delete":{"range":[2046,2050]}}},{"diffOp":{"equal":{"range":[2050,2056]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[2056,2117]}}},{"diffOp":{"delete":{"range":[2117,2123]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2123,2214]}}},{"diffOp":{"delete":{"range":[2117,2123]}}},{"diffOp":{"insert":{"range":[959,960]}}},{"diffOp":{"equal":{"range":[2214,2340]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[2340,2346]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\regression.ts"},"span":null,"sourceCode":"/**\n * 受控自进化退步判定与回退编排（S9-07/08/09）。\n *\n * 职责：\n * - `judgeRegression`：把一次新失败按结构化关联判成三种 regression（可复现\n *   原问题回归 / 正常用法破坏 / 用户明确退步），或判为无关失败不乱归因。\n * - `handleRegression`：judge 为真时编排回退——找上一有效版 → `rollbackResource`\n *   事务切回 → 找受影响任务列「待切换」→ 标坏版同 base 的未终态候选 cancelled\n *   → 组通知载荷（资源、原因、当前有效版、受影响任务、待人工核对清单）。\n *\n * 契约（S9 任务书 §5）：\n * - 判定依据是**结构化关联**（调用方给的 problemId/任务绑定/used 行存在性），\n *   不做语义相似度判断，不凭模型偏好回滚；条件不符/无关失败返回\n *   `isRegression=false` 并保留调查说明。\n * - 「上一有效版」口径：坏版 `activation='effective'` 凭据行的 `from_version`\n *   （坏版生效前资源实际指向的版本；baseVersion 快照不走 activation 表，\n *   但生效行的 from_version 照实记了它）。前版自身已被「停用:」标记则沿\n *   该版本 effective 凭据的 from_version 向前追溯到首个未停用版。\n * - 回退执行只走 `rollbackResource` 事务体：当前指向仍是坏版才切回；\n *   指向已非坏版（另一修复已生效）→ `no_change` 不覆盖，通知照发说明现状。\n * - 不碰宿主：任务换版走 `switchTaskResourceAtSafePoint`（宿主在安全点调用）、\n *   通知展示归界面——本模块只出 `affectedTasks` 清单与 `notification` 载荷。\n * - 已发生业务动作不盲目撤销：`needsReviewFiles` 列出受影响绑定任务的\n *   换版历史供人工核对，本批不推断具体业务文件（无来源则空数组）。\n */\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { rollbackResource } from \"./activation.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 退步类别（判定的结构化口径）。 */\nexport const REGRESSION_KINDS = [\n\t/** 可复现原问题回归：已解决原问题在新版本上复现。 */\n\t\"original_problem\",\n\t/** 正常用法破坏：曾过验证/用过的正常用法在新版本上报失败。 */\n\t\"normal_breakage\",\n\t/** 用户明确退步：调用方显式标记 userReported。 */\n\t\"user_reported\",\n] as const;\nexport type RegressionKind = (typeof REGRESSION_KINDS)[number];\n\n/** `judgeRegression` 的输入。 */\nexport interface JudgeRegressionInput {\n\t/** 被怀疑退步的资源 ID。 */\n\tresourceId: string;\n\t/** 报失败的任务 ID（有绑定时用于查 used 行与受影响范围）。 */\n\ttaskId?: string;\n\t/** 会话 ID（审计定位）。 */\n\tsessionId?: string;\n\t/** 失败现象描述（人读，进 reason；不做语义匹配）。 */\n\tfailureDescription: string;\n\t/**\n\t * 失败关联的原问题 ID（调用方给的结构化线索）：\n\t * 该 problem 有候选已发布/生效过当前坏版 → 判 original_problem。\n\t */\n\tproblemId?: string;\n\t/**\n\t * 失败版本 ID（缺省取资源当前 effective_version）：\n\t * 判定与回退都以「当前指向的坏版」为准。\n\t */\n\tversionId?: string;\n\t/**\n\t * 用户明确标记退步（用户控制面直报）；true 时直接判 user_reported，\n\t * 不再查结构化证据。\n\t */\n\tuserReported?: boolean;\n\t/**\n\t * 退步证据来源 ID（写进 rollback 行 source_links_json 与通知）；\n\t * 缺省时用 problemId/taskId 拼最小来源集。\n\t */\n\tsourceIds?: string[];\n\t/** 判定时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `judgeRegression` 的输出。 */\nexport interface RegressionJudgement {\n\t/** 是否构成 regression（三种 kind 任一成立）。 */\n\tisRegression: boolean;\n\t/** 判定时锁定的坏版（= 资源当前 effective_version 或显式 versionId）。 */\n\tbadVersion?: string;\n\t/** 退步类别（isRegression=true 时必给）。 */\n\tkind?: RegressionKind;\n\t/** 判定说明（人读；false 时说明为何不归因，供保留调查）。 */\n\treason: string;\n\t/** 证据来源 ID 集（供 rollback 行与通知）。 */\n\tsourceIds: string[];\n\t/** 关联的原问题 ID（判出 original_problem 时给出）。 */\n\tproblemId?: string;\n}\n\n/** 一个受回退影响的任务绑定（待切换）。 */\nexport interface AffectedTaskBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 该任务当前绑定的坏版。 */\n\tversionId: string;\n\t/** 回退后应切到的版本（= previousVersion）。 */\n\ttargetVersion: string;\n}\n\n/** 回退通知载荷（宿主/界面决定怎么展示；本模块只组数据）。 */\nexport interface RegressionNotification {\n\t/** 退步资源。 */\n\tresourceId: string;\n\t/** 被判停用的坏版。 */\n\tbadVersion: string;\n\t/** 回退原因（判定 reason 透传）。 */\n\treason: string;\n\t/** 回退后当前有效版（rolled_back 时 = previousVersion；no_change 时 = 实际当前值）。 */\n\tcurrentVersion: string;\n\t/** 受影响任务清单（active 且绑坏版；宿主据此在安全点换版）。 */\n\taffectedTaskIds: string[];\n\t/**\n\t * 已发生业务动作待人工核对的文件清单。\n\t * 本批只能给出绑定任务的换版历史（switch_history）作线索，\n\t * 无法推断具体业务文件；没有线索时为空数组，注释如实说明。\n\t */\n\tneedsReviewFiles: string[];\n\t/** 用户是否需复核（needsReviewFiles 非空或 affectedTaskIds 非空时 true）。 */\n\tneedsReview: boolean;\n}\n\n/** `handleRegression` 的输出。 */\nexport interface HandleRegressionResult {\n\t/** 是否执行了回退写（rolled_back=true；no_change/未判定=false）。 */\n\trolledBack: boolean;\n\t/** 判定的坏版。 */\n\tbadVersion?: string;\n\t/** 回退目标版本（上一有效版）。 */\n\tpreviousVersion?: string;\n\t/** 受影响任务清单。 */\n\taffectedTasks: AffectedTaskBinding[];\n\t/** 通知载荷（isRegression=true 时必给，无论 rolledBack 与否）。 */\n\tnotification?: RegressionNotification;\n\t/** 判定（透传 judgeRegression 结果，isRegression=false 时说明保留调查原因）。 */\n\tjudgement: RegressionJudgement;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：行读取与上一有效版口径\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 上一有效版口径：坏版 `activation='effective'` 凭据行的 `from_version`——\n * 它就是坏版生效前资源实际指向的版本（可能是 baseVersion 快照：快照不走\n * activation 表，但生效行的 from_version 照实记了它）。\n *\n * 坏版无 effective 凭据或 from_version 为 NULL → 无上一版可回退。\n * 候选前版自身已被「停用:」标记（也被回退过）→ 继续沿该版本的\n * effective 凭据 from_version 向前追溯，直到找到未停用版本或链断。\n */\nfunction findPreviousEffectiveVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tbadVersion: string,\n): string | undefined {\n\t// 查坏版的 activation='effective' 行（kind='publish'），取 from_version。\n\tconst effectiveRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, to_version, from_version, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND kind = 'publish' AND to_version = ?\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, badVersion) as unknown as Array<ActivationRow & { from_version: string | null }>;\n\tlet fromVersion: string | null = null;\n\tfor (const row of effectiveRows) {\n\t\tif (row.source_links_json === null) continue;\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\n\t\t\tif (links.activation === \"effective\") {\n\t\t\t\tfromVersion = row.from_version;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 非 JSON 行跳过。\n\t\t}\n\t}\n\tif (fromVersion === null) return undefined;\n\n\t// 前版自身若已被「停用:」标记（也被回退过），沿它的 effective 凭据\n\t// from_version 继续向前追溯；链上的停用版跳过。\n\tconst visited = new Set<string>([badVersion]);\n\tlet cursor: string | null = fromVersion;\n\twhile (cursor !== null && !visited.has(cursor)) {\n\t\tvisited.add(cursor);\n\t\tconst disabled = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish' AND reason LIKE '停用:%'`,\n\t\t\t)\n\t\t\t.get(resourceId, cursor) as { n: number };\n\t\tif (disabled.n === 0) return cursor;\n\t\t// 该前版也停用了：沿它的 effective 凭据 from_version 再往前找。\n\t\tconst prevRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT from_version, source_links_json FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'publish' AND to_version = ?\n\t\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t\t)\n\t\t\t.all(resourceId, cursor) as Array<{ from_version: string | null; source_links_json: string | null }>;\n\t\tlet next: string | null = null;\n\t\tfor (const row of prevRows) {\n\t\t\tif (row.source_links_json === null) continue;\n\t\t\ttry {\n\t\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\n\t\t\t\tif (links.activation === \"effective\") {\n\t\t\t\t\tnext = row.from_version;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 非 JSON 行跳过。\n\t\t\t}\n\t\t}\n\t\tcursor = next;\n\t}\n\treturn undefined;\n}\n\ninterface BindingRow {\n\tbinding_id: string;\n\ttask_id: string;\n\tversion_id: string;\n\tswitch_history_json: string | null;\n}\n\n/** 找该资源 active 且绑定指定版本的全部任务绑定（待切换清单）。 */\nfunction findActiveBindingsOnVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): BindingRow[] {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, version_id, switch_history_json\n\t\t\t FROM evolution_task_bindings\n\t\t\t WHERE resource_id = ? AND version_id = ? AND active = 1\n\t\t\t ORDER BY bound_at ASC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as BindingRow[];\n}\n\n/**\n * 标坏版同 base 的未终态候选 cancelled（markStaleCandidates 同口径：\n * proposed/testing → cancelled + failure_reason；passed 终态不动）。\n * 防止「失败候选不被同一后台任务再发布」：坏版的 publish 凭据已被\n * rollbackResource 标「停用:」，这里再把同源未终态候选清掉。\n */\nfunction cancelPendingCandidatesForBadVersion(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tbadVersion: string,\n\treason: string,\n\tnow: string,\n): number {\n\t// 找生产坏版的候选（publish-落盘凭据 source_links_json.candidateId），\n\t// 取其 base_version 作为「同源候选」口径。\n\tconst publishCred = store.db\n\t\t.prepare(\n\t\t\t`SELECT source_links_json FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, badVersion) as Array<{ source_links_json: string | null }>;\n\tlet baseVersion: string | undefined;\n\tfor (const row of publishCred) {\n\t\tif (row.source_links_json === null) continue;\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\tif (links.candidateId !== undefined) {\n\t\t\t\tconst cand = store.db\n\t\t\t\t\t.prepare(`SELECT base_version FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t\t.get(links.candidateId) as { base_version: string } | undefined;\n\t\t\t\tif (cand) {\n\t\t\t\t\tbaseVersion = cand.base_version;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// 非 JSON 行跳过。\n\t\t}\n\t}\n\tif (baseVersion === undefined) return 0;\n\tconst result = store.db\n\t\t.prepare(\n\t\t\t`UPDATE evolution_candidates\n\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\n\t\t\t WHERE resource_id = ? AND base_version = ? AND status IN ('proposed','testing')`,\n\t\t)\n\t\t.run(\n\t\t\t`${reason}（关联版本 ${badVersion} 已停用，同源未终态候选不得直接重新排发布）`,\n\t\t\tnow,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t);\n\treturn Number(result.changes);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. judgeRegression\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 把一次失败按结构化关联判成 regression 或保留调查。\n *\n * 判据（按优先级）：\n * 1. `userReported=true` → kind='user_reported'（用户控制面直报，无需其他证据）。\n * 2. `problemId` 指向的 problem 其候选曾发布且当前坏版就是该候选产出的版本\n *    → kind='original_problem'（可复现原问题回归）。\n * 3. 坏版上有 used 行（说明真实任务用过）且本次报失败的任务有 active 绑定绑坏版\n *    → kind='normal_breakage'（正常用法破坏）。\n * 4. 以上都不满足 → isRegression=false，reason 说明缺的关联，不乱归因。\n *\n * 不做语义相似度：problemId 是调用方给的结构化关联，失败文本只进 reason 不参与判定。\n */\nexport function judgeRegression(\n\tstore: MemoryStore,\n\tinput: JudgeRegressionInput,\n): MemoryResult<RegressionJudgement> {\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tconst badVersion = input.versionId ?? resource.effective_version ?? undefined;\n\tif (badVersion === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tisRegression: false,\n\t\t\treason: `资源 ${input.resourceId} 当前无生效版本，失败无法归因到具体版本`,\n\t\t\tsourceIds: input.sourceIds ?? [],\n\t\t};\n\t}\n\n\tconst sourceIds = input.sourceIds ?? [\n\t\t...(input.problemId === undefined ? [] : [input.problemId]),\n\t\t...(input.taskId === undefined ? [] : [`task:${input.taskId}`]),\n\t];\n\n\t// 1. 用户明确退步（用户控制面直报）。\n\tif (input.userReported === true) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tisRegression: true,\n\t\t\tbadVersion,\n\t\t\tkind: \"user_reported\",\n\t\t\treason: `用户明确报告退步:${input.failureDescription}`,\n\t\t\tsourceIds,\n\t\t\t...(input.problemId === undefined ? {} : { problemId: input.problemId }),\n\t\t};\n\t}\n\n\t// 2. 可复现原问题回归：problemId 的候选发布过当前坏版。\n\tif (input.problemId !== undefined) {\n\t\tconst problem = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT problem_id, status, disposition FROM evolution_problems\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.get(input.problemId) as\n\t\t\t| { problem_id: string; status: string; disposition: string }\n\t\t\t| undefined;\n\t\tif (problem) {\n\t\t\t// 该 problem 的候选是否发布过 badVersion（publish-落盘凭据 source_links.candidateId\n\t\t\t// 指向 evolution_candidates.problem_id === input.problemId）。\n\t\t\tconst publishRows = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT source_links_json FROM evolution_activations\n\t\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'`,\n\t\t\t\t)\n\t\t\t\t.all(input.resourceId, badVersion) as Array<{ source_links_json: string | null }>;\n\t\t\tfor (const row of publishRows) {\n\t\t\t\tif (row.source_links_json === null) continue;\n\t\t\t\ttry {\n\t\t\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\t\t\tif (links.candidateId === undefined) continue;\n\t\t\t\t\tconst cand = store.db\n\t\t\t\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t\t\t.get(links.candidateId) as { problem_id: string } | undefined;\n\t\t\t\t\tif (cand?.problem_id === input.problemId) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tok: true,\n\t\t\t\t\t\t\tisRegression: true,\n\t\t\t\t\t\t\tbadVersion,\n\t\t\t\t\t\t\tkind: \"original_problem\",\n\t\t\t\t\t\t\treason:\n\t\t\t\t\t\t\t\t`可复现原问题回归:${input.failureDescription}` +\n\t\t\t\t\t\t\t\t`（问题 ${input.problemId} 的候选发布过版本 ${badVersion}，新失败与之关联）`,\n\t\t\t\t\t\t\tsourceIds,\n\t\t\t\t\t\t\tproblemId: input.problemId,\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行跳过。\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\t// 3. 正常用法破坏：坏版有 used 行 + 报失败任务有 active 绑定绑坏版。\n\tif (input.taskId !== undefined) {\n\t\tconst binding = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, version_id, active FROM evolution_task_bindings\n\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.taskId, input.resourceId) as\n\t\t\t| { binding_id: string; version_id: string; active: number }\n\t\t\t| undefined;\n\t\tif (binding && binding.active === 1 && binding.version_id === badVersion) {\n\t\t\tconst usedCount = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_observations\n\t\t\t\t\t WHERE resource_id = ? AND version_id = ? AND action = 'used'`,\n\t\t\t\t)\n\t\t\t\t.get(input.resourceId, badVersion) as { n: number };\n\t\t\tif (usedCount.n > 0) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tisRegression: true,\n\t\t\t\t\tbadVersion,\n\t\t\t\t\tkind: \"normal_breakage\",\n\t\t\t\t\treason:\n\t\t\t\t\t\t`正常用法破坏:${input.failureDescription}` +\n\t\t\t\t\t\t`（任务 ${input.taskId} 绑定版本 ${badVersion}，该版本有 ${usedCount.n} 条 used 行，失败可归因该版本）`,\n\t\t\t\t\tsourceIds,\n\t\t\t\t};\n\t\t\t}\n\t\t}\n\t}\n\n\t// 4. 无关失败：结构化关联不成立，保留调查不乱归因。\n\tconst why: string[] = [];\n\tif (input.problemId === undefined) why.push(\"未给 problemId\");\n\tif (input.taskId === undefined) why.push(\"未给 taskId\");\n\treturn {\n\t\tok: true,\n\t\tisRegression: false,\n\t\tbadVersion,\n\t\treason:\n\t\t\t`不满足 regression 判定口径（${why.length > 0 ? why.join(\"、\") : \"结构化关联不成立\"}），` +\n\t\t\t`失败「${input.failureDescription}」保留调查，不归因到版本 ${badVersion}`,\n\t\tsourceIds,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. handleRegression\n// ════════════════════════════════════════════════════════════════════════\n\n/** `handleRegression` 的输入（比 judge 多执行参数）。 */\nexport interface HandleRegressionInput extends JudgeRegressionInput {\n\t/** PAO_HOME 根（找版本目录与核对需要；本批通知载荷不读盘，留给宿主用）。 */\n\tpaoHome: string;\n\t/** 显式指定回退目标（缺省时自动找上一有效版）。 */\n\tpreviousVersion?: string;\n\t/** 回退执行时间（夹具注入；缺省取当前）。 */\n\trollbackAt?: string;\n}\n\n/**\n * 判定为 regression 后执行回退编排。\n *\n * 流程：\n * 1. `judgeRegression` 判定；false → 直接返回（rolledBack=false，带 reason）。\n * 2. 找上一有效版（findPreviousEffectiveVersion）；无 → 返回不回退（通知说明）。\n * 3. `rollbackResource` 事务：指向仍是坏版 → rolled_back；已非坏版 → no_change。\n * 4. 找受影响任务（active 绑定绑坏版）→ 列待切换清单（宿主走安全点换版）。\n * 5. 标坏版同 base 的未终态候选 cancelled（防止失败候选被同后台任务再发布）。\n * 6. 组通知载荷：资源、原因、当前有效版、受影响任务、needsReviewFiles（绑定\n *    换版历史里的 from/to 文件路径线索；本批不能推断业务文件则空数组）。\n */\nexport function handleRegression(\n\tstore: MemoryStore,\n\tinput: HandleRegressionInput,\n): MemoryResult<HandleRegressionResult> {\n\tconst now = input.rollbackAt ?? input.createdAt ?? new Date().toISOString();\n\n\tconst judged = judgeRegression(store, input);\n\tif (!judged.ok) return judged;\n\tif (!judged.isRegression || judged.badVersion === undefined || judged.kind === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\trolledBack: false,\n\t\t\taffectedTasks: [],\n\t\t\tjudgement: judged,\n\t\t};\n\t}\n\tconst badVersion = judged.badVersion;\n\n\t// 找上一有效版。\n\tconst previousVersion =\n\t\tinput.previousVersion ?? findPreviousEffectiveVersion(store, input.resourceId, badVersion);\n\tif (previousVersion === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\trolledBack: false,\n\t\t\tbadVersion,\n\t\t\taffectedTasks: [],\n\t\t\tjudgement: judged,\n\t\t\tnotification: {\n\t\t\t\tresourceId: input.resourceId,\n\t\t\t\tbadVersion,\n\t\t\t\treason: `${judged.reason}；但找不到上一有效版可回退（全部历史版均被停用或无 effective 凭据）`,\n\t\t\t\tcurrentVersion: badVersion,\n\t\t\t\taffectedTaskIds: [],\n\t\t\t\tneedsReviewFiles: [],\n\t\t\t\tneedsReview: true,\n\t\t\t},\n\t\t};\n\t}\n\n\t// 事务回退（rollbackResource 内已含指向核对与「停用:」标记）。\n\tconst rb = rollbackResource(store, {\n\t\tresourceId: input.resourceId,\n\t\tbadVersion,\n\t\tpreviousVersion,\n\t\tsourceIds: judged.sourceIds,\n\t\treason: judged.reason,\n\t\tcreatedAt: now,\n\t});\n\tif (!rb.ok) return rb;\n\n\tconst rolledBack = rb.status === \"rolled_back\";\n\tconst currentVersion = rolledBack\n\t\t? previousVersion\n\t\t: (rb.status === \"no_change\" ? rb.currentEffectiveVersion : undefined) ?? badVersion;\n\n\t// 受影响任务（绑定坏版的 active 绑定）→ 列待切换；宿主决定何时安全点换版。\n\tconst bindings = findActiveBindingsOnVersion(store, input.resourceId, badVersion);\n\tconst affectedTasks: AffectedTaskBinding[] = bindings.map((b) => ({\n\t\tbindingId: b.binding_id,\n\t\ttaskId: b.task_id,\n\t\tversionId: b.version_id,\n\t\ttargetVersion: previousVersion,\n\t}));\n\n\t// 标坏版同 base 的未终态候选 cancelled（在回退成功后做；no_change 时也做，\n\t// 因为坏版确实被判退步，同源未终态候选不应被再发布）。\n\tlet cancelledCount = 0;\n\tif (rolledBack || rb.status === \"no_change\") {\n\t\tcancelledCount = cancelPendingCandidatesForBadVersion(\n\t\t\tstore,\n\t\t\tinput.resourceId,\n\t\t\tbadVersion,\n\t\t\tjudged.reason,\n\t\t\tnow,\n\t\t);\n\t}\n\n\t// needsReviewFiles：列绑定任务的换版历史 from/to 路径线索。\n\t// 本批只能给出「哪些任务在坏版上有过换版动作」供人工核对其业务文件，\n\t// 不推断具体文件；无线索时为空数组。\n\tconst needsReviewFiles: string[] = [];\n\tfor (const b of bindings) {\n\t\tif (b.switch_history_json === null) continue;\n\t\ttry {\n\t\t\tconst history = JSON.parse(b.switch_history_json) as Array<{ from?: string; to?: string }>;\n\t\t\tfor (const h of history) {\n\t\t\t\tif (h.from === badVersion || h.to === badVersion) {\n\t\t\t\t\tneedsReviewFiles.push(`task:${b.task_id}:switch:${h.from ?? \"?\"}->${h.to ?? \"?\"}`);\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// 历史行损坏跳过。\n\t\t}\n\t}\n\n\treturn {\n\t\tok: true,\n\t\trolledBack,\n\t\tbadVersion,\n\t\tpreviousVersion,\n\t\taffectedTasks,\n\t\tjudgement: judged,\n\t\tnotification: {\n\t\t\tresourceId: input.resourceId,\n\t\t\tbadVersion,\n\t\t\treason:\n\t\t\t\tjudged.reason +\n\t\t\t\t(rb.status === \"no_change\"\n\t\t\t\t\t? `；当前指向已变为 ${currentVersion}（另一修复已生效），未覆盖回退`\n\t\t\t\t\t: \"\") +\n\t\t\t\t(cancelledCount > 0 ? `；同源未终态候选 ${cancelledCount} 个已标待重评估` : \"\"),\n\t\t\tcurrentVersion,\n\t\t\taffectedTaskIds: affectedTasks.map((t) => t.taskId),\n\t\t\tneedsReviewFiles,\n\t\t\tneedsReview: needsReviewFiles.length > 0 || affectedTasks.length > 0,\n\t\t},\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控资源登记（S8-02）。\n *import { createHash } from \"node:crypto\";\nimport { mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join, dirname } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\ttypeEvolutionResource,\n\ttyperesolveEvolutionResourceEvolutionResourceKind,\n\tparseResourceId,\n} from \"./policy.ts\nimport { fingerprintResourceRoot, listResourceFiles } from \"./versions.ts\";\n// 5. 文件遍历（O12/E12：收拢到 versions.ts 共享实现，文件/目录统一分派）\n// ════════════════════════════════════════════════════════════════════════\n","ops":[{"diffOp":{"equal":{"range":[0,42]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[42,192]}}},{"diffOp":{"equal":{"range":[192,200]}}},{"diffOp":{"delete":{"range":[200,205]}}},{"diffOp":{"equal":{"range":[205,206]}}},{"diffOp":{"delete":{"range":[206,219]}}},{"diffOp":{"equal":{"range":[206,207]}}},{"diffOp":{"delete":{"range":[219,231]}}},{"diffOp":{"insert":{"range":[231,245]}}},{"diffOp":{"equal":{"range":[245,264]}}},{"diffOp":{"delete":{"range":[264,272]}}},{"diffOp":{"insert":{"range":[272,280]}}},{"diffOp":{"equal":{"range":[280,282]}}},{"diffOp":{"equal":{"range":[282,337]}}},{"diffOp":{"equal":{"range":[282,290]}}},{"diffOp":{"insert":{"range":[200,205]}}},{"diffOp":{"equal":{"range":[337,339]}}},{"diffOp":{"delete":{"range":[231,245]}}},{"diffOp":{"insert":{"range":[339,364]}}},{"diffOp":{"equal":{"range":[245,264]}}},{"diffOp":{"delete":{"range":[272,280]}}},{"diffOp":{"insert":{"range":[264,272]}}},{"diffOp":{"equal":{"range":[280,282]}}},{"diffOp":{"equal":{"range":[364,373]}}},{"diffOp":{"delete":{"range":[373,406]}}},{"diffOp":{"equal":{"range":[245,246]}}},{"diffOp":{"delete":{"range":[406,430]}}},{"diffOp":{"insert":{"range":[430,454]}}},{"diffOp":{"equal":{"range":[245,246]}}},{"diffOp":{"delete":{"range":[454,495]}}},{"diffOp":{"equal":{"range":[495,505]}}},{"diffOp":{"delete":{"range":[264,272]}}},{"diffOp":{"insert":{"range":[505,514]}}},{"diffOp":{"equal":{"range":[280,282]}}},{"diffOp":{"equal":{"range":[364,373]}}},{"diffOp":{"insert":{"range":[373,406]}}},{"diffOp":{"equal":{"range":[245,246]}}},{"diffOp":{"delete":{"range":[430,454]}}},{"diffOp":{"insert":{"range":[406,430]}}},{"diffOp":{"equal":{"range":[245,246]}}},{"diffOp":{"insert":{"range":[454,495]}}},{"diffOp":{"equal":{"range":[495,505]}}},{"diffOp":{"delete":{"range":[505,514]}}},{"diffOp":{"insert":{"range":[264,272]}}},{"diffOp":{"equal":{"range":[280,282]}}},{"diffOp":{"equal":{"range":[514,591]}}},{"equalLines":{"line_count":278}},{"diffOp":{"equal":{"range":[591,908]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\resources.ts"},"span":[753,794],"sourceCode":"/**\n * 受控资源登记（S8-02）。\n *\n * 职责：登记确切资源位置与加载方式、读当前已部署版本存为 baseVersion、\n * 对资源做文件快照（内容哈希），以及单资源停用/恢复自动进化。\n *\n * 契约（S8 任务书 §3/§5）：\n * - `registerResource`/`getResource`/`listResources`：登记确切资源；\n *   用户文件不扫描后自动登记。\n * - `snapshotResourceFiles`：列出资源当前文件及内容哈希，供 baseVersion 固定。\n * - `setAutoEvolution`：能单独停用/恢复某资源（autoEvolutionEnabled 开关）。\n *\n * 存储：`evolution_resources` 表在 memory/store.ts 的 SCHEMA_SQL 内；\n * 文件归 `<PAO_HOME>/evolution/versions/<resourceId>/<versionId>/`。\n */\nimport { createHash } from \"node:crypto\";\nimport { mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join, dirname } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tparseResourceId,\n} from \"./types.ts\";\nimport { resolveEvolutionResource } from \"./policy.ts\";\nimport { fingerprintResourceRoot, listResourceFiles } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 行映射\n// ════════════════════════════════════════════════════════════════════════\n\ninterface EvolutionResourceDbRow {\n\tresource_id: string;\n\tkind: string;\n\trelative_root: string;\n\tallowed_ops_json: string;\n\tcapability_scope_json: string;\n\tload_method: string;\n\teffective_version: string | null;\n\tauto_evolution_enabled: number;\n\tregistered_at: string;\n\tupdated_at: string;\n}\n\nfunction rowToResource(row: EvolutionResourceDbRow): EvolutionResource {\n\treturn {\n\t\tresourceId: row.resource_id,\n\t\tkind: row.kind as EvolutionResourceKind,\n\t\trelativeRoot: row.relative_root,\n\t\tallowedOps: JSON.parse(row.allowed_ops_json) as EvolutionResource[\"allowedOps\"],\n\t\tcapabilityScope: JSON.parse(row.capability_scope_json) as EvolutionResource[\"capabilityScope\"],\n\t\tloadMethod: row.load_method as EvolutionResource[\"loadMethod\"],\n\t\t...(row.effective_version === null ? {} : { effectiveVersion: row.effective_version }),\n\t\tautoEvolutionEnabled: row.auto_evolution_enabled === 1,\n\t\tregisteredAt: row.registered_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 登记 / 查询 / 停用\n// ════════════════════════════════════════════════════════════════════════\n\n/** `registerResource` 的输入。 */\nexport interface RegisterEvolutionResourceInput {\n\t/** 已授权类别。 */\n\tkind: EvolutionResourceKind;\n\t/** 目标名（技能名/部门名/命令名/策略键）。 */\n\tname: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 登记时间（夹具注入；缺省取当前）。 */\n\tregisteredAt?: string;\n}\n\n/**\n * 登记一个受控资源。\n *\n * 幂等：同一 resourceId 重复登记返回已有记录，不重复请求已授予的类别权限。\n * 用户文件不扫描后自动登记——只有显式调用本函数才入库。\n */\nexport function registerResource(\n\tstore: MemoryStore,\n\tinput: RegisterEvolutionResourceInput,\n): MemoryResult<EvolutionResource> {\n\tconst resolved = resolveEvolutionResource(input);\n\tif (!resolved.ok) return resolved;\n\tconst now = input.registeredAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst existing = getResourceRow(store, resolved.resourceId);\n\t\tif (existing) {\n\t\t\t// 已登记：更新路径/操作集（可能因类别策略微调），保留版本与开关。\n\t\t\tconst merged = rowToResource(existing);\n\t\t\treturn { ok: true, ...merged };\n\t\t}\n\t\tdbInsertResource(store, {\n\t\t\tresourceId: resolved.resourceId,\n\t\t\tkind: input.kind,\n\t\t\trelativeRoot: resolved.relativeRoot,\n\t\t\tallowedOps: resolved.allowedOps,\n\t\t\tcapabilityScope: resolved.capabilityScope,\n\t\t\tloadMethod: resolved.loadMethod,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: now,\n\t\t\tupdatedAt: now,\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresourceId: resolved.resourceId,\n\t\t\tkind: input.kind,\n\t\t\trelativeRoot: resolved.relativeRoot,\n\t\t\tallowedOps: resolved.allowedOps,\n\t\t\tcapabilityScope: resolved.capabilityScope,\n\t\t\tloadMethod: resolved.loadMethod,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: now,\n\t\t\tupdatedAt: now,\n\t\t};\n\t});\n}\n\n/** 按 resourceId 查询已登记资源。 */\nexport function getResource(store: MemoryStore, resourceId: string): MemoryResult<EvolutionResource> {\n\tconst parsed = parseResourceId(resourceId);\n\tif (!parsed) return fail(\"invalid_input\", `非法 resourceId:${resourceId}`, resourceId);\n\tconst row = getResourceRow(store, resourceId);\n\tif (!row) return fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\n\treturn { ok: true, ...rowToResource(row) };\n}\n\n/** 列出全部已登记资源（可按 kind 过滤）。 */\nexport function listResources(\n\tstore: MemoryStore,\n\tkind?: EvolutionResourceKind,\n): MemoryResult<{ items: EvolutionResource[] }> {\n\tif (kind !== undefined && !EVOLUTION_RESOURCE_KINDS.includes(kind)) {\n\t\treturn fail(\"invalid_input\", `未知资源类别:${String(kind)}`, String(kind));\n\t}\n\tconst rows = (kind === undefined\n\t\t? store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t\t FROM evolution_resources ORDER BY resource_id`,\n\t\t\t\t)\n\t\t\t\t.all()\n\t\t: store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t\t FROM evolution_resources WHERE kind = ? ORDER BY resource_id`,\n\t\t\t\t)\n\t\t\t\t.all(kind)) as unknown as EvolutionResourceDbRow[];\n\treturn { ok: true, items: rows.map(rowToResource) };\n}\n\n/** `setAutoEvolution` 的输入。 */\nexport interface SetAutoEvolutionInput {\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单个资源的自动进化。\n * 停用后保留当前有效版，不删除历史与验证记录。\n */\nexport function setAutoEvolution(store: MemoryStore, input: SetAutoEvolutionInput): MemoryResult<EvolutionResource> {\n\tconst now = input.updatedAt ?? new Date().toISOString();\n\treturn store.transaction(() => {\n\t\tconst row = getResourceRow(store, input.resourceId);\n\t\tif (!row) return fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_resources SET auto_evolution_enabled = ?, updated_at = ? WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.run(input.enabled ? 1 : 0, now, input.resourceId);\n\t\treturn { ok: true, ...rowToResource({ ...row, auto_evolution_enabled: input.enabled ? 1 : 0, updated_at: now }) };\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 文件快照（baseVersion 固定）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 快照里的一份文件。 */\nexport interface ResourceFileSnapshot {\n\t/** 资源根内相对路径（POSIX）。 */\n\tpath: string;\n\t/** 内容 SHA-256 哈希。 */\n\thash: string;\n\t/** 字节数。 */\n\tsizeBytes: number;\n}\n\n/** `snapshotResourceFiles` 的输出。 */\nexport interface ResourceSnapshot {\n\tresourceId: string;\n\t/** 本次快照的版本 ID（`v-{hash前12位}`）。 */\n\tversionId: string;\n\t/** 文件清单（相对路径 + 哈希）。 */\n\tfiles: ResourceFileSnapshot[];\n\t/** 快照时间。 */\n\tcreatedAt: string;\n}\n\n/**\n * 对资源当前文件做内容哈希快照。\n *\n * 只读资源根内文件，不扫描整个 PAO_HOME；\n * 结果写入 `evolution/versions/<resourceId>/<versionId>/` 目录（副本供后续\n * baseVersion 固定与差异对比）。文件不存在时如实返回空清单。\n * O12/E12：资源根可以是目录或单个文件（template/recipe 的 relative_root\n * 指向 `工作流/{name}.md`、`部门/{name}/配方.md` 单文件）——由共享的\n * listResourceFiles 统一分派，文件形态在版本目录保存原文件名（basename）。\n */\nexport function snapshotResourceFiles(\n\tstore: MemoryStore,\n\tinput: { resourceId: string; paoHome: string; createdAt?: string },\n): MemoryResult<ResourceSnapshot> {\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst absoluteRoot = join(input.paoHome, resource.relativeRoot);\n\tconst files = listResourceFiles(absoluteRoot);\n\tconst snapshots: ResourceFileSnapshot[] = files.map((file) => {\n\t\tconst content = readFileSync(file.absolutePath);\n\t\treturn {\n\t\t\tpath: file.relativePath,\n\t\t\thash: createHash(\"sha256\").update(content).digest(\"hex\"),\n\t\t\tsizeBytes: content.length,\n\t\t};\n\t});\n\n\t// 版本 ID = 全清单哈希的短前缀；同内容同 versionId（幂等）。\n\tconst versionId = fingerprintResourceRoot(absoluteRoot).versionId;\n\n\t// 把快照文件复制到版本目录（不可原位修改的版本底座）。\n\t// resourceId 含 `:`，在 Windows 目录名中非法；用 `_` 替换后落盘。\n\tconst dirSafeResourceId = input.resourceId.replace(/:/g, \"_\");\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, versionId);\n\tmkdirSync(versionDir, { recursive: true });\n\tfor (const file of files) {\n\t\tconst dest = join(versionDir, file.relativePath);\n\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\twriteFileSync(dest, readFileSync(file.absolutePath));\n\t}\n\n\t// 登记为资源的首个可恢复版本（无 effectiveVersion 时设为 baseVersion 指向）。\n\tif (resource.effectiveVersion === undefined) {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.run(versionId, now, input.resourceId);\n\t}\n\n\treturn { ok: true, resourceId: input.resourceId, versionId, files: snapshots, createdAt: now };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 内部 SQL\n// ════════════════════════════════════════════════════════════════════════\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): EvolutionResourceDbRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t)\n\t\t.get(resourceId) as EvolutionResourceDbRow | undefined;\n}\n\nfunction dbInsertResource(store: MemoryStore, resource: EvolutionResource & { autoEvolutionEnabled: boolean }): void {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_resources (\n\t\t\t\tresource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tresource.resourceId,\n\t\t\tresource.kind,\n\t\t\tresource.relativeRoot,\n\t\t\tJSON.stringify(resource.allowedOps),\n\t\t\tJSON.stringify(resource.capabilityScope),\n\t\t\tresource.loadMethod,\n\t\t\tresource.effectiveVersion ?? null,\n\t\t\tresource.autoEvolutionEnabled ? 1 : 0,\n\t\t\tresource.registeredAt,\n\t\t\tresource.updatedAt,\n\t\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 文件遍历（O12/E12：收拢到 versions.ts 共享实现，文件/目录统一分派）\n// ════════════════════════════════════════════════════════════════════════\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控资源登记（S8-02）。\n *\t\tif (!row) return fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_resources SET auto_evolution_enabled = ?, updated_at = ? WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.run(input.enabled ? 1 : 0, now, input.resourceId);\n\t\treturn { ok: true, ...rowToResource({ ...row, auto_evolution_enabled: input.enabled ? 1 : 0, updated_at: now }) };\tif (resource.effectiveVersion === undefined) {\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, now, input.resourceId);\n\t}// 5. 文件遍历（O12/E12：收拢到 versions.ts 共享实现，文件/目录统一分派）\n// ════════════════════════════════════════════════════════════════════════\n","ops":[{"diffOp":{"equal":{"range":[0,42]}}},{"equalLines":{"line_count":178}},{"diffOp":{"equal":{"range":[42,164]}}},{"diffOp":{"delete":{"range":[164,169]}}},{"diffOp":{"equal":{"range":[169,266]}}},{"diffOp":{"delete":{"range":[266,271]}}},{"diffOp":{"equal":{"range":[271,444]}}},{"equalLines":{"line_count":72}},{"diffOp":{"equal":{"range":[444,515]}}},{"diffOp":{"delete":{"range":[164,169]}}},{"diffOp":{"equal":{"range":[515,607]}}},{"diffOp":{"delete":{"range":[266,271]}}},{"diffOp":{"equal":{"range":[607,654]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[654,971]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\resources.ts"},"span":null,"sourceCode":"/**\n * 受控资源登记（S8-02）。\n *\n * 职责：登记确切资源位置与加载方式、读当前已部署版本存为 baseVersion、\n * 对资源做文件快照（内容哈希），以及单资源停用/恢复自动进化。\n *\n * 契约（S8 任务书 §3/§5）：\n * - `registerResource`/`getResource`/`listResources`：登记确切资源；\n *   用户文件不扫描后自动登记。\n * - `snapshotResourceFiles`：列出资源当前文件及内容哈希，供 baseVersion 固定。\n * - `setAutoEvolution`：能单独停用/恢复某资源（autoEvolutionEnabled 开关）。\n *\n * 存储：`evolution_resources` 表在 memory/store.ts 的 SCHEMA_SQL 内；\n * 文件归 `<PAO_HOME>/evolution/versions/<resourceId>/<versionId>/`。\n */\nimport { createHash } from \"node:crypto\";\nimport { mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join, dirname } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tparseResourceId,\n} from \"./types.ts\";\nimport { resolveEvolutionResource } from \"./policy.ts\";\nimport { fingerprintResourceRoot, listResourceFiles } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 行映射\n// ════════════════════════════════════════════════════════════════════════\n\ninterface EvolutionResourceDbRow {\n\tresource_id: string;\n\tkind: string;\n\trelative_root: string;\n\tallowed_ops_json: string;\n\tcapability_scope_json: string;\n\tload_method: string;\n\teffective_version: string | null;\n\tauto_evolution_enabled: number;\n\tregistered_at: string;\n\tupdated_at: string;\n}\n\nfunction rowToResource(row: EvolutionResourceDbRow): EvolutionResource {\n\treturn {\n\t\tresourceId: row.resource_id,\n\t\tkind: row.kind as EvolutionResourceKind,\n\t\trelativeRoot: row.relative_root,\n\t\tallowedOps: JSON.parse(row.allowed_ops_json) as EvolutionResource[\"allowedOps\"],\n\t\tcapabilityScope: JSON.parse(row.capability_scope_json) as EvolutionResource[\"capabilityScope\"],\n\t\tloadMethod: row.load_method as EvolutionResource[\"loadMethod\"],\n\t\t...(row.effective_version === null ? {} : { effectiveVersion: row.effective_version }),\n\t\tautoEvolutionEnabled: row.auto_evolution_enabled === 1,\n\t\tregisteredAt: row.registered_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 登记 / 查询 / 停用\n// ════════════════════════════════════════════════════════════════════════\n\n/** `registerResource` 的输入。 */\nexport interface RegisterEvolutionResourceInput {\n\t/** 已授权类别。 */\n\tkind: EvolutionResourceKind;\n\t/** 目标名（技能名/部门名/命令名/策略键）。 */\n\tname: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 登记时间（夹具注入；缺省取当前）。 */\n\tregisteredAt?: string;\n}\n\n/**\n * 登记一个受控资源。\n *\n * 幂等：同一 resourceId 重复登记返回已有记录，不重复请求已授予的类别权限。\n * 用户文件不扫描后自动登记——只有显式调用本函数才入库。\n */\nexport function registerResource(\n\tstore: MemoryStore,\n\tinput: RegisterEvolutionResourceInput,\n): MemoryResult<EvolutionResource> {\n\tconst resolved = resolveEvolutionResource(input);\n\tif (!resolved.ok) return resolved;\n\tconst now = input.registeredAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst existing = getResourceRow(store, resolved.resourceId);\n\t\tif (existing) {\n\t\t\t// 已登记：更新路径/操作集（可能因类别策略微调），保留版本与开关。\n\t\t\tconst merged = rowToResource(existing);\n\t\t\treturn { ok: true, ...merged };\n\t\t}\n\t\tdbInsertResource(store, {\n\t\t\tresourceId: resolved.resourceId,\n\t\t\tkind: input.kind,\n\t\t\trelativeRoot: resolved.relativeRoot,\n\t\t\tallowedOps: resolved.allowedOps,\n\t\t\tcapabilityScope: resolved.capabilityScope,\n\t\t\tloadMethod: resolved.loadMethod,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: now,\n\t\t\tupdatedAt: now,\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresourceId: resolved.resourceId,\n\t\t\tkind: input.kind,\n\t\t\trelativeRoot: resolved.relativeRoot,\n\t\t\tallowedOps: resolved.allowedOps,\n\t\t\tcapabilityScope: resolved.capabilityScope,\n\t\t\tloadMethod: resolved.loadMethod,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: now,\n\t\t\tupdatedAt: now,\n\t\t};\n\t});\n}\n\n/** 按 resourceId 查询已登记资源。 */\nexport function getResource(store: MemoryStore, resourceId: string): MemoryResult<EvolutionResource> {\n\tconst parsed = parseResourceId(resourceId);\n\tif (!parsed) return fail(\"invalid_input\", `非法 resourceId:${resourceId}`, resourceId);\n\tconst row = getResourceRow(store, resourceId);\n\tif (!row) return fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\n\treturn { ok: true, ...rowToResource(row) };\n}\n\n/** 列出全部已登记资源（可按 kind 过滤）。 */\nexport function listResources(\n\tstore: MemoryStore,\n\tkind?: EvolutionResourceKind,\n): MemoryResult<{ items: EvolutionResource[] }> {\n\tif (kind !== undefined && !EVOLUTION_RESOURCE_KINDS.includes(kind)) {\n\t\treturn fail(\"invalid_input\", `未知资源类别:${String(kind)}`, String(kind));\n\t}\n\tconst rows = (kind === undefined\n\t\t? store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t\t FROM evolution_resources ORDER BY resource_id`,\n\t\t\t\t)\n\t\t\t\t.all()\n\t\t: store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t\t FROM evolution_resources WHERE kind = ? ORDER BY resource_id`,\n\t\t\t\t)\n\t\t\t\t.all(kind)) as unknown as EvolutionResourceDbRow[];\n\treturn { ok: true, items: rows.map(rowToResource) };\n}\n\n/** `setAutoEvolution` 的输入。 */\nexport interface SetAutoEvolutionInput {\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单个资源的自动进化。\n * 停用后保留当前有效版，不删除历史与验证记录。\n */\nexport function setAutoEvolution(store: MemoryStore, input: SetAutoEvolutionInput): MemoryResult<EvolutionResource> {\n\tconst now = input.updatedAt ?? new Date().toISOString();\n\treturn store.transaction(() => {\n\t\tconst row = getResourceRow(store, input.resourceId);\n\t\tif (!row) return fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_resources SET auto_evolution_enabled = ?, updated_at = ? WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.run(input.enabled ? 1 : 0, now, input.resourceId);\n\t\treturn { ok: true, ...rowToResource({ ...row, auto_evolution_enabled: input.enabled ? 1 : 0, updated_at: now }) };\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 文件快照（baseVersion 固定）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 快照里的一份文件。 */\nexport interface ResourceFileSnapshot {\n\t/** 资源根内相对路径（POSIX）。 */\n\tpath: string;\n\t/** 内容 SHA-256 哈希。 */\n\thash: string;\n\t/** 字节数。 */\n\tsizeBytes: number;\n}\n\n/** `snapshotResourceFiles` 的输出。 */\nexport interface ResourceSnapshot {\n\tresourceId: string;\n\t/** 本次快照的版本 ID（`v-{hash前12位}`）。 */\n\tversionId: string;\n\t/** 文件清单（相对路径 + 哈希）。 */\n\tfiles: ResourceFileSnapshot[];\n\t/** 快照时间。 */\n\tcreatedAt: string;\n}\n\n/**\n * 对资源当前文件做内容哈希快照。\n *\n * 只读资源根内文件，不扫描整个 PAO_HOME；\n * 结果写入 `evolution/versions/<resourceId>/<versionId>/` 目录（副本供后续\n * baseVersion 固定与差异对比）。文件不存在时如实返回空清单。\n * O12/E12：资源根可以是目录或单个文件（template/recipe 的 relative_root\n * 指向 `工作流/{name}.md`、`部门/{name}/配方.md` 单文件）——由共享的\n * listResourceFiles 统一分派，文件形态在版本目录保存原文件名（basename）。\n */\nexport function snapshotResourceFiles(\n\tstore: MemoryStore,\n\tinput: { resourceId: string; paoHome: string; createdAt?: string },\n): MemoryResult<ResourceSnapshot> {\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst absoluteRoot = join(input.paoHome, resource.relativeRoot);\n\tconst files = listResourceFiles(absoluteRoot);\n\tconst snapshots: ResourceFileSnapshot[] = files.map((file) => {\n\t\tconst content = readFileSync(file.absolutePath);\n\t\treturn {\n\t\t\tpath: file.relativePath,\n\t\t\thash: createHash(\"sha256\").update(content).digest(\"hex\"),\n\t\t\tsizeBytes: content.length,\n\t\t};\n\t});\n\n\t// 版本 ID = 全清单哈希的短前缀；同内容同 versionId（幂等）。\n\tconst versionId = fingerprintResourceRoot(absoluteRoot).versionId;\n\n\t// 把快照文件复制到版本目录（不可原位修改的版本底座）。\n\t// resourceId 含 `:`，在 Windows 目录名中非法；用 `_` 替换后落盘。\n\tconst dirSafeResourceId = input.resourceId.replace(/:/g, \"_\");\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, versionId);\n\tmkdirSync(versionDir, { recursive: true });\n\tfor (const file of files) {\n\t\tconst dest = join(versionDir, file.relativePath);\n\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\twriteFileSync(dest, readFileSync(file.absolutePath));\n\t}\n\n\t// 登记为资源的首个可恢复版本（无 effectiveVersion 时设为 baseVersion 指向）。\n\tif (resource.effectiveVersion === undefined) {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.run(versionId, now, input.resourceId);\n\t}\n\n\treturn { ok: true, resourceId: input.resourceId, versionId, files: snapshots, createdAt: now };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 内部 SQL\n// ════════════════════════════════════════════════════════════════════════\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): EvolutionResourceDbRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t)\n\t\t.get(resourceId) as EvolutionResourceDbRow | undefined;\n}\n\nfunction dbInsertResource(store: MemoryStore, resource: EvolutionResource & { autoEvolutionEnabled: boolean }): void {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_resources (\n\t\t\t\tresource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tresource.resourceId,\n\t\t\tresource.kind,\n\t\t\tresource.relativeRoot,\n\t\t\tJSON.stringify(resource.allowedOps),\n\t\t\tJSON.stringify(resource.capabilityScope),\n\t\t\tresource.loadMethod,\n\t\t\tresource.effectiveVersion ?? null,\n\t\t\tresource.autoEvolutionEnabled ? 1 : 0,\n\t\t\tresource.registeredAt,\n\t\t\tresource.updatedAt,\n\t\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 文件遍历（O12/E12：收拢到 versions.ts 共享实现，文件/目录统一分派）\n// ════════════════════════════════════════════════════════════════════════\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化隔离验证执行器（S8-08）。\n * */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport {\n\tcopyFileSync,existsSync,mkdirSync,readdirSync,readFileSync,rmSync,statSync,writeFileSync,\n} from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, join, relative, resolve, sep } from \"node:path\"; * 资源的用例）。\n */\nfunction materializeVersionCopy(layout: ScratchLayout,input: RunValidationCaseInput): { resourceCopyDir: string; sourceDir: string } {\n\tconst dirSafe = dirSafeId(input.resourceId);\n\tconst paths = evolutionPaths(input.paoHome);\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,60]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[60,126]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[128,141]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[141,152]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[152,162]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[162,174]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[174,187]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[187,194]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[194,203]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[203,216]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[216,218]}}},{"diffOp":{"equal":{"range":[218,336]}}},{"equalLines":{"line_count":201}},{"diffOp":{"equal":{"range":[336,397]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[397,419]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"insert":{"range":[126,128]}}},{"diffOp":{"equal":{"range":[419,448]}}},{"diffOp":{"insert":{"range":[216,218]}}},{"diffOp":{"equal":{"range":[448,591]}}},{"equalLines":{"line_count":537}},{"diffOp":{"equal":{"range":[591,597]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\runner.ts"},"span":null,"sourceCode":"/**\n * 受控自进化隔离验证执行器（S8-08）。\n *\n * 职责：为一个冻结 `ValidationCase` 分别在 baseline / candidate 两侧各建独立\n * home、cwd、sessionDir，从同一份 `initialFiles` 复制后运行，回收运行回执。\n *\n * 契约（S8 任务书 §5 与实施路径 §6）：\n * - baseline/candidate 各建独立 home、cwd、sessionDir；同一 initialFiles 复制。\n * - 纯命令用例用 `runCardProcess(cmd,args,cwd,timeoutMs,env,signal)` 启动已批准\n *   验证器；命令先过 `checkCommandSafety` 安检门。\n * - 技能效果类用例用隔离验证进程内受控入口：显式传 agentDir、modelRuntime、\n *   sessionManager、resourceLoader、tools；工具只保留 `case.allowedTools`。\n * - 通过 `additionalSkillPaths`/`additionalExtensionPaths` 加载指定版本；\n *   默认自动发现不能带入正式 home 或另一候选。\n * - 运行回执保存输出、退出码、相关文件变化、模型配置、requestId、费用、\n *   取消原因；落盘在 `evolution/validations/<testPlanId>/runs/`（核心管理位置，\n *   不在候选可写目录）。\n * - 子进程模型认证沿现有受控启动方式传入（隔离 home 内 agentDir），不复制\n *   用户凭证文件。\n * - 进程取消及超时能收尾；无正式会话/用户项目文件挂入候选可写区。\n *\n * 边界声明：本模块不提供操作系统沙箱。隔离靠「独立 scratch 目录 + 白名单环境 +\n * 事后文件树对比 + 受控入口」；候选进程能写 scratch 父链上的内容时由\n * `fileChanges` 与 boundary 核对兜底，不声称路径白名单已隔离。\n */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, join, relative, resolve, sep } from \"node:path\";\nimport { type CardProcessResult, runCardProcess } from \"../cards/process.ts\";\nimport { checkCommandSafety } from \"../cards/verifier.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport { resolveValidationToolSet } from \"./boundary.ts\";\nimport type { ValidationCase, ValidationRunResult } from \"./types.ts\";\nimport { fingerprintResourceRoot, listResourceFiles } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 用例形态：纯命令验证 or 隔离 agent 会话的技能效果验证。 */\nexport type ValidationRunKind = \"command\" | \"agent\";\n\n/** 运行侧：baseline（旧版）或 candidate（候选副本）。 */\nexport type ValidationSide = \"baseline\" | \"candidate\";\n\n/** 已批准验证器（命令型用例）：核心定义的命令，不来自候选。 */\nexport interface ApprovedVerifier {\n\t/** 命令头（相对/可执行名）。 */\n\tcmd: string;\n\t/** 参数数组。 */\n\targs?: string[];\n\t/** 附加环境（白名单净化基础上叠加；不得含凭证）。 */\n\tenv?: Record<string, string>;\n}\n\n/** 隔离 agent 会话工厂的依赖注入面（测试可换假实现）。 */\nexport interface AgentSessionFactoryInput {\n\t/** 隔离 home 根（本次运行专用）。 */\n\thomeDir: string;\n\t/** 隔离工作目录（initialFiles 已复制进来）。 */\n\tcwd: string;\n\t/** 隔离 sessionDir。 */\n\tsessionDir: string;\n\t/** 隔离 agentDir（`<home>/agent`；认证沿受控启动方式从该目录读）。 */\n\tagentDir: string;\n\t/** 冻结用例。 */\n\tvalidationCase: ValidationCase;\n\t/** 版本化资源副本路径（技能/扩展目录；经 additionalSkillPaths/additionalExtensionPaths 挂接）。 */\n\tresourceCopyDir?: string;\n\t/** 资源加载方式（决定挂到 additionalSkillPaths 还是 additionalExtensionPaths）。 */\n\tloadMethod?: \"skill-path\" | \"extension-path\" | string;\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/**\n\t * 超时毫秒（O10/E10）：编排层给的收口上限；到达后等同 abort。\n\t * 接口仅声明字段——工厂实现与超时/AbortSignal 具体收口归 O11。\n\t */\n\ttimeoutMs?: number;\n\t/** 模型配置（档位/模型名；原样传给受控入口）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** 隔离 agent 会话的运行结果。 */\nexport interface AgentSessionRunOutcome {\n\t/** 输出摘要（assistant 文本拼接）。 */\n\toutput: string;\n\t/**\n\t * 会话是否完整结束（O11/E07）：「会话跑完」与「验收通过」分开——\n\t * completed=true 只表示会话正常收尾，不表示判据通过；判据由\n\t * acceptance 核对（编排层/evaluate）给出。未提供时 runner 按 output\n\t * 非空回退判定（兼容只回 output 的旧假工厂）。\n\t */\n\tcompleted?: boolean;\n\t/** requestId（受控入口返回）。 */\n\trequestId?: string;\n\t/** 用量引用。 */\n\tusageRef?: string;\n\t/** 取消原因（被取消/中止时——返回 abortReason 一律按执行故障记，不可通过）。 */\n\tabortReason?: string;\n}\n\n/** `runValidationCase` 的依赖注入面。 */\nexport interface RunValidationCaseDeps {\n\t/** 隔离 agent 会话工厂（技能效果类用例）；缺省时 agent 用例返回 unavailable。 */\n\tagentSessionFactory?: (input: AgentSessionFactoryInput) => Promise<AgentSessionRunOutcome>;\n\t/** 命令执行器（缺省 `runCardProcess`；测试可换假实现）。 */\n\tprocessRunner?: typeof runCardProcess;\n\t/** scratch 根（缺省 `<系统临时目录>/pao-evolution-run`）。 */\n\tscratchRoot?: string;\n\t/** 是否保留 scratch（排障用；缺省 false，run 结束整体删除）。 */\n\tkeepScratch?: boolean;\n}\n\n/** `runValidationCase` 的输入。 */\nexport interface RunValidationCaseInput {\n\t/** 冻结用例。 */\n\tvalidationCase: ValidationCase;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本。 */\n\tbaseVersion: string;\n\t/** 运行侧。 */\n\tside: ValidationSide;\n\t/** 候选 ID（side=candidate 时必填）。 */\n\tcandidateId?: string;\n\t/** 冻结计划 ID（回执落盘归属）。 */\n\ttestPlanId: string;\n\t/** PAO_HOME 根（回执落盘用）。 */\n\tpaoHome: string;\n\t/** 用例形态。 */\n\tkind: ValidationRunKind;\n\t/** 已批准验证器（kind=command 必填）。 */\n\tverifier?: ApprovedVerifier;\n\t/** 单条命令超时毫秒；缺省 120000。 */\n\ttimeoutMs?: number;\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 版本化资源副本目录（kind=agent 时经 additionalSkillPaths/additionalExtensionPaths 挂接）。 */\n\tresourceCopyDir?: string;\n\t/** 资源加载方式（kind=agent 时决定挂接路径）。 */\n\tloadMethod?: \"skill-path\" | \"extension-path\" | string;\n\t/** 运行时间（夹具注入）。 */\n\trunAt?: string;\n}\n\n/** `runValidationCase` 的成功输出。 */\nexport interface RunValidationCaseResult {\n\t/** 运行回执（不含 usageRef 时由调用方聚合）。 */\n\tresult: ValidationRunResult;\n\t/** 回执落盘路径（evolution/validations/<testPlanId>/runs/…）。 */\n\treceiptPath: string;\n\t/** 隔离 scratch 根（keepScratch 时保留供排障；否则已删除）。 */\n\tscratchDir?: string;\n\t/** 取消原因（被取消时）。 */\n\tcancelReason?: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 隔离 scratch 与环境\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 隔离 scratch 布局：`<scratch>/<caseId>-<side>-<rand>/{home,work,session,agent}`。 */\ninterface ScratchLayout {\n\troot: string;\n\thomeDir: string;\n\tworkDir: string;\n\tsessionDir: string;\n\tagentDir: string;\n}\n\nfunction makeScratch(scratchRoot: string | undefined, caseId: string, side: ValidationSide): ScratchLayout {\n\tconst base = scratchRoot ?? join(tmpdir(), \"pao-evolution-run\");\n\tconst root = join(base, `${caseId}-${side}-${randomUUID().slice(0, 8)}`);\n\tconst layout: ScratchLayout = {\n\t\troot,\n\t\thomeDir: join(root, \"home\"),\n\t\tworkDir: join(root, \"work\"),\n\t\tsessionDir: join(root, \"session\"),\n\t\tagentDir: join(root, \"home\", \"agent\"),\n\t};\n\tfor (const dir of [layout.homeDir, layout.workDir, layout.sessionDir, layout.agentDir]) {\n\t\tmkdirSync(dir, { recursive: true });\n\t}\n\treturn layout;\n}\n\n/** 把 initialFiles 复制进 workDir；返回相对路径清单。 */\nfunction materializeInitialFiles(workDir: string, initialFiles: Record<string, string>): string[] {\n\tconst written: string[] = [];\n\tfor (const [rel, content] of Object.entries(initialFiles)) {\n\t\tconst normalized = rel.replace(/\\\\/g, \"/\").replace(/^\\/+/, \"\");\n\t\t// 初始文件不允许越出 workDir；`..` 段直接抛错（输入非法，不是运行时失败）。\n\t\tconst abs = resolve(workDir, normalized);\n\t\tconst relToWork = relative(workDir, abs).replace(/\\\\/g, \"/\");\n\t\tif (relToWork === \"..\" || relToWork.startsWith(`..${sep}`) || relToWork.startsWith(\"../\")) {\n\t\t\tthrow new Error(`initialFiles 含越界路径:${rel}`);\n\t\t}\n\t\tmkdirSync(dirname(abs), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t\twritten.push(normalized);\n\t}\n\treturn written;\n}\n\n/** resourceId → 目录安全名（`:` → `_`，与 versions/candidates 同规则）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/**\n * 版本副本物化（O11/E07）：把「该侧应验证的资源正文」复制进 workDir 下的\n * 固定子目录 `resource/`。\n *\n * - baseline 侧来源：`evolution/versions/<dirSafeResourceId>/<baseVersion>/`\n *   （snapshotResourceFiles 当时固化的旧版正文）；\n * - candidate 侧来源：`evolution/candidates/<dirSafeResourceId>/<candidateId>/`\n *   （proposeCandidate 生成的候选目录）。\n *\n * 两侧差异来自已固化版本/候选目录本身，不由调用方逐侧塞不同 initialFiles\n * 制造。冻结用例的脚本/测试以相对路径 `resource/` 引用它（verifier 在\n * workDir 内执行自然读到对应侧正文）。\n *\n * 源目录缺失或为空时抛错（输入前置缺失，如实暴露——不静默跑一个没装\n * 资源的用例）。\n */\nfunction materializeVersionCopy(layout: ScratchLayout, input: RunValidationCaseInput): { resourceCopyDir: string; sourceDir: string } {\n\tconst dirSafe = dirSafeId(input.resourceId);\n\tconst paths = evolutionPaths(input.paoHome);\n\tconst sourceDir =\n\t\tinput.side === \"baseline\"\n\t\t\t? join(paths.versions, dirSafe, input.baseVersion)\n\t\t\t: join(paths.candidates, dirSafe, input.candidateId!);\n\tif (!existsSync(sourceDir)) {\n\t\tthrow new Error(\n\t\t\t`${input.side} 版本副本源目录不存在:${sourceDir}（baseline 应指向已固化 versions/<baseVersion>，candidate 应指向 candidates/<candidateId>）`,\n\t\t);\n\t}\n\tconst files = listResourceFiles(sourceDir);\n\tif (files.length === 0) {\n\t\tthrow new Error(`${input.side} 版本副本源目录为空:${sourceDir}`);\n\t}\n\tconst dest = join(layout.workDir, \"resource\");\n\tfor (const file of files) {\n\t\tconst target = join(dest, file.relativePath);\n\t\tmkdirSync(dirname(target), { recursive: true });\n\t\tcopyFileSync(file.absolutePath, target);\n\t}\n\treturn { resourceCopyDir: dest, sourceDir };\n}\n\n/** 递归列出目录文件（相对路径 + sha256）。 */\nfunction hashTree(root: string): Map<string, string> {\n\tconst out = new Map<string, string>();\n\tif (!existsSync(root)) return out;\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tconst content = readFileSync(full);\n\t\t\t\tout.set(relative(root, full).replace(/\\\\/g, \"/\"), createHash(\"sha256\").update(content).digest(\"hex\"));\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out;\n}\n\n/** 计算前后文件树差异；返回 相对路径 → 变化描述（`new:<hash>`/`changed:<hash>`/`deleted`）。 */\nfunction diffTrees(before: Map<string, string>, after: Map<string, string>): Record<string, string> {\n\tconst changes: Record<string, string> = {};\n\tfor (const [path, hash] of after) {\n\t\tconst prev = before.get(path);\n\t\tif (prev === undefined) changes[path] = `new:${hash}`;\n\t\telse if (prev !== hash) changes[path] = `changed:${hash}`;\n\t}\n\tfor (const path of before.keys()) {\n\t\tif (!after.has(path)) changes[path] = \"deleted\";\n\t}\n\treturn changes;\n}\n\n/**\n * 验证环境白名单（等价 verifier 的 sanitizedEnv；本模块不复用其私有实现）：\n * 只传进程运行必需的系统变量 + PAO_HOME 指向隔离 home；不带用户凭证/项目配置。\n */\nfunction sanitizedValidationEnv(homeDir: string): NodeJS.ProcessEnv {\n\tconst allowed = [\n\t\t\"PATH\",\n\t\t\"Path\",\n\t\t\"SystemRoot\",\n\t\t\"SYSTEMROOT\",\n\t\t\"SystemDrive\",\n\t\t\"ComSpec\",\n\t\t\"PATHEXT\",\n\t\t\"TEMP\",\n\t\t\"TMP\",\n\t\t\"USERPROFILE\",\n\t\t\"HOME\",\n\t\t\"NO_COLOR\",\n\t\t\"CI\",\n\t];\n\tconst env: NodeJS.ProcessEnv = {};\n\tfor (const key of allowed) {\n\t\tif (process.env[key] !== undefined) env[key] = process.env[key];\n\t}\n\t// 隔离 home：子进程内解析 PAO_HOME 一律落隔离区，不指正式现场。\n\tenv.PAO_HOME = homeDir;\n\treturn env;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 回执落盘（核心管理位置）\n// ════════════════════════════════════════════════════════════════════════\n\ninterface ValidationReceipt {\n\tcaseId: string;\n\tside: ValidationSide;\n\ttestPlanId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\tcandidateId?: string;\n\tkind: ValidationRunKind;\n\t/** 该侧物化的版本副本源目录（O11/E08：已验内容绑定的指纹比对对象）。 */\n\tresourceCopyDir?: string;\n\t/** 版本副本指纹（`v-{sha12(清单)}`——O11/E08 绑定「验过的正文」）。 */\n\tresourceFingerprint?: string;\n\tresult: ValidationRunResult;\n\tmodelConfig?: Record<string, unknown>;\n\trequestId?: string;\n\tcancelReason?: string;\n\trunAt: string;\n}\n\nfunction writeReceipt(paoHome: string, testPlanId: string, receipt: ValidationReceipt): string {\n\tconst dir = join(evolutionPaths(paoHome).validations, testPlanId, \"runs\");\n\tmkdirSync(dir, { recursive: true });\n\tconst filename = `${receipt.caseId}-${receipt.side}-${randomUUID().slice(0, 8)}.json`;\n\tconst file = join(dir, filename);\n\twriteFileSync(file, JSON.stringify(receipt, null, 2), \"utf8\");\n\treturn file;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 命令型用例\n// ════════════════════════════════════════════════════════════════════════\n\nasync function executeCommandCase(\n\tlayout: ScratchLayout,\n\tinput: RunValidationCaseInput,\n\tdeps: RunValidationCaseDeps,\n\tbeforeTree: Map<string, string>,\n): Promise<{ run: ValidationRunResult; cancelReason?: string }> {\n\tconst verifier = input.verifier;\n\tif (!verifier) {\n\t\treturn { run: { passed: false, failureReason: \"kind=command 但缺 verifier\" } };\n\t}\n\tconst argv = [verifier.cmd, ...(verifier.args ?? [])];\n\tconst joined = argv.join(\" \");\n\tconst safety = checkCommandSafety(joined);\n\tif (!safety.过) {\n\t\treturn {\n\t\t\trun: { passed: false, failureReason: `验证器命令未过安检:${safety.违规.join(\"；\")}` },\n\t\t};\n\t}\n\tconst env = { ...sanitizedValidationEnv(layout.homeDir), ...(verifier.env ?? {}) };\n\tconst runner = deps.processRunner ?? runCardProcess;\n\tlet proc: CardProcessResult;\n\ttry {\n\t\tproc = await runner(\n\t\t\tverifier.cmd,\n\t\t\tverifier.args ?? [],\n\t\t\tlayout.workDir,\n\t\t\tinput.timeoutMs ?? 120000,\n\t\t\tenv,\n\t\t\tinput.signal,\n\t\t);\n\t} catch (error) {\n\t\t// AbortError 与停止未确认分开归类：取消保留取消语义。\n\t\tif (input.signal?.aborted || (error as Error).name === \"AbortError\") {\n\t\t\treturn {\n\t\t\t\trun: {\n\t\t\t\t\tpassed: false,\n\t\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\t\tfailureReason: `已取消:${(error as Error).message ?? String(error)}`,\n\t\t\t\t},\n\t\t\t\tcancelReason: String(input.signal?.reason ?? \"aborted\"),\n\t\t\t};\n\t\t}\n\t\t// 停止未确认/启动故障：如实记未完成（executionFailure=start），不伪装业务失败。\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: `进程启动/停止异常:${(error as Error).message ?? String(error)}`,\n\t\t\t},\n\t\t};\n\t}\n\tconst afterTree = hashTree(layout.workDir);\n\tconst fileChanges = diffTrees(beforeTree, afterTree);\n\tconst output = `${proc.stdout}${proc.stderr ? `\\n--- stderr ---\\n${proc.stderr}` : \"\"}`.trim();\n\t// 环境/执行故障（启动失败/超时）记结构化 executionFailure，不再塞进\n\t// failureReason 字符串——evaluate 据此判 incomplete，不把它当业务失败或通过。\n\tconst executionFailure =\n\t\tproc.failureKind === \"timeout\" || proc.failureKind === \"start\" ? proc.failureKind : undefined;\n\tconst passed = proc.code === 0 && executionFailure === undefined;\n\treturn {\n\t\trun: {\n\t\t\tpassed,\n\t\t\toutput: output.slice(0, 64 * 1024),\n\t\t\texitCode: proc.code,\n\t\t\tfileChanges,\n\t\t\t...(executionFailure ? { executionFailure } : {}),\n\t\t\t...(proc.failureKind ? { failureReason: `failureKind=${proc.failureKind}` } : {}),\n\t\t\t...(proc.outputTruncated ? { failureReason: `输出超过采集上限 ${proc.outputLimitBytes} 字节` } : {}),\n\t\t},\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. agent 会话型用例（技能/模板文本生效验证）\n// ════════════════════════════════════════════════════════════════════════\n\nasync function executeAgentCase(\n\tlayout: ScratchLayout,\n\tinput: RunValidationCaseInput,\n\tdeps: RunValidationCaseDeps,\n\tbeforeTree: Map<string, string>,\n): Promise<{ run: ValidationRunResult; cancelReason?: string; requestId?: string }> {\n\tif (!deps.agentSessionFactory) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: \"kind=agent 但未注入 agentSessionFactory（隔离验证入口未装配）\",\n\t\t\t},\n\t\t};\n\t}\n\tlet outcome: AgentSessionRunOutcome;\n\ttry {\n\t\toutcome = await deps.agentSessionFactory({\n\t\t\thomeDir: layout.homeDir,\n\t\t\tcwd: layout.workDir,\n\t\t\tsessionDir: layout.sessionDir,\n\t\t\tagentDir: layout.agentDir,\n\t\t\tvalidationCase: input.validationCase,\n\t\t\tresourceCopyDir: input.resourceCopyDir,\n\t\t\tloadMethod: input.loadMethod,\n\t\t\tsignal: input.signal,\n\t\t\ttimeoutMs: input.timeoutMs,\n\t\t\tmodelConfig: input.validationCase.modelConfig,\n\t\t});\n\t} catch (error) {\n\t\tif (input.signal?.aborted || (error as Error).name === \"AbortError\") {\n\t\t\treturn {\n\t\t\t\trun: {\n\t\t\t\t\tpassed: false,\n\t\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\t\tfailureReason: `已取消:${(error as Error).message ?? String(error)}`,\n\t\t\t\t},\n\t\t\t\tcancelReason: String(input.signal?.reason ?? \"aborted\"),\n\t\t\t};\n\t\t}\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: `隔离验证会话异常:${(error as Error).message ?? String(error)}`,\n\t\t\t},\n\t\t};\n\t}\n\tconst afterTree = hashTree(layout.workDir);\n\tconst fileChanges = diffTrees(beforeTree, afterTree);\n\n\t// O11/E07：「会话完成」与「验收通过」分开——\n\t// - abortReason 返回 → 会话被中止/取消，执行故障，绝不可通过；\n\t// - completed=false（或 completed 未给但 output 为空）→ 会话未真正收尾，\n\t//   执行故障，不当业务通过；\n\t// - 其余情况 passed=true 只表示「会话完整跑完」（判据仍由 acceptance/evaluate\n\t//   裁决——本层不再无条件放行）。\n\tif (outcome.abortReason !== undefined) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\tfailureReason: `会话中止:${outcome.abortReason}`,\n\t\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\t\tfileChanges,\n\t\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t\t},\n\t\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t\t};\n\t}\n\tconst completed = outcome.completed ?? outcome.output.trim().length > 0;\n\tif (!completed) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: \"隔离会话未完整收尾（completed=false/无输出）\",\n\t\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\t\tfileChanges,\n\t\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t\t},\n\t\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t\t};\n\t}\n\treturn {\n\t\trun: {\n\t\t\tpassed: true, // 会话完整跑完；判据通过与否由 acceptance/evaluate 裁决\n\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\tfileChanges,\n\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t},\n\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 入口\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 运行一个冻结验证用例的 baseline 或 candidate 侧。\n *\n * 流程：建独立 scratch（home/work/session/agent）→ 复制 initialFiles →\n * **物化版本副本**（baseline=`versions/<baseVersion>`、candidate=\n * `candidates/<candidateId>` 复制进 `workDir/resource/`）→ 记录运行前\n * 文件树 → 按 kind 走命令或隔离会话 → 记录运行后文件树差异 →\n * 回执落盘 `evolution/validations/<testPlanId>/runs/` → 清理 scratch。\n *\n * 取消：AbortSignal 传到 runCardProcess/会话工厂；取消结果保留取消原因，\n * 不把取消伪装成业务失败。\n */\nexport async function runValidationCase(\n\t_store: MemoryStore,\n\tdeps: RunValidationCaseDeps,\n\tinput: RunValidationCaseInput,\n): Promise<MemoryResult<RunValidationCaseResult>> {\n\tinput.signal?.throwIfAborted();\n\tif (input.side === \"candidate\" && !input.candidateId) {\n\t\treturn fail(\"invalid_input\", \"side=candidate 时必须给 candidateId\");\n\t}\n\tconst layout = makeScratch(deps.scratchRoot, input.validationCase.caseId, input.side);\n\tconst runAt = input.runAt ?? new Date().toISOString();\n\tconst keep = deps.keepScratch === true;\n\ttry {\n\t\t// 复制初始文件；越界路径直接抛错（输入非法）。\n\t\tmaterializeInitialFiles(layout.workDir, input.validationCase.initialFiles);\n\t\t// O11/E07：版本副本物化——两侧差异来自已固化版本/候选目录本身；\n\t\t// 冻结用例经相对路径 `resource/` 引用对应侧正文。\n\t\tconst versionCopy = materializeVersionCopy(layout, input);\n\t\t// O11/E08：对版本副本源目录算指纹写回执——publish 门以它绑定「验过的正文」。\n\t\tconst resourceFingerprint = fingerprintResourceRoot(versionCopy.sourceDir).versionId;\n\t\tconst beforeTree = hashTree(layout.workDir);\n\n\t\t// 版本副本路径归一化：调用方显式给的 resourceCopyDir 优先（向后兼容），\n\t\t// 否则用物化出来的固定子目录。\n\t\tconst effectiveInput: RunValidationCaseInput =\n\t\t\tinput.resourceCopyDir === undefined ? { ...input, resourceCopyDir: versionCopy.resourceCopyDir } : input;\n\n\t\tlet run: ValidationRunResult;\n\t\tlet cancelReason: string | undefined;\n\t\tlet requestId: string | undefined;\n\t\tif (input.kind === \"command\") {\n\t\t\tconst out = await executeCommandCase(layout, effectiveInput, deps, beforeTree);\n\t\t\trun = out.run;\n\t\t\tcancelReason = out.cancelReason;\n\t\t} else {\n\t\t\tconst out = await executeAgentCase(layout, effectiveInput, deps, beforeTree);\n\t\t\trun = out.run;\n\t\t\tcancelReason = out.cancelReason;\n\t\t\trequestId = out.requestId;\n\t\t}\n\n\t\t// 回执：运行时间戳取自入参（夹具注入）或当前；requestId 来自受控入口返回。\n\t\tconst receipt: ValidationReceipt = {\n\t\t\tcaseId: input.validationCase.caseId,\n\t\t\tside: input.side,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tresourceId: input.resourceId,\n\t\t\tbaseVersion: input.baseVersion,\n\t\t\t...(input.candidateId ? { candidateId: input.candidateId } : {}),\n\t\t\tkind: input.kind,\n\t\t\tresourceCopyDir: versionCopy.sourceDir,\n\t\t\tresourceFingerprint,\n\t\t\tresult: run,\n\t\t\t...(input.validationCase.modelConfig ? { modelConfig: input.validationCase.modelConfig } : {}),\n\t\t\t...(requestId ? { requestId } : {}),\n\t\t\t...(cancelReason ? { cancelReason } : {}),\n\t\t\trunAt,\n\t\t};\n\t\tconst receiptPath = writeReceipt(input.paoHome, input.testPlanId, receipt);\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresult: run,\n\t\t\treceiptPath,\n\t\t\t...(keep ? { scratchDir: layout.root } : {}),\n\t\t\t...(cancelReason ? { cancelReason } : {}),\n\t\t};\n\t} finally {\n\t\t// 收尾：scratch 整体删除（keepScratch 时保留供排障）；取消/异常同路径收尾。\n\t\tif (!keep) {\n\t\t\ttry {\n\t\t\t\trmSync(layout.root, { recursive: true, force: true });\n\t\t\t} catch {\n\t\t\t\t// 清理失败不掩盖运行结果；残留只影响临时空间。\n\t\t\t}\n\t\t}\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 7. 生产 agent 会话工厂（O11/E07：包现成 SDK 函数，不新建框架）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生产版隔离 agent 会话工厂。\n *\n * 装配（全部包现成函数）：\n * 1. `DefaultResourceLoader`：候选/版本副本经 `prioritySkillPaths`（skill-path）\n *    或 `additionalExtensionPaths`（extension-path）挂接——priority 保证\n *    候选版本压过用户目录同名技能；`noContextFiles/noPromptTemplates/noThemes`\n *    隔离用户配置；隔离 agentDir 内无用户技能/扩展来源可发现。\n * 2. `SessionManager.create(cwd, sessionDir)`：隔离会话目录。\n * 3. `createAgentSession`：注入 modelRuntime（假实现可经 modelConfig.modelRuntime\n *    或 deps 注入）、`tools`=`resolveValidationToolSet(case).allowed` 交集、\n *    resourceLoader、sessionManager、agentDir、cwd。\n * 4. 驱动 `session.prompt(input)` → `waitForIdle()`；output 取\n *    `getLastAssistantText()`，usage 取 `getSessionStats()`。\n * 5. 取消/超时：`input.signal` 与 `AbortSignal.timeout(timeoutMs)` 经\n *    `AbortSignal.any` 合成；信号触发即 `session.abort()`+`close()`，返回\n *    abortReason。\n *\n * 不启动扩展：验证只用内置限定工具集（read/grep/find/ls），候选扩展代码\n * 不经本通道激活（extension 资源 publish 侧本就不可自动发布）。\n */\nexport async function createValidationAgentSession(\n\tinput: AgentSessionFactoryInput,\n\toptions: {\n\t\t/** 注入 modelRuntime（假实现经此缝进；缺省用隔离 agentDir 认证创建真实 runtime）。 */\n\t\tmodelRuntime?: unknown;\n\t} = {},\n): Promise<AgentSessionRunOutcome> {\n\tconst { DefaultResourceLoader } = await import(\"../../core/resource-loader.ts\");\n\tconst { SessionManager } = await import(\"../../core/session-manager.ts\");\n\tconst { SettingsManager } = await import(\"../../core/settings-manager.ts\");\n\tconst { ModelRuntime } = await import(\"../../core/model-runtime.ts\");\n\tconst { createAgentSession } = await import(\"../../core/sdk.ts\");\n\n\t// 工具交集：VALIDATION_TOOL_ALLOWLIST ∩ case.allowedTools。\n\tconst toolset = resolveValidationToolSet(input.validationCase);\n\n\t// 资源挂接：skill-path → prioritySkillPaths（压过同名）；extension-path →\n\t// additionalExtensionPaths；其余 loadMethod 不挂（如实不装，不猜测）。\n\tconst loaderOptions: Record<string, unknown> = {};\n\tif (input.resourceCopyDir !== undefined) {\n\t\tif (input.loadMethod === \"skill-path\") {\n\t\t\tloaderOptions.prioritySkillPaths = [input.resourceCopyDir];\n\t\t} else if (input.loadMethod === \"extension-path\") {\n\t\t\tloaderOptions.additionalExtensionPaths = [input.resourceCopyDir];\n\t\t}\n\t}\n\t// 隔离：不带入用户/项目自动发现（隔离 home/agentDir 本身已空，再显式关掉\n\t// context/prompt/theme 发现，防止 cwd 内 AGENTS.md 等影响验证）。\n\tconst settingsManager = SettingsManager.create(input.cwd, input.agentDir);\n\tconst resourceLoader = new DefaultResourceLoader({\n\t\tcwd: input.cwd,\n\t\tagentDir: input.agentDir,\n\t\tsettingsManager,\n\t\tnoContextFiles: true,\n\t\tnoPromptTemplates: true,\n\t\tnoThemes: true,\n\t\t...loaderOptions,\n\t});\n\tawait resourceLoader.reload();\n\n\tconst sessionManager = SessionManager.create(input.cwd, input.sessionDir);\n\tconst modelRuntime =\n\t\toptions.modelRuntime ??\n\t\t(input.modelConfig?.modelRuntime !== undefined\n\t\t\t? input.modelConfig.modelRuntime\n\t\t\t: await ModelRuntime.create({\n\t\t\t\t\tauthPath: join(input.agentDir, \"auth.json\"),\n\t\t\t\t\tmodelsPath: join(input.agentDir, \"models.json\"),\n\t\t\t\t}));\n\n\t// 取消/超时合成：外部 signal 与 timeoutMs 任一先到即中止。\n\tconst timeoutSignal =\n\t\tinput.timeoutMs !== undefined && Number.isFinite(input.timeoutMs)\n\t\t\t? AbortSignal.timeout(input.timeoutMs)\n\t\t\t: undefined;\n\tconst signals = [input.signal, timeoutSignal].filter((s): s is AbortSignal => s !== undefined);\n\tconst runSignal = signals.length === 0 ? undefined : signals.length === 1 ? signals[0] : AbortSignal.any(signals);\n\n\t// 用例固定模型（modelConfig.model=\"provider/id\"）：冻结样例声明的模型优先，\n\t// 否则由 createAgentSession 走 findInitialModel（可用清单首个）。验证需要可\n\t// 复现——生产编排按档位写 modelConfig.model，测试经同一字段固定假模型。\n\tconst runtime = modelRuntime as { getModel?: (provider: string, modelId: string) => unknown };\n\tconst modelRef = typeof input.modelConfig?.model === \"string\" ? input.modelConfig.model : undefined;\n\tconst pinnedModel =\n\t\tmodelRef !== undefined && typeof runtime.getModel === \"function\"\n\t\t\t? (() => {\n\t\t\t\t\tconst slash = modelRef.indexOf(\"/\");\n\t\t\t\t\tif (slash <= 0) return undefined;\n\t\t\t\t\treturn runtime.getModel(modelRef.slice(0, slash), modelRef.slice(slash + 1));\n\t\t\t\t})()\n\t\t\t: undefined;\n\n\tconst { session } = await createAgentSession({\n\t\tcwd: input.cwd,\n\t\tagentDir: input.agentDir,\n\t\tmodelRuntime: modelRuntime as never,\n\t\tsessionManager,\n\t\tsettingsManager,\n\t\tresourceLoader,\n\t\ttools: toolset.allowed,\n\t\t...(pinnedModel !== undefined ? { model: pinnedModel as never } : {}),\n\t});\n\n\t// 信号触发 → abort + close，返回 abortReason。\n\tlet abortReason: string | undefined;\n\tconst onAbort = () => {\n\t\tif (abortReason !== undefined) return;\n\t\tabortReason =\n\t\t\trunSignal?.reason !== undefined\n\t\t\t\t? String(runSignal.reason)\n\t\t\t\t: timeoutSignal?.aborted\n\t\t\t\t\t? `timeout ${input.timeoutMs}ms`\n\t\t\t\t\t: \"aborted\";\n\t\tvoid session\n\t\t\t.abort()\n\t\t\t.catch(() => undefined)\n\t\t\t.finally(() => session.close().catch(() => undefined));\n\t};\n\trunSignal?.addEventListener(\"abort\", onAbort, { once: true });\n\tif (runSignal?.aborted) onAbort();\n\n\tlet output = \"\";\n\ttry {\n\t\tawait session.prompt(input.validationCase.input);\n\t\tawait session.waitForIdle();\n\t\toutput = session.getLastAssistantText() ?? \"\";\n\t} catch (error) {\n\t\tif (abortReason !== undefined || runSignal?.aborted) {\n\t\t\tabortReason ??= String(runSignal?.reason ?? \"aborted\");\n\t\t} else {\n\t\t\tthrow error;\n\t\t}\n\t} finally {\n\t\trunSignal?.removeEventListener(\"abort\", onAbort);\n\t\tawait session.close().catch(() => undefined);\n\t\tsession.dispose();\n\t}\n\n\tif (abortReason !== undefined) {\n\t\treturn { output, abortReason };\n\t}\n\n\tconst stats = session.getSessionStats();\n\treturn {\n\t\toutput,\n\t\tcompleted: true,\n\t\tusageRef: `session:${stats.sessionId}:tokens=${stats.tokens.total}`,\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化改进选择（S8-05）。\n * * - 不要求每问题都产补丁；没有「必须产补丁」的完成条件。\n */\n\nimport type { MemoryError,MemoryStoreMemoryResult } from \"../memory/types.tsstore.ts\";\nimport type { \nimport { getProblemRow, rowToProblem } from \"./problems.ts\";\nimport {\treturn parts.join(\"；\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":7}},{"diffOp":{"equal":{"range":[51,139]}}},{"diffOp":{"insert":{"range":[139,140]}}},{"diffOp":{"equal":{"range":[140,154]}}},{"diffOp":{"delete":{"range":[154,166]}}},{"diffOp":{"insert":{"range":[166,177]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"delete":{"range":[177,190]}}},{"diffOp":{"equal":{"range":[190,208]}}},{"diffOp":{"delete":{"range":[208,216]}}},{"diffOp":{"insert":{"range":[216,224]}}},{"diffOp":{"equal":{"range":[224,226]}}},{"diffOp":{"equal":{"range":[226,241]}}},{"diffOp":{"delete":{"range":[166,177]}}},{"diffOp":{"insert":{"range":[154,166]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"insert":{"range":[177,190]}}},{"diffOp":{"equal":{"range":[190,208]}}},{"diffOp":{"delete":{"range":[216,224]}}},{"diffOp":{"insert":{"range":[208,216]}}},{"diffOp":{"equal":{"range":[224,226]}}},{"diffOp":{"equal":{"range":[241,311]}}},{"equalLines":{"line_count":189}},{"diffOp":{"equal":{"range":[311,340]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\select.ts"},"span":[605,673],"sourceCode":"/**\n * 受控自进化改进选择（S8-05）。\n *\n * 职责：按已分类问题选择 modify/delete/merge/no_change/development_suggestion。\n *\n * 契约（S8 任务书 §5）：\n * - 核心问题（core_issue）→ development_suggestion，并输出具体文件/函数建议；\n *   结束自动路径。\n * - 未采用经验（unused_experience）→ 优先改检索/提示策略（memory-policy 资源）。\n * - 只有资源行为可改善才返回 modify 供 candidates 消费；no_change 是合法终态。\n * - 不要求每问题都产补丁；没有「必须产补丁」的完成条件。\n */\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getProblemRow, rowToProblem } from \"./problems.ts\";\nimport {\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 类型\n// ════════════════════════════════════════════════════════════════════════\n\n/** `selectImprovement` 的输入。 */\nexport interface SelectImprovementInput {\n\tproblemId: string;\n\t/** 选择时间（夹具注入）。 */\n\tselectedAt?: string;\n}\n\n/** `selectImprovement` 的输出。 */\nexport interface SelectImprovementResult {\n\tproblemId: string;\n\taction: EvolutionProblemAction;\n\t/** 处置结果（与 action 对应）。 */\n\tdisposition: EvolutionProblemDisposition;\n\t/** 选择理由。 */\n\treason: string;\n\t/** development_suggestion 时的具体建议（文件/函数）。 */\n\tsuggestion?: string;\n\t/** modify 时建议的目标资源与基础版本（供 candidates 消费）。 */\n\ttarget?: {\n\t\tresourceId: string;\n\t\tbaseVersion?: string;\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 内部\n// ════════════════════════════════════════════════════════════════════════\n//\n// O14：完整 Problem 行读取（getProblemRow/rowToProblem）统一由 problems.ts 导出，\n// 本模块只负责选择决策与状态提交；字段增补只改 problems.ts 一处。\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// selectImprovement\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按已分类问题选择改进动作。\n *\n * 选择规则：\n * - core_issue → development_suggestion（输出具体文件/函数建议，结束自动路径）。\n * - unused_experience → 优先改检索/提示策略（memory-policy 资源）；若问题已指向\n *   具体 memory-policy 资源则返回 modify，否则返回 development_suggestion（缺目标）。\n * - invocation / implementation_defect → 有 resourceId 时返回 modify；无目标返回\n *   no_change（无资源可改不强行产补丁）。\n * - 已终态（no_change/development_suggestion）返回原动作，不重复推进。\n */\nexport function selectImprovement(\n\tstore: MemoryStore,\n\tinput: SelectImprovementInput,\n): MemoryResult<SelectImprovementResult> {\n\tconst now = input.selectedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态直接返回原结果。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tproblemId: problem.problemId,\n\t\t\t\taction: problem.action ?? \"no_change\",\n\t\t\t\tdisposition: problem.disposition,\n\t\t\t\treason: problem.reason ?? \"问题已终态\",\n\t\t\t};\n\t\t}\n\n\t\t// 未分类问题先分类（防御：调用方应按顺序先 classify）。\n\t\tif (problem.status === \"observed\") {\n\t\t\treturn fail(\"invalid_input\", `问题尚未分类:${input.problemId}`, input.problemId);\n\t\t}\n\n\t\tlet action: EvolutionProblemAction;\n\t\tlet disposition: EvolutionProblemDisposition;\n\t\tlet reason: string;\n\t\tlet suggestion: string | undefined;\n\t\tlet target: SelectImprovementResult[\"target\"] | undefined;\n\n\t\tif (problem.action === \"delete\" || problem.action === \"merge\" || problem.action === \"no_change\") {\n\t\t\t// O10/E04：登记时声明的非 modify 动作（delete/merge/no_change）不被无条件\n\t\t\t// 改成 modify——这些动作不产生候选补丁，按终态语义收口并保留原动作；\n\t\t\t// 资源处置本身（删除/合并）走单独通道，不在自动候选链内完成。\n\t\t\taction = problem.action;\n\t\t\tdisposition = \"no_change\";\n\t\t\treason = `登记动作 ${problem.action} 不产生候选补丁，收口为 no_change（资源处置走单独通道）`;\n\t\t} else if (problem.kind === \"core_issue\") {\n\t\t\t// 核心缺口：转开发建议，结束自动路径。\n\t\t\taction = \"development_suggestion\";\n\t\t\tdisposition = \"development_suggestion\";\n\t\t\tsuggestion = buildDevelopmentSuggestion(problem);\n\t\t\treason = `核心问题转开发建议:${suggestion}`;\n\t\t} else if (problem.kind === \"unused_experience\") {\n\t\t\t// 未采用经验：优先改检索/提示策略。\n\t\t\tif (problem.resourceId !== undefined && problem.resourceId.startsWith(\"memory-policy:\")) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `未采用经验 ${problem.reason ?? \"\"}，改检索/提示策略(${problem.resourceId})`;\n\t\t\t} else {\n\t\t\t\taction = \"development_suggestion\";\n\t\t\t\tdisposition = \"development_suggestion\";\n\t\t\t\tsuggestion = `未采用经验 ${problem.reason ?? \"\"}，但问题未指向具体 memory-policy 资源；请确认检索/提示策略目标后登记 resourceId`;\n\t\t\t\treason = suggestion;\n\t\t\t}\n\t\t} else {\n\t\t\t// invocation / implementation_defect：有资源目标才 modify。\n\t\t\tif (problem.resourceId !== undefined) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `资源 ${problem.resourceId} 行为可改善，进入候选生成`;\n\t\t\t} else {\n\t\t\t\taction = \"no_change\";\n\t\t\t\tdisposition = \"no_change\";\n\t\t\t\treason = \"无明确资源目标，不强行产补丁（no_change 合法终态）\";\n\t\t\t}\n\t\t}\n\n\t\t// O10/E04：可改问题（disposition=candidate）状态保持 classified，只写\n\t\t// action/disposition——candidate 状态由 proposeCandidate 成功后推进；\n\t\t// 若 select 抢先把 status 写成 candidate，freezeValidationPlan（只收\n\t\t// classified）会拒绝，链路冻死在 select 与 freeze 之间。终态动作仍\n\t\t// 推进 status（no_change/development_suggestion）。\n\t\tconst nextStatus: EvolutionProblemStatus =\n\t\t\tdisposition === \"candidate\" ? \"classified\" : disposition === \"no_change\" ? \"no_change\" : \"development_suggestion\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET action = ?, disposition = ?, status = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(action, disposition, nextStatus, now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\taction,\n\t\t\tdisposition,\n\t\t\treason,\n\t\t\t...(suggestion === undefined ? {} : { suggestion }),\n\t\t\t...(target === undefined ? {} : { target }),\n\t\t};\n\t});\n}\n\n/** 给核心问题生成具体定位与建议（人读）：从问题的真实字段（资源/版本/证据/身份）解析位置，不只拼泛化禁止对象。 */\nfunction buildDevelopmentSuggestion(problem: EvolutionProblem): string {\n\tconst parts: string[] = [`核心问题:${problem.summary}`];\n\tif (problem.reason) parts.push(`原因:${problem.reason}`);\n\tparts.push(`预期:${problem.expectedBehavior}`);\n\tparts.push(`实际:${problem.actualBehavior}`);\n\t// 实际定位：登记时绑定的资源/版本/发生现场是排查入口（O10/E04——\n\t// 建议须带真实位置，不是只有泛化对象清单）。\n\tconst locations: string[] = [];\n\tif (problem.resourceId !== undefined) {\n\t\tlocations.push(`资源 ${problem.resourceId}${problem.baseVersion !== undefined ? `@${problem.baseVersion}` : \"\"}`);\n\t}\n\tconst identity = [\n\t\tproblem.projectId !== undefined ? `项目 ${problem.projectId}` : undefined,\n\t\tproblem.taskId !== undefined ? `任务 ${problem.taskId}` : undefined,\n\t\tproblem.sessionId !== undefined ? `会话 ${problem.sessionId}` : undefined,\n\t\tproblem.entryId !== undefined ? `条目 ${problem.entryId}` : undefined,\n\t\tproblem.toolCallId !== undefined ? `工具调用 ${problem.toolCallId}` : undefined,\n\t].filter((value): value is string => value !== undefined);\n\tif (identity.length > 0) locations.push(`发生现场:${identity.join(\" / \")}`);\n\tif (problem.evidenceRefs.length > 0) locations.push(`证据引用:${problem.evidenceRefs.join(\"、\")}`);\n\tif (locations.length > 0) parts.push(`定位:${locations.join(\"；\")}`);\n\t// 指向固定禁止对象清单中的相关位置（内核/表结构/权限/预算/加载机制）。\n\tparts.push(\"涉及固定禁止对象：内核源码 / memory.sqlite 表结构 / 权限角色门控 / 预算上限 / 资源加载与更新机制\");\n\treturn parts.join(\"；\");\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化改进选择（S8-05）。\n *\t\t// 推进 status（no_change/development_suggestion）。\n\t\tconst nextStatus: EvolutionProblemStatus =\n\t\t\tdisposition === \"candidate\" \n\t\t\t\t? \"classified\": disposition === \"no_change\"\n\t\t\t\t\t? \"no_change\": \"development_suggestion\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\treturn parts.join(\"；\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":151}},{"diffOp":{"equal":{"range":[51,186]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[187,192]}}},{"diffOp":{"equal":{"range":[192,206]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[187,192]}}},{"diffOp":{"equal":{"range":[206,235]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[235,241]}}},{"diffOp":{"equal":{"range":[241,254]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[235,241]}}},{"diffOp":{"equal":{"range":[254,460]}}},{"equalLines":{"line_count":46}},{"diffOp":{"equal":{"range":[460,489]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\select.ts"},"span":null,"sourceCode":"/**\n * 受控自进化改进选择（S8-05）。\n *\n * 职责：按已分类问题选择 modify/delete/merge/no_change/development_suggestion。\n *\n * 契约（S8 任务书 §5）：\n * - 核心问题（core_issue）→ development_suggestion，并输出具体文件/函数建议；\n *   结束自动路径。\n * - 未采用经验（unused_experience）→ 优先改检索/提示策略（memory-policy 资源）。\n * - 只有资源行为可改善才返回 modify 供 candidates 消费；no_change 是合法终态。\n * - 不要求每问题都产补丁；没有「必须产补丁」的完成条件。\n */\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getProblemRow, rowToProblem } from \"./problems.ts\";\nimport {\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 类型\n// ════════════════════════════════════════════════════════════════════════\n\n/** `selectImprovement` 的输入。 */\nexport interface SelectImprovementInput {\n\tproblemId: string;\n\t/** 选择时间（夹具注入）。 */\n\tselectedAt?: string;\n}\n\n/** `selectImprovement` 的输出。 */\nexport interface SelectImprovementResult {\n\tproblemId: string;\n\taction: EvolutionProblemAction;\n\t/** 处置结果（与 action 对应）。 */\n\tdisposition: EvolutionProblemDisposition;\n\t/** 选择理由。 */\n\treason: string;\n\t/** development_suggestion 时的具体建议（文件/函数）。 */\n\tsuggestion?: string;\n\t/** modify 时建议的目标资源与基础版本（供 candidates 消费）。 */\n\ttarget?: {\n\t\tresourceId: string;\n\t\tbaseVersion?: string;\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 内部\n// ════════════════════════════════════════════════════════════════════════\n//\n// O14：完整 Problem 行读取（getProblemRow/rowToProblem）统一由 problems.ts 导出，\n// 本模块只负责选择决策与状态提交；字段增补只改 problems.ts 一处。\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// selectImprovement\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按已分类问题选择改进动作。\n *\n * 选择规则：\n * - core_issue → development_suggestion（输出具体文件/函数建议，结束自动路径）。\n * - unused_experience → 优先改检索/提示策略（memory-policy 资源）；若问题已指向\n *   具体 memory-policy 资源则返回 modify，否则返回 development_suggestion（缺目标）。\n * - invocation / implementation_defect → 有 resourceId 时返回 modify；无目标返回\n *   no_change（无资源可改不强行产补丁）。\n * - 已终态（no_change/development_suggestion）返回原动作，不重复推进。\n */\nexport function selectImprovement(\n\tstore: MemoryStore,\n\tinput: SelectImprovementInput,\n): MemoryResult<SelectImprovementResult> {\n\tconst now = input.selectedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态直接返回原结果。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tproblemId: problem.problemId,\n\t\t\t\taction: problem.action ?? \"no_change\",\n\t\t\t\tdisposition: problem.disposition,\n\t\t\t\treason: problem.reason ?? \"问题已终态\",\n\t\t\t};\n\t\t}\n\n\t\t// 未分类问题先分类（防御：调用方应按顺序先 classify）。\n\t\tif (problem.status === \"observed\") {\n\t\t\treturn fail(\"invalid_input\", `问题尚未分类:${input.problemId}`, input.problemId);\n\t\t}\n\n\t\tlet action: EvolutionProblemAction;\n\t\tlet disposition: EvolutionProblemDisposition;\n\t\tlet reason: string;\n\t\tlet suggestion: string | undefined;\n\t\tlet target: SelectImprovementResult[\"target\"] | undefined;\n\n\t\tif (problem.action === \"delete\" || problem.action === \"merge\" || problem.action === \"no_change\") {\n\t\t\t// O10/E04：登记时声明的非 modify 动作（delete/merge/no_change）不被无条件\n\t\t\t// 改成 modify——这些动作不产生候选补丁，按终态语义收口并保留原动作；\n\t\t\t// 资源处置本身（删除/合并）走单独通道，不在自动候选链内完成。\n\t\t\taction = problem.action;\n\t\t\tdisposition = \"no_change\";\n\t\t\treason = `登记动作 ${problem.action} 不产生候选补丁，收口为 no_change（资源处置走单独通道）`;\n\t\t} else if (problem.kind === \"core_issue\") {\n\t\t\t// 核心缺口：转开发建议，结束自动路径。\n\t\t\taction = \"development_suggestion\";\n\t\t\tdisposition = \"development_suggestion\";\n\t\t\tsuggestion = buildDevelopmentSuggestion(problem);\n\t\t\treason = `核心问题转开发建议:${suggestion}`;\n\t\t} else if (problem.kind === \"unused_experience\") {\n\t\t\t// 未采用经验：优先改检索/提示策略。\n\t\t\tif (problem.resourceId !== undefined && problem.resourceId.startsWith(\"memory-policy:\")) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `未采用经验 ${problem.reason ?? \"\"}，改检索/提示策略(${problem.resourceId})`;\n\t\t\t} else {\n\t\t\t\taction = \"development_suggestion\";\n\t\t\t\tdisposition = \"development_suggestion\";\n\t\t\t\tsuggestion = `未采用经验 ${problem.reason ?? \"\"}，但问题未指向具体 memory-policy 资源；请确认检索/提示策略目标后登记 resourceId`;\n\t\t\t\treason = suggestion;\n\t\t\t}\n\t\t} else {\n\t\t\t// invocation / implementation_defect：有资源目标才 modify。\n\t\t\tif (problem.resourceId !== undefined) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `资源 ${problem.resourceId} 行为可改善，进入候选生成`;\n\t\t\t} else {\n\t\t\t\taction = \"no_change\";\n\t\t\t\tdisposition = \"no_change\";\n\t\t\t\treason = \"无明确资源目标，不强行产补丁（no_change 合法终态）\";\n\t\t\t}\n\t\t}\n\n\t\t// O10/E04：可改问题（disposition=candidate）状态保持 classified，只写\n\t\t// action/disposition——candidate 状态由 proposeCandidate 成功后推进；\n\t\t// 若 select 抢先把 status 写成 candidate，freezeValidationPlan（只收\n\t\t// classified）会拒绝，链路冻死在 select 与 freeze 之间。终态动作仍\n\t\t// 推进 status（no_change/development_suggestion）。\n\t\tconst nextStatus: EvolutionProblemStatus =\n\t\t\tdisposition === \"candidate\" ? \"classified\" : disposition === \"no_change\" ? \"no_change\" : \"development_suggestion\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET action = ?, disposition = ?, status = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(action, disposition, nextStatus, now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\taction,\n\t\t\tdisposition,\n\t\t\treason,\n\t\t\t...(suggestion === undefined ? {} : { suggestion }),\n\t\t\t...(target === undefined ? {} : { target }),\n\t\t};\n\t});\n}\n\n/** 给核心问题生成具体定位与建议（人读）：从问题的真实字段（资源/版本/证据/身份）解析位置，不只拼泛化禁止对象。 */\nfunction buildDevelopmentSuggestion(problem: EvolutionProblem): string {\n\tconst parts: string[] = [`核心问题:${problem.summary}`];\n\tif (problem.reason) parts.push(`原因:${problem.reason}`);\n\tparts.push(`预期:${problem.expectedBehavior}`);\n\tparts.push(`实际:${problem.actualBehavior}`);\n\t// 实际定位：登记时绑定的资源/版本/发生现场是排查入口（O10/E04——\n\t// 建议须带真实位置，不是只有泛化对象清单）。\n\tconst locations: string[] = [];\n\tif (problem.resourceId !== undefined) {\n\t\tlocations.push(`资源 ${problem.resourceId}${problem.baseVersion !== undefined ? `@${problem.baseVersion}` : \"\"}`);\n\t}\n\tconst identity = [\n\t\tproblem.projectId !== undefined ? `项目 ${problem.projectId}` : undefined,\n\t\tproblem.taskId !== undefined ? `任务 ${problem.taskId}` : undefined,\n\t\tproblem.sessionId !== undefined ? `会话 ${problem.sessionId}` : undefined,\n\t\tproblem.entryId !== undefined ? `条目 ${problem.entryId}` : undefined,\n\t\tproblem.toolCallId !== undefined ? `工具调用 ${problem.toolCallId}` : undefined,\n\t].filter((value): value is string => value !== undefined);\n\tif (identity.length > 0) locations.push(`发生现场:${identity.join(\" / \")}`);\n\tif (problem.evidenceRefs.length > 0) locations.push(`证据引用:${problem.evidenceRefs.join(\"、\")}`);\n\tif (locations.length > 0) parts.push(`定位:${locations.join(\"；\")}`);\n\t// 指向固定禁止对象清单中的相关位置（内核/表结构/权限/预算/加载机制）。\n\tparts.push(\"涉及固定禁止对象：内核源码 / memory.sqlite 表结构 / 权限角色门控 / 预算上限 / 资源加载与更新机制\");\n\treturn parts.join(\"；\");\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化契约类型（S8-01）。\n *\n/** 合法转移表。 */\nexport const EVOLUTION_CANDIDATE_TRANSITIONS: Record<\n\tEvolutionCandidateStatus, readonly EvolutionCandidateStatus[]> = {\n\tproposed: [\"testing\", \"cancelled\"],\n\ttesting: [\"passed\", \"failed\", \"cancelled\"],\treturn `${kind}:${name}`;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":217}},{"diffOp":{"equal":{"range":[51,131]}}},{"diffOp":{"delete":{"range":[131,133]}}},{"diffOp":{"equal":{"range":[133,158]}}},{"diffOp":{"delete":{"range":[131,133]}}},{"diffOp":{"insert":{"range":[158,159]}}},{"diffOp":{"equal":{"range":[159,194]}}},{"diffOp":{"delete":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[194,281]}}},{"equalLines":{"line_count":179}},{"diffOp":{"equal":{"range":[281,310]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\types.ts"},"span":null,"sourceCode":"/**\n * 受控自进化契约类型（S8-01）。\n *\n * 本模块只定义数据契约与状态机；业务拒绝沿用 `MemoryResult<T>` 判别联合\n * （见 ../memory/types.ts），底层故障直接 throw，不包装成业务错误。\n *\n * 契约锚点（S8 任务书 §5）：\n * - `passed ≠ active`：候选通过验证不等于已生效；发布/生效/绑定/回退全部留 S9。\n * - `occurrenceCount` 只由独立事实来源计算，不算摘要指纹。\n * - `testPlanId` 绑定 `baseVersion`：验收依据绑定到冻结时的基础版本。\n * - 资源登记不重复请求已授予的类别权限；越界候选一律拒绝并给理由。\n */\nimport type { MemoryResult } from \"../memory/types.ts\";\n\nexport type { MemoryResult };\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 资源（EvolutionResource）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 受控资源类别（C4 已授权范围）。 */\nexport const EVOLUTION_RESOURCE_KINDS = [\n\t/** PAO 自有技能：`pao配置/skills/<name>/` 下的 SKILL.md 正文、示例、局部步骤。 */\n\t\"skill\",\n\t/** 任务模板：出厂模板经 workflow/templates.ts 安装至现场的配方。 */\n\t\"template\",\n\t/** 自定义命令：`/pao` 子命令注册表内 PAO 自有命令。 */\n\t\"command\",\n\t/** 扩展工具：paoExtension 注册的 `pao_*` 工具实现。 */\n\t\"extension\",\n\t/** 记忆策略：`memory/` 内策略定义（检索参数/条件选择/提炼提示）。 */\n\t\"memory-policy\",\n\t/** 部门配方：`部门/<dept>/配方.md`。 */\n\t\"recipe\",\n] as const;\n\nexport type EvolutionResourceKind = (typeof EVOLUTION_RESOURCE_KINDS)[number];\n\n/** 资源允许的操作集（候选可执行的写入动作）。 */\nexport const EVOLUTION_RESOURCE_OPS = [\n\t/** 编辑既有文件正文（技能正文、模板正文、配方正文等）。 */\n\t\"edit-content\",\n\t/** 调整参数组织（命令参数、工具参数组织）。 */\n\t\"adjust-params\",\n\t/** 调整检索/提炼参数（memory-policy 专用）。 */\n\t\"adjust-policy\",\n] as const;\n\nexport type EvolutionResourceOp = (typeof EVOLUTION_RESOURCE_OPS)[number];\n\n/** 资源加载方式（由既有 resource-loader/装配层决定，候选不改加载机制本身）。 */\nexport const EVOLUTION_LOAD_METHODS = [\n\t/** 经 `additionalSkillPaths` 挂接的技能目录。 */\n\t\"skill-path\",\n\t/** 经 `additionalExtensionPaths` 挂接的扩展目录。 */\n\t\"extension-path\",\n\t/** 经模板安装目录加载的配方文件。 */\n\t\"template-file\",\n\t/** 经 `/pao` 子命令注册表注册的命令。 */\n\t\"command-registry\",\n\t/** 内核读取的受控策略资源（任务绑定版本）。 */\n\t\"policy-resource\",\n\t/** 部门配方文件。 */\n\t\"recipe-file\",\n] as const;\n\nexport type EvolutionLoadMethod = (typeof EVOLUTION_LOAD_METHODS)[number];\n\n/** 一个已登记的受控资源。 */\nexport interface EvolutionResource {\n\t/** 稳定资源 ID：`{kind}:{name}`（如 `skill:code-review`、`recipe:研发部`）。 */\n\tresourceId: string;\n\t/** 资源类别。 */\n\tkind: EvolutionResourceKind;\n\t/** 资源根相对路径（相对 PAO_HOME；POSIX 分隔符）。 */\n\trelativeRoot: string;\n\t/** 允许的操作集。 */\n\tallowedOps: EvolutionResourceOp[];\n\t/** 能力范围（哪些行为可改；如 \"正文/示例/局部步骤\"）。 */\n\tcapabilityScope: string[];\n\t/** 加载方式。 */\n\tloadMethod: EvolutionLoadMethod;\n\t/** 当前生效版本（S9 发布前只登记 baseVersion；effectiveVersion 由激活事务更新）。 */\n\teffectiveVersion?: string;\n\t/** 自动进化开关：false 时停止新候选领取，保留当前有效版。 */\n\tautoEvolutionEnabled: boolean;\n\t/** 登记时间。 */\n\tregisteredAt: string;\n\t/** 最后版本快照时间（snapshotResourceFiles 更新时刷新）。 */\n\tupdatedAt: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 问题（EvolutionProblem）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 问题类别：先查未采用经验，再查调用方式，最后才落到实现缺陷或核心问题。 */\nexport const EVOLUTION_PROBLEM_KINDS = [\n\t/** 已有经验未被召回/注入/采用（优先改检索/提示策略）。 */\n\t\"unused_experience\",\n\t/** 调用方式问题（参数误用、上下文组织错误）。 */\n\t\"invocation\",\n\t/** 资源实现缺陷（技能正文、模板、命令、工具实现的逻辑错误）。 */\n\t\"implementation_defect\",\n\t/** 核心问题（内核、表结构、权限、预算、加载机制等禁止对象）。 */\n\t\"core_issue\",\n] as const;\n\nexport type EvolutionProblemKind = (typeof EVOLUTION_PROBLEM_KINDS)[number];\n\n/** 问题处理动作（S8-05 `selectImprovement` 的选择）。 */\nexport const EVOLUTION_PROBLEM_ACTIONS = [\n\t/** 局部修改（生成候选）。 */\n\t\"modify\",\n\t/** 删除冗余资源/内容。 */\n\t\"delete\",\n\t/** 合并到既有资源/记忆。 */\n\t\"merge\",\n\t/** 无需改动（保留现状）。 */\n\t\"no_change\",\n\t/** 核心缺口转具体开发建议（结束自动路径）。 */\n\t\"development_suggestion\",\n] as const;\n\nexport type EvolutionProblemAction = (typeof EVOLUTION_PROBLEM_ACTIONS)[number];\n\n/** 问题状态机：observed → classified → candidate | no_change | development_suggestion。 */\nexport const EVOLUTION_PROBLEM_STATUSES = [\n\t/** 已登记，尚未分类。 */\n\t\"observed\",\n\t/** 已分类，等待选择处理动作。 */\n\t\"classified\",\n\t/** 已产生候选（进入验证）。 */\n\t\"candidate\",\n\t/** 判定无需改动（终态）。 */\n\t\"no_change\",\n\t/** 转开发建议（终态；核心缺口不自动改）。 */\n\t\"development_suggestion\",\n] as const;\n\nexport type EvolutionProblemStatus = (typeof EVOLUTION_PROBLEM_STATUSES)[number];\n\n/** 合法转移表：`from → 允许的 to 集合`。 */\nexport const EVOLUTION_PROBLEM_TRANSITIONS: Record<EvolutionProblemStatus, readonly EvolutionProblemStatus[]> = {\n\tobserved: [\"classified\", \"no_change\", \"development_suggestion\"],\n\t// classified→classified 自环：select 对可改问题只写 action/disposition、\n\t// 状态保持 classified（candidate 由 proposeCandidate 成功后推进——O10/E04\n\t// 顺序修正，select 不再抢先把 status 写成 candidate 堵住 freezeValidationPlan）。\n\tclassified: [\"classified\", \"candidate\", \"no_change\", \"development_suggestion\"],\n\tcandidate: [\"no_change\"],\n\tno_change: [],\n\tdevelopment_suggestion: [],\n};\n\n/** 问题处置（返回给调用方的结果形态）。 */\nexport type EvolutionProblemDisposition =\n\t| \"pending_classification\"\n\t| \"merged\"\n\t| \"candidate\"\n\t| \"no_change\"\n\t| \"development_suggestion\";\n\n/** 一个已登记的进化问题。 */\nexport interface EvolutionProblem {\n\tproblemId: string;\n\t/** 问题类别。 */\n\tkind: EvolutionProblemKind;\n\t/** 处理动作（分类后确定）。 */\n\taction?: EvolutionProblemAction;\n\t/** 一句话摘要（给界面/列表展示）。 */\n\tsummary: string;\n\t/** 发生原因（分类时填；模型推测标 model_inference）。 */\n\treason?: string;\n\t/** 预期行为。 */\n\texpectedBehavior: string;\n\t/** 实际行为（有真实回执时必填）。 */\n\tactualBehavior: string;\n\t/** 证据引用（sourceId / memoryId / revision / toolCallId / receiptRef）。 */\n\tevidenceRefs: string[];\n\t/** 独立事实来源计算的发生次数（模型单次申报不能标\"重复失败\"）。 */\n\toccurrenceCount: number;\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本（问题发生时的资源版本）。 */\n\tbaseVersion?: string;\n\t/** 宿主补的身份（不信模型自报）。 */\n\tprojectId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\tentryId?: string;\n\ttoolCallId?: string;\n\t/** 状态机当前位置。 */\n\tstatus: EvolutionProblemStatus;\n\t/** 处置结果（返回给 declareImprovementIntent 的调用方）。 */\n\tdisposition: EvolutionProblemDisposition;\n\t/** 登记时间。 */\n\tcreatedAt: string;\n\t/** 最后更新时间。 */\n\tupdatedAt: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 候选（EvolutionCandidate）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 候选状态机：proposed → testing → passed | failed | cancelled。 */\nexport const EVOLUTION_CANDIDATE_STATUSES = [\n\t/** 已生成差异，待验证。 */\n\t\"proposed\",\n\t/** 正在验证。 */\n\t\"testing\",\n\t/** 验证通过（不等于已生效；发布在 S9）。 */\n\t\"passed\",\n\t/** 验证失败。 */\n\t\"failed\",\n\t/** 已取消。 */\n\t\"cancelled\",\n] as const;\n\nexport type EvolutionCandidateStatus = (typeof EVOLUTION_CANDIDATE_STATUSES)[number];\n\n/** 合法转移表。 */\nexport const EVOLUTION_CANDIDATE_TRANSITIONS: Record<\n\tEvolutionCandidateStatus,\n\treadonly EvolutionCandidateStatus[]\n> = {\n\tproposed: [\"testing\", \"cancelled\"],\n\ttesting: [\"passed\", \"failed\", \"cancelled\"],\n\tpassed: [],\n\tfailed: [],\n\tcancelled: [],\n};\n\n/** 一份文件差异（候选相对 baseVersion 的实际改动）。 */\nexport interface EvolutionFileDiff {\n\t/** 资源根内相对路径（POSIX）。 */\n\tpath: string;\n\t/** 差异形态。 */\n\tkind: \"edit\" | \"create\" | \"delete\";\n\t/** unified diff 正文（编辑/删除时；新建文件可省略）。 */\n\tdiff?: string;\n\t/** 新文件完整正文（create 时）。 */\n\tnewContent?: string;\n}\n\n/** 一个进化候选（局部改动，未发布）。 */\nexport interface EvolutionCandidate {\n\tcandidateId: string;\n\tproblemId: string;\n\tresourceId: string;\n\t/** 生成候选时的基础版本（验证必须绑定同一 baseVersion）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID（验证前必须绑定）。 */\n\ttestPlanId: string;\n\t/** 文件差异清单。 */\n\tdiffs: EvolutionFileDiff[];\n\t/** 改动理由（模型给出的依据）。 */\n\trationale: string;\n\t/** 本次生成关联的账本/请求引用（usageRefs 贯穿记账）。 */\n\tusageRefs: string[];\n\t/** 状态机当前位置。 */\n\tstatus: EvolutionCandidateStatus;\n\t/** 验证失败/取消原因（状态为 failed/cancelled 时）。 */\n\tfailureReason?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 验证（EvolutionValidation / ValidationPlan / ValidationCaseResult）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 三组冻结样例。 */\nexport const EVOLUTION_SAMPLE_GROUPS = [\n\t/** 原问题复现组：先跑旧版必须真失败，否则回问题分类。 */\n\t\"reproduction\",\n\t/** 受影响正常用法组：候选不能破坏既有正常行为。 */\n\t\"normal\",\n\t/** 独立保留样例组：生成器读不到，只用于最终验收。 */\n\t\"holdout\",\n] as const;\n\nexport type EvolutionSampleGroup = (typeof EVOLUTION_SAMPLE_GROUPS)[number];\n\n/** 一个冻结验证用例。 */\nexport interface ValidationCase {\n\tcaseId: string;\n\t/** 所属样例组。 */\n\tgroup: EvolutionSampleGroup;\n\t/** 固定输入（可回放的初始状态/文件/参数）。 */\n\tinput: string;\n\t/** 初始文件清单（相对路径 → 内容或哈希）。 */\n\tinitialFiles: Record<string, string>;\n\t/** 允许工具清单。 */\n\tallowedTools: string[];\n\t/** 完成判据（如何算通过）。 */\n\tacceptance: string;\n\t/** 模型配置（档位/模型名）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** 冻结验收计划：绑定 baseVersion，三组样例一次冻结。 */\nexport interface ValidationPlan {\n\ttestPlanId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\t/** 原问题复现样例（至少一条；旧版必须先真失败）。 */\n\treproduction: ValidationCase[];\n\t/** 受影响正常用法样例。 */\n\tnormal: ValidationCase[];\n\t/** 独立保留样例（生成器不可见）。 */\n\tholdout: ValidationCase[];\n\tcreatedAt: string;\n}\n\n/** 一个用例的实际运行结果。 */\nexport interface ValidationRunResult {\n\t/** 是否通过判据。 */\n\tpassed: boolean;\n\t/** 输出摘要（截断后的 stdout/stderr）。 */\n\toutput?: string;\n\t/** 退出码（进程类验证）。 */\n\texitCode?: number;\n\t/** 实际文件变化（相对路径 → 新内容哈希或 diff）。 */\n\tfileChanges?: Record<string, string>;\n\t/** 模型用量引用（usageRef/requestId）。 */\n\tusageRef?: string;\n\t/**\n\t * 结构化执行失败（O11/E07）：进程/会话根本没跑成业务判据。\n\t * `start`=启动失败（命令不存在/进程没起来）、`timeout`=超时、\n\t * `cancel`=被取消。环境失败凭此字段判定（evaluate.isEnvironmentFailure），\n\t * 不再靠 output/exitCode 启发式；环境失败 → incomplete，不算业务失败。\n\t */\n\texecutionFailure?: \"start\" | \"timeout\" | \"cancel\";\n\t/** 运行失败原因（环境错误/启动失败/超时等）。 */\n\tfailureReason?: string;\n}\n\n/** 逐项判定结果。 */\nexport const EVOLUTION_CASE_VERDICTS = [\n\t/** 通过：候选修复了原问题且未破坏正常用法。 */\n\t\"passed\",\n\t/** 业务失败：输出/行为不符判据。 */\n\t\"failed\",\n\t/** 未完成：环境/启动/进程异常，无法得出业务结论。 */\n\t\"incomplete\",\n] as const;\n\nexport type EvolutionCaseVerdict = (typeof EVOLUTION_CASE_VERDICTS)[number];\n\n/** 一个用例的逐项评估结果。 */\nexport interface ValidationCaseResult {\n\tcaseId: string;\n\t/** 旧版运行结果（baseline 必须先跑）。 */\n\tbaseline: ValidationRunResult;\n\t/** 候选运行结果。 */\n\tcandidate: ValidationRunResult;\n\t/** 逐项判定。 */\n\tverdict: EvolutionCaseVerdict;\n\t/** 判定理由（incomplete 时必带原因）。 */\n\treason?: string;\n}\n\n/** 一次完整验证记录（baseline + candidate 同输入对照）。 */\nexport interface EvolutionValidation {\n\tvalidationId: string;\n\ttestPlanId: string;\n\tcandidateId: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\t/** 逐项结果（与 ValidationPlan 用例一一对应）。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 总体判定：全部关键项过才 passed；任一 incomplete 不标 passed。 */\n\tverdict: \"passed\" | \"failed\" | \"incomplete\";\n\t/** 总费用/用量引用。 */\n\ttotalUsageRef?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 辅助校验函数\n// ════════════════════════════════════════════════════════════════════════\n\n/** 检查问题状态转移是否合法。 */\nexport function isProblemTransitionAllowed(from: EvolutionProblemStatus, to: EvolutionProblemStatus): boolean {\n\treturn EVOLUTION_PROBLEM_TRANSITIONS[from].includes(to);\n}\n\n/** 检查候选状态转移是否合法。 */\nexport function isCandidateTransitionAllowed(from: EvolutionCandidateStatus, to: EvolutionCandidateStatus): boolean {\n\treturn EVOLUTION_CANDIDATE_TRANSITIONS[from].includes(to);\n}\n\n/** 解析 resourceId 为 `{kind, name}`；不合法返回 undefined。 */\nexport function parseResourceId(resourceId: string): { kind: EvolutionResourceKind; name: string } | undefined {\n\tconst idx = resourceId.indexOf(\":\");\n\tif (idx <= 0) return undefined;\n\tconst kind = resourceId.slice(0, idx);\n\tconst name = resourceId.slice(idx + 1);\n\tif (!name || !(EVOLUTION_RESOURCE_KINDS as readonly string[]).includes(kind)) return undefined;\n\treturn { kind: kind as EvolutionResourceKind, name };\n}\n\n/** 组装 resourceId（`{kind}:{name}`）。 */\nexport function formatResourceId(kind: EvolutionResourceKind, name: string): string {\n\treturn `${kind}:${name}`;\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化冻结验收（S8-06）。\n *import { createHash } from \"node:crypto\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tEVOLUTION_SAMPLE_GROUPS,\treturn { ok: true, testPlanId, plan, planPath };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[51,187]}}},{"diffOp":{"equal":{"range":[187,195]}}},{"diffOp":{"delete":{"range":[195,200]}}},{"diffOp":{"equal":{"range":[200,201]}}},{"diffOp":{"delete":{"range":[201,214]}}},{"diffOp":{"equal":{"range":[201,202]}}},{"diffOp":{"delete":{"range":[214,226]}}},{"diffOp":{"insert":{"range":[226,240]}}},{"diffOp":{"equal":{"range":[240,259]}}},{"diffOp":{"delete":{"range":[259,267]}}},{"diffOp":{"insert":{"range":[267,275]}}},{"diffOp":{"equal":{"range":[275,277]}}},{"diffOp":{"equal":{"range":[277,332]}}},{"diffOp":{"equal":{"range":[277,285]}}},{"diffOp":{"insert":{"range":[195,200]}}},{"diffOp":{"equal":{"range":[332,334]}}},{"diffOp":{"delete":{"range":[226,240]}}},{"diffOp":{"insert":{"range":[334,359]}}},{"diffOp":{"equal":{"range":[240,259]}}},{"diffOp":{"delete":{"range":[267,275]}}},{"diffOp":{"insert":{"range":[259,267]}}},{"diffOp":{"equal":{"range":[275,277]}}},{"diffOp":{"equal":{"range":[359,394]}}},{"equalLines":{"line_count":219}},{"diffOp":{"equal":{"range":[394,446]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\validation.ts"},"span":[885,926],"sourceCode":"/**\n * 受控自进化冻结验收（S8-06）。\n *\n * 职责：从已分类 problem + baseVersion 生成三组冻结样例，testPlanId 绑定 baseVersion，\n * 验收依据存核心管理位置（evolution_validations 行 + `<home>/evolution/` 受管区），\n * 不在候选可写目录。测试命令由核心定义。\n *\n * 契约（S8 任务书 §5）：\n * - `reproduction`：原问题复现（至少一条；先跑旧版必须真失败，复现不了回问题分类，\n *   不继续制造改进）。\n * - `normal`：受影响正常用法。\n * - `holdout`：独立保留样例（候选生成器读不到其内容）。\n * - 每项固定 input、initialFiles、allowedTools、acceptance、modelConfig。\n * - testPlanId 绑定 baseVersion；验收依据不入候选可写目录；测试命令由核心定义。\n * - `passed ≠ active`：本阶段不发布正式资源。\n */\nimport { createHash } from \"node:crypto\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_SAMPLE_GROUPS,\n\ttype EvolutionSampleGroup,\n\ttype ValidationCase,\n\ttype ValidationPlan,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 单个冻结样例的输入（调用方组装，不含 caseId）。 */\nexport interface FreezeCaseInput {\n\t/** 固定输入（可回放的初始状态/文件/参数）。 */\n\tinput: string;\n\t/** 初始文件清单（相对路径 → 内容）。 */\n\tinitialFiles: Record<string, string>;\n\t/** 允许工具清单。 */\n\tallowedTools: string[];\n\t/** 完成判据（如何算通过）。 */\n\tacceptance: string;\n\t/** 模型配置（档位/模型名等）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** `freezeValidationPlan` 的输入。 */\nexport interface FreezeValidationPlanInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 冻结时的基础版本。 */\n\tbaseVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 原问题复现样例（至少一条）。 */\n\treproduction: FreezeCaseInput[];\n\t/** 受影响正常用法样例。 */\n\tnormal: FreezeCaseInput[];\n\t/** 独立保留样例（生成器不可见）。 */\n\tholdout: FreezeCaseInput[];\n\t/** 冻结时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 来源引用（写入 evolution_source_links）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `freezeValidationPlan` 的成功输出。 */\nexport interface FreezeValidationPlanResult {\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 完整计划（含三组样例）。 */\n\tplan: ValidationPlan;\n\t/** 落盘的 plan.json 路径。 */\n\tplanPath: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 生成 testPlanId：`tp-{resourceId}-{baseVersion}-{hash}`，保证同 resource+base 幂等。 */\nfunction makeTestPlanId(resourceId: string, baseVersion: string, cases: ValidationCase[]): string {\n\tconst fingerprint = testPlanCaseFingerprint(cases);\n\treturn `tp-${resourceId.replace(/:/g, \"_\")}-${baseVersion}-${fingerprint}`;\n}\n\n/**\n * 用例集合指纹（O11/E08 共用）：plan.json 内容被篡改时重算值与\n * testPlanId 尾段对不上——publish 门据此做实质篡改核对（快照自比只\n * 能证明「此刻可读」）。\n */\nexport function testPlanCaseFingerprint(cases: ValidationCase[]): string {\n\treturn createHash(\"sha256\")\n\t\t.update(\n\t\t\tJSON.stringify(\n\t\t\t\tcases.map((c) => [c.group, c.input, c.initialFiles, c.allowedTools, c.acceptance, c.modelConfig]),\n\t\t\t),\n\t\t)\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n}\n\n/** 把 FreezeCaseInput 展开为带 caseId 的 ValidationCase。 */\nfunction expandCases(group: EvolutionSampleGroup, inputs: FreezeCaseInput[]): ValidationCase[] {\n\treturn inputs.map((input, index) => ({\n\t\tcaseId: `${group}-${index}`,\n\t\tgroup,\n\t\tinput: input.input,\n\t\tinitialFiles: input.initialFiles,\n\t\tallowedTools: input.allowedTools,\n\t\tacceptance: input.acceptance,\n\t\t...(input.modelConfig !== undefined ? { modelConfig: input.modelConfig } : {}),\n\t}));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. freezeValidationPlan\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 冻结验收计划：三组样例一次冻结，testPlanId 绑定 baseVersion。\n *\n * 验收依据存核心管理位置：\n * - evolution_validations 行（verdict 先占位 \"incomplete\"）。\n * - `<home>/evolution/validations/<testPlanId>/plan.json`。\n * 不在候选可写目录（candidates/ 下无写入口）。\n *\n * reproduction 组至少一条；旧版必须先真失败（由调用方在 freeze 前跑 baseline 验证，\n * 复现不了回问题分类，不继续制造改进）。\n */\nexport function freezeValidationPlan(\n\tstore: MemoryStore,\n\tinput: FreezeValidationPlanInput,\n): MemoryResult<FreezeValidationPlanResult> {\n\t// 校验：problem 必须已分类（classified），目标资源已登记。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, resource_id, base_version\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| { problem_id: string; status: string; resource_id: string | null; base_version: string | null }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\tif (problemRow.status !== \"classified\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 才能冻结验收`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 登记的资源 ${problemRow.resource_id ?? \"无\"} 与输入 ${input.resourceId} 不一致`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst resolvedBase = input.baseVersion ?? problemRow.base_version;\n\tif (!resolvedBase) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 未绑定 baseVersion，无法冻结验收`, input.problemId);\n\t}\n\n\t// 三组样例展开。\n\tconst reproduction = expandCases(\"reproduction\", input.reproduction);\n\tconst normal = expandCases(\"normal\", input.normal);\n\tconst holdout = expandCases(\"holdout\", input.holdout);\n\tif (reproduction.length === 0) {\n\t\treturn fail(\"invalid_input\", \"原问题复现样例至少一条\", input.problemId);\n\t}\n\tconst allCases = [...reproduction, ...normal, ...holdout];\n\tconst testPlanId = makeTestPlanId(input.resourceId, resolvedBase, allCases);\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst plan: ValidationPlan = {\n\t\ttestPlanId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: resolvedBase,\n\t\treproduction,\n\t\tnormal,\n\t\tholdout,\n\t\tcreatedAt: now,\n\t};\n\n\t// 验收依据落盘：核心管理位置，不在候选可写目录。\n\tconst planDir = join(evolutionPaths(input.paoHome).validations, testPlanId);\n\tmkdirSync(planDir, { recursive: true });\n\tconst planPath = join(planDir, \"plan.json\");\n\twriteFileSync(planPath, JSON.stringify(plan, null, 2), \"utf8\");\n\n\t// 验收依据存核心管理位置：\n\t// - plan.json 落盘（<home>/evolution/validations/<testPlanId>/）。\n\t// - evolution_validations 行由 evaluateCandidate 在运行时创建（外键约束要求\n\t//   candidate_id 已存在，freeze 阶段尚无候选，故不在此写行）。\n\t// - evolution_source_links 以 owner_kind=\"validation\"、owner_id=testPlanId 写入，\n\t//   供来源删除时沿关联清理。\n\t// O12/E11：sourceRefs 未传时自动继承 problem 已登记的 links（内核内部默认\n\t// 继承，不依赖编排层重复传参）；显式传入时以传入为准。\n\tconst sourceRefs =\n\t\tinput.sourceRefs ??\n\t\t(store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>).map((link) => ({\n\t\t\tsourceId: link.source_id,\n\t\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t\t}));\n\tstore.transaction(() => {\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VA