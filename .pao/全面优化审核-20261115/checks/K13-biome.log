0,552]}}},{"diffOp":{"delete":{"range":[470,476]}}},{"diffOp":{"insert":{"range":[395,401]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[483,497]}}},{"diffOp":{"insert":{"range":[519,525]}}},{"diffOp":{"equal":{"range":[430,432]}}},{"diffOp":{"equal":{"range":[432,442]}}},{"diffOp":{"delete":{"range":[359,383]}}},{"diffOp":{"insert":{"range":[533,540]}}},{"diffOp":{"equal":{"range":[540,552]}}},{"diffOp":{"delete":{"range":[401,410]}}},{"diffOp":{"insert":{"range":[395,401]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[419,430]}}},{"diffOp":{"insert":{"range":[559,570]}}},{"diffOp":{"equal":{"range":[430,432]}}},{"diffOp":{"equal":{"range":[570,631]}}},{"equalLines":{"line_count":228}},{"diffOp":{"equal":{"range":[631,636]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\friction\\drafts.ts"},"span":[1486,1548],"sourceCode":"/**\n * 摩擦日志自动草稿（M0-08）：打回／重试到顶／升级人／扇出取消四事件发生时，\n * 机械往 $PAO_HOME/.pao/摩擦草稿.md 追加事实；正式摩擦日志由开发项目维护。\n *\n * 规格出处：pao 仓库根 摩擦日志.md 头部「自动草稿机制」段（M0-08 定案）。\n * 分工：机器只灌事实，人补一句「为什么难受」后把行移进正式区（转正）。\n *\n * 机制要点：\n * - 去重：同「卡目录＋卡号＋场景」累计次数，不合并不同项目的同号卡；\n * - 周清：每次追加时顺带清掉「最后更新时间超过 7 天」的草稿行（惰性 GC，不建定时器——纪律 R05 不做常驻）；\n *   转正＝人把行从草稿区剪走，留在草稿区即视为未转正；\n * - 并发安全：跨进程文件锁（shared/lock.ts）内完成读改写，写盘走原子写（shared/atomic.ts）；\n *   同进程多次追加经模块级写队列串行，避免锁内自旋；\n * - 文件缺失：只创建「# 摩擦日志」＋「## 草稿区」两级骨架（正文本体归外层仓库管）；\n *   草稿区标题缺失则在文件尾补标题（本文件约定草稿区为最后一段）；\n * - 只认机器格式的行做去重/周清，人手写或改写过的其他行原样保留。\n *\n * 草稿行格式（单行，字段用「 | 」分隔）：\n *   - [草稿] 2026-10-02 14:30 | 打回 | 卡0001 | ×1 | 机械校验拒绝：部门「X」不在注册表\n */\nimport { existsSync, mkdirSync, readFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\n\nimport { writeFileAtomic } from \"../shared/atomic.ts\";\nimport { withFileLock } from \"../shared/lock.ts\";\nimport { logWarn } from \"../shared/log.ts\";\nimport { pathKey } from \"../shared/path-key.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport { enqueueEvolveJob } from \"../memory/maintenance.ts\";\nimport { declareImprovementIntent } from \"../evolution/problems.ts\";\n\n/** 四类摩擦场景（与 M0-08 定案一一对应） */\nexport const FRICTION_SCENARIOS = [\"打回\", \"重试到顶\", \"升级人\", \"扇出取消\"] as const;\nexport type FrictionScenario = (typeof FRICTION_SCENARIOS)[number];\n\n/** 一条草稿的机器可见事实 */\nexport interface FrictionDraftEntry {\n\t场景: FrictionScenario;\n\t/** 卡号（格式化引用，如 卡0001）；无卡号事件传「无」 */\n\t卡号: string;\n\t/** 事件所属卡目录，用完整路径区分不同项目的同号卡。 */\n\t卡目录?: string;\n\t/** 一句话机器可见事实（多行会被压成单行） */\n\t事实: string;\n}\n\nexport interface FrictionDraftOptions {\n\t/** 时间源（测试注入）；缺省 new Date() */\n\t时间?: () => Date;\n}\n\n/** 运行时只记录草稿；正式日志仍在开发项目，不在使用现场另造一份。 */\nexport function frictionLogPath(home: string): string {\n\treturn join(home, \".pao\", \"摩擦草稿.md\");\n}\n\n/** 文件不存在时创建的最小骨架：只有两级标题，正式区内容归外层仓库维护 */\nconst SKELETON = \"# 摩擦日志\\n\\n## 草稿区\";\n\n/** 草稿行解析；不匹配机器格式的行（占位文字、人补记行）返回 undefined，原样保留 */\nconst DRAFT_LINE_RE =\n\t/^- \\[草稿\\] (\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}) \\| ([^|]+?) \\| ([^|]+?) \\| ×(\\d+) \\| (.*?)(?: \\| 卡目录=(.*))?$/;\n\ninterface ParsedDraftLine {\n\t/** 最后更新时间（YYYY-MM-DD HH:mm，即行首时间戳；去重命中时刷新） */\n\t时间: string;\n\t场景: string;\n\t卡号: string;\n\t次数: number;\n\t事实: string;\n\t卡目录?: string;\n}\n\n/** 事实压成单行并限长，避免一条草稿占多行破坏「一行一事」 */\nfunction sanitizeFact(fact: string): string {\n\tconst oneLine = fact.replace(/\\s*\\r?\\n\\s*/g, \" \").trim();\n\treturn oneLine.length > 160 ? `${oneLine.slice(0, 160)}…` : oneLine;\n}\n\nfunction renderDraftLine(\n\tscenario: string,\n\tcardNo: string,\n\tfact: string,\n\ttimes: number,\n\ttime: string,\n\tcardDir?: string,\n): string {\n\treturn `- [草稿] ${time} | ${scenario} | ${cardNo} | ×${times} | ${sanitizeFact(fact)}${cardDir ? ` | 卡目录=${cardDir}` : \"\"}`;\n}\n\nfunction parseDraftLine(line: string): ParsedDraftLine | undefined {\n\tconst match = DRAFT_LINE_RE.exec(line.trim());\n\tif (!match) return undefined;\n\treturn { 时间: match[1], 场景: match[2], 卡号: match[3], 次数: Number(match[4]), 事实: match[5], 卡目录: match[6] };\n}\n\n/** \"YYYY-MM-DD HH:mm\" → 本地时区 Date（解析失败返回 undefined，按不清理处理） */\nfunction parseTimestamp(text: string): Date | undefined {\n\tconst match = /^(\\d{4})-(\\d{2})-(\\d{2}) (\\d{2}):(\\d{2})$/.exec(text);\n\tif (!match) return undefined;\n\tconst [, y, m, d, h, min] = match;\n\treturn new Date(Number(y), Number(m) - 1, Number(d), Number(h), Number(min));\n}\n\n/** 周清阈值：最后更新时间超过 7 天的草稿行清掉 */\nconst GC_AGE_MS = 7 * 24 * 60 * 60 * 1000;\n\n/** 同进程追加串行队列：同步挂钩点（状态机）只能尾随写入，队列避免两次追加并发进锁 */\nlet writeQueue: Promise<void> = Promise.resolve();\n\n/**\n * 追加一条摩擦草稿（整个读改写在跨进程文件锁内完成，含去重与惰性周清）。\n * 摩擦日志目录不存在时随原子写自动建目录；文件不存在时先落两级骨架。\n */\nexport function appendFrictionDraft(\n\thome: string,\n\tentry: FrictionDraftEntry,\n\toptions?: FrictionDraftOptions,\n): Promise<void> {\n\tconst run = writeQueue.then(() => appendOnce(home, entry, options));\n\t// 队列吞掉失败：后续追加不被前一次失败卡死\n\twriteQueue = run.then(\n\t\t() => undefined,\n\t\t() => undefined,\n\t);\n\treturn run;\n}\n\n/** 等待本进程内排队的草稿写入全部落盘（同步挂钩点的尾随写入靠它等齐；测试用，生产无须调用） */\nexport function drainFrictionDraftWrites(): Promise<void> {\n\treturn writeQueue;\n}\n\nasync function appendOnce(home: string, entry: FrictionDraftEntry, options?: FrictionDraftOptions): Promise<void> {\n\tconst logPath = frictionLogPath(home);\n\tmkdirSync(dirname(logPath), { recursive: true });\n\tconst now = (options?.时间 ?? (() => new Date()))();\n\tconst timeText = formatTimestamp(now);\n\tconst dir = entry.卡目录 ? resolve(entry.卡目录).replaceAll(\"\\\\\", \"/\") : undefined;\n\t// 日志里存的是换正斜杠的键（冻结存储形状），只借 pathKey 折叠大小写，不改存储格式\n\tconst cardDir = dir !== undefined ? pathKey(dir) : undefined;\n\tawait withFileLock(logPath, () => {\n\t\tconst content = existsSync(logPath) ? readFileSync(logPath, \"utf8\") : SKELETON;\n\t\tconst lines = content.split(/\\r?\\n/);\n\t\tconst key = `${cardDir ?? \"\"}|${entry.场景}|${entry.卡号}`;\n\t\tconst kept: string[] = [];\n\t\tlet deduped = false;\n\t\tfor (const line of lines) {\n\t\t\tconst parsed = parseDraftLine(line);\n\t\t\tif (!parsed) {\n\t\t\t\tkept.push(line); // 非机器格式行（标题、占位文字、人改过的行）原样保留\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 周清：最后更新时间超过 7 天的草稿行直接丢弃\n\t\t\tconst last = parseTimestamp(parsed.时间);\n\t\t\tif (last !== undefined && now.getTime() - last.getTime() > GC_AGE_MS) continue;\n\t\t\t// 去重：同卡同场景只累计次数、刷新时间戳（事实保留首次记录）\n\t\t\tif (!deduped && `${parsed.卡目录 ?? \"\"}|${parsed.场景}|${parsed.卡号}` === key) {\n\t\t\t\tdeduped = true;\n\t\t\t\tkept.push(renderDraftLine(parsed.场景, parsed.卡号, parsed.事实, parsed.次数 + 1, timeText, cardDir));\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tkept.push(line);\n\t\t}\n\t\tif (!deduped) {\n\t\t\t// 收掉文件尾空行；草稿区标题缺失则补（约定草稿区为最后一段）\n\t\t\twhile (kept.length > 0 && kept[kept.length - 1].trim() === \"\") kept.pop();\n\t\t\tif (!kept.some((line) => /^##\\s*草稿区\\s*$/.test(line))) kept.push(\"\", \"## 草稿区\");\n\t\t\tkept.push(renderDraftLine(entry.场景, entry.卡号, entry.事实, 1, timeText, cardDir));\n\t\t}\n\t\twriteFileAtomic(logPath, `${kept.join(\"\\n\")}\\n`);\n\t});\n}\n\nexport function formatTimestamp(date: Date): string {\n\tconst pad = (n: number): string => String(n).padStart(2, \"0\");\n\treturn `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;\n}\n\n/** recordFrictionDraft 的可选身份（宿主沿调用链下传；不在本模块猜全局会话）。 */\nexport interface FrictionEventIdentity {\n\t/** 单次事件唯一身份（toolCallId/entryId/随机 UUID）；同一事件重报必须同值才幂等。 */\n\teventId?: string;\n\tprojectId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\tentryId?: string;\n\ttoolCallId?: string;\n}\n\n/**\n * 事件挂钩入口（各事件落定处调用）：解析 PAO_HOME 并追加草稿，任何失败只警告不抛——\n * 草稿记不上不能影响主流程。PAO_HOME 未配置＝摩擦日志机制未启用，静默跳过（对齐\n * index.ts「配置缺失＝未用此功能」的口径，也避免无 pao 环境的测试刷警告）。\n *\n * 同步代码路径（如状态机）用 `void recordFrictionDraft(...)` 尾随调用，落盘时序由\n * 模块级写队列保证；测试等齐用 drainFrictionDraftWrites()。\n *\n * O10/E02：调用方经 identity 传真实会话身份与事件唯一 ID——同一事件重报\n * 复用同 eventId（幂等，不重复累计 occurrence_count）；新事件用新值。\n */\nexport async function recordFrictionDraft(\n\tscenario: FrictionScenario,\n\tcardNo: string,\n\tfact: string,\n\tcardDir?: string,\n\tidentity?: FrictionEventIdentity,\n): Promise<void> {\n\ttry {\n\t\tconst home = process.env.PAO_HOME?.trim();\n\t\tif (!home) return;\n\t\tawait appendFrictionDraft(home, { 场景: scenario, 卡号: cardNo, 事实: fact, 卡目录: cardDir });\n\t\t// S8-03：同一调用点把四类失败事实登记到受控自进化问题库。\n\t\t// 以稳定来源引用关联（friction 草稿行位置/卡号/场景作为 evidenceRef），\n\t\t// 保留原 Markdown 记录用途，不定期解析 Markdown 生成另一份计数。\n\t\t// 失败只警告不抛，不阻塞主流程。\n\t\ttry {\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\t// 稳定证据引用：场景|卡号|卡目录|事件唯一身份。\n\t\t\t\t// eventId 是单次事件的唯一值——同一事件重报同值命中去重；\n\t\t\t\t// 未传时退化为草稿行键（同卡同场景重报合并计数）。\n\t\t\t\tconst evidenceRef = `friction:${scenario}:${cardNo}:${cardDir ? pathKey(resolve(cardDir).replaceAll(\"\\\\\", \"/\")) : \"\"}${identity?.eventId !== undefined ? `:${identity.eventId}` : \"\"}`;\n\t\t\t\tconst declared = declareImprovementIntent(store, {\n\t\t\t\t\tkind: \"implementation_defect\",\n\t\t\t\t\tsummary: `摩擦事件:${scenario}`,\n\t\t\t\t\texpectedBehavior: \"主流程正常完成\",\n\t\t\t\t\tactualBehavior: fact,\n\t\t\t\t\tevidenceRefs: [evidenceRef],\n\t\t\t\t\toccurrenceCount: 1,\n\t\t\t\t\t...(identity?.projectId === undefined ? {} : { projectId: identity.projectId }),\n\t\t\t\t\t...(identity?.taskId === undefined ? {} : { taskId: identity.taskId }),\n\t\t\t\t\t...(identity?.sessionId === undefined ? {} : { sessionId: identity.sessionId }),\n\t\t\t\t\t...(identity?.entryId === undefined ? {} : { entryId: identity.entryId }),\n\t\t\t\t\t...(identity?.toolCallId === undefined ? {} : { toolCallId: identity.toolCallId }),\n\t\t\t\t});\n\t\t\t\t// O10/E01：登记受理后按项目 enqueue evolve 作业（scopeKey 幂等；\n\t\t\t\t// 本路径无宿主 ctx——enqueueEvolveJob 落持久 pending 后尽量唤醒\n\t\t\t\t// 该 home 的空闲 drain，没有调度器在听则等下一次 settled/recover）。\n\t\t\t\tif (declared.ok && declared.accepted && identity?.projectId !== undefined) {\n\t\t\t\t\ttry {\n\t\t\t\t\t\tenqueueEvolveJob(store, {\n\t\t\t\t\t\t\tpaoHome: home,\n\t\t\t\t\t\t\tprojectId: identity.projectId,\n\t\t\t\t\t\t\tnow: new Date().toISOString(),\n\t\t\t\t\t\t});\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tlogWarn(\n\t\t\t\t\t\t\t`[摩擦日志] 进化作业登记失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tlogWarn(`[摩擦日志] 进化问题登记失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`);\n\t\t}\n\t} catch (error) {\n\t\tlogWarn(`[摩擦日志] 草稿记录失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`);\n\t}\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 摩擦日志自动草稿（M0-08）：打回／重试到顶／升级人／扇出取消四事件发生时，\n * 机械往 $PAO_HOME/.pao/摩擦草稿.md 追加事实；正式摩擦日志由开发项目维护。\t\t\t}\n\t\t} catch (error) {\n\t\t\tlogWarn(\n\t\t\t\t`[摩擦日志] 进化问题登记失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t);\n\t\t}\n\t} catch (error) {\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,216]}}},{"equalLines":{"line_count":251}},{"diffOp":{"equal":{"range":[216,252]}}},{"diffOp":{"insert":{"range":[252,257]}}},{"diffOp":{"equal":{"range":[257,380]}}},{"diffOp":{"insert":{"range":[380,385]}}},{"diffOp":{"equal":{"range":[385,410]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[410,415]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\friction\\drafts.ts"},"span":null,"sourceCode":"/**\n * 摩擦日志自动草稿（M0-08）：打回／重试到顶／升级人／扇出取消四事件发生时，\n * 机械往 $PAO_HOME/.pao/摩擦草稿.md 追加事实；正式摩擦日志由开发项目维护。\n *\n * 规格出处：pao 仓库根 摩擦日志.md 头部「自动草稿机制」段（M0-08 定案）。\n * 分工：机器只灌事实，人补一句「为什么难受」后把行移进正式区（转正）。\n *\n * 机制要点：\n * - 去重：同「卡目录＋卡号＋场景」累计次数，不合并不同项目的同号卡；\n * - 周清：每次追加时顺带清掉「最后更新时间超过 7 天」的草稿行（惰性 GC，不建定时器——纪律 R05 不做常驻）；\n *   转正＝人把行从草稿区剪走，留在草稿区即视为未转正；\n * - 并发安全：跨进程文件锁（shared/lock.ts）内完成读改写，写盘走原子写（shared/atomic.ts）；\n *   同进程多次追加经模块级写队列串行，避免锁内自旋；\n * - 文件缺失：只创建「# 摩擦日志」＋「## 草稿区」两级骨架（正文本体归外层仓库管）；\n *   草稿区标题缺失则在文件尾补标题（本文件约定草稿区为最后一段）；\n * - 只认机器格式的行做去重/周清，人手写或改写过的其他行原样保留。\n *\n * 草稿行格式（单行，字段用「 | 」分隔）：\n *   - [草稿] 2026-10-02 14:30 | 打回 | 卡0001 | ×1 | 机械校验拒绝：部门「X」不在注册表\n */\nimport { existsSync, mkdirSync, readFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\n\nimport { writeFileAtomic } from \"../shared/atomic.ts\";\nimport { withFileLock } from \"../shared/lock.ts\";\nimport { logWarn } from \"../shared/log.ts\";\nimport { pathKey } from \"../shared/path-key.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport { enqueueEvolveJob } from \"../memory/maintenance.ts\";\nimport { declareImprovementIntent } from \"../evolution/problems.ts\";\n\n/** 四类摩擦场景（与 M0-08 定案一一对应） */\nexport const FRICTION_SCENARIOS = [\"打回\", \"重试到顶\", \"升级人\", \"扇出取消\"] as const;\nexport type FrictionScenario = (typeof FRICTION_SCENARIOS)[number];\n\n/** 一条草稿的机器可见事实 */\nexport interface FrictionDraftEntry {\n\t场景: FrictionScenario;\n\t/** 卡号（格式化引用，如 卡0001）；无卡号事件传「无」 */\n\t卡号: string;\n\t/** 事件所属卡目录，用完整路径区分不同项目的同号卡。 */\n\t卡目录?: string;\n\t/** 一句话机器可见事实（多行会被压成单行） */\n\t事实: string;\n}\n\nexport interface FrictionDraftOptions {\n\t/** 时间源（测试注入）；缺省 new Date() */\n\t时间?: () => Date;\n}\n\n/** 运行时只记录草稿；正式日志仍在开发项目，不在使用现场另造一份。 */\nexport function frictionLogPath(home: string): string {\n\treturn join(home, \".pao\", \"摩擦草稿.md\");\n}\n\n/** 文件不存在时创建的最小骨架：只有两级标题，正式区内容归外层仓库维护 */\nconst SKELETON = \"# 摩擦日志\\n\\n## 草稿区\";\n\n/** 草稿行解析；不匹配机器格式的行（占位文字、人补记行）返回 undefined，原样保留 */\nconst DRAFT_LINE_RE =\n\t/^- \\[草稿\\] (\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}) \\| ([^|]+?) \\| ([^|]+?) \\| ×(\\d+) \\| (.*?)(?: \\| 卡目录=(.*))?$/;\n\ninterface ParsedDraftLine {\n\t/** 最后更新时间（YYYY-MM-DD HH:mm，即行首时间戳；去重命中时刷新） */\n\t时间: string;\n\t场景: string;\n\t卡号: string;\n\t次数: number;\n\t事实: string;\n\t卡目录?: string;\n}\n\n/** 事实压成单行并限长，避免一条草稿占多行破坏「一行一事」 */\nfunction sanitizeFact(fact: string): string {\n\tconst oneLine = fact.replace(/\\s*\\r?\\n\\s*/g, \" \").trim();\n\treturn oneLine.length > 160 ? `${oneLine.slice(0, 160)}…` : oneLine;\n}\n\nfunction renderDraftLine(\n\tscenario: string,\n\tcardNo: string,\n\tfact: string,\n\ttimes: number,\n\ttime: string,\n\tcardDir?: string,\n): string {\n\treturn `- [草稿] ${time} | ${scenario} | ${cardNo} | ×${times} | ${sanitizeFact(fact)}${cardDir ? ` | 卡目录=${cardDir}` : \"\"}`;\n}\n\nfunction parseDraftLine(line: string): ParsedDraftLine | undefined {\n\tconst match = DRAFT_LINE_RE.exec(line.trim());\n\tif (!match) return undefined;\n\treturn { 时间: match[1], 场景: match[2], 卡号: match[3], 次数: Number(match[4]), 事实: match[5], 卡目录: match[6] };\n}\n\n/** \"YYYY-MM-DD HH:mm\" → 本地时区 Date（解析失败返回 undefined，按不清理处理） */\nfunction parseTimestamp(text: string): Date | undefined {\n\tconst match = /^(\\d{4})-(\\d{2})-(\\d{2}) (\\d{2}):(\\d{2})$/.exec(text);\n\tif (!match) return undefined;\n\tconst [, y, m, d, h, min] = match;\n\treturn new Date(Number(y), Number(m) - 1, Number(d), Number(h), Number(min));\n}\n\n/** 周清阈值：最后更新时间超过 7 天的草稿行清掉 */\nconst GC_AGE_MS = 7 * 24 * 60 * 60 * 1000;\n\n/** 同进程追加串行队列：同步挂钩点（状态机）只能尾随写入，队列避免两次追加并发进锁 */\nlet writeQueue: Promise<void> = Promise.resolve();\n\n/**\n * 追加一条摩擦草稿（整个读改写在跨进程文件锁内完成，含去重与惰性周清）。\n * 摩擦日志目录不存在时随原子写自动建目录；文件不存在时先落两级骨架。\n */\nexport function appendFrictionDraft(\n\thome: string,\n\tentry: FrictionDraftEntry,\n\toptions?: FrictionDraftOptions,\n): Promise<void> {\n\tconst run = writeQueue.then(() => appendOnce(home, entry, options));\n\t// 队列吞掉失败：后续追加不被前一次失败卡死\n\twriteQueue = run.then(\n\t\t() => undefined,\n\t\t() => undefined,\n\t);\n\treturn run;\n}\n\n/** 等待本进程内排队的草稿写入全部落盘（同步挂钩点的尾随写入靠它等齐；测试用，生产无须调用） */\nexport function drainFrictionDraftWrites(): Promise<void> {\n\treturn writeQueue;\n}\n\nasync function appendOnce(home: string, entry: FrictionDraftEntry, options?: FrictionDraftOptions): Promise<void> {\n\tconst logPath = frictionLogPath(home);\n\tmkdirSync(dirname(logPath), { recursive: true });\n\tconst now = (options?.时间 ?? (() => new Date()))();\n\tconst timeText = formatTimestamp(now);\n\tconst dir = entry.卡目录 ? resolve(entry.卡目录).replaceAll(\"\\\\\", \"/\") : undefined;\n\t// 日志里存的是换正斜杠的键（冻结存储形状），只借 pathKey 折叠大小写，不改存储格式\n\tconst cardDir = dir !== undefined ? pathKey(dir) : undefined;\n\tawait withFileLock(logPath, () => {\n\t\tconst content = existsSync(logPath) ? readFileSync(logPath, \"utf8\") : SKELETON;\n\t\tconst lines = content.split(/\\r?\\n/);\n\t\tconst key = `${cardDir ?? \"\"}|${entry.场景}|${entry.卡号}`;\n\t\tconst kept: string[] = [];\n\t\tlet deduped = false;\n\t\tfor (const line of lines) {\n\t\t\tconst parsed = parseDraftLine(line);\n\t\t\tif (!parsed) {\n\t\t\t\tkept.push(line); // 非机器格式行（标题、占位文字、人改过的行）原样保留\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 周清：最后更新时间超过 7 天的草稿行直接丢弃\n\t\t\tconst last = parseTimestamp(parsed.时间);\n\t\t\tif (last !== undefined && now.getTime() - last.getTime() > GC_AGE_MS) continue;\n\t\t\t// 去重：同卡同场景只累计次数、刷新时间戳（事实保留首次记录）\n\t\t\tif (!deduped && `${parsed.卡目录 ?? \"\"}|${parsed.场景}|${parsed.卡号}` === key) {\n\t\t\t\tdeduped = true;\n\t\t\t\tkept.push(renderDraftLine(parsed.场景, parsed.卡号, parsed.事实, parsed.次数 + 1, timeText, cardDir));\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tkept.push(line);\n\t\t}\n\t\tif (!deduped) {\n\t\t\t// 收掉文件尾空行；草稿区标题缺失则补（约定草稿区为最后一段）\n\t\t\twhile (kept.length > 0 && kept[kept.length - 1].trim() === \"\") kept.pop();\n\t\t\tif (!kept.some((line) => /^##\\s*草稿区\\s*$/.test(line))) kept.push(\"\", \"## 草稿区\");\n\t\t\tkept.push(renderDraftLine(entry.场景, entry.卡号, entry.事实, 1, timeText, cardDir));\n\t\t}\n\t\twriteFileAtomic(logPath, `${kept.join(\"\\n\")}\\n`);\n\t});\n}\n\nexport function formatTimestamp(date: Date): string {\n\tconst pad = (n: number): string => String(n).padStart(2, \"0\");\n\treturn `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;\n}\n\n/** recordFrictionDraft 的可选身份（宿主沿调用链下传；不在本模块猜全局会话）。 */\nexport interface FrictionEventIdentity {\n\t/** 单次事件唯一身份（toolCallId/entryId/随机 UUID）；同一事件重报必须同值才幂等。 */\n\teventId?: string;\n\tprojectId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\tentryId?: string;\n\ttoolCallId?: string;\n}\n\n/**\n * 事件挂钩入口（各事件落定处调用）：解析 PAO_HOME 并追加草稿，任何失败只警告不抛——\n * 草稿记不上不能影响主流程。PAO_HOME 未配置＝摩擦日志机制未启用，静默跳过（对齐\n * index.ts「配置缺失＝未用此功能」的口径，也避免无 pao 环境的测试刷警告）。\n *\n * 同步代码路径（如状态机）用 `void recordFrictionDraft(...)` 尾随调用，落盘时序由\n * 模块级写队列保证；测试等齐用 drainFrictionDraftWrites()。\n *\n * O10/E02：调用方经 identity 传真实会话身份与事件唯一 ID——同一事件重报\n * 复用同 eventId（幂等，不重复累计 occurrence_count）；新事件用新值。\n */\nexport async function recordFrictionDraft(\n\tscenario: FrictionScenario,\n\tcardNo: string,\n\tfact: string,\n\tcardDir?: string,\n\tidentity?: FrictionEventIdentity,\n): Promise<void> {\n\ttry {\n\t\tconst home = process.env.PAO_HOME?.trim();\n\t\tif (!home) return;\n\t\tawait appendFrictionDraft(home, { 场景: scenario, 卡号: cardNo, 事实: fact, 卡目录: cardDir });\n\t\t// S8-03：同一调用点把四类失败事实登记到受控自进化问题库。\n\t\t// 以稳定来源引用关联（friction 草稿行位置/卡号/场景作为 evidenceRef），\n\t\t// 保留原 Markdown 记录用途，不定期解析 Markdown 生成另一份计数。\n\t\t// 失败只警告不抛，不阻塞主流程。\n\t\ttry {\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\t// 稳定证据引用：场景|卡号|卡目录|事件唯一身份。\n\t\t\t\t// eventId 是单次事件的唯一值——同一事件重报同值命中去重；\n\t\t\t\t// 未传时退化为草稿行键（同卡同场景重报合并计数）。\n\t\t\t\tconst evidenceRef = `friction:${scenario}:${cardNo}:${cardDir ? pathKey(resolve(cardDir).replaceAll(\"\\\\\", \"/\")) : \"\"}${identity?.eventId !== undefined ? `:${identity.eventId}` : \"\"}`;\n\t\t\t\tconst declared = declareImprovementIntent(store, {\n\t\t\t\t\tkind: \"implementation_defect\",\n\t\t\t\t\tsummary: `摩擦事件:${scenario}`,\n\t\t\t\t\texpectedBehavior: \"主流程正常完成\",\n\t\t\t\t\tactualBehavior: fact,\n\t\t\t\t\tevidenceRefs: [evidenceRef],\n\t\t\t\t\toccurrenceCount: 1,\n\t\t\t\t\t...(identity?.projectId === undefined ? {} : { projectId: identity.projectId }),\n\t\t\t\t\t...(identity?.taskId === undefined ? {} : { taskId: identity.taskId }),\n\t\t\t\t\t...(identity?.sessionId === undefined ? {} : { sessionId: identity.sessionId }),\n\t\t\t\t\t...(identity?.entryId === undefined ? {} : { entryId: identity.entryId }),\n\t\t\t\t\t...(identity?.toolCallId === undefined ? {} : { toolCallId: identity.toolCallId }),\n\t\t\t\t});\n\t\t\t\t// O10/E01：登记受理后按项目 enqueue evolve 作业（scopeKey 幂等；\n\t\t\t\t// 本路径无宿主 ctx——enqueueEvolveJob 落持久 pending 后尽量唤醒\n\t\t\t\t// 该 home 的空闲 drain，没有调度器在听则等下一次 settled/recover）。\n\t\t\t\tif (declared.ok && declared.accepted && identity?.projectId !== undefined) {\n\t\t\t\t\ttry {\n\t\t\t\t\t\tenqueueEvolveJob(store, {\n\t\t\t\t\t\t\tpaoHome: home,\n\t\t\t\t\t\t\tprojectId: identity.projectId,\n\t\t\t\t\t\t\tnow: new Date().toISOString(),\n\t\t\t\t\t\t});\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tlogWarn(\n\t\t\t\t\t\t\t`[摩擦日志] 进化作业登记失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tlogWarn(`[摩擦日志] 进化问题登记失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`);\n\t\t}\n\t} catch (error) {\n\t\tlogWarn(`[摩擦日志] 草稿记录失败（不影响主流程）:${error instanceof Error ? error.message : String(error)}`);\n\t}\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * PAO 总入口（接线层,黑板公共决定 #1:由主控维护）。\n *import { registerHostTools, registerSupervisionTools } from \"./host/tools.ts\";\nimport { type KnowledgeMemoryRuntime, matchExecutionEvidence, registerKnowledgeTools } from \"./knowledge/index.ts\";\nimport {\n\t makeRegisterDeliveryArtifacts,makeRegisterReceiptArtifacts,\n} from \"./memory/artifact-registration.ts\";\nimport { registerTaskCompactionState } from \"./memory/compaction-state.ts\";\nimport {\treturn tracker.snapshot();\n}\n","ops":[{"diffOp":{"equal":{"range":[0,79]}}},{"equalLines":{"line_count":22}},{"diffOp":{"equal":{"range":[79,282]}}},{"diffOp":{"delete":{"range":[282,284]}}},{"diffOp":{"insert":{"range":[284,285]}}},{"diffOp":{"equal":{"range":[285,315]}}},{"diffOp":{"delete":{"range":[282,284]}}},{"diffOp":{"insert":{"range":[284,285]}}},{"diffOp":{"equal":{"range":[315,343]}}},{"diffOp":{"delete":{"range":[343,345]}}},{"diffOp":{"insert":{"range":[284,285]}}},{"diffOp":{"equal":{"range":[345,473]}}},{"equalLines":{"line_count":1015}},{"diffOp":{"equal":{"range":[473,503]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\index.ts"},"span":null,"sourceCode":"/**\n * PAO 总入口（接线层,黑板公共决定 #1:由主控维护）。\n *\n * 组装各模块注册,并提供接线层独有的一件事：/pao status 子命令注册（§21 先行区,§status 模块,\n * 数据源与 /pao queue 同源——renderAllQueues/renderDeptPanels,后者随实现迁入 dept/panels.ts）。\n */\nimport { dirname, join, resolve } from \"node:path\";\nimport { getAgentDir } from \"../config.ts\";\nimport { setPrecompactionInstaller } from \"../core/compaction/precompaction.ts\";\nimport type { ExtensionAPI } from \"../core/extensions/types.ts\";\nimport { listCards, loadCard } from \"./cards/cardfile.ts\";\nimport { registerCardTools, registerDeliveryTools, registerVerifierTools } from \"./cards/index.ts\";\nimport { registerIntegrationTools } from \"./cards/integration.ts\";\nimport { registerCollab } from \"./collab/index.ts\";\nimport { registerPaoCommand } from \"./command-router.ts\";\nimport { redactContext, registerContextInspection } from \"./context/index.ts\";\nimport { registerPrecompaction } from \"./context/precompaction.ts\";\nimport { setupPrecompaction } from \"./context/precompaction-adapter.ts\";\nimport { registerDeptTools, renderDeptPanels } from \"./dept/index.ts\";\nimport { registerDesktopOwner } from \"./desktop/index.ts\";\nimport { registerDispatchBriefTools, registerDispatchReconTool } from \"./dispatch-brief/index.ts\";\nimport { type FanoutBackgroundState, registerFanout } from \"./fanout/index.ts\";\nimport { registerHealthcheck } from \"./healthcheck/index.ts\";\nimport { readWorkerSilenceMinutes } from \"./host/config.ts\";\nimport { MinisterHost } from \"./host/host.ts\";\nimport { registerHostTools, registerSupervisionTools } from \"./host/tools.ts\";\nimport { type KnowledgeMemoryRuntime, matchExecutionEvidence, registerKnowledgeTools } from \"./knowledge/index.ts\";\nimport {\n\tmakeRegisterDeliveryArtifacts,\n\tmakeRegisterReceiptArtifacts,\n} from \"./memory/artifact-registration.ts\";\nimport { registerTaskCompactionState } from \"./memory/compaction-state.ts\";\nimport {\n\ttype ArchivedEvent,\n\tappendToOpenSegment,\n\ttype BuiltinMemoryRegistration,\n\tcreateVendorRecall,\n\tMemoryVendorManager,\n\tregisterMemory,\n\tregisterResidentMemory,\n} from \"./memory/index.ts\";\nimport { registerProjectGoalCommand } from \"./memory/project-goal-command.ts\";\nimport { registerProjectSession } from \"./memory/project-session.ts\";\nimport { sessionMemory } from \"./memory/session.ts\";\nimport { getSource, registerSource } from \"./memory/sources.ts\";\nimport { openMemoryStore } from \"./memory/store.ts\";\nimport { scopeFromContext } from \"./memory/tools.ts\";\nimport { openPaoPanel } from \"./panel/index.ts\";\nimport { registerPanorama } from \"./panorama/index.ts\";\nimport { patrolAfterInspect } from \"./patrol/hook.ts\";\nimport { registerShellGuard } from \"./patrol/wire.ts\";\nimport {\n\tcheckPaoAssembly,\n\tcreatePaoAssemblyTracker,\n\tcreatePaoTeardown,\n\tfinalizePaoAssemblyFailure,\n\ttype PaoAssemblyDegradation,\n\tPaoAssemblyFailure,\n\ttype PaoAssemblyRecord,\n\ttype PaoTeardown,\n\tplanPaoAssembly,\n\trecordPaoAssembly,\n\ttoPaoAssemblyFailure,\n} from \"./preflight/assembly.ts\";\nimport { registerPreflight } from \"./preflight/index.ts\";\nimport {\n\tisWorkflowMinisterTool,\n\tresolvePaoLoadout,\n\tresolvePaoRole,\n\tskippedModulesFor,\n\tworkflowMinisterActiveTools,\n} from \"./role.ts\";\nimport { resolvePaoHome } from \"./routing/config.ts\";\nimport { registerModelCommand, registerTiers } from \"./routing/index.ts\";\nimport { attachBackgroundHost, createBackgroundHost, releaseBackgroundHost } from \"./runtime/background.ts\";\nimport { registerRuntimeControls } from \"./runtime/index.ts\";\nimport { reconcileDispatchReferenceImpact } from \"./runtime-impact.ts\";\nimport { logWarn } from \"./shared/log.ts\";\nimport { pathKey } from \"./shared/path-key.ts\";\nimport type { WorkerWorkflowPort } from \"./shared/workflow-port.ts\";\nimport { registerFirstRun } from \"./status/firstrun.ts\";\nimport { registerStatusCommand } from \"./status/index.ts\";\nimport { registerTodo, type TodoItem } from \"./todo/index.ts\";\nimport { BRAND_SPINNER_FRAMES, BRAND_SPINNER_INTERVAL_MS } from \"./ui/brand.ts\";\nimport { registerPaoPanels } from \"./ui/panel-renderer.ts\";\nimport { registerTodoSummary } from \"./ui/todo-summary.ts\";\nimport { registerBudgetCommand } from \"./usage/budget-command.ts\";\nimport { appendLedgerRow, buildLedgerRow } from \"./usage/ledger.ts\";\nimport { registerCleanupTools } from \"./worker/cleanup.ts\";\nimport { registerEvidenceReadTool } from \"./worker/evidence-read-tool.ts\";\nimport {\n\tbuildWorkerSupervisionActivity,\n\tregisterSessionBudget,\n\tregisterUsageFooter,\n\tregisterWorkerTools,\n\tresolveLocalWorkerSupervisionRoute,\n\tWorkerRunner,\n\ttype WorkerRunnerOptions,\n} from \"./worker/index.ts\";\nimport { registerWorkerInject } from \"./worker/inject.ts\";\nimport {\n\tacquireExecutionLock,\n\tacquireExecutionRootGuard,\n\treleaseDispatchLock,\n\tretainDispatchLock,\n} from \"./worker/lock.ts\";\nimport { createDispatchNotifySurface, sendDispatchNotifyWakeup } from \"./worker/notify.ts\";\nimport { installManagedParentLifecycle } from \"./worker/parent-lifecycle.ts\";\nimport { registerWorkerResultTool } from \"./worker/result-tool.ts\";\nimport { resolveWorkflowDispatch } from \"./workflow/dispatch-context.ts\";\nimport { WorkflowHostBridge } from \"./workflow/host-bridge.ts\";\nimport { registerWorkflowTools } from \"./workflow/index.ts\";\nimport { readMinisterContext, registerWorkflowMinisterTools } from \"./workflow/minister.ts\";\nimport { createWorkflowSupervisionQuery, resolveWorkflowSupervisionRoute } from \"./workflow/supervision-query.ts\";\nimport { hasPaoWorktreeHostInstallation, installPaoWorktreeHost, resolvePaoWorktreeHost } from \"./worktrees/host.ts\";\nimport { createLocalPaoWorktreeHost } from \"./worktrees/local-host/index.ts\";\nimport { registerWorktreeTools } from \"./worktrees/tools.ts\";\nimport { createSingleRootWorktreeHost, type PaoWorktreeHost } from \"./worktrees/types.ts\";\n\nexport * from \"./cards/index.ts\";\nexport * from \"./collab/index.ts\";\nexport * from \"./dept/index.ts\";\nexport * from \"./host/index.ts\";\nexport * from \"./intake/index.ts\";\nexport * from \"./knowledge/index.ts\";\nexport * from \"./memory/index.ts\";\nexport * from \"./routing/index.ts\";\nexport type { StatusCommandOptions } from \"./status/index.ts\";\nexport * from \"./worker/index.ts\";\nexport * from \"./workflow/index.ts\";\nexport * from \"./worktrees/index.ts\";\n\n// 模块加载即接线（先于任何 createAgentSession 的装配期调用；本文件经 src/extensions/index.ts\n// 被进程入口静态加载，时机成立）：装配口在 core/compaction/precompaction.ts，预压缩装配实现在 pao。\nsetPrecompactionInstaller(setupPrecompaction);\n// 请求额度门的注册在 pao/runtime/request-fetch.ts 模块加载期自挂（见该文件）；此处引入\n// 仅为触发装配——core 直连不载 pao 的纯 SDK 形态无额度门，产品入口（CLI/桌面）都经本文件。\nimport \"./runtime/request-fetch.ts\";\n\n/** 默认卡目录:当前工作目录 .pao/卡（平铺布局;正式任务工作区由调用方传全路径覆盖） */\nexport function defaultCardsDir(cwd: string = process.cwd()): string {\n\treturn join(cwd, \".pao\", \"卡\");\n}\n\nexport interface PaoExtensionOptions {\n\t/** 可信宿主注入机械验收命令执行器，覆盖自动链、直接派卡与手动验收。 */\n\tverificationCommandRunner?: import(\"./cards/verifier.ts\").VerificationCommandRunner;\n\t/** 覆盖默认卡目录解析(测试/宿主注入) */\n\tresolveCardsDir?: () => string;\n\t/** 覆盖 PAO_HOME 解析(测试/宿主注入;缺省读环境变量) */\n\tresolvePaoHome?: () => string;\n\t/**\n\t * 项目根解析(临时计划定义落 <项目根>/.pao/临时工作流/)。\n\t * 缺省＝session_start 的会话工作目录；会话启动前使用进程目录。宿主另有布局时注入。\n\t */\n\tresolveProjectRoot?: () => string;\n\t/** 默认 worker 与部长共用的可信子进程入口；显式注入 runner/host 时由该对象负责。 */\n\tprocessInvocation?: WorkerRunnerOptions[\"processInvocation\"];\n\t/** 仅供可信宿主注入本次配置目录和工作树存储；不会写入全局环境。 */\n\tchildEnvironment?: () => NodeJS.ProcessEnv;\n\t/** 产品宿主与子进程共享的工作树状态目录；桌面传已有 userDataDir。 */\n\tworktreeStateRoot?: string;\n\t/** 可信宿主选择的新实例运行方式；未指定时读启动环境 PAO_RUN_MODE，缺省有人值守。 */\n\trunMode?: \"attended\" | \"unattended\";\n\t/** 宿主/测试注入；正式入口每次扩展加载创建独立运行器。 */\n\trunner?: WorkerRunner;\n\thost?: MinisterHost;\n\t/** 宿主已装配的工作树服务。桌面经 RPC 代理注入；不能依赖该模块的进程内 WeakMap 跨进程共享。 */\n\tworktreeHost?: PaoWorktreeHost;\n}\n\n/**\n * pao 扩展工厂:装配全部模块。\n *\n * 装配失败分两类(计划§11.2 S5-2/S5-3):\n * - 关键能力(控制/派发/验收/交付/任务工具/结果通道/模型入口,以及配置前置已满足的档位与\n *   工作流)注册失败即抛 `PaoAssemblyFailure`——宿主不得启用该会话执行;抛出前先把本次\n *   已建资源按逆序释放,再把失败(必要时连同清理错误)交回调用方。\n * - 可选能力(记忆/知识/界面/观测等)按明确策略降级:登记降级清单并保留 warning,普通任务\n *   仍可用。区分口径是「配置前置」:前置量得到且合格,该模块再失败就只可能是编程错误。\n *\n * 角色门控(R10/G1-12)与能力清单同源于 role.ts(S5-1):装载面＝全部模块－角色跳过－角色\n * 条件分支,由 `resolvePaoLoadout`/`paoAssemblyRequirements` 决定必需与可选,装配层不再\n * 自己维护一份跳过表;清单见 `pao配置/装载清单.md` 与本文件 register 调用点。\n *\n * 调用约定:**失败信号是返回值里的 Promise**。包装工厂必须 `return` 它\n * (`(pi) => paoExtension(pi)` 会吞掉装配失败,装载器当作同步成功 commit);生产内置入口\n * `src/extensions/index.ts` 直接传 `factory: paoExtension`,满足该约定。\n */\nexport default function paoExtension(pi: ExtensionAPI, options: PaoExtensionOptions = {}): void | Promise<void> {\n\tconst teardown = createPaoTeardown();\n\ttry {\n\t\tconst record = assemblePaoExtension(pi, options, teardown);\n\t\trecordPaoAssembly(pi, record);\n\t\treturn;\n\t} catch (error) {\n\t\t// S5-3/S5-4:关键失败向宿主传播。返回 Promise 让 loader 的 `await factory(api)` 等到\n\t\t// 资源真正释放之后才 discard 半装配实例;错误里同时保留模块名与原始原因。\n\t\treturn finalizePaoAssemblyFailure(teardown, toPaoAssemblyFailure(error));\n\t}\n}\n\n/** 一次装配的实现体:任何抛出都由工厂入口统一收尾(释放资源＋包装成装配失败)。 */\nfunction assemblePaoExtension(\n\tpi: ExtensionAPI,\n\toptions: PaoExtensionOptions,\n\tteardown: PaoTeardown,\n): PaoAssemblyRecord {\n\tconst paoHome = options.resolvePaoHome ?? resolvePaoHome;\n\tconst role = resolvePaoRole();\n\t// 工作流部长上下文是纯读取(env JSON):提前到任何副作用之前,坏配置在装配前失败。\n\tlet workflowMinister: ReturnType<typeof readMinisterContext>;\n\ttry {\n\t\tworkflowMinister = role === \"部长\" ? readMinisterContext() : undefined;\n\t} catch (error) {\n\t\tthrow toPaoAssemblyFailure(error, {\n\t\t\tmodule: \"workflow-minister\",\n\t\t\tcapability: \"control\",\n\t\t\tsource: \"PAO_WORKFLOW_MINISTER\",\n\t\t});\n\t}\n\tconst loadout = resolvePaoLoadout(role, workflowMinister !== undefined);\n\tconst worktreeStateRootInput =\n\t\toptions.worktreeStateRoot ??\n\t\tprocess.env.PAO_WORKTREE_STATE_ROOT ??\n\t\tjoin(process.env.PAO_HOME?.trim() || getAgentDir(), \"worktree-host\");\n\t// S5-2 装配前校验:配置与依赖先判,判不过就在动任何资源之前失败。\n\tconst check = checkPaoAssembly({ loadout, resolvePaoHome: paoHome, worktreeStateRootInput });\n\tconst problem = check.problems[0];\n\tif (problem)\n\t\tthrow new PaoAssemblyFailure({\n\t\t\tmodule: problem.module,\n\t\t\tcapability: problem.capability,\n\t\t\tsource: problem.source,\n\t\t\treason: problem.reason,\n\t\t});\n\tconst plan = planPaoAssembly(check, loadout);\n\tconst tracker = createPaoAssemblyTracker(loadout, check.degradations);\n\t// 角色门控与能力清单同源:被本装载面跳过的模块不安装、也不记降级(不是失败)。\n\tconst skippedModules = skippedModulesFor(loadout);\n\t/** 非 register 的装配步骤:失败同样带模块名,别让宿主只看到一句没有主语的报错。 */\n\tconst critical = (module: string, install: () => void): void => {\n\t\tcriticalValue(module, install);\n\t};\n\tconst criticalValue = <T>(module: string, install: () => T): T => {\n\t\ttry {\n\t\t\treturn install();\n\t\t} catch (error) {\n\t\t\tthrow toPaoAssemblyFailure(error, { module });\n\t\t}\n\t};\n\t// 前置换行之后才开始动资源:受管父通道钩子(进程级,装配失败须撤销)、证据读取工具(默认不激活)。\n\tteardown.add(\"managed-parent-lifecycle\", installManagedParentLifecycle());\n\t// read 保持原工具名，只在既有读取面增加 worker 证据解压；默认不激活，\n\t// 因此 defaultTools、--tools、--exclude-tools 和巡库 hook 的语义不变。\n\tcritical(\"evidence-read-tool\", () => registerEvidenceReadTool(pi));\n\tlet sessionProjectRoot: string | undefined;\n\tconst resolveProjectRoot = options.resolveProjectRoot ?? (() => sessionProjectRoot ?? process.cwd());\n\tconst resolveCardsDir = options.resolveCardsDir ?? (() => defaultCardsDir(resolveProjectRoot()));\n\tconst resolveSharedStateRoot = (): string | undefined => {\n\t\ttry {\n\t\t\tconst home = paoHome().trim();\n\t\t\treturn home ? join(home, \"派发状态\") : undefined;\n\t\t} catch {\n\t\t\t// 桌面主进程可能没有 PAO_HOME；宿主必须通过 resolvePaoHome 注入隔离现场。\n\t\t\t// 缺现场时运行器保留单进程限额，登记状态会如实显示跨进程共享未启用。\n\t\t\treturn undefined;\n\t\t}\n\t};\n\tconst resolveRunMode = (): \"attended\" | \"unattended\" => {\n\t\tconst mode = options.runMode ?? process.env.PAO_RUN_MODE ?? \"attended\";\n\t\tif (mode !== \"attended\" && mode !== \"unattended\")\n\t\t\tthrow new Error(\"宿主运行方式 PAO_RUN_MODE 须为 attended 或 unattended\");\n\t\treturn mode;\n\t};\n\t// S4：工作流执行归属只经这一处装配查询，执行侧与监督快照共用同一份投影。\n\tconst workflowSupervision = createWorkflowSupervisionQuery({\n\t\trole: role === \"部长\" ? \"minister\" : \"main\",\n\t\t...(process.env.PAO_DEPT?.trim() ? { department: process.env.PAO_DEPT.trim() } : {}),\n\t});\n\t// 工作流解释端口：worker 与 fanout 共用同一实例，执行侧不直接导入 workflow。\n\tconst workerWorkflowPort: WorkerWorkflowPort = {\n\t\tresolveDispatch: resolveWorkflowDispatch,\n\t\tresolveSupervisionRoute: resolveWorkflowSupervisionRoute,\n\t};\n\tconst resolveSupervisionRoute = (input: {\n\t\tcardNo: string;\n\t\tcardsDir: string;\n\t\toperator: string;\n\t\townerSession?: string;\n\t\tgoal: string;\n\t}): ReturnType<typeof resolveLocalWorkerSupervisionRoute> => {\n\t\tconst card = loadCard(input.cardsDir, Number.parseInt(input.cardNo, 10));\n\t\treturn (\n\t\t\tworkflowSupervision.resolveRoute(card, input) ??\n\t\t\tresolveLocalWorkerSupervisionRoute(card, {\n\t\t\t\t...input,\n\t\t\t\trole: role === \"部长\" ? \"minister\" : \"main\",\n\t\t\t})\n\t\t);\n\t};\n\t// 前校验已判过空值(问题清单),这里只做路径归一。\n\tconst worktreeStateRoot = resolve(worktreeStateRootInput);\n\tconst childEnvironment = (): NodeJS.ProcessEnv => ({\n\t\tPAO_CODING_AGENT_DIR: getAgentDir(),\n\t\t...(options.resolvePaoHome ? { PAO_HOME: options.resolvePaoHome() } : {}),\n\t\t...options.childEnvironment?.(),\n\t\tPAO_WORKTREE_STATE_ROOT: worktreeStateRoot,\n\t\tPAO_RUN_MODE: resolveRunMode(),\n\t});\n\tlet ownerSessionId: string | undefined;\n\tconst runner =\n\t\toptions.runner ??\n\t\tcriticalValue(\n\t\t\t\"worker-runner\",\n\t\t\t() =>\n\t\t\t\tnew WorkerRunner({\n\t\t\t\t\tdispatchStateRoot: resolveSharedStateRoot(),\n\t\t\t\t\tprocessInvocation: options.processInvocation,\n\t\t\t\t\tchildEnvironment,\n\t\t\t\t}),\n\t\t);\n\t// 只释放 pao 自己建的资源:宿主注入的 runner/host 由宿主负责(装配失败不越权停宿主的进程)。\n\tif (!options.runner)\n\t\tteardown.add(\"worker-runner\", async () => {\n\t\t\tawait runner.stopAll();\n\t\t});\n\tconst host =\n\t\toptions.host ??\n\t\tcriticalValue(\n\t\t\t\"minister-host\",\n\t\t\t() =>\n\t\t\t\tnew MinisterHost({\n\t\t\t\t\tprocessInvocation: options.processInvocation,\n\t\t\t\t\tchildEnvironment,\n\t\t\t\t\tresolvePaoHome: () => {\n\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\treturn paoHome();\n\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\treturn undefined;\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t}),\n\t\t);\n\tif (!options.host) teardown.add(\"minister-host\", () => host.stopTracking());\n\tconst stopObservingActivity =\n\t\trole !== \"worker\"\n\t\t\t? host.observeActivity(() =>\n\t\t\t\t\tbuildWorkerSupervisionActivity(runner, {\n\t\t\t\t\t\trole: role === \"部长\" ? \"minister\" : \"main\",\n\t\t\t\t\t\tcontext: ownerSessionId,\n\t\t\t\t\t\tworkflowPosition: (entry, card) => workflowSupervision.position(entry, card),\n\t\t\t\t\t}),\n\t\t\t\t)\n\t\t\t: () => {};\n\tpi.on(\"session_shutdown\", (event) => {\n\t\tif (event.onConfirmedShutdown) event.onConfirmedShutdown(stopObservingActivity);\n\t\telse stopObservingActivity();\n\t});\n\tteardown.add(\"host-activity-observer\", stopObservingActivity);\n\t// worktrees 在 worker 跳过清单内:critical 安装与 register 注册同口径按装载面跳过。\n\tif (!skippedModules.has(\"worktrees\"))\n\t\tcritical(\"worktrees\", () => {\n\t\t\tif (options.worktreeHost) installPaoWorktreeHost(pi, options.worktreeHost);\n\t\t\telse if (!hasPaoWorktreeHostInstallation(pi))\n\t\t\t\tinstallPaoWorktreeHost(pi, createLocalPaoWorktreeHost({ stateRoot: worktreeStateRoot }));\n\t\t});\n\tconst installedWorktreeHost = resolvePaoWorktreeHost(pi);\n\t/**\n\t * 无工作树管理器时保留普通 primary 单卡与扇出；独立工作树工具仍只认真实安装的宿主，\n\t * 不会把这个本地适配器伪装成可创建或清理 managed 工作树的能力。\n\t */\n\tconst primaryWorktreeHost = (): PaoWorktreeHost =>\n\t\tinstalledWorktreeHost.host ?? createSingleRootWorktreeHost(resolveProjectRoot());\n\tconst acquireIntegrationWriteLock = async ({\n\t\texecutionRoot,\n\t\tholder,\n\t\tsignal,\n\t}: {\n\t\texecutionRoot: string;\n\t\tholder: string;\n\t\tsignal?: AbortSignal;\n\t}) => {\n\t\tconst taskRoot = resolve(resolveProjectRoot());\n\t\tconst normalizedExecutionRoot = resolve(executionRoot);\n\t\tlet guard: Awaited<ReturnType<typeof acquireExecutionRootGuard>> | undefined;\n\t\tlet executionLock: Awaited<ReturnType<typeof acquireExecutionLock>> | undefined;\n\t\ttry {\n\t\t\tif (pathKey(taskRoot) !== pathKey(normalizedExecutionRoot)) {\n\t\t\t\tguard = await acquireExecutionRootGuard({\n\t\t\t\t\ttaskRoot,\n\t\t\t\t\texecutionRoot: normalizedExecutionRoot,\n\t\t\t\t\tholder,\n\t\t\t\t\t...(signal ? { signal } : {}),\n\t\t\t\t});\n\t\t\t}\n\t\t\texecutionLock = await acquireExecutionLock({\n\t\t\t\troot: normalizedExecutionRoot,\n\t\t\t\tholder,\n\t\t\t\t...(signal ? { signal } : {}),\n\t\t\t});\n\t\t} catch (error) {\n\t\t\tif (guard) {\n\t\t\t\ttry {\n\t\t\t\t\tawait guard.release();\n\t\t\t\t} catch (releaseError) {\n\t\t\t\t\tlogWarn(\n\t\t\t\t\t\t`[pao] 整合获取失败后的执行根守卫回滚失败:${releaseError instanceof Error ? relea