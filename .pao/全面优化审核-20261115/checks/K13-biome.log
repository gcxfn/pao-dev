53]}}},{"diffOp":{"insert":{"range":[784,796]}}},{"diffOp":{"equal":{"range":[521,522]}}},{"diffOp":{"delete":{"range":[796,813]}}},{"diffOp":{"insert":{"range":[813,828]}}},{"diffOp":{"equal":{"range":[521,544]}}},{"diffOp":{"delete":{"range":[335,340]}}},{"diffOp":{"insert":{"range":[329,335]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[348,358]}}},{"diffOp":{"insert":{"range":[340,348]}}},{"diffOp":{"equal":{"range":[358,360]}}},{"diffOp":{"equal":{"range":[828,860]}}},{"equalLines":{"line_count":681}},{"diffOp":{"equal":{"range":[860,869]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-version.test.ts"},"span":[1371,1469],"sourceCode":"/**\n * S9-01 定向测试：固定版本存储（publishCandidate / listResourceVersions / readResourceVersion）。\n *\n * 覆盖：\n * - passed 候选发布成功：版本目录完整 + publish activation 行落库；\n * - 候选未 passed 拒绝（not_ready）；最新验证非 passed 拒绝；\n * - 复制中断不产生可加载版本（半成品目录被清理、无 activation）；\n * - 同一候选重复 publish 幂等（同 versionId 不重复写 activation）；\n * - listResourceVersions 返回时间线；\n * - 旧版本在后续 publish 后仍可读；\n * - 已验证版本文件不被后续候选原位修改（版本目录内容不变）。\n *\n * O11/E08 审计门（publishCandidate 内部）：\n * - 「合法 passed 链」helper（freeze→假双侧 run→evaluate→passed）替代直接\n *   插 passed 行——publish 门要核对 problem/candidate/testPlan/validation\n *   四级来源关联 + 候选目录指纹与验证回执一致，直接插行过不了门。\n * - extension/command 资源 → 能力未接拒发；\n * - 验证后改动候选正文 → 指纹不匹配拒发；\n * - plan.json 被改 → 受管输入核对拒发；\n * - 合法 skill 候选发布文件与已验副本逐字一致。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-version.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\tlistResourceVersions,\n\tpublishCandidate,\n\treadResourceVersion,\n} from \"../../src/pao/evolution/versions.ts\";\nimport type { CardProcessResult } from \"../../src/pao/cards/process.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ver-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 造一个已登记 skill 资源 + baseVersion 快照。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直接插一行 problem（classified）。 */\nfunction seedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string; action?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\tover.action ?? \"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n/** 写一条 evolution_source_links（sourceId 需是已登记 sources 行或不含 src- 前缀）。 */\nfunction seedLink(store: MemoryStore, ownerKind: string, ownerId: string, sourceId: string) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\tlink_id, owner_kind, owner_id, source_id, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`link-${ownerKind}-${ownerId}-${sourceId}`, ownerKind, ownerId, sourceId, AT);\n}\n\n/**\n * O11/E08「合法 passed 链」helper：\n * freeze（含来源关联）→ 候选行+目录+关联 → 双侧 runValidationCase（假\n * processRunner，command 用例，回执带真实指纹）→ evaluate（paoHome 读\n * plan.json）→ passed。替代直接插 passed 行——publish 门核对来源关联与\n * 候选指纹，插假行过不了门。\n */\nasync function legalPassedChain(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tfiles?: Record<string, string>;\n\t\t/** 双侧 run 的退出码（baseline=旧版/candidate=候选）；缺省 baseline=1、candidate=0。 */\n\t\tbaselineCode?: number;\n\t\tcandidateCode?: number;\n\t},\n): Promise<{ candidateId: string; testPlanId: string; validationId: string; candidateDir: string }> {\n\tconst candidateId = over.candidateId ?? `cand-${Math.random().toString(36).slice(2, 8)}`;\n\t// 1. 真实来源行 + problem/candidate 关联（publish 门核对四级关联）。\n\tconst sourceId = registerSource(store.db, {\n\t\tsessionId: \"s1\",\n\t\tentryId: `e-${candidateId}`,\n\t\teventType: \"toolResult\",\n\t\tcapturedAt: AT,\n\t});\n\tseedLink(store, \"problem\", over.problemId, sourceId);\n\n\t// 2. freeze 计划（继承 problem 关联写 validation/testPlan 级 link）。\n\tconst plan = freezeValidationPlan(store, {\n\t\tproblemId: over.problemId,\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tpaoHome: home,\n\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: AT,\n\t});\n\tif (!plan.ok) throw new Error(`freeze failed: ${plan.error.message}`);\n\tconst testPlanId = plan.testPlanId;\n\n\t// 3. 候选行 + 候选目录（候选正文 = baseVersion 文件 + 修正）+ 候选关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'proposed', ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\ttestPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? { \"SKILL.md\": \"# code-review\\n步骤一（已修正）\\n\", \"examples/a.md\": \"示例 A\\n\" };\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\tseedLink(store, \"candidate\", candidateId, sourceId);\n\n\t// 4. 双侧 run：command 用例 + 假 processRunner（不发起真实子进程；\n\t//    回执仍由 runner 真实落盘并带版本副本指纹）。\n\tconst fakeProcess = (code: number): typeof import(\"../../src/pao/cards/process.ts\").runCardProcess =>\n\t\tasync () => ({ code, stdout: \"\", stderr: \"\" }) satisfies CardProcessResult;\n\tconst caseSpec = plan.plan.reproduction[0];\n\tconst sideRun = async (side: \"baseline\" | \"candidate\", code: number) => {\n\t\tconst run = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeProcess(code) },\n\t\t\t{\n\t\t\t\tvalidationCase: caseSpec,\n\t\t\t\tresourceId: over.resourceId,\n\t\t\t\tbaseVersion: over.baseVersion,\n\t\t\t\tside,\n\t\t\t\t...(side === \"candidate\" ? { candidateId } : {}),\n\t\t\t\ttestPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\tif (!run.ok) throw new Error(`run ${side} failed: ${run.error.message}`);\n\t\treturn run.result;\n\t};\n\tconst baseline = await sideRun(\"baseline\", over.baselineCode ?? 1);\n\tconst candidate = await sideRun(\"candidate\", over.candidateCode ?? 0);\n\n\t// 5. evaluate：paoHome 读 plan.json 核对完整集合 → passed。\n\tconst evaluated = evaluateCandidate(store, {\n\t\tcandidateId,\n\t\ttestPlanId,\n\t\tpaoHome: home,\n\t\tcaseResults: [{ caseId: caseSpec.caseId, baseline, candidate, verdict: \"passed\" }],\n\t\tcreatedAt: AT,\n\t});\n\tif (!evaluated.ok) throw new Error(`evaluate failed: ${evaluated.error.message}`);\n\tif (evaluated.verdict !== \"passed\") {\n\t\tthrow new Error(`legalPassedChain 未 passed: ${evaluated.verdict}（${evaluated.caseResults.map((r) => r.reason).join(\"；\")}）`);\n\t}\n\treturn { candidateId, testPlanId, validationId: evaluated.validationId, candidateDir };\n}\n\n// ── publishCandidate ────────────────────────────────────────────────────\n\ndescribe(\"publishCandidate\", () => {\n\tit(\"passed 候选发布成功：版本目录完整 + publish activation 落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\texpect(result.published).toBe(true);\n\t\texpect(result.filesPublished).toBe(2);\n\n\t\t// 版本目录文件完整且内容与候选一致。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst versionDir = join(evolutionPaths(home).versions, dirSafe, result.versionId);\n\t\texpect(readFileSync(join(versionDir, \"SKILL.md\"), \"utf8\")).toContain(\"已修正\");\n\t\texpect(readFileSync(join(versionDir, \"examples\", \"a.md\"), \"utf8\")).toBe(\"示例 A\\n\");\n\n\t\t// publish activation 落库，from_version=候选 baseVersion。\n\t\tconst act = store.db\n\t\t\t.prepare(`SELECT * FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, result.versionId) as {\n\t\t\tkind: string;\n\t\t\tfrom_version: string;\n\t\t\tto_version: string;\n\t\t};\n\t\texpect(act.kind).toBe(\"publish\");\n\t\texpect(act.from_version).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"候选未 passed → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// testing 状态：走 legalPassedChain 会落 passed——改用「freeze+candidate 行」只到 testing。\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-t\", eventType: \"toolResult\", capturedAt: AT });\n\t\tseedLink(store, \"problem\", problemId, sourceId);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, '[]', '', '[]', 'testing', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"cand-testing\", problemId, resourceId, baseVersion, plan.testPlanId, AT, AT);\n\n\t\tconst result = await publishCandidate(store, { candidateId: \"cand-testing\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"passed\");\n\t\tstore.close();\n\t});\n\n\tit(\"最新验证非 passed → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 在 passed 之后再插一条更新的 failed 验证（最新一条非 passed → 拒绝）。\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-f\", eventType: \"toolResult\", capturedAt: AT });\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, (SELECT test_plan_id FROM evolution_candidates WHERE candidate_id = ?), ?, ?, ?, ?, '[]', 'failed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"val-failed-new\", candidateId, candidateId, problemId, resourceId, baseVersion, AT3, AT3);\n\t\tseedLink(store, \"validation\", \"val-failed-new\", sourceId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"failed\");\n\t\tstore.close();\n\t});\n\n\tit(\"候选无验证记录 → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// passed 状态但无 validation 行——直接把状态改成 passed 而无验证记录。\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\tstore.db.prepare(`DELETE FROM evolution_validations WHERE candidate_id = ?`).run(candidateId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"候选目录缺失 → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\trmSync(candidateDir, { recursive: true, force: true });\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"复制中断不产生可加载版本（半成品目录清理 + 无 activation + 指向不变）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 先正常发布一次拿到 versionId 与 versionDir。\n\t\tconst first = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT });\n\t\texpect(first.ok && \"versionId\" in first).toBe(true);\n\t\tif (!first.ok || !(\"versionId\" in first)) return;\n\t\tconst { versionId, versionDir } = first;\n\n\t\t// 抹掉 activation 并把版本目录中的 `examples` 子目录替换成同名文件：\n\t\t// 再发布同一候选时，复制 `examples/a.md` 会因 dirname 是文件而 throw。\n\t\tstore.db.prepare(`DELETE FROM evolution_activations WHERE to_version = ?`).run(versionId);\n\t\trmSync(join(versionDir, \"examples\"), { recursive: true, force: true });\n\t\twriteFileSync(join(versionDir, \"examples\"), \"占位文件\\n\", \"utf8\");\n\n\t\tawait expect(\n\t\t\tpublishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 }),\n\t\t).rejects.toThrow();\n\n\t\t// 半成品目录被整体清理：版本目录不复存在。\n\t\texpect(existsSync(versionDir)).toBe(false);\n\t\t// 没有写 activation（部分目录不构成可加载版本）。\n\t\tconst acts = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t\t// effective_version 未被改动（仍指向 baseVersion）。\n\t\tconst res = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(res.effective_version).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"半成品版本目录（无 activation）→ readResourceVersion 报不可用但文件可读\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId } = seedSkill(home);\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst halfDir = join(evolutionPaths(home).versions, dirSafe, \"v-halfbaked01\");\n\t\tmkdirSync(halfDir, { recursive: true });\n\t\twriteFileSync(join(halfDir, \"SKILL.md\"), \"partial\\n\", \"utf8\");\n\t\tconst read = readResourceVersion(store, { resourceId, versionId: \"v-halfbaked01\", paoHome: home });\n\t\texpect(read.ok).toBe(true);\n\t\tif (!read.ok) return;\n\t\texpect(read.available).toBe(false);\n\t\texpect(read.files).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"同一候选重复 publish 幂等（同 versionId，不重复写 activation）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst first = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(first.ok).toBe(true);\n\t\tif (!first.ok || !(\"versionId\" in first)) return;\n\n\t\tconst second = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok || !(\"versionId\" in second)) return;\n\t\texpect(second.versionId).toBe(first.versionId);\n\t\texpect(second.published).toBe(false);\n\n\t\t// 只写了一条 publish activation。\n\t\tconst acts = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, first.versionId) as { n: number };\n\t\texpect(acts.n).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"两个不同候选同内容 → 同 versionId 幂等\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst files = { \"SKILL.md\": \"# code-review\\n同一修正\\n\", \"examples/a.md\": \"示例 A\\n\" };\n\t\tconst c1 = await legalPassedChain(store, home, { problemId, resourceId, baseVersion, files });\n\t\tconst c2 = await legalPassedChain(store, home, { problemId, resourceId, baseVersion, files });\n\n\t\tconst r1 = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\tconst r2 = await publishCandidate(store, { candidateId: c2.candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(r1.ok && \"versionId\" in r1).toBe(true);\n\t\texpect(r2.ok && \"versionId\" in r2).toBe(true);\n\t\tif (!r1.ok || !r2.ok || !(\"versionId\" in r1) || !(\"versionId\" in r2)) return;\n\t\texpect(r2.versionId).toBe(r1.versionId);\n\t\texpect(r2.published).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"已验证版本文件不被后续候选原位修改\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst c1 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第一版修正\\n\" },\n\t\t});\n\t\tconst pub = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(pub.ok && \"versionId\" in pub).toBe(true);\n\t\tif (!pub.ok || !(\"versionId\" in pub)) return;\n\t\tconst versionDir = pub.versionDir;\n\n\t\t// 后续候选改动同一资源文件 → 新候选目录是独立目录，版本目录原内容不变。\n\t\tawait legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第二版修正\\n\" },\n\t\t});\n\t\texpect(readFileSync(join(versionDir, \"SKILL.md\"), \"utf8\")).toContain(\"第一版修正\");\n\t\tstore.close();\n\t});\n\n\t// ── O11/E08 审计门反面场景 ────────────────────────────────────────────\n\n\tit(\"O11/E08：extension 资源能力未接 → not_ready（拒发）\", async () => {\n\t\tconst home = tempHome();\n\t\t// 手工插一个 extension 资源行（registerResource 只接 skill 类经登记入口；\n\t\t// extension 行直接插以覆盖「能力未接」分支）。\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resourceId = \"extension:test-ext\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_resources (\n\t\t\t\t\tresource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t) VALUES (?, 'extension', 'extensions/test-ext', '[\"edit-content\"]', '[]', 'extension-path', NULL, 1, ?, ?)`,\n\t\t\t)\n\t\t\t.run(resourceId, AT, AT);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion: \"v-000000000000\", action: \"modify\" });\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-x\", eventType: \"toolResult\", capturedAt: AT });\n\t\tseedLink(store, \"problem\", problemId, sourceId);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion: \"v-000000000000\", paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = \"cand-ext\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, '[]', '', '[]', 'passed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(candidateId, problemId, resourceId, \"v-000000000000\", plan.testPlanId, AT, AT);\n\t\tseedLink(store, \"candidate\", candidateId, sourceId);\n\t\t// 候选目录（能力核对在目录检查之前，但目录要有文件才能到能力步——先给一份）。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\t\tmkdirSync(candidateDir, { recursive: true });\n\t\twriteFileSync(join(candidateDir, \"index.js\"), \"console.log(1)\\n\", \"utf8\");\n\t\t// passed validation 行 + link（能力核对在 validation 存在后、来源核对前）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, '[]', 'passed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"val-ext\", plan.testPlanId, candidateId, problemId, resourceId, \"v-000000000000\", AT, AT);\n\t\tseedLink(store, \"validation\", \"val-ext\", sourceId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"能力未覆盖\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：验证后改动候选正文 → 指纹不匹配 not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 验证通过后改候选文件 → 当前指纹 ≠ 回执指纹 → 拒发。\n\t\twriteFileSync(join(candidateDir, \"SKILL.md\"), \"# code-review\\n验证后新改动\\n\", \"utf8\");\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"被改动\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：plan.json 被改 → 受管输入核对 not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, testPlanId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 篡改 plan.json（加一条从未冻结的用例——受管输入被修改）。\n\t\tconst planPath = join(evolutionPaths(home).validations, testPlanId, \"plan.json\");\n\t\tconst planJson = JSON.parse(readFileSync(planPath, \"utf8\")) as Record<string, unknown>;\n\t\t(planJson as { holdout: unknown[] }).holdout = [\n\t\t\t{ caseId: \"holdout-0\", group: \"holdout\", input: \"后门\", initialFiles: {}, allowedTools: [], acceptance: \"x\" },\n\t\t];\n\t\twriteFileSync(planPath, JSON.stringify(planJson, null, 2), \"utf8\");\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\t// plan.json 实质篡改核对：testPlanId 尾段指纹与重算值对不上即拒发。\n\t\texpect(result.reason).toContain(\"指纹不符\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：合法 skill 发布文件与已验副本逐字一致\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst files = { \"SKILL.md\": \"# code-review\\n步骤一（已修正）\\n\", \"examples/a.md\": \"示例 A\\n\", \"examples/b.md\": \"示例 B\\n\" };\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles,\n\t\t});\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(result.ok && \"versionId\" in result).toBe(true);\n\t\tif (!result.ok || !(\"versionId\" in result)) return;\n\n\t\t// 版本目录与候选目录逐字一致（验证时跑的就是这份内容）。\n\t\tfor (const [rel] of Object.entries(files)) {\n\t\t\texpect(readFileSync(join(result.versionDir, rel), \"utf8\")).toBe(\n\t\t\t\treadFileSync(join(candidateDir, rel), \"utf8\"),\n\t\t\t);\n\t\t}\n\t\tstore.close();\n\t});\n});\n\n// ── listResourceVersions / readResourceVersion ──────────────────────────\n\ndescribe(\"listResourceVersions / readResourceVersion\", () => {\n\tit(\"listResourceVersions 返回时间线（含 baseVersion 快照与已发布版本）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(pub.ok && \"versionId\" in pub).toBe(true);\n\t\tif (!pub.ok || !(\"versionId\" in pub)) return;\n\n\t\tconst list = listResourceVersions(store, resourceId, home);\n\t\texpect(list.ok).toBe(true);\n\t\tif (!list.ok) return;\n\t\t// 时间线含：baseVersion 快照目录（无 activation → 排尾 available=false）\n\t\t// + 已发布版本（有 activation → available=true）。\n\t\tconst published = list.items.find((i) => i.versionId === pub.versionId);\n\t\texpect(published).toBeDefined();\n\t\texpect(published?.available).toBe(true);\n\t\texpect(published?.activation?.kind).toBe(\"publish\");\n\t\tconst base = list.items.find((i) => i.versionId === baseVersion);\n\t\texpect(base).toBeDefined();\n\t\texpect(base?.available).toBe(false); // baseVersion 快照无 activation\n\t\texpect(base?.files.length).toBeGreaterThan(0);\n\t\t// 有 activation 的排在无 activation 之前。\n\t\tconst pubIdx = list.items.findIndex((i) => i.versionId === pub.versionId);\n\t\tconst baseIdx = list.items.findIndex((i) => i.versionId === baseVersion);\n\t\texpect(pubIdx).toBeLessThan(baseIdx);\n\t\tstore.close();\n\t});\n\n\tit(\"旧版本在后续 publish 后仍可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\t// 第一个候选 → 发布 v1。\n\t\tconst c1 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第一版修正\\n\" },\n\t\t});\n\t\tconst p1 = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(p1.ok && \"versionId\" in p1).toBe(true);\n\t\tif (!p1.ok || !(\"versionId\" in p1)) return;\n\t\tconst v1 = p1.versionId;\n\n\t\t// 第二个候选（不同内容）→ 发布 v2。\n\t\tconst c2 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第二版修正\\n\" },\n\t\t});\n\t\tconst p2 = await publishCandidate(store, { candidateId: c2.candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(p2.ok && \"versionId\" in p2).toBe(true);\n\t\tif (!p2.ok || !(\"versionId\" in p2)) return;\n\t\texpect(p2.versionId).not.toBe(v1);\n\n\t\t// v1 仍可读且内容未被覆盖。\n\t\tconst read1 = readResourceVersion(store, { resourceId, versionId: v1, paoHome: home });\n\t\texpect(read1.ok).toBe(true);\n\t\tif (!read1.ok) return;\n\t\texpect(read1.available).toBe(true);\n\t\tconst skillFile = read1.files.find((f) => f.path === \"SKILL.md\");\n\t\texpect(skillFile?.content).toContain(\"第一版修正\");\n\t\t// v2 也可读，内容独立。\n\t\tconst read2 = readResourceVersion(store, { resourceId, versionId: p2.versionId, paoHome: home });\n\t\texpect(read2.ok).toBe(true);\n\t\tif (!read2.ok) return;\n\t\texpect(read2.files.find((f) => f.path === \"SKILL.md\")?.content).toContain(\"第二版修正\");\n\t\tstore.close();\n\t});\n\n\tit(\"读取不存在版本 → source_missing；非法 versionId → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId } = seedSkill(home);\n\t\tconst missing = readResourceVersion(store, { resourceId, versionId: \"v-000000000000\", paoHome: home });\n\t\texpect(missing.ok).toBe(false);\n\t\tif (missing.ok) return;\n\t\texpect(missing.error.code).toBe(\"source_missing\");\n\n\t\tconst bad = readResourceVersion(store, { resourceId, versionId: \"../escape\", paoHome: home });\n\t\texpect(bad.ok).toBe(false);\n\t\tif (bad.ok) return;\n\t\texpect(bad.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n\n\tit(\"版本目录存在但无 activation → available=false 但文件仍可读\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\t// baseVersion 快照目录存在、无 activation。\n\t\tconst read = readResourceVersion(store, { resourceId, versionId: baseVersion, paoHome: home });\n\t\texpect(read.ok).toBe(true);\n\t\tif (!read.ok) return;\n\t\texpect(read.available).toBe(false);\n\t\texpect(read.files.length).toBeGreaterThan(0);\n\t\texpect(read.files.find((f) => f.path === \"SKILL.md\")?.content).toContain(\"步骤一\");\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-01 定向测试：固定版本存储（publishCandidate / listResourceVersions / readResourceVersion）。\n *import { runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\t listResourceVersions,publishCandidate,readResourceVersion,\n} from \"../../src/pao/evolution/versions.ts\";\nimport type { CardProcessResult } from \"../../src/pao/cards/process.ts\";\n\t// 4. 双侧 run：command 用例 + 假 processRunner（不发起真实子进程；\n\t//    回执仍由 runner 真实落盘并带版本副本指纹）。\n\tconst fakeProcess =\n\t\t(code: number): typeof import(\"../../src/pao/cards/process.ts\").runCardProcess =>\n\t\tasync () =>\n\t\t\t({ code, stdout: \"\", stderr: \"\" }) satisfies CardProcessResult;\n\tconst caseSpec = plan.plan.reproduction[0];\n\tconst sideRun = async (side: \"baseline\" | \"candidate\", code: number) => {\tif (!evaluated.ok) throw new Error(`evaluate failed: ${evaluated.error.message}`);\n\tif (evaluated.verdict !== \"passed\") {\n\t\tthrow new Error(`legalPassedChain 未 passed: ${evaluated.verdict}（${evaluated.caseResults.map((r) => r.reason).join(\"；\")}）`,\n\t\t);\n\t}\n\treturn { candidateId, testPlanId, validationId: evaluated.validationId, candidateDir };\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// testing 状态：走 legalPassedChain 会落 passed——改用「freeze+candidate 行」只到 testing。\n\t\tconst sourceId = registerSource(store.db, {sessionId: \"s1\",entryId: \"e-t\",eventType: \"toolResult\",capturedAt: AT});\n\t\tseedLink(store, \"problem\", problemId, sourceId);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,resourceId,baseVersion,paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 在 passed 之后再插一条更新的 failed 验证（最新一条非 passed → 拒绝）。\n\t\tconst sourceId = registerSource(store.db, {entryId: \"e-f\",});\n\t\tstore.db\n\t\t\t.prepare(\t\twriteFileSync(join(versionDir, \"examples\"), \"占位文件\\n\", \"utf8\");\n\n\t\tawait expect(publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 })).rejects.toThrow();\n\n\t\t// 半成品目录被整体清理：版本目录不复存在。\t\t\t.run(resourceId, AT, AT);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion: \"v-000000000000\", action: \"modify\" });\n\t\tconst sourceId = registerSource(store.db, {entryId: \"e-x\",baseVersion: \"v-000000000000\",\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst files = {\"SKILL.md\": \"# code-review\\n步骤一（已修正）\\n\",\"examples/a.md\": \"示例 A\\n\",\"examples/b.md\": \"示例 B\\n\"};\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, {\n\t\t\tproblemId,\t\t// 版本目录与候选目录逐字一致（验证时跑的就是这份内容）。\n\t\tfor (const [rel] of Object.entries(files)) {\n\t\t\texpect(readFileSync(join(result.versionDir, rel), \"utf8\")).toBe(\n\t\t\t\treadFileSync(join(candidateDir, rel), \"utf8\"),\n\t\t\t);\n\t\t}\n\t\tstore.close();\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,119]}}},{"equalLines":{"line_count":29}},{"diffOp":{"equal":{"range":[119,271]}}},{"diffOp":{"delete":{"range":[271,273]}}},{"diffOp":{"insert":{"range":[273,274]}}},{"diffOp":{"equal":{"range":[274,295]}}},{"diffOp":{"delete":{"range":[271,273]}}},{"diffOp":{"insert":{"range":[273,274]}}},{"diffOp":{"equal":{"range":[295,312]}}},{"diffOp":{"delete":{"range":[271,273]}}},{"diffOp":{"insert":{"range":[273,274]}}},{"diffOp":{"equal":{"range":[312,331]}}},{"diffOp":{"delete":{"range":[331,333]}}},{"diffOp":{"insert":{"range":[273,274]}}},{"diffOp":{"equal":{"range":[333,452]}}},{"equalLines":{"line_count":162}},{"diffOp":{"equal":{"range":[452,627]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[627,630]}}},{"diffOp":{"equal":{"range":[630,725]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[729,912]}}},{"equalLines":{"line_count":30}},{"diffOp":{"equal":{"range":[912,1053]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1053,1167]}}},{"diffOp":{"insert":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[1171,1265]}}},{"equalLines":{"line_count":42}},{"diffOp":{"equal":{"range":[1265,1491]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1491,1507]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1507,1522]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1522,1546]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1546,1560]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[1560,1673]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1673,1684]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1684,1696]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1696,1818]}}},{"equalLines":{"line_count":26}},{"diffOp":{"equal":{"range":[1818,2066]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1491,1507]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2066,2081]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1522,1546]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1546,1560]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[2081,2108]}}},{"equalLines":{"line_count":62}},{"diffOp":{"equal":{"range":[2108,2197]}}},{"diffOp":{"delete":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2197,2268]}}},{"diffOp":{"delete":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[2268,2355]}}},{"equalLines":{"line_count":112}},{"diffOp":{"equal":{"range":[2355,2534]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1491,1507]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2534,2549]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1522,1546]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1546,1560]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[1560,1673]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1673,1684]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2549,2579]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[1696,1818]}}},{"equalLines":{"line_count":83}},{"diffOp":{"equal":{"range":[2579,2727]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2727,2783]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2783,2813]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[725,729]}}},{"diffOp":{"equal":{"range":[2813,2842]}}},{"diffOp":{"delete":{"range":[273,274]}}},{"diffOp":{"insert":{"range":[1167,1171]}}},{"diffOp":{"equal":{"range":[2842,2936]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[2936,3137]}}},{"diffOp":{"delete":{"range":[3137,3142]}}},{"diffOp":{"equal":{"range":[3142,3187]}}},{"diffOp":{"delete":{"range":[3187,3192]}}},{"diffOp":{"equal":{"range":[3192,3215]}}},{"equalLines":{"line_count":105}},{"diffOp":{"equal":{"range":[3215,3224]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-version.test.ts"},"span":null,"sourceCode":"/**\n * S9-01 定向测试：固定版本存储（publishCandidate / listResourceVersions / readResourceVersion）。\n *\n * 覆盖：\n * - passed 候选发布成功：版本目录完整 + publish activation 行落库；\n * - 候选未 passed 拒绝（not_ready）；最新验证非 passed 拒绝；\n * - 复制中断不产生可加载版本（半成品目录被清理、无 activation）；\n * - 同一候选重复 publish 幂等（同 versionId 不重复写 activation）；\n * - listResourceVersions 返回时间线；\n * - 旧版本在后续 publish 后仍可读；\n * - 已验证版本文件不被后续候选原位修改（版本目录内容不变）。\n *\n * O11/E08 审计门（publishCandidate 内部）：\n * - 「合法 passed 链」helper（freeze→假双侧 run→evaluate→passed）替代直接\n *   插 passed 行——publish 门要核对 problem/candidate/testPlan/validation\n *   四级来源关联 + 候选目录指纹与验证回执一致，直接插行过不了门。\n * - extension/command 资源 → 能力未接拒发；\n * - 验证后改动候选正文 → 指纹不匹配拒发；\n * - plan.json 被改 → 受管输入核对拒发；\n * - 合法 skill 候选发布文件与已验副本逐字一致。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-version.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\tlistResourceVersions,\n\tpublishCandidate,\n\treadResourceVersion,\n} from \"../../src/pao/evolution/versions.ts\";\nimport type { CardProcessResult } from \"../../src/pao/cards/process.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ver-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 造一个已登记 skill 资源 + baseVersion 快照。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直接插一行 problem（classified）。 */\nfunction seedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string; action?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\tover.action ?? \"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n/** 写一条 evolution_source_links（sourceId 需是已登记 sources 行或不含 src- 前缀）。 */\nfunction seedLink(store: MemoryStore, ownerKind: string, ownerId: string, sourceId: string) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\tlink_id, owner_kind, owner_id, source_id, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`link-${ownerKind}-${ownerId}-${sourceId}`, ownerKind, ownerId, sourceId, AT);\n}\n\n/**\n * O11/E08「合法 passed 链」helper：\n * freeze（含来源关联）→ 候选行+目录+关联 → 双侧 runValidationCase（假\n * processRunner，command 用例，回执带真实指纹）→ evaluate（paoHome 读\n * plan.json）→ passed。替代直接插 passed 行——publish 门核对来源关联与\n * 候选指纹，插假行过不了门。\n */\nasync function legalPassedChain(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tfiles?: Record<string, string>;\n\t\t/** 双侧 run 的退出码（baseline=旧版/candidate=候选）；缺省 baseline=1、candidate=0。 */\n\t\tbaselineCode?: number;\n\t\tcandidateCode?: number;\n\t},\n): Promise<{ candidateId: string; testPlanId: string; validationId: string; candidateDir: string }> {\n\tconst candidateId = over.candidateId ?? `cand-${Math.random().toString(36).slice(2, 8)}`;\n\t// 1. 真实来源行 + problem/candidate 关联（publish 门核对四级关联）。\n\tconst sourceId = registerSource(store.db, {\n\t\tsessionId: \"s1\",\n\t\tentryId: `e-${candidateId}`,\n\t\teventType: \"toolResult\",\n\t\tcapturedAt: AT,\n\t});\n\tseedLink(store, \"problem\", over.problemId, sourceId);\n\n\t// 2. freeze 计划（继承 problem 关联写 validation/testPlan 级 link）。\n\tconst plan = freezeValidationPlan(store, {\n\t\tproblemId: over.problemId,\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tpaoHome: home,\n\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: AT,\n\t});\n\tif (!plan.ok) throw new Error(`freeze failed: ${plan.error.message}`);\n\tconst testPlanId = plan.testPlanId;\n\n\t// 3. 候选行 + 候选目录（候选正文 = baseVersion 文件 + 修正）+ 候选关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'proposed', ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\ttestPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? { \"SKILL.md\": \"# code-review\\n步骤一（已修正）\\n\", \"examples/a.md\": \"示例 A\\n\" };\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\tseedLink(store, \"candidate\", candidateId, sourceId);\n\n\t// 4. 双侧 run：command 用例 + 假 processRunner（不发起真实子进程；\n\t//    回执仍由 runner 真实落盘并带版本副本指纹）。\n\tconst fakeProcess = (code: number): typeof import(\"../../src/pao/cards/process.ts\").runCardProcess =>\n\t\tasync () => ({ code, stdout: \"\", stderr: \"\" }) satisfies CardProcessResult;\n\tconst caseSpec = plan.plan.reproduction[0];\n\tconst sideRun = async (side: \"baseline\" | \"candidate\", code: number) => {\n\t\tconst run = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeProcess(code) },\n\t\t\t{\n\t\t\t\tvalidationCase: caseSpec,\n\t\t\t\tresourceId: over.resourceId,\n\t\t\t\tbaseVersion: over.baseVersion,\n\t\t\t\tside,\n\t\t\t\t...(side === \"candidate\" ? { candidateId } : {}),\n\t\t\t\ttestPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\tif (!run.ok) throw new Error(`run ${side} failed: ${run.error.message}`);\n\t\treturn run.result;\n\t};\n\tconst baseline = await sideRun(\"baseline\", over.baselineCode ?? 1);\n\tconst candidate = await sideRun(\"candidate\", over.candidateCode ?? 0);\n\n\t// 5. evaluate：paoHome 读 plan.json 核对完整集合 → passed。\n\tconst evaluated = evaluateCandidate(store, {\n\t\tcandidateId,\n\t\ttestPlanId,\n\t\tpaoHome: home,\n\t\tcaseResults: [{ caseId: caseSpec.caseId, baseline, candidate, verdict: \"passed\" }],\n\t\tcreatedAt: AT,\n\t});\n\tif (!evaluated.ok) throw new Error(`evaluate failed: ${evaluated.error.message}`);\n\tif (evaluated.verdict !== \"passed\") {\n\t\tthrow new Error(`legalPassedChain 未 passed: ${evaluated.verdict}（${evaluated.caseResults.map((r) => r.reason).join(\"；\")}）`);\n\t}\n\treturn { candidateId, testPlanId, validationId: evaluated.validationId, candidateDir };\n}\n\n// ── publishCandidate ────────────────────────────────────────────────────\n\ndescribe(\"publishCandidate\", () => {\n\tit(\"passed 候选发布成功：版本目录完整 + publish activation 落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\texpect(result.published).toBe(true);\n\t\texpect(result.filesPublished).toBe(2);\n\n\t\t// 版本目录文件完整且内容与候选一致。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst versionDir = join(evolutionPaths(home).versions, dirSafe, result.versionId);\n\t\texpect(readFileSync(join(versionDir, \"SKILL.md\"), \"utf8\")).toContain(\"已修正\");\n\t\texpect(readFileSync(join(versionDir, \"examples\", \"a.md\"), \"utf8\")).toBe(\"示例 A\\n\");\n\n\t\t// publish activation 落库，from_version=候选 baseVersion。\n\t\tconst act = store.db\n\t\t\t.prepare(`SELECT * FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, result.versionId) as {\n\t\t\tkind: string;\n\t\t\tfrom_version: string;\n\t\t\tto_version: string;\n\t\t};\n\t\texpect(act.kind).toBe(\"publish\");\n\t\texpect(act.from_version).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"候选未 passed → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// testing 状态：走 legalPassedChain 会落 passed——改用「freeze+candidate 行」只到 testing。\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-t\", eventType: \"toolResult\", capturedAt: AT });\n\t\tseedLink(store, \"problem\", problemId, sourceId);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, '[]', '', '[]', 'testing', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"cand-testing\", problemId, resourceId, baseVersion, plan.testPlanId, AT, AT);\n\n\t\tconst result = await publishCandidate(store, { candidateId: \"cand-testing\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"passed\");\n\t\tstore.close();\n\t});\n\n\tit(\"最新验证非 passed → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 在 passed 之后再插一条更新的 failed 验证（最新一条非 passed → 拒绝）。\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-f\", eventType: \"toolResult\", capturedAt: AT });\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, (SELECT test_plan_id FROM evolution_candidates WHERE candidate_id = ?), ?, ?, ?, ?, '[]', 'failed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"val-failed-new\", candidateId, candidateId, problemId, resourceId, baseVersion, AT3, AT3);\n\t\tseedLink(store, \"validation\", \"val-failed-new\", sourceId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"failed\");\n\t\tstore.close();\n\t});\n\n\tit(\"候选无验证记录 → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// passed 状态但无 validation 行——直接把状态改成 passed 而无验证记录。\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\tstore.db.prepare(`DELETE FROM evolution_validations WHERE candidate_id = ?`).run(candidateId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"候选目录缺失 → not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\trmSync(candidateDir, { recursive: true, force: true });\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"复制中断不产生可加载版本（半成品目录清理 + 无 activation + 指向不变）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 先正常发布一次拿到 versionId 与 versionDir。\n\t\tconst first = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT });\n\t\texpect(first.ok && \"versionId\" in first).toBe(true);\n\t\tif (!first.ok || !(\"versionId\" in first)) return;\n\t\tconst { versionId, versionDir } = first;\n\n\t\t// 抹掉 activation 并把版本目录中的 `examples` 子目录替换成同名文件：\n\t\t// 再发布同一候选时，复制 `examples/a.md` 会因 dirname 是文件而 throw。\n\t\tstore.db.prepare(`DELETE FROM evolution_activations WHERE to_version = ?`).run(versionId);\n\t\trmSync(join(versionDir, \"examples\"), { recursive: true, force: true });\n\t\twriteFileSync(join(versionDir, \"examples\"), \"占位文件\\n\", \"utf8\");\n\n\t\tawait expect(\n\t\t\tpublishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 }),\n\t\t).rejects.toThrow();\n\n\t\t// 半成品目录被整体清理：版本目录不复存在。\n\t\texpect(existsSync(versionDir)).toBe(false);\n\t\t// 没有写 activation（部分目录不构成可加载版本）。\n\t\tconst acts = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t\t// effective_version 未被改动（仍指向 baseVersion）。\n\t\tconst res = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(res.effective_version).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"半成品版本目录（无 activation）→ readResourceVersion 报不可用但文件可读\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId } = seedSkill(home);\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst halfDir = join(evolutionPaths(home).versions, dirSafe, \"v-halfbaked01\");\n\t\tmkdirSync(halfDir, { recursive: true });\n\t\twriteFileSync(join(halfDir, \"SKILL.md\"), \"partial\\n\", \"utf8\");\n\t\tconst read = readResourceVersion(store, { resourceId, versionId: \"v-halfbaked01\", paoHome: home });\n\t\texpect(read.ok).toBe(true);\n\t\tif (!read.ok) return;\n\t\texpect(read.available).toBe(false);\n\t\texpect(read.files).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"同一候选重复 publish 幂等（同 versionId，不重复写 activation）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst first = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(first.ok).toBe(true);\n\t\tif (!first.ok || !(\"versionId\" in first)) return;\n\n\t\tconst second = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok || !(\"versionId\" in second)) return;\n\t\texpect(second.versionId).toBe(first.versionId);\n\t\texpect(second.published).toBe(false);\n\n\t\t// 只写了一条 publish activation。\n\t\tconst acts = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND to_version = ?`)\n\t\t\t.get(resourceId, first.versionId) as { n: number };\n\t\texpect(acts.n).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"两个不同候选同内容 → 同 versionId 幂等\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst files = { \"SKILL.md\": \"# code-review\\n同一修正\\n\", \"examples/a.md\": \"示例 A\\n\" };\n\t\tconst c1 = await legalPassedChain(store, home, { problemId, resourceId, baseVersion, files });\n\t\tconst c2 = await legalPassedChain(store, home, { problemId, resourceId, baseVersion, files });\n\n\t\tconst r1 = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\tconst r2 = await publishCandidate(store, { candidateId: c2.candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(r1.ok && \"versionId\" in r1).toBe(true);\n\t\texpect(r2.ok && \"versionId\" in r2).toBe(true);\n\t\tif (!r1.ok || !r2.ok || !(\"versionId\" in r1) || !(\"versionId\" in r2)) return;\n\t\texpect(r2.versionId).toBe(r1.versionId);\n\t\texpect(r2.published).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"已验证版本文件不被后续候选原位修改\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst c1 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第一版修正\\n\" },\n\t\t});\n\t\tconst pub = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(pub.ok && \"versionId\" in pub).toBe(true);\n\t\tif (!pub.ok || !(\"versionId\" in pub)) return;\n\t\tconst versionDir = pub.versionDir;\n\n\t\t// 后续候选改动同一资源文件 → 新候选目录是独立目录，版本目录原内容不变。\n\t\tawait legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第二版修正\\n\" },\n\t\t});\n\t\texpect(readFileSync(join(versionDir, \"SKILL.md\"), \"utf8\")).toContain(\"第一版修正\");\n\t\tstore.close();\n\t});\n\n\t// ── O11/E08 审计门反面场景 ────────────────────────────────────────────\n\n\tit(\"O11/E08：extension 资源能力未接 → not_ready（拒发）\", async () => {\n\t\tconst home = tempHome();\n\t\t// 手工插一个 extension 资源行（registerResource 只接 skill 类经登记入口；\n\t\t// extension 行直接插以覆盖「能力未接」分支）。\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resourceId = \"extension:test-ext\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_resources (\n\t\t\t\t\tresource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t) VALUES (?, 'extension', 'extensions/test-ext', '[\"edit-content\"]', '[]', 'extension-path', NULL, 1, ?, ?)`,\n\t\t\t)\n\t\t\t.run(resourceId, AT, AT);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion: \"v-000000000000\", action: \"modify\" });\n\t\tconst sourceId = registerSource(store.db, { sessionId: \"s1\", entryId: \"e-x\", eventType: \"toolResult\", capturedAt: AT });\n\t\tseedLink(store, \"problem\", problemId, sourceId);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion: \"v-000000000000\", paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = \"cand-ext\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, '[]', '', '[]', 'passed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(candidateId, problemId, resourceId, \"v-000000000000\", plan.testPlanId, AT, AT);\n\t\tseedLink(store, \"candidate\", candidateId, sourceId);\n\t\t// 候选目录（能力核对在目录检查之前，但目录要有文件才能到能力步——先给一份）。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\t\tmkdirSync(candidateDir, { recursive: true });\n\t\twriteFileSync(join(candidateDir, \"index.js\"), \"console.log(1)\\n\", \"utf8\");\n\t\t// passed validation 行 + link（能力核对在 validation 存在后、来源核对前）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, '[]', 'passed', ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"val-ext\", plan.testPlanId, candidateId, problemId, resourceId, \"v-000000000000\", AT, AT);\n\t\tseedLink(store, \"validation\", \"val-ext\", sourceId);\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"能力未覆盖\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：验证后改动候选正文 → 指纹不匹配 not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 验证通过后改候选文件 → 当前指纹 ≠ 回执指纹 → 拒发。\n\t\twriteFileSync(join(candidateDir, \"SKILL.md\"), \"# code-review\\n验证后新改动\\n\", \"utf8\");\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\texpect(result.reason).toContain(\"被改动\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：plan.json 被改 → 受管输入核对 not_ready\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId, testPlanId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\n\t\t// 篡改 plan.json（加一条从未冻结的用例——受管输入被修改）。\n\t\tconst planPath = join(evolutionPaths(home).validations, testPlanId, \"plan.json\");\n\t\tconst planJson = JSON.parse(readFileSync(planPath, \"utf8\")) as Record<string, unknown>;\n\t\t(planJson as { holdout: unknown[] }).holdout = [\n\t\t\t{ caseId: \"holdout-0\", group: \"holdout\", input: \"后门\", initialFiles: {}, allowedTools: [], acceptance: \"x\" },\n\t\t];\n\t\twriteFileSync(planPath, JSON.stringify(planJson, null, 2), \"utf8\");\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"not_ready\").toBe(true);\n\t\tif (!(\"status\" in result)) return;\n\t\t// plan.json 实质篡改核对：testPlanId 尾段指纹与重算值对不上即拒发。\n\t\texpect(result.reason).toContain(\"指纹不符\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E08：合法 skill 发布文件与已验副本逐字一致\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst files = { \"SKILL.md\": \"# code-review\\n步骤一（已修正）\\n\", \"examples/a.md\": \"示例 A\\n\", \"examples/b.md\": \"示例 B\\n\" };\n\t\tconst { candidateId, candidateDir } = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles,\n\t\t});\n\n\t\tconst result = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(result.ok && \"versionId\" in result).toBe(true);\n\t\tif (!result.ok || !(\"versionId\" in result)) return;\n\n\t\t// 版本目录与候选目录逐字一致（验证时跑的就是这份内容）。\n\t\tfor (const [rel] of Object.entries(files)) {\n\t\t\texpect(readFileSync(join(result.versionDir, rel), \"utf8\")).toBe(\n\t\t\t\treadFileSync(join(candidateDir, rel), \"utf8\"),\n\t\t\t);\n\t\t}\n\t\tstore.close();\n\t});\n});\n\n// ── listResourceVersions / readResourceVersion ──────────────────────────\n\ndescribe(\"listResourceVersions / readResourceVersion\", () => {\n\tit(\"listResourceVersions 返回时间线（含 baseVersion 快照与已发布版本）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(pub.ok && \"versionId\" in pub).toBe(true);\n\t\tif (!pub.ok || !(\"versionId\" in pub)) return;\n\n\t\tconst list = listResourceVersions(store, resourceId, home);\n\t\texpect(list.ok).toBe(true);\n\t\tif (!list.ok) return;\n\t\t// 时间线含：baseVersion 快照目录（无 activation → 排尾 available=false）\n\t\t// + 已发布版本（有 activation → available=true）。\n\t\tconst published = list.items.find((i) => i.versionId === pub.versionId);\n\t\texpect(published).toBeDefined();\n\t\texpect(published?.available).toBe(true);\n\t\texpect(published?.activation?.kind).toBe(\"publish\");\n\t\tconst base = list.items.find((i) => i.versionId === baseVersion);\n\t\texpect(base).toBeDefined();\n\t\texpect(base?.available).toBe(false); // baseVersion 快照无 activation\n\t\texpect(base?.files.length).toBeGreaterThan(0);\n\t\t// 有 activation 的排在无 activation 之前。\n\t\tconst pubIdx = list.items.findIndex((i) => i.versionId === pub.versionId);\n\t\tconst baseIdx = list.items.findIndex((i) => i.versionId === baseVersion);\n\t\texpect(pubIdx).toBeLessThan(baseIdx);\n\t\tstore.close();\n\t});\n\n\tit(\"旧版本在后续 publish 后仍可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\t// 第一个候选 → 发布 v1。\n\t\tconst c1 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第一版修正\\n\" },\n\t\t});\n\t\tconst p1 = await publishCandidate(store, { candidateId: c1.candidateId, paoHome: home, createdAt: AT2 });\n\t\texpect(p1.ok && \"versionId\" in p1).toBe(true);\n\t\tif (!p1.ok || !(\"versionId\" in p1)) return;\n\t\tconst v1 = p1.versionId;\n\n\t\t// 第二个候选（不同内容）→ 发布 v2。\n\t\tconst c2 = await legalPassedChain(store, home, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tfiles: { \"SKILL.md\": \"# code-review\\n第二版修正\\n\" },\n\t\t});\n\t\tconst p2 = await publishCandidate(store, { candidateId: c2.candidateId, paoHome: home, createdAt: AT3 });\n\t\texpect(p2.ok && \"versionId\" in p2).toBe(true);\n\t\tif (!p2.ok || !(\"versionId\" in p2)) return;\n\t\texpect(p2.versionId).not.toBe(v1);\n\n\t\t// v1 仍可读且内容未被覆盖。\n\t\tconst read1 = readResourceVersion(store, { resourceId, versionId: v1, paoHome: home });\n\t\texpect(read1.ok).toBe(true);\n\t\tif (!read1.ok) return;\n\t\texpect(read1.available).toBe(true);\n\t\tconst skillFile = read1.files.find((f) => f.path === \"SKILL.md\");\n\t\texpect(skillFile?.content).toContain(\"第一版修正\");\n\t\t// v2 也可读，内容独立。\n\t\tconst read2 = readResourceVersion(store, { resourceId, versionId: p2.versionId, paoHome: home });\n\t\texpect(read2.ok).toBe(true);\n\t\tif (!read2.ok) return;\n\t\texpect(read2.files.find((f) => f.path === \"SKILL.md\")?.content).toContain(\"第二版修正\");\n\t\tstore.close();\n\t});\n\n\tit(\"读取不存在版本 → source_missing；非法 versionId → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId } = seedSkill(home);\n\t\tconst missing = readResourceVersion(store, { resourceId, versionId: \"v-000000000000\", paoHome: home });\n\t\texpect(missing.ok).toBe(false);\n\t\tif (missing.ok) return;\n\t\texpect(missing.error.code).toBe(\"source_missing\");\n\n\t\tconst bad = readResourceVersion(store, { resourceId, versionId: \"../escape\", paoHome: home });\n\t\texpect(bad.ok).toBe(false);\n\t\tif (bad.ok) return;\n\t\texpect(bad.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n\n\tit(\"版本目录存在但无 activation → available=false 但文件仍可读\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\t// baseVersion 快照目录存在、无 activation。\n\t\tconst read = readResourceVersion(store, { resourceId, versionId: baseVersion, paoHome: home });\n\t\texpect(read.ok).toBe(true);\n\t\tif (!read.ok) return;\n\t\texpect(read.available).toBe(false);\n\t\texpect(read.files.length).toBeGreaterThan(0);\n\t\texpect(read.files.find((f) => f.path === \"SKILL.md\")?.content).toContain(\"步骤一\");\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * O11/E08 共享夹具：「合法 passed 链」helper。\n *\n\t// 4. 双侧 run：command 用例 + 假 processRunner（回执真实落盘带指纹）。\n\tconst fakeProcess = \n\t\t(code: number): typeof import(\"../../../src/pao/cards/process.ts\").runCardProcess =>\n\t\tasync () =>\n\t\t\t({ code, stdout: \"\", stderr: \"\" }) satisfies CardProcessResult;\n\tconst caseSpec = plan.plan.reproduction[0]!;\n\tconst sideRun = async (side: \"baseline\" | \"candidate\", code: number) => {\treturn { candidateId, testPlanId, validationId: evaluated.validationId, candidateDir };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,65]}}},{"equalLines":{"line_count":148}},{"diffOp":{"equal":{"range":[65,177]}}},{"diffOp":{"delete":{"range":[177,178]}}},{"diffOp":{"insert":{"range":[178,181]}}},{"diffOp":{"equal":{"range":[181,279]}}},{"diffOp":{"delete":{"range":[177,178]}}},{"diffOp":{"insert":{"range":[279,283]}}},{"diffOp":{"equal":{"range":[283,467]}}},{"equalLines":{"line_count":37}},{"diffOp":{"equal":{"range":[467,558]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\fixtures\\evolution-legal-chain.ts"},"span":null,"sourceCode":"/**\n * O11/E08 共享夹具：「合法 passed 链」helper。\n *\n * publish 门（O11/E08）核对四级来源关联 + 候选目录指纹与运行回执绑定 +\n * plan.json 实质指纹，直接插 passed 行过不了门。本 helper 跑真实链：\n *   freeze（含来源关联继承）→ 候选行+目录+关联 → 双侧 runValidationCase\n *   （command 用例 + 假 processRunner，不发真实子进程；回执仍由 runner\n *   真实落盘并带版本副本指纹）→ evaluateCandidate（paoHome 读 plan.json\n *   核对完整集合）→ passed。\n *\n * 各下游测试（activation/binding/control/regression/restart）原先种「tp-1\n * 假计划 + 空回执」的 passed 行，自 O11 起统一走本链；测试关注点仍是\n * publish/activate 之后的行为，不变。\n */\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { CardProcessResult } from \"../../../src/pao/cards/process.ts\";\nimport { evaluateCandidate } from \"../../../src/pao/evolution/evaluate.ts\";\nimport { runValidationCase } from \"../../../src/pao/evolution/runner.ts\";\nimport { freezeValidationPlan } from \"../../../src/pao/evolution/validation.ts\";\nimport { evolutionPaths } from \"../../../src/pao/memory/paths.ts\";\nimport { registerSource } from \"../../../src/pao/memory/sources.ts\";\nimport type { MemoryStore } from \"../../../src/pao/memory/store.ts\";\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\n/** 写一条 evolution_source_links（sourceId 需已登记或不带 src- 前缀）。 */\nexport function seedSourceLink(store: MemoryStore, ownerKind: string, ownerId: string, sourceId: string) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\tlink_id, owner_kind, owner_id, source_id, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`link-${ownerKind}-${ownerId}-${sourceId}`, ownerKind, ownerId, sourceId, AT);\n}\n\n/** 直插 problem 行（classified）+ problem 级来源关联。 */\nexport function seedClassifiedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string } = {},\n): string {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\nexport interface LegalPassedChainResult {\n\tcandidateId: string;\n\ttestPlanId: string;\n\tvalidationId: string;\n\tcandidateDir: string;\n}\n\n/**\n * 跑「freeze → 双侧 run → evaluate」真实链，产出合法 passed 候选。\n *\n * - 注册真实 source 行，problem/candidate/testPlan/validation 四级关联齐备；\n * - 候选目录文件 = over.files（缺省含「已修正」SKILL.md）；\n * - 双侧 command 用例走假 processRunner：baseline 退 baselineCode（缺省 1，\n *   旧版复现失败）、candidate 退 candidateCode（缺省 0）。\n */\nexport async function legalPassedChain(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tfiles?: Record<string, string>;\n\t\tbaselineCode?: number;\n\t\tcandidateCode?: number;\n\t},\n): Promise<LegalPassedChainResult> {\n\tconst candidateId = over.candidateId ?? `cand-${Math.random().toString(36).slice(2, 8)}`;\n\t// 1. 真实来源行 + problem/candidate 关联（publish 门核对四级关联）。\n\tconst sourceId = registerSource(store.db, {\n\t\tsessionId: \"s1\",\n\t\tentryId: `e-${candidateId}`,\n\t\teventType: \"toolResult\",\n\t\tcapturedAt: AT,\n\t});\n\tseedSourceLink(store, \"problem\", over.problemId, sourceId);\n\n\t// 2. freeze（继承 problem 关联写 validation/testPlan 级 link）。\n\tconst plan = freezeValidationPlan(store, {\n\t\tproblemId: over.problemId,\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tpaoHome: home,\n\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: AT,\n\t});\n\tif (!plan.ok) throw new Error(`freeze failed: ${plan.error.message}`);\n\tconst testPlanId = plan.testPlanId;\n\n\t// 3. 候选行 + 候选目录 + 候选关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'proposed', ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\ttestPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\" };\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\tseedSourceLink(store, \"candidate\", candidateId, sourceId);\n\n\t// 4. 双侧 run：command 用例 + 假 processRunner（回执真实落盘带指纹）。\n\tconst fakeProcess = (code: number): typeof import(\"../../../src/pao/cards/process.ts\").runCardProcess =>\n\t\tasync () => ({ code, stdout: \"\", stderr: \"\" }) satisfies CardProcessResult;\n\tconst caseSpec = plan.plan.reproduction[0]!;\n\tconst sideRun = async (side: \"baseline\" | \"candidate\", code: number) => {\n\t\tconst run = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeProcess(code) },\n\t\t\t{\n\t\t\t\tvalidationCase: caseSpec,\n\t\t\t\tresourceId: over.resourceId,\n\t\t\t\tbaseVersion: over.baseVersion,\n\t\t\t\tside,\n\t\t\t\t...(side === \"candidate\" ? { candidateId } : {}),\n\t\t\t\ttestPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\tif (!run.ok) throw new Error(`run ${side} failed: ${run.error.message}`);\n\t\treturn run.result;\n\t};\n\tconst baseline = await sideRun(\"baseline\", over.baselineCode ?? 1);\n\tconst candidate = await sideRun(\"candidate\", over.candidateCode ?? 0);\n\n\t// 5. evaluate：paoHome 读 plan.json 核对完整集合 → passed（写 validation\n\t//    行 + 继承关联）。\n\tconst evaluated = evaluateCandidate(store, {\n\t\tcandidateId,\n\t\ttestPlanId,\n\t\tpaoHome: home,\n\t\tcaseResults: [{ caseId: caseSpec.caseId, baseline, candidate, verdict: \"passed\" }],\n\t\tcreatedAt: AT,\n\t});\n\tif (!evaluated.ok) throw new Error(`evaluate failed: ${evaluated.error.message}`);\n\tif (evaluated.verdict !== \"passed\") {\n\t\tthrow new Error(\n\t\t\t`legalPassedChain 未 passed: ${evaluated.verdict}（${evaluated.caseResults.map((r) => r.reason).join(\"；\")}）`,\n\t\t);\n\t}\n\treturn { candidateId, testPlanId, validationId: evaluated.validationId, candidateDir };\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * O10/E01 测试夹具：造一个带 evolve handler 的 MaintenanceSchedulerDeps.handlers。\n *\toptions: EvolveHandlerFixtureOptions,\n): Partial<Record<\"evolve\", MaintenanceHandler>> {\n\tconst evolve: MaintenanceHandler = async (\n\t\tctx: ExtensionContext, job: ExtractionJob,deps: MaintenanceSchedulerDeps,signal: AbortSignal,\n\t) => {\n\t\tconst scope = parseEvolveJobScope(job.sourceScope);\n\t\tif (scope === undefined) {\t\t});\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems SET status = 'development_suggestion', disposition = 'development_suggestion', reason = ?, updated_at = ? WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(reason, now(), problemId);\n\t\treturn problemId;\n\tconst problem = store.db\n\t\t.prepare(`SELECT expected_behavior, actual_behavior, summary, base_version, evidence_refs_json FROM evolution_problems WHERE problem_id = ?`)\n\t\t.get(problemId) as\n\t\t| {expected_behavior: string;actual_behavior: string;summary: string;base_version: string | null;evidence_refs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (problem === undefined || problem.base_version === null) {\t\tbaseVersion: problem.base_version,\n\t\tpaoHome: over.paoHome,\n\t\treproduction: [{ input: problem.actual_behavior, initialFiles: {}, allowedTools: [], acceptance: problem.expected_behavior }],\n\t\tnormal: [],\n\t\tholdout: [],\t}\n\n\tconst proposed = await proposeCandidate(store,{\n\t\tmodelRegistry: over.ctx.modelRegistry,\n\t\tledger: over.ledger,\n\t\tpaoHome: over.paoHome,\n\t\tbudgetPaoHome: over.paoHome,\n\t\toutboundProjects: [over.outboundProject],\n\t\ttierConfig: over.tierConfig,\n\t\toutbound: over.outbound,\n\t\tbudget: { jobId: over.job.jobId, kind: \"evolve\" },\n\t},problemId,\n\t\tresourceId: resource.resourceId,\n\t\tbaseVersion: problem.base_version,\n\t\ttestPlanId: frozen.testPlanId,\n\t\tallowedFiles: [],\n\t\tdevCases: [{ input: problem.actual_behavior, failure: problem.actual_behavior, expected: problem.expected_behavior }signal: over.signal,\n\t\tcreatedAt: now(),\n\t);\n\tif (!proposed.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\t\tfor (const side of [\"baseline\", \"candidate\"] as const) {\n\t\t\tif (over.signal.aborted) return { aborted: true as const, fileChanges };\n\t\t\tconst run = await runValidationCase({\n\t\t\t\t...(over.agentSessionFactory ? { agentSessionFactory: over.agentSessionFactory } : {}),\n\t\t\t\t...(over.processRunner ? { processRunner: over.processRunner } : {}),\n\t\t\tvalidationCase,\n\t\t\t\tresourceId: resource.resourceId,\n\t\t\t\tbaseVersion: problem.base_version!,\n\t\t\t\tside,\n\t\t\t\t...(side === \"candidate\" ? { candidateId } : {}),\n\t\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\t\tpaoHome: over.paoHome,\n\t\t\t\tkind: over.agentSessionFactory ? \"agent\" : \"command\",\n\t\t\t\t// command 用例需 verifier（假 processRunner 注入时命令不实际执行，\n\t\t\t\t// 但字段须完整才走得到 command 分支）。\n\t\t\t\t...(over.agentSessionFactory ? {} : { verifier: { cmd: \"node\", args: [\"check.js\"] } }),\n\t\t\t\tloadMethod: resource.loadMethod,\n\t\t\t\tsignal: over.signal,\n\t\t\t\ttimeoutMs: 120000,\n\t\t\t\trunAt: now(),\n\t\t\t);\n\t\t\tif (!run.ok) {\n\t\t\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\treturn problemId;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":56}},{"diffOp":{"equal":{"range":[101,234]}}},{"diffOp":{"insert":{"range":[234,237]}}},{"diffOp":{"equal":{"range":[237,259]}}},{"diffOp":{"delete":{"range":[259,260]}}},{"diffOp":{"insert":{"range":[234,237]}}},{"diffOp":{"equal":{"range":[260,279]}}},{"diffOp":{"delete":{"range":[259,260]}}},{"diffOp":{"insert":{"range":[234,237]}}},{"diffOp":{"equal":{