":[512,513]}}},{"diffOp":{"delete":{"range":[820,956]}}},{"diffOp":{"insert":{"range":[956,969]}}},{"diffOp":{"equal":{"range":[969,979]}}},{"diffOp":{"delete":{"range":[668,676]}}},{"diffOp":{"insert":{"range":[767,779]}}},{"diffOp":{"equal":{"range":[431,433]}}},{"diffOp":{"equal":{"range":[979,993]}}},{"diffOp":{"delete":{"range":[993,1006]}}},{"diffOp":{"insert":{"range":[820,956]}}},{"diffOp":{"equal":{"range":[969,977]}}},{"diffOp":{"delete":{"range":[758,759]}}},{"diffOp":{"equal":{"range":[758,759]}}},{"diffOp":{"delete":{"range":[1006,1013]}}},{"diffOp":{"equal":{"range":[1013,1024]}}},{"diffOp":{"equal":{"range":[459,467]}}},{"diffOp":{"delete":{"range":[365,370]}}},{"diffOp":{"equal":{"range":[512,514]}}},{"diffOp":{"delete":{"range":[579,590]}}},{"diffOp":{"insert":{"range":[779,798]}}},{"diffOp":{"equal":{"range":[798,807]}}},{"diffOp":{"delete":{"range":[758,759]}}},{"diffOp":{"equal":{"range":[758,760]}}},{"diffOp":{"delete":{"range":[1024,1039]}}},{"diffOp":{"insert":{"range":[809,820]}}},{"diffOp":{"equal":{"range":[431,433]}}},{"diffOp":{"equal":{"range":[1039,1260]}}},{"equalLines":{"line_count":795}},{"diffOp":{"equal":{"range":[1260,1266]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[1554,1595],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/suspicious/noImplicitAnyLet","severity":"error","description":"This variable implicitly has the any type.","message":[{"elements":[],"content":"This variable implicitly has the "},{"elements":["Emphasis"],"content":"any"},{"elements":[],"content":" type."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Variable declarations without type annotation and initialization implicitly have the "},{"elements":["Emphasis"],"content":"any"},{"elements":[],"content":" type. Declare a type or initialize the variable with some value."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[27360,27367],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n *import { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";setAutoEvolutiongetResource,  } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[51,174]}}},{"diffOp":{"equal":{"range":[174,182]}}},{"diffOp":{"delete":{"range":[182,187]}}},{"diffOp":{"equal":{"range":[187,188]}}},{"diffOp":{"delete":{"range":[188,201]}}},{"diffOp":{"equal":{"range":[188,189]}}},{"diffOp":{"delete":{"range":[201,213]}}},{"diffOp":{"insert":{"range":[213,227]}}},{"diffOp":{"equal":{"range":[227,246]}}},{"diffOp":{"delete":{"range":[246,254]}}},{"diffOp":{"insert":{"range":[254,262]}}},{"diffOp":{"equal":{"range":[262,264]}}},{"diffOp":{"equal":{"range":[264,319]}}},{"diffOp":{"equal":{"range":[264,272]}}},{"diffOp":{"insert":{"range":[182,187]}}},{"diffOp":{"equal":{"range":[319,321]}}},{"diffOp":{"delete":{"range":[213,227]}}},{"diffOp":{"insert":{"range":[321,346]}}},{"diffOp":{"equal":{"range":[227,246]}}},{"diffOp":{"delete":{"range":[254,262]}}},{"diffOp":{"insert":{"range":[246,254]}}},{"diffOp":{"equal":{"range":[262,264]}}},{"diffOp":{"equal":{"range":[346,406]}}},{"diffOp":{"equal":{"range":[346,356]}}},{"diffOp":{"delete":{"range":[406,422]}}},{"diffOp":{"insert":{"range":[422,433]}}},{"diffOp":{"equal":{"range":[433,435]}}},{"diffOp":{"delete":{"range":[422,433]}}},{"diffOp":{"insert":{"range":[406,422]}}},{"diffOp":{"equal":{"range":[435,460]}}},{"diffOp":{"equal":{"range":[460,570]}}},{"equalLines":{"line_count":425}},{"diffOp":{"equal":{"range":[570,576]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":[1475,1516],"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n *\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions,dirSafeId(input.resourceId),input.targetVersionId);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":220}},{"diffOp":{"equal":{"range":[51,135]}}},{"diffOp":{"delete":{"range":[135,139]}}},{"diffOp":{"equal":{"range":[139,235]}}},{"diffOp":{"delete":{"range":[235,239]}}},{"diffOp":{"equal":{"range":[239,263]}}},{"diffOp":{"delete":{"range":[263,267]}}},{"diffOp":{"equal":{"range":[267,334]}}},{"diffOp":{"delete":{"range":[263,266]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[334,440]}}},{"equalLines":{"line_count":55}},{"diffOp":{"equal":{"range":[440,628]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[637,704]}}},{"equalLines":{"line_count":3}},{"diffOp":{"equal":{"range":[704,858]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[858,1013]}}},{"diffOp":{"delete":{"range":[263,266]}}},{"diffOp":{"equal":{"range":[1013,1052]}}},{"diffOp":{"delete":{"range":[263,266]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[1052,1080]}}},{"diffOp":{"delete":{"range":[263,266]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[1080,1101]}}},{"diffOp":{"delete":{"range":[235,238]}}},{"diffOp":{"equal":{"range":[1101,1179]}}},{"equalLines":{"line_count":3}},{"diffOp":{"equal":{"range":[1179,1441]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[858,925]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[1441,1681]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[858,925]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[1681,1810]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[628,633]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[858,925]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[1810,1986]}}},{"diffOp":{"delete":{"range":[1986,1992]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[633,637]}}},{"diffOp":{"delete":{"range":[1986,1992]}}},{"diffOp":{"insert":{"range":[267,268]}}},{"diffOp":{"equal":{"range":[1992,2106]}}},{"equalLines":{"line_count":91}},{"diffOp":{"equal":{"range":[2106,2112]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":null,"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *import { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\n\ttype ValidationPlan,\n\ttype ValidationRunResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[57,184]}}},{"diffOp":{"equal":{"range":[184,192]}}},{"diffOp":{"delete":{"range":[192,197]}}},{"diffOp":{"equal":{"range":[197,198]}}},{"diffOp":{"delete":{"range":[198,211]}}},{"diffOp":{"equal":{"range":[198,199]}}},{"diffOp":{"delete":{"range":[211,223]}}},{"diffOp":{"insert":{"range":[223,237]}}},{"diffOp":{"equal":{"range":[237,256]}}},{"diffOp":{"delete":{"range":[256,264]}}},{"diffOp":{"insert":{"range":[264,272]}}},{"diffOp":{"equal":{"range":[272,274]}}},{"diffOp":{"equal":{"range":[274,329]}}},{"diffOp":{"equal":{"range":[274,282]}}},{"diffOp":{"insert":{"range":[192,197]}}},{"diffOp":{"equal":{"range":[329,331]}}},{"diffOp":{"delete":{"range":[223,237]}}},{"diffOp":{"insert":{"range":[331,356]}}},{"diffOp":{"equal":{"range":[237,256]}}},{"diffOp":{"delete":{"range":[264,272]}}},{"diffOp":{"insert":{"range":[256,264]}}},{"diffOp":{"equal":{"range":[272,274]}}},{"diffOp":{"equal":{"range":[356,367]}}},{"diffOp":{"delete":{"range":[367,398]}}},{"diffOp":{"equal":{"range":[398,453]}}},{"diffOp":{"insert":{"range":[367,398]}}},{"diffOp":{"equal":{"range":[453,549]}}},{"diffOp":{"equal":{"range":[549,770]}}},{"equalLines":{"line_count":537}},{"diffOp":{"equal":{"range":[770,776]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\evaluate.ts"},"span":[1461,1502],"sourceCode":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *\n * 职责：\n * - `evaluateCandidate`：同一 testPlan 分别绑定 baseline 和 candidate 运行结果，\n *   逐项比较预期行为、输出、退出码和受影响文件。\n * - 判定规则（S8 任务书 §5）：\n *   **原问题从失败到通过 + 关键正常用法及保留样例全部通过 + 范围检查通过 → `passed`**；\n *   启动失败/环境缺依赖/进程停止未确认 → `incomplete`（保留原因并停止发布）；\n *   业务结果不符 → `failed`。\n * - 候选定稿后才运行独立保留样例（reproduction+normal 在定稿前跑，\n *   holdout 在定稿后跑——由调用方传入的 caseResults 分组保证）。\n * - 模型随机性使同一用例前后结论矛盾时才补做该用例成对运行；\n *   证据仍不稳定则不宣称改善。\n * - 总分仅用于报告，不能覆盖关键失败；开发样例通过不直接标 passed。\n * - 完整费用归因到该候选（evolution_candidates.usage_refs_json 追加）；\n *   写 evolution_validations 行 + evolution_source_links（owner_kind='validation'）。\n * - 推进 candidate 状态机 proposed→testing→passed|failed|cancelled。\n *\n * 契约（S8-11）：\n * - `passed ≠ active`；不自动发布正式资源。\n * - 验证失败/取消/额度不足分别写状态，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\n\ttype ValidationPlan,\n\ttype ValidationRunResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `evaluateCandidate` 的输入：调用方已跑完 baseline/candidate 对照，逐项组装结果。 */\nexport interface EvaluateCandidateInput {\n\t/** 已生成候选 ID。 */\n\tcandidateId: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/**\n\t * PAO_HOME 根（O11/E06）：eval 读取 `<paoHome>/evolution/validations/\n\t * <testPlanId>/plan.json` 核对结果完整集合（plan 每个 caseId×side 都要有\n\t * 回执）。与 `plan` 互斥——注入其一即可。\n\t */\n\tpaoHome?: string;\n\t/** 直接注入计划对象（测试夹具可传；与 paoHome 互斥）。 */\n\tplan?: ValidationPlan;\n\t/** 逐项对照结果：reproduction + normal 在候选定稿前已跑完；holdout 在定稿后跑完。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 总费用/用量引用（候选生成+验证的全部 usageRefs 汇总）。 */\n\ttotalUsageRef?: string;\n\t/** 评估时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/**\n\t * 是否补做过成对运行（同 case 前后矛盾时由调用方重跑并替换旧结果）。\n\t * 补做后仍不稳定的用例在 verdict 标 incomplete 而非宣称改善。\n\t */\n\trepairedContradictions?: boolean;\n\t/** 来源引用（写入 evolution_source_links owner_kind='validation'）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `evaluateCandidate` 的输出。 */\nexport interface EvaluateCandidateResult {\n\t/** 验证记录 ID（evolution_validations.validation_id）。 */\n\tvalidationId: string;\n\t/** 总体判定。 */\n\tverdict: \"passed\" | \"failed\" | \"incomplete\";\n\t/** 逐项判定汇总（与输入 caseResults 一致）。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 各组通过率（报告用，不覆盖关键失败）。 */\n\tscore: {\n\t\treproduction: { passed: number; failed: number; incomplete: number; total: number };\n\t\tnormal: { passed: number; failed: number; incomplete: number; total: number };\n\t\tholdout: { passed: number; failed: number; incomplete: number; total: number };\n\t\t/** 总分：仅作报告摘要，不用于覆盖关键失败。 */\n\t\ttotal: { passed: number; failed: number; incomplete: number; total: number };\n\t};\n\t/** 完整验证记录。 */\n\tvalidation: EvolutionValidation;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 判定一个用例是否「关键失败」：reproduction 组失败 + normal/holdout 组任何非 passed。 */\nfunction isCriticalFailure(result: ValidationCaseResult): boolean {\n\tif (result.verdict === \"incomplete\") return true;\n\tif (result.verdict === \"failed\") {\n\t\t// reproduction 组失败永远是关键失败；normal/holdout 组失败也是关键失败。\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n/** 逐组统计通过率。 */\nfunction computeScore(caseResults: ValidationCaseResult[]): EvaluateCandidateResult[\"score\"] {\n\tconst group = (name: string) => {\n\t\tconst items = caseResults.filter((r) => r.caseId.startsWith(`${name}-`));\n\t\treturn {\n\t\t\tpassed: items.filter((r) => r.verdict === \"passed\").length,\n\t\t\tfailed: items.filter((r) => r.verdict === \"failed\").length,\n\t\t\tincomplete: items.filter((r) => r.verdict === \"incomplete\").length,\n\t\t\ttotal: items.length,\n\t\t};\n\t};\n\tconst reproduction = group(\"reproduction\");\n\tconst normal = group(\"normal\");\n\tconst holdout = group(\"holdout\");\n\tconst total = {\n\t\tpassed: reproduction.passed + normal.passed + holdout.passed,\n\t\tfailed: reproduction.failed + normal.failed + holdout.failed,\n\t\tincomplete: reproduction.incomplete + normal.incomplete + holdout.incomplete,\n\t\ttotal: reproduction.total + normal.total + holdout.total,\n\t};\n\treturn { reproduction, normal, holdout, total };\n}\n\n/**\n * 判断运行结果是否为「环境/启动失败」（O11/E07）：\n * 凭结构化 `executionFailure` 字段判定（start/timeout/cancel），不再靠\n * output/exitCode 启发式——启动失败/超时的进程也可能带 output 和 exitCode\n * （如 127/124），启发式会把启动故障误当业务失败或通过。\n * 环境失败标 incomplete，不画成业务失败或通过。\n */\nfunction isEnvironmentFailure(run: ValidationRunResult): boolean {\n\treturn run.executionFailure !== undefined;\n}\n\n/**\n * 读取冻结计划（O11/E06）：plan 对象优先，其次 `<paoHome>/evolution/\n * validations/<testPlanId>/plan.json`；都拿不到返回 undefined。\n */\nfunction readValidationPlan(input: EvaluateCandidateInput): ValidationPlan | undefined {\n\tif (input.plan !== undefined) return input.plan;\n\tif (input.paoHome === undefined) return undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, input.testPlanId, \"plan.json\");\n\tif (!existsSync(planPath)) return undefined;\n\ttry {\n\t\treturn JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/** plan 全部 caseId（三组展开）。 */\nfunction planCaseIds(plan: ValidationPlan): string[] {\n\treturn [...plan.reproduction, ...plan.normal, ...plan.holdout].map((c) => c.caseId);\n}\n\n/**\n * 解析 validation 的 sourceRefs（O12/E11）：显式传入优先；否则先取候选自身\n * links（O12 起 proposeCandidate 已从 problem 继承），候选无 links 时回退\n * problem 的 links（兼容 O12 之前生成的旧候选行）。\n */\nfunction resolveValidationSourceRefs(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): Array<{ sourceId: string; memoryId?: string; revision?: number }> {\n\tif (input.sourceRefs !== undefined) return input.sourceRefs;\n\tconst problemId = (\n\t\tstore.db\n\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { problem_id: string } | undefined\n\t)?.problem_id;\n\tconst readLinks = (ownerKind: string, ownerId: string) =>\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(ownerKind, ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\tlet rows = readLinks(\"candidate\", input.candidateId);\n\tif (rows.length === 0 && problemId !== undefined) rows = readLinks(\"problem\", problemId);\n\treturn rows.map((link) => ({\n\t\tsourceId: link.source_id,\n\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t}));\n}\n\n/**\n * O11/E06：完整集合不齐时收尾——写一条 verdict=incomplete 的验证记录，\n * 逐项 caseResults 原样落库，候选状态推 cancelled，返回 incomplete。\n * 不抛错（这是业务结论「验收不完整」，不是系统故障）。\n */\nfunction completeWithIncompleteVerdict(\n\tstore: MemoryStore,\n\tover: {\n\t\tcandidateId: string;\n\t\ttestPlanId: string;\n\t\tcandidateRow: { problem_id: string; resource_id: string; base_version: string; usage_refs_json: string };\n\t\tcurrentStatus: string;\n\t\tcaseResults: ValidationCaseResult[];\n\t\treason: string;\n\t\ttotalUsageRef?: string;\n\t\tsourceRefs: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n\t\tnow: string;\n\t},\n): MemoryResult<EvaluateCandidateResult> {\n\tconst validationId = `val-${randomUUID()}`;\n\tconst normalized = over.caseResults.map((r) => ({\n\t\t...r,\n\t\tverdict: \"incomplete\" as const,\n\t\treason: r.reason ?? `回执不完整:${over.reason}`,\n\t}));\n\tconst score = computeScore(normalized);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: over.testPlanId,\n\t\tcandidateId: over.candidateId,\n\t\tproblemId: over.candidateRow.problem_id,\n\t\tresourceId: over.candidateRow.resource_id,\n\t\tbaseVersion: over.candidateRow.base_version,\n\t\tcaseResults: normalized,\n\t\tverdict: \"incomplete\",\n\t\t...(over.totalUsageRef === undefined ? {} : { totalUsageRef: over.totalUsageRef }),\n\t\tcreatedAt: over.now,\n\t\tupdatedAt: over.now,\n\t};\n\tconst candidateUsageRefs = JSON.parse(over.candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs =\n\t\tover.totalUsageRef !== undefined ? [...new Set([...candidateUsageRefs, over.totalUsageRef])] : candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tover.testPlanId,\n\t\t\t\tover.candidateId,\n\t\t\t\tover.candidateRow.problem_id,\n\t\t\t\tover.candidateRow.resource_id,\n\t\t\t\tover.candidateRow.base_version,\n\t\t\t\tJSON.stringify(normalized),\n\t\t\t\t\"incomplete\",\n\t\t\t\tover.totalUsageRef ?? null,\n\t\t\t\tover.now,\n\t\t\t\tover.now,\n\t\t\t);\n\t\tfor (const ref of over.sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tover.now,\n\t\t\t\t);\n\t\t}\n\t\tif (over.currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(over.now, over.candidateId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = 'cancelled', failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(`验证未完成:${over.reason}`, JSON.stringify(nextUsageRefs), over.now, over.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict: \"incomplete\",\n\t\tcaseResults: normalized,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 逐项评估候选：原问题改善且关键正常/保留样例通过才 passed。\n *\n * 判定：\n * - 任一 incomplete → 总体 incomplete（保留原因并停止发布）。\n * - reproduction 组未全部从失败到通过 → failed（即使总分提高也不宣称改善）。\n * - normal/holdout 组任一失败 → failed（关键用法退步）。\n * - reproduction+normal+holdout 全部通过 + 范围检查通过 → passed。\n *\n * 开发样例通过不直接标 passed（开发样例是 devCases，不是验收样例）。\n */\nexport function evaluateCandidate(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): MemoryResult<EvaluateCandidateResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst validationId = `val-${randomUUID()}`;\n\n\t// 1. 校验 candidate：必须存在且状态允许进入 testing。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, usage_refs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tusage_refs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.test_plan_id !== input.testPlanId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 登记的 testPlanId 与输入不一致`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst currentStatus = candidateRow.status as import(\"./types.ts\").EvolutionCandidateStatus;\n\tif (!isCandidateTransitionAllowed(currentStatus, \"testing\")) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 状态 ${currentStatus} 不允许进入 testing`,\n\t\t\tinput.candidateId,\n\t\t);\n\t}\n\n\t// 1b. O11/E06：核对冻结计划完整集合——plan 每个 caseId×side 都要有回执。\n\t// 空集、缺项、未知/重复 caseId 一律不接受（标 incomplete 不落 passed）。\n\tif (input.caseResults.length === 0) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`caseResults 为空集——空验收不允许 passed（E06：plan 每个 caseId 双侧回执必须齐全）`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst plan = readValidationPlan(input);\n\tconst completenessViolations: string[] = [];\n\tif (plan === undefined) {\n\t\tcompletenessViolations.push(\n\t\t\t`未提供 plan（注入 paoHome 或 plan 对象）且读不到 plan.json，无法核对完整集合`,\n\t\t);\n\t} else {\n\t\tconst expectedIds = planCaseIds(plan);\n\t\tconst seen = new Map<string, number>();\n\t\tfor (const r of input.caseResults) {\n\t\t\tseen.set(r.caseId, (seen.get(r.caseId) ?? 0) + 1);\n\t\t\tif (!expectedIds.includes(r.caseId)) {\n\t\t\t\tcompletenessViolations.push(`未知 caseId:${r.caseId}（不在冻结计划内）`);\n\t\t\t}\n\t\t}\n\t\tfor (const [caseId, count] of seen) {\n\t\t\tif (count > 1) completenessViolations.push(`重复 caseId:${caseId}（出现 ${count} 次）`);\n\t\t}\n\t\tfor (const caseId of expectedIds) {\n\t\t\tif (!seen.has(caseId)) completenessViolations.push(`缺 caseId:${caseId} 的回执（漏跑/未交付）`);\n\t\t}\n\t}\n\tif (completenessViolations.length > 0) {\n\t\t// 完整集合不齐 → 不落 passed：写一条 incomplete 验证记录并把候选标 cancelled。\n\t\treturn completeWithIncompleteVerdict(store, {\n\t\t\tcandidateId: input.candidateId,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tcandidateRow,\n\t\t\tcurrentStatus,\n\t\t\tcaseResults: input.caseResults,\n\t\t\treason: completenessViolations.join(\"；\"),\n\t\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\t\tsourceRefs: resolveValidationSourceRefs(store, input),\n\t\t\tnow,\n\t\t});\n\t}\n\n\t// 2. 逐项判定：环境失败标 incomplete；reproduction 组必须「失败→通过」才算改善。\n\t//    逐项 verdict 已由调用方给定（调用方跑完 baseline/candidate 后组装），\n\t//    这里核对每个 case 的判定一致性：若某项 baseline 也 passed，\n\t//    reproduction 组不能宣称「修复了原问题」。\n\tconst normalizedCaseResults: ValidationCaseResult[] = input.caseResults.map((result) => {\n\t\t// 环境失败统一标 incomplete（不画成业务失败或通过）。\n\t\tif (isEnvironmentFailure(result.baseline) || isEnvironmentFailure(result.candidate)) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\treason: result.reason ?? `环境/启动失败:${result.baseline.failureReason ?? result.candidate.failureReason ?? \"进程停止未确认\"}`,\n\t\t\t};\n\t\t}\n\t\t// 调用方已标 incomplete（不稳定/无法定论，如补做成对运行后仍矛盾）\n\t\t// 不升级为 failed——incomplete 是「证据不足」结论，不是「候选未过」；\n\t\t// 本层只对「调用方没下结论或结论与双侧结果矛盾」的项做判定。\n\t\tif (result.verdict === \"incomplete\") {\n\t\t\treturn { ...result, verdict: \"incomplete\" as const };\n\t\t}\n\t\t// reproduction 组：baseline 必须先真失败，candidate 后通过才算修复。\n\t\tif (result.caseId.startsWith(\"reproduction-\")) {\n\t\t\tif (result.baseline.passed === true) {\n\t\t\t\t// baseline 未失败——复现不了原问题，验证前提不成立，标 incomplete 而非宣称改善。\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\t\treason: result.reason ?? \"baseline 未复现原问题（baseline.passed=true），验证前提不成立\",\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (result.candidate.passed !== true) {\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\t\treason: result.reason ?? \"原问题未修复：候选未通过复现样例\",\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn { ...result, verdict: \"passed\" as const };\n\t\t}\n\t\t// normal / holdout 组：candidate 未通过即关键失败。\n\t\tif (result.candidate.passed !== true) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\treason: result.reason ?? `候选未通过${result.caseId.startsWith(\"normal-\") ? \"正常用法\" : \"保留\"}样例`,\n\t\t\t};\n\t\t}\n\t\treturn { ...result, verdict: \"passed\" as const };\n\t});\n\n\t// 3. 总体判定：任一 incomplete → incomplete；任一关键失败 → failed；全过 → passed。\n\tconst hasIncomplete = normalizedCaseResults.some((r) => r.verdict === \"incomplete\");\n\tconst hasFailed = normalizedCaseResults.some((r) => r.verdict === \"failed\");\n\tlet verdict: EvolutionValidation[\"verdict\"];\n\tif (hasIncomplete) {\n\t\tverdict = \"incomplete\";\n\t} else if (hasFailed) {\n\t\tverdict = \"failed\";\n\t} else {\n\t\tverdict = \"passed\";\n\t}\n\n\t// 补做成对运行后仍不稳定（有 incomplete）→ 不宣称改善，保留 incomplete 结论。\n\t// 调用方传入 repairedContradictions=true 时，若结果仍含 incomplete，\n\t// 说明证据不稳定，verdict 保持 incomplete（已由上面逻辑覆盖）。\n\n\tconst score = computeScore(normalizedCaseResults);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: input.testPlanId,\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\tcaseResults: normalizedCaseResults,\n\t\tverdict,\n\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\n\t// 4. 写库：evolution_validations 行 + evolution_source_links + 候选状态推进。\n\t//    完整费用归因到该候选（usage_refs_json 追加）。\n\tconst sourceRefs = resolveValidationSourceRefs(store, input);\n\tconst candidateUsageRefs = JSON.parse(candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs = input.totalUsageRef !== undefined\n\t\t? [...new Set([...candidateUsageRefs, input.totalUsageRef])]\n\t\t: candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\t// evolution_validations 行：候选 ID 此时已存在（外键满足）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tinput.candidateId,\n\t\t\t\tcandidateRow.problem_id,\n\t\t\t\tcandidateRow.resource_id,\n\t\t\t\tcandidateRow.base_version,\n\t\t\t\tJSON.stringify(normalizedCaseResults),\n\t\t\t\tverdict,\n\t\t\t\tinput.totalUsageRef ?? null,\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 来源关联：evolution_source_links owner_kind='validation'。\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\n\t\t// 候选状态推进：proposed → testing → passed | failed | cancelled。\n\t\t// 先推到 testing（若尚未在 testing），再推到终态。\n\t\tif (currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(now, input.candidateId);\n\t\t}\n\t\tconst nextCandidateStatus =\n\t\t\tverdict === \"passed\" ? \"passed\" : verdict === \"failed\" ? \"failed\" : \"cancelled\";\n\t\t// 状态机校验：testing → passed|failed|cancelled 全部合法。\n\t\tconst statusBeforeUpdate = currentStatus === \"proposed\" ? \"testing\" : currentStatus;\n\t\tif (!isCandidateTransitionAllowed(statusBeforeUpdate, nextCandidateStatus)) {\n\t\t\tthrow new Error(\n\t\t\t\t`候选 ${input.candidateId} 状态机不允许 ${statusBeforeUpdate} → ${nextCandidateStatus}`,\n\t\t\t);\n\t\t}\n\t\tconst failureReason =\n\t\t\tverdict === \"incomplete\"\n\t\t\t\t? `验证未完成:${normalizedCaseResults.find((r) => r.verdict === \"incomplete\")?.reason ?? \"环境/启动失败\"}`\n\t\t\t\t: verdict === \"failed\"\n\t\t\t\t\t? `验证失败:${normalizedCaseResults.find((r) => r.verdict === \"failed\")?.reason ?? \"业务结果不符\"}`\n\t\t\t\t\t: null;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = ?, failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(nextCandidateStatus, failureReason, JSON.stringify(nextUsageRefs), now, input.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict,\n\t\tcaseResults: normalizedCaseResults,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *\tif (input.sourceRefs !== undefined) return input.sourceRefs;\n\tconst problemId = (\n\t\tstore.db\n\t\t\t.preparestore.db.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as\n\t\t\t| { problem_id: string }| undefined\n\t)?.problem_id;\n\tconst readLinks = (ownerKind: string, ownerId: string) =>\t}\n\tif (candidateRow.test_plan_id !== input.testPlanId) {\n\t\treturn fail(\"invalid_input\",`候选 ${input.candidateId} 登记的 testPlanId 与输入不一致`,input.testPlanId,\n\t\t);\n\t}\n\tconst currentStatus = candidateRow.status as import(\"./types.ts\").EvolutionCandidateStatus;\tconst completenessViolations: string[] = [];\n\tif (plan === undefined) {\n\t\tcompletenessViolations.push(`未提供 plan（注入 paoHome 或 plan 对象）且读不到 plan.json，无法核对完整集合`);\n\t} else {\n\t\tconst expectedIds = planCaseIds(plan);\t\t\t\t...result,\n\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\treason:\n\t\t\t\t\tresult.reason ??`环境/启动失败:${result.baseline.failureReason ?? result.candidate.failureReason ?? \"进程停止未确认\"}`,\n\t\t\t};\n\t\t}\tconst sourceRefs = resolveValidationSourceRefs(store, input);\n\tconst candidateUsageRefs = JSON.parse(candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs =input.totalUsageRef !== undefined\n\t\t? [...new Set([...candidateUsageRefs, input.totalUsageRef])]\n\t\t: candidateUsageRefs;\n\n\tstore.transaction(() => {\t\t\t\t.run(now, input.candidateId);\n\t\t}\n\t\tconst nextCandidateStatus =verdict === \"passed\" ? \"passed\" : verdict === \"failed\" ? \"failed\" : \"cancelled\";\n\t\t// 状态机校验：testing → passed|failed|cancelled 全部合法。\n\t\tconst statusBeforeUpdate = currentStatus === \"proposed\" ? \"testing\" : currentStatus;\n\t\tif (!isCandidateTransitionAllowed(statusBeforeUpdate, nextCandidateStatus)) {\n\t\t\tthrow new Error(`候选 ${input.candidateId} 状态机不允许 ${statusBeforeUpdate} → ${nextCandidateStatus}`,\n\t\t\t);\n\t\t}\n\t\tconst failureReason =\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":171}},{"diffOp":{"equal":{"range":[57,142]}}},{"diffOp":{"delete":{"range":[142,162]}}},{"diffOp":{"insert":{"range":[162,178]}}},{"diffOp":{"equal":{"range":[178,248]}}},{"diffOp":{"delete":{"range":[248,252]}}},{"diffOp":{"equal":{"range":[252,278]}}},{"diffOp":{"insert":{"range":[278,283]}}},{"diffOp":{"equal":{"range":[283,306]}}},{"diffOp":{"delete":{"range":[283,284]}}},{"diffOp":{"insert":{"range":[278,282]}}},{"diffOp":{"equal":{"range":[306,392]}}},{"equalLines":{"line_count":165}},{"diffOp":{"equal":{"range":[392,464]}}},{"diffOp":{"delete":{"range":[278,282]}}},{"diffOp":{"equal":{"range":[4