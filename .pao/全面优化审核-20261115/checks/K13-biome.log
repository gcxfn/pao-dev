e":[2378,2379]}}},{"diffOp":{"equal":{"range":[13236,13267]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[13267,13292]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14012,14085]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14085,14130]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14130,14207]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14207,14236]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14236,14265]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[14265,14352]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[5824,5857]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[5857,5884]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[5996,6053]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[4216,4220]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}},{"diffOp":{"equal":{"range":[3095,3098]}}},{"diffOp":{"delete":{"range":[2374,2376]}}},{"diffOp":{"insert":{"range":[2378,2379]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o13.test.ts"},"span":null,"sourceCode":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\n *\r\n * 覆盖（对应 O13 任务书 §测试与回归）：\r\n * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出\r\n *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。\r\n * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→\r\n *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后\r\n *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。\r\n * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。\r\n * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression\r\n *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。\r\n * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。\r\n *\r\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { afterEach, describe, expect, it } from \"vitest\";\r\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\r\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\r\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\r\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\r\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\r\nimport { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";\r\nimport { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";\r\nimport { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";\r\nimport { handleRegression } from \"../../src/pao/evolution/regression.ts\";\r\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\r\nimport { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\nconst tempDirs: string[] = [];\r\nconst openStores: MemoryStore[] = [];\r\n\r\nfunction tempHome(): string {\r\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\r\n\ttempDirs.push(dir);\r\n\treturn dir;\r\n}\r\nfunction openStore(home: string): MemoryStore {\r\n\tconst store = openMemoryStore(home, \"readwrite\");\r\n\topenStores.push(store);\r\n\treturn store;\r\n}\r\nafterEach(async () => {\r\n\tfor (const store of openStores.splice(0)) {\r\n\t\ttry {\r\n\t\t\tstore.close();\r\n\t\t} catch {\r\n\t\t\t// 已关\r\n\t\t}\r\n\t}\r\n\tfor (const dir of tempDirs.splice(0)) {\r\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(dir, { recursive: true, force: true });\r\n\t\t\t\tbreak;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tif (attempt === 4) throw error;\r\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\nconst AT = \"2026-11-11T10:00:00.000Z\";\r\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\r\n\r\n/** 种一个已登记 skill 资源 + baseVersion 快照。 */\r\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\r\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\r\n\tmkdirSync(skillDir, { recursive: true });\r\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\r\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\r\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\r\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\r\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\r\n}\r\n\r\n/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */\r\nasync function runRound(\r\n\thome: string,\r\n\tstore: MemoryStore,\r\n\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },\r\n) {\r\n\tconst problemId = seedClassifiedProblem(store, {\r\n\t\tproblemId: `prob-${over.name}`,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t});\r\n\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\tproblemId,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t\tfiles: { \"SKILL.md\": over.newContent },\r\n\t});\r\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\tconst act = await activateCandidate(store, {\r\n\t\tcandidateId,\r\n\t\texpectedEffectiveVersion: over.expectedEffective,\r\n\t\tpaoHome: home,\r\n\t\tcreatedAt: AT2,\r\n\t});\r\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\r\n\treturn { candidateId, versionId: act.versionId };\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E14 新任务初始绑定\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E14 ensureTaskBindings\", () => {\r\n\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\r\n\t\t// task_bindings 行已落。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.ok && bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"无登记资源 → 空清单不建绑定\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths).toEqual([]);\r\n\t\texpect(ensured.mounted).toEqual([]);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(0);\r\n\t});\r\n\r\n\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 首轮 ensure。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\t// 激活新版 → effective 变。\r\n\t\tawait runRound(home, store, {\r\n\t\t\tname: \"r2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tseedSkill(home, store, \"skill-a\");\r\n\t\tseedSkill(home, store, \"skill-b\");\r\n\t\tconst ensured = ensureTaskBindings(store, {\r\n\t\t\ttaskId: \"worker-1\",\r\n\t\t\tpaoHome: home,\r\n\t\t\tresourceIds: [\"skill:skill-a\"],\r\n\t\t});\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E15 激活基线分离（两轮进化）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E15 两轮进化基线分离\", () => {\r\n\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 第一轮 v1。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 资源根不动（不回写正式资源根）。\r\n\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\r\n\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\r\n\t\tconst r2 = await runRound(home, store, {\r\n\t\t\tname: \"v2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion: r1.versionId,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\r\n\t\t\texpectedEffective: r1.versionId,\r\n\t\t});\r\n\t\texpect(r2.versionId).not.toBe(r1.versionId);\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(r2.versionId);\r\n\t});\r\n\r\n\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\r\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\r\n\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\r\n\t\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\t\tproblemId,\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\r\n\t\t});\r\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\t\tconst act = await activateCandidate(store, {\r\n\t\t\tcandidateId,\r\n\t\t\texpectedEffectiveVersion: baseVersion,\r\n\t\t\tpaoHome: home,\r\n\t\t\tcreatedAt: AT2,\r\n\t\t});\r\n\t\texpect(act.ok).toBe(true);\r\n\t\tif (!act.ok) return;\r\n\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\r\n\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\r\n\t\tif (\"status\" in act && act.status === \"conflict\") {\r\n\t\t\texpect(act.reason).toContain(\"根基线\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-06 使用观察（recordUsed 挂点语义）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-06 recordUsed 挂点语义\", () => {\r\n\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\tconst written = recordUsed(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tsessionId: \"sess-1\",\r\n\t\t\treceiptRef: \"session:sess-1:settled:1\",\r\n\t\t\toutcome: \"success\",\r\n\t\t});\r\n\t\texpect(written.ok).toBe(true);\r\n\t\tif (!written.ok) return;\r\n\t\texpect(written.versionId).toBe(baseVersion);\r\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\r\n\t\texpect(counts.ok).toBe(true);\r\n\t\tif (counts.ok) {\r\n\t\t\texpect(counts.used).toBe(1);\r\n\t\t\texpect(counts.success).toBe(1);\r\n\t\t}\r\n\t});\r\n\r\n\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId } = seedSkill(home, store);\r\n\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\r\n\t\texpect(written.ok).toBe(false);\r\n\t\tif (written.ok) return;\r\n\t\texpect(written.error.code).toBe(\"invalid_input\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-08/09 退步回退编排\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-08/09 handleRegression 编排\", () => {\r\n\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 会话绑定到 v1。\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\tproblemId: \"prob-v1\",\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tfailureDescription: \"v1 上线后功能坏\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t\t// effective 回退到上一有效版（baseVersion）。\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(baseVersion);\r\n\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\r\n\t\texpect(regression.affectedTasks.length).toBe(1);\r\n\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\r\n\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\r\n\t\t// 受影响任务换绑定到回退目标（宿主消费）。\r\n\t\tswitchTaskResourceAtSafePoint(store, {\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tresourceId,\r\n\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\r\n\t\t\treason: \"退步回退\",\r\n\t\t});\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\r\n\t\t// 坏版上有 used 行。\r\n\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-2\",\r\n\t\t\tfailureDescription: \"v1 用着坏了\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-11 启动恢复（跨进程一致）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-11 启动恢复\", () => {\r\n\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\t// 进程 A：写入绑定 + 激活。\r\n\t\t{\r\n\t\t\tconst storeA = openStore(home);\r\n\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\r\n\t\t\tawait runRound(home, storeA, {\r\n\t\t\t\tname: \"v1\",\r\n\t\t\t\tresourceId,\r\n\t\t\t\tbaseVersion,\r\n\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\t\texpectedEffective: baseVersion,\r\n\t\t\t});\r\n\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\r\n\t\t}\r\n\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\r\n\t\tconst storeB = openStore(home);\r\n\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\texpect(report.resources.length).toBe(1);\r\n\t\texpect(report.resources[0]!.dirOk).toBe(true);\r\n\t\texpect(report.needsAttention).toEqual([]);\r\n\t\t// 绑定仍在且指 effective 版。\r\n\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\tconst effective = (storeB.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(bindings.items[0]!.resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t});\r\n\r\n\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\r\n\t\t// 删版本目录。\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\r\n\t\tconst report = recoverEvolutionState(store, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\r\n\t\texpect(view!.staleBindings.length).toBe(1);\r\n\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\r\n\t\texpect(attn).toBeDefined();\r\n\t\t// 绑定行未被改动。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n});\r\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore \n\tassertCandidatePathsWithinScope,\n\tassertCandidateWithinScope,\n\tcheckForbiddenTarget,\n\tFORBIDDEN_EVOLUTION_TARGETS,\n\tresolveEvolutionResource,\n} from \"../../src/pao/memoryevolutionstore.tspolicy.ts\";\nimport {\n\tFORBIDDEN_EVOLUTION_TARGETSlistResources,\n\tassertCandidatePathsWithinScoperegisterResourceassertCandidateWithinScopesetAutoEvolutioncheckForbiddenTargetsnapshotResourceFiles\tresolveEvolutionResource,\n} from \"../../src/pao/evolution/resources.ts\n\tlistResources,\n\tregisterResource,\n\tsetAutoEvolution,\n\tsnapshotResourceFiles formatResourceId parseResourceId types.ts\nimport { formatResourceId, parseResourceIdopenMemoryStore } from \"../../src/pao/\n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[73,198]}}},{"diffOp":{"equal":{"range":[198,207]}}},{"diffOp":{"delete":{"range":[207,224]}}},{"diffOp":{"insert":{"range":[224,368]}}},{"diffOp":{"equal":{"range":[368,390]}}},{"diffOp":{"delete":{"range":[390,396]}}},{"diffOp":{"insert":{"range":[396,405]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[405,413]}}},{"diffOp":{"insert":{"range":[413,422]}}},{"diffOp":{"equal":{"range":[422,424]}}},{"diffOp":{"equal":{"range":[424,435]}}},{"diffOp":{"delete":{"range":[435,462]}}},{"diffOp":{"insert":{"range":[462,475]}}},{"diffOp":{"equal":{"range":[475,478]}}},{"diffOp":{"delete":{"range":[478,509]}}},{"diffOp":{"insert":{"range":[509,525]}}},{"diffOp":{"equal":{"range":[475,478]}}},{"diffOp":{"delete":{"range":[525,551]}}},{"diffOp":{"insert":{"range":[551,567]}}},{"diffOp":{"equal":{"range":[475,478]}}},{"diffOp":{"delete":{"range":[567,587]}}},{"diffOp":{"insert":{"range":[587,608]}}},{"diffOp":{"equal":{"range":[475,477]}}},{"diffOp":{"delete":{"range":[608,635]}}},{"diffOp":{"equal":{"range":[635,667]}}},{"diffOp":{"delete":{"range":[413,422]}}},{"diffOp":{"insert":{"range":[667,679]}}},{"diffOp":{"equal":{"range":[422,424]}}},{"diffOp":{"equal":{"range":[424,433]}}},{"diffOp":{"delete":{"range":[679,756]}}},{"diffOp":{"insert":{"range":[756,773]}}},{"diffOp":{"equal":{"range":[475,476]}}},{"diffOp":{"delete":{"range":[424,425]}}},{"diffOp":{"insert":{"range":[773,790]}}},{"diffOp":{"equal":{"range":[635,667]}}},{"diffOp":{"delete":{"range":[667,679]}}},{"diffOp":{"insert":{"range":[790,798]}}},{"diffOp":{"equal":{"range":[422,424]}}},{"diffOp":{"equal":{"range":[798,808]}}},{"diffOp":{"delete":{"range":[808,841]}}},{"diffOp":{"insert":{"range":[841,856]}}},{"diffOp":{"equal":{"range":[856,879]}}},{"diffOp":{"delete":{"range":[396,405]}}},{"diffOp":{"insert":{"range":[390,396]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[790,798]}}},{"diffOp":{"insert":{"range":[405,413]}}},{"diffOp":{"equal":{"range":[422,424]}}},{"diffOp":{"equal":{"range":[879,911]}}},{"equalLines":{"line_count":419}},{"diffOp":{"equal":{"range":[911,920]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-policy.test.ts"},"span":[859,931],"sourceCode":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *\n * 覆盖：\n * - resolveEvolutionResource：授权类别映射 resourceId/资源根/允许操作；\n *   未授权类别返回拒绝；空目标名拒绝。\n * - assertCandidateWithinScope：候选文件必须在资源根内；越界（改核心、\n *   表结构、权限、预算、加载机制）被拒且给理由；策略引用不能扩大授权。\n * - registerResource/getResource/listResources：登记幂等（不重复请求\n *   已授予类别）；未登记 resourceId 返回拒绝。\n * - snapshotResourceFiles：列出当前文件及哈希，生成 baseVersion 底座。\n * - setAutoEvolution：单独停用/恢复某资源。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-policy.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport {\n\tFORBIDDEN_EVOLUTION_TARGETS,\n\tassertCandidatePathsWithinScope,\n\tassertCandidateWithinScope,\n\tcheckForbiddenTarget,\n\tresolveEvolutionResource,\n} from \"../../src/pao/evolution/policy.ts\";\nimport {\n\tlistResources,\n\tregisterResource,\n\tsetAutoEvolution,\n\tsnapshotResourceFiles,\n} from \"../../src/pao/evolution/resources.ts\";\nimport { formatResourceId, parseResourceId } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\n// ════════════════════════════════════════════════════════════════════════\n// resolveEvolutionResource\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resolveEvolutionResource\", () => {\n\tit(\"授权类别映射为 resourceId/资源根/允许操作\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"skill:code-review\");\n\t\texpect(result.relativeRoot).toBe(\"pao配置/skills/code-review\");\n\t\texpect(result.allowedOps).toEqual([\"edit-content\"]);\n\t\texpect(result.loadMethod).toBe(\"skill-path\");\n\t\texpect(result.absoluteRoot).toBe(join(home, \"pao配置/skills/code-review\"));\n\t});\n\n\tit(\"recipe 类别映射到部门配方路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"recipe:研发部\");\n\t\texpect(result.relativeRoot).toBe(\"部门/研发部/配方.md\");\n\t});\n\n\tit(\"memory-policy 类别映射到 memory/ 策略路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"memory-policy:recall\");\n\t\texpect(result.relativeRoot).toBe(\"memory/recall\");\n\t\texpect(result.allowedOps).toEqual([\"adjust-policy\"]);\n\t});\n\n\tit(\"未授权类别返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"kernel\" as never, name: \"core\", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"未授权的进化资源类别\");\n\t});\n\n\tit(\"空目标名返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"  \", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// parseResourceId / formatResourceId\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resourceId 解析与组装\", () => {\n\tit(\"合法 resourceId 解析成功\", () => {\n\t\texpect(parseResourceId(\"skill:code-review\")).toEqual({ kind: \"skill\", name: \"code-review\" });\n\t\texpect(parseResourceId(\"memory-policy:recall\")).toEqual({ kind: \"memory-policy\", name: \"recall\" });\n\t});\n\n\tit(\"非法 resourceId 返回 undefined\", () => {\n\t\texpect(parseResourceId(\"noskill:x\")).toBeUndefined();\n\t\texpect(parseResourceId(\"skill\")).toBeUndefined();\n\t\texpect(parseResourceId(\"\")).toBeUndefined();\n\t});\n\n\tit(\"formatResourceId 组装正确\", () => {\n\t\texpect(formatResourceId(\"skill\", \"a\")).toBe(\"skill:a\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// checkForbiddenTarget\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"checkForbiddenTarget\", () => {\n\tit(\"固定禁止对象命中并给出理由\", () => {\n\t\tconst cases: Array<[string, string]> = [\n\t\t\t[\"src/pao/role.ts\", \"权限/角色门控\"],\n\t\t\t[\"pao配置/档位.json\", \"档位配置数值\"],\n\t\t\t[\"pao配置/记忆后台预算.json\", \"记忆后台预算\"],\n\t\t\t[\"memory/memory.sqlite\", \"表结构\"],\n\t\t\t[\"src/core/resource-loader.ts\", \"资源加载与更新机制\"],\n\t\t\t[\"plans/未來.md\", \"正式决定/计划文件\"],\n\t\t];\n\t\tfor (const [path, fragment] of cases) {\n\t\t\tconst reason = checkForbiddenTarget(path);\n\t\t\texpect(reason, `path=${path}`).toBeDefined();\n\t\t\texpect(reason).toContain(fragment);\n\t\t}\n\t});\n\n\tit(\"资源根内普通文件不命中禁止对象\", () => {\n\t\texpect(checkForbiddenTarget(\"pao配置/skills/code-review/SKILL.md\")).toBeUndefined();\n\t\texpect(checkForbiddenTarget(\"部门/研发部/配方.md\")).toBeUndefined();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// assertCandidateWithinScope\n// ════════════════════════════════════════════════════════════════════════\n\nfunction skillResource(paoHome: string, name = \"code-review\") {\n\tconst result = registerResource(openMemoryStore(paoHome, \"readwrite\"), {\n\t\tkind: \"skill\",\n\t\tname,\n\t\tpaoHome,\n\t});\n\tif (!result.ok) throw new Error(\"registerResource failed\");\n\treturn result;\n}\n\ndescribe(\"assertCandidateWithinScope\", () => {\n\tit(\"资源根内文件通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [\n\t\t\t\t{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" },\n\t\t\t\t{ path: \"pao配置/skills/code-review/examples/a.md\", kind: \"edit\" },\n\t\t\t],\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"改内核源码被拒且给理由\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"src/pao/role.ts\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"权限/角色门控\");\n\t\tstore.close();\n\t});\n\n\tit(\"改表结构文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/memory.sqlite\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"表结构\");\n\t\tstore.close();\n\t});\n\n\tit(\"改预算配置被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/记忆后台预算.json\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"记忆后台预算\");\n\t\tstore.close();\n\t});\n\n\tit(\"超出资源根的文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/other-skill/SKILL.md\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"策略引用超出能力范围被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/recall/policy.json\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"表结构\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出记忆策略能力范围\");\n\t\tstore.close();\n\t});\n\n\tit(\"非 memory-policy 类别传 policyRefs 被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"检索参数\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"非记忆策略类别\");\n\t\tstore.close();\n\t});\n\n\tit(\"assertCandidatePathsWithinScope 简版路径检查\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst ok = assertCandidatePathsWithinScope(resource, [\"pao配置/skills/code-review/SKILL.md\"]);\n\t\texpect(ok.ok).toBe(true);\n\t\tconst bad = assertCandidatePathsWithinScope(resource, [\"src/pao/role.ts\"]);\n\t\texpect(bad.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// registerResource / getResource / listResources / setAutoEvolution\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"资源登记与开关\", () => {\n\tit(\"登记后 getResource 可读，listResources 可按类别过滤\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst skill = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst recipe = registerResource(store, { kind: \"recipe\", name: \"b\", paoHome: home });\n\t\texpect(skill.ok && recipe.ok).toBe(true);\n\n\t\tconst got = store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number };\n\t\texpect(got.n).toBe(2);\n\n\t\tconst all = listResources(store);\n\t\texpect(all.ok && all.items.length).toBe(2);\n\t\tconst skillsOnly = listResources(store, \"skill\");\n\t\texpect(skillsOnly.ok && skillsOnly.items.length).toBe(1);\n\t\texpect(skillsOnly.ok && skillsOnly.items[0].resourceId).toBe(\"skill:a\");\n\t\tstore.close();\n\t});\n\n\tit(\"重复登记返回已有记录，不重复请求已授予类别\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst first = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\tconst second = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\texpect(first.ok && second.ok).toBe(true);\n\t\tif (!first.ok || !second.ok) return;\n\t\texpect(second.resourceId).toBe(first.resourceId);\n\t\texpect(second.registeredAt).toBe(first.registeredAt);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记 resourceId 返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst result = store.db\n\t\t\t.prepare(\"SELECT resource_id FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:ghost\");\n\t\texpect(result).toBeUndefined();\n\t\tconst got = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\texpect(got.ok).toBe(true);\n\t\t// getResource 对未登记 ID 走 invalid_input\n\t\tconst missing = listResources(store, \"extension\");\n\t\texpect(missing.ok && missing.items.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"setAutoEvolution 单独停用/恢复某资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst disabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: false, updatedAt: AT });\n\t\texpect(disabled.ok && disabled.autoEvolutionEnabled).toBe(false);\n\t\tconst enabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: true, updatedAt: AT });\n\t\texpect(enabled.ok && enabled.autoEvolutionEnabled).toBe(true);\n\t\tconst missing = setAutoEvolution(store, { resourceId: \"skill:ghost\", enabled: false });\n\t\texpect(missing.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// snapshotResourceFiles\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"snapshotResourceFiles\", () => {\n\tit(\"登记资源后快照列出文件及哈希，生成 baseVersion 底座\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t// 造一个真实技能目录\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"code-review\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\t\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\t\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\t\tregisterResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:code-review\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(2);\n\t\texpect(snap.files.map((f) => f.path).sort()).toEqual([\"SKILL.md\", \"examples/a.md\"].sort());\n\t\texpect(snap.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 版本底座已写库\n\t\tconst row = store.db\n\t\t\t.prepare(\"SELECT effective_version FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:code-review\") as { effective_version: string };\n\t\texpect(row.effective_version).toBe(snap.versionId);\n\t\tstore.close();\n\t});\n\n\tit(\"资源目录不存在时返回空清单（不伪造文件）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"ghost\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记资源快照返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home });\n\t\texpect(snap.ok).toBe(false);\n\t\tif (snap.ok) return;\n\t\texpect(snap.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E12：文件型 relative_root（template/recipe 单文件）快照不抛 ENOTDIR\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\n\t\t// template → 工作流/{name}.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"工作流\"), { recursive: true });\n\t\twriteFileSync(join(home, \"工作流\", \"复盘.md\"), \"# 复盘\\n步骤一\\n\", \"utf8\");\n\t\tconst regT = registerResource(store, { kind: \"template\", name: \"复盘\", paoHome: home });\n\t\texpect(regT.ok).toBe(true);\n\t\tconst snapT = snapshotResourceFiles(store, { resourceId: \"template:复盘\", paoHome: home, createdAt: AT });\n\t\texpect(snapT.ok).toBe(true);\n\t\tif (!snapT.ok) return;\n\t\texpect(snapT.files.length).toBe(1);\n\t\texpect(snapT.files[0].path).toBe(\"复盘.md\");\n\t\texpect(snapT.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 快照落盘在 <home>/evolution/versions/<dirSafeResourceId>/<versionId>/<basename>。\n\t\tconst { existsSync } = require(\"node:fs\") as typeof import(\"node:fs\");\n\t\texpect(\n\t\t\texistsSync(join(home, \"evolution\", \"versions\", \"template_复盘\", snapT.versionId, \"复盘.md\")),\n\t\t).toBe(true);\n\n\t\t// recipe → 部门/{name}/配方.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"部门\", \"研发部\"), { recursive: true });\n\t\twriteFileSync(join(home, \"部门\", \"研发部\", \"配方.md\"), \"# 研发部配方\\n\", \"utf8\");\n\t\tconst regR = registerResource(store, { kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(regR.ok).toBe(true);\n\t\tconst snapR = snapshotResourceFiles(store, { resourceId: \"recipe:研发部\", paoHome: home, createdAt: AT });\n\t\texpect(snapR.ok).toBe(true);\n\t\tif (!snapR.ok) return;\n\t\texpect(snapR.files.length).toBe(1);\n\t\texpect(snapR.files[0].path).toBe(\"配方.md\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 固定禁止对象清单完整性\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"固定禁止对象清单\", () => {\n\tit(\"清单包含任务书 §2 全部类别\", () => {\n\t\tconst expected = [\n\t\t\t\"src/\",\n\t\t\t\"memory/memory.sqlite\",\n\t\t\t\"src/pao/role.ts\",\n\t\t\t\"pao配置/档位.json\",\n\t\t\t\"pao配置/记忆后台预算.json\",\n\t\t\t\"src/core/resource-loader.ts\",\n\t\t\t\"plans/\",\n\t\t];\n\t\tfor (const item of expected) {\n\t\t\texpect(FORBIDDEN_EVOLUTION_TARGETS).toContain(item);\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *\t\t// 快照落盘在 <home>/evolution/versions/<dirSafeResourceId>/<versionId>/<basename>。\n\t\tconst { existsSync } = require(\"node:fs\") as typeof import(\"node:fs\");\n\t\texpect(\n\t\t\texistsSync(join(home, \"evolution\", \"versions\", \"template_复盘\", snapT.versionId, \"复盘.md\")),\n\t\t).toBe(true);\n\n\t\t// recipe → 部门/{name}/配方.md（单文件相对根）。\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":414}},{"diffOp":{"equal":{"range":[73,248]}}},{"diffOp":{"delete":{"range":[248,252]}}},{"diffOp":{"equal":{"range":[252,348]}}},{"diffOp":{"delete":{"range":[348,352]}}},{"diffOp":{"equal":{"range":[352,433]}}},{"equalLines":{"line_count":31}},{"diffOp":{"equal":{"range":[433,442]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-policy.test.ts"},"span":null,"sourceCode":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *\n * 覆盖：\n * - resolveEvolutionResource：授权类别映射 resourceId/资源根/允许操作；\n *   未授权类别返回拒绝；空目标名拒绝。\n * - assertCandidateWithinScope：候选文件必须在资源根内；越界（改核心、\n *   表结构、权限、预算、加载机制）被拒且给理由；策略引用不能扩大授权。\n * - registerResource/getResource/listResources：登记幂等（不重复请求\n *   已授予类别）；未登记 resourceId 返回拒绝。\n * - snapshotResourceFiles：列出当前文件及哈希，生成 baseVersion 底座。\n * - setAutoEvolution：单独停用/恢复某资源。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-policy.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport {\n\tFORBIDDEN_EVOLUTION_TARGETS,\n\tassertCandidatePathsWithinScope,\n\tassertCandidateWithinScope,\n\tcheckForbiddenTarget,\n\tresolveEvolutionResource,\n} from \"../../src/pao/evolution/policy.ts\";\nimport {\n\tlistResources,\n\tregisterResource,\n\tsetAutoEvolution,\n\tsnapshotResourceFiles,\n} from \"../../src/pao/evolution/resources.ts\";\nimport { formatResourceId, parseResourceId } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\n// ════════════════════════════════════════════════════════════════════════\n// resolveEvolutionResource\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resolveEvolutionResource\", () => {\n\tit(\"授权类别映射为 resourceId/资源根/允许操作\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"skill:code-review\");\n\t\texpect(result.relativeRoot).toBe(\"pao配置/skills/code-review\");\n\t\texpect(result.allowedOps).toEqual([\"edit-content\"]);\n\t\texpect(result.loadMethod).toBe(\"skill-path\");\n\t\texpect(result.absoluteRoot).toBe(join(home, \"pao配置/skills/code-review\"));\n\t});\n\n\tit(\"recipe 类别映射到部门配方路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"recipe:研发部\");\n\t\texpect(result.relativeRoot).toBe(\"部门/研发部/配方.md\");\n\t});\n\n\tit(\"memory-policy 类别映射到 memory/ 策略路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"memory-policy:recall\");\n\t\texpect(result.relativeRoot).toBe(\"memory/recall\");\n\t\texpect(result.allowedOps).toEqual([\"adjust-policy\"]);\n\t});\n\n\tit(\"未授权类别返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"kernel\" as never, name: \"core\", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"未授权的进化资源类别\");\n\t});\n\n\tit(\"空目标名返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"  \", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// parseResourceId / formatResourceId\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resourceId 解析与组装\", () => {\n\tit(\"合法 resourceId 解析成功\", () => {\n\t\texpect(parseResourceId(\"skill:code-review\")).toEqual({ kind: \"skill\", name: \"code-review\" });\n\t\texpect(parseResourceId(\"memory-policy:recall\")).toEqual({ kind: \"memory-policy\", name: \"recall\" });\n\t});\n\n\tit(\"非法 resourceId 返回 undefined\", () => {\n\t\texpect(parseResourceId(\"noskill:x\")).toBeUndefined();\n\t\texpect(parseResourceId(\"skill\")).toBeUndefined();\n\t\texpect(parseResourceId(\"\")).toBeUndefined();\n\t});\n\n\tit(\"formatResourceId 组装正确\", () => {\n\t\texpect(formatResourceId(\"skill\", \"a\")).toBe(\"skill:a\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// checkForbiddenTarget\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"checkForbiddenTarget\", () => {\n\tit(\"固定禁止对象命中并给出理由\", () => {\n\t\tconst cases: Array<[string, string]> = [\n\t\t\t[\"src/pao/role.ts\", \"权限/角色门控\"],\n\t\t\t[\"pao配置/档位.json\", \"档位配置数值\"],\n\t\t\t[\"pao配置/记忆后台预算.json\", \"记忆后台预算\"],\n\t\t\t[\"memory/memory.sqlite\", \"表结构\"],\n\t\t\t[\"src/core/resource-loader.ts\", \"资源加载与更新机制\"],\n\t\t\t[\"plans/未來.md\", \"正式决定/计划文件\"],\n\t\t];\n\t\tfor (const [path, fragment] of cases) {\n\t\t\tconst reason = checkForbiddenTarget(path);\n\t\t\texpect(reason, `path=${path}`).toBeDefined();\n\t\t\texpect(reason).toContain(fragment);\n\t\t}\n\t});\n\n\tit(\"资源根内普通文件不命中禁止对象\", () => {\n\t\texpect(checkForbiddenTarget(\"pao配置/skills/code-review/SKILL.md\")).toBeUndefined();\n\t\texpect(checkForbiddenTarget(\"部门/研发部/配方.md\")).toBeUndefined();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// assertCandidateWithinScope\n// ════════════════════════════════════════════════════════════════════════\n\nfunction skillResource(paoHome: string, name = \"code-review\") {\n\tconst result = registerResource(openMemoryStore(paoHome, \"readwrite\"), {\n\t\tkind: \"skill\",\n\t\tname,\n\t\tpaoHome,\n\t});\n\tif (!result.ok) throw new Error(\"registerResource failed\");\n\treturn result;\n}\n\ndescribe(\"assertCandidateWithinScope\", () => {\n\tit(\"资源根内文件通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [\n\t\t\t\t{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" },\n\t\t\t\t{ path: \"pao配置/skills/code-review/examples/a.md\", kind: \"edit\" },\n\t\t\t],\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"改内核源码被拒且给理由\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"src/pao/role.ts\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"权限/角色门控\");\n\t\tstore.close();\n\t});\n\n\tit(\"改表结构文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/memory.sqlite\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"表结构\");\n\t\tstore.close();\n\t});\n\n\tit(\"改预算配置被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/记忆后台预算.json\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"记忆后台预算\");\n\t\tstore.close();\n\t});\n\n\tit(\"超出资源根的文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/other-skill/SKILL.md\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"策略引用超出能力范围被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/recall/policy.json\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"表结构\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出记忆策略能力范围\");\n\t\tstore.close();\n\t});\n\n\tit(\"非 memory-policy 类别传 policyRefs 被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"检索参数\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"非记忆策略类别\");\n\t\tstore.close();\n\t});\n\n\tit(\"assertCandidatePathsWithinScope 简版路径检查\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst ok = assertCandidatePathsWithinScope(resource, [\"pao配置/skills/code-review/SKILL.md\"]);\n\t\texpect(ok.ok).toBe(true);\n\t\tconst bad = assertCandidatePathsWithinScope(resource, [\"src/pao/role.ts\"]);\n\t\texpect(bad.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// registerResource / getResource / listResources / setAutoEvolution\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"资源登记与开关\", () => {\n\tit(\"登记后 getResource 可读，listResources 可按类别过滤\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst skill = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst recipe = registerResource(store, { kind: \"recipe\", name: \"b\", paoHome: home });\n\t\texpect(skill.ok && recipe.ok).toBe(true);\n\n\t\tconst got = store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number };\n\t\texpect(got.n).toBe(2);\n\n\t\tconst all = listResources(store);\n\t\texpect(all.ok && all.items.length).toBe(2);\n\t\tconst skillsOnly = listResources(store, \"skill\");\n\t\texpect(skillsOnly.ok && skillsOnly.items.length).toBe(1);\n\t\texpect(skillsOnly.ok && skillsOnly.items[0].resourceId).toBe(\"skill:a\");\n\t\tstore.close();\n\t});\n\n\tit(\"重复登记返回已有记录，不重复请求已授予类别\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst first = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\tconst second = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\texpect(first.ok && second.ok).toBe(true);\n\t\tif (!first.ok || !second.ok) return;\n\t\texpect(second.resourceId).toBe(first.resourceId);\n\t\texpect(second.registeredAt).toBe(first.registeredAt);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记 resourceId 返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst result = store.db\n\t\t\t.prepare(\"SELECT resource_id FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:ghost\");\n\t\texpect(result).toBeUndefined();\n\t\tconst got = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\texpect(got.ok).toBe(true);\n\t\t// getResource 对未登记 ID 走 invalid_input\n\t\tconst missing = listResources(store, \"extension\");\n\t\texpect(missing.ok && missing.items.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"setAutoEvolution 单独停用/恢复某资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst disabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: false, updatedAt: AT });\n\t\texpect(disabled.ok && disabled.autoEvolutionEnabled).toBe(false);\n\t\tconst enabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: true, updatedAt: AT });\n\t\texpect(enabled.ok && enabled.autoEvolutionEnabled).toBe(true);\n\t\tconst missing = setAutoEvolution(store, { resourceId: \"skill:ghost\", enabled: false });\n\t\texpect(missing.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// snapshotResourceFiles\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"snapshotResourceFiles\", () => {\n\tit(\"登记资源后快照列出文件及哈希，生成 baseVersion 底座\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t// 造一个真实技能目录\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"code-review\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\t\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\t\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\t\tregisterResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:code-review\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(2);\n\t\texpect(snap.files.map((f) => f.path).sort()).toEqual([\"SKILL.md\", \"examples/a.md\"].sort());\n\t\texpect(snap.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 版本底座已写库\n\t\tconst row = store.db\n\t\t\t.prepare(\"SELECT effective_version FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:code-review\") as { effective_version: string };\n\t\texpect(row.effective_version).toBe(snap.versionId);\n\t\tstore.close();\n\t});\n\n\tit(\"资源目录不存在时返回空清单（不伪造文件）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"ghost\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记资源快照返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home });\n\t\texpect(snap.ok).toBe(false);\n\t\tif (snap.ok) return;\n\t\texpect(snap.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E12：文件型 relative_root（template/recipe 单文件）快照不抛 ENOTDIR\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\n\t\t// template → 工作流/{name}.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"工作流\"), { recursive: true });\n\t\twriteFileSync(join(home, \"工作流\", \"复盘.md\"), \"# 复盘\\n步骤一\\n\", \"utf8\");\n\t\tconst regT = registerResource(store, { kind: \"template\", name: \"复盘\", paoHome: home });\n\t\texpect(regT.ok).toBe(true);\n\t\tconst snapT = snapshotResourceFiles(store, { resourceId: \"template:复盘\", paoHome: home, createdAt: AT });\n\t\texpect(snapT.ok).toBe(true);\n\t\tif (!snapT.ok) return;\n\t\texpect(snapT.files.length).toBe(1);\n\t\texpect(snapT.files[0].path).toBe(\"复盘.md\");\n\t\texpect(snapT.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 快照落盘在 <home>/evolution/versions/<dirSafeResourceId>/<versionId>/<basename>。\n\t\tconst { existsSync } = require(\"node:fs\") as typeof import(\"node:fs\");\n\t\texpect(\n\t\t\texistsSync(join(home, \"evolution\", \"versions\", \"template_复盘\", snapT.versionId, \"复盘.md\")),\n\t\t).toBe(true);\n\n\t\t// recipe → 部门/{name}/配方.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"部门\", \"研发部\"), { recursive: true });\n\t\twriteFileSync(join(home, \"部门\", \"研发部\", \"配方.md\"), \"# 研发部配方\\n\", \"utf8\");\n\t\tconst regR = registerResource(store, { kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(regR.ok).toBe(true);\n\t\tconst snapR = snapshotResourceFiles(store, { resourceId: \"recipe:研发部\", paoHome: home, createdAt: AT });\n\t\texpect(snapR.ok).toBe(true);\n\t\tif (!snapR.ok) return;\n\t\texpect(snapR.files.length).toBe(1);\n\t\texpect(snapR.files[0].path).toBe(\"配方.md\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 固定禁止对象清单完整性\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"固定禁止对象清单\", () => {\n\tit(\"清单包含任务书 §2 全部类别\", () => {\n\t\tconst expected = [\n\t\t\t\"src/\",\n\t\t\t\"memory/memory.sqlite\",\n\t\t\t\"src/pao/role.ts\",\n\t\t\t\"pao配置/档位.json\",\n\t\t\t\"pao配置/记忆后台预算.json\",\n\t\t\t\"src/core/resource-loader.ts\",\n\t\t\t\"plans/\",\n\t\t];\n\t\tfor (const item of expected) {\n\t\t\texpect(FORBIDDEN_EVOLUTION_TARGETS).toContain(item);\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S8-03/04/05 定向测试：受控自进化问题登记、分类与改进选择。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore\n\tclassifyProblem,\n\tcollectEvolutionProblem, type MemoryStore \n\tdeclareImprovementIntent,\n\tgetEvolutionProblem,\n\tproblemsForSource,\n} from \"../../src/pao/memoryevolutionstore.tsproblems.ts\";\nimport { registerSourceregisterResource } from \"../../src/pao/sources.tsresources.tsselectImprovement } from \"../../src/pao/evolution/select.ts\n\tclassifyProblem,\n\tcollectEvolutionProblem,\n\tdeclareImprovementIntent,\n\tgetEvolutionProblem,\n\tproblemsForSource,\n registerSource type MemoryStore,openMemoryStore \n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,91]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[91,216]}}},{"diffOp":{"equal":{"range":[216,225]}}},{"diffOp":{"delete":{"range":[225,241]}}},{"diffOp":{"insert":{"range":[241,284]}}},{"diffOp":{"equal":{"range":[284,285]}}},{"diffOp":{"delete":{"range":[285,303]}}},{"diffOp":{"insert":{"range":[303,373]}}},{"diffOp":{"equal":{"range":[373,395]}}},{"diffOp":{"delete":{"range":[395,401]}}},{"diffOp":{"insert":{"range":[401,410]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[410,418]}}},{"diffOp":{"insert":{"range":[418,429]}}},{"diffOp":{"equal":{"range":[429,431]}}},{"diffOp":{"equal":{"range":[431,441]}}},{"diffOp":{"delete":{"range":[441,455]}}},{"diffOp":{"insert":{"range":[455,471]}}},{"diffOp":{"equal":{"range":[471,494]}}},{"diffOp":{"delete":{"range":[395,401]}}},{"diffOp":{"insert":{"range":[401,410]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[494,504]}}},{"diffOp":{"insert":{"range":[504,516]}}},{"diffOp":{"equal":{"range":[429,431]}}},{"diffOp":{"equal":{"range":[431,441]}}},{"diffOp":{"delete":{"range":[455,471]}}},{"diffOp":{"insert":{"range":[516,533]}}},{"diffOp":{"equal":{"range":[533,566]}}},{"diffOp":{"delete":{"range":[504,516]}}},{"diffOp":{"insert":{"range":[566,575]}}},{"diffOp":{"equal":{"range":[429,431]}}},{"diffOp":{"equal":{"range":[431,440]}}},{"diffOp":{"delete":{"range":[575,689]}}},{"diffOp":{"insert":{"range":[689,705]}}},{"diffOp":{"equal":{"range":[373,395]}}},{"diffOp":{"delete":{"range":[401,410]}}},{"diffOp":{"insert":{"range":[395,401]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[418,429]}}},{"diffOp":{"insert":{"range":[494,504]}}},{"diffOp":{"equal":{"range":[429,431]}}},{"diffOp":{"equal":{"range":[431,441]}}},{"diffOp":{"delete":{"range":[516,533]}}},{"diffOp":{"insert":{"range":[705,722]}}},{"diffOp":{"equal":{"range":[533,534]}}},{"diffOp":{"insert":{"range":[722,738]}}},{"diffOp":{"equal":{"range":[373,395]}}},{"diffOp":{"delete":{"range":[401,410]}}},{"diffOp":{"insert":{"range":[395,401]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[566,575]}}},{"diffOp":{"insert":{"range":[410,418]}}},{"diffOp":{"equal":{"range":[429,431]}}},{"diffOp":{"equal":{"range":[738,770]}}},{"equalLines":{"line_count":816}},{"diffOp":{"equal":{"range":[770,779]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-problems.test.ts"},"span":[891,949],"sourceCode":"/**\n * S8-03/04/05 定向测试：受控自进化问题登记、分类与改进选择。\n *\n * 覆盖：\n * - declareImprovementIntent：稳定引用（src- 前缀校验 sources 表）、同来源重复申报\n *   复用 problemId、单次机会不伪造重复、无效来源拒绝、空证据不受理。\n * - collectEvolutionProblem：只读事实输入，同来源复用 ID。\n * - classifyProblem：未采用经验→unused_experience、核心问题→development_suggestion。\n * - selectImprovement：core_issue→development_suggestion、无资源目标→no_change、\n *   有资源→modify；不要求每问题都产补丁。\n * - 来源删除沿 evolution_source_links 可查；登记后资源文件未改；模型验证调用为零。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-problems.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { registerResource } from \"../../src/pao/evolution/resources.ts\";\nimport {\n\tclassifyProblem,\n\tcollectEvolutionProblem,\n\tdeclareImprovementIntent,\n\tgetEvolutionProblem,\n\tproblemsForSource,\n} from \"../../src/pao/evolution/problems.ts\";\nimport { selectImprovement } from \"../../src/pao/evolution/select.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-problems-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(() => {\n\t// 先关 store 再删目录，避免 Windows 文件占用 EPERM。\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 测试内已关的忽略\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 个别锁定残留不阻塞后续测试\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\nfunction seedSource(store: MemoryStore, sessionId: string, entryId: string, eventType = \"toolResult\"): string {\n\treturn registerSource(store.db, {\n\t\tsessionId,\n\t\tentryId,\n\t\teventType,\n\t\tcapturedAt: AT,\n\t});\n}\n\n/** 登记资源（evolution_problems.resource_id 有 FK 指向 evolution_resources）。 */\nfunction seedResource(store: MemoryStore, home: string, kind: \"skill\" | \"memory-policy\" | \"command\" | \"extension\" | \"template\" | \"recipe\", name: string): string {\n\tconst result = registerResource(store, { kind, name, paoHome: home, registeredAt: AT });\n\tif (!result.ok) throw new Error(`seedResource 失败:${result.error.message}`);\n\treturn result.resourceId;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// declareImprovementIntent\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"declareImprovementIntent\", () => {\n\tit(\"稳定引用：src- 前缀 evidenceRef 校验 sources 表存在性\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能执行超时\",\n\t\t\texpectedBehavior: \"技能 30s 内返回\",\n\t\t\tactualBehavior: \"技能 120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\t\texpect(result.problemId).toMatch(/^prob-/);\n\n\t\t// 来源关联已写入 evolution_source_links\n\t\tconst links = store.db\n\t\t\t.prepare(\"SELECT * FROM evolution_source_links WHERE owner_kind = 'problem' AND owner_id = ?\")\n\t\t\t.all(result.problemId!) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\tstore.close();\n\t});\n\n\tit(\"同来源 + 同资源 + 同动作重复申报复用 problemId，返回 merged\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\n\t\tconst first = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\t\tconst firstProblemId = first.problemId!;\n\n\t\t// 同 sourceId + resourceId + action 重复申报 → merged\n\t\tconst second = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时（第二次申报，摘要不同）\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.accepted).toBe(true);\n\t\texpect(second.disposition).toBe(\"merged\");\n\t\texpect(second.problemId).toBe(firstProblemId);\n\n\t\t// 库内只有一条问题\n\t\tconst count = store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_problems\").get() as { n: number };\n\t\texpect(count.n).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"同来源但不同动作不合并\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\n\t\tconst first = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\n\t\tconst second = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"delete\",\n\t\t\tsummary: \"技能冗余\",\n\t\t\texpectedBehavior: \"技能精简\",\n\t\t\tactualBehavior: \"技能冗余\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.disposition).toBe(\"pending_classification\");\n\t\texpect(second.problemId).not.toBe(first.problemId);\n\t\tstore.close();\n\t});\n\n\tit(\"单次机会不伪造重复：occurrenceCount 缺省 1，不给模型自报「重复」\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"单次失败\",\n\t\t\texpectedBehavior: \"成功\",\n\t\t\tactualBehavior: \"失败\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.occurrenceCount).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"occurrenceCount 只由独立事实来源计算：显式传入才生效\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"重复失败\",\n\t\t\texpectedBehavior: \"成功\",\n\t\t\tactualBehavior: \"失败\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\toccurrenceCount: 3, // 调用方持有独立事实来源（如 memory_usage 聚合）\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.occurrenceCount).toBe(3);\n\t\tstore.close();\n\t});\n\n\tit(\"无效来源拒绝：src- 前缀但 sources 表不存在\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [\"src-ghost-1-toolResult\"],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(false);\n\t\texpect(result.reason).toContain(\"来源不存在\");\n\t\tstore.close();\n\t});\n\n\tit(\"空证据不受理：evidenceRefs 为空返回不受理理由\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"泛化建议\",\n\t\t\texpectedBehavior: \"更好\",\n\t\t\tactualBehavior: \"一般\",\n\t\t\tevidenceRefs: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(false);\n\t\texpect(result.reason).toContain(\"无证据引用\");\n\t\tstore.close();\n\t});\n\n\tit(\"非 src- 前缀引用（memoryId/revision/toolCallId）原样保留，不校验 sources 表\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [\"mem-abc@rev-2\", \"toolcall:tc-1\", \"receipt:r-1\"],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\t\tstore.close();\n\t});\n\n\tit(\"宿主补身份：projectId/taskId/sessionId/entryId/toolCallId 落库\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tprojectId: \"proj-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tentryId: \"entry-1\",\n\t\t\ttoolCallId: \"tc-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.projectId).toBe(\"proj-1\");\n\t\texpect(problem.taskId).toBe(\"task-1\");\n\t\texpect(problem.sessionId).toBe(\"sess-1\");\n\t\texpect(problem.entryId).toBe(\"entry-1\");\n\t\texpect(problem.toolCallId).toBe(\"tc-1\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// collectEvolutionProblem\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"collectEvolutionProblem\", () => {\n\tit(\"从失败回执收集事实：sourceIds + memoryRevisionRefs + toolCallId 组装证据\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能执行超时\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tmemoryRevisionRefs: [\"mem-1@rev-1\"],\n\t\t\ttoolCallId: \"tc-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tentryId: \"e1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.evidenceRefs).toContain(sourceId);\n\t\texpect(problem.evidenceRefs).toContain(\"mem-1@rev-1\");\n\t\texpect(problem.evidenceRefs).toContain(\"toolcall:tc-1\");\n\t\tstore.close();\n\t});\n\n\tit(\"已有同来源问题复用 ID（collect 与 declare 共用同一去重）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst first = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\n\t\t// collect 缺省 action=modify（implementation_defect）；同 sourceId+action 复用\n\t\tconst second = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能超时（第二次）\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.disposition).toBe(\"merged\");\n\t\texpect(second.problemId).toBe(first.problemId);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// classifyProblem\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"classifyProblem\", () => {\n\tit(\"未采用经验→unused_experience + modify（优先改检索/提示策略）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\t// 造一条 memory_usage 记录：同 session 下 mem-1 被 inject 但未 used\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"unused_experience\");\n\t\texpect(classified.action).toBe(\"modify\");\n\n\t\t// 状态机推进到 classified\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"classified\");\n\t\texpect(problem.kind).toBe(\"unused_experience\");\n\t\tstore.close();\n\t});\n\n\tit(\"已 used 的记忆不算未采用，保持原类别\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\t// mem-1 被 inject 且被 used → 不算未采用\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"used\", AT);\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"implementation_defect\");\n\t\texpect(classified.action).toBe(\"modify\");\n\t\tstore.close();\n\t});\n\n\tit(\"核心问题→development_suggestion\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"core_issue\",\n\t\t\tsummary: \"内核调度死锁\",\n\t\t\texpectedBehavior: \"任务正常派发\",\n\t\t\tactualBehavior: \"派发循环等待\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"core_issue\");\n\t\texpect(classified.action).toBe(\"development_suggestion\");\n\t\tstore.close();\n\t});\n\n\tit(\"未登记 problemId 返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = classifyProblem(store, { problemId: \"prob-ghost\" });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// selectImprovement\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"selectImprovement\", () => {\n\tit(\"core_issue→development_suggestion，输出具体文件/函数建议\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"core_issue\",\n\t\t\tsummary: \"内核调度死锁\",\n\t\t\texpectedBehavior: \"任务正常派发\",\n\t\t\tactualBehavior: \"派发循环等待\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"development_suggestion\");\n\t\texpect(selected.disposition).toBe(\"development_suggestion\");\n\t\texpect(selected.suggestion).toContain(\"固定禁止对象\");\n\n\t\t// 状态机到 development_suggestion 终态\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"development_suggestion\");\n\t\texpect(problem.disposition).toBe(\"development_suggestion\");\n\t\tstore.close();\n\t});\n\n\tit(\"无资源目标的 implementation_defect→no_change（合法终态，不强行产补丁）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"no_change\");\n\t\texpect(selected.disposition).toBe(\"no_change\");\n\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"有资源目标的 implementation_defect→modify，target 供 candidates 消费\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion: \"v-abc123\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"modify\");\n\t\texpect(selected.disposition).toBe(\"candidate\");\n\t\texpect(selected.target).toEqual({ resourceId: \"skill:code-review\", baseVersion: \"v-abc123\" });\n\n\t\t// O10/E04：select 对可改问题保持 status='classified'，只写 action/\n\t\t// disposition——candidate 状态由 proposeCandidate 成功后推进。\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"classified\");\n\t\texpect(problem.action).toBe(\"modify\");\n\t\texpect(problem.disposition).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"O10/E04：登记动作 delete 不被 select 覆盖为 modify，收口 no_change 保留 delete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"redundant\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"delete\",\n\t\t\tsummary: \"技能冗余\",\n\t\t\texpectedBehavior: \"精简\",\n\t\t\tactualBehavior: \"冗余\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:redundant\",\n\t\t\tbaseVersion: \"v-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\t// 登记动作 delete 保留，不产生候选补丁。\n\t\texpect(selected.action).toBe(\"delete\");\n\t\texpect(selected.disposition).toBe(\"no_change\");\n\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"no_change\");\n\t\texpect(problem.action).toBe(\"delete\");\n\t\tstore.close();\n\t});\n\n\tit(\"unused_experience 指向 memory-policy 资源→modify；无指向→development_suggestion\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"memory-policy\", \"recall\");\n\n\t\t// 造一条 inject 未 used 的记忆\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\n\t\t// 有 memory-policy 目标（O10/E03：evidenceRefs 直接引用该记忆修订，\n\t\t// 与未采用记录明确关联才改判 unused_experience）。\n\t\tconst withTarget = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"经验未召回\",\n\t\t\texpectedBehavior: \"召回相关经验\",\n\t\t\tactualBehavior: \"经验未注入\",\n\t\t\tevidenceRefs: [sourceId, \"mem-1@rev-1\"],\n\t\t\tresourceId: \"memory-policy:recall\",\n\t\t\tbaseVersion: \"v-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(withTarget.ok && withTarget.accepted).toBe(true);\n\t\tif (!withTarget.ok || !withTarget.accepted) return;\n\t\tclassifyProblem(store, { problemId: withTarget.problemId! });\n\t\tconst selected1 = selectImprovement(store, { problemId: withTarget.problemId! });\n\t\texpect(selected1.ok).toBe(true);\n\t\tif (!selected1.ok) return;\n\t\texpect(selected1.action).toBe(\"modify\");\n\t\texpect(selected1.target?.resourceId).toBe(\"memory-policy:recall\");\n\n\t\t// 无 memory-policy 目标（同 O10/E03 关联口径）。\n\t\tconst sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-2\", \"task-2\", \"s2\", \"mem-2\", 1, \"inject\", AT);\n\t\tconst noTarget = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"经验未召回\",\n\t\t\texpectedBehavior: \"召回相关经验\",\n\t\t\tactualBehavior: \"经验未注入\",\n\t\t\tevidenceRefs: [sourceId2, \"mem-2@rev-1\"],\n\t\t\ttaskId: \"task-2\",\n\t\t\tsessionId: \"s2\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(noTarget.ok && noTarget.accepted).toBe(true);\n\t\tif (!noTarget.ok || !noTarget.accepted) return;\n\t\tclassifyProblem(store, { problemId: noTarget.problemId! });\n\t\tconst selected2 = selectImprovement(store, { problemId: noTarget.problemId! });\n\t\texpect(selected2.ok).toBe(true);\n\t\tif (!selected2.ok) return;\n\t\texpect(selected2.action).toBe(\"development_suggestion\");\n\t\texpect(selected2.suggestion).toContain(\"memory-policy\");\n\t\tstore.close();\n\t});\n\n\tit(\"未分类问题 select 返回拒绝（须先 classify）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(false);\n\t\tif (selected.ok) return;\n\t\texpect(selected.error.message).toContain(\"尚未分类\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 来源删除沿 evolution_source_links 可查\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"来源删除沿 evolution_source_links 可查\", () => {\n\tit(\"problemsForSource 返回该来源关联的全部问题\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst s1 = seedSource(store, \"s1\", \"e1\");\n\t\tconst s2 = seedSource(store, \"s2\", \"e2\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\t\tseedResource(store, home, \"skill\", \"b\");\n\n\t\t// 不同 resourceId 才能区分两条问题（同 ref+resourceId+action 会去重合并）。\n\t\tdeclareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"问题A\",\n\t\t\texpectedBehavior: \"x\",\n\t\t\tactualBehavior: \"y\",\n\t\t\tevidenceRefs: [s1],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tdeclareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"问题B\",\n\t\t\texpectedBehavior: \"x\",\n\t\t\tactualBehavior: \"y\",\n\t\t\tevidenceRefs: [s1, s2],\n\t\t\tresourceId: \"skill:b\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tconst forS1 = problemsForSource(store, s1);\n\t\texpect(forS1).toHaveLength(2);\n\t\tconst forS2 = problemsForSource(store, s2);\n\t\texpect(forS2).toHaveLength(1);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 登记后资源文件未改 & 模型验证调用为零\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"登记后资源文件未改 & 模型验证调用为零\", () => {\n\tit(\"declareImprovementIntent 只写问题及来源关联，不改资源文件\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\t// 先登记资源——evolution_problems.resource_id 有 FK 指向 evolution_resources\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\t\tconst beforeCount = (store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number }).n;\n\t\texpect(beforeCount).toBe(1);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion: \"v-abc\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\n\t\t// 登记问题不新写资源行（资源数仍为 1）；也不落资源目录下的新文件。\n\t\tconst afterCount = (store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number }).n;\n\t\texpect(afterCount).toBe(1);\n\t\texpect(existsSync(join(home, \"pao配置\", \"skills\", \"code-review\"))).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"classifyProblem/selectImprovement 不调用模型（纯 SQL 事实判断）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\t// classify 与 select 都是同步 SQL，无异步模型调用——函数签名即证明\n\t\t// （两者都返回 MemoryResult 而非 Promise）。\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S8-03/04/05 定向测试：受控自进化问题登记、分类与改进选择。\n *\n/** 登记资源（evolution_problems.resource_id 有 FK 指向 evolution_resources）。 */\nfunction seedResource(\n\tstore: MemoryStore, home: string,kind: \"skill\" | \"memory-policy\" | \"command\" | \"extension\" | \"template\" | \"recipe\",name: string,\n): string {\n\tconst result = registerResource(store, { kind, name, paoHome: home, registeredAt: AT });\n\tif (!result.ok) throw new Error(`seedResource 失败:${result.error.message}`);\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,91]}}},{"equalLines":{"line_count":68}},{"diffOp":{"equal":{"range":[91,207]}}},{"diffOp":{"insert":{"range":[207,209]}}},{"diffOp":{"equal":{"range":[209,228]}}},{"diffOp":{"delete":{"range":[228,229]}}},{"diffOp":{"insert":{"range":[207,209]}}},{"diffOp":{"equal":{"range":[229,242]}}},{"diffOp":{"delete":{"range":[228,229]}}},{"diffOp":{"insert":{"range":[207,209]}}},{"diffOp":{"equal":{"range":[242,324]}}},{"diffOp":{"delete":{"range":[228,229]}}},{"diffOp":{"insert":{"range":[207,209]}}},{"diffOp":{"equal":{"range":[324,336]}}},{"diffOp":{"insert":{"range":[336,338]}}},{"diffOp":{"equal":{"range":[338,520]}}},{"equalLines":{"line_count":771}},{"diffOp":{"equal":{"range":[520,529]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-problems.test.ts"},"span":null,"sourceCode":"/**\n * S8-03/04/05 定向测试：受控自进化问题登记、分类与改进选择。\n *\n * 覆盖：\n * - declareImprovementIntent：稳定引用（src- 前缀校验 sources 表）、同来源重复申报\n *   复用 problemId、单次机会不伪造重复、无效来源拒绝、空证据不受理。\n * - collectEvolutionProblem：只读事实输入，同来源复用 ID。\n * - classifyProblem：未采用经验→unused_experience、核心问题→development_suggestion。\n * - selectImprovement：core_issue→development_suggestion、无资源目标→no_change、\n *   有资源→modify；不要求每问题都产补丁。\n * - 来源删除沿 evolution_source_links 可查；登记后资源文件未改；模型验证调用为零。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-problems.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { registerResource } from \"../../src/pao/evolution/resources.ts\";\nimport {\n\tclassifyProblem,\n\tcollectEvolutionProblem,\n\tdeclareImprovementIntent,\n\tgetEvolutionProblem,\n\tproblemsForSource,\n} from \"../../src/pao/evolution/problems.ts\";\nimport { selectImprovement } from \"../../src/pao/evolution/select.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-problems-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(() => {\n\t// 先关 store 再删目录，避免 Windows 文件占用 EPERM。\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 测试内已关的忽略\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 个别锁定残留不阻塞后续测试\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\nfunction seedSource(store: MemoryStore, sessionId: string, entryId: string, eventType = \"toolResult\"): string {\n\treturn registerSource(store.db, {\n\t\tsessionId,\n\t\tentryId,\n\t\teventType,\n\t\tcapturedAt: AT,\n\t});\n}\n\n/** 登记资源（evolution_problems.resource_id 有 FK 指向 evolution_resources）。 */\nfunction seedResource(store: MemoryStore, home: string, kind: \"skill\" | \"memory-policy\" | \"command\" | \"extension\" | \"template\" | \"recipe\", name: string): string {\n\tconst result = registerResource(store, { kind, name, paoHome: home, registeredAt: AT });\n\tif (!result.ok) throw new Error(`seedResource 失败:${result.error.message}`);\n\treturn result.resourceId;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// declareImprovementIntent\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"declareImprovementIntent\", () => {\n\tit(\"稳定引用：src- 前缀 evidenceRef 校验 sources 表存在性\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能执行超时\",\n\t\t\texpectedBehavior: \"技能 30s 内返回\",\n\t\t\tactualBehavior: \"技能 120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\t\texpect(result.problemId).toMatch(/^prob-/);\n\n\t\t// 来源关联已写入 evolution_source_links\n\t\tconst links = store.db\n\t\t\t.prepare(\"SELECT * FROM evolution_source_links WHERE owner_kind = 'problem' AND owner_id = ?\")\n\t\t\t.all(result.problemId!) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\tstore.close();\n\t});\n\n\tit(\"同来源 + 同资源 + 同动作重复申报复用 problemId，返回 merged\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\n\t\tconst first = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\t\tconst firstProblemId = first.problemId!;\n\n\t\t// 同 sourceId + resourceId + action 重复申报 → merged\n\t\tconst second = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时（第二次申报，摘要不同）\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.accepted).toBe(true);\n\t\texpect(second.disposition).toBe(\"merged\");\n\t\texpect(second.problemId).toBe(firstProblemId);\n\n\t\t// 库内只有一条问题\n\t\tconst count = store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_problems\").get() as { n: number };\n\t\texpect(count.n).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"同来源但不同动作不合并\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\n\t\tconst first = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\n\t\tconst second = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"delete\",\n\t\t\tsummary: \"技能冗余\",\n\t\t\texpectedBehavior: \"技能精简\",\n\t\t\tactualBehavior: \"技能冗余\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.disposition).toBe(\"pending_classification\");\n\t\texpect(second.problemId).not.toBe(first.problemId);\n\t\tstore.close();\n\t});\n\n\tit(\"单次机会不伪造重复：occurrenceCount 缺省 1，不给模型自报「重复」\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"单次失败\",\n\t\t\texpectedBehavior: \"成功\",\n\t\t\tactualBehavior: \"失败\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.occurrenceCount).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"occurrenceCount 只由独立事实来源计算：显式传入才生效\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"重复失败\",\n\t\t\texpectedBehavior: \"成功\",\n\t\t\tactualBehavior: \"失败\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\toccurrenceCount: 3, // 调用方持有独立事实来源（如 memory_usage 聚合）\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.occurrenceCount).toBe(3);\n\t\tstore.close();\n\t});\n\n\tit(\"无效来源拒绝：src- 前缀但 sources 表不存在\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [\"src-ghost-1-toolResult\"],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(false);\n\t\texpect(result.reason).toContain(\"来源不存在\");\n\t\tstore.close();\n\t});\n\n\tit(\"空证据不受理：evidenceRefs 为空返回不受理理由\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"泛化建议\",\n\t\t\texpectedBehavior: \"更好\",\n\t\t\tactualBehavior: \"一般\",\n\t\t\tevidenceRefs: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(false);\n\t\texpect(result.reason).toContain(\"无证据引用\");\n\t\tstore.close();\n\t});\n\n\tit(\"非 src- 前缀引用（memoryId/revision/toolCallId）原样保留，不校验 sources 表\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [\"mem-abc@rev-2\", \"toolcall:tc-1\", \"receipt:r-1\"],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\t\tstore.close();\n\t});\n\n\tit(\"宿主补身份：projectId/taskId/sessionId/entryId/toolCallId 落库\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tprojectId: \"proj-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tentryId: \"entry-1\",\n\t\t\ttoolCallId: \"tc-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\t\tif (!result.ok || !result.accepted) return;\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.projectId).toBe(\"proj-1\");\n\t\texpect(problem.taskId).toBe(\"task-1\");\n\t\texpect(problem.sessionId).toBe(\"sess-1\");\n\t\texpect(problem.entryId).toBe(\"entry-1\");\n\t\texpect(problem.toolCallId).toBe(\"tc-1\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// collectEvolutionProblem\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"collectEvolutionProblem\", () => {\n\tit(\"从失败回执收集事实：sourceIds + memoryRevisionRefs + toolCallId 组装证据\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst result = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能执行超时\",\n\t\t\texpectedBehavior: \"30s 内返回\",\n\t\t\tactualBehavior: \"120s 未返回\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tmemoryRevisionRefs: [\"mem-1@rev-1\"],\n\t\t\ttoolCallId: \"tc-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tentryId: \"e1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.accepted).toBe(true);\n\t\texpect(result.disposition).toBe(\"pending_classification\");\n\n\t\tconst problem = getEvolutionProblem(store, result.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.evidenceRefs).toContain(sourceId);\n\t\texpect(problem.evidenceRefs).toContain(\"mem-1@rev-1\");\n\t\texpect(problem.evidenceRefs).toContain(\"toolcall:tc-1\");\n\t\tstore.close();\n\t});\n\n\tit(\"已有同来源问题复用 ID（collect 与 declare 共用同一去重）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst first = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.accepted).toBe(true);\n\t\tif (!first.ok || !first.accepted) return;\n\n\t\t// collect 缺省 action=modify（implementation_defect）；同 sourceId+action 复用\n\t\tconst second = collectEvolutionProblem(store, {\n\t\t\tsummary: \"技能超时（第二次）\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.disposition).toBe(\"merged\");\n\t\texpect(second.problemId).toBe(first.problemId);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// classifyProblem\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"classifyProblem\", () => {\n\tit(\"未采用经验→unused_experience + modify（优先改检索/提示策略）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\t// 造一条 memory_usage 记录：同 session 下 mem-1 被 inject 但未 used\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"unused_experience\");\n\t\texpect(classified.action).toBe(\"modify\");\n\n\t\t// 状态机推进到 classified\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"classified\");\n\t\texpect(problem.kind).toBe(\"unused_experience\");\n\t\tstore.close();\n\t});\n\n\tit(\"已 used 的记忆不算未采用，保持原类别\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\t// mem-1 被 inject 且被 used → 不算未采用\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"used\", AT);\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"implementation_defect\");\n\t\texpect(classified.action).toBe(\"modify\");\n\t\tstore.close();\n\t});\n\n\tit(\"核心问题→development_suggestion\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"core_issue\",\n\t\t\tsummary: \"内核调度死锁\",\n\t\t\texpectedBehavior: \"任务正常派发\",\n\t\t\tactualBehavior: \"派发循环等待\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"core_issue\");\n\t\texpect(classified.action).toBe(\"development_suggestion\");\n\t\tstore.close();\n\t});\n\n\tit(\"未登记 problemId 返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = classifyProblem(store, { problemId: \"prob-ghost\" });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// selectImprovement\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"selectImprovement\", () => {\n\tit(\"core_issue→development_suggestion，输出具体文件/函数建议\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"core_issue\",\n\t\t\tsummary: \"内核调度死锁\",\n\t\t\texpectedBehavior: \"任务正常派发\",\n\t\t\tactualBehavior: \"派发循环等待\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"development_suggestion\");\n\t\texpect(selected.disposition).toBe(\"development_suggestion\");\n\t\texpect(selected.suggestion).toContain(\"固定禁止对象\");\n\n\t\t// 状态机到 development_suggestion 终态\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"development_suggestion\");\n\t\texpect(problem.disposition).toBe(\"development_suggestion\");\n\t\tstore.close();\n\t});\n\n\tit(\"无资源目标的 implementation_defect→no_change（合法终态，不强行产补丁）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"no_change\");\n\t\texpect(selected.disposition).toBe(\"no_change\");\n\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"有资源目标的 implementation_defect→modify，target 供 candidates 消费\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion: \"v-abc123\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"modify\");\n\t\texpect(selected.disposition).toBe(\"candidate\");\n\t\texpect(selected.target).toEqual({ resourceId: \"skill:code-review\", baseVersion: \"v-abc123\" });\n\n\t\t// O10/E04：select 对可改问题保持 status='classified'，只写 action/\n\t\t// disposition——candidate 状态由 proposeCandidate 成功后推进。\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"classified\");\n\t\texpect(problem.action).toBe(\"modify\");\n\t\texpect(problem.disposition).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"O10/E04：登记动作 delete 不被 select 覆盖为 modify，收口 no_change 保留 delete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"redundant\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"delete\",\n\t\t\tsummary: \"技能冗余\",\n\t\t\texpectedBehavior: \"精简\",\n\t\t\tactualBehavior: \"冗余\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:redundant\",\n\t\t\tbaseVersion: \"v-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\t\tclassifyProblem(store, { problemId: declared.problemId! });\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\t// 登记动作 delete 保留，不产生候选补丁。\n\t\texpect(selected.action).toBe(\"delete\");\n\t\texpect(selected.disposition).toBe(\"no_change\");\n\n\t\tconst problem = getEvolutionProblem(store, declared.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (!problem.ok) return;\n\t\texpect(problem.status).toBe(\"no_change\");\n\t\texpect(problem.action).toBe(\"delete\");\n\t\tstore.close();\n\t});\n\n\tit(\"unused_experience 指向 memory-policy 资源→modify；无指向→development_suggestion\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"memory-policy\", \"recall\");\n\n\t\t// 造一条 inject 未 used 的记忆\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-1\", \"task-1\", \"s1\", \"mem-1\", 1, \"inject\", AT);\n\n\t\t// 有 memory-policy 目标（O10/E03：evidenceRefs 直接引用该记忆修订，\n\t\t// 与未采用记录明确关联才改判 unused_experience）。\n\t\tconst withTarget = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"经验未召回\",\n\t\t\texpectedBehavior: \"召回相关经验\",\n\t\t\tactualBehavior: \"经验未注入\",\n\t\t\tevidenceRefs: [sourceId, \"mem-1@rev-1\"],\n\t\t\tresourceId: \"memory-policy:recall\",\n\t\t\tbaseVersion: \"v-1\",\n\t\t\ttaskId: \"task-1\",\n\t\t\tsessionId: \"s1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(withTarget.ok && withTarget.accepted).toBe(true);\n\t\tif (!withTarget.ok || !withTarget.accepted) return;\n\t\tclassifyProblem(store, { problemId: withTarget.problemId! });\n\t\tconst selected1 = selectImprovement(store, { problemId: withTarget.problemId! });\n\t\texpect(selected1.ok).toBe(true);\n\t\tif (!selected1.ok) return;\n\t\texpect(selected1.action).toBe(\"modify\");\n\t\texpect(selected1.target?.resourceId).toBe(\"memory-policy:recall\");\n\n\t\t// 无 memory-policy 目标（同 O10/E03 关联口径）。\n\t\tconst sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO memory_usage (request_id, task_id, session_id, memory_id, revision, action, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"req-2\", \"task-2\", \"s2\", \"mem-2\", 1, \"inject\", AT);\n\t\tconst noTarget = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"经验未召回\",\n\t\t\texpectedBehavior: \"召回相关经验\",\n\t\t\tactualBehavior: \"经验未注入\",\n\t\t\tevidenceRefs: [sourceId2, \"mem-2@rev-1\"],\n\t\t\ttaskId: \"task-2\",\n\t\t\tsessionId: \"s2\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(noTarget.ok && noTarget.accepted).toBe(true);\n\t\tif (!noTarget.ok || !noTarget.accepted) return;\n\t\tclassifyProblem(store, { problemId: noTarget.problemId! });\n\t\tconst selected2 = selectImprovement(store, { problemId: noTarget.problemId! });\n\t\texpect(selected2.ok).toBe(true);\n\t\tif (!selected2.ok) return;\n\t\texpect(selected2.action).toBe(\"development_suggestion\");\n\t\texpect(selected2.suggestion).toContain(\"memory-policy\");\n\t\tstore.close();\n\t});\n\n\tit(\"未分类问题 select 返回拒绝（须先 classify）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(false);\n\t\tif (selected.ok) return;\n\t\texpect(selected.error.message).toContain(\"尚未分类\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 来源删除沿 evolution_source_links 可查\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"来源删除沿 evolution_source_links 可查\", () => {\n\tit(\"problemsForSource 返回该来源关联的全部问题\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst s1 = seedSource(store, \"s1\", \"e1\");\n\t\tconst s2 = seedSource(store, \"s2\", \"e2\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\t\tseedResource(store, home, \"skill\", \"b\");\n\n\t\t// 不同 resourceId 才能区分两条问题（同 ref+resourceId+action 会去重合并）。\n\t\tdeclareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"问题A\",\n\t\t\texpectedBehavior: \"x\",\n\t\t\tactualBehavior: \"y\",\n\t\t\tevidenceRefs: [s1],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tdeclareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"问题B\",\n\t\t\texpectedBehavior: \"x\",\n\t\t\tactualBehavior: \"y\",\n\t\t\tevidenceRefs: [s1, s2],\n\t\t\tresourceId: \"skill:b\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tconst forS1 = problemsForSource(store, s1);\n\t\texpect(forS1).toHaveLength(2);\n\t\tconst forS2 = problemsForSource(store, s2);\n\t\texpect(forS2).toHaveLength(1);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 登记后资源文件未改 & 模型验证调用为零\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"登记后资源文件未改 & 模型验证调用为零\", () => {\n\tit(\"declareImprovementIntent 只写问题及来源关联，不改资源文件\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\t// 先登记资源——evolution_problems.resource_id 有 FK 指向 evolution_resources\n\t\tseedResource(store, home, \"skill\", \"code-review\");\n\t\tconst beforeCount = (store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number }).n;\n\t\texpect(beforeCount).toBe(1);\n\n\t\tconst result = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion: \"v-abc\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok && result.accepted).toBe(true);\n\n\t\t// 登记问题不新写资源行（资源数仍为 1）；也不落资源目录下的新文件。\n\t\tconst afterCount = (store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number }).n;\n\t\texpect(afterCount).toBe(1);\n\t\texpect(existsSync(join(home, \"pao配置\", \"skills\", \"code-review\"))).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"classifyProblem/selectImprovement 不调用模型（纯 SQL 事实判断）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tseedResource(store, home, \"skill\", \"a\");\n\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\tsummary: \"技能超时\",\n\t\t\texpectedBehavior: \"30s\",\n\t\t\tactualBehavior: \"120s\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId: \"skill:a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.accepted) return;\n\n\t\t// classify 与 select 都是同步 SQL，无异步模型调用——函数签名即证明\n\t\t// （两者都返回 MemoryResult 而非 Promise）。\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId! });\n\t\texpect(classified.ok).toBe(true);\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId! });\n\t\texpect(selected.ok).toBe(true);\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStoreactivateCandidate } from \"../../src/pao/memoryevolutionstore.tsactivation.ts\";evolutionPathsbindTaskResourcespaths.tsbinding.tsregisterResource, snapshotResourceFilesrecordUsed } from \"../../src/pao/evolution/resources.tsobserve.tspublishCandidatehandleRegression,judgeRegression } from \"../../src/pao/evolution/versions.tsregression.tssnapshotResourceFiles type MemoryStore, \nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,110]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[110,235]}}},{"diffOp":{"equal":{"range":[235,245]}}},{"diffOp":{"delete":{"range":[245,278]}}},{"diffOp":{"insert":{"range":[278,295]}}},{"diffOp":{"equal":{"range":[295,318]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[324,333]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[333,341]}}},{"diffOp":{"insert":{"range":[341,354]}}},{"diffOp":{"equal":{"range":[354,356]}}},{"diffOp":{"equal":{"range":[235,245]}}},{"diffOp":{"delete":{"range":[356,370]}}},{"diffOp":{"insert":{"range":[370,387]}}},{"diffOp":{"equal":{"range":[295,318]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[356,365]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[387,395]}}},{"diffOp":{"insert":{"range":[395,405]}}},{"diffOp":{"equal":{"range":[354,356]}}},{"diffOp":{"equal":{"range":[235,245]}}},{"diffOp":{"delete":{"range":[405,444]}}},{"diffOp":{"insert":{"range":[444,454]}}},{"diffOp":{"equal":{"range":[454,487]}}},{"diffOp":{"delete":{"range":[487,499]}