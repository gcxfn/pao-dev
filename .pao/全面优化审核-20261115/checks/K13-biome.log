ices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-activation.test.ts"},"span":[997,1083],"sourceCode":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *\n * 覆盖：\n * - 成功路径：publish → activate → effective_version 更新 + kind='publish'/activation='effective' 行；\n * - expectedEffectiveVersion 不匹配 → conflict；\n * - 验证期资源被改（文件指纹变 → conflict；另起 effective_version 变也 conflict）；\n * - 候选非 passed / 未发布 / 版本目录缺文件 → conflict；\n * - auto_evolution_enabled=false → conflict；\n * - 事务内失败 → 指向只能旧版或完整新版，无半份；\n * - rollbackResource：指向是 badVersion → 切回 + rollback 行 + 坏版凭据标停用；\n *   指向已非 badVersion → no_change 不覆盖其他已生效修复；\n * - getEffectiveVersion 正常/目录缺失。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-act-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直插 problem 行（classified）。O12/E11：补 problem source link（activation 前置核对要求非空 links）。 */\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（非 src- 前缀：不查 sources 行，作为有效来源）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\n/** 直插 candidate 行 + 候选目录文件（默认 passed）。 */\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tfiles?: Record<string, string>;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径，activation 前置核对要求非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? {\n\t\t\"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\",\n\t\t\"examples/a.md\": \"示例 A\\n\",\n\t};\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\treturn { candidateId, candidateDir };\n}\n\n/** 直插 validation 行（默认 passed）。 */\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: {\n\t\tvalidationId?: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tverdict?: string;\n\t\tcreatedAt?: string;\n\t},\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tJSON.stringify([]),\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tnull,\n\t\t\tover.createdAt ?? AT,\n\t\t\tover.createdAt ?? AT,\n\t\t);\n\t// O12/E11：validation（运行验证）级来源关联；冻结计划（tp-1）级同样补一条\n\t// （activation 核对 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", over.createdAt ?? AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", over.createdAt ?? AT);\n\treturn validationId;\n}\n\n/** 一套 ready-to-activate：resource + problem + 合法 passed 链 + publish。 */\nasync function seedPublished(home: string, store: MemoryStore) {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，直接种 passed 行过不了——\n\t// 跑 freeze→双侧 run→evaluate 真实链得到合法 passed。\n\tconst { candidateId, validationId } = await legalPassedChain(store, home, {\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\", \"examples/a.md\": \"示例 A\\n\" },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(`publish failed: ${JSON.stringify(pub)}`);\n\treturn { resourceId, baseVersion, skillDir, problemId, candidateId, validationId, versionId: pub.versionId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── activateCandidate ────────────────────────────────────────────────────\n\ndescribe(\"activateCandidate\", () => {\n\tit(\"publish → activate 成功：effective_version 更新 + effective activation 行落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tauthRef: \"auth-xyz\",\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toBe(versionId);\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\n\t\t// effective_version 指向新版本。\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\t// 新增 activation 行：kind='publish'、activation='effective'、authRef 落 source_links。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, source_links_json, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? ORDER BY created_at`,\n\t\t\t)\n\t\t\t.all(resourceId, versionId) as Array<{ kind: string; source_links_json: string; reason: string }>;\n\t\texpect(acts.length).toBe(2); // 落盘凭据 + 生效凭据\n\t\tconst effective = acts.find((a) => JSON.parse(a.source_links_json).activation === \"effective\");\n\t\texpect(effective).toBeDefined();\n\t\texpect(JSON.parse(effective!.source_links_json).authRef).toBe(\"auth-xyz\");\n\t\texpect(effective!.reason).toContain(candidateId);\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: \"v-notcurrent00\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(baseVersion);\n\t\t// 指向仍停在 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tvoid versionId;\n\t});\n\n\tit(\"验证期资源根被人工改（文件内容变）→ conflict，旧版保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\n\t\t// 验证通过后人工改 SKILL.md（指纹偏离 base_version）。\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t\t// 旧指向未动。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"验证期资源根被人工加文件（指纹变）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\t\twriteFileSync(join(skillDir, \"extra.md\"), \"新增\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"验证期 effective_version 已变（另一生效已写入）→ conflict，不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 另一路径先把 effective_version 改成别的（模拟另一激活已生效）。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, AT3, resourceId);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(versionId);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\t});\n\n\tit(\"候选非 passed → conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion, status: \"testing\" });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"候选未发布（无 publish 凭据）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\t\t// 不走 publishCandidate。\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"版本目录缺文件（指纹不匹配）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 删除版本目录里一个文件。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId, \"examples\", \"a.md\"));\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"auto_evolution_enabled=false → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId } = await seedPublished(home, store);\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"事务内写失败 → 指向只能旧版（无半份：activation 行与 effective_version 同生同死）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先造一条同 activation_id 不可复现的失败：直接 mock——给库加触发器让 INSERT\n\t\t// evolution_activations 失败，观察 rollback（SQLite 触发器属测试夹具注入的故障）。\n\t\tstore.db.exec(\n\t\t\t`CREATE TEMP TRIGGER fail_act_insert BEFORE INSERT ON evolution_activations\n\t\t\t WHEN NEW.kind = 'publish' AND json_extract(NEW.source_links_json, '$.activation') = 'effective'\n\t\t\t BEGIN SELECT RAISE(ABORT, 'simulated insert failure'); END`,\n\t\t);\n\t\tawait expect(\n\t\t\tactivateCandidate(store, {\n\t\t\t\tcandidateId,\n\t\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\t\tpaoHome: home,\n\t\t\t}),\n\t\t).rejects.toThrow();\n\t\tstore.db.exec(`DROP TRIGGER fail_act_insert`);\n\n\t\t// 指向仍停旧版（INSERT 失败回滚了 UPDATE），无 effective 行。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND json_extract(source_links_json, '$.activation') = 'effective'`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t});\n\n\tit(\"来源依据失效（validation 的 source_links 行引用已删记忆）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(home, store);\n\t\tvoid versionId;\n\n\t\t// 给 validation 行加一条引用已删记忆的 source link（记忆行不存在）。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tconst valId = validationId;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'validation', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-del-${valId}`, valId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\t\tvoid problemId;\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"记忆 mem-ghost 已被删除排除\");\n\t});\n});\n\n// ── rollbackResource ─────────────────────────────────────────────────────\n\ndescribe(\"rollbackResource\", () => {\n\tit(\"当前指向是 badVersion → 切回 previousVersion + rollback activation 行 + 坏版凭据标停用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先 activate 到 badVersion。\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"复现原问题回归\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rolled_back\");\n\n\t\t// 指向回到 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// rollback activation 落库，source_links 带 sourceIds。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason, source_links_json\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string; source_links_json: string };\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(JSON.parse(row.source_links_json).sourceIds).toEqual([\"src-reg-1\"]);\n\n\t\t// 坏版的 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t\t   AND json_extract(source_links_json, '$.candidateId') = ?`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId, candidateId) as { reason: string };\n\t\texpect(pubRow.reason.startsWith(\"停用:\")).toBe(true);\n\t});\n\n\tit(\"当前指向已非 badVersion（另一修复已生效）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\n\t\t// 另一路径把 effective_version 改成第三个版本（模拟回退期间另一修复已生效）。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId, // 认为该回退的坏版\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"判定退步\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tif (result.status !== \"no_change\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(otherVersion);\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t\t// 没有 rollback activation 写入。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`)\n\t\t\t.get(resourceId) as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tbadVersion: \"v-xxxxxxxxxxxx\",\n\t\t\tpreviousVersion: \"v-yyyyyyyyyyyy\",\n\t\t\tsourceIds: [],\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── getEffectiveVersion ──────────────────────────────────────────────────\n\ndescribe(\"getEffectiveVersion\", () => {\n\tit(\"激活后返回新 versionId + available=true（目录完整）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(true);\n\t\texpect(info.versionDir).toContain(versionId);\n\t});\n\n\tit(\"未激活时指向 baseVersion（快照目录完整 → available=true）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedPublished(home, store);\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(baseVersion);\n\t\texpect(info.available).toBe(true);\n\t});\n\n\tit(\"指向版本目录缺失/不完整 → available=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\t// 删版本目录文件 → 指纹不匹配。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId), { recursive: true, force: true });\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst info = getEffectiveVersion(store, \"skill:missing\", home);\n\t\texpect(info.ok).toBe(false);\n\t\tif (info.ok) return;\n\t\texpect(info.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *import { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\t activateCandidate,getEffectiveVersion,rollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(\n\t\t\thome,store,\n\t\t);\n\t\tvoid versionId;\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as {kind: string;from_version: string;to_version: string;reason: string;source_links_json: string;\n\t\t};\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,136]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[136,330]}}},{"diffOp":{"delete":{"range":[330,332]}}},{"diffOp":{"insert":{"range":[332,333]}}},{"diffOp":{"equal":{"range":[333,351]}}},{"diffOp":{"delete":{"range":[330,332]}}},{"diffOp":{"insert":{"range":[332,333]}}},{"diffOp":{"equal":{"range":[351,371]}}},{"diffOp":{"delete":{"range":[330,332]}}},{"diffOp":{"insert":{"range":[332,333]}}},{"diffOp":{"equal":{"range":[371,387]}}},{"diffOp":{"delete":{"range":[387,389]}}},{"diffOp":{"insert":{"range":[332,333]}}},{"diffOp":{"equal":{"range":[389,509]}}},{"equalLines":{"line_count":456}},{"diffOp":{"equal":{"range":[509,676]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[680,685]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[685,690]}}},{"diffOp":{"insert":{"range":[690,694]}}},{"diffOp":{"equal":{"range":[694,715]}}},{"equalLines":{"line_count":61}},{"diffOp":{"equal":{"range":[715,822]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[822,835]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[835,856]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[856,875]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[875,890]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[676,680]}}},{"diffOp":{"equal":{"range":[890,915]}}},{"diffOp":{"delete":{"range":[332,333]}}},{"diffOp":{"insert":{"range":[915,919]}}},{"diffOp":{"equal":{"range":[919,1009]}}},{"equalLines":{"line_count":129}},{"diffOp":{"equal":{"range":[1009,1018]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-activation.test.ts"},"span":null,"sourceCode":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *\n * 覆盖：\n * - 成功路径：publish → activate → effective_version 更新 + kind='publish'/activation='effective' 行；\n * - expectedEffectiveVersion 不匹配 → conflict；\n * - 验证期资源被改（文件指纹变 → conflict；另起 effective_version 变也 conflict）；\n * - 候选非 passed / 未发布 / 版本目录缺文件 → conflict；\n * - auto_evolution_enabled=false → conflict；\n * - 事务内失败 → 指向只能旧版或完整新版，无半份；\n * - rollbackResource：指向是 badVersion → 切回 + rollback 行 + 坏版凭据标停用；\n *   指向已非 badVersion → no_change 不覆盖其他已生效修复；\n * - getEffectiveVersion 正常/目录缺失。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-act-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直插 problem 行（classified）。O12/E11：补 problem source link（activation 前置核对要求非空 links）。 */\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（非 src- 前缀：不查 sources 行，作为有效来源）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\n/** 直插 candidate 行 + 候选目录文件（默认 passed）。 */\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tfiles?: Record<string, string>;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径，activation 前置核对要求非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? {\n\t\t\"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\",\n\t\t\"examples/a.md\": \"示例 A\\n\",\n\t};\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\treturn { candidateId, candidateDir };\n}\n\n/** 直插 validation 行（默认 passed）。 */\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: {\n\t\tvalidationId?: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tverdict?: string;\n\t\tcreatedAt?: string;\n\t},\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tJSON.stringify([]),\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tnull,\n\t\t\tover.createdAt ?? AT,\n\t\t\tover.createdAt ?? AT,\n\t\t);\n\t// O12/E11：validation（运行验证）级来源关联；冻结计划（tp-1）级同样补一条\n\t// （activation 核对 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", over.createdAt ?? AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", over.createdAt ?? AT);\n\treturn validationId;\n}\n\n/** 一套 ready-to-activate：resource + problem + 合法 passed 链 + publish。 */\nasync function seedPublished(home: string, store: MemoryStore) {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，直接种 passed 行过不了——\n\t// 跑 freeze→双侧 run→evaluate 真实链得到合法 passed。\n\tconst { candidateId, validationId } = await legalPassedChain(store, home, {\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\", \"examples/a.md\": \"示例 A\\n\" },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(`publish failed: ${JSON.stringify(pub)}`);\n\treturn { resourceId, baseVersion, skillDir, problemId, candidateId, validationId, versionId: pub.versionId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── activateCandidate ────────────────────────────────────────────────────\n\ndescribe(\"activateCandidate\", () => {\n\tit(\"publish → activate 成功：effective_version 更新 + effective activation 行落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tauthRef: \"auth-xyz\",\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toBe(versionId);\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\n\t\t// effective_version 指向新版本。\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\t// 新增 activation 行：kind='publish'、activation='effective'、authRef 落 source_links。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, source_links_json, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? ORDER BY created_at`,\n\t\t\t)\n\t\t\t.all(resourceId, versionId) as Array<{ kind: string; source_links_json: string; reason: string }>;\n\t\texpect(acts.length).toBe(2); // 落盘凭据 + 生效凭据\n\t\tconst effective = acts.find((a) => JSON.parse(a.source_links_json).activation === \"effective\");\n\t\texpect(effective).toBeDefined();\n\t\texpect(JSON.parse(effective!.source_links_json).authRef).toBe(\"auth-xyz\");\n\t\texpect(effective!.reason).toContain(candidateId);\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: \"v-notcurrent00\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(baseVersion);\n\t\t// 指向仍停在 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tvoid versionId;\n\t});\n\n\tit(\"验证期资源根被人工改（文件内容变）→ conflict，旧版保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\n\t\t// 验证通过后人工改 SKILL.md（指纹偏离 base_version）。\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t\t// 旧指向未动。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"验证期资源根被人工加文件（指纹变）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\t\twriteFileSync(join(skillDir, \"extra.md\"), \"新增\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"验证期 effective_version 已变（另一生效已写入）→ conflict，不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 另一路径先把 effective_version 改成别的（模拟另一激活已生效）。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, AT3, resourceId);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(versionId);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\t});\n\n\tit(\"候选非 passed → conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion, status: \"testing\" });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"候选未发布（无 publish 凭据）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\t\t// 不走 publishCandidate。\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"版本目录缺文件（指纹不匹配）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 删除版本目录里一个文件。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId, \"examples\", \"a.md\"));\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"auto_evolution_enabled=false → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId } = await seedPublished(home, store);\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"事务内写失败 → 指向只能旧版（无半份：activation 行与 effective_version 同生同死）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先造一条同 activation_id 不可复现的失败：直接 mock——给库加触发器让 INSERT\n\t\t// evolution_activations 失败，观察 rollback（SQLite 触发器属测试夹具注入的故障）。\n\t\tstore.db.exec(\n\t\t\t`CREATE TEMP TRIGGER fail_act_insert BEFORE INSERT ON evolution_activations\n\t\t\t WHEN NEW.kind = 'publish' AND json_extract(NEW.source_links_json, '$.activation') = 'effective'\n\t\t\t BEGIN SELECT RAISE(ABORT, 'simulated insert failure'); END`,\n\t\t);\n\t\tawait expect(\n\t\t\tactivateCandidate(store, {\n\t\t\t\tcandidateId,\n\t\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\t\tpaoHome: home,\n\t\t\t}),\n\t\t).rejects.toThrow();\n\t\tstore.db.exec(`DROP TRIGGER fail_act_insert`);\n\n\t\t// 指向仍停旧版（INSERT 失败回滚了 UPDATE），无 effective 行。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND json_extract(source_links_json, '$.activation') = 'effective'`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t});\n\n\tit(\"来源依据失效（validation 的 source_links 行引用已删记忆）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(home, store);\n\t\tvoid versionId;\n\n\t\t// 给 validation 行加一条引用已删记忆的 source link（记忆行不存在）。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tconst valId = validationId;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'validation', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-del-${valId}`, valId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\t\tvoid problemId;\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"记忆 mem-ghost 已被删除排除\");\n\t});\n});\n\n// ── rollbackResource ─────────────────────────────────────────────────────\n\ndescribe(\"rollbackResource\", () => {\n\tit(\"当前指向是 badVersion → 切回 previousVersion + rollback activation 行 + 坏版凭据标停用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先 activate 到 badVersion。\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"复现原问题回归\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rolled_back\");\n\n\t\t// 指向回到 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// rollback activation 落库，source_links 带 sourceIds。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason, source_links_json\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string; source_links_json: string };\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(JSON.parse(row.source_links_json).sourceIds).toEqual([\"src-reg-1\"]);\n\n\t\t// 坏版的 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t\t   AND json_extract(source_links_json, '$.candidateId') = ?`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId, candidateId) as { reason: string };\n\t\texpect(pubRow.reason.startsWith(\"停用:\")).toBe(true);\n\t});\n\n\tit(\"当前指向已非 badVersion（另一修复已生效）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\n\t\t// 另一路径把 effective_version 改成第三个版本（模拟回退期间另一修复已生效）。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId, // 认为该回退的坏版\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"判定退步\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tif (result.status !== \"no_change\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(otherVersion);\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t\t// 没有 rollback activation 写入。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`)\n\t\t\t.get(resourceId) as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tbadVersion: \"v-xxxxxxxxxxxx\",\n\t\t\tpreviousVersion: \"v-yyyyyyyyyyyy\",\n\t\t\tsourceIds: [],\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── getEffectiveVersion ──────────────────────────────────────────────────\n\ndescribe(\"getEffectiveVersion\", () => {\n\tit(\"激活后返回新 versionId + available=true（目录完整）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(true);\n\t\texpect(info.versionDir).toContain(versionId);\n\t});\n\n\tit(\"未激活时指向 baseVersion（快照目录完整 → available=true）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedPublished(home, store);\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(baseVersion);\n\t\texpect(info.available).toBe(true);\n\t});\n\n\tit(\"指向版本目录缺失/不完整 → available=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\t// 删版本目录文件 → 指纹不匹配。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId), { recursive: true, force: true });\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst info = getEffectiveVersion(store, \"skill:missing\", home);\n\t\texpect(info.ok).toBe(false);\n\t\tif (info.ok) return;\n\t\texpect(info.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S9-04/05/06 定向测试：任务绑定（bindTaskResources/resolveTaskResourceVersion/\n * switchTaskResourceAtSafePoint/listTaskBindings/deactivateTaskBinding）+import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStoreactivateCandidate } from \"../../src/pao/memoryevolutionstore.tsactivation.ts\"; evolutionPaths \n\tbindTaskResources,\n\tdeactivateTaskBinding,\n\tlistTaskBindings,\n\tresolveTaskResourceVersion,\n\tswitchTaskResourceAtSafePoint,\n} from \"../../src/pao/paths.tsbinding.tsregisterResourcecountUsageByVersion, snapshotResourceFilesrecordUsed } from \"../../src/pao/evolution/resources.tsobserve.tspublishCandidateregisterResource,snapshotResourceFiles } from \"../../src/pao/evolution/versions.tstype MemoryStore\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,170]}}},{"equalLines":{"line_count":16}},{"diffOp":{"equal":{"range":[170,295]}}},{"diffOp":{"equal":{"range":[295,305]}}},{"diffOp":{"delete":{"range":[305,338]}}},{"diffOp":{"insert":{"range":[338,355]}}},{"diffOp":{"equal":{"range":[355,378]}}},{"diffOp":{"delete":{"range":[378,384]}}},{"diffOp":{"insert":{"range":[384,393]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[393,401]}}},{"diffOp":{"insert":{"range":[401,414]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,304]}}},{"diffOp":{"delete":{"range":[416,432]}}},{"diffOp":{"insert":{"range":[432,557]}}},{"diffOp":{"equal":{"range":[557,579]}}},{"diffOp":{"delete":{"range":[378,384]}}},{"diffOp":{"insert":{"range":[384,393]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[579,587]}}},{"diffOp":{"insert":{"range":[587,597]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,305]}}},{"diffOp":{"delete":{"range":[597,613]}}},{"diffOp":{"insert":{"range":[613,632]}}},{"diffOp":{"equal":{"range":[632,634]}}},{"diffOp":{"delete":{"range":[634,655]}}},{"diffOp":{"insert":{"range":[655,665]}}},{"diffOp":{"equal":{"range":[665,698]}}},{"diffOp":{"delete":{"range":[698,710]}}},{"diffOp":{"insert":{"range":[710,720]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,305]}}},{"diffOp":{"delete":{"range":[720,736]}}},{"diffOp":{"insert":{"range":[736,753]}}},{"diffOp":{"equal":{"range":[665,666]}}},{"diffOp":{"insert":{"range":[753,775]}}},{"diffOp":{"equal":{"range":[775,807]}}},{"diffOp":{"delete":{"range":[807,818]}}},{"diffOp":{"insert":{"range":[698,710]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,305]}}},{"diffOp":{"delete":{"range":[338,355]}}},{"diffOp":{"insert":{"range":[720,736]}}},{"diffOp":{"equal":{"range":[665,698]}}},{"diffOp":{"delete":{"range":[401,414]}}},{"diffOp":{"insert":{"range":[807,818]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,304]}}},{"diffOp":{"delete":{"range":[432,557]}}},{"diffOp":{"insert":{"range":[416,432]}}},{"diffOp":{"equal":{"range":[775,797]}}},{"diffOp":{"delete":{"range":[384,393]}}},{"diffOp":{"insert":{"range":[378,384]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[587,597]}}},{"diffOp":{"insert":{"range":[579,587]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[295,305]}}},{"diffOp":{"delete":{"range":[613,632]}}},{"diffOp":{"insert":{"range":[818,834]}}},{"diffOp":{"equal":{"range":[632,634]}}},{"diffOp":{"delete":{"range":[655,665]}}},{"diffOp":{"insert":{"range":[305,320]}}},{"diffOp":{"equal":{"range":[665,688]}}},{"diffOp":{"delete":{"range":[384,393]}}},{"diffOp":{"insert":{"range":[378,384]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[710,720]}}},{"diffOp":{"insert":{"range":[393,401]}}},{"diffOp":{"equal":{"range":[414,416]}}},{"diffOp":{"equal":{"range":[834,907]}}},{"equalLines":{"line_count":462}},{"diffOp":{"equal":{"range":[907,916]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-binding.test.ts"},"span":[1042,1114],"sourceCode":"/**\n * S9-04/05/06 定向测试：任务绑定（bindTaskResources/resolveTaskResourceVersion/\n * switchTaskResourceAtSafePoint/listTaskBindings/deactivateTaskBinding）+\n * 观察扩展（recordUsed/recordPatched/countUsageByVersion）。\n *\n * 覆盖：\n * - 绑定写入/冲突复用（UNIQUE(task_id,resource_id) 重绑更新同一行）；\n * - resolveTaskResourceVersion 返回正确版本目录；\n * - 安全点换版 switch_history 追加前后值；\n * - activeOnly 过滤、deactivate 幂等；\n * - recordUsed：无绑定拒写、versionId 缺省取绑定、显式不匹配照实记（versionMismatch）、\n *   outcome 编进 receipt_ref 前缀；\n * - recordPatched：activateCandidate 成功路径同事务落库；\n * - countUsageByVersion 按版本计数（success/failure 从 receipt_ref 前缀解析）；\n * - 「未绑定任务的错误不记 used」（绑定校验语义）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-binding.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tbindTaskResources,\n\tdeactivateTaskBinding,\n\tlistTaskBindings,\n\tresolveTaskResourceVersion,\n\tswitchTaskResourceAtSafePoint,\n} from \"../../src/pao/evolution/binding.ts\";\nimport { countUsageByVersion, recordUsed } from \"../../src/pao/evolution/observe.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-bind-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId };\n}\n\n/** 种到「已激活新版本」的资源：返回 { resourceId, baseVersion, newVersionId }。 */\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion } = seedSkill(home, store, name);\n\tconst problemId = \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（legalPassedChain 内 freeze/propose/evaluate 继承它）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, ?, ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, \"problem\", problemId, \"evidence:probe-1\", AT);\n\tconst candidateId = \"cand-1\";\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tawait legalPassedChain(store, home, {\n\t\tcandidateId,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# ${name}\\n\\n步骤一: 输入\\n步骤三: 验证\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId };\n}\n\n// ── bindTaskResources ────────────────────────────────────────────────────\n\ndescribe(\"bindTaskResources\", () => {\n\tit(\"任务开始解析 effective_version 落绑定\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\n\t\tconst result = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.bindings.length).toBe(1);\n\t\tconst b = result.bindings[0]!;\n\t\texpect(b.taskId).toBe(\"task-1\");\n\t\texpect(b.resourceId).toBe(resourceId);\n\t\texpect(b.versionId).toBe(baseVersion);\n\t\texpect(b.active).toBe(true);\n\t\texpect(b.switchHistory).toEqual([]);\n\t});\n\n\tit(\"UNIQUE(task_id,resource_id) 冲突即复用同一行（重绑更新 version）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst first = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\texpect(first.ok).toBe(true);\n\t\tif (!first.ok) return;\n\t\texpect(first.bindings[0]!.versionId).toBe(newVersionId); // 激活后 effective 已是新版\n\n\t\t// 手动把 effective 改回 baseVersion 再重绑，验证更新而非新增行。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, resourceId);\n\t\tconst second = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT2 });\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.bindings[0]!.bindingId).toBe(first.bindings[0]!.bindingId);\n\t\texpect(second.bindings[0]!.versionId).toBe(baseVersion);\n\n\t\t// 库里仍只有一行。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_task_bindings WHERE task_id = 'task-1'`)\n\t\t\t.get() as { n: number };\n\t\texpect(n.n).toBe(1);\n\t});\n\n\tit(\"资源未登记 → invalid_input，整批不写\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst result = bindTaskResources(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceIds: [resourceId, \"skill:missing\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\t// 事务回滚：合法资源也没落绑定。\n\t\tconst n = store.db.prepare(`SELECT COUNT(*) AS n FROM evolution_task_bindings`).get() as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"resourceIds 为空 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [] });\n\t\texpect(result.ok).toBe(false);\n\t});\n});\n\n// ── resolveTaskResourceVersion ────────────────────────────────────────────\n\ndescribe(\"resolveTaskResourceVersion\", () => {\n\tit(\"返回绑定版本目录（versions/<dirSafe>/<versionId>/）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-1\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(true);\n\t\tif (!resolved.ok) return;\n\t\texpect(resolved.versionId).toBe(baseVersion);\n\t\t// resourceId 含 `:`，目录名用 `_` 替换。\n\t\texpect(resolved.versionDir).toBe(\n\t\t\tjoin(evolutionPaths(home).versions, resourceId.replace(/:/g, \"_\"), baseVersion),\n\t\t);\n\t});\n\n\tit(\"未绑定 → invalid_input（不静默回退到当前 effective_version）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-nobind\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(false);\n\t\tif (resolved.ok) return;\n\t\texpect(resolved.error.code).toBe(\"invalid_input\");\n\t});\n\n\tit(\"绑定已停用 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-1\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(false);\n\t});\n});\n\n// ── switchTaskResourceAtSafePoint ─────────────────────────────────────────\n\ndescribe(\"switchTaskResourceAtSafePoint\", () => {\n\tit(\"安全点换版：switch_history 追加 {from,to,reason,at}，version_id 更新\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\t\t// 绑定时 effective 已是 newVersionId；手动把绑定改回 baseVersion 模拟旧任务。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = ? AND resource_id = ?`)\n\t\t\t.run(baseVersion, \"task-1\", resourceId);\n\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"阻塞修复后重载\",\n\t\t\tswitchedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\t\texpect(result.toVersion).toBe(newVersionId);\n\t\texpect(result.switchHistory.length).toBe(1);\n\t\texpect(result.switchHistory[0]).toEqual({\n\t\t\tfrom: baseVersion,\n\t\t\tto: newVersionId,\n\t\t\treason: \"阻塞修复后重载\",\n\t\t\tat: AT4,\n\t\t});\n\n\t\t// 绑定行已更新。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT version_id, switch_history_json FROM evolution_task_bindings WHERE task_id = 'task-1'`)\n\t\t\t.get() as { version_id: string; switch_history_json: string };\n\t\texpect(row.version_id).toBe(newVersionId);\n\t\texpect(JSON.parse(row.switch_history_json).length).toBe(1);\n\t});\n\n\tit(\"换到同版本 → 不追加历史，只刷新 bound_at\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"复核\",\n\t\t\tswitchedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.switchHistory.length).toBe(0);\n\t});\n\n\tit(\"停用绑定上换版 → invalid_input\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t});\n});\n\n// ── listTaskBindings / deactivateTaskBinding ─────────────────────────────\n\ndescribe(\"listTaskBindings / deactivateTaskBinding\", () => {\n\tit(\"activeOnly 过滤 + deactivate 幂等\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst { resourceId: resourceId2 } = seedSkill(home, store, \"other-skill\");\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId, resourceId2] });\n\t\tbindTaskResources(store, { taskId: \"task-2\", resourceIds: [resourceId] });\n\n\t\t// 全部 3 条。\n\t\tconst all = listTaskBindings(store);\n\t\texpect(all.ok && all.items.length).toBe(3);\n\t\t// activeOnly 也是 3（都还没停）。\n\t\tconst active = listTaskBindings(store, { activeOnly: true });\n\t\texpect(active.ok && active.items.length).toBe(3);\n\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst activeAfter = listTaskBindings(store, { activeOnly: true });\n\t\texpect(activeAfter.ok && activeAfter.items.length).toBe(2);\n\n\t\t// 按 taskId 过滤。\n\t\tconst task2 = listTaskBindings(store, { taskId: \"task-2\" });\n\t\texpect(task2.ok && task2.items.length).toBe(1);\n\t\texpect(task2.ok && task2.items[0]!.resourceId).toBe(resourceId);\n\n\t\t// deactivate 幂等：再停一次仍 ok，found=true（行还在）。\n\t\tconst again = deactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\texpect(again.ok && again.found).toBe(true);\n\t\t// 不存在的绑定 found=false。\n\t\tconst missing = deactivateTaskBinding(store, { taskId: \"task-x\", resourceId });\n\t\texpect(missing.ok && missing.found).toBe(false);\n\t});\n});\n\n// ── recordUsed（S9-06）───────────────────────────────────────────────────\n\ndescribe(\"recordUsed\", () => {\n\tit(\"有 active 绑定 + versionId 缺省 → 取绑定值落库\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst result = recordUsed(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\treceiptRef: \"receipt-abc\",\n\t\t\toutcome: \"success\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.versionId).toBe(baseVersion);\n\t\texpect(result.versionMismatch).toBe(false);\n\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT action, version_id, task_id, receipt_ref FROM evolution_observations WHERE observation_id = ?`)\n\t\t\t.get(result.observationId) as { action: string; version_id: string; task_id: string; receipt_ref: string };\n\t\texpect(row.action).toBe(\"used\");\n\t\texpect(row.version_id).toBe(baseVersion);\n\t\texpect(row.task_id).toBe(\"task-1\");\n\t\texpect(row.receipt_ref).toBe(\"success:receipt-abc\");\n\t});\n\n\tit(\"无绑定 → invalid_input 拒写（已加载 ≠ 实际采用）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst result = recordUsed(store, { resourceId, taskId: \"task-nobind\", outcome: \"failure\" });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\t// 「未绑定任务的错误不记 used」：库里无该行。\n\t\tconst n = store.db.prepare(`SELECT COUNT(*) AS n FROM evolution_observations`).get() as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"绑定已停用 → 拒写\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst result = recordUsed(store, { resourceId, taskId: \"task-1\" });\n\t\texpect(result.ok).toBe(false);\n\t});\n\n\tit(\"显式 versionId ≠ 绑定值 → 照实记 + versionMismatch\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst result = recordUsed(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tversionId: \"v-otherversion\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.versionId).toBe(\"v-otherversion\");\n\t\texpect(result.versionMismatch).toBe(true);\n\t\t// 落库的是显式值，不是绑定值。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT version_id FROM evolution_observations WHERE observation_id = ?`)\n\t\t\t.get(result.observationId) as { version_id: string };\n\t\texpect(row.version_id).toBe(\"v-otherversion\");\n\t\texpect(baseVersion).not.toBe(\"v-otherversion\");\n\t});\n});\n\n// ── recordPatched（S9-06，经 activateCandidate 成功路径）──────────────────\n\ndescribe(\"recordPatched\", () => {\n\tit(\"activateCandidate 成功同事务落 patched 观察\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT action, version_id, candidate_id FROM evolution_observations\n\t\t\t\t WHERE resource_id = ? AND action = 'patched'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { action: string; version_id: string; candidate_id: string } | undefined;\n\t\texpect(row).toBeDefined();\n\t\texpect(row!.version_id).toBe(newVersionId);\n\t\texpect(row!.candidate_id).toBe(candidateId);\n\t});\n});\n\n// ── countUsageByVersion ──────────────────────────────────────────────────\n\ndescribe(\"countUsageByVersion\", () => {\n\tit(\"按版本汇总 viewed/used/patched + success/failure\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, baseVersion } = await seedActivated(home, store);\n\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r1\", outcome: \"success\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r2\", outcome: \"success\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r3\", outcome: \"failure\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r4\" }); // 无 outcome 不计\n\t\t// viewed 走通用入口。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_observations (observation_id, action, resource_id, version_id, created_at)\n\t\t\t\t VALUES ('obs-v1', 'viewed', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(resourceId, newVersionId, AT);\n\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: newVersionId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (!counts.ok) return;\n\t\texpect(counts.viewed).toBe(1);\n\t\texpect(counts.used).toBe(4);\n\t\texpect(counts.patched).toBe(1); // activateCandidate 落的\n\t\texpect(counts.success).toBe(2);\n\t\texpect(counts.failure).toBe(1);\n\n\t\t// 另一个版本（baseVersion）无 patched。\n\t\tconst other = countUsageByVersion(store, { resourceId, versionId: baseVersion });\n\t\texpect(other.ok && other.patched).toBe(0);\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-04/05/06 定向测试：任务绑定（bindTaskResources/resolveTaskResourceVersion/\n * switchTaskResourceAtSafePoint/listTaskBindings/deactivateTaskBinding）+\t\texpect(resolved.versionId).toBe(baseVersion);\n\t\t// resourceId 含 `:`，目录名用 `_` 替换。\n\t\texpect(resolved.versionDir).toBe(\n\t\t\tjoin(evolutionPaths(home).versions, resourceId.replace(/:/g, \"_\"), baseVersion),\n\t\t);\n\t});\n\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT action, version_id, task_id, receipt_ref FROM evolution_observations WHERE observation_id = ?`,\n\t\t\t)\n\t\t\t.get(result.observationId) as { action: string; version_id: string; task_id: string; receipt_ref: string };\n\t\texpect(row.action).toBe(\"used\");\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,170]}}},{"equalLines":{"line_count":228}},{"diffOp":{"equal":{"range":[170,306]}}},{"diffOp":{"delete":{"range":[306,310]}}},{"diffOp":{"equal":{"range":[310,389]}}},{"diffOp":{"delete":{"range":[389,393]}}},{"diffOp":{"equal":{"range":[393,401]}}},{"equalLines":{"line_count":151}},{"diffOp":{"equal":{"range":[401,437]}}},{"diffOp":{"insert":{"range":[437,442]}}},{"diffOp":{"equal":{"range":[442,544]}}},{"diffOp":{"insert":{"range":[544,549]}}},{"diffOp":{"equal":{"range":[549,696]}}},{"equalLines":{"line_count":105}},{"diffOp":{"equal":{"range":[696,705]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-binding.test.ts"},"span":null,"sourceCode":"/**\n * S9-04/05/06 定向测试：任务绑定（bindTaskResources/resolveTaskResourceVersion/\n * switchTaskResourceAtSafePoint/listTaskBindings/deactivateTaskBinding）+\n * 观察扩展（recordUsed/recordPatched/countUsageByVersion）。\n *\n * 覆盖：\n * - 绑定写入/冲突复用（UNIQUE(task_id,resource_id) 重绑更新同一行）；\n * - resolveTaskResourceVersion 返回正确版本目录；\n * - 安全点换版 switch_history 追加前后值；\n * - activeOnly 过滤、deactivate 幂等；\n * - recordUsed：无绑定拒写、versionId 缺省取绑定、显式不匹配照实记（versionMismatch）、\n *   outcome 编进 receipt_ref 前缀；\n * - recordPatched：activateCandidate 成功路径同事务落库；\n * - countUsageByVersion 按版本计数（success/failure 从 receipt_ref 前缀解析）；\n * - 「未绑定任务的错误不记 used」（绑定校验语义）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-binding.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tbindTaskResources,\n\tdeactivateTaskBinding,\n\tlistTaskBindings,\n\tresolveTaskResourceVersion,\n\tswitchTaskResourceAtSafePoint,\n} from \"../../src/pao/evolution/binding.ts\";\nimport { countUsageByVersion, recordUsed } from \"../../src/pao/evolution/observe.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-bind-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId };\n}\n\n/** 种到「已激活新版本」的资源：返回 { resourceId, baseVersion, newVersionId }。 */\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion } = seedSkill(home, store, name);\n\tconst problemId = \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（legalPassedChain 内 freeze/propose/evaluate 继承它）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, ?, ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, \"problem\", problemId, \"evidence:probe-1\", AT);\n\tconst candidateId = \"cand-1\";\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tawait legalPassedChain(store, home, {\n\t\tcandidateId,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# ${name}\\n\\n步骤一: 输入\\n步骤三: 验证\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId };\n}\n\n// ── bindTaskResources ────────────────────────────────────────────────────\n\ndescribe(\"bindTaskResources\", () => {\n\tit(\"任务开始解析 effective_version 落绑定\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\n\t\tconst result = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.bindings.length).toBe(1);\n\t\tconst b = result.bindings[0]!;\n\t\texpect(b.taskId).toBe(\"task-1\");\n\t\texpect(b.resourceId).toBe(resourceId);\n\t\texpect(b.versionId).toBe(baseVersion);\n\t\texpect(b.active).toBe(true);\n\t\texpect(b.switchHistory).toEqual([]);\n\t});\n\n\tit(\"UNIQUE(task_id,resource_id) 冲突即复用同一行（重绑更新 version）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst first = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\texpect(first.ok).toBe(true);\n\t\tif (!first.ok) return;\n\t\texpect(first.bindings[0]!.versionId).toBe(newVersionId); // 激活后 effective 已是新版\n\n\t\t// 手动把 effective 改回 baseVersion 再重绑，验证更新而非新增行。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, resourceId);\n\t\tconst second = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT2 });\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.bindings[0]!.bindingId).toBe(first.bindings[0]!.bindingId);\n\t\texpect(second.bindings[0]!.versionId).toBe(baseVersion);\n\n\t\t// 库里仍只有一行。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_task_bindings WHERE task_id = 'task-1'`)\n\t\t\t.get() as { n: number };\n\t\texpect(n.n).toBe(1);\n\t});\n\n\tit(\"资源未登记 → invalid_input，整批不写\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst result = bindTaskResources(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceIds: [resourceId, \"skill:missing\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\t// 事务回滚：合法资源也没落绑定。\n\t\tconst n = store.db.prepare(`SELECT COUNT(*) AS n FROM evolution_task_bindings`).get() as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"resourceIds 为空 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = bindTaskResources(store, { taskId: \"task-1\", resourceIds: [] });\n\t\texpect(result.ok).toBe(false);\n\t});\n});\n\n// ── resolveTaskResourceVersion ────────────────────────────────────────────\n\ndescribe(\"resolveTaskResourceVersion\", () => {\n\tit(\"返回绑定版本目录（versions/<dirSafe>/<versionId>/）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-1\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(true);\n\t\tif (!resolved.ok) return;\n\t\texpect(resolved.versionId).toBe(baseVersion);\n\t\t// resourceId 含 `:`，目录名用 `_` 替换。\n\t\texpect(resolved.versionDir).toBe(\n\t\t\tjoin(evolutionPaths(home).versions, resourceId.replace(/:/g, \"_\"), baseVersion),\n\t\t);\n\t});\n\n\tit(\"未绑定 → invalid_input（不静默回退到当前 effective_version）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-nobind\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(false);\n\t\tif (resolved.ok) return;\n\t\texpect(resolved.error.code).toBe(\"invalid_input\");\n\t});\n\n\tit(\"绑定已停用 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst resolved = resolveTaskResourceVersion(store, { taskId: \"task-1\", resourceId, paoHome: home });\n\t\texpect(resolved.ok).toBe(false);\n\t});\n});\n\n// ── switchTaskResourceAtSafePoint ─────────────────────────────────────────\n\ndescribe(\"switchTaskResourceAtSafePoint\", () => {\n\tit(\"安全点换版：switch_history 追加 {from,to,reason,at}，version_id 更新\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\t\t// 绑定时 effective 已是 newVersionId；手动把绑定改回 baseVersion 模拟旧任务。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = ? AND resource_id = ?`)\n\t\t\t.run(baseVersion, \"task-1\", resourceId);\n\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"阻塞修复后重载\",\n\t\t\tswitchedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\t\texpect(result.toVersion).toBe(newVersionId);\n\t\texpect(result.switchHistory.length).toBe(1);\n\t\texpect(result.switchHistory[0]).toEqual({\n\t\t\tfrom: baseVersion,\n\t\t\tto: newVersionId,\n\t\t\treason: \"阻塞修复后重载\",\n\t\t\tat: AT4,\n\t\t});\n\n\t\t// 绑定行已更新。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT version_id, switch_history_json FROM evolution_task_bindings WHERE task_id = 'task-1'`)\n\t\t\t.get() as { version_id: string; switch_history_json: string };\n\t\texpect(row.version_id).toBe(newVersionId);\n\t\texpect(JSON.parse(row.switch_history_json).length).toBe(1);\n\t});\n\n\tit(\"换到同版本 → 不追加历史，只刷新 bound_at\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId], boundAt: AT });\n\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"复核\",\n\t\t\tswitchedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.switchHistory.length).toBe(0);\n\t});\n\n\tit(\"停用绑定上换版 → invalid_input\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst result = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: \"task-1\",\n\t\t\tresourceId,\n\t\t\tnewVersionId,\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t});\n});\n\n// ── listTaskBindings / deactivateTaskBinding ─────────────────────────────\n\ndescribe(\"listTaskBindings / deactivateTaskBinding\", () => {\n\tit(\"activeOnly 过滤 + deactivate 幂等\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst { resourceId: resourceId2 } = seedSkill(home, store, \"other-skill\");\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId, resourceId2] });\n\t\tbindTaskResources(store, { taskId: \"task-2\", resourceIds: [resourceId] });\n\n\t\t// 全部 3 条。\n\t\tconst all = listTaskBindings(store);\n\t\texpect(all.ok && all.items.length).toBe(3);\n\t\t// activeOnly 也是 3（都还没停）。\n\t\tconst active = listTaskBindings(store, { activeOnly: true });\n\t\texpect(active.ok && active.items.length).toBe(3);\n\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst activeAfter = listTaskBindings(store, { activeOnly: true });\n\t\texpect(activeAfter.ok && activeAfter.items.length).toBe(2);\n\n\t\t// 按 taskId 过滤。\n\t\tconst task2 = listTaskBindings(store, { taskId: \"task-2\" });\n\t\texpect(task2.ok && task2.items.length).toBe(1);\n\t\texpect(task2.ok && task2.items[0]!.resourceId).toBe(resourceId);\n\n\t\t// deactivate 幂等：再停一次仍 ok，found=true（行还在）。\n\t\tconst again = deactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\texpect(again.ok && again.found).toBe(true);\n\t\t// 不存在的绑定 found=false。\n\t\tconst missing = deactivateTaskBinding(store, { taskId: \"task-x\", resourceId });\n\t\texpect(missing.ok && missing.found).toBe(false);\n\t});\n});\n\n// ── recordUsed（S9-06）───────────────────────────────────────────────────\n\ndescribe(\"recordUsed\", () => {\n\tit(\"有 active 绑定 + versionId 缺省 → 取绑定值落库\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst result = recordUsed(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\treceiptRef: \"receipt-abc\",\n\t\t\toutcome: \"success\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.versionId).toBe(baseVersion);\n\t\texpect(result.versionMismatch).toBe(false);\n\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT action, version_id, task_id, receipt_ref FROM evolution_observations WHERE observation_id = ?`)\n\t\t\t.get(result.observationId) as { action: string; version_id: string; task_id: string; receipt_ref: string };\n\t\texpect(row.action).toBe(\"used\");\n\t\texpect(row.version_id).toBe(baseVersion);\n\t\texpect(row.task_id).toBe(\"task-1\");\n\t\texpect(row.receipt_ref).toBe(\"success:receipt-abc\");\n\t});\n\n\tit(\"无绑定 → invalid_input 拒写（已加载 ≠ 实际采用）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tconst result = recordUsed(store, { resourceId, taskId: \"task-nobind\", outcome: \"failure\" });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\t// 「未绑定任务的错误不记 used」：库里无该行。\n\t\tconst n = store.db.prepare(`SELECT COUNT(*) AS n FROM evolution_observations`).get() as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"绑定已停用 → 拒写\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tdeactivateTaskBinding(store, { taskId: \"task-1\", resourceId });\n\t\tconst result = recordUsed(store, { resourceId, taskId: \"task-1\" });\n\t\texpect(result.ok).toBe(false);\n\t});\n\n\tit(\"显式 versionId ≠ 绑定值 → 照实记 + versionMismatch\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\tconst result = recordUsed(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tversionId: \"v-otherversion\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.versionId).toBe(\"v-otherversion\");\n\t\texpect(result.versionMismatch).toBe(true);\n\t\t// 落库的是显式值，不是绑定值。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT version_id FROM evolution_observations WHERE observation_id = ?`)\n\t\t\t.get(result.observationId) as { version_id: string };\n\t\texpect(row.version_id).toBe(\"v-otherversion\");\n\t\texpect(baseVersion).not.toBe(\"v-otherversion\");\n\t});\n});\n\n// ── recordPatched（S9-06，经 activateCandidate 成功路径）──────────────────\n\ndescribe(\"recordPatched\", () => {\n\tit(\"activateCandidate 成功同事务落 patched 观察\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT action, version_id, candidate_id FROM evolution_observations\n\t\t\t\t WHERE resource_id = ? AND action = 'patched'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { action: string; version_id: string; candidate_id: string } | undefined;\n\t\texpect(row).toBeDefined();\n\t\texpect(row!.version_id).toBe(newVersionId);\n\t\texpect(row!.candidate_id).toBe(candidateId);\n\t});\n});\n\n// ── countUsageByVersion ──────────────────────────────────────────────────\n\ndescribe(\"countUsageByVersion\", () => {\n\tit(\"按版本汇总 viewed/used/patched + success/failure\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, baseVersion } = await seedActivated(home, store);\n\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r1\", outcome: \"success\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r2\", outcome: \"success\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r3\", outcome: \"failure\" });\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r4\" }); // 无 outcome 不计\n\t\t// viewed 走通用入口。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_observations (observation_id, action, resource_id, version_id, created_at)\n\t\t\t\t VALUES ('obs-v1', 'viewed', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(resourceId, newVersionId, AT);\n\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: newVersionId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (!counts.ok) return;\n\t\texpect(counts.viewed).toBe(1);\n\t\texpect(counts.used).toBe(4);\n\t\texpect(counts.patched).toBe(1); // activateCandidate 落的\n\t\texpect(counts.success).toBe(2);\n\t\texpect(counts.failure).toBe(1);\n\n\t\t// 另一个版本（baseVersion）无 patched。\n\t\tconst other = countUsageByVersion(store, { resourceId, versionId: baseVersion });\n\t\texpect(other.ok && other.patched).toBe(0);\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S8-08/09 定向测试：隔离验证执行器与边界核对。\n *import { join } from \"node:path\";\nimport { fauxAssistantMessage, registerFauxProvider } from \"@pao/ai/compat\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { CardProcessResultAuthStorage } from \"../../src/paocorecards/process.tsauth-storage.ts\";pao/cardsprocess.ts\nimport {\n\tauditCandidateForPublish,\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[73,241]}}},{"diffOp":{"equal":{"range":[241,249]}}},{"diffOp":{"delete":{"range":[249,254]}}},{"diffOp":{"equal":{"range":[254,256]}}},{"diffOp":{"delete":{"range":[256,273]}}},{"diffOp":{"insert":{"range":[273,284]}}},{"diffOp":{"equal":{"range":[284,303]}}},{"diffOp":{"delete":{"range":[303,306]}}},{"diffOp":{"insert":{"range":[306,310]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[310,326]}}},{"diffOp":{"insert":{"range":[326,341]}}},{"diffOp":{"equal":{"range":[341,343]}}},{"diffOp":{"equal":{"range":[241,249]}}},{"diffOp":{"insert":{"range":[249,254]}}},{"diffOp":{"equal":{"range":[254,256]}}},{"diffOp":{"delete":{"range":[273,284]}}},{"diffOp":{"insert":{"range":[256,273]}}},{"diffOp":{"equal":{"range":[284,303]}}},{"diffOp":{"delete":{"range":[306,310]}}},{"diffOp":{"insert":{"range":[343,352]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[326,341]}}},{"diffOp":{"insert":{"range":[352,362]}}},{"diffOp":{"equal":{"range":[341,343]}}},{"diffOp":{"equal":{"range":[362,398]}}},{"equalLines":{"line_count":959}},{"diffOp":{"equal":{"range":[398,407]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-boundary.test.ts"},"span":[1277,1363],"sourceCode":"/**\n * S8-08/09 定向测试：隔离验证执行器与边界核对。\n *\n * 覆盖：\n * - runValidationCase：baseline/candidate 各建独立 home/cwd/sessionDir，\n *   同一 initialFiles 复制；命令用例经 runCardProcess + 安检门；回执落盘\n *   evolution/validations/<testPlanId>/runs/（不在候选可写目录）。\n * - 取消/超时收尾：AbortSignal 取消结果保留取消原因；scratch 收尾删除。\n * - boundary：resolveValidationToolSet 交集外工具记入 rejected；\n *   verifyManagedInputsIntact 检测 plan.json 被改/被删；\n *   checkRunFileChangesWithinSandbox 检测越出工作目录的写入；\n *   auditCandidateForPublish 范围越界候选被拒（改策略/改验收）；\n *   auditResourceCapabilityCoverage 对 extension/command 列出未覆盖缺口。\n * - 嵌套工具调用经受控入口：限定工具集之外的调用只能走 executeTool，\n *   由受控入口统一验证（本测试以工具集核对断言入口约束存在）。\n *\n * 模型/进程一律假（agentSessionFactory 与 processRunner 注入假实现），\n * 不发起真实请求或子进程。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-boundary.test.ts --maxWorkers=2\n */\nimport { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage, registerFauxProvider } from \"@pao/ai/compat\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { CardProcessResult } from \"../../src/pao/cards/process.ts\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport {\n\tauditCandidateForPublish,\n\tauditResourceCapabilityCoverage,\n\tcheckRunFileChangesWithinSandbox,\n\tresolveValidationToolSet,\n\tsnapshotManagedFile,\n\tverifyManagedInputsIntact,\n} from \"../../src/pao/evolution/boundary.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { createValidationAgentSession, runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport type { ValidationCase } from \"../../src/pao/evolution/types.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { createInMemoryModelRegistry, getModelRuntime } from \"../model-runtime-test-utils.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-boundary-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有释放延迟；多等几拍避开 EPERM，\n\t// 不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 10; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 9) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 造一个已登记 skill 资源 + baseVersion 快照。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(\n\t\tjoin(skillDir, \"SKILL.md\"),\n\t\t\"---\\nname: code-review\\ndescription: 代码评审技能\\n---\\n# code-review\\n步骤一\\n\",\n\t\t\"utf8\",\n\t);\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tover: {\n\t\tresourceId?: string;\n\t\tbaseVersion?: string;\n\t} = {},\n) {\n\tconst problemId = \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\nfunction freezePlan(\n\tstore: ReturnType<typeof openMemoryStore>,\n\thome: string,\n\tover: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t},\n) {\n\tconst result = freezeValidationPlan(store, {\n\t\tproblemId: over.problemId,\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tpaoHome: home,\n\t\treproduction: [\n\t\t\t{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t},\n\t\t],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: AT,\n\t});\n\tif (!result.ok) throw new Error(\"freeze failed\");\n\treturn result;\n}\n\nconst COMMAND_CASE: ValidationCase = {\n\tcaseId: \"reproduction-0\",\n\tgroup: \"reproduction\",\n\tinput: \"复现输入\",\n\tinitialFiles: { \"input.txt\": \"x\" },\n\tallowedTools: [\"read\"],\n\tacceptance: \"exit 0\",\n};\n\n/** 种候选目录文件（O11/E07：candidate 侧从 candidates/ 物化版本副本）。 */\nfunction seedCandidateDir(home: string, resourceId: string, candidateId: string, content = \"# cand\\n\") {\n\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\tconst dir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(dir, { recursive: true });\n\twriteFileSync(join(dir, \"SKILL.md\"), content, \"utf8\");\n\treturn dir;\n}\n\n// ── runValidationCase ───────────────────────────────────────────────────\n\ndescribe(\"runValidationCase\", () => {\n\tit(\"baseline/candidate 各建独立 home/cwd/sessionDir，同一 initialFiles 复制\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst captured: Array<{ cwd: string; env: NodeJS.ProcessEnv }> = [];\n\t\tconst fakeRunner = (_cmd: string, _args: string[], cwd: string, _t: number, env?: NodeJS.ProcessEnv) => {\n\t\t\tcaptured.push({ cwd, env: env ?? {} });\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"ok\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst base = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"baseline\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(base.ok).toBe(true);\n\t\tif (!base.ok) return;\n\t\texpect(base.result.passed).toBe(true);\n\t\texpect(base.result.exitCode).toBe(0);\n\t\texpect(captured).toHaveLength(1);\n\t\t// cwd 是独立 scratch work 目录，且 PAO_HOME 指向隔离 home（不是正式 home）。\n\t\texpect(captured[0]!.cwd).toContain(\"work\");\n\t\texpect(captured[0]!.env.PAO_HOME).toBeDefined();\n\t\texpect(captured[0]!.env.PAO_HOME).not.toBe(home);\n\t\t// initialFiles 已复制进 workDir（通过 fileChanges 反推：input.txt 应无变化）。\n\t\texpect(base.result.fileChanges?.[\"input.txt\"]).toBeUndefined();\n\t\tstore.close();\n\t});\n\n\tit(\"运行回执落盘在 evolution/validations/<testPlanId>/runs/，不在候选可写目录\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst fakeRunner = () => Promise.resolve({ code: 0, stdout: \"out\", stderr: \"\" } as CardProcessResult);\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.receiptPath).toContain(join(\"validations\", plan.testPlanId, \"runs\"));\n\t\texpect(result.receiptPath).not.toContain(\"candidates\");\n\t\tconst receipt = JSON.parse(readFileSync(result.receiptPath, \"utf8\"));\n\t\texpect(receipt.caseId).toBe(\"reproduction-0\");\n\t\texpect(receipt.side).toBe(\"candidate\");\n\t\texpect(receipt.candidateId).toBe(\"cand-x\");\n\t\texpect(receipt.result.exitCode).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"fileChanges 记录候选在工作目录内的实际写动作\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\t// 假进程：在 workDir 里写一个文件。\n\t\tconst fakeRunner = (_c: string, _a: string[], cwd: string) => {\n\t\t\twriteFileSync(join(cwd, \"out.txt\"), \"written\", \"utf8\");\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"ok\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"-e\", \"1\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.fileChanges?.[\"out.txt\"]).toMatch(/^new:/);\n\t\tstore.close();\n\t});\n\n\tit(\"取消信号传给进程，结果保留取消原因且 scratch 收尾\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst controller = new AbortController();\n\t\tlet sawAbort = false;\n\t\t// 运行中取消：进程执行期间触发 abort，进程以 AbortError 收尾。\n\t\tconst fakeRunner = (\n\t\t\t_c: string,\n\t\t\t_a: string[],\n\t\t\t_cwd: string,\n\t\t\t_t: number,\n\t\t\t_e: NodeJS.ProcessEnv | undefined,\n\t\t\tsignal?: AbortSignal,\n\t\t) => {\n\t\t\tcontroller.abort(\"用户取消\");\n\t\t\tsawAbort = signal?.aborted === true;\n\t\t\tconst err = new Error(\"aborted\");\n\t\t\terr.name = \"AbortError\";\n\t\t\treturn Promise.reject(err);\n\t\t};\n\t\ttry {\n\t\t\tconst result = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ processRunner: fakeRunner },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"baseline\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"command\",\n\t\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\t\tsignal: controller.signal,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\texpect(result.ok).toBe(true);\n\t\t\tif (result.ok) {\n\t\t\t\texpect(sawAbort).toBe(true);\n\t\t\t\texpect(result.cancelReason).toBeDefined();\n\t\t\t\texpect(result.result.failureReason).toContain(\"已取消\");\n\t\t\t\t// scratch 已删除（keepScratch 缺省 false）。\n\t\t\t\texpect(result.scratchDir).toBeUndefined();\n\t\t\t}\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"验证器命令未过安检门即拒（候选无法注入新命令）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tlet ran = false;\n\t\tconst fakeRunner = () => {\n\t\t\tran = true;\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"baseline\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"cmd\", args: [\"/c\", \"echo\", \"hi\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(ran).toBe(false);\n\t\texpect(result.result.failureReason).toContain(\"未过安检\");\n\t\texpect(result.result.passed).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"agent 用例经 agentSessionFactory 隔离入口，显式传 agentDir/sessionDir/cwd/版本副本路径\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst captured: Array<{ agentDir: string; sessionDir: string; cwd: string; homeDir: string; resourceCopyDir?: string; timeoutMs?: number }> = [];\n\t\tconst fakeFactory = (input: { agentDir: string; sessionDir: string; cwd: string; homeDir: string; resourceCopyDir?: string; timeoutMs?: number }) => {\n\t\t\tcaptured.push(input);\n\t\t\treturn Promise.resolve({ output: \"assistant output\", completed: true, requestId: \"req-1\" });\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [\"read\"], modelConfig: { tier: \"fast\" } },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\ttimeoutMs: 60000,\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(captured).toHaveLength(1);\n\t\texpect(captured[0]!.agentDir).toContain(\"agent\");\n\t\texpect(captured[0]!.sessionDir).toContain(\"session\");\n\t\texpect(captured[0]!.cwd).toContain(\"work\");\n\t\t// O11/E07：resourceCopyDir 自动解析为物化副本目录（workDir/resource/），\n\t\t// 源目录是 candidates/<dirSafe>/<candidateId>；timeoutMs 透传工厂。\n\t\texpect(captured[0]!.resourceCopyDir).toContain(join(\"work\", \"resource\"));\n\t\texpect(captured[0]!.timeoutMs).toBe(60000);\n\t\t// 回执带 requestId。\n\t\tconst receipt = JSON.parse(readFileSync(result.receiptPath, \"utf8\"));\n\t\texpect(receipt.requestId).toBe(\"req-1\");\n\t\texpect(receipt.modelConfig?.tier).toBe(\"fast\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：command 双侧各自物化版本副本产生真实差异（baseline 旧版失败，candidate 新版通过）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// baseline 源（versions/<baseVersion>/SKILL.md）= seedSkill 写的旧版「# code-review\\n步骤一\\n」；\n\t\t// candidate 源（candidates/<cand-x>/SKILL.md）= 修复版含「步骤三」。\n\t\tseedCandidateDir(home, resourceId, \"cand-x\", \"# code-review\\n步骤一\\n步骤三\\n\");\n\n\t\t// 验证器读 resource/SKILL.md 查「步骤三」：真实进程跑 node -e（写进 initialFiles 的 check.js）。\n\t\tconst needle = \"步骤三\";\n\t\tconst checkJs = `const fs=require(\"fs\");process.exit(fs.readFileSync(\"resource/SKILL.md\",\"utf8\").includes(${JSON.stringify(needle)})?0:1);`;\n\t\tconst kase: ValidationCase = { ...COMMAND_CASE, initialFiles: { \"check.js\": checkJs }, allowedTools: [] };\n\n\t\tconst base = await runValidationCase(store, {}, {\n\t\t\tvalidationCase: kase,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tside: \"baseline\",\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tkind: \"command\",\n\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\trunAt: AT,\n\t\t});\n\t\tconst cand = await runValidationCase(store, {}, {\n\t\t\tvalidationCase: kase,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tside: \"candidate\",\n\t\t\tcandidateId: \"cand-x\",\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tkind: \"command\",\n\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\trunAt: AT,\n\t\t});\n\t\texpect(base.ok && cand.ok).toBe(true);\n\t\tif (!base.ok || !cand.ok) return;\n\t\t// baseline 旧版（无步骤三）failed；candidate 新版（有步骤三）passed——\n\t\t// 差异来自物化的版本副本，不是 initialFiles 逐侧替换。\n\t\texpect(base.result.passed).toBe(false);\n\t\texpect(cand.result.passed).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：candidate 侧 abortReason → passed:false + executionFailure=cancel\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\t// 假工厂返回 abortReason：会话被中止——执行故障，不可通过。\n\t\tconst fakeFactory = () =>\n\t\t\tPromise.resolve({ output: \"半截输出\", abortReason: \"timeout 120000ms\" });\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [] },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.passed).toBe(false);\n\t\texpect(result.result.executionFailure).toBe(\"cancel\");\n\t\texpect(result.result.failureReason).toContain(\"中止\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：真机制假模型——baseline/candidate 物化副本经同一假 provider 产出不同输出\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// baseline 版本快照（seedSkill 写入的旧版 SKILL.md 只有「步骤一」）；\n\t\t// candidate 目录写入修复版（含「步骤三」）。\n\t\tseedCandidateDir(home, resourceId, \"cand-x\", \"---\\nname: code-review\\ndescription: 代码评审技能\\n---\\n# code-review\\n步骤一\\n步骤三\\n\");\n\n\t\t// 装配假 provider + ModelRuntime（机制=真实 createValidationAgentSession，\n\t\t// 模型=faux；本用例验证「双侧副本差异经同一 provider 产生不同输出」这一\n\t\t// 链路的真实机制，真实 provider 闭环归 O15）。\n\t\tconst faux = registerFauxProvider();\n\t\ttry {\n\t\t\tconst authStorage = AuthStorage.inMemory();\n\t\t\tawait authStorage.modify(faux.getModel().provider, async () => ({ type: \"api_key\", key: \"faux-key\" }));\n\t\t\tconst modelRegistry = await createInMemoryModelRegistry(authStorage);\n\t\t\tmodelRegistry.registerProvider(faux.getModel().provider, {\n\t\t\t\tbaseUrl: faux.getModel().baseUrl,\n\t\t\t\tapiKey: \"faux-key\",\n\t\t\t\tapi: faux.api,\n\t\t\t\tmodels: faux.models.map((registeredModel) => ({\n\t\t\t\t\tid: registeredModel.id,\n\t\t\t\t\tname: registeredModel.name,\n\t\t\t\t\tapi: registeredModel.api,\n\t\t\t\t\treasoning: registeredModel.reasoning,\n\t\t\t\t\tinput: registeredModel.input,\n\t\t\t\t\tinputLimits: registeredModel.inputLimits,\n\t\t\t\t\tcost: registeredModel.cost,\n\t\t\t\t\tcontextWindow: registeredModel.contextWindow,\n\t\t\t\t\tmaxTokens: registeredModel.maxTokens,\n\t\t\t\t\tbaseUrl: registeredModel.baseUrl,\n\t\t\t\t})),\n\t\t\t});\n\t\t\tconst modelRuntime = getModelRuntime(modelRegistry);\n\n\t\t\t// 假 provider 逐调用回读模型上下文（/skill:code-review 展开把该侧\n\t\t\t// resource/SKILL.md 正文灌进 user 消息），回报正文中是否含「步骤三」。\n\t\t\tconst needle = \"步骤三\";\n\t\t\tconst contextHasNeedle = (context: { messages: Array<{ role: string; content: unknown }> }) =>\n\t\t\t\tcontext.messages.some((m) => {\n\t\t\t\t\tif (m.role !== \"user\") return false;\n\t\t\t\t\tif (typeof m.content === \"string\") return m.content.includes(needle);\n\t\t\t\t\tif (Array.isArray(m.content)) {\n\t\t\t\t\t\treturn m.content.some(\n\t\t\t\t\t\t\t(block) =>\n\t\t\t\t\t\t\t\ttypeof block === \"object\" &&\n\t\t\t\t\t\t\t\tblock !== null &&\n\t\t\t\t\t\t\t\t(block as { type?: string; text?: string }).type === \"text\" &&\n\t\t\t\t\t\t\t\t((block as { text?: string }).text ?? \"\").includes(needle),\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t\treturn false;\n\t\t\t\t});\n\t\t\tfaux.setResponses([\n\t\t\t\t(context) => fauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t\t(context) => fauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t]);\n\n\t\t\t// 用例 input=/skill:code-review —— 会话内技能展开把该侧 resource/ 副本的\n\t\t\t// SKILL.md 正文注入模型上下文；baseline 副本无步骤三、candidate 副本有。\n\t\t\tconst kase: ValidationCase = {\n\t\t\t\t...COMMAND_CASE,\n\t\t\t\tinput: \"/skill:code-review\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\t// 冻结样例固定模型（modelConfig.model=\"provider/id\"）——验证可复现，\n\t\t\t\t// 不把「可用清单首个」的偶然选择当验收依据。\n\t\t\t\tmodelConfig: { model: `${faux.getModel().provider}/${faux.getModel().id}` },\n\t\t\t};\n\t\t\tconst base = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ agentSessionFactory: (input) => createValidationAgentSession(input, { modelRuntime }) },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: kase,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"baseline\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"agent\",\n\t\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\t\ttimeoutMs: 120000,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\tconst cand = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ agentSessionFactory: (input) => createValidationAgentSession(input, { modelRuntime }) },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: kase,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"candidate\",\n\t\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"agent\",\n\t\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\t\ttimeoutMs: 120000,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\texpect(base.ok && cand.ok).toBe(true);\n\t\t\tif (!base.ok || !cand.ok) return;\n\t\t\t// 双侧会话均完整跑完（passed=会话完成语义），输出差异来自物化版本副本。\n\t\t\texpect(base.result.passed).toBe(true);\n\t\t\texpect(cand.result.passed).toBe(true);\n\t\t\texpect(base.result.output).toContain(\"skill-missing-步骤三\");\n\t\t\texpect(cand.result.output).toContain(\"skill-has-步骤三\");\n\t\t\t// 同一假 provider 共处理两次调用（baseline 一次、candidate 一次）。\n\t\t\texpect(faux.state.callCount).toBe(2);\n\t\t\tstore.close();\n\t\t} finally {\n\t\t\tfaux.unregister();\n\t\t}\n\t});\n\n\tit(\"O11/E07：agent 会话未完整收尾（completed=false）→ executionFailure=start 不当业务通过\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst fakeFactory = () => Promise.resolve({ output: \"\", completed: false });\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [] },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.passed).toBe(false);\n\t\texpect(result.result.executionFailure).toBe(\"start\");\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: 工具集限定 ────────────────────────────────────────────────\n\ndescribe(\"resolveValidationToolSet\", () => {\n\tit(\"限定工具集取交集；交集外工具记入 rejected\", () => {\n\t\tconst toolset = resolveValidationToolSet({\n\t\t\t...COMMAND_CASE,\n\t\t\tallowedTools: [\"read\", \"bash\", \"pao_verify_card\", \"grep\"],\n\t\t});\n\t\texpect(toolset.allowed).toEqual(expect.arrayContaining([\"read\", \"grep\"]));\n\t\texpect(toolset.allowed).not.toContain(\"bash\");\n\t\texpect(toolset.rejected).toEqual(expect.arrayContaining([\"bash\", \"pao_verify_card\"]));\n\t});\n\n\tit(\"嵌套工具调用经受控入口：只有交集内工具可激活\", () => {\n\t\t// 交集外的工具名（如未授权扩展工具）不进入允许清单；\n\t\t// 嵌套调用经 ExtensionToolContext.executeTool 统一验证/钩子/权限，\n\t\t// 只能命中已激活的工具集。本测试断言「未授权工具不在可激活清单」这一入口约束。\n\t\tconst toolset = resolveValidationToolSet({\n\t\t\t...COMMAND_CASE,\n\t\t\tallowedTools: [\"read\", \"malicious_tool\"],\n\t\t});\n\t\texpect(toolset.allowed).toEqual([\"read\"]);\n\t\texpect(toolset.rejected).toEqual([\"malicious_tool\"]);\n\t});\n});\n\n// ── boundary: 受管输入核对 ─────────────────────────────────────────────\n\ndescribe(\"verifyManagedInputsIntact\", () => {\n\tit(\"plan.json 未被修改时 intact\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(true);\n\t\texpect(check.violations).toHaveLength(0);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 被修改时检出违约\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\twriteFileSync(planPath, JSON.stringify({ tampered: true }), \"utf8\");\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(false);\n\t\texpect(check.violations.some((v) => v.path === \"plan.json\" && v.reason.includes(\"被修改\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 被删除时检出违约\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\trmSync(planPath);\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(false);\n\t\texpect(check.violations.some((v) => v.reason.includes(\"被删除\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: run 文件变化越区核对 ─────────────────────────────────────\n\ndescribe(\"checkRunFileChangesWithinSandbox\", () => {\n\tit(\"工作目录内的变化通过\", () => {\n\t\tconst check = checkRunFileChangesWithinSandbox({\n\t\t\t\"out.txt\": \"new:abc\",\n\t\t\t\"sub/dir/f.md\": \"changed:def\",\n\t\t});\n\t\texpect(check.withinSandbox).toBe(true);\n\t});\n\n\tit(\"越出工作目录的写入（.. 前缀）检出\", () => {\n\t\tconst check = checkRunFileChangesWithinSandbox({\n\t\t\t\"../outside.txt\": \"new:abc\",\n\t\t\t\"/abs/path\": \"new:def\",\n\t\t});\n\t\texpect(check.withinSandbox).toBe(false);\n\t\texpect(check.violations).toHaveLength(2);\n\t});\n});\n\n// ── boundary: 发布前核对 ───────────────────────────────────────────────\n\ndescribe(\"auditCandidateForPublish\", () => {\n\tfunction seedCandidate(\n\t\tstore: ReturnType<typeof openMemoryStore>,\n\t\tover: {\n\t\t\tproblemId: string;\n\t\t\tresourceId: string;\n\t\t\tbaseVersion: string;\n\t\t\ttestPlanId: string;\n\t\t\tdiffs: Array<{ path: string; kind: \"edit\" | \"create\" | \"delete\"; newContent?: string }>;\n\t\t},\n\t) {\n\t\tconst candidateId = \"cand-audit\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tover.problemId,\n\t\t\t\tover.resourceId,\n\t\t\t\tover.baseVersion,\n\t\t\t\tover.testPlanId,\n\t\t\t\tJSON.stringify(over.diffs),\n\t\t\t\t\"理由\",\n\t\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\t\"passed\",\n\t\t\t\tAT,\n\t\t\t\tAT,\n\t\t\t);\n\t\treturn {\n\t\t\tcandidateId,\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\ttestPlanId: over.testPlanId,\n\t\t\tdiffs: over.diffs,\n\t\t\trationale: \"理由\",\n\t\t\tusageRefs: [\"req-1\"],\n\t\t\tstatus: \"passed\" as const,\n\t\t\tcreatedAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t}\n\n\tit(\"范围内候选 eligible\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"已修正\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, { candidate, paoHome: home });\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(true);\n\t\texpect(audit.violations).toHaveLength(0);\n\t\tstore.close();\n\t});\n\n\tit(\"候选改资源根外文件被拒（范围越界）\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"../escape.md\", kind: \"create\", newContent: \"x\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, { candidate, paoHome: home });\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"路径逃逸\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"候选改固定禁止对象被拒（改策略/改验收）\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// 候选试图改 pao配置/档位.json（预算数值，固定禁止对象）。\n\t\t// diff.path 相对资源根 pao配置/skills/code-review；越界写到 pao配置/档位.json\n\t\t// 会被「超出资源根」先拦，这里改为直接构造完整相对路径验证固定禁止对象。\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\t\t// 手动构造一份「改验收」候选：diff.path 指向 validations 受管区（经资源根逃逸）。\n\t\t// assertCandidateWithinScope 用「资源根前缀」核对，escape 到 pao配置/ 仍会被拦。\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate: {\n\t\t\t\t...candidate,\n\t\t\t\tdiffs: [{ path: \"../../档位.json\", kind: \"edit\", newContent: \"{}\" }],\n\t\t\t},\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.length).toBeGreaterThan(0);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 在验证期间被修改时 eligible=false\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\t\twriteFileSync(planPath, JSON.stringify({ tampered: true }), \"utf8\");\n\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate,\n\t\t\tpaoHome: home,\n\t\t\tplanSnapshotBefore: before,\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"plan.json\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"run 文件变化越出工作目录时检出\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate,\n\t\t\tpaoHome: home,\n\t\t\trunFileChanges: [{ \"../outside.txt\": \"new:abc\" }],\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"越出工作目录\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: 能力缺口核对 ─────────────────────────────────────────────\n\ndescribe(\"auditResourceCapabilityCoverage\", () => {\n\tit(\"extension 资源列出直接文件/子进程能力缺口（明确不可自动发布）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"extension\", name: \"pao_x\", paoHome: home });\n\t\tconst resource = {\n\t\t\tresourceId: \"extension:pao_x\",\n\t\t\tkind: \"extension\" as const,\n\t\t\trelativeRoot: \"pao配置/extensions/pao_x\",\n\t\t\tallowedOps: [\"edit-content\", \"adjust-params\"] as const,\n\t\t\tcapabilityScope: [\"工具实现\", \"参数组织\"],\n\t\t\tloadMethod: \"extension-path\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(false);\n\t\texpect(report.gaps.length).toBeGreaterThan(0);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"子进程\"))).toBe(true);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"文件\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"command 资源：参数组织可覆盖，直接文件/子进程能力列缺口\", () => {\n\t\tconst resource = {\n\t\t\tresourceId: \"command:mycmd\",\n\t\t\tkind: \"command\" as const,\n\t\t\trelativeRoot: \"pao配置/commands/mycmd\",\n\t\t\tallowedOps: [\"adjust-params\"] as const,\n\t\t\tcapabilityScope: [\"参数组织\"],\n\t\t\tloadMethod: \"command-registry\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(false);\n\t\texpect(report.covered.some((c) => c.capability.includes(\"参数组织\"))).toBe(true);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"文件\") || g.capability.includes(\"子进程\"))).toBe(true);\n\t});\n\n\tit(\"skill 资源：文本生效验证已覆盖，publishable\", () => {\n\t\tconst resource = {\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tkind: \"skill\" as const,\n\t\t\trelativeRoot: \"pao配置/skills/code-review\",\n\t\t\tallowedOps: [\"edit-content\"] as const,\n\t\t\tcapabilityScope: [\"SKILL.md 正文\"],\n\t\t\tloadMethod: \"skill-path\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(true);\n\t\texpect(report.gaps).toHaveLength(0);\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S8-08/09 定向测试：隔离验证执行器与边界核对。\n *\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst captured: Array<{ \n\t\t\tagentDir: string;sessionDir: string;cwd: string;homeDir: string;resourceCopyDir?: string;timeoutMs?: number;\n\t\t}> = [];\n\t\tconst fakeFactory = (input: {}) => {\n\t\t\tcaptured.push(input);\n\t\t\treturn Promise.resolve({ output: \"assistant output\", completed: true, requestId: \"req-1\" });\t\tconst kase: ValidationCase = { ...COMMAND_CASE, initialFiles: { \"check.js\": checkJs }, allowedTools: [] };\n\n\t\tconst base = await runValidationCase(store,{},{\n\t\t\tvalidationCase: kase,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tside: \"baseline\",\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tkind: \"command\",\n\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\trunAt: AT,\n\t\t,\n\t\t);\n\t\tconst cand = await runValidationCase(side: \"candidate\",\n\t\t\tcandidateId: \"cand-x\",\n\t\t\t);\n\t\texpect(base.ok && cand.ok).toBe(true);\n\t\tif (!base.ok || !cand.ok) return;\n\t\t// 假工厂返回 abortReason：会话被中止——执行故障，不可通过。\n\t\tconst fakeFactory = () =>Promise.resolve({ output: \"半截输出\", abortReason: \"timeout 120000ms\" });\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\t\t// baseline 版本快照（seedSkill 写入的旧版 SKILL.md 只有「步骤一」）；\n\t\t// candidate 目录写入修复版（含「步骤三」）。\n\t\tseedCandidateDir(home,\"cand-x\",\"---\\nname: code-review\\ndescription: 代码评审技能\\n---\\n# code-review\\n步骤一\\n步骤三\\n\");\n\n\t\t// 装配假 provider + ModelRuntime（机制=真实 createValidationAgentSession，\t\t\t\t});\n\t\t\tfaux.setResponses([\n\t\t\t\t(context) =>\n\t\t\t\t\tfauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t\t(context) =>fauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t]);\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":372}},{"diffOp":{"equal":{"range":[73,147]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[152,169]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[169,188]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[188,200]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[200,216]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[216,241]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[241,259]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[259,263]}}},{"diffOp":{"equal":{"range":[263,303]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[152