\t\t\t\ttry {\t\t\t\t\t\tconst scriptPlan = await planScriptRun({\t\t\t\t\t\t\tcard: claimed.card,\t\t\t\t\t\t\tattempt: claimed.尝试号,\t\t\t\t\t\t\tevidenceDir,\t\t\t\t\t\t});\t\t\t\t\t\trunOptions.命令 = scriptPlan.interpreter;\t\t\t\t\t\trunOptions.参数 = scriptPlan.args;\t\t\t\t\t\trunOptions.要求回执 = false;\t\t\t\t\t\trunOptions.超时毫秒 = scriptPlan.超时毫秒;\t\t\t\t\t\t// 脚本无模型提示词：buildDispatchRunOptions 已带提示词，覆盖路径把它清空，\t\t\t\t\t\t// buildArgs 对空提示词不再追加参数（runner.ts 提示词分支）。\t\t\t\t\t\trunOptions.提示词 = \"\";\t\t\t\t\t\t// pi 专属参数不得尾随进脚本解释器 argv：buildArgs 会把这些字段各拼成\t\t\t\t\t\t// 命令行开关，脚本走 参数 覆盖后这些键仍残留就要清掉（含 blackboardPointer\t\t\t\t\t\t// 注入的附加系统提示词）。\t\t\t\t\t\trunOptions.模型 = undefined;\t\t\t\t\t\trunOptions.思考档 = undefined;\t\t\t\t\t\trunOptions.工具白名单 = undefined;\t\t\t\t\t\trunOptions.skills = undefined;\t\t\t\t\t\trunOptions.附加系统提示词 = undefined;\t\t\t\t\t\trunOptions.会话标识 = undefined;\t\t\t\t\t\trunOptions.延续会话 = undefined;\t\t\t\t\t\trunOptions.会话目录 = undefined;\t\t\t\t\t} catch (error) {\t\t\t\t\t\t// 解释器缺失/正文超限/物化失败——不抛派发异常，合成本次尝试的\t\t\t\t\t\t// script_start 终态回执；证据落真实文件，走完同一条 appendDispatchReceipt 通道。\t\t\t\t\t\tconst reason = error instanceof Error ? error.message : String(error);\t\t\t\t\t\tawait mkdir(evidenceDir, { recursive: true });\t\t\t\t\t\tconst evidencePath = join(\t\t\t\t\t\t\t`卡${String(claimed.card.card_no).padStart(4, \"0\")}-尝试${claimed.尝试号}-script_start.json`,\t\t\t\t\t\t);\t\t\t\t\t\tawait writeFileAtomic(\t\t\t\t\t\t\tevidencePath,\t\t\t\t\t\t\t`${JSON.stringify({\t\t\t\t\t\t\t\ttype: \"pao_script_start\",\t\t\t\t\t\t\t\t卡号: claimed.card.card_no,\t\t\t\t\t\t\t\t卡路径: claimed.card.path,\t\t\t\t\t\t\t\t尝试: claimed.尝试号,\t\t\t\t\t\t\t\t执行标识: randomUUID(),\t\t\t\t\t\t\t\t原因: reason,\t\t\t\t\t\t\t\t时间: utcNow(),\t\t\t\t\t\t\t})}\\n`,\t\t\t\t\t\tscriptStartFailure = {\t\t\t\t\t\t\tcard_no: String(claimed.card.card_no).padStart(4, \"0\"),\t\t\t\t\t\t\tstatus: \"failed\",\t\t\t\t\t\t\tartifact_path: [],\t\t\t\t\t\t\tsummary: `脚本启动失败：${reason}`,\t\t\t\t\t\t\tusage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0, turns: 0 },\t\t\t\t\t\t\texitCode: -1,\t\t\t\t\t\t\tstopReason: \"script_start\",\t\t\t\t\t\t\tfailure_type: \"script_start\",\t\t\t\t\t\t\tevidence_path: evidencePath,\t\t\t\t\t\t\tscriptRun: true,\t\t\t\t\t\t\tcommand: `script_start:${reason}`,\t\t\t\t\t\t\tpid: -1,\t\t\t\t\t\t\tduration_ms: 0,\t\t\t\t// O13/E14 受控技能绑定（派发装配点）：新会话 worker 在 spawn 前把将装载的\t\t\t\t// 受控技能绑进本任务——taskId = runOptions.会话标识（worker 子进程\t\t\t\t// sessionId 经 --session-id 收到同一值，worker 内 createRuntime 的绑定\t\t\t\t// 解析天然命中同一键）。技能路径 basename → `skill:<name>` resourceId。\t\t\t\t// 延续会话与脚本卡不绑——绑定语义是「本任务若用就固定这个版本」，延续\t\t\t\t// 会话已由旧 taskId 持有绑定；无会话 worker（--no-session）没有\t\t\t\t// sessionId 可传，不参与绑定换版。\t\t\t\t// 绑定失败记派发告警不拒派（技能装载不阻塞业务；残余失败如实留痕）。\t\t\t\tlet workerBindingTaskId: string | undefined;\t\t\t\tlet workerBoundResourceIds: string[] = [];\t\t\t\tif (!scriptCard && runOptions.skills !== undefined && runOptions.skills.length > 0 && options.paoHome) {\t\t\t\t\tconst bindingTaskId = runOptions.会话标识 ?? randomUUID();\t\t\t\t\tif (runOptions.会话标识 === undefined) runOptions.会话标识 = bindingTaskId;\t\t\t\t\tworkerBindingTaskId = bindingTaskId;\t\t\t\t\tconst resourceIds = [\t\t\t\t\t\t...new Set(\t\t\t\t\t\t\trunOptions.skills\t\t\t\t\t\t\t\t.map((skillPath) => basename(skillPath))\t\t\t\t\t\t\t\t.filter((name) => name !== \"\")\t\t\t\t\t\t\t\t.map((name) => `skill:${name}`),\t\t\t\t\t\t),\t\t\t\t\t];\t\t\t\t\tworkerBoundResourceIds = resourceIds;\t\t\t\t\tif (resourceIds.length > 0 && existsSync(memoryPaths(options.paoHome).database)) {\t\t\t\t\t\tconst bindStore = openMemoryStore(options.paoHome, \"readwrite\");\t\t\t\t\t\ttry {\t\t\t\t\t\t\tconst ensured = ensureTaskBindings(bindStore, {\t\t\t\t\t\t\t\ttaskId: bindingTaskId,\t\t\t\t\t\t\t\tpaoHome: options.paoHome,\t\t\t\t\t\t\t\tresourceIds,\t\t\t\t\t\t\t});\t\t\t\t\t\t\tif (!ensured.ok) {\t\t\t\t\t\t\t\trunOptions.派发告警 = [\t\t\t\t\t\t\t\t\t...(runOptions.派发告警 ?? []),\t\t\t\t\t\t\t\t\t`[evolution] 任务绑定初始化失败（taskId=${bindingTaskId}）：${ensured.error.message}（worker 沿用资源根装载）`,\t\t\t\t\t\t\t\t];\t\t\t\t\t\t} finally {\t\t\t\t\t\t\tbindStore.close();\t\t\t\t// 派发缺省超时(兜底护栏):调用方未显式给 超时毫秒 时按保温配置兜底(缺省 24 小时)——\t\t\t\t// 到点走与主动停止相同的收敛路径(树杀→证据→超时回执→finally 放锁/名额),不留无限期悬挂。\t\t\t\t// B 档定位:静默提醒叫人裁决是主判决,本超时只兜「无人应答」的底。\t\t\t\trunOptions.超时毫秒 ??= readDispatchTimeoutMs(options.paoHome);\t\t\t\t// 认领租约(S5 包3,运行器事实):认领时间/租约到期＝监督信号(到期不自动放权,amber 呈现),\t\t\t\t// 认领代数＝接管代际;时长与派发超时同源配置,随 run() 落登记表条目。\t\t\t\trunOptions.租约 = buildClaimLease(\t\t\t\t\tnew Date(),\t\t\t\t\trunOptions.超时毫秒,\t\t\t\t\trunner.registry.claimGeneration(claimed.card.path),\t\t\t\t// 门禁放行且认领成功＝这次真开跑:把\"预留\"转成\"已提交\"（此刻之后不再归还,\t\t\t\t// 因为 worker 可能已经花了钱）。commit 只落盘记账,不拉起任何进程。\t\t\t\t// 清空 gate 的时机在 commit 成功之后:commit 自己抛错＝还没开跑,交给 finally 归还。\t\t\t\tawait releaseSharedLock(sharedLock);\t\t\t\tsharedLock = undefined;\t\t\t\tif (gate) {\t\t\t\t\tawait gate.commit();\t\t\t\t\tcommittedGate = gate;\t\t\t\t\tgate = undefined;\t\t\t\t\tgatePhase.value = \"committed\";\t\t\t\tlet receipt: WorkerReceipt;\t\t\t\t\tif (scriptStartFailure) {\t\t\t\t\t\treceipt = scriptStartFailure;\t\t\t\t\t} else {\t\t\t\t\t\trunnerPhase = \"started\";\t\t\t\t\t\tfailurePhase = \"started\";\t\t\t\t\t\treceipt = await runner.run(runOptions);\t\t\t\t\tpreStartClaimRollback = undefined;\t\t\t\t} catch (error) {\t\t\t\t\tconst settlementNote =\t\t\t\t\t\tgatePhase.value === \"committed\"\t\t\t\t\t\t\t? await settleGateOnce(committedGate, gatePhase, (committed) =>\t\t\t\t\t\t\t\t\tcommitted.settleUnknown(errorMessage(error)),\t\t\t\t\t\t\t\t)\t\t\t\t\t\t\t: undefined;\t\t\t\t\tthrow errorWithSettlementNote(error, settlementNote);\t\t\t\t// 脚本卡后置核对（批3b-E 调用层归类）：exit 0 且声明产物缺失 → script_artifact_missing；\t\t\t\t// 非零退出 → script_exit:<code>；超时 → script_timeout；进程没拉起 → script_start。\t\t\t\t// 取消沿既有 canceled 终态不改写；success 且产物齐全保持成功。\t\t\t\tif (scriptCard && !scriptStartFailure) {\t\t\t\t\treceipt.scriptRun = true;\t\t\t\t\tconst scriptDeclared = claimed.card.frontmatter.artifacts ?? [];\t\t\t\t\tif (receipt.status === \"success\" && receipt.exitCode === 0 && scriptDeclared.length > 0) {\t\t\t\t\t\tconst projectRoot = scriptArtifactProjectRoot(claimed.card, claimed.尝试号);\t\t\t\t\t\tconst checked = checkScriptArtifacts(scriptDeclared, projectRoot);\t\t\t\t\t\tif (checked.缺失.length > 0) {\t\t\t\t\t\t\treceipt.status = \"failed\";\t\t\t\t\t\t\treceipt.failure_type = \"script_artifact_missing\";\t\t\t\t\t\t\treceipt.artifact_path = checked.存在;\t\t\t\t\t\t\treceipt.summary = [\t\t\t\t\t\t\t\t`脚本退出码 0 但声明产物缺失：${checked.缺失.join(\"、\")}`,\t\t\t\t\t\t\t\t`已有产物已保留作诊断；按项目根 ${projectRoot} 复核`,\t\t\t\t\t\t\t].join(\"\\n\");\t\t\t\t\t\t} else {\t\t\t\t\t\t\t// 退出 0 且全部声明产物存在：产物按绝对路径写实收清单。\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.stopReason === \"timeout\") {\t\t\t\t\t\treceipt.failure_type = \"script_timeout\";\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.exitCode !== 0 && receipt.exitCode > 0) {\t\t\t\t\t\treceipt.failure_type = scriptExitFailureType(receipt.exitCode);\t\t\t\t\t\t(receipt.status === \"failed\" || receipt.status === \"unknown\") &&\t\t\t\t\t\treceipt.exitCode < 0 &&\t\t\t\t\t\treceipt.pid <= 0\t\t\t\t\t) {\t\t\t\t\t\treceipt.status = \"failed\";\t\t\t\t\t\treceipt.failure_type = \"script_start\";\t\t\t\t\t// 两路尾部注明流名与是否截断（批3b-E 规格「写卡时注明流名及是否截断」）：\t\t\t\t\t// 卡面摘要 ≤3 行是硬校验，标注并入末行（不新增行）防顶破上限；\t\t\t\t\t// 尾部原文经 stdoutTail/stderrFullTail 送达调用方与证据。\t\t\t\t\tconst tailNote = [\t\t\t\t\t\treceipt.stdoutTail !== undefined\t\t\t\t\t\t\t? `stdout 尾部${receipt.stdoutTruncated ? \"（已截断）\" : \"（未截断）\"}`\t\t\t\t\t\t\t: undefined,\t\t\t\t\t\treceipt.stderrFullTail !== undefined\t\t\t\t\t\t\t? `stderr 尾部${receipt.stderrTruncated ? \"（已截断）\" : \"（未截断）\"}`\t\t\t\t\t\t.filter(Boolean)\t\t\t\t\t\t.join(\"；\");\t\t\t\t\tif (tailNote) {\t\t\t\t\t\tconst lines = receipt.summary.split(\"\\n\");\t\t\t\t\t\tlines[lines.length - 1] = `${lines[lines.length - 1]}（${tailNote}）`;\t\t\t\t\t\t