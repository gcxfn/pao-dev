,1621]}}},{"diffOp":{"insert":{"range":[609,614]}}},{"diffOp":{"equal":{"range":[2964,3042]}}},{"equalLines":{"line_count":92}},{"diffOp":{"equal":{"range":[3042,3063]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\fixtures\\evolve-handler.ts"},"span":null,"sourceCode":"/**\n * O10/E01 测试夹具：造一个带 evolve handler 的 MaintenanceSchedulerDeps.handlers。\n *\n * 生产侧 buildMaintenanceHandlers 是 tools.ts 的私有函数（连同 embed/organize/\n * archive 一起注册）。测试只需要 evolve 链——本夹具复制 evolve handler 的\n * 串行编排（classify→select→资源门→freeze→propose），但把「事件 ctx 现取」\n * 之外的可注入依赖（tierConfig/outbound/outboundProjects）经入参显式塞入，\n * 不读档位/外发文件。\n *\n * 与生产实现的差异只在外部依赖入口；编排顺序与「能力未接」收口口径一致。\n */\nimport type { ExtensionContext } from \"../../../src/core/extensions/types.ts\";\nimport type { SessionManager } from \"../../../src/core/session-manager.ts\";\nimport type { OutboundConfig } from \"../../../src/pao/knowledge/outbound.ts\";\nimport type { MaintenanceHandler, MaintenanceSchedulerDeps } from \"../../../src/pao/memory/maintenance.ts\";\nimport type { ExtractionJob } from \"../../../src/pao/memory/types.ts\";\nimport type { TierConfig } from \"../../../src/pao/routing/config.ts\";\nimport { classifyProblem } from \"../../../src/pao/evolution/problems.ts\";\nimport { getResource } from \"../../../src/pao/evolution/resources.ts\";\nimport { selectImprovement } from \"../../../src/pao/evolution/select.ts\";\nimport { freezeValidationPlan } from \"../../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../../src/pao/evolution/candidates.ts\";\nimport { runValidationCase } from \"../../../src/pao/evolution/runner.ts\";\nimport { evaluateCandidate } from \"../../../src/pao/evolution/evaluate.ts\";\nimport { publishCandidate } from \"../../../src/pao/evolution/versions.ts\";\nimport type { ValidationCase, ValidationCaseResult, ValidationRunResult } from \"../../../src/pao/evolution/types.ts\";\n\nexport interface EvolveHandlerFixtureOptions {\n\tpaoHome: string;\n\ttierConfig: TierConfig;\n\toutbound: OutboundConfig;\n\toutboundProjects: string[];\n\t/** O11 缝：注入假 agentSessionFactory（不发起真实模型请求）。 */\n\tagentSessionFactory?: (\n\t\tinput: import(\"../../../src/pao/evolution/runner.ts\").AgentSessionFactoryInput,\n\t) => Promise<import(\"../../../src/pao/evolution/runner.ts\").AgentSessionRunOutcome>;\n\t/** O11 缝：注入假 processRunner（command 型用例不发起真实子进程）。 */\n\tprocessRunner?: typeof import(\"../../../src/pao/cards/process.ts\").runCardProcess;\n}\n\ninterface EvolveJobScope {\n\tprojectId: string;\n}\n\nfunction parseEvolveJobScope(sourceScope: string): EvolveJobScope | undefined {\n\ttry {\n\t\tconst parsed = JSON.parse(sourceScope) as { projectId?: unknown };\n\t\tif (typeof parsed.projectId !== \"string\" || parsed.projectId.trim() === \"\") return undefined;\n\t\treturn { projectId: parsed.projectId };\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/**\n * 返回只含 evolve handler 的注册表；embed/organize/archive 未注册（领到会\n * failJob「未注册类别」，与生产同口径——本测试只 enqueue evolve）。\n */\nexport function getEvolveMaintenanceHandlersForTest(\n\toptions: EvolveHandlerFixtureOptions,\n): Partial<Record<\"evolve\", MaintenanceHandler>> {\n\tconst evolve: MaintenanceHandler = async (ctx: ExtensionContext, job: ExtractionJob, deps: MaintenanceSchedulerDeps, signal: AbortSignal) => {\n\t\tconst scope = parseEvolveJobScope(job.sourceScope);\n\t\tif (scope === undefined) {\n\t\t\tthrow new Error(`进化作业 sourceScope 缺少合法 projectId:${job.sourceScope}`);\n\t\t}\n\t\tconst ledger = deps.ledger ?? {\n\t\t\tappendUsage: () => ({}) as never,\n\t\t\tappendCustomEntry: () => ({}) as never,\n\t\t};\n\t\tlet cursor: string | undefined;\n\t\tconst pendingProblems = deps.store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT problem_id, status FROM evolution_problems\n\t\t\t\t WHERE project_id = ? AND status IN ('observed','classified')\n\t\t\t\t ORDER BY created_at, problem_id`,\n\t\t\t)\n\t\t\t.all(scope.projectId) as Array<{ problem_id: string; status: string }>;\n\t\t// 注：all() 返回蛇形字段名，须用 problem_id 而非 problemId（首轮调试曾\n\t\t// 因驼峰映射拿到 undefined 绑定到 SQLite，抛 bind 错误）。\n\t\tfor (const row of pendingProblems) {\n\t\t\tif (signal.aborted) return { done: false, ...(cursor === undefined ? {} : { cursor }) };\n\t\t\tcursor = await evolveOneProblem(deps.store, {\n\t\t\t\tctx,\n\t\t\t\tjob,\n\t\t\t\tledger,\n\t\t\t\toutboundProject: options.outboundProjects[0],\n\t\t\t\tprojectId: scope.projectId,\n\t\t\t\tproblemId: row.problem_id,\n\t\t\t\tproblemStatus: row.status,\n\t\t\t\tpaoHome: deps.paoHome,\n\t\t\t\tsignal,\n\t\t\t\tcursor,\n\t\t\t\ttierConfig: options.tierConfig,\n\t\t\t\toutbound: options.outbound,\n\t\t\t\tagentSessionFactory: options.agentSessionFactory,\n\t\t\t\tprocessRunner: options.processRunner,\n\t\t\t});\n\t\t}\n\t\treturn { done: true, ...(cursor === undefined ? {} : { cursor }) };\n\t};\n\treturn { evolve };\n}\n\ninterface EvolveOneProblemDeps {\n\tctx: ExtensionContext;\n\tjob: ExtractionJob;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\toutboundProject: string;\n\tprojectId: string;\n\tproblemId: string;\n\tproblemStatus: string;\n\tpaoHome: string;\n\tsignal: AbortSignal;\n\tcursor?: string;\n\ttierConfig: TierConfig;\n\toutbound: OutboundConfig;\n\t/** O11 缝（测试注入）。 */\n\tagentSessionFactory?: EvolveHandlerFixtureOptions[\"agentSessionFactory\"];\n\tprocessRunner?: EvolveHandlerFixtureOptions[\"processRunner\"];\n}\n\nasync function evolveOneProblem(\n\tstore: MaintenanceSchedulerDeps[\"store\"],\n\tover: EvolveOneProblemDeps,\n): Promise<string | undefined> {\n\tconst { problemId } = over;\n\tconst now = () => new Date().toISOString();\n\n\tif (over.problemStatus === \"observed\") {\n\t\tconst classified = classifyProblem(store, { problemId, classifiedAt: now() });\n\t\tif (!classified.ok) {\n\t\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\t\tjobId: over.job.jobId,\n\t\t\t\tproblemId,\n\t\t\t\tstage: \"classify\",\n\t\t\t\treason: classified.error.message,\n\t\t\t});\n\t\t\treturn problemId;\n\t\t}\n\t}\n\n\tconst selected = selectImprovement(store, { problemId, selectedAt: now() });\n\tif (!selected.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"select\",\n\t\t\treason: selected.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\tif (selected.disposition !== \"candidate\" || selected.target === undefined) {\n\t\treturn problemId;\n\t}\n\n\tconst resource = getResource(store, selected.target.resourceId);\n\tif (!resource.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"resource\",\n\t\t\treason: resource.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\tif (resource.kind !== \"skill\" || resource.loadMethod !== \"skill-path\") {\n\t\tconst reason = `能力未接:资源 ${resource.resourceId}（kind=${resource.kind}, loadMethod=${resource.loadMethod}）不在 O10 已接的 skill/skill-path 通道`;\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"resource-gate\",\n\t\t\tresourceId: resource.resourceId,\n\t\t\treason,\n\t\t});\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'development_suggestion', disposition = 'development_suggestion', reason = ?, updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(reason, now(), problemId);\n\t\treturn problemId;\n\t}\n\n\tconst problem = store.db\n\t\t.prepare(`SELECT expected_behavior, actual_behavior, summary, base_version, evidence_refs_json FROM evolution_problems WHERE problem_id = ?`)\n\t\t.get(problemId) as\n\t\t| { expected_behavior: string; actual_behavior: string; summary: string; base_version: string | null; evidence_refs_json: string }\n\t\t| undefined;\n\tif (problem === undefined || problem.base_version === null) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"freeze\",\n\t\t\treason: \"问题缺 baseVersion，无法冻结验收\",\n\t\t});\n\t\treturn problemId;\n\t}\n\tconst frozen = freezeValidationPlan(store, {\n\t\tproblemId,\n\t\tresourceId: resource.resourceId,\n\t\tbaseVersion: problem.base_version,\n\t\tpaoHome: over.paoHome,\n\t\treproduction: [{ input: problem.actual_behavior, initialFiles: {}, allowedTools: [], acceptance: problem.expected_behavior }],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: now(),\n\t\tsourceRefs: (JSON.parse(problem.evidence_refs_json) as string[])\n\t\t\t.filter((ref) => ref.startsWith(\"src-\"))\n\t\t\t.map((sourceId) => ({ sourceId })),\n\t});\n\tif (!frozen.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"freeze\",\n\t\t\treason: frozen.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\n\tconst proposed = await proposeCandidate(store, {\n\t\tmodelRegistry: over.ctx.modelRegistry,\n\t\tledger: over.ledger,\n\t\tpaoHome: over.paoHome,\n\t\tbudgetPaoHome: over.paoHome,\n\t\toutboundProjects: [over.outboundProject],\n\t\ttierConfig: over.tierConfig,\n\t\toutbound: over.outbound,\n\t\tbudget: { jobId: over.job.jobId, kind: \"evolve\" },\n\t}, {\n\t\tproblemId,\n\t\tresourceId: resource.resourceId,\n\t\tbaseVersion: problem.base_version,\n\t\ttestPlanId: frozen.testPlanId,\n\t\tallowedFiles: [],\n\t\tdevCases: [{ input: problem.actual_behavior, failure: problem.actual_behavior, expected: problem.expected_behavior }],\n\t\tsignal: over.signal,\n\t\tcreatedAt: now(),\n\t});\n\tif (!proposed.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tstage: \"propose\",\n\t\t\treason: proposed.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\tif (proposed.status === \"rejected\") {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-rejected\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\treason: proposed.reason,\n\t\t});\n\t\treturn problemId;\n\t}\n\tif (proposed.status !== \"changed\") {\n\t\treturn problemId;\n\t}\n\tconst candidateId = proposed.candidateId;\n\n\t// O11 续段：双侧验证 → 评估 → 发布（与生产 evolveOneProblem 同序）。\n\tconst runBoth = async (validationCase: ValidationCase) => {\n\t\tconst results = {} as Record<\"baseline\" | \"candidate\", ValidationRunResult>;\n\t\tconst fileChanges: Record<string, string>[] = [];\n\t\tfor (const side of [\"baseline\", \"candidate\"] as const) {\n\t\t\tif (over.signal.aborted) return { aborted: true as const, fileChanges };\n\t\t\tconst run = await runValidationCase(store, {\n\t\t\t\t...(over.agentSessionFactory ? { agentSessionFactory: over.agentSessionFactory } : {}),\n\t\t\t\t...(over.processRunner ? { processRunner: over.processRunner } : {}),\n\t\t\t}, {\n\t\t\t\tvalidationCase,\n\t\t\t\tresourceId: resource.resourceId,\n\t\t\t\tbaseVersion: problem.base_version!,\n\t\t\t\tside,\n\t\t\t\t...(side === \"candidate\" ? { candidateId } : {}),\n\t\t\t\ttestPlanId: frozen.testPlanId,\n\t\t\t\tpaoHome: over.paoHome,\n\t\t\t\tkind: over.agentSessionFactory ? \"agent\" : \"command\",\n\t\t\t\t// command 用例需 verifier（假 processRunner 注入时命令不实际执行，\n\t\t\t\t// 但字段须完整才走得到 command 分支）。\n\t\t\t\t...(over.agentSessionFactory ? {} : { verifier: { cmd: \"node\", args: [\"check.js\"] } }),\n\t\t\t\tloadMethod: resource.loadMethod,\n\t\t\t\tsignal: over.signal,\n\t\t\t\ttimeoutMs: 120000,\n\t\t\t\trunAt: now(),\n\t\t\t});\n\t\t\tif (!run.ok) {\n\t\t\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\t\t\tjobId: over.job.jobId,\n\t\t\t\t\tproblemId,\n\t\t\t\t\tstage: \"run\",\n\t\t\t\t\tcaseId: validationCase.caseId,\n\t\t\t\t\tside,\n\t\t\t\t\treason: run.error.message,\n\t\t\t\t});\n\t\t\t\treturn { aborted: true as const, fileChanges };\n\t\t\t}\n\t\t\tresults[side] = run.result;\n\t\t\tif (run.result.fileChanges) fileChanges.push(run.result.fileChanges);\n\t\t}\n\t\treturn { aborted: false as const, results, fileChanges };\n\t};\n\n\tconst caseResults: ValidationCaseResult[] = [];\n\tfor (const validationCase of [...frozen.plan.reproduction, ...frozen.plan.normal, ...frozen.plan.holdout]) {\n\t\tconst out = await runBoth(validationCase);\n\t\tif (out.aborted) return problemId;\n\t\tcaseResults.push({\n\t\t\tcaseId: validationCase.caseId,\n\t\t\tbaseline: out.results.baseline,\n\t\t\tcandidate: out.results.candidate,\n\t\t\tverdict: \"passed\",\n\t\t});\n\t}\n\n\tconst evaluated = evaluateCandidate(store, {\n\t\tcandidateId,\n\t\ttestPlanId: frozen.testPlanId,\n\t\tpaoHome: over.paoHome,\n\t\tcaseResults,\n\t\tcreatedAt: now(),\n\t});\n\tif (!evaluated.ok || evaluated.verdict !== \"passed\") {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-verdict\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tcandidateId,\n\t\t\tverdict: evaluated.ok ? evaluated.verdict : evaluated.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\n\tconst published = await publishCandidate(store, { candidateId, paoHome: over.paoHome, createdAt: now() });\n\tif (published.ok && \"versionId\" in published) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-published\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tcandidateId,\n\t\t\tversionId: published.versionId,\n\t\t});\n\t} else {\n\t\treturn problemId;\n\t}\n\n\t// O13 续段：激活（与生产 evolveOneProblem 第 8 步同序——不激活则新会话绑的还是旧版）。\n\tconst { activateCandidate } = await import(\"../../../src/pao/evolution/activation.ts\");\n\tconst expectedEffectiveVersion = resource.effectiveVersion ?? problem.base_version!;\n\tconst activated = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion,\n\t\tpaoHome: over.paoHome,\n\t\treason: `自动进化激活（作业 ${over.job.jobId}，问题 ${problemId}）`,\n\t\tcreatedAt: now(),\n\t});\n\tif (!activated.ok) {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-skip\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tcandidateId,\n\t\t\tstage: \"activate\",\n\t\t\treason: activated.error.message,\n\t\t});\n\t\treturn problemId;\n\t}\n\tif (\"status\" in activated && activated.status === \"conflict\") {\n\t\tover.ledger.appendCustomEntry(\"pao-evolution-verdict\", {\n\t\t\tjobId: over.job.jobId,\n\t\t\tproblemId,\n\t\t\tcandidateId,\n\t\t\tverdict: \"activate_conflict\",\n\t\t\treason: activated.reason,\n\t\t});\n\t\treturn problemId;\n\t}\n\tover.ledger.appendCustomEntry(\"pao-evolution-activated\", {\n\t\tjobId: over.job.jobId,\n\t\tproblemId,\n\t\tcandidateId,\n\t\t...(\"versionId\" in activated ? { versionId: activated.versionId } : {}),\n\t});\n\treturn problemId;\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * O10/E01 测试夹具：造一个带 evolve handler 的 MaintenanceSchedulerDeps.handlers。\n * */\nimport type { ExtensionContext } from \"../../../src/core/extensions/types.ts\";\nimport type { SessionManager } from \"../../../src/core/session-manager.ts\";\nimport type { OutboundConfigproposeCandidate } from \"../../../src/pao/knowledgeevolutionoutbound.tscandidates.ts\"; MaintenanceHandler,MaintenanceSchedulerDepsevaluateCandidatememorymaintenance.tsevaluate.tsExtractionJobclassifyProblemtypes.tsproblems.tsTierConfiggetResourceroutingconfig.tsresources.ts\nimport { runValidationCase } from \"../../../src/pao/evolution/runner.tsselectImprovementselect.tsValidationCase, ValidationCaseResult, ValidationRunResult\nimport { freezeValidationPlan } from \"../../../src/pao/evolution/validation.ts\";publishCandidateversions.tsMaintenanceHandler,MaintenanceSchedulerDeps } from \"../../../src/pao/\nimport type { ValidationRunResult \n\nexport interface EvolveHandlerFixtureOptions {\treturn problemId;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":7}}