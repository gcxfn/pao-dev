\t\t\t};\r\n\t\t\t\t// 附加系统提示词是追加语义:配方提示(resolveDispatchParameters)与调用方注入\r\n\t\t\t\t// (M2-01 宿主的交接页指针等)拼接,不互相覆盖;黑板指针压轴(最贴近接卡动作);\r\n\t\t\t\t// 冻结简报正文是任务主入口,由 buildWorkerPrompt 直接注入。\r\n\t\t\t\tconst extraPrompt = [\r\n\t\t\t\t\t...(resolved.附加系统提示词 ?? []),\r\n\t\t\t\t\t...(extra.附加系统提示词 ?? []),\r\n\t\t\t\t\tblackboardPointer(input.cardsDir),\r\n\t\t\t\t];\r\n\t\t\t\tpythonCacheDir = createPythonCacheDir(tmpdir(), \"pao-worker-python-cache-\");\r\n\t\t\t\tconst runOptions = buildDispatchRunOptions({\r\n\t\t\t\t\tcard: claimed.card,\r\n\t\t\t\t\t尝试号: claimed.尝试号,\r\n\t\t\t\t\tfrozenBrief: snapshot,\r\n\t\t\t\t\t...(claimed.claimBaseline ? { claimBaseline: claimed.claimBaseline } : {}),\r\n\t\t\t\t\t公共参数: {\r\n\t\t\t\t\t\t...resolved,\r\n\t\t\t\t\t\t...extra,\r\n\t\t\t\t\t\t...(extraPrompt.length > 0 ? { 附加系统提示词: extraPrompt } : {}),\r\n\t\t\t\t\t\t// 侦察工具只接受派发链的权威身份，不接受模型参数自报。受控变量最后合并，\r\n\t\t\t\t\t\t// 覆盖调用方同名配置，其他环境变量保持原样。Python 缓存放系统临时目录，\r\n\t\t\t\t\t\t// 防止工人的 py_compile/import/子进程把 __pycache__ 写进业务工作区。\r\n\t\t\t\t\t\t// 缓存目录只在所有准备和复核都通过、即将启动时创建；任何拒派或早失败\r\n\t\t\t\t\t\t// 都不应留下空目录。\r\n\t\t\t\t\t\t环境变量: {\r\n\t\t\t\t\t\t\t...(resolved.环境变量 ?? {}),\r\n\t\t\t\t\t\t\t...(extra.环境变量 ?? {}),\r\n\t\t\t\t\t\t\t[PYTHON_CACHE_ENV]: pythonCacheDir,\r\n\t\t\t\t\t\t\t...dispatchReconWorkerEnvironment(\r\n\t\t\t\t\t\t\t\tinput.cardsDir,\r\n\t\t\t\t\t\t\t\tclaimed.card.card_no,\r\n\t\t\t\t\t\t\t\tclaimed.尝试号,\r\n\t\t\t\t\t\t\t\tclaim.owner,\r\n\t\t\t\t\t\t\t),\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t},\r\n\t\t\t\t\t追加参数: {\r\n\t\t\t\t\t\t预算: budget,\r\n\t\t\t\t\t\ttaskRoot: projectRoot,\r\n\t\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\t\tcwd: authoritative.executionRoot,\r\n\t\t\t\t\t\t...(authoritative.kind === \"managed\" ? { worktreeId: authoritative.worktreeId } : {}),\r\n\t\t\t\t\t\tsnapshotDigest: snapshot.snapshotDigest,\r\n\t\t\t\t\t\tworktreeBindingDigest: authoritative.bindingDigest,\r\n\t\t\t\t\t\texecutionBindingDigest: executionIdentity.bindingDigest,\r\n\t\t\t\t\t\texecutionBinding: executionIdentity,\r\n\t\t\t\t\t\t...(claimed.claimBaseline?.available && claimed.claimBaseline.snapshotPath\r\n\t\t\t\t\t\t\t? { claimBaselinePath: claimed.claimBaseline.snapshotPath }\r\n\t\t\t\t\t\t\t: {}),\r\n\t\t\t\t\t},\r\n\t\t\t\t\t派单理由: input.dispatch_reason,\r\n\t\t\t\t});\r\n\t\t\t\tif (supervisionRoute) runOptions.supervisionRoute = supervisionRoute;\r\n\t\t\t\t// 脚本卡（批3b-E）：命令/参数覆盖路径取代 pi worker 调用——要求回执:false 用原生\r\n\t\t\t\t// exitCode→status。解释器/脚本体物化失败时按规格落 failed+script_start 单次终态\r\n\t\t\t\t// 回执（真实证据文件 + 原生退出码语义），不另建失败路径也不拒派。\r\n\t\t\t\tconst scriptCard = isScriptCard(claimed.card);\r\n\t\t\t\tlet scriptStartFailure: WorkerReceipt | undefined;\r\n\t\t\t\tif (scriptCard) {\r\n\t\t\t\t\tconst evidenceDir = join(dirname(dirname(claimed.card.path)), \"worker-evidence\");\r\n\t\t\t\t\ttry {\r\n\t\t\t\t\t\tconst scriptPlan = await planScriptRun({\r\n\t\t\t\t\t\t\tcard: claimed.card,\r\n\t\t\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\t\t\tevidenceDir,\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\trunOptions.命令 = scriptPlan.interpreter;\r\n\t\t\t\t\t\trunOptions.参数 = scriptPlan.args;\r\n\t\t\t\t\t\trunOptions.要求回执 = false;\r\n\t\t\t\t\t\trunOptions.超时毫秒 = scriptPlan.超时毫秒;\r\n\t\t\t\t\t\t// 脚本无模型提示词：buildDispatchRunOptions 已带提示词，覆盖路径把它清空，\r\n\t\t\t\t\t\t// buildArgs 对空提示词不再追加参数（runner.ts 提示词分支）。\r\n\t\t\t\t\t\trunOptions.提示词 = \"\";\r\n\t\t\t\t\t\t// pi 专属参数不得尾随进脚本解释器 argv：buildArgs 会把这些字段各拼成\r\n\t\t\t\t\t\t// 命令行开关，脚本走 参数 覆盖后这些键仍残留就要清掉（含 blackboardPointer\r\n\t\t\t\t\t\t// 注入的附加系统提示词）。\r\n\t\t\t\t\t\trunOptions.模型 = undefined;\r\n\t\t\t\t\t\trunOptions.思考档 = undefined;\r\n\t\t\t\t\t\trunOptions.工具白名单 = undefined;\r\n\t\t\t\t\t\trunOptions.skills = undefined;\r\n\t\t\t\t\t\trunOptions.附加系统提示词 = undefined;\r\n\t\t\t\t\t\trunOptions.会话标识 = undefined;\r\n\t\t\t\t\t\trunOptions.延续会话 = undefined;\r\n\t\t\t\t\t\trunOptions.会话目录 = undefined;\r\n\t\t\t\t\t} catch (error) {\r\n\t\t\t\t\t\t// 解释器缺失/正文超限/物化失败——不抛派发异常，合成本次尝试的\r\n\t\t\t\t\t\t// script_start 终态回执；证据落真实文件，走完同一条 appendDispatchReceipt 通道。\r\n\t\t\t\t\t\tconst reason = error instanceof Error ? error.message : String(error);\r\n\t\t\t\t\t\tawait mkdir(evidenceDir, { recursive: true });\r\n\t\t\t\t\t\tconst evidencePath = join(\r\n\t\t\t\t\t\t\tevidenceDir,\r\n\t\t\t\t\t\t\t`卡${String(claimed.card.card_no).padStart(4, \"0\")}-尝试${claimed.尝试号}-script_start.json`,\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\tawait writeFileAtomic(\r\n\t\t\t\t\t\t\tevidencePath,\r\n\t\t\t\t\t\t\t`${JSON.stringify({\r\n\t\t\t\t\t\t\t\ttype: \"pao_script_start\",\r\n\t\t\t\t\t\t\t\t卡号: claimed.card.card_no,\r\n\t\t\t\t\t\t\t\t卡路径: claimed.card.path,\r\n\t\t\t\t\t\t\t\t尝试: claimed.尝试号,\r\n\t\t\t\t\t\t\t\t执行标识: randomUUID(),\r\n\t\t\t\t\t\t\t\t原因: reason,\r\n\t\t\t\t\t\t\t\t时间: utcNow(),\r\n\t\t\t\t\t\t\t})}\\n`,\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\tscriptStartFailure = {\r\n\t\t\t\t\t\t\tcard_no: String(claimed.card.card_no).padStart(4, \"0\"),\r\n\t\t\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\t\t\tstatus: \"failed\",\r\n\t\t\t\t\t\t\tartifact_path: [],\r\n\t\t\t\t\t\t\tsummary: `脚本启动失败：${reason}`,\r\n\t\t\t\t\t\t\tusage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0, turns: 0 },\r\n\t\t\t\t\t\t\texitCode: -1,\r\n\t\t\t\t\t\t\tstopReason: \"script_start\",\r\n\t\t\t\t\t\t\tfailure_type: \"script_start\",\r\n\t\t\t\t\t\t\tevidence_path: evidencePath,\r\n\t\t\t\t\t\t\tscriptRun: true,\r\n\t\t\t\t\t\t\tcommand: `script_start:${reason}`,\r\n\t\t\t\t\t\t\tpid: -1,\r\n\t\t\t\t\t\t\tduration_ms: 0,\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// O13/E14 受控技能绑定（派发装配点）：新会话 worker 在 spawn 前把将装载的\r\n\t\t\t\t// 受控技能绑进本任务——taskId = runOptions.会话标识（worker 子进程\r\n\t\t\t\t// sessionId 经 --session-id 收到同一值，worker 内 createRuntime 的绑定\r\n\t\t\t\t// 解析天然命中同一键）。技能路径 basename → `skill:<name>` resourceId。\r\n\t\t\t\t// 延续会话与脚本卡不绑——绑定语义是「本任务若用就固定这个版本」，延续\r\n\t\t\t\t// 会话已由旧 taskId 持有绑定；无会话 worker（--no-session）没有\r\n\t\t\t\t// sessionId 可传，不参与绑定换版。\r\n\t\t\t\t// 绑定失败记派发告警不拒派（技能装载不阻塞业务；残余失败如实留痕）。\r\n\t\t\t\tlet workerBindingTaskId: string | undefined;\r\n\t\t\t\tlet workerBoundResourceIds: string[] = [];\r\n\t\t\t\tif (!scriptCard && runOptions.skills !== undefined && runOptions.skills.length > 0 && options.paoHome) {\r\n\t\t\t\t\tconst bindingTaskId = runOptions.会话标识 ?? randomUUID();\r\n\t\t\t\t\tif (runOptions.会话标识 === undefined) runOptions.会话标识 = bindingTaskId;\r\n\t\t\t\t\tworkerBindingTaskId = bindingTaskId;\r\n\t\t\t\t\tconst resourceIds = [\r\n\t\t\t\t\t\t...new Set(\r\n\t\t\t\t\t\t\trunOptions.skills\r\n\t\t\t\t\t\t\t\t.map((skillPath) => basename(skillPath))\r\n\t\t\t\t\t\t\t\t.filter((name) => name !== \"\")\r\n\t\t\t\t\t\t\t\t.map((name) => `skill:${name}`),\r\n\t\t\t\t\t\t),\r\n\t\t\t\t\t];\r\n\t\t\t\t\tworkerBoundResourceIds = resourceIds;\r\n\t\t\t\t\tif (resourceIds.length > 0 && existsSync(memoryPaths(options.paoHome).database)) {\r\n\t\t\t\t\t\tconst bindStore = openMemoryStore(options.paoHome, \"readwrite\");\r\n\t\t\t\t\t\ttry {\r\n\t\t\t\t\t\t\tconst ensured = ensureTaskBindings(bindStore, {\r\n\t\t\t\t\t\t\t\ttaskId: bindingTaskId,\r\n\t\t\t\t\t\t\t\tpaoHome: options.paoHome,\r\n\t\t\t\t\t\t\t\tresourceIds,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\tif (!ensured.ok) {\r\n\t\t\t\t\t\t\t\trunOptions.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t...(runOptions.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t`[evolution] 任务绑定初始化失败（taskId=${bindingTaskId}）：${ensured.error.message}（worker 沿用资源根装载）`,\r\n\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t} finally {\r\n\t\t\t\t\t\t\tbindStore.close();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// 派发缺省超时(兜底护栏):调用方未显式给 超时毫秒 时按保温配置兜底(缺省 24 小时)——\r\n\t\t\t\t// 到点走与主动停止相同的收敛路径(树杀→证据→超时回执→finally 放锁/名额),不留无限期悬挂。\r\n\t\t\t\t// B 档定位:静默提醒叫人裁决是主判决,本超时只兜「无人应答」的底。\r\n\t\t\t\trunOptions.超时毫秒 ??= readDispatchTimeoutMs(options.paoHome);\r\n\t\t\t\t// 认领租约(S5 包3,运行器事实):认领时间/租约到期＝监督信号(到期不自动放权,amber 呈现),\r\n\t\t\t\t// 认领代数＝接管代际;时长与派发超时同源配置,随 run() 落登记表条目。\r\n\t\t\t\trunOptions.租约 = buildClaimLease(\r\n\t\t\t\t\tnew Date(),\r\n\t\t\t\t\trunOptions.超时毫秒,\r\n\t\t\t\t\trunner.registry.claimGeneration(claimed.card.path),\r\n\t\t\t\t);\r\n\t\t\t\t// 门禁放行且认领成功＝这次真开跑:把\"预留\"转成\"已提交\"（此刻之后不再归还,\r\n\t\t\t\t// 因为 worker 可能已经花了钱）。commit 只落盘记账,不拉起任何进程。\r\n\t\t\t\t// 清空 gate 的时机在 commit 成功之后:commit 自己抛错＝还没开跑,交给 finally 归还。\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t\tif (gate) {\r\n\t\t\t\t\tawait gate.commit();\r\n\t\t\t\t\tcommittedGate = gate;\r\n\t\t\t\t\tgate = undefined;\r\n\t\t\t\t\tgatePhase.value = \"committed\";\r\n\t\t\t\t}\r\n\t\t\t\tlet receipt: WorkerReceipt;\r\n\t\t\t\ttry {\r\n\t\t\t\t\tif (scriptStartFailure) {\r\n\t\t\t\t\t\treceipt = scriptStartFailure;\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\trunnerPhase = \"started\";\r\n\t\t\t\t\t\tfailurePhase = \"started\";\r\n\t\t\t\t\t\treceipt = await runner.run(runOptions);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tpreStartClaimRollback = undefined;\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tconst settlementNote =\r\n\t\t\t\t\t\tgatePhase.value === \"committed\"\r\n\t\t\t\t\t\t\t? await settleGateOnce(committedGate, gatePhase, (committed) =>\r\n\t\t\t\t\t\t\t\t\tcommitted.settleUnknown(errorMessage(error)),\r\n\t\t\t\t\t\t\t\t)\r\n\t\t\t\t\t\t\t: undefined;\r\n\t\t\t\t\tthrow errorWithSettlementNote(error, settlementNote);\r\n\t\t\t\t}\r\n\t\t\t\t// 脚本卡后置核对（批3b-E 调用层归类）：exit 0 且声明产物缺失 → script_artifact_missing；\r\n\t\t\t\t// 非零退出 → script_exit:<code>；超时 → script_timeout；进程没拉起 → script_start。\r\n\t\t\t\t// 取消沿既有 canceled 终态不改写；success 且产物齐全保持成功。\r\n\t\t\t\tif (scriptCard && !scriptStartFailure) {\r\n\t\t\t\t\treceipt.scriptRun = true;\r\n\t\t\t\t\tconst scriptDeclared = claimed.card.frontmatter.artifacts ?? [];\r\n\t\t\t\t\tif (receipt.status === \"success\" && receipt.exitCode === 0 && scriptDeclared.length > 0) {\r\n\t\t\t\t\t\tconst projectRoot = scriptArtifactProjectRoot(claimed.card, claimed.尝试号);\r\n\t\t\t\t\t\tconst checked = checkScriptArtifacts(scriptDeclared, projectRoot);\r\n\t\t\t\t\t\tif (checked.缺失.length > 0) {\r\n\t\t\t\t\t\t\treceipt.status = \"failed\";\r\n\t\t\t\t\t\t\treceipt.failure_type = \"script_artifact_missing\";\r\n\t\t\t\t\t\t\treceipt.artifact_path = checked.存在;\r\n\t\t\t\t\t\t\treceipt.summary = [\r\n\t\t\t\t\t\t\t\t`脚本退出码 0 但声明产物缺失：${checked.缺失.join(\"、\")}`,\r\n\t\t\t\t\t\t\t\t`已有产物已保留作诊断；按项目根 ${projectRoot} 复核`,\r\n\t\t\t\t\t\t\t].join(\"\\n\");\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t// 退出 0 且全部声明产物存在：产物按绝对路径写实收清单。\r\n\t\t\t\t\t\t\treceipt.artifact_path = checked.存在;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.stopReason === \"timeout\") {\r\n\t\t\t\t\t\treceipt.failure_type = \"script_timeout\";\r\n\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.exitCode !== 0 && receipt.exitCode > 0) {\r\n\t\t\t\t\t\treceipt.failure_type = scriptExitFailureType(receipt.exitCode);\r\n\t\t\t\t\t} else if (\r\n\t\t\t\t\t\t(receipt.status === \"failed\" || receipt.status === \"unknown\") &&\r\n\t\t\t\t\t\treceipt.exitCode < 0 &&\r\n\t\t\t\t\t\treceipt.pid <= 0\r\n\t\t\t\t\t) {\r\n\t\t\t\t\t\treceipt.status = \"failed\";\r\n\t\t\t\t\t\treceipt.failure_type = \"script_start\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// 两路尾部注明流名与是否截断（批3b-E 规格「写卡时注明流名及是否截断」）：\r\n\t\t\t\t\t// 卡面摘要 ≤3 行是硬校验，标注并入末行（不新增行）防顶破上限；\r\n\t\t\t\t\t// 尾部原文经 stdoutTail/stderrFullTail 送达调用方与证据。\r\n\t\t\t\t\tconst tailNote = [\r\n\t\t\t\t\t\treceipt.stdoutTail !== undefined\r\n\t\t\t\t\t\t\t? `stdout 尾部${receipt.stdoutTruncated ? \"（已截断）\" : \"（未截断）\"}`\r\n\t\t\t\t\t\t\t: undefined,\r\n\t\t\t\t\t\treceipt.stderrFullTail !== undefined\r\n\t\t\t\t\t\t\t? `stderr 尾部${receipt.stderrTruncated ? \"（已截断）\" : \"（未截断）\"}`\r\n\t\t\t\t\t\t\t: undefined,\r\n\t\t\t\t\t]\r\n\t\t\t\t\t\t.filter(Boolean)\r\n\t\t\t\t\t\t.join(\"；\");\r\n\t\t\t\t\tif (tailNote) {\r\n\t\t\t\t\t\tconst lines = receipt.summary.split(\"\\n\");\r\n\t\t\t\t\t\tlines[lines.length - 1] = `${lines[lines.length - 1]}（${tailNote}）`;\r\n\t\t\t\t\t\treceipt.summary = lines.join(\"\\n\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// 单卡、扇出、自动链都在同一处按回执结算，业务回调只处理各自结果，避免漏结或重复结算。\r\n\t\t\t\tconst settlementNote =\r\n\t\t\t\t\tgatePhase.value === \"committed\"\r\n\t\t\t\t\t\t? await settleGateOnce(committedGate, gatePhase, (committed) => committed.settle(receipt))\r\n\t\t\t\t\t\t: undefined;\r\n\t\t\t\tif (settlementNote) {\r\n\t\t\t\t\treceipt.派发告警 = [...(receipt.派发告警 ?? []), settlementNote];\r\n\t\t\t\t}\r\n\t\t\t\t// O13/S9-06/07：worker 回执终态按绑定清单逐条 recordUsed（outcome 映射\r\n\t\t\t\t// success/failure，receiptRef 定位回执）；失败终态再做一次\r\n\t\t\t\t// handleRegression 判定（problemId 无明确线索时不传，靠 used 行 +\r\n\t\t\t\t// 本任务 active 绑定判 normal_breakage）。invalid_input（无绑定）\r\n\t\t\t\t// 预期内不噪音；其他错误记派发告警不阻塞结果。\r\n\t\t\t\tif (workerBindingTaskId !== undefined && workerBoundResourceIds.length > 0 && options.paoHome) {\r\n\t\t\t\t\tconst usedStore = openMemoryStore(options.paoHome, \"readwrite\");\r\n\t\t\t\t\ttry {\r\n\t\t\t\t\t\tconst outcome = receipt.status === \"success\" ? \"success\" : \"failure\";\r\n\t\t\t\t\t\tconst receiptRef = `receipt:${claimed.card.path}:attempt:${claimed.尝试号}`;\r\n\t\t\t\t\t\t// worker 真实运行的会话 ID：会话文件名是 {时间戳}_{sessionId}.jsonl。\r\n\t\t\t\t\t\t// 延续会话时 worker resume 旧 sessionId（=旧 taskId，旧绑定），与派发层\r\n\t\t\t\t\t\t// 本轮写的绑定键不同——used/退步必须记到 worker 实际跑的那个键下。\r\n\t\t\t\t\t\tlet usedTaskId = workerBindingTaskId;\r\n\t\t\t\t\t\tif (receipt.会话路径) {\r\n\t\t\t\t\t\t\tconst m = /_([^_\\\\/]+)\\.jsonl$/i.exec(basename(receipt.会话路径));\r\n\t\t\t\t\t\t\tif (m && m[1] !== workerBindingTaskId) {\r\n\t\t\t\t\t\t\t\tusedTaskId = m[1];\r\n\t\t\t\t\t\t\t\t// 本轮派发前写的绑定挂在派发期 taskId 下，worker 实际用了旧\r\n\t\t\t\t\t\t\t\t// sessionId 的旧绑定——孤儿行清掉，避免以后被当成受影响任务。\r\n\t\t\t\t\t\t\t\tfor (const resourceId of workerBoundResourceIds) {\r\n\t\t\t\t\t\t\t\t\tdeactivateTaskBinding(usedStore, { taskId: workerBindingTaskId, resourceId });\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tfor (const resourceId of workerBoundResourceIds) {\r\n\t\t\t\t\t\t\tconst written = recordUsed(usedStore, {\r\n\t\t\t\t\t\t\t\tresourceId,\r\n\t\t\t\t\t\t\t\ttaskId: usedTaskId,\r\n\t\t\t\t\t\t\t\treceiptRef,\r\n\t\t\t\t\t\t\t\toutcome,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\tif (!written.ok && written.error.code !== \"invalid_input\") {\r\n\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t`[evolution] worker 对 ${resourceId} 记 used 失败：${written.error.message}`,\r\n\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tif (outcome === \"failure\") {\r\n\t\t\t\t\t\t\t\tconst regression = handleRegression(usedStore, {\r\n\t\t\t\t\t\t\t\t\tresourceId,\r\n\t\t\t\t\t\t\t\t\ttaskId: usedTaskId,\r\n\t\t\t\t\t\t\t\t\tfailureDescription: receipt.summary,\r\n\t\t\t\t\t\t\t\t\tpaoHome: options.paoHome,\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t\tif (!regression.ok) {\r\n\t\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t\t`[evolution] worker 对 ${resourceId} 退步判定失败：${regression.error.message}`,\r\n\t\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t\t} else if (regression.judgement.isRegression) {\r\n\t\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t\t`[evolution] ${resourceId} 版本 ${regression.badVersion} 判退步（${regression.judgement.kind}），` +\r\n\t\t\t\t\t\t\t\t\t\t\t`已回退至 ${regression.notification?.currentVersion ?? regression.badVersion}；` +\r\n\t\t\t\t\t\t\t\t\t\t\t`受影响任务 ${regression.notification?.affectedTaskIds.length ?? 0} 个`,\r\n\t\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t} finally {\r\n\t\t\t\t\t\tusedStore.close();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tsharedLock = await acquireSharedLock({\r\n\t\t\t\t\troot: projectRoot,\r\n\t\t\t\t\tholder: claimed.card.path,\r\n\t\t\t\t\twait: true,\r\n\t\t\t\t\tretries: 60,\r\n\t\t\t\t});\r\n\t\t\t\toutcome = {\r\n\t\t\t\t\t可派: true,\r\n\t\t\t\t\tresult: await completed(claimed, receipt),\r\n\t\t\t\t\t...(supervisionRoute ? { supervisionRoute } : {}),\r\n\t\t\t\t};\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t\tconst proof = runner.confirmStopped(claimed.card.path);\r\n\t\t\t\tawait releaseDispatchLock(executionLock, proof, dispatchDetails);\r\n\t\t\t\texecutionLock = undefined;\r\n\t\t\t\texecutionStopProven = true;\r\n\t\t\t\trunnerPhase = \"stopProven\";\r\n\t\t\t}\r\n\t\t}\r\n\t} catch (error) {\r\n\t\tbodyError = error;\r\n\t} finally {\r\n\t\tif (bodyError !== undefined && runnerPhase === \"notStarted\" && preStartClaimRollback) {\r\n\t\t\ttry {\r\n\t\t\t\trollbackPreStartClaim(preStartClaimRollback);\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconst note = `启动前卡面回滚失败：${errorMessage(error)}`;\r\n\t\t\t\tlogWarn(`[pao] ${note}:${preStartClaimRollback.path}`);\r\n\t\t\t\tif (bodyError instanceof PaoWorkerError) {\r\n\t\t\t\t\tbodyError = new PaoWorkerError(bodyError.code, `${errorMessage(bodyError)}；${note}`, bodyError.detail);\r\n\t\t\t\t} else if (bodyError instanceof Error) {\r\n\t\t\t\t\tbodyError = new Error(`${bodyError.message}；${note}`, { cause: bodyError });\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t// 预留归还（G4）:只在\"确定没开跑\"时归还——gate 仍挂着＝commit 没成功（或压根没认领成功）,\r\n\t\t// 线程从未拉起,这笔钱没花;已 commit 或已有回执的都不归还（结果不明按 G2 口径留给人工查）。\r\n\t\tif (gate && gatePhase.value === \"notCommitted\") await releaseGateQuietly(gate, input);\r\n\t\ttry {\r\n\t\t\tif (sharedLock) {\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t}\r\n\t\t} catch (error) {\r\n\t\t\tlogWarn(`[pao] 共享事务锁释放失败:${errorMessage(error)}`);\r\n\t\t}\r\n\t\tif (executionLock && !executionStopProven) {\r\n\t\t\tconst heldLock = executionLock;\r\n\t\t\ttry {\r\n\t\t\t\tconst proof = runner.confirmStopped(dispatchIdentity);\r\n\t\t\t\tawait releaseDispatchLock(heldLock, proof, dispatchDetails);\r\n\t\t\t\texecutionLock = undefined;\r\n\t\t\t\texecutionStopProven = true;\r\n\t\t\t\trunnerPhase = \"stopProven\";\r\n\t\t\t} catch (error) {\r\n\t\t\t\tstopConfirmFailed = error;\r\n\t\t\t\tretainDispatchLock(heldLock, \"停止未确认，保留执行长锁\", {\r\n\t\t\t\t\terror: errorMessage(error),\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (releaseSlot) {\r\n\t\t\tif (runnerPhase === \"stopProven\") {\r\n\t\t\t\treleaseSlot();\r\n\t\t\t} else if (runnerPhase === \"notStarted\") {\r\n\t\t\t\t// 执行长锁尚未取得时不可能进入 runner.run；这里复核一次，避免把“尚未拿到锁”\r\n\t\t\t\t// 误当成进程已停。确认失败则保留名额，等人工核对。\r\n\t\t\t\ttry {\r\n\t\t\t\t\trunner.confirmStopped(dispatchIdentity);\r\n\t\t\t\t\treleaseSlot();\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tstopConfirmFailed ??= error;\r\n\t\t\t\t\tlogWarn(`[pao] 派发未进入运行但无法确认无进程，保留共享名额:${errorMessage(error)}`);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tlogWarn(`[pao] worker 停止未确认，保留共享名额与执行长锁:${dispatchIdentity}`);\r\n\t\t\t}\r\n\t\t}\r\n\t\treleaseBudgetQueue?.();\r\n\t\tif (executionRootGuard) {\r\n\t\t\t// 执行长锁从未取得时不可能启动 runner；可安全回滚获取锁前拿到的守卫。\r\n\t\t\tif (executionStopProven || (!executionLock && runnerPhase === \"notStarted\")) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tawait executionRootGuard.release();\r\n\t\t\t\t\texecutionRootGuard = undefined;\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tlogWarn(`[pao] 执行根守卫释放失败（执行已停止，守卫仍保留供人工核对）:${errorMessage(error)}`);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\t// 停止未确认时 guard 与 execution 长锁一样保留；不能只释放守卫，\r\n\t\t\t\t// 否则清理流程可能在孤儿 worker 仍写执行根时删除工作树。\r\n\t\t\t\tlogWarn(`[pao] 停止未确认，保留执行根守卫:${executionRootGuard.executionRoot}`);\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (pythonCacheDir && (executionStopProven || (!executionLock && runnerPhase === \"notStarted\"))) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(pythonCacheDir, { recursive: true, force: true });\r\n\t\t\t} catch (error) {\r\n\t\t\t\tlogWarn(`[pao] Python 缓存目录清理失败（保留供人工核对）:${pythonCacheDir}:${errorMessage(error)}`);\r\n\t\t\t}\r\n\t\t} else if (pythonCacheDir) {\r\n\t\t\tlogWarn(`[pao] worker 停止未确认，保留 Python 缓存目录:${pythonCacheDir}`);\r\n\t\t}\r\n\t\tif (stopConfirmFailed !== undefined && bodyError !== undefined) {\r\n\t\t\t// 原始错误优先上抛,停止确认失败单独记录不遮蔽\r\n\t\t\tlogWarn(\r\n\t\t\t\t`[pao] 派发停止确认失败(锁未放,先停后放锁):${stopConfirmFailed instanceof Error ? stopConfirmFailed.message : String(stopConfirmFailed)}`,\r\n\t\t\t);\r\n\t\t}\r\n\t}\r\n\tif (bodyError !== undefined) {\r\n\t\tif (bodyError instanceof PaoWorkerError) {\r\n\t\t\tbodyError.dispatchFailurePhase ??= failurePhase;\r\n\t\t}\r\n\t\tthrow bodyError;\r\n\t}\r\n\tif (stopConfirmFailed !== undefined) throw stopConfirmFailed;\r\n\treturn outcome;\r\n}\r\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore\n\tactivateCandidate, type MemoryStore \n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/memoryevolutionstore.tsactivation.ts\";\nimport { evolutionPathsregisterResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/paths.tsresources.tspublishCandidate } from \"../../src/pao/evolution/versions.ts\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource openMemoryStore \nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,136]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[136,261]}}},{"diffOp":{"equal":{"range":[261,270]}}},{"diffOp":{"delete":{"range":[270,286]}}},{"diffOp":{"insert":{"range":[286,305]}}},{"diffOp":{"equal":{"range":[305,306]}}},{"diffOp":{"delete":{"range":[306,324]}}},{"diffOp":{"insert":{"range":[324,366]}}},{"diffOp":{"equal":{"range":[366,388]}}},{"diffOp":{"delete":{"range":[