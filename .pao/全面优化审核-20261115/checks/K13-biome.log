p":{"delete":{"range":[672,685]}}},{"diffOp":{"insert":{"range":[660,672]}}},{"diffOp":{"equal":{"range":[470,472]}}},{"diffOp":{"equal":{"range":[350,361]}}},{"diffOp":{"delete":{"range":[846,877]}}},{"diffOp":{"insert":{"range":[685,701]}}},{"diffOp":{"equal":{"range":[627,660]}}},{"diffOp":{"delete":{"range":[775,785]}}},{"diffOp":{"insert":{"range":[764,775]}}},{"diffOp":{"equal":{"range":[470,472]}}},{"diffOp":{"equal":{"range":[350,361]}}},{"diffOp":{"delete":{"range":[817,833]}}},{"diffOp":{"insert":{"range":[472,486]}}},{"diffOp":{"equal":{"range":[627,650]}}},{"diffOp":{"delete":{"range":[472,481]}}},{"diffOp":{"insert":{"range":[434,440]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[833,846]}}},{"diffOp":{"insert":{"range":[552,560]}}},{"diffOp":{"equal":{"range":[470,472]}}},{"diffOp":{"equal":{"range":[350,361]}}},{"diffOp":{"delete":{"range":[785,806]}}},{"diffOp":{"insert":{"range":[877,894]}}},{"diffOp":{"equal":{"range":[627,628]}}},{"diffOp":{"insert":{"range":[894,910]}}},{"diffOp":{"equal":{"range":[732,754]}}},{"diffOp":{"delete":{"range":[472,481]}}},{"diffOp":{"insert":{"range":[434,440]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[806,817]}}},{"diffOp":{"insert":{"range":[449,457]}}},{"diffOp":{"equal":{"range":[470,472]}}},{"diffOp":{"equal":{"range":[910,1009]}}},{"equalLines":{"line_count":401}},{"diffOp":{"equal":{"range":[1009,1020]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o13.test.ts"},"span":[1293,1378],"sourceCode":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\n *\r\n * 覆盖（对应 O13 任务书 §测试与回归）：\r\n * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出\r\n *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。\r\n * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→\r\n *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后\r\n *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。\r\n * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。\r\n * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression\r\n *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。\r\n * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。\r\n *\r\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { afterEach, describe, expect, it } from \"vitest\";\r\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\r\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\r\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\r\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\r\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\r\nimport { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";\r\nimport { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";\r\nimport { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";\r\nimport { handleRegression } from \"../../src/pao/evolution/regression.ts\";\r\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\r\nimport { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\nconst tempDirs: string[] = [];\r\nconst openStores: MemoryStore[] = [];\r\n\r\nfunction tempHome(): string {\r\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\r\n\ttempDirs.push(dir);\r\n\treturn dir;\r\n}\r\nfunction openStore(home: string): MemoryStore {\r\n\tconst store = openMemoryStore(home, \"readwrite\");\r\n\topenStores.push(store);\r\n\treturn store;\r\n}\r\nafterEach(async () => {\r\n\tfor (const store of openStores.splice(0)) {\r\n\t\ttry {\r\n\t\t\tstore.close();\r\n\t\t} catch {\r\n\t\t\t// 已关\r\n\t\t}\r\n\t}\r\n\tfor (const dir of tempDirs.splice(0)) {\r\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(dir, { recursive: true, force: true });\r\n\t\t\t\tbreak;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tif (attempt === 4) throw error;\r\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\nconst AT = \"2026-11-11T10:00:00.000Z\";\r\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\r\n\r\n/** 种一个已登记 skill 资源 + baseVersion 快照。 */\r\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\r\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\r\n\tmkdirSync(skillDir, { recursive: true });\r\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\r\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\r\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\r\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\r\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\r\n}\r\n\r\n/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */\r\nasync function runRound(\r\n\thome: string,\r\n\tstore: MemoryStore,\r\n\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },\r\n) {\r\n\tconst problemId = seedClassifiedProblem(store, {\r\n\t\tproblemId: `prob-${over.name}`,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t});\r\n\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\tproblemId,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t\tfiles: { \"SKILL.md\": over.newContent },\r\n\t});\r\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\tconst act = await activateCandidate(store, {\r\n\t\tcandidateId,\r\n\t\texpectedEffectiveVersion: over.expectedEffective,\r\n\t\tpaoHome: home,\r\n\t\tcreatedAt: AT2,\r\n\t});\r\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\r\n\treturn { candidateId, versionId: act.versionId };\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E14 新任务初始绑定\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E14 ensureTaskBindings\", () => {\r\n\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\r\n\t\t// task_bindings 行已落。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.ok && bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"无登记资源 → 空清单不建绑定\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths).toEqual([]);\r\n\t\texpect(ensured.mounted).toEqual([]);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(0);\r\n\t});\r\n\r\n\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 首轮 ensure。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\t// 激活新版 → effective 变。\r\n\t\tawait runRound(home, store, {\r\n\t\t\tname: \"r2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tseedSkill(home, store, \"skill-a\");\r\n\t\tseedSkill(home, store, \"skill-b\");\r\n\t\tconst ensured = ensureTaskBindings(store, {\r\n\t\t\ttaskId: \"worker-1\",\r\n\t\t\tpaoHome: home,\r\n\t\t\tresourceIds: [\"skill:skill-a\"],\r\n\t\t});\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E15 激活基线分离（两轮进化）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E15 两轮进化基线分离\", () => {\r\n\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 第一轮 v1。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 资源根不动（不回写正式资源根）。\r\n\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\r\n\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\r\n\t\tconst r2 = await runRound(home, store, {\r\n\t\t\tname: \"v2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion: r1.versionId,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\r\n\t\t\texpectedEffective: r1.versionId,\r\n\t\t});\r\n\t\texpect(r2.versionId).not.toBe(r1.versionId);\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(r2.versionId);\r\n\t});\r\n\r\n\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\r\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\r\n\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\r\n\t\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\t\tproblemId,\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\r\n\t\t});\r\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\t\tconst act = await activateCandidate(store, {\r\n\t\t\tcandidateId,\r\n\t\t\texpectedEffectiveVersion: baseVersion,\r\n\t\t\tpaoHome: home,\r\n\t\t\tcreatedAt: AT2,\r\n\t\t});\r\n\t\texpect(act.ok).toBe(true);\r\n\t\tif (!act.ok) return;\r\n\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\r\n\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\r\n\t\tif (\"status\" in act && act.status === \"conflict\") {\r\n\t\t\texpect(act.reason).toContain(\"根基线\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-06 使用观察（recordUsed 挂点语义）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-06 recordUsed 挂点语义\", () => {\r\n\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\tconst written = recordUsed(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tsessionId: \"sess-1\",\r\n\t\t\treceiptRef: \"session:sess-1:settled:1\",\r\n\t\t\toutcome: \"success\",\r\n\t\t});\r\n\t\texpect(written.ok).toBe(true);\r\n\t\tif (!written.ok) return;\r\n\t\texpect(written.versionId).toBe(baseVersion);\r\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\r\n\t\texpect(counts.ok).toBe(true);\r\n\t\tif (counts.ok) {\r\n\t\t\texpect(counts.used).toBe(1);\r\n\t\t\texpect(counts.success).toBe(1);\r\n\t\t}\r\n\t});\r\n\r\n\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId } = seedSkill(home, store);\r\n\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\r\n\t\texpect(written.ok).toBe(false);\r\n\t\tif (written.ok) return;\r\n\t\texpect(written.error.code).toBe(\"invalid_input\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-08/09 退步回退编排\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-08/09 handleRegression 编排\", () => {\r\n\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 会话绑定到 v1。\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\tproblemId: \"prob-v1\",\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tfailureDescription: \"v1 上线后功能坏\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t\t// effective 回退到上一有效版（baseVersion）。\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(baseVersion);\r\n\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\r\n\t\texpect(regression.affectedTasks.length).toBe(1);\r\n\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\r\n\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\r\n\t\t// 受影响任务换绑定到回退目标（宿主消费）。\r\n\t\tswitchTaskResourceAtSafePoint(store, {\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tresourceId,\r\n\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\r\n\t\t\treason: \"退步回退\",\r\n\t\t});\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\r\n\t\t// 坏版上有 used 行。\r\n\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-2\",\r\n\t\t\tfailureDescription: \"v1 用着坏了\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-11 启动恢复（跨进程一致）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-11 启动恢复\", () => {\r\n\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\t// 进程 A：写入绑定 + 激活。\r\n\t\t{\r\n\t\t\tconst storeA = openStore(home);\r\n\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\r\n\t\t\tawait runRound(home, storeA, {\r\n\t\t\t\tname: \"v1\",\r\n\t\t\t\tresourceId,\r\n\t\t\t\tbaseVersion,\r\n\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\t\texpectedEffective: baseVersion,\r\n\t\t\t});\r\n\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\r\n\t\t}\r\n\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\r\n\t\tconst storeB = openStore(home);\r\n\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\texpect(report.resources.length).toBe(1);\r\n\t\texpect(report.resources[0]!.dirOk).toBe(true);\r\n\t\texpect(report.needsAttention).toEqual([]);\r\n\t\t// 绑定仍在且指 effective 版。\r\n\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\tconst effective = (storeB.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(bindings.items[0]!.resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t});\r\n\r\n\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\r\n\t\t// 删版本目录。\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\r\n\t\tconst report = recoverEvolutionState(store, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\r\n\t\texpect(view!.staleBindings.length).toBe(1);\r\n\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\r\n\t\texpect(attn).toBeDefined();\r\n\t\t// 绑定行未被改动。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n});\r\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\r\n\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、 * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。 * 覆盖（对应 O13 任务书 §测试与回归）： * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出 *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。 * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→ *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后 *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。 * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。 * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。 * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。 * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1 */import { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";import { tmpdir } from \"node:os\";import { join } from \"node:path\";import { afterEach, describe, expect, it } from \"vitest\";import { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";import { evolutionPaths } from \"../../src/pao/memory/paths.ts\";import { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";import { publishCandidate } from \"../../src/pao/evolution/versions.ts\";import { activateCandidate } from \"../../src/pao/evolution/activation.ts\";import { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";import { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";import { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";import { handleRegression } from \"../../src/pao/evolution/regression.ts\";import { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";import { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\n\n\nconst tempDirs: string[] = [];const openStores: MemoryStore[] = [];function tempHome(): string {\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\ttempDirs.push(dir);\treturn dir;}function openStore(home: string): MemoryStore {\tconst store = openMemoryStore(home, \"readwrite\");\topenStores.push(store);\treturn store;afterEach(async () => {\tfor (const store of openStores.splice(0)) {\t\ttry {\t\t\tstore.close();\t\t} catch {\t\t\t// 已关\t}\tfor (const dir of tempDirs.splice(0)) {\t\tfor (let attempt = 0; attempt < 5; attempt++) {\t\t\ttry {\t\t\t\trmSync(dir, { recursive: true, force: true });\t\t\t\tbreak;\t\t\t} catch (error) {\t\t\t\tif (attempt === 4) throw error;\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));});const AT = \"2026-11-11T10:00:00.000Z\";const AT2 = \"2026-11-11T10:01:00.000Z\";/** 种一个已登记 skill 资源 + baseVersion 快照。 */function seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\tmkdirSync(skillDir, { recursive: true });\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\tif (!snap.ok) throw new Error(\"snapshot failed\");\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */async function runRound(\thome: string,\tstore: MemoryStore,\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },) {\tconst problemId = seedClassifiedProblem(store, {\t\tproblemId: `prob-${over.name}`,\t\tresourceId: over.resourceId,\t\tbaseVersion: over.baseVersion,\t});\tconst { candidateId } = await legalPassedChain(store, home, {\t\tproblemId,\t\tfiles: { \"SKILL.md\": over.newContent },\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\tconst act = await activateCandidate(store, {\t\tcandidateId,\t\texpectedEffectiveVersion: over.expectedEffective,\t\tpaoHome: home,\t\tcreatedAt: AT2,\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\treturn { candidateId, versionId: act.versionId };// ════════════════════════════════════════════════════════════════════════// E14 新任务初始绑定describe(\"E14 ensureTaskBindings\", () => {\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\t\tconst home = tempHome();\t\tconst store = openStore(home);\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\t\texpect(ensured.ok).toBe(true);\t\tif (!ensured.ok) return;\t\texpect(ensured.skillPaths.length).toBe(1);\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\t\t// task_bindings 行已落。\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\t\texpect(bindings.ok).toBe(true);\t\tif (!bindings.ok) return;\t\texpect(bindings.ok && bindings.items.length).toBe(1);\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\tit(\"无登记资源 → 空清单不建绑定\", () => {\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\t\texpect(ensured.skillPaths).toEqual([]);\t\texpect(ensured.mounted).toEqual([]);\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\t\texpect(bindings.items.length).toBe(0);\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\t\t// 首轮 ensure。\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\t\t// 激活新版 → effective 变。\t\tawait runRound(home, store, {\t\t\tname: \"r2\",\t\t\tresourceId,\t\t\tbaseVersion,\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\t\t\texpectedEffective: baseVersion,\t\t});\t\tconst effective = (store.db.prepare\n\t\t\tstore.db\n\t\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t\t.get(resourceId) as { effective_version: string }).effective_version;\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\t\texpect(bindings.items.length).toBe(1);\t\texpect(bindings.items[0]!.versionId).toBe(effective);\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\t\tseedSkill(home, store, \"skill-a\");\t\tseedSkill(home, store, \"skill-b\");\t\t\ttaskId: \"worker-1\",\t\t\tpaoHome: home,\t\t\tresourceIds: [\"skill:skill-a\"],\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");// E15 激活基线分离（两轮进化）describe(\"E15 两轮进化基线分离\", () => {\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\t\t// 第一轮 v1。\t\tconst r1 = await runRound(home, store, {\t\t\tname: \"v1\",\t\t// 资源根不动（不回写正式资源根）。\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\t\tconst r2 = await runRound(home, store, {\t\t\tname: \"v2\",\t\t\tbaseVersion: r1.versionId,\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\t\t\texpectedEffective: r1.versionId,\t\texpect(r2.versionId).not.toBe(r1.versionId);\t\texpect(effective).toBe(r2.versionId);\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\t\tconst { candidateId } = await legalPassedChain(store, home, {\t\t\tproblemId,\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\t\tconst act = await activateCandidate(store, {\t\t\tcandidateId,\t\t\texpectedEffectiveVersion: baseVersion,\t\t\tcreatedAt: AT2,\t\texpect(act.ok).toBe(true);\t\tif (!act.ok) return;\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\t\tif (\"status\" in act && act.status === \"conflict\") {\t\t\texpect(act.reason).toContain(\"根基线\");// S9-06 使用观察（recordUsed 挂点语义）describe(\"S9-06 recordUsed 挂点语义\", () => {\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\t\tconst written = recordUsed(store, {\t\t\ttaskId: \"sess-1\",\t\t\tsessionId: \"sess-1\",\t\t\treceiptRef: \"session:sess-1:settled:1\",\t\t\toutcome: \"success\",\t\texpect(written.ok).toBe(true);\t\tif (!written.ok) return;\t\texpect(written.versionId).toBe(baseVersion);\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\t\texpect(counts.ok).toBe(true);\t\tif (counts.ok) {\t\t\texpect(counts.used).toBe(1);\t\t\texpect(counts.success).toBe(1);\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\t\tconst { resourceId } = seedSkill(home, store);\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\t\texpect(written.ok).toBe(false);\t\tif (written.ok) return;\t\texpect(written.error.code).toBe(\"invalid_input\");// S9-08/09 退步回退编排describe(\"S9-08/09 handleRegression 编排\", () => {\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\t\t// 会话绑定到 v1。\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\t\tconst regression = handleRegression(store, {\t\t\tproblemId: \"prob-v1\",\t\t\tfailureDescription: \"v1 上线后功能坏\",\t\texpect(regression.ok).toBe(true);\t\tif (!regression.ok) return;\t\texpect(regression.judgement.isRegression).toBe(true);\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\t\texpect(regression.rolledBack).toBe(true);\t\t// effective 回退到上一有效版（baseVersion）。\t\texpect(effective).toBe(baseVersion);\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\t\texpect(regression.affectedTasks.length).toBe(1);\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\t\t// 受影响任务换绑定到回退目标（宿主消费）。\t\tswitchTaskResourceAtSafePoint(store, {\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\t\t\treason: \"退步回退\",\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\t\t// 坏版上有 used 行。\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\t\t\ttaskId: \"sess-2\",\t\t\tfailureDescription: \"v1 用着坏了\",\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");// S9-11 启动恢复（跨进程一致）describe(\"S9-11 启动恢复\", () => {\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\t\t// 进程 A：写入绑定 + 激活。\t\t{\t\t\tconst storeA = openStore(home);\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\t\t\tawait runRound(home, storeA, {\t\t\t\tname: \"v1\",\t\t\t\tresourceId,\t\t\t\tbaseVersion,\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\t\t\t\texpectedEffective: baseVersion,\t\t\t});\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\t\tconst storeB = openStore(home);\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\t\texpect(report.ok).toBe(true);\t\tif (!report.ok) return;\t\texpect(report.resources.length).toBe(1);\t\texpect(report.resources[0]!.dirOk).toBe(true);\t\texpect(report.needsAttention).toEqual([]);\t\t// 绑定仍在且指 effective 版。\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });storeB.db.prepare\n\t\t\tstoreB.db\n\t\t\t\t.prepare.get(bindings.items[0]!.resourceId) as { effective_version: string }\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\t\t// 删版本目录。\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\t\tconst report = recoverEvolutionState(store, { paoHome: home });\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\t\texpect(view!.staleBindings.length).toBe(1);\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\t\texpect(attn).toBeDefined();\t\t// 绑定行未被改动。\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });","ops":[{"diffOp":{"equal":{"range":[0,3]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[6,115]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[115,221]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[115,117]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[221,277]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[277,371]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[371,471]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[471,570]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[570,665]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[665,765]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[765,859]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[859,942]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[942,1024]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":