},{"diffOp":{"insert":{"range":[560,566]}}},{"diffOp":{"equal":{"range":[1336,1437]}}},{"diffOp":{"delete":{"range":[1292,1293]}}},{"diffOp":{"insert":{"range":[560,567]}}},{"diffOp":{"equal":{"range":[675,684]}}},{"diffOp":{"delete":{"range":[1292,1293]}}},{"diffOp":{"insert":{"range":[1149,1156]}}},{"diffOp":{"equal":{"range":[435,436]}}},{"diffOp":{"delete":{"range":[1156,1157]}}},{"diffOp":{"equal":{"range":[560,565]}}},{"diffOp":{"delete":{"range":[108,109]}}},{"diffOp":{"insert":{"range":[1156,1157]}}},{"diffOp":{"equal":{"range":[1437,1471]}}},{"diffOp":{"insert":{"range":[560,566]}}},{"diffOp":{"equal":{"range":[1471,1581]}}},{"diffOp":{"insert":{"range":[108,109]}}},{"diffOp":{"equal":{"range":[675,690]}}},{"diffOp":{"insert":{"range":[108,109]}}},{"diffOp":{"equal":{"range":[435,436]}}},{"diffOp":{"insert":{"range":[560,565]}}},{"diffOp":{"equal":{"range":[1581,1600]}}},{"equalLines":{"line_count":50}},{"diffOp":{"equal":{"range":[1600,1680]}}},{"diffOp":{"delete":{"range":[254,275]}}},{"diffOp":{"insert":{"range":[1051,1067]}}},{"diffOp":{"equal":{"range":[291,354]}}},{"diffOp":{"delete":{"range":[560,565]}}},{"diffOp":{"equal":{"range":[359,370]}}},{"diffOp":{"delete":{"range":[1292,1293]}}},{"diffOp":{"insert":{"range":[560,565]}}},{"diffOp":{"equal":{"range":[371,400]}}},{"diffOp":{"delete":{"range":[1292,1293]}}},{"diffOp":{"insert":{"range":[560,565]}}},{"diffOp":{"equal":{"range":[400,430]}}},{"diffOp":{"delete":{"range":[1292,1293]}}},{"diffOp":{"insert":{"range":[1149,1154]}}},{"diffOp":{"equal":{"range":[1680,1766]}}},{"equalLines":{"line_count":64}},{"diffOp":{"equal":{"range":[1766,1775]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-backup.test.ts"},"span":null,"sourceCode":"/**\n * S7-09 定向测试：记忆数据库与归档的一致性备份/恢复（O07 修 F07/F08/F15）。\n *\n * 覆盖：\n * - createMemoryBackup 用 VACUUM INTO 产生 manifest + 快照 + 段文件副本\n *   + 受管成果副本；备份目录非空拒绝覆盖；\n * - restoreMemoryBackup 恢复到新目录：段文件回位并重定位 archive_segments\n *   路径、来源可回读、受管成果副本回位并重写 location_json.dir、\n *   FTS/向量按库内 exclusion 清理；目标 memory/ 非空拒绝覆盖；\n * - 异地恢复（旧 home 不可读）后 readSourceEvents/resolveArtifactVersion\n *   仍从新 home 取到确切字节；\n * - 恢复时传 liveHome：备份后现场新产生的 source_exclusions 重放进\n *   恢复库，被排除记忆的正本/修订/来源行与派生索引一并清除，\n *   getMemory(includeHistory) 不再返回已删正文；\n * - 不传 liveHome 的独立旧备份：只有备份自带 exclusion，manifest.limitation\n *   如实声明无法推断备份后删除；\n * - archive jobKind 解析：parseArchiveJobScope 只认合法 backupDir。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-backup.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { readSourceEvents } from \"../../src/pao/memory/archive.ts\";\nimport {\n\ttype BackupManifest,\n\tcreateMemoryBackup,\n\tparseArchiveJobScope,\n\trestoreMemoryBackup,\n} from \"../../src/pao/memory/backup.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { isSourceExcluded } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryService } from \"../../src/pao/memory/types.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-10T10:00:00.000Z\";\nconst PROJECT = \"pao-dev\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nfunction makePersistentSession(home: string, id: string) {\n\tconst sessionDir = join(home, \"agent\", \"sessions\");\n\tconst manager = SessionManager.create(home, sessionDir, { id });\n\tmanager.appendMessage(userMsg(\"备份测试的用户上下文\"));\n\tconst assistantId = manager.appendMessage(assistantMsg(\"备份测试的助手回复\"));\n\tconst file = manager.getSessionFile();\n\tif (!file || !existsSync(file)) throw new Error(\"真实会话文件未创建\");\n\treturn { manager, file, assistantId };\n}\n\nasync function createMemory(service: MemoryService, conclusion: string, sourceIds: string[]): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: \"decision\",\n\t\tscope: { projectId: PROJECT },\n\t\tconclusion,\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds,\n\t\tcreatedAt: AT,\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\n/** 造一份含一条真实来源、一条激活记忆的最小现场。 */\nasync function seedHome(home: string, conclusion: string) {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\tconst session = makePersistentSession(home, `sess-${Math.random().toString(36).slice(2, 8)}`);\n\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\tcapture.registerSession(session.manager.getSessionId(), session.file);\n\tconst captured = capture.captureCommittedEntry(\n\t\tsession.manager.getSessionId(),\n\t\tsession.manager.getEntry(session.assistantId) as never,\n\t\t\"user\",\n\t\tAT,\n\t);\n\tif (!captured.sourceId) throw new Error(\"来源登记失败\");\n\tconst memoryId = await createMemory(service, conclusion, [captured.sourceId]);\n\treturn { store, service, session, sourceId: captured.sourceId, memoryId };\n}\n\nfunction readManifest(backupDir: string): BackupManifest {\n\treturn JSON.parse(readFileSync(join(backupDir, \"manifest.json\"), \"utf8\")) as BackupManifest;\n}\n\ndescribe(\"S7-09 一致性备份/恢复\", () => {\n\tit(\"备份生成 manifest+快照+段副本；目录非空拒绝覆盖\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src-\");\n\t\tconst seeded = await seedHome(home, \"备份一致性验证结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out-\"), \"backup-1\");\n\t\ttry {\n\t\t\tconst result = createMemoryBackup(seeded.store, {\n\t\t\t\thome,\n\t\t\t\tbackupDir,\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(result.ok).toBe(true);\n\t\t\tif (!result.ok) return;\n\t\t\texpect(existsSync(result.snapshotPath)).toBe(true);\n\t\t\texpect(result.memoryCount).toBe(1);\n\t\t\texpect(result.copiedSegments).toBe(1);\n\t\t\texpect(result.missingSegments).toBe(0);\n\n\t\t\tconst manifest = readManifest(backupDir);\n\t\t\texpect(manifest.version).toBe(1);\n\t\t\texpect(manifest.memoryCount).toBe(1);\n\t\t\texpect(manifest.segments).toHaveLength(1);\n\t\t\texpect(manifest.segments[0]!.backupPath).toMatch(/^segments[/\\\\]/);\n\t\t\texpect(manifest.limitation).toContain(\"备份之后产生的删除排除记录不包含在内\");\n\n\t\t\t// 备份目录非空 → 拒绝覆盖。\n\t\t\tconst again = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(again.ok).toBe(false);\n\t\t\tif (!again.ok) expect(again.error.code).toBe(\"invalid_input\");\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t});\n\n\tit(\"恢复到新目录：段回位、来源可回读、exclusion 生效清派生索引\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src2-\");\n\t\tconst seeded = await seedHome(home, \"恢复后可读来源结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out2-\"), \"backup-2\");\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredSegments).toBe(1);\n\t\texpect(existsSync(restored.database)).toBe(true);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst row = store.db.prepare(`SELECT conclusion_ok FROM (SELECT 1 AS conclusion_ok)`).get() as {\n\t\t\t\tconclusion_ok: number;\n\t\t\t};\n\t\t\texpect(row.conclusion_ok).toBe(1);\n\t\t\tconst memory = store.db.prepare(`SELECT id FROM memories WHERE id = ?`).get(seeded.memoryId) as\n\t\t\t\t| { id: string }\n\t\t\t\t| undefined;\n\t\t\texpect(memory?.id).toBe(seeded.memoryId);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"传 liveHome：备份后新 exclusion 重放进恢复库并清派生索引\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src3-\");\n\t\tconst seeded = await seedHome(home, \"备份后删除的记忆结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out3-\"), \"backup-3\");\n\t\tconst memoryId = seeded.memoryId;\n\t\tconst sourceId = seeded.sourceId;\n\t\ttry {\n\t\t\t// 备份后删该记忆：source_exclusions 在库内出现。\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.exclusionCount).toBe(0); // 备份时还没有排除\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: seeded.session.manager.getSessionId() },\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t\texpect(isSourceExcluded(seeded.store.db, { sourceId })).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst3-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBeGreaterThan(0);\n\t\texpect(restored.exclusionCount).toBeGreaterThanOrEqual(restored.replayedExclusions);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\t// 恢复库里：正本记忆行还在（备份时刻存在），但 exclusion 已重放、派生索引已清。\n\t\t\texpect(isSourceExcluded(store.db, { sourceId })).toBe(true);\n\t\t\tconst ftsRows = store.db.prepare(`SELECT COUNT(*) AS n FROM memory_fts WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\tn: number;\n\t\t\t};\n\t\t\texpect(ftsRows.n).toBe(0);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"独立旧备份不传 liveHome：只留备份自带 exclusion，limitation 如实声明\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src4-\");\n\t\tconst seeded = await seedHome(home, \"独立备份的限制说明结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out4-\"), \"backup-4\");\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst4-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBe(0);\n\t\texpect(restored.exclusionCount).toBe(0);\n\t\texpect(restored.limitation).toContain(\"备份之后产生的删除排除记录不包含在内\");\n\t});\n\n\tit(\"目标 memory/ 非空拒绝覆盖；manifest/快照缺失如实失败\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src5-\");\n\t\tconst seeded = await seedHome(home, \"覆盖保护验证结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out5-\"), \"backup-5\");\n\t\ttry {\n\t\t\texpect(createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT }).ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\t// 目标已有 memory 数据 → 拒绝。\n\t\tconst occupiedHome = tempDir(\"pao-bak-occ-\");\n\t\tmkdirSync(join(occupiedHome, \"memory\"), { recursive: true });\n\t\twriteFileSync(join(occupiedHome, \"memory\", \"memory.sqlite\"), \"x\");\n\t\tconst occupied = restoreMemoryBackup({ backupDir, targetHome: occupiedHome, restoredAt: AT });\n\t\texpect(occupied.ok).toBe(false);\n\t\tif (!occupied.ok) expect(occupied.error.code).toBe(\"invalid_input\");\n\n\t\t// manifest 缺失 → invalid_input。\n\t\tconst empty = tempDir(\"pao-bak-empty-\");\n\t\tconst noManifest = restoreMemoryBackup({ backupDir: empty, targetHome: tempDir(\"pao-bak-t1-\"), restoredAt: AT });\n\t\texpect(noManifest.ok).toBe(false);\n\t\tif (!noManifest.ok) expect(noManifest.error.code).toBe(\"invalid_input\");\n\n\t\t// manifest 在但快照缺 → source_missing。\n\t\tconst broken = tempDir(\"pao-bak-broken-\");\n\t\twriteFileSync(\n\t\t\tjoin(broken, \"manifest.json\"),\n\t\t\tJSON.stringify({\n\t\t\t\tversion: 1,\n\t\t\t\tcreatedAt: AT,\n\t\t\t\tsourceHome: \"x\",\n\t\t\t\tsnapshotPath: \"memory.snapshot\",\n\t\t\t\texclusionCount: 0,\n\t\t\t\tmemoryCount: 0,\n\t\t\t\tsegments: [],\n\t\t\t\tlimitation: \"x\",\n\t\t\t}),\n\t\t);\n\t\tconst noSnapshot = restoreMemoryBackup({ backupDir: broken, targetHome: tempDir(\"pao-bak-t2-\"), restoredAt: AT });\n\t\texpect(noSnapshot.ok).toBe(false);\n\t\tif (!noSnapshot.ok) expect(noSnapshot.error.code).toBe(\"source_missing\");\n\t});\n\n\tit(\"parseArchiveJobScope 只认合法 backupDir\", () => {\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\",\"backupDir\":\"/tmp/x\"}')).toEqual({ backupDir: \"/tmp/x\" });\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope('{\"kind\":\"embed\",\"backupDir\":\"/tmp/x\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\",\"backupDir\":\"\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope(\"not-json\")).toBeUndefined();\n\t});\n\n\tit(\"异地恢复（旧 home 不可读）后 readSourceEvents 从新 home 回读段\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src6-\");\n\t\tconst seeded = await seedHome(home, \"异地恢复回读结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out6-\"), \"backup-6\");\n\t\ttry {\n\t\t\texpect(createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT }).ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t\t// 旧 home 不可读（移走），恢复后回读不能再依赖旧绝对路径。\n\t\trmSync(home, { recursive: true, force: true });\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst6-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst events = await readSourceEvents(store.db, targetHome, seeded.sourceId, { limit: 10 });\n\t\t\texpect(events.ok).toBe(true);\n\t\t\tif (!events.ok) return;\n\t\t\texpect(events.events.length).toBeGreaterThan(0);\n\t\t\texpect(JSON.stringify(events.events[0]!.content)).toContain(\"备份测试\");\n\t\t\t// 恢复库内段路径已重写到新 home。\n\t\t\tconst seg = store.db\n\t\t\t\t.prepare(`SELECT original_path, compressed_path FROM archive_segments`)\n\t\t\t\t.get() as { original_path: string | null; compressed_path: string | null };\n\t\t\tconst path = seg.compressed_path ?? seg.original_path;\n\t\t\texpect(path).not.toBeNull();\n\t\t\texpect(path!).toContain(memoryPaths(targetHome).archives);\n\t\t\texpect(path!).not.toContain(home);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"受管成果恢复后 resolveArtifactVersion 从新 home 读回确切字节\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src7-\");\n\t\tconst seeded = await seedHome(home, \"受管成果恢复结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out7-\"), \"backup-7\");\n\t\tlet versionId = \"\";\n\t\tlet artifactId = \"\";\n\t\tconst deliveredDir = tempDir(\"pao-bak-art-\");\n\t\ttry {\n\t\t\twriteFileSync(join(deliveredDir, \"deliver.txt\"), \"受管成果确切字节\");\n\t\t\tconst registered = await seeded.service.registerArtifact({\n\t\t\t\tname: \"恢复用成果\",\n\t\t\t\tpurpose: \"验证受管副本随备份\",\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tfiles: [{ name: \"deliver.txt\", path: join(deliveredDir, \"deliver.txt\") }],\n\t\t\t\tsourceIds: [seeded.sourceId],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tartifactId = registered.artifactId;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.copiedArtifacts).toBe(1);\n\t\t\texpect(backup.missingArtifacts).toBe(0);\n\t\t\tconst manifest = readManifest(backupDir);\n\t\t\texpect(manifest.artifacts).toHaveLength(1);\n\t\t\texpect(manifest.artifacts![0]!.versionId).toBe(versionId);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t\t// 旧 home 与交付源都不可读。\n\t\trmSync(home, { recursive: true, force: true });\n\t\trmSync(deliveredDir, { recursive: true, force: true });\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst7-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredArtifacts).toBe(1);\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId });\n\t\t\texpect(resolved.ok).toBe(true);\n\t\t\tif (!resolved.ok) return;\n\t\t\texpect(resolved.available).toBe(true);\n\t\t\tif (!resolved.available) return;\n\t\t\texpect(resolved.content.toString(\"utf8\")).toBe(\"受管成果确切字节\");\n\t\t\texpect(resolved.version.artifactId).toBe(artifactId);\n\t\t\t// location.dir 已重写到新 home。\n\t\t\tconst loc = resolved.version.location;\n\t\t\texpect(loc.kind).toBe(\"managed\");\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\texpect(loc.dir).toContain(memoryPaths(targetHome).artifacts);\n\t\t\t\texpect(loc.dir).not.toContain(home);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\tit(\"带 liveHome 删除后恢复：getMemory(includeHistory) 不再返回已删正文\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src8-\");\n\t\tconst seeded = await seedHome(home, \"备份后彻底删除的结论正文\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out8-\"), \"backup-8\");\n\t\tconst memoryId = seeded.memoryId;\n\t\tconst sourceId = seeded.sourceId;\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: seeded.session.manager.getSessionId() },\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst8-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBeGreaterThan(0);\n\t\texpect(restored.purgedMemories).toBe(1);\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\t// 已删记忆按 ID 查不存在。\n\t\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\t\texpect(got.ok).toBe(false);\n\t\t\tif (!got.ok) expect(got.error.code).toBe(\"invalid_input\");\n\n\t\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\t\ttry {\n\t\t\t\t// 正本/修订/来源行已清；派生索引也清。\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memories WHERE id = ?`).get(memoryId) as { n: number }).n,\n\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memory_revisions WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\tn: number;\n\t\t\t\t\t}).n,\n\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memory_fts WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\tn: number;\n\t\t\t\t\t}).n,\n\t\t\t\t).toBe(0);\n\t\t\t\t// 已删正文不再可回读：来源行已清 → 按 sourceId 回读 source_missing。\n\t\t\t\tconst events = await readSourceEvents(store.db, targetHome, sourceId, { limit: 10 });\n\t\t\t\texpect(events.ok).toBe(false);\n\t\t\t\tif (!events.ok) expect(events.error.code).toBe(\"source_missing\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\t// R2：共享保留来源的 source_fts 不随删除重放丢失（历史检索仍命中）。\n\tit(\"R2 删除重放：共享保留来源的 source_fts 保留、独占来源清除\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r2-\");\n\t\tconst seeded = await seedHome(home, \"共享保留来源的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r2o-\"), \"backup-r2\");\n\t\tconst sharedSourceId = seeded.sourceId;\n\t\tconst sharedSessionId = seeded.session.manager.getSessionId();\n\t\tlet exclusiveSourceId = \"\";\n\t\tlet exclusiveSessionId = \"\";\n\t\tlet deletedMemoryId = \"\";\n\t\tlet keptMemoryId = \"\";\n\t\ttry {\n\t\t\t// 第二条独立会话来源：独占给将被删记忆。\n\t\t\tconst second = makePersistentSession(home, `sess-${Math.random().toString(36).slice(2, 8)}`);\n\t\t\texclusiveSessionId = second.manager.getSessionId();\n\t\t\tconst capture = createCapture({ store: seeded.store, paoHome: home, now: () => AT });\n\t\t\tcapture.registerSession(exclusiveSessionId, second.file);\n\t\t\tconst captured = capture.captureCommittedEntry(\n\t\t\t\texclusiveSessionId,\n\t\t\t\tsecond.manager.getEntry(second.assistantId) as never,\n\t\t\t\t\"user\",\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tif (!captured.sourceId) throw new Error(\"独占来源登记失败\");\n\t\t\texclusiveSourceId = captured.sourceId;\n\n\t\t\t// 存活记忆只引共享来源；被删记忆引共享+独占。\n\t\t\tkeptMemoryId = await createMemory(seeded.service, \"保留的决定\", [sharedSourceId]);\n\t\t\tdeletedMemoryId = await createMemory(seeded.service, \"被删的决定\", [sharedSourceId, exclusiveSourceId]);\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [deletedMemoryId],\n\t\t\t\trevisions: { [deletedMemoryId]: 1 },\n\t\t\t\tsource: { sessionId: sharedSessionId },\n\t\t\t\tsharedSourcePolicy: \"retain\",\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r2d-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.purgedMemories).toBe(1);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\t// 共享保留来源行与其 fts 索引都保留；独占来源行与索引清除。\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(sharedSourceId) as { n: number }).n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(sharedSourceId) as { n: number })\n\t\t\t\t\t.n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(exclusiveSourceId) as { n: number })\n\t\t\t\t\t.n,\n\t\t\t).toBe(0);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(exclusiveSourceId) as {\n\t\t\t\t\tn: number;\n\t\t\t\t}).n,\n\t\t\t).toBe(0);\n\n\t\t\t// 共享来源仍可按 ID 回读、history 原文检索仍命中。\n\t\t\tconst direct = await readSourceEvents(store.db, targetHome, sharedSourceId);\n\t\t\texpect(direct.ok).toBe(true);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\t// seedHome 采集的是 assistant 条目（\"备份测试的助手回复\"）。\n\t\t\tconst history = await service.searchMemory({\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tquery: \"助手回复\",\n\t\t\t\tmode: \"history\",\n\t\t\t});\n\t\t\texpect(history.ok).toBe(true);\n\t\t\tif (history.ok) {\n\t\t\t\texpect(history.sourceHits?.some((hit) => hit.sourceId === sharedSourceId)).toBe(true);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\t// R3：备份时副本缺失的段恢复后清旧 home 路径，不回读旧现场。\n\tit(\"R3 缺失段副本：恢复后清 original_path/compressed_path，不回读旧 home\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r3s-\");\n\t\tconst seeded = await seedHome(home, \"缺失段副本的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r3so-\"), \"backup-r3s\");\n\t\tconst sourceId = seeded.sourceId;\n\t\tlet heldPath = \"\";\n\t\ttry {\n\t\t\tconst row = seeded.store.db.prepare(`SELECT original_path FROM archive_segments`).get() as {\n\t\t\t\toriginal_path: string;\n\t\t\t};\n\t\t\theldPath = `${row.original_path}.held`;\n\t\t\trenameSync(row.original_path, heldPath);\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\trenameSync(heldPath, row.original_path);\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.missingSegments).toBe(1);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r3sd-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst seg = store.db\n\t\t\t\t.prepare(`SELECT original_path, compressed_path FROM archive_segments`)\n\t\t\t\t.get() as { original_path: string | null; compressed_path: string | null };\n\t\t\texpect(seg.original_path).toBeNull();\n\t\t\texpect(seg.compressed_path).toBeNull();\n\t\t\tconst read = await readSourceEvents(store.db, targetHome, sourceId);\n\t\t\texpect(read.ok).toBe(false);\n\t\t\tif (!read.ok) expect(read.error.code).toBe(\"source_missing\");\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\t// R3：旧版 manifest 无 artifacts 清单时，受管版本 location.dir 也重写到新 home。\n\tit(\"R3 旧版 manifest 无 artifacts：managed 版本 dir 重写、副本缺失如实 unavailable\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r3a-\");\n\t\tconst seeded = await seedHome(home, \"旧版 manifest 无成果清单的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r3ao-\"), \"backup-r3a\");\n\t\tlet versionId = \"\";\n\t\ttry {\n\t\t\tconst deliveredDir = tempDir(\"pao-bak-r3ad-\");\n\t\t\twriteFileSync(join(deliveredDir, \"deliver.txt\"), \"旧版成果字节\");\n\t\t\tconst registered = await seeded.service.registerArtifact({\n\t\t\t\tname: \"旧版成果\",\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tfiles: [{ name: \"deliver.txt\", path: join(deliveredDir, \"deliver.txt\") }],\n\t\t\t\tsourceIds: [seeded.sourceId],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\n\t\t\t// 模拟旧版 manifest：去掉 artifacts 字段。\n\t\t\tconst manifestPath = join(backupDir, \"manifest.json\");\n\t\t\tconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\")) as Record<string, unknown>;\n\t\t\tdelete manifest.artifacts;\n\t\t\twriteFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\\n`, \"utf8\");\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r3adt-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredArtifacts).toBe(0);\n\t\texpect(restored.limitation).toContain(\"受管成果副本缺失 1 个\");\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId });\n\t\t\texpect(resolved.ok).toBe(true);\n\t\t\tif (!resolved.ok) return;\n\t\t\texpect(resolved.available).toBe(false);\n\t\t\tconst loc = resolved.version.location;\n\t\t\texpect(loc.kind).toBe(\"managed\");\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\t// dir 已指向目标 home 预期位置，不是旧 home 绝对路径。\n\t\t\t\texpect(loc.dir).toContain(memoryPaths(targetHome).artifacts);\n\t\t\t\texpect(loc.dir).not.toContain(home);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S7-08 定向测试：真实请求上下文来源估算快照。\n *} from \"../../src/pao/memory/context-usage.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport { AUTO_RECALL_SECTION } from \"../../src/pao/memory/resident.ts\";\nimport type { MemoryScope,MemoryServiceBUILTIN_PROVIDER } from \"../../src/pao/memory/types.tssession.ts\";{ registerMemoryUsageMemoryScope, MemoryServiceusage.ts\nimport { \n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[73,271]}}},{"diffOp":{"equal":{"range":[271,279]}}},{"diffOp":{"delete":{"range":[279,284]}}},{"diffOp":{"equal":{"range":[284,285]}}},{"diffOp":{"delete":{"range":[285,298]}}},{"diffOp":{"equal":{"range":[285,286]}}},{"diffOp":{"delete":{"range":[298,311]}}},{"diffOp":{"insert":{"range":[311,327]}}},{"diffOp":{"equal":{"range":[327,357]}}},{"diffOp":{"delete":{"range":[357,365]}}},{"diffOp":{"insert":{"range":[365,375]}}},{"diffOp":{"equal":{"range":[375,377]}}},{"diffOp":{"equal":{"range":[271,279]}}},{"diffOp":{"insert":{"range":[279,284]}}},{"diffOp":{"equal":{"range":[377,379]}}},{"diffOp":{"delete":{"range":[379,398]}}},{"diffOp":{"insert":{"range":[398,424]}}},{"diffOp":{"equal":{"range":[327,357]}}},{"diffOp":{"delete":{"range":[424,432]}}},{"diffOp":{"insert":{"range":[357,365]}}},{"diffOp":{"equal":{"range":[375,377]}}},{"diffOp":{"equal":{"range":[432,442]}}},{"diffOp":{"delete":{"range":[311,327]}}},{"diffOp":{"insert":{"range":[379,398]}}},{"diffOp":{"equal":{"range":[327,357]}}},{"diffOp":{"delete":{"range":[365,375]}}},{"diffOp":{"insert":{"range":[424,432]}}},{"diffOp":{"equal":{"range":[375,377]}}},{"diffOp":{"equal":{"range":[442,474]}}},{"equalLines":{"line_count":315}},{"diffOp":{"equal":{"range":[474,483]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-context-usage.test.ts"},"span":[726,772],"sourceCode":"/**\n * S7-08 定向测试：真实请求上下文来源估算快照。\n *\n * 覆盖：\n * - 单段只进一类（system 拆 prompt/tools 两桶，合计等于整条估算）；\n * - 工具定义计入 tool_definitions；\n * - 附件全文未内联只计路径元数据（conversation），经工具读取的全文计入 tool_results；\n * - role=custom 且 customType=pao-* 归 memory，其余 custom 归 other；\n * - 多模态块（image）标 unestimated，不混入 estimatedTotal；\n * - registerContextUsage 在 before_provider_request 时把快照落会话 custom entry。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-context-usage.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { AgentMessage } from \"@pao/agent-core\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport {\n\ttype ContextUsageSnapshot,\n\testimateContextUsage,\n\tregisterContextUsage,\n} from \"../../src/pao/memory/context-usage.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport { AUTO_RECALL_SECTION } from \"../../src/pao/memory/resident.ts\";\nimport type { MemoryScope, MemoryService } from \"../../src/pao/memory/types.ts\";\nimport { registerMemoryUsage } from \"../../src/pao/memory/usage.ts\";\nimport { BUILTIN_PROVIDER } from \"../../src/pao/memory/session.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst SCOPE: MemoryScope = resolveMemoryScope(process.cwd());\n\nfunction systemMessage(overrides: Partial<Record<string, unknown>> = {}): AgentMessage {\n\treturn {\n\t\trole: \"system\",\n\t\tcontent: \"你是编程助手。\",\n\t\ttimestamp: 0,\n\t\t...overrides,\n\t} as AgentMessage;\n}\n\nfunction userMessage(text: string): AgentMessage {\n\treturn { role: \"user\", content: text, timestamp: 1 } as AgentMessage;\n}\n\nfunction toolResultMessage(toolName: string, text: string): AgentMessage {\n\treturn {\n\t\trole: \"toolResult\",\n\t\ttoolCallId: \"call-1\",\n\t\ttoolName,\n\t\tcontent: [{ type: \"text\", text }],\n\t\tisError: false,\n\t\ttimestamp: 2,\n\t} as unknown as AgentMessage;\n}\n\nfunction customMessage(customType: string, text: string): AgentMessage {\n\treturn {\n\t\trole: \"custom\",\n\t\tcustomType,\n\t\tcontent: text,\n\t\tdisplay: false,\n\t\ttimestamp: 3,\n\t} as unknown as AgentMessage;\n}\n\ndescribe(\"estimateContextUsage\", () => {\n\tit(\"system 消息拆 system_prompt 与 tool_definitions，单段不重复计\", () => {\n\t\tconst tool = { name: \"read\", description: \"读文件\", parameters: { type: \"object\" } };\n\t\tconst snapshot = estimateContextUsage({\n\t\t\tmessages: [\n\t\t\t\tsystemMessage({\n\t\t\t\t\tsections: { rules: \"简洁回答\" },\n\t\t\t\t\ttoolsAdded: [tool],\n\t\t\t\t}),\n\t\t\t\tuserMessage(\"你好\"),\n\t\t\t],\n\t\t\trequestId: \"req-1\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\texpect(snapshot.byCategory.system_prompt).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.tool_definitions).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.conversation).toBeGreaterThan(0);\n\t\t// 合计 = 各分类之和，不重复计。\n\t\tconst sum = Object.values(snapshot.byCategory).reduce((acc, value) => acc + value, 0);\n\t\texpect(snapshot.estimatedTotal).toBe(sum);\n\t});\n\n\tit(\"role=custom 且 customType=pao-* 归 memory；普通 custom 归 other\", () => {\n\t\tconst snapshot = estimateContextUsage({\n\t\t\tmessages: [\n\t\t\t\tsystemMessage(),\n\t\t\t\tcustomMessage(AUTO_RECALL_SECTION, \"召回：发布口径 rev-1 已确认\"),\n\t\t\t\tcustomMessage(\"some-plugin-note\", \"插件备忘\"),\n\t\t\t],\n\t\t\trequestId: \"req-2\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\texpect(snapshot.byCategory.memory).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.other).toBeGreaterThan(0);\n\t});\n\n\tit(\"toolResult 归 tool_results；附件路径元数据随 conversation 计\", () => {\n\t\tconst attachmentPreamble = \"附件：report.pdf（类型 application/pdf，路径 D:\\\\docs\\\\report.pdf，大小 12KB）\";\n\t\tconst toolOutput = \"文件全文内容：报告正文……\";\n\t\tconst snapshot = estimateContextUsage({\n\t\t\tmessages: [systemMessage(), userMessage(attachmentPreamble), toolResultMessage(\"read\", toolOutput)],\n\t\t\trequestId: \"req-3\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\t// 附件只来路径元数据 → conversation；read 工具返回全文 → tool_results。\n\t\texpect(snapshot.byCategory.conversation).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.tool_results).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.memory).toBe(0);\n\t});\n\n\tit(\"多模态块标 unestimated，不计入 estimatedTotal 假装完整\", () => {\n\t\tconst imageMessage = {\n\t\t\trole: \"user\",\n\t\t\tcontent: [\n\t\t\t\t{ type: \"text\", text: \"看图\" },\n\t\t\t\t{ type: \"image\", data: \"base64…\", mimeType: \"image/png\" },\n\t\t\t],\n\t\t\ttimestamp: 1,\n\t\t} as unknown as AgentMessage;\n\t\tconst snapshot = estimateContextUsage({\n\t\t\tmessages: [systemMessage(), imageMessage],\n\t\t\trequestId: \"req-4\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\tconst multimodal = snapshot.unestimated.find((u) => u.kind === \"multimodal\");\n\t\texpect(multimodal).toBeDefined();\n\t\texpect(multimodal?.messageIndexes).toContain(1);\n\t\t// estimatedTotal 仍是各分类合计；multimodal 只点名不折算。\n\t\tconst sum = Object.values(snapshot.byCategory).reduce((acc, value) => acc + value, 0);\n\t\texpect(snapshot.estimatedTotal).toBe(sum);\n\t});\n\n\tit(\"taskId 仅 scope 可解析时记录；无卡任务缺省\", () => {\n\t\tconst withTask = estimateContextUsage({\n\t\t\tmessages: [systemMessage()],\n\t\t\trequestId: \"req-5\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\ttaskId: \"card-42\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\texpect(withTask.taskId).toBe(\"card-42\");\n\t\tconst withoutTask = estimateContextUsage({\n\t\t\tmessages: [systemMessage()],\n\t\t\trequestId: \"req-6\",\n\t\t\tsessionId: \"sess-1\",\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t});\n\t\texpect(withoutTask.taskId).toBeUndefined();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// registerContextUsage：context_with_system → before_provider_request → appendEntry\n// ════════════════════════════════════════════════════════════════════════\n\ntype Handler = (event: never, ctx: unknown) => unknown;\n\ninterface CapturedPi {\n\thandlers: Map<string, Handler[]>;\n\tentries: Array<{ customType: string; data: unknown }>;\n\tpi: ExtensionAPI;\n}\n\nfunction capturePi(): CapturedPi {\n\tconst handlers = new Map<string, Handler[]>();\n\tconst entries: Array<{ customType: string; data: unknown }> = [];\n\tconst pi = {\n\t\ton(event: string, handler: Handler) {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\thandlers.set(\n\t\t\t\t\tevent,\n\t\t\t\t\tlist.filter((h) => h !== handler),\n\t\t\t\t);\n\t\t\t};\n\t\t},\n\t\tappendEntry<T>(customType: string, data?: T) {\n\t\t\tentries.push({ customType, data });\n\t\t},\n\t} as unknown as ExtensionAPI;\n\treturn { handlers, entries, pi };\n}\n\nfunction testCtx(overrides: Partial<ExtensionContext> = {}): ExtensionContext {\n\treturn {\n\t\tcwd: process.cwd(),\n\t\tsessionManager: {\n\t\t\tgetSessionId: () => \"sess-test\",\n\t\t},\n\t\tsignal: undefined,\n\t\t...overrides,\n\t} as unknown as ExtensionContext;\n}\n\nasync function emit(pi: CapturedPi, event: string, payload: unknown, ctx: ExtensionContext): Promise<void> {\n\tfor (const handler of pi.handlers.get(event) ?? []) {\n\t\tawait handler(payload as never, ctx);\n\t}\n}\n\ndescribe(\"registerContextUsage\", () => {\n\tit(\"context_with_system 记账 → before_provider_request 落 custom entry\", async () => {\n\t\tconst home = mkdtempSync(join(tmpdir(), \"pao-ctx-usage-\"));\n\t\ttempDirs.push(home);\n\t\tconst captured = capturePi();\n\t\tconst unmount = registerContextUsage(captured.pi, () => SCOPE);\n\t\tconst ctx = testCtx();\n\n\t\tconst tool = { name: \"read\", description: \"读文件\", parameters: { type: \"object\" } };\n\t\tawait emit(\n\t\t\tcaptured,\n\t\t\t\"context_with_system\",\n\t\t\t{\n\t\t\t\ttype: \"context_with_system\",\n\t\t\t\tmessages: [systemMessage({ toolsAdded: [tool] }), userMessage(\"开始\")],\n\t\t\t},\n\t\t\tctx,\n\t\t);\n\t\tawait emit(captured, \"before_provider_request\", { type: \"before_provider_request\", payload: {} }, ctx);\n\n\t\texpect(captured.entries).toHaveLength(1);\n\t\texpect(captured.entries[0]!.customType).toBe(\"pao-context-usage\");\n\t\tconst snapshot = captured.entries[0]!.data as ContextUsageSnapshot;\n\t\texpect(snapshot.requestId).toBeTruthy();\n\t\texpect(snapshot.sessionId).toBe(\"sess-test\");\n\t\texpect(snapshot.byCategory.tool_definitions).toBeGreaterThan(0);\n\t\texpect(snapshot.byCategory.conversation).toBeGreaterThan(0);\n\t\tunmount();\n\t});\n\n\tit(\"signal 已 abort 时不落快照\", async () => {\n\t\tconst captured = capturePi();\n\t\tconst unmount = registerContextUsage(captured.pi, () => SCOPE);\n\t\tconst ctx = testCtx({\n\t\t\tsignal: { aborted: true } as AbortSignal,\n\t\t});\n\t\tawait emit(\n\t\t\tcaptured,\n\t\t\t\"context_with_system\",\n\t\t\t{ type: \"context_with_system\", messages: [systemMessage(), userMessage(\"x\")] },\n\t\t\tctx,\n\t\t);\n\t\tawait emit(captured, \"before_provider_request\", { type: \"before_provider_request\", payload: {} }, ctx);\n\t\texpect(captured.entries).toHaveLength(0);\n\t\tunmount();\n\t});\n\n\tit(\"agent_settled 清空待落快照，下一轮重新采样\", async () => {\n\t\tconst captured = capturePi();\n\t\tconst unmount = registerContextUsage(captured.pi, () => SCOPE);\n\t\tconst ctx = testCtx();\n\t\tawait emit(\n\t\t\tcaptured,\n\t\t\t\"context_with_system\",\n\t\t\t{ type: \"context_with_system\", messages: [systemMessage(), userMessage(\"x\")] },\n\t\t\tctx,\n\t\t);\n\t\tawait emit(captured, \"agent_settled\", { type: \"agent_settled\" }, ctx);\n\t\t// settled 后未再触发 context_with_system → before_provider_request 无快照可落。\n\t\tawait emit(captured, \"before_provider_request\", { type: \"before_provider_request\", payload: {} }, ctx);\n\t\texpect(captured.entries).toHaveLength(0);\n\t\tunmount();\n\t});\n\n\tit(\"O01：context-usage 快照与 usage.ts inject 共享 requestId；两轮不同\", async () => {\n\t\t// 同一 pi 上同时挂 context-usage 与 usage（registerBuiltinMemory 同款装配）：\n\t\t// context-usage 在 context_with_system 记 requestId，usage 在\n\t\t// before_provider_request 用同一身份写 inject——快照与 inject 记录同 ID。\n\t\tconst home = mkdtempSync(join(tmpdir(), \"pao-req-id-\"));\n\t\ttempDirs.push(home);\n\t\tconst captured = capturePi();\n\t\tconst injects: Array<{ requestId?: string }> = [];\n\t\tconst service = {\n\t\t\trecordMemoryUsage: async (input: { action: string; requestId?: string }) => {\n\t\t\t\tif (input.action === \"inject\") injects.push({ requestId: input.requestId });\n\t\t\t\treturn { ok: true as const, id: 1 };\n\t\t\t},\n\t\t} as unknown as MemoryService;\n\t\tconst unmountCtx = registerContextUsage(captured.pi, () => SCOPE);\n\t\tconst unmountUsage = registerMemoryUsage(captured.pi, service);\n\t\tconst sessionManager = SessionManager.inMemory();\n\t\tconst ctx = testCtx({ sessionManager });\n\t\tconst recallMessage = customMessage(\"pao-auto-recall\", \"召回：端口固定为 8123\");\n\t\t(recallMessage as { details?: unknown }).details = {\n\t\t\tvendor: BUILTIN_PROVIDER,\n\t\t\thits: [{ 记忆ID: \"mem-1\", 修订号: 1, 内容: \"端口固定为 8123\" }],\n\t\t};\n\n\t\t// 第一轮：context_with_system（快照+可见引用）→ before_provider_request（落快照+inject）。\n\t\tawait emit(captured, \"turn_start\", { type: \"turn_start\" }, ctx);\n\t\tawait emit(\n\t\t\tcaptured,\n\t\t\t\"context_with_system\",\n\t\t\t{ type: \"context_with_system\", messages: [systemMessage(), recallMessage, userMessage(\"端口多少\")] },\n\t\t\tctx,\n\t\t);\n\t\tawait emit(captured, \"before_provider_request\", { type: \"before_provider_request\", payload: {} }, ctx);\n\t\tawait emit(captured, \"agent_settled\", { type: \"agent_settled\" }, ctx);\n\n\t\texpect(captured.entries).toHaveLength(1);\n\t\tconst snapshot1 = captured.entries[0]!.data as ContextUsageSnapshot;\n\t\texpect(injects).toHaveLength(1);\n\t\texpect(snapshot1.requestId).toBeTruthy();\n\t\texpect(injects[0]!.requestId).toBe(snapshot1.requestId);\n\n\t\t// 第二轮：turn_start 换发新 ID——快照与 inject 仍一致但与上轮不同。\n\t\tawait emit(captured, \"turn_start\", { type: \"turn_start\" }, ctx);\n\t\tawait emit(\n\t\t\tcaptured,\n\t\t\t\"context_with_system\",\n\t\t\t{ type: \"context_with_system\", messages: [systemMessage(), recallMessage, userMessage(\"再确认端口\")] },\n\t\t\tctx,\n\t\t);\n\t\tawait emit(captured, \"before_provider_request\", { type: \"before_provider_request\", payload: {} }, ctx);\n\t\tawait emit(captured, \"agent_settled\", { type: \"agent_settled\" }, ctx);\n\n\t\texpect(captured.entries).toHaveLength(2);\n\t\tconst snapshot2 = captured.entries[1]!.data as ContextUsageSnapshot;\n\t\texpect(injects).toHaveLength(2);\n\t\texpect(injects[1]!.requestId).toBe(snapshot2.requestId);\n\t\texpect(snapshot2.requestId).not.toBe(snapshot1.requestId);\n\t\tunmountCtx();\n\t\tunmountUsage();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { SessionManagerExtensionAPI, ToolDefinition } from \"../../src/core/session-manager.tsextensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";createCapturelistPaoSubcommands } from \"../../src/pao/memory/capture.tscommand-router.tscommitExtractionCandidates } from \"../../src/pao/memory/extract-commit.tscapture.tsarchiveProjectOperationSourceproject-operation-source.tscommit.tsopenMemoryServiceservice.tsproject-operation-source.ts\n\tBUILTIN_PROVIDER,\n\tbindBuiltinMemoryService,\n\tregisterMemoryCommand,\n\tsessionMemory,\n openMemoryService } from \"../../src/pao/memory/session.ts registerBuiltinMemory tools.ts\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";assistantMsg, userMsgregisterBuiltinMemoryutilities.ts../src/pao/memory/tools.ts\nimport type {\n\tCommitSourceRef,\tRelatedMemorySummary,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";ToolDefinition../src/core/extensions/types.ts\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,82]}}},{"equalLines":{"line_count":8}},{"diffOp":{"equal":{"range":[82,211]}}},{"diffOp":{"equal":{"range":[211,219]}}},{"diffOp":{"insert":{"range":[219,224]}}},{"diffOp":{"equa