!isWorkflowMinisterTool(event.toolName))\n\t\t\t\treturn { block: true, reason: \"工作流部长只读规划；请通过 pao_minister_submit_cards 交工人执行\" };\n\t\t\treturn undefined;\n\t\t});\n\t}\n\tif (role === \"主控\")\n\t\tpi.on(\"session_shutdown\", async () => {\n\t\t\tawait workflowBridge.shutdown();\n\t\t});\n\t/**\n\t * 模块装配器:等级取自 role.ts 能力清单(S5-1),不再自己维护跳过表。\n\t * - 未登记 → 编程错误(新模块忘了进清单,直接失败);\n\t * - 配置前置不合格 → 跳过并登记降级原因(显式降级,不是静默少装);\n\t * - 必需失败 → 抛 PaoAssemblyFailure,宿主不得启用该会话执行;\n\t * - 可选失败 → 登记降级并保留 warning,普通任务仍可用。\n\t */\n\tconst seen = new Set<string>();\n\t/**\n\t * 可选模块 registerFn 执行期间把 pi 换成只记录的薄代理:登记 pi.on 返回的退订函数与\n\t * registerTool 的工具名;注册失败时退订已装钩子(工具没有公开撤销口,见 已知边界.md)。\n\t */\n\tconst registerGuarded = (\n\t\tregisterFn: () => void,\n\t\tsink: { disposers: Array<() => void>; toolNames: string[] },\n\t): void => {\n\t\t// 不换代理对象(pi 被 WeakMap 按身份键控),只在执行期临时替换两个方法,finally 必还原。\n\t\tconst realOn = pi.on.bind(pi) as ExtensionAPI[\"on\"];\n\t\tconst realRegisterTool = pi.registerTool.bind(pi) as ExtensionAPI[\"registerTool\"];\n\t\ttry {\n\t\t\tpi.on = ((...args: Parameters<ExtensionAPI[\"on\"]>) => {\n\t\t\t\tconst release = (realOn as (...a: unknown[]) => () => void)(...args);\n\t\t\t\tsink.disposers.push(release);\n\t\t\t\treturn release;\n\t\t\t}) as ExtensionAPI[\"on\"];\n\t\t\tpi.registerTool = ((tool: { name: string }) => {\n\t\t\t\tsink.toolNames.push(tool.name);\n\t\t\t\treturn (realRegisterTool as (t: unknown) => void)(tool);\n\t\t\t}) as ExtensionAPI[\"registerTool\"];\n\t\t\tregisterFn();\n\t\t} finally {\n\t\t\tpi.on = realOn;\n\t\t\tpi.registerTool = realRegisterTool;\n\t\t}\n\t};\n\tconst register = (module: string, registerFn: () => void): void => {\n\t\tif (skippedModules.has(module)) return;\n\t\tconst requirement = plan.get(module);\n\t\tif (!requirement)\n\t\t\tthrow new PaoAssemblyFailure({\n\t\t\t\tmodule,\n\t\t\t\tsource: \"assembly-manifest\",\n\t\t\t\treason: \"模块没有登记在 role.ts 能力清单里(装配接线与清单不一致)\",\n\t\t\t});\n\t\tif (seen.has(module))\n\t\t\tthrow new PaoAssemblyFailure({ module, source: \"assembly-manifest\", reason: \"模块被重复注册\" });\n\t\tseen.add(module);\n\t\tif (requirement.skipReason !== undefined) {\n\t\t\ttracker.noteSkipped(requirement, requirement.skipReason);\n\t\t\tlogWarn(`[pao] ${module}模块按配置前置降级:${requirement.skipReason}`);\n\t\t\treturn;\n\t\t}\n\t\tconst guarded = { disposers: [] as Array<() => void>, toolNames: [] as string[] };\n\t\ttry {\n\t\t\tregisterGuarded(registerFn, guarded);\n\t\t\ttracker.noteRegistered(module);\n\t\t} catch (error) {\n\t\t\t// 失败先回滚本次已装钩子,再记降级;工具无撤销口只留警告(已知边界.md)。\n\t\t\tfor (const dispose of guarded.disposers.splice(0)) dispose();\n\t\t\tif (guarded.toolNames.length)\n\t\t\t\tlogWarn(`[pao] ${module}模块降级时无法撤销已注册工具:${guarded.toolNames.join(\"、\")}`);\n\t\t\tconst reason = error instanceof Error ? error.message : String(error);\n\t\t\tif (requirement.level === \"required\")\n\t\t\t\tthrow toPaoAssemblyFailure(error, { module, capability: requirement.capability });\n\t\t\tconst degradation: PaoAssemblyDegradation = {\n\t\t\t\tmodule,\n\t\t\t\tcapability: requirement.capability,\n\t\t\t\tlevel: requirement.level,\n\t\t\t\tsource: \"register\",\n\t\t\t\treason,\n\t\t\t};\n\t\t\ttracker.noteDegraded(degradation);\n\t\t\tlogWarn(`[pao] ${module}模块按可选能力降级:${reason}`);\n\t\t}\n\t};\n\n\t// S8 会话 todo(todo_write,全角色注册,不进任何 SKIPPED 清单):四态整表替换＋陈旧提醒＋\n\t// 压缩留存。currentTodos 是 S8-TUI1 常驻摘要的权威取数口(查询口径,不重放时间线)。\n\tlet todoCurrent: (() => readonly TodoItem[]) | undefined;\n\tregister(\"todo\", () => {\n\t\ttodoCurrent = registerTodo(pi).currentTodos;\n\t});\n\t// S8-TUI1 常驻摘要:footer 折叠行＋/todo 展开挂件(仅 TUI 模式渲染;rpc/json 不发,桌面壳归 S8-桌面1)。\n\tregister(\"todo-summary\", () => registerTodoSummary(pi, { currentTodos: () => todoCurrent?.() ?? [] }));\n\n\tregister(\"cards\", () =>\n\t\tregisterCardTools(pi, {\n\t\t\tverificationCommandRunner: options.verificationCommandRunner,\n\t\t\tresolveCardsDir,\n\t\t\tappendQueueSections,\n\t\t\tresolvePaoHome: paoHome,\n\t\t\tcancelWorker: async (car