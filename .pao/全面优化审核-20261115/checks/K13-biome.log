range":[198,199]}}},{"diffOp":{"insert":{"range":[3216,3221]}}},{"diffOp":{"equal":{"range":[4104,4115]}}},{"diffOp":{"delete":{"range":[198,199]}}},{"diffOp":{"insert":{"range":[3216,3221]}}},{"diffOp":{"equal":{"range":[7074,7086]}}},{"diffOp":{"delete":{"range":[198,199]}}},{"diffOp":{"insert":{"range":[3216,3221]}}},{"diffOp":{"equal":{"range":[9032,9066]}}},{"diffOp":{"insert":{"range":[1402,1403]}}},{"diffOp":{"equal":{"range":[9066,9142]}}},{"diffOp":{"insert":{"range":[1402,1403]}}},{"diffOp":{"equal":{"range":[9142,9159]}}},{"diffOp":{"insert":{"range":[1402,1403]}}},{"diffOp":{"equal":{"range":[4263,4281]}}},{"diffOp":{"insert":{"range":[1402,1403]}}},{"diffOp":{"equal":{"range":[2578,2579]}}},{"diffOp":{"insert":{"range":[3344,3348]}}},{"diffOp":{"equal":{"range":[9159,9219]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[9219,9228]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-e2e.test.ts"},"span":null,"sourceCode":"/**\n * S8-13 全链机制验证（E2E 集成测试）。\n *\n * 串起 evolution 模块公开函数的完整链路：\n *   registerResource → snapshotResourceFiles（baseVersion）\n *   → declareImprovementIntent（observed）→ classifyProblem（classified）\n *   → freezeValidationPlan（三组冻结样例，testPlanId 绑定 baseVersion）\n *   → proposeCandidate（fakeRegistry 注入预设 JSON edits，模型路由为模拟）\n *   → runValidationCase（command 型，真实 runCardProcess 跑 node -e，baseline/candidate 双侧）\n *   → evaluateCandidate（逐项判定 + 状态机推进 + 库表落账）\n *   → recordEvolutionObservation / countEvolutionObservations。\n *\n * 场景（任务书 §2）：`skill:test-skill` 的 SKILL.md 缺「步骤三: 验证输出」。\n * 三个用例各以 node -e 检查 SKILL.md 是否含对应步骤：\n * - reproduction 查步骤三：baseline（旧版）应 failed，candidate（修复后）应 passed；\n * - normal 查步骤一：两侧都 passed；\n * - holdout 查步骤二：两侧都 passed。\n *\n * 标注：proposeCandidate 的模型返回是 fakeRegistry 预设 JSON——这是模型路由\n * 机制验证，不是真实模型输出；真实改进证据待实际积累。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-e2e.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { getResource, listResources, registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { classifyProblem, collectEvolutionProblem, declareImprovementIntent, getEvolutionProblem } from \"../../src/pao/evolution/problems.ts\";\nimport { selectImprovement } from \"../../src/pao/evolution/select.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport { countEvolutionObservations, recordEvolutionObservation } from \"../../src/pao/evolution/observe.ts\";\nimport type { ValidationCase, ValidationCaseResult, ValidationRunResult } from \"../../src/pao/evolution/types.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-e2e-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\n/** 外发许可（测试注入）：proposeCandidate 的外发门要求编排显式传项目名与许可。 */\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\n/** fakeRegistry：streamSimple 返回固定 JSON——模型路由机制验证（模拟，非真实模型输出）。 */\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\nconst RESOURCE_ID = \"skill:test-skill\";\n\n/** 旧版 SKILL.md：缺「步骤三: 验证输出」（可机器检测的错误）。 */\nconst SKILL_BASELINE = \"# test-skill\\n\\n步骤一: 输入\\n步骤二: 处理\\n\";\n/** 候选修复版：补进步骤三。 */\nconst SKILL_FIXED = \"# test-skill\\n\\n步骤一: 输入\\n步骤二: 处理\\n步骤三: 验证输出\\n\";\n\n/**\n * 种一个已登记 skill 资源 + 预算配置 + 缺步骤三的 SKILL.md + baseVersion 快照。\n * 预算文件：checkMemoryJobBudget 需要 记忆后台预算.json + 总预算账.json。\n */\nfunction seedSkill(home: string, store: MemoryStore) {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", \"test-skill\");\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), SKILL_BASELINE, \"utf8\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tregisterResource(store, { kind: \"skill\", name: \"test-skill\", paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: RESOURCE_ID, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: RESOURCE_ID, baseVersion: snap.versionId, skillDir };\n}\n\n/** 种一行 sources 表记录（sourceId=src-ev-test-001），让 declareImprovementIntent 的 src- 前缀校验通过。 */\nfunction seedSource(store: MemoryStore) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t VALUES (?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\"src-ev-test-001\", \"e2e-session\", \"ev-001\", \"tool_call\", AT);\n\treturn \"src-ev-test-001\";\n}\n\n/**\n * 验收脚本内容（写进用例 initialFiles 的 check.js）：\n * 读 `resource/SKILL.md`（版本副本物化目录），含目标片段则 exit 0，否则 exit 1。\n * 验证器用 `node check.js`——命令形态干净过安检门；`node -e` 内联脚本的\n * 引号会被安检拒/被 spawn 当字面文本，不能用。\n */\nfunction checkScript(needle: string): string {\n\treturn `const fs = require(\"fs\");\\nprocess.exit(fs.readFileSync(\"resource/SKILL.md\", \"utf8\").includes(${JSON.stringify(needle)}) ? 0 : 1);\\n`;\n}\n\n/** 验证器：执行 initialFiles 里种入的 check.js。 */\nconst VERIFIER = { cmd: \"node\", args: [\"check.js\"] };\n\n/** 造一个 proposed 状态的候选（辅助断言用，不重走 proposeCandidate）。 */\nfunction seedCandidate(store: MemoryStore, over: {\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n}) {\n\tconst candidateId = \"cand-aux\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tover.testPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: SKILL_FIXED }]),\n\t\t\t\"补充缺少的步骤三\",\n\t\t\tJSON.stringify([]),\n\t\t\t\"proposed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn candidateId;\n}\n\n/** 种候选目录文件（O11/E07：runValidationCase 从 candidates/ 物化版本副本）。 */\nfunction seedCandidateDir(home: string, resourceId: string, candidateId: string, skillContent: string) {\n\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\tconst dir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(dir, { recursive: true });\n\twriteFileSync(join(dir, \"SKILL.md\"), skillContent, \"utf8\");\n\treturn dir;\n}\n\n/**\n * 跑一个冻结用例的某一侧（O11/E07）：两侧资源正文不再由 initialFiles 逐侧塞入——\n * baseline 侧 runner 从 `versions/<dirSafe>/<baseVersion>/` 物化、candidate 侧从\n * `evolution/candidates/<dirSafe>/<candidateId>/` 物化到 `workDir/resource/`；\n * check.js 读 `resource/SKILL.md`。\n */\nasync function runSide(over: {\n\tstore: MemoryStore;\n\tpaoHome: string;\n\tvalidationCase: ValidationCase;\n\tside: \"baseline\" | \"candidate\";\n\tcandidateId?: string;\n\ttestPlanId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\tneedle: string;\n\trunAt: string;\n}) {\n\tconst result = await runValidationCase(over.store, {}, {\n\t\tvalidationCase: {\n\t\t\t...over.validationCase,\n\t\t\t// 每侧 initialFiles：同一份验收脚本（check.js 由核心定义，不来自候选）；\n\t\t\t// 资源正文由版本副本物化提供，不经 initialFiles。\n\t\t\tinitialFiles: { \"check.js\": checkScript(over.needle) },\n\t\t},\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tside: over.side,\n\t\t...(over.candidateId === undefined ? {} : { candidateId: over.candidateId }),\n\t\ttestPlanId: over.testPlanId,\n\t\tpaoHome: over.paoHome,\n\t\tkind: \"command\",\n\t\tverifier: VERIFIER,\n\t\trunAt: over.runAt,\n\t});\n\tif (!result.ok) throw new Error(`runValidationCase(${over.side}) failed: ${result.error.message}`);\n\treturn result;\n}\n\n/** 组装一组用例的双侧结果条目。 */\nfunction makeCaseResult(caseId: string, baseline: ValidationRunResult, candidate: ValidationRunResult): ValidationCaseResult {\n\treturn { caseId, baseline, candidate, verdict: \"passed\" };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 全链：登记 → 快照 → 问题 → 分类 → 选择 → 冻结 → 候选 → 双侧运行 → 评估 → 观察\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"S8-13 全链机制验证（E2E）\", () => {\n\tit(\"缺步骤三的 skill 走完 登记→候选→双侧验证→评估→观察 全链 verdict=passed\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store);\n\n\t\t// ── 3. 声明问题（observed）─────────────────────────────────────────\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"test-skill 缺少步骤三\",\n\t\t\texpectedBehavior: \"SKILL.md 应含步骤三: 验证输出\",\n\t\t\tactualBehavior: \"SKILL.md 只有步骤一和步骤二\",\n\t\t\tevidenceRefs: [sourceId],\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok).toBe(true);\n\t\tif (!declared.ok) return;\n\t\texpect(declared.accepted).toBe(true);\n\t\tconst problemId = declared.problemId!;\n\t\texpect(problemId).toMatch(/^prob-/);\n\n\t\tlet statusRow = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(statusRow.status).toBe(\"observed\");\n\n\t\t// ── 4. 分类（classified；implementation_defect 保持 modify）─────────\n\t\tconst classified = classifyProblem(store, { problemId, classifiedAt: AT });\n\t\texpect(classified.ok).toBe(true);\n\t\tif (!classified.ok) return;\n\t\texpect(classified.kind).toBe(\"implementation_defect\");\n\t\tstatusRow = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(statusRow.status).toBe(\"classified\");\n\n\t\t// ── 4b. 选择（O10/E04：select 定动作，可改问题保持 classified 等冻结）─\n\t\tconst selected = selectImprovement(store, { problemId, selectedAt: AT });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"modify\");\n\t\texpect(selected.disposition).toBe(\"candidate\");\n\t\tstatusRow = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(statusRow.status).toBe(\"classified\"); // select 不抢写 candidate\n\n\t\t// ── 5. 冻结验收（三组样例；testPlanId 绑定 baseVersion）────────────\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"检查步骤三\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤三\" }],\n\t\t\tnormal: [{ input: \"检查步骤一\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤一\" }],\n\t\t\tholdout: [{ input: \"检查步骤二\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤二\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(frozen.ok).toBe(true);\n\t\tif (!frozen.ok) return;\n\t\tconst testPlanId = frozen.testPlanId;\n\t\t// 断言2：testPlanId 绑定 baseVersion；plan.json 落盘在 validations/<testPlanId>/\n\t\texpect(testPlanId).toContain(baseVersion);\n\t\texpect(frozen.planPath).toContain(\"validations\");\n\t\tconst planOnDisk = JSON.parse(readFileSync(frozen.planPath, \"utf8\")) as { testPlanId: string; baseVersion: string };\n\t\texpect(planOnDisk.testPlanId).toBe(testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\n\n\t\t// ── 6. 生成候选（fakeRegistry 预设 edits，把步骤三写进 SKILL.md）─────\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"补充缺少的步骤三\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst proposed = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\ttierConfig: TIER,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"检查步骤三\", failure: \"SKILL.md 缺少步骤三\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(proposed.ok).toBe(true);\n\t\tif (!proposed.ok) return;\n\t\texpect(proposed.status).toBe(\"changed\");\n\t\tif (proposed.status !== \"changed\") return;\n\t\tconst candidateId = proposed.candidateId;\n\n\t\t// 断言1（收尾）：problem status 沿 observed→classified→candidate 推进\n\t\tstatusRow = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(statusRow.status).toBe(\"candidate\");\n\t\t// 候选状态 proposed\n\t\tconst candRow = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(candRow.status).toBe(\"proposed\");\n\n\t\t// 断言3：候选目录存在且 SKILL.md 含步骤三（Windows 目录名 : → _）\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, \"skill_test-skill\", candidateId);\n\t\texpect(existsSync(candidateDir)).toBe(true);\n\t\tconst candidateSkill = readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\");\n\t\texpect(candidateSkill).toContain(\"步骤三\");\n\n\t\t// ── 7. 双侧运行（command 型，真实 runCardProcess 跑 node -e）────────\n\t\t// O11/E07：两侧正文不再逐侧塞 initialFiles——baseline 从 versions/<baseVersion>\n\t\t// 物化、candidate 从 candidates/<candidateId> 物化进 workDir/resource/。\n\t\tconst plan = frozen.plan;\n\t\tconst caseIds = [\n\t\t\t{ validationCase: plan.reproduction[0], needle: \"步骤三\" },\n\t\t\t{ validationCase: plan.normal[0], needle: \"步骤一\" },\n\t\t\t{ validationCase: plan.holdout[0], needle: \"步骤二\" },\n\t\t] as const;\n\t\tconst caseResults: ValidationCaseResult[] = [];\n\t\tfor (const { validationCase, needle } of caseIds) {\n\t\t\tconst baselineRun = await runSide({\n\t\t\t\tstore, paoHome: home, validationCase, needle,\n\t\t\t\tside: \"baseline\", testPlanId, resourceId, baseVersion, runAt: AT2,\n\t\t\t});\n\t\t\tconst candidateRun = await runSide({\n\t\t\t\tstore, paoHome: home, validationCase, needle,\n\t\t\t\tside: \"candidate\", candidateId, testPlanId, resourceId, baseVersion, runAt: AT3,\n\t\t\t});\n\t\t\tcaseResults.push(makeCaseResult(validationCase.caseId, baselineRun.result, candidateRun.result));\n\t\t}\n\n\t\t// 断言4/5：reproduction 组 baseline failed（前提成立）、candidate passed\n\t\tconst reproduction = caseResults.find((r) => r.caseId === \"reproduction-0\")!;\n\t\texpect(reproduction.baseline.passed).toBe(false);\n\t\texpect(reproduction.candidate.passed).toBe(true);\n\t\t// normal/holdout 双侧 passed\n\t\tfor (const r of caseResults.filter((c) => c.caseId !== \"reproduction-0\")) {\n\t\t\texpect(r.baseline.passed).toBe(true);\n\t\t\texpect(r.candidate.passed).toBe(true);\n\t\t}\n\n\t\t// 断言9：回执落盘在 evolution/validations/<testPlanId>/runs/\n\t\tconst runsDir = join(evolutionPaths(home).validations, testPlanId, \"runs\");\n\t\texpect(existsSync(runsDir)).toBe(true);\n\t\tconst receipts = readdirSync(runsDir).filter((f) => f.endsWith(\".json\"));\n\t\texpect(receipts.length).toBe(6); // 3 用例 × 双侧\n\t\texpect(receipts.some((f) => f.includes(\"reproduction-0-baseline\"))).toBe(true);\n\t\texpect(receipts.some((f) => f.includes(\"reproduction-0-candidate\"))).toBe(true);\n\n\t\t// 断言11：scratch 目录已清理（keepScratch=false 时 runs 外不留临时目录）\n\t\tconst scratchRoot = join(tmpdir(), \"pao-evolution-run\");\n\t\tconst leftovers = existsSync(scratchRoot) ? readdirSync(scratchRoot) : [];\n\t\texpect(leftovers.filter((d) => d.includes(\"reproduction-0\") || d.includes(\"normal-0\") || d.includes(\"holdout-0\"))).toHaveLength(0);\n\n\t\t// ── 8. evaluateCandidate → verdict=passed ──────────────────────────\n\t\tconst evaluated = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults,\n\t\t\ttotalUsageRef: \"req-e2e-validation\",\n\t\t\tsourceRefs: [{ sourceId }],\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(evaluated.ok).toBe(true);\n\t\tif (!evaluated.ok) return;\n\t\t// 断言6：verdict=passed，score.reproduction.passed=1\n\t\texpect(evaluated.verdict).toBe(\"passed\");\n\t\texpect(evaluated.score.reproduction.passed).toBe(1);\n\t\texpect(evaluated.score.normal.passed).toBe(1);\n\t\texpect(evaluated.score.holdout.passed).toBe(1);\n\n\t\t// 断言7：候选 status=passed；passed ≠ active（effectiveVersion 未变）\n\t\tconst candAfter = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(candAfter.status).toBe(\"passed\");\n\t\tconst resource = getResource(store, resourceId);\n\t\texpect(resource.ok).toBe(true);\n\t\tif (resource.ok) {\n\t\t\texpect(resource.effectiveVersion).toBe(baseVersion); // 仍是 baseVersion，未发布候选\n\t\t}\n\n\t\t// 断言8：evolution_validations 行写入库；source_links owner_kind='validation' 存在\n\t\tconst valRow = store.db.prepare(`SELECT verdict FROM evolution_validations WHERE candidate_id = ?`).get(candidateId) as { verdict: string };\n\t\texpect(valRow.verdict).toBe(\"passed\");\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT source_id FROM evolution_source_links WHERE owner_kind = 'validation' AND owner_id = ?`)\n\t\t\t.all(evaluated.validationId) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\n\t\t// ── 9. 观察计数：record + count 一致 ───────────────────────────────\n\t\tconst obs1 = recordEvolutionObservation(store, { action: \"viewed\", resourceId, candidateId, createdAt: AT3 });\n\t\tconst obs2 = recordEvolutionObservation(store, { action: \"used\", resourceId, versionId: baseVersion, createdAt: AT3 });\n\t\texpect(obs1.ok && obs2.ok).toBe(true);\n\t\tconst counts = countEvolutionObservations(store, { resourceId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (counts.ok) {\n\t\t\texpect(counts.persisted).toBe(true);\n\t\t\texpect(counts.counts.viewed).toBe(1);\n\t\t\texpect(counts.counts.used).toBe(1);\n\t\t\texpect(counts.counts.patched).toBe(0);\n\t\t\texpect(counts.total).toBe(2);\n\t\t}\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助断言（§5 边界场景）\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"S8-13 边界场景\", () => {\n\tit(\"资源查询与开关：listResources/getResource/setAutoEvolution\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\tconst listed = listResources(store, \"skill\");\n\t\texpect(listed.ok).toBe(true);\n\t\tif (!listed.ok) return;\n\t\texpect(listed.items.map((r) => r.resourceId)).toContain(resourceId);\n\n\t\tconst got = getResource(store, resourceId);\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.loadMethod).toBe(\"skill-path\");\n\t\texpect(got.autoEvolutionEnabled).toBe(true);\n\n\t\t// 停用后开关落库；恢复后回到 true。停用保留当前有效版，不删历史。\n\t\tconst off = setAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT2 });\n\t\texpect(off.ok).toBe(true);\n\t\tif (off.ok) expect(off.autoEvolutionEnabled).toBe(false);\n\t\tconst on = setAutoEvolution(store, { resourceId, enabled: true, updatedAt: AT3 });\n\t\texpect(on.ok).toBe(true);\n\t\tif (on.ok) expect(on.autoEvolutionEnabled).toBe(true);\n\t});\n\n\tit(\"collectEvolutionProblem：从事实来源登记问题（复用 declare 链路）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\n\t\tconst collected = collectEvolutionProblem(store, {\n\t\t\tactualBehavior: \"SKILL.md 只有步骤一和步骤二\",\n\t\t\texpectedBehavior: \"SKILL.md 应含步骤三\",\n\t\t\tsummary: \"test-skill 缺少步骤三\",\n\t\t\taction: \"modify\",\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tsourceIds: [\"src-ev-test-001\"],\n\t\t\ttoolCallId: \"tc-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(collected.ok).toBe(true);\n\t\tif (!collected.ok) return;\n\t\texpect(collected.accepted).toBe(true);\n\t\texpect(collected.problemId).toMatch(/^prob-/);\n\n\t\t// getEvolutionProblem 读回登记的事实（evidenceRefs 含 sourceId + toolcall 引用）。\n\t\tconst problem = getEvolutionProblem(store, collected.problemId!);\n\t\texpect(problem.ok).toBe(true);\n\t\tif (problem.ok) {\n\t\t\texpect(problem.status).toBe(\"observed\");\n\t\t\texpect(problem.evidenceRefs).toContain(\"src-ev-test-001\");\n\t\t\texpect(problem.evidenceRefs).toContain(\"toolcall:tc-1\");\n\t\t}\n\t});\n\n\tit(\"selectImprovement：implementation_defect + resourceId → modify 并推进到 candidate\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\t\t// 走真实登记入口到 classified，再验证 selectImprovement 的选择与状态推进。\n\t\tconst declared = declareImprovementIntent(store, {\n\t\t\tkind: \"implementation_defect\",\n\t\t\taction: \"modify\",\n\t\t\tsummary: \"test-skill 缺少步骤三\",\n\t\t\texpectedBehavior: \"SKILL.md 应含步骤三\",\n\t\t\tactualBehavior: \"SKILL.md 缺步骤三\",\n\t\t\tevidenceRefs: [\"src-ev-test-001\"],\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(declared.ok && declared.accepted).toBe(true);\n\t\tif (!declared.ok || !declared.problemId) return;\n\t\tconst classified = classifyProblem(store, { problemId: declared.problemId, classifiedAt: AT });\n\t\texpect(classified.ok).toBe(true);\n\n\t\tconst selected = selectImprovement(store, { problemId: declared.problemId, selectedAt: AT2 });\n\t\texpect(selected.ok).toBe(true);\n\t\tif (!selected.ok) return;\n\t\texpect(selected.action).toBe(\"modify\");\n\t\texpect(selected.disposition).toBe(\"candidate\");\n\t\texpect(selected.target?.resourceId).toBe(resourceId);\n\t\texpect(selected.target?.baseVersion).toBe(baseVersion);\n\t\t// O10/E04：select 保持 classified；candidate 由 proposeCandidate 推进。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(declared.problemId) as { status: string };\n\t\texpect(row.status).toBe(\"classified\");\n\t});\n\n\tit(\"reproduction baseline 也 passed → verdict=incomplete（验证前提不成立）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\t\tconst problemId = \"prob-aux-baseline-pass\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(problemId, \"implementation_defect\", \"modify\", \"x\", \"y\", \"z\",\n\t\t\t\tJSON.stringify([\"src-ev-test-001\"]), 1, resourceId, baseVersion,\n\t\t\t\t\"classified\", \"pending_classification\", AT, AT);\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"检查步骤三\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤三\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: frozen.testPlanId });\n\t\tconst validationCase = frozen.plan.reproduction[0];\n\n\t\t// baseline 侧版本目录放已含步骤三的文件——复现不了原问题（前提不成立）。\n\t\t// O11/E07：直接改 versions/<baseVersion>/ 的 SKILL.md（baseline 物化来源）。\n\t\tconst versionDir = join(evolutionPaths(home).versions, resourceId.replace(/:/g, \"_\"), baseVersion);\n\t\twriteFileSync(join(versionDir, \"SKILL.md\"), SKILL_FIXED, \"utf8\");\n\t\t// candidate 侧目录同样放修复版（本测试只关心「baseline 也过」的前提）。\n\t\tseedCandidateDir(home, resourceId, candidateId, SKILL_FIXED);\n\n\t\tconst baselineRun = await runSide({\n\t\t\tstore, paoHome: home, validationCase, needle: \"步骤三\",\n\t\t\tside: \"baseline\", testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT2,\n\t\t});\n\t\tconst candidateRun = await runSide({\n\t\t\tstore, paoHome: home, validationCase, needle: \"步骤三\",\n\t\t\tside: \"candidate\", candidateId, testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT3,\n\t\t});\n\t\texpect(baselineRun.result.passed).toBe(true);\n\t\texpect(candidateRun.result.passed).toBe(true);\n\n\t\tconst evaluated = evaluateCandidate(store, {\n\t\t\tcandidateId, testPlanId: frozen.testPlanId, paoHome: home,\n\t\t\tcaseResults: [makeCaseResult(validationCase.caseId, baselineRun.result, candidateRun.result)],\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(evaluated.ok).toBe(true);\n\t\tif (!evaluated.ok) return;\n\t\texpect(evaluated.verdict).toBe(\"incomplete\");\n\t\texpect(evaluated.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(evaluated.caseResults[0].reason).toContain(\"baseline 未复现原问题\");\n\t});\n\n\tit(\"holdout candidate failed → verdict=failed（关键失败不覆盖）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\t\tconst problemId = \"prob-aux-holdout-fail\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(problemId, \"implementation_defect\", \"modify\", \"x\", \"y\", \"z\",\n\t\t\t\tJSON.stringify([\"src-ev-test-001\"]), 1, resourceId, baseVersion,\n\t\t\t\t\"classified\", \"pending_classification\", AT, AT);\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"检查步骤三\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤三\" }],\n\t\t\tnormal: [{ input: \"检查步骤一\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤一\" }],\n\t\t\tholdout: [{ input: \"检查步骤四\", initialFiles: { \"SKILL.md\": SKILL_BASELINE }, allowedTools: [], acceptance: \"SKILL.md 含步骤四\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: frozen.testPlanId });\n\t\t// candidate 侧物化来源：candidates/<dirSafe>/<candidateId>/SKILL.md 修复版。\n\t\tseedCandidateDir(home, resourceId, candidateId, SKILL_FIXED);\n\n\t\tconst caseResults: ValidationCaseResult[] = [];\n\t\t// reproduction：修复生效\n\t\t{\n\t\t\tconst b = await runSide({ store, paoHome: home, validationCase: frozen.plan.reproduction[0], needle: \"步骤三\", side: \"baseline\", testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT2 });\n\t\t\tconst c = await runSide({ store, paoHome: home, validationCase: frozen.plan.reproduction[0], needle: \"步骤三\", side: \"candidate\", candidateId, testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT3 });\n\t\t\tcaseResults.push(makeCaseResult(\"reproduction-0\", b.result, c.result));\n\t\t}\n\t\t// normal：双侧通过\n\t\t{\n\t\t\tconst b = await runSide({ store, paoHome: home, validationCase: frozen.plan.normal[0], needle: \"步骤一\", side: \"baseline\", testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT2 });\n\t\t\tconst c = await runSide({ store, paoHome: home, validationCase: frozen.plan.normal[0], needle: \"步骤一\", side: \"candidate\", candidateId, testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT3 });\n\t\t\tcaseResults.push(makeCaseResult(\"normal-0\", b.result, c.result));\n\t\t}\n\t\t// holdout：候选也过不了（步骤四不存在于任何版本）\n\t\t{\n\t\t\tconst b = await runSide({ store, paoHome: home, validationCase: frozen.plan.holdout[0], needle: \"步骤四\", side: \"baseline\", testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT2 });\n\t\t\tconst c = await runSide({ store, paoHome: home, validationCase: frozen.plan.holdout[0], needle: \"步骤四\", side: \"candidate\", candidateId, testPlanId: frozen.testPlanId, resourceId, baseVersion, runAt: AT3 });\n\t\t\texpect(c.result.passed).toBe(false);\n\t\t\tcaseResults.push(makeCaseResult(\"holdout-0\", b.result, c.result));\n\t\t}\n\n\t\tconst evaluated = evaluateCandidate(store, {\n\t\t\tcandidateId, testPlanId: frozen.testPlanId, paoHome: home,\n\t\t\tcaseResults, createdAt: AT3,\n\t\t});\n\t\texpect(evaluated.ok).toBe(true);\n\t\tif (!evaluated.ok) return;\n\t\texpect(evaluated.verdict).toBe(\"failed\");\n\t\texpect(evaluated.score.holdout.failed).toBe(1);\n\t\t// reproduction 通过不能覆盖 holdout 关键失败\n\t\tconst cand = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(cand.status).toBe(\"failed\");\n\t});\n\n\tit(\"allowedFiles 为空时 edit.path 含 .. → 被跳过不穿透（applyEdits 修复）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tseedSource(store);\n\t\tconst problemId = \"prob-aux-escape\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(problemId, \"implementation_defect\", \"modify\", \"x\", \"y\", \"z\",\n\t\t\t\tJSON.stringify([\"src-ev-test-001\"]), 1, resourceId, baseVersion,\n\t\t\t\t\"classified\", \"pending_classification\", AT, AT);\n\t\tconst frozen = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!frozen.ok) throw new Error(\"freeze failed\");\n\n\t\t// fakeRegistry 返回含越界路径的 edits；allowedFiles 空 = 允许全部资源内文件\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"尝试越界\",\n\t\t\tedits: [\n\t\t\t\t{ path: \"../evil.txt\", action: \"create\", content: \"穿透\" },\n\t\t\t\t{ path: \"SKILL.md\", action: \"edit\", content: SKILL_FIXED },\n\t\t\t],\n\t\t});\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: fakeLedger() as never,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\ttierConfig: TIER,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId, resourceId, baseVersion, testPlanId: frozen.testPlanId,\n\t\t\tallowedFiles: [], // 空：白名单核对跳过，靠 applyEdits 兜底\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\t\tif (result.status !== \"changed\") return;\n\t\t// `../evil.txt` 被跳过：diffs 只含 SKILL.md\n\t\texpect(result.diffs).toHaveLength(1);\n\t\texpect(result.diffs[0].path).toBe(\"SKILL.md\");\n\t\t// 未穿透：候选根上一级（candidates/skill_test-skill/）下无 evil.txt\n\t\tconst parentDir = join(evolutionPaths(home).candidates, \"skill_test-skill\");\n\t\texpect(existsSync(join(parentDir, \"evil.txt\"))).toBe(false);\n\t\t// 候选目录内 SKILL.md 已改（越界跳过不影响合法编辑）\n\t\tconst candidateDir = join(parentDir, result.candidateId);\n\t\texpect(readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\")).toContain(\"步骤三\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S8-13 全链机制验证（E2E 集成测试）。\n *import { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStoreproposeCandidate } from \"../../src/pao/memoryevolutionstore.tscandidates.ts\";evolutionPathsevaluateCandidatepaths.tsevaluate.tstype { TierConfigcountEvolutionObservations,recordEvolutionObservation } from \"../../src/pao/routingconfig.tsobserve.tsgetResource, listResourcesclassifyProblem, registerResourcecollectEvolutionProblemsetAutoEvolutiondeclareImprovementIntentsnapshotResourceFilesgetEvolutionProblem } from \"../../src/pao/evolution/resources.tsproblems.tslistResourcesregisterResource, setAutoEvolutionselectImprovementrunValidationCaseselect.tsrunner.tsfreezeValidationPlanvalidation.tsValidationCase, ValidationCaseResult, ValidationRunResulttypes.tstype MemoryStore\nimport type { ValidationRunResult \n\n// ── 夹具 ────────────────────────────────────────────────────────────────\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,59]}}},{"equalLines":{"line_count":22}},{"diffOp":{"equal":{"range":[59,190]}}},{"diffOp":{"equal":{"range":[190,200]}}},{"diffOp":{"delete":{"range":[200,233]}}},{"diffOp":{"insert":{"range":[233,249]}}},{"diffOp":{"equal":{"range":[249,272]}}},{"diffOp":{"delete":{"range":[272,278]}}},{"diffOp":{"insert":{"range":[278,287]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[287,295]}}},{"diffOp":{"insert":{"range":[295,308]}}},{"diffOp":{"equal":{"range":[308,310]}}},{"diffOp":{"equal":{"range":[190,200]}}},{"diffOp":{"delete":{"range":[310,324]}}},{"diffOp":{"insert":{"range":[324,341]}}},{"diffOp":{"equal":{"range":[249,272]}}},{"diffOp":{"delete":{"range":[272,278]}}},{"diffOp":{"insert":{"range":[310,319]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[341,349]}}},{"diffOp":{"insert":{"range":[349,360]}}},{"diffOp":{"equal":{"range":[308,310]}}},{"diffOp":{"equal":{"range":[190,198]}}},{"diffOp":{"delete":{"range":[360,365]}}},{"diffOp":{"equal":{"range":[365,367]}}},{"diffOp":{"delete":{"range":[367,377]}}},{"diffOp":{"insert":{"range":[377,404]}}},{"diffOp":{"equal":{"range":[249,250]}}},{"diffOp":{"insert":{"range":[404,431]}}},{"diffOp":{"equal":{"range":[431,453]}}},{"diffOp":{"delete":{"range":[453,460]}}},{"diffOp":{"insert":{"range":[310,319]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[460,469]}}},{"diffOp":{"insert":{"range":[469,479]}}},{"diffOp":{"equal":{"range":[308,310]}}},{"diffOp":{"equal":{"range":[190,200]}}},{"diffOp":{"delete":{"range":[479,505]}}},{"diffOp":{"insert":{"range":[505,520]}}},{"diffOp":{"equal":{"range":[520,522]}}},{"diffOp":{"delete":{"range":[522,538]}}},{"diffOp":{"insert":{"range":[538,561]}}},{"diffOp":{"equal":{"ran