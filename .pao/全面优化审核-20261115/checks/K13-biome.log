"range":[785,791]}}},{"diffOp":{"equal":{"range":[791,931]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[931,940]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-deletion.test.ts"},"span":null,"sourceCode":"import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { gunzipSync } from \"node:zlib\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ToolDefinition } from \"../../src/core/extensions/types.ts\";\nimport { type SessionEntry, SessionManager, type SessionMessageEntry } from \"../../src/core/session-manager.ts\";\nimport { appendToOpenSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { renderRecallSection } from \"../../src/pao/memory/resident.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { isSourceExcluded, registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerBuiltinMemory, scopeFromContext } from \"../../src/pao/memory/tools.ts\";\nimport type { DeletionSessionCoordinator, MemoryService, SharedSourcePolicy } from \"../../src/pao/memory/types.ts\";\nimport { acquireSessionControl } from \"../../src/pao/runtime/session-lock.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-09T10:00:00.000Z\";\nconst PROJECT = \"pao-dev\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite handles can be released a few milliseconds after close on Windows.\n\t\t}\n\t}\n});\n\nfunction toolCallContent(text: string, calls: Array<{ id: string; args: Record<string, unknown> }>) {\n\tconst message = assistantMsg(text) as Record<string, unknown>;\n\tmessage.content = [\n\t\t{ type: \"text\", text },\n\t\t...calls.map((call) => ({\n\t\t\ttype: \"toolCall\",\n\t\t\tid: call.id,\n\t\t\tname: call.id === \"call-write\" ? \"pao_memory_write\" : \"bash\",\n\t\t\targuments: call.args,\n\t\t})),\n\t];\n\treturn message as never;\n}\n\nfunction makePersistentSession(home: string, id: string) {\n\tconst agentDir = join(home, \"agent\");\n\tconst sessionDir = join(agentDir, \"sessions\");\n\tconst manager = SessionManager.create(home, sessionDir, { id });\n\tmanager.appendMessage(userMsg(\"用户原始上下文:保留这一段\"));\n\tconst assistantId = manager.appendMessage(\n\t\ttoolCallContent(\"准备写入和核对\", [\n\t\t\t{ id: \"call-delete\", args: { content: \"将要彻底删除的结论甲乙丙丁\" } },\n\t\t\t{ id: \"call-keep\", args: { command: \"保留这个工具调用\" } },\n\t\t]),\n\t);\n\tconst file = manager.getSessionFile();\n\tif (!file || !existsSync(file)) throw new Error(\"真实会话文件未创建\");\n\treturn { manager, file, assistantId };\n}\n\nasync function createMemory(service: MemoryService, conclusion: string, sourceIds: string[]): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: \"decision\",\n\t\tscope: { projectId: PROJECT },\n\t\tconclusion,\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds,\n\t\tcreatedAt: AT,\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\nfunction entryMap(entries: SessionEntry[]): Map<string, SessionEntry> {\n\treturn new Map(entries.map((entry) => [entry.id, entry]));\n}\n\nfunction archiveContains(file: string, compressed: boolean, text: string): boolean {\n\tconst raw = readFileSync(file);\n\tconst content = compressed ? gunzipSync(raw).toString(\"utf8\") : raw.toString(\"utf8\");\n\treturn content.includes(text);\n}\n\ndescribe(\"真实会话与归档彻底删除\", () => {\n\tit(\"保留身份/父链/工具配对，清理源、动态注入、memory 结果、compaction 与 branch summary\", async () => {\n\t\tconst home = tempDir(\"pao-del-session-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst { manager, file, assistantId } = makePersistentSession(home, \"session-real\");\n\t\t\tconst assistant = manager.getEntry(assistantId) as SessionMessageEntry;\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tcapture.registerSession(\"session-real\", file);\n\t\t\tconst captured = capture.captureCommittedEntry(\"session-real\", assistant, \"toolcall:call-delete\", AT);\n\t\t\tconst sourceId = captured.sourceId!;\n\t\t\tconst conclusion = \"将要彻底删除的结论甲乙丙丁\";\n\t\t\tconst memoryId = await createMemory(service, conclusion, [sourceId]);\n\n\t\t\tconst autoRecallId = manager.appendCustomMessageEntry(\n\t\t\t\t\"pao-auto-recall\",\n\t\t\t\t`召回 ${memoryId}\\n${conclusion}`,\n\t\t\t\tfalse,\n\t\t\t);\n\t\t\tconst targetResultId = manager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-delete\",\n\t\t\t\ttoolName: \"pao_memory_write\",\n\t\t\t\tcontent: [{ type: \"text\", text: `已写入 ${memoryId}: ${conclusion}` }],\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\tconst unrelatedResultId = manager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-keep\",\n\t\t\t\ttoolName: \"bash\",\n\t\t\t\tcontent: [{ type: \"text\", text: \"无关工具回执必须保留\" }],\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\tconst compactionId = manager.appendCompaction(`压缩摘要提到 ${memoryId} 与 ${conclusion}`, null, 100);\n\t\t\tconst branchSummaryId = manager.branchWithSummary(\n\t\t\t\tmanager.getLeafId(),\n\t\t\t\t`分支摘要提到 ${memoryId} 与 ${conclusion}`,\n\t\t\t);\n\t\t\tconst unrelatedId = manager.appendMessage(userMsg(\"无关后续内容必须保留\"));\n\n\t\t\tconst beforeEntries = manager.getEntries();\n\t\t\tconst beforeById = entryMap(beforeEntries);\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\texpect(preview.sources).toEqual([\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\tsourceId,\n\t\t\t\t\tsessionId: \"session-real\",\n\t\t\t\t\tentryId: assistantId,\n\t\t\t\t\teventType: \"toolcall:call-delete\",\n\t\t\t\t\tresolution: \"session\",\n\t\t\t\t\taction: \"redact\",\n\t\t\t\t}),\n\t\t\t]);\n\t\t\texpect(preview.sessions[0]).toMatchObject({\n\t\t\t\tsessionId: \"session-real\",\n\t\t\t\tsessionFile: file,\n\t\t\t\tsourceEntryIds: [assistantId],\n\t\t\t});\n\t\t\texpect(preview.sessions[0]?.derivedEntryIds).toEqual(\n\t\t\t\texpect.arrayContaining([autoRecallId, targetResultId, compactionId, branchSummaryId]),\n\t\t\t);\n\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-real\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(deleted.pendingObjects).toEqual([]);\n\n\t\t\tconst afterById = entryMap(SessionManager.open(file).getEntries());\n\t\t\tfor (const [id, before] of beforeById) {\n\t\t\t\tconst after = afterById.get(id);\n\t\t\t\texpect(after, `条目 ${id} 必须保留`).toBeDefined();\n\t\t\t\texpect(after?.parentId).toBe(before.parentId);\n\t\t\t\texpect(after?.timestamp).toBe(before.timestamp);\n\t\t\t\texpect(after?.type).toBe(before.type);\n\t\t\t}\n\t\t\tconst assistantAfter = afterById.get(assistantId) as SessionMessageEntry;\n\t\t\texpect((assistantAfter.message as { content: unknown[] }).content).toEqual(\n\t\t\t\texpect.arrayContaining([\n\t\t\t\t\texpect.objectContaining({ type: \"toolCall\", id: \"call-delete\", arguments: {} }),\n\t\t\t\t\texpect.objectContaining({\n\t\t\t\t\t\ttype: \"toolCall\",\n\t\t\t\t\t\tid: \"call-keep\",\n\t\t\t\t\t\targuments: { command: \"保留这个工具调用\" },\n\t\t\t\t\t}),\n\t\t\t\t]),\n\t\t\t);\n\t\t\texpect(JSON.stringify(afterById.get(autoRecallId))).not.toContain(conclusion);\n\t\t\texpect(JSON.stringify(afterById.get(targetResultId))).not.toContain(memoryId);\n\t\t\texpect(JSON.stringify(afterById.get(compactionId))).not.toContain(conclusion);\n\t\t\texpect(JSON.stringify(afterById.get(branchSummaryId))).not.toContain(conclusion);\n\t\t\texpect(JSON.stringify(afterById.get(unrelatedResultId))).toContain(\"无关工具回执必须保留\");\n\t\t\texpect(JSON.stringify(afterById.get(unrelatedId))).toContain(\"无关后续内容必须保留\");\n\t\t\texpect(JSON.stringify(afterById.get(targetResultId))).toContain('\"toolCallId\":\"call-delete\"');\n\t\t\texpect(JSON.stringify(afterById.get(unrelatedResultId))).toContain('\"toolCallId\":\"call-keep\"');\n\n\t\t\tconst sourceSegment = store.db\n\t\t\t\t.prepare(\"SELECT original_path, compressed_path FROM archive_segments WHERE session_id = ?\")\n\t\t\t\t.get(\"session-real\") as { original_path: string; compressed_path: string | null };\n\t\t\tconst archivePath = sourceSegment.compressed_path ?? sourceSegment.original_path;\n\t\t\texpect(archiveContains(archivePath, sourceSegment.compressed_path !== null, \"将要彻底删除\")).toBe(false);\n\t\t\texpect(archiveContains(archivePath, sourceSegment.compressed_path !== null, \"保留这个工具调用\")).toBe(true);\n\n\t\t\tconst operation = await service.readDeletionOperation({ operationId: deleted.operationId });\n\t\t\texpect(operation.ok && operation.status).toBe(\"complete\");\n\t\t\texpect(JSON.stringify(operation)).not.toContain(conclusion);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"按真实父链清理来源回复及 archive，保留同一会话的无关用户消息\", async () => {\n\t\tconst home = tempDir(\"pao-del-source-replies-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst body = \"text-embedding-3-small\";\n\t\t\tconst firstManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-source-replies-one\",\n\t\t\t});\n\t\t\tconst firstUser = firstManager.appendMessage(userMsg(`嵌入模型用 ${body}。`));\n\t\t\tconst firstReply = firstManager.appendMessage(assistantMsg(`已记录：嵌入模型用 ${body}。`));\n\t\t\tconst firstUnrelated = firstManager.appendMessage(userMsg(\"保留第一条无关用户消息。\"));\n\t\t\tconst firstFile = firstManager.getSessionFile()!;\n\n\t\t\tconst secondManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-source-replies-two\",\n\t\t\t});\n\t\t\tconst secondUser = secondManager.appendMessage(userMsg(\"恢复刚才的嵌入模型决定。\"));\n\t\t\tconst secondReply = secondManager.appendMessage(assistantMsg(`已恢复：嵌入模型使用 ${body}。`));\n\t\t\tconst secondUnrelated = secondManager.appendMessage(userMsg(\"保留第二条无关用户消息。\"));\n\t\t\tconst secondFile = secondManager.getSessionFile()!;\n\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tcapture.registerSession(\"session-source-replies-one\", firstFile);\n\t\t\tconst firstCaptured = capture.captureCommittedEntries(\n\t\t\t\t\"session-source-replies-one\",\n\t\t\t\tfirstManager.getEntries(),\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tcapture.registerSession(\"session-source-replies-two\", secondFile);\n\t\t\tconst secondCaptured = capture.captureCommittedEntries(\n\t\t\t\t\"session-source-replies-two\",\n\t\t\t\tsecondManager.getEntries(),\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tconst sourceFor = (captured: ReturnType<typeof capture.captureCommittedEntries>, entryId: string): string => {\n\t\t\t\tconst sourceId = captured.find((entry) => entry.entryId === entryId)?.sourceId;\n\t\t\t\tif (!sourceId) throw new Error(`来源未采集:${entryId}`);\n\t\t\t\treturn sourceId;\n\t\t\t};\n\t\t\tconst memoryId = await createMemory(service, `嵌入模型使用 ${body}`, [\n\t\t\t\tsourceFor(firstCaptured, firstUser),\n\t\t\t\tsourceFor(secondCaptured, secondUser),\n\t\t\t]);\n\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\texpect(preview.sessions.find((session) => session.sessionId === \"session-source-replies-one\")).toMatchObject({\n\t\t\t\tsourceEntryIds: [firstUser],\n\t\t\t\tderivedEntryIds: [firstReply],\n\t\t\t});\n\t\t\texpect(preview.sessions.find((session) => session.sessionId === \"session-source-replies-two\")).toMatchObject({\n\t\t\t\tsourceEntryIds: [secondUser],\n\t\t\t\tderivedEntryIds: [secondReply],\n\t\t\t});\n\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-source-replies-two\", entryId: secondUnrelated },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\", pendingObjects: [] });\n\n\t\t\tconst firstAfter = entryMap(SessionManager.open(firstFile).getEntries());\n\t\t\tconst secondAfter = entryMap(SessionManager.open(secondFile).getEntries());\n\t\t\texpect(JSON.stringify(firstAfter.get(firstUser))).not.toContain(body);\n\t\t\texpect(JSON.stringify(firstAfter.get(firstReply))).not.toContain(body);\n\t\t\texpect(JSON.stringify(secondAfter.get(secondUser))).not.toContain(body);\n\t\t\texpect(JSON.stringify(secondAfter.get(secondReply))).not.toContain(body);\n\t\t\texpect(JSON.stringify(firstAfter.get(firstUnrelated))).toContain(\"保留第一条无关用户消息\");\n\t\t\texpect(JSON.stringify(secondAfter.get(secondUnrelated))).toContain(\"保留第二条无关用户消息\");\n\t\t\texpect(firstAfter.get(firstReply)?.parentId).toBe(firstUser);\n\t\t\texpect(secondAfter.get(secondReply)?.parentId).toBe(secondUser);\n\n\t\t\tconst segments = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT session_id, original_path, compressed_path\n\t\t\t\t\t FROM archive_segments\n\t\t\t\t\t WHERE session_id IN (?, ?)\n\t\t\t\t\t ORDER BY session_id`,\n\t\t\t\t)\n\t\t\t\t.all(\"session-source-replies-one\", \"session-source-replies-two\") as unknown as Array<{\n\t\t\t\tsession_id: string;\n\t\t\t\toriginal_path: string;\n\t\t\t\tcompressed_path: string | null;\n\t\t\t}>;\n\t\t\tfor (const segment of segments) {\n\t\t\t\tconst archivePath = segment.compressed_path ?? segment.original_path;\n\t\t\t\texpect(archiveContains(archivePath, segment.compressed_path !== null, body)).toBe(false);\n\t\t\t}\n\t\t\tconst firstArchive = segments.find((segment) => segment.session_id === \"session-source-replies-one\")!;\n\t\t\tconst secondArchive = segments.find((segment) => segment.session_id === \"session-source-replies-two\")!;\n\t\t\texpect(\n\t\t\t\tarchiveContains(\n\t\t\t\t\tfirstArchive.compressed_path ?? firstArchive.original_path,\n\t\t\t\t\tfirstArchive.compressed_path !== null,\n\t\t\t\t\t\"保留第一条无关用户消息\",\n\t\t\t\t),\n\t\t\t).toBe(true);\n\t\t\texpect(\n\t\t\t\tarchiveContains(\n\t\t\t\t\tsecondArchive.compressed_path ?? secondArchive.original_path,\n\t\t\t\t\tsecondArchive.compressed_path !== null,\n\t\t\t\t\t\"保留第二条无关用户消息\",\n\t\t\t\t),\n\t\t\t).toBe(true);\n\t\t\tconst databaseText = JSON.stringify([\n\t\t\t\t...store.db.prepare(\"SELECT * FROM memories\").all(),\n\t\t\t\t...store.db.prepare(\"SELECT * FROM memory_revisions\").all(),\n\t\t\t\t...store.db.prepare(\"SELECT * FROM memory_fts\").all(),\n\t\t\t\t...store.db.prepare(\"SELECT * FROM memory_vectors\").all(),\n\t\t\t\t...store.db.prepare(\"SELECT * FROM sources\").all(),\n\t\t\t]);\n\t\t\texpect(databaseText).not.toContain(body);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"从可信会话登记清理跨会话召回与旧修订派生正文，检索未注入不扩展范围\", async () => {\n\t\tconst home = tempDir(\"pao-del-cross-session-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tlet control: Awaited<ReturnType<typeof acquireSessionControl>> | undefined;\n\t\ttry {\n\t\t\tconst sourceManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-source\",\n\t\t\t});\n\t\t\tconst sourceEntryId = sourceManager.appendMessage(userMsg(\"来源会话原文:旧结论是跨会话派生删除甲乙丙丁\"));\n\t\t\tconst sourceFile = sourceManager.getSessionFile()!;\n\t\t\tconst sourceCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsourceCapture.registerSession(\"session-source\", sourceFile);\n\t\t\tconst sourceEntry = sourceManager.getEntry(sourceEntryId)!;\n\t\t\tconst sourceId = sourceCapture.captureCommittedEntry(\"session-source\", sourceEntry, undefined, AT).sourceId!;\n\n\t\t\tconst oldConclusion = \"旧结论是跨会话派生删除甲乙丙丁\";\n\t\t\tconst currentConclusion = \"当前结论已更正为跨会话清理戊己庚辛\";\n\t\t\tconst keeperOne = \"同批召回保留的无关事实甲\";\n\t\t\tconst keeperOneId = \"keeper-recall-one\";\n\t\t\tconst keeperTwo = \"同批召回保留的无关事实乙\";\n\t\t\tconst keeperTwoId = \"keeper-recall-two\";\n\t\t\tconst memoryId = await createMemory(service, oldConclusion, [sourceId]);\n\n\t\t\tconst recallManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-recall\",\n\t\t\t});\n\t\t\tconst recallFile = recallManager.getSessionFile()!;\n\t\t\tconst recallCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\trecallManager.appendMessage(userMsg(\"召回会话的用户问题\"));\n\t\t\tconst automaticHits = [\n\t\t\t\t{ 记忆ID: memoryId, 修订号: 1, 内容: oldConclusion, 来源: \"内置记忆库\" },\n\t\t\t\t{ 记忆ID: keeperOneId, 修订号: 1, 内容: keeperOne, 来源: \"内置记忆库\" },\n\t\t\t\t{ 记忆ID: keeperTwoId, 修订号: 1, 内容: keeperTwo, 来源: \"内置记忆库\" },\n\t\t\t];\n\t\t\tconst autoRecallId = recallManager.appendCustomMessageEntry(\n\t\t\t\t\"pao-auto-recall\",\n\t\t\t\trenderRecallSection(automaticHits),\n\t\t\t\tfalse,\n\t\t\t\t{\n\t\t\t\t\tvendor: \"builtin\",\n\t\t\t\t\thits: automaticHits,\n\t\t\t\t},\n\t\t\t);\n\t\t\tconst recallCallMessage = assistantMsg(\"准备手动召回\") as Record<string, unknown>;\n\t\t\trecallCallMessage.content = [\n\t\t\t\t{ type: \"text\", text: \"准备手动召回\" },\n\t\t\t\t{ type: \"toolCall\", id: \"call-recall\", name: \"pao_memory_recall\", arguments: { query: \"召回目标\" } },\n\t\t\t];\n\t\t\trecallCallMessage.stopReason = \"toolUse\";\n\t\t\tconst recallCallId = recallManager.appendMessage(recallCallMessage as never);\n\t\t\tconst manualHits = [\n\t\t\t\t{ 记忆ID: memoryId, 修订号: 1, 内容: oldConclusion, 来源: \"内置记忆库\" },\n\t\t\t\t{ 记忆ID: keeperOneId, 修订号: 1, 内容: keeperOne, 来源: \"内置记忆库\" },\n\t\t\t];\n\t\t\tconst manualRecallId = recallManager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-recall\",\n\t\t\t\ttoolName: \"pao_memory_recall\",\n\t\t\t\tcontent: [\n\t\t\t\t\t{\n\t\t\t\t\t\ttype: \"text\",\n\t\t\t\t\t\ttext: [\n\t\t\t\t\t\t\t\"召回 2 条(供应商召回所得,非用户输入;防污染标注照 §18.4):\",\n\t\t\t\t\t\t\t...manualHits.map((hit, index) => `${index + 1}. ${hit.内容}(记忆ID ${hit.记忆ID}｜${hit.来源})`),\n\t\t\t\t\t\t].join(\"\\n\"),\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\tdetails: {\n\t\t\t\t\tprovider: \"builtin\",\n\t\t\t\t\tmemories: manualHits,\n\t\t\t\t},\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\trecallCapture.registerSession(\"session-recall\", recallFile);\n\t\t\trecallCapture.captureCommittedEntry(\"session-recall\", recallManager.getEntry(recallCallId)!, undefined, AT);\n\t\t\trecallCapture.captureCommittedEntry(\"session-recall\", recallManager.getEntry(autoRecallId)!, undefined, AT);\n\t\t\trecallCapture.captureCommittedEntry(\"session-recall\", recallManager.getEntry(manualRecallId)!, undefined, AT);\n\t\t\tconst unrelatedResultId = recallManager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-unrelated\",\n\t\t\t\ttoolName: \"bash\",\n\t\t\t\tcontent: [{ type: \"text\", text: \"召回会话里的无关工具回执\" }],\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\trecallCapture.captureCommittedEntry(\n\t\t\t\t\"session-recall\",\n\t\t\t\trecallManager.getEntry(unrelatedResultId)!,\n\t\t\t\tundefined,\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tconst oldCompactionId = recallManager.appendCompaction(oldConclusion, null, 100);\n\t\t\tconst oldBranchSummaryId = recallManager.branchWithSummary(recallManager.getLeafId(), oldConclusion);\n\t\t\tconst unrelatedTailId = recallManager.appendMessage(userMsg(\"召回会话里的无关后续\"));\n\n\t\t\tconst taskManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-task-snapshot\",\n\t\t\t});\n\t\t\tconst taskFile = taskManager.getSessionFile()!;\n\t\t\ttaskManager.appendMessage(userMsg(\"任务快照会话\"));\n\t\t\tconst taskCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\ttaskCapture.registerSession(\"session-task-snapshot\", taskFile);\n\t\t\tconst taskSnapshotId = taskManager.appendCustomEntry(\"pao-task-snapshot\", {\n\t\t\t\titems: [{ entryId: sourceEntryId, kind: \"source\" }],\n\t\t\t});\n\n\t\t\tconst searchManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-search-only\",\n\t\t\t});\n\t\t\tconst searchFile = searchManager.getSessionFile()!;\n\t\t\tconst searchEntryId = searchManager.appendMessage(userMsg(\"仅检索未注入的无关会话正文\"));\n\t\t\tconst searchCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsearchCapture.registerSession(\"session-search-only\", searchFile);\n\t\t\tsearchCapture.captureCommittedEntry(\n\t\t\t\t\"session-search-only\",\n\t\t\t\tsearchManager.getEntry(searchEntryId)!,\n\t\t\t\tundefined,\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tconst searched = await service.searchMemory({\n\t\t\t\tscope: { projectId: PROJECT, sessionId: \"session-search-only\" },\n\t\t\t\tquery: oldConclusion,\n\t\t\t\tmode: \"current\",\n\t\t\t});\n\t\t\texpect(searched.ok).toBe(true);\n\t\t\texpect(\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"SELECT action FROM memory_usage WHERE memory_id = ? AND session_id = ?\")\n\t\t\t\t\t.all(memoryId, \"session-search-only\"),\n\t\t\t).toEqual([{ action: \"search\" }]);\n\n\t\t\tconst corrected = await service.correctMemory({\n\t\t\t\tid: memoryId,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: currentConclusion,\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t},\n\t\t\t\tsource: { sessionId: \"session-recall\" },\n\t\t\t\tcreatedAt: \"2026-11-09T10:01:00.000Z\",\n\t\t\t});\n\t\t\texpect(corrected).toMatchObject({ ok: true, revision: 2 });\n\t\t\texpect(\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"SELECT COUNT(*) AS count FROM memory_usage WHERE memory_id = ? AND session_id = ?\")\n\t\t\t\t\t.get(memoryId, \"session-recall\"),\n\t\t\t).toEqual({ count: 0 });\n\t\t\texpect(\n\t\t\t\tstore.db.prepare(\"SELECT session_file FROM memory_sessions WHERE session_id = ?\").get(\"session-recall\"),\n\t\t\t).toEqual({ session_file: recallFile });\n\t\t\texpect(JSON.stringify(SessionManager.open(recallFile).getEntry(autoRecallId))).toContain(memoryId);\n\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\texpect(preview.sessions.map((session) => session.sessionId).sort()).toEqual([\n\t\t\t\t\"session-recall\",\n\t\t\t\t\"session-source\",\n\t\t\t\t\"session-task-snapshot\",\n\t\t\t]);\n\t\t\tconst recallImpact = preview.sessions.find((session) => session.sessionId === \"session-recall\");\n\t\t\texpect(recallImpact?.derivedEntryIds).toEqual(\n\t\t\t\texpect.arrayContaining([autoRecallId, manualRecallId, oldCompactionId, oldBranchSummaryId]),\n\t\t\t);\n\t\t\texpect(preview.sessions.some((session) => session.sessionId === \"session-search-only\")).toBe(false);\n\n\t\t\tcontrol = await acquireSessionControl({\n\t\t\t\tpaoHome: home,\n\t\t\t\tsessionId: \"session-recall\",\n\t\t\t\tsurface: \"foreign-writer\",\n\t\t\t});\n\t\t\tconst pending = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 2 },\n\t\t\t\tsource: { sessionId: \"session-recall\" },\n\t\t\t});\n\t\t\texpect(pending).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\tif (!pending.ok) return;\n\t\t\texpect(pending.sessions.map((session) => session.sessionId).sort()).toEqual([\n\t\t\t\t\"session-recall\",\n\t\t\t\t\"session-source\",\n\t\t\t\t\"session-task-snapshot\",\n\t\t\t]);\n\t\t\texpect(pending.pendingObjects).toEqual(\n\t\t\t\texpect.arrayContaining([expect.objectContaining({ kind: \"session\", sessionId: \"session-recall\" })]),\n\t\t\t);\n\t\t\texpect(readFileSync(recallFile, \"utf8\")).toContain(oldConclusion);\n\t\t\tconst persisted = store.db\n\t\t\t\t.prepare(\"SELECT scope_json FROM deletion_operations WHERE operation_id = ?\")\n\t\t\t\t.get(pending.operationId) as { scope_json: string };\n\t\t\texpect(JSON.parse(persisted.scope_json)).toMatchObject({\n\t\t\t\tplan: {\n\t\t\t\t\tdatabaseDone: false,\n\t\t\t\t\tsessions: expect.arrayContaining([\n\t\t\t\t\t\texpect.objectContaining({\n\t\t\t\t\t\t\tsessionId: \"session-recall\",\n\t\t\t\t\t\t\tderivedEntryIds: expect.arrayContaining([autoRecallId, oldCompactionId, oldBranchSummaryId]),\n\t\t\t\t\t\t}),\n\t\t\t\t\t]),\n\t\t\t\t},\n\t\t\t});\n\n\t\t\tawait control.release();\n\t\t\tcontrol = undefined;\n\t\t\tconst resumed = await service.resumeDeletion({ operationId: pending.operationId });\n\t\t\texpect(resumed).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tif (!resumed.ok) return;\n\t\t\texpect(resumed.pendingObjects).toEqual([]);\n\n\t\t\tconst sourceAfter = entryMap(SessionManager.open(sourceFile).getEntries());\n\t\t\tconst recallAfter = entryMap(SessionManager.open(recallFile).getEntries());\n\t\t\tconst taskAfter = entryMap(SessionManager.open(taskFile).getEntries());\n\t\t\tconst searchAfter = entryMap(SessionManager.open(searchFile).getEntries());\n\t\t\texpect(JSON.stringify(sourceAfter.get(sourceEntryId))).not.toContain(oldConclusion);\n\t\t\tfor (const id of [autoRecallId, manualRecallId, oldCompactionId, oldBranchSummaryId]) {\n\t\t\t\tconst serialized = JSON.stringify(recallAfter.get(id));\n\t\t\t\texpect(serialized).not.toContain(oldConclusion);\n\t\t\t\texpect(serialized).not.toContain(memoryId);\n\t\t\t}\n\t\t\texpect(JSON.stringify(recallAfter.get(autoRecallId))).toContain(keeperOne);\n\t\t\texpect(JSON.stringify(recallAfter.get(autoRecallId))).toContain(keeperTwo);\n\t\t\texpect(JSON.stringify(recallAfter.get(autoRecallId))).toContain(keeperOneId);\n\t\t\texpect(JSON.stringify(recallAfter.get(autoRecallId))).toContain(keeperTwoId);\n\t\t\texpect(JSON.stringify(recallAfter.get(manualRecallId))).toContain(keeperOne);\n\t\t\texpect(JSON.stringify(recallAfter.get(manualRecallId))).toContain('\"toolCallId\":\"call-recall\"');\n\t\t\texpect(JSON.stringify(recallAfter.get(recallCallId))).toContain('\"id\":\"call-recall\"');\n\t\t\texpect(JSON.stringify(recallAfter.get(unrelatedResultId))).toContain(\"召回会话里的无关工具回执\");\n\t\t\texpect(JSON.stringify(recallAfter.get(unrelatedTailId))).toContain(\"召回会话里的无关后续\");\n\t\t\texpect(JSON.stringify(taskAfter.get(taskSnapshotId))).not.toContain(sourceEntryId);\n\t\t\texpect(JSON.stringify(taskAfter.get(taskSnapshotId))).toContain('\"data\":{\"redacted\":true}');\n\t\t\texpect(JSON.stringify(searchAfter.get(searchEntryId))).toContain(\"仅检索未注入的无关会话正文\");\n\n\t\t\tconst segments = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT session_id, original_path, compressed_path\n\t\t\t\t\t FROM archive_segments ORDER BY session_id, segment_id`,\n\t\t\t\t)\n\t\t\t\t.all() as unknown as Array<{\n\t\t\t\tsession_id: string;\n\t\t\t\toriginal_path: string;\n\t\t\t\tcompressed_path: string | null;\n\t\t\t}>;\n\t\t\tconst leakedArchiveText: Array<{ sessionId: string; text: string }> = [];\n\t\t\tfor (const segment of segments) {\n\t\t\t\tconst archivePath = segment.compressed_path ?? segment.original_path;\n\t\t\t\tfor (const removedText of [oldConclusion, currentConclusion, memoryId]) {\n\t\t\t\t\tif (archiveContains(archivePath, segment.compressed_path !== null, removedText)) {\n\t\t\t\t\t\tleakedArchiveText.push({ sessionId: segment.session_id, text: removedText });\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\texpect(leakedArchiveText).toEqual([]);\n\t\t\tconst recallArchive = segments.find((segment) => segment.session_id === \"session-recall\")!;\n\t\t\tconst recallArchivePath = recallArchive.compressed_path ?? recallArchive.original_path;\n\t\t\texpect(archiveContains(recallArchivePath, recallArchive.compressed_path !== null, \"无关工具回执\")).toBe(true);\n\t\t\tconst searchArchive = segments.find((segment) => segment.session_id === \"session-search-only\")!;\n\t\t\tconst searchArchivePath = searchArchive.compressed_path ?? searchArchive.original_path;\n\t\t\texpect(archiveContains(searchArchivePath, searchArchive.compressed_path !== null, \"仅检索未注入\")).toBe(true);\n\t\t} finally {\n\t\t\tawait control?.release().catch(() => undefined);\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"已登记会话 JSONL 删除后仍从受管归档清理无 usage 的跨会话召回\", async () => {\n\t\tconst home = tempDir(\"pao-del-deleted-recall-session-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst sourceManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-deleted-recall-source\",\n\t\t\t});\n\t\t\tconst sourceEntryId = sourceManager.appendMessage(userMsg(\"已删会话归档来源:旧事实庚辛壬癸子丑\"));\n\t\t\tconst sourceFile = sourceManager.getSessionFile()!;\n\t\t\tconst sourceCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsourceCapture.registerSession(\"session-deleted-recall-source\", sourceFile);\n\t\t\tconst sourceEntry = sourceManager.getEntry(sourceEntryId)!;\n\t\t\tconst sourceId = sourceCapture.captureCommittedEntry(\n\t\t\t\t\"session-deleted-recall-source\",\n\t\t\t\tsourceEntry,\n\t\t\t\tundefined,\n\t\t\t\tAT,\n\t\t\t).sourceId!;\n\t\t\tconst oldConclusion = \"旧事实庚辛壬癸子丑\";\n\t\t\tconst currentConclusion = \"当前事实子丑寅卯\";\n\t\t\tconst memoryId = await createMemory(service, oldConclusion, [sourceId]);\n\n\t\t\tconst recallManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-deleted-recall\",\n\t\t\t});\n\t\t\tconst recallFile = recallManager.getSessionFile()!;\n\t\t\tconst recallCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\trecallManager.appendMessage(userMsg(\"已删会话里的用户问题\"));\n\t\t\trecallCapture.registerSession(\"session-deleted-recall\", recallFile);\n\t\t\tconst keeper = \"已删会话归档里的无关保留事实\";\n\t\t\tconst keeperId = \"keeper-deleted-session\";\n\t\t\tconst autoRecallId = recallManager.appendCustomMessageEntry(\n\t\t\t\t\"pao-auto-recall\",\n\t\t\t\trenderRecallSection([\n\t\t\t\t\t{ 记忆ID: memoryId, 修订号: 1, 内容: oldConclusion, 来源: \"内置记忆库\" },\n\t\t\t\t\t{ 记忆ID: keeperId, 修订号: 1, 内容: keeper, 来源: \"内置记忆库\" },\n\t\t\t\t]),\n\t\t\t\tfalse,\n\t\t\t\t{\n\t\t\t\t\tvendor: \"builtin\",\n\t\t\t\t\thits: [\n\t\t\t\t\t\t{ 记忆ID: memoryId, 修订号: 1, 内容: oldConclusion, 来源: \"内置记忆库\" },\n\t\t\t\t\t\t{ 记忆ID: keeperId, 修订号: 1, 内容: keeper, 来源: \"内置记忆库\" },\n\t\t\t\t\t],\n\t\t\t\t},\n\t\t\t);\n\t\t\tconst manualRecallId = recallManager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-deleted-recall\",\n\t\t\t\ttoolName: \"pao_memory_recall\",\n\t\t\t\tcontent: [{ type: \"text\", text: `召回 ${oldConclusion}\\n保留 ${keeper}` }],\n\t\t\t\tdetails: {\n\t\t\t\t\tprovider: \"builtin\",\n\t\t\t\t\tmemories: [\n\t\t\t\t\t\t{ 记忆ID: memoryId, 修订号: 1, 内容: oldConclusion, 来源: \"内置记忆库\" },\n\t\t\t\t\t\t{ 记忆ID: keeperId, 修订号: 1, 内容: keeper, 来源: \"内置记忆库\" },\n\t\t\t\t\t],\n\t\t\t\t},\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\trecallCapture.captureCommittedEntry(\n\t\t\t\t\"session-deleted-recall\",\n\t\t\t\trecallManager.getEntry(autoRecallId)!,\n\t\t\t\tundefined,\n\t\t\t\tAT,\n\t\t\t);\n\t\t\trecallCapture.captureCommittedEntry(\n\t\t\t\t\"session-deleted-recall\",\n\t\t\t\trecallManager.getEntry(manualRecallId)!,\n\t\t\t\tundefined,\n\t\t\t\tAT,\n\t\t\t);\n\t\t\texpect(existsSync(recallFile)).toBe(true);\n\t\t\texpect(\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"SELECT COUNT(*) AS count FROM memory_usage WHERE memory_id = ? AND session_id = ?\")\n\t\t\t\t\t.get(memoryId, \"session-deleted-recall\"),\n\t\t\t).toEqual({ count: 0 });\n\n\t\t\tconst corrected = await service.correctMemory({\n\t\t\t\tid: memoryId,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: currentConclusion,\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t},\n\t\t\t\tsource: { sessionId: \"session-deleted-recall\" },\n\t\t\t\tcreatedAt: \"2026-11-09T10:02:00.000Z\",\n\t\t\t});\n\t\t\texpect(corrected).toMatchObject({ ok: true, revision: 2 });\n\t\t\texpect(existsSync(recallFile)).toBe(true);\n\n\t\t\trmSync(recallFile);\n\t\t\texpect(existsSync(recallFile)).toBe(false);\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\tconst deletedSession = preview.sessions.find((session) => session.sessionId === \"session-deleted-recall\");\n\t\t\texpect(deletedSession).toMatchObject({\n\t\t\t\tderivedEntryIds: expect.arrayContaining([autoRecallId, manualRecallId]),\n\t\t\t});\n\t\t\texpect(deletedSession?.reason).toContain(\"已确认无需重写\");\n\t\t\texpect(\n\t\t\t\tpreview.pendingObjects.some(\n\t\t\t\t\t(item) => item.kind === \"session\" && item.sessionId === \"session-deleted-recall\",\n\t\t\t\t),\n\t\t\t).toBe(false);\n\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 2 },\n\t\t\t\tsource: { sessionId: \"memory-deletion\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(deleted.pendingObjects).toEqual([]);\n\t\t\texpect(existsSync(recallFile)).toBe(false);\n\t\t\texpect(JSON.stringify(SessionManager.open(sourceFile).getEntries())).not.toContain(oldConclusion);\n\t\t\texpect(JSON.stringify(SessionManager.open(sourceFile).getEntries())).not.toContain(memoryId);\n\n\t\t\tconst segments = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT session_id, original_path, compressed_path\n\t\t\t\t\t FROM archive_segments ORDER BY session_id, segment_id`,\n\t\t\t\t)\n\t\t\t\t.all() as unknown as Array<{\n\t\t\t\tsession_id: string;\n\t\t\t\toriginal_path: string;\n\t\t\t\tcompressed_path: string | null;\n\t\t\t}>;\n\t\t\tconst leakedArchiveText: Array<{ sessionId: string; text: string }> = [];\n\t\t\tfor (const segment of segments) {\n\t\t\t\tconst archivePath = segment.compressed_path ?? segment.original_path;\n\t\t\t\tfor (const removedText of [oldConclusion, currentConclusion, memoryId]) {\n\t\t\t\t\tif (archiveContains(archivePath, segment.compressed_path !== null, removedText)) {\n\t\t\t\t\t\tleakedArchiveText.push({ sessionId: segment.session_id, text: removedText });\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\texpect(leakedArchiveText).toEqual([]);\n\t\t\tconst recallArchive = segments.find((segment) => segment.session_id === \"session-deleted-recall\")!;\n\t\t\tconst recallArchivePath = recallArchive.compressed_path ?? recallArchive.original_path;\n\t\t\texpect(archiveContains(recallArchivePath, recallArchive.compressed_path !== null, keeper)).toBe(true);\n\t\t\texpect(\n\t\t\t\tarchiveContains(\n\t\t\t\t\trecallArchivePath,\n\t\t\t\t\trecallArchive.compressed_path !== null,\n\t\t\t\t\t'\"toolCallId\":\"call-deleted-recall\"',\n\t\t\t\t),\n\t\t\t).toBe(true);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"共享来源 retain 后另一记忆可检索，目标记忆被排除且同来源重提炼被拒绝\", async () => {\n\t\tconst home = tempDir(\"pao-del-shared-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-shared\" });\n\t\t\tmanager.appendMessage(userMsg(\"共享来源原文:两种独立结论来自同一证据\"));\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-shared\",\n\t\t\t\tentryId: manager.getLeafId()!,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst targetId = await createMemory(service, \"共享来源目标记忆删除标记甲乙\", [sourceId]);\n\t\t\tconst keeperId = await createMemory(service, \"共享来源保留记忆检索标记丙丁\", [sourceId]);\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tcapture.registerSession(\"session-shared\", manager.getSessionFile());\n\t\t\tconst autoRecallId = manager.appendCustomMessageEntry(\n\t\t\t\t\"pao-auto-recall\",\n\t\t\t\t`召回 ${targetId}\\n共享来源目标记忆删除标记甲乙`,\n\t\t\t\tfalse,\n\t\t\t);\n\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [targetId],\n\t\t\t\trevisions: { [targetId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-shared\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(deleted.sources[0]).toMatchObject({\n\t\t\t\tsourceId,\n\t\t\t\tresolution: \"shared-retained\",\n\t\t\t\taction: \"retain\",\n\t\t\t\tsharedWithMemoryIds: [keeperId],\n\t\t\t});\n\n\t\t\tconst search = await service.searchMemory({\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tquery: \"保留记忆检索标记\",\n\t\t\t\tmode: \"current\",\n\t\t\t});\n\t\t\texpect(search.ok).toBe(true);\n\t\t\tif (search.ok) {\n\t\t\t\texpect(search.hits.map((hit) => hit.memoryId)).toContain(keeperId);\n\t\t\t\texpect(search.hits.map((hit) => hit.memoryId)).not.toContain(targetId);\n\t\t\t}\n\t\t\texpect(store.db.prepare(\"SELECT COUNT(*) AS count FROM sources WHERE source_id = ?\").get(sourceId)).toEqual({\n\t\t\t\tcount: 1,\n\t\t\t});\n\t\t\texpect(JSON.stringify(SessionManager.open(manager.getSessionFile()!).getEntry(autoRecallId))).not.toContain(\n\t\t\t\t\"共享来源目标记忆删除标记甲乙\",\n\t\t\t);\n\t\t\texpect(\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT memory_id FROM source_exclusions\n\t\t\t\t\t\t WHERE source_id = ? AND memory_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(sourceId, targetId),\n\t\t\t).toEqual({ memory_id: targetId });\n\t\t\texpect(isSourceExcluded(store.db, { sourceId })).toBe(true);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"回复作为 keeper 唯一来源时 retain 保留正文，显式递归时纳入并清理\", async () => {\n\t\tconst body = \"keeper-reply-source-body\";\n\n\t\tconst retainHome = tempDir(\"pao-del-reply-keeper-retain-\");\n\t\tconst retainStore = openMemoryStore(retainHome, \"readwrite\");\n\t\tconst retainService = openMemoryService({ paoHome: retainHome, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(retainHome, join(retainHome, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-reply-keeper-retain\",\n\t\t\t});\n\t\t\tconst userEntryId = manager.appendMessage(userMsg(\"目标来源保留状态。\"));\n\t\t\tconst replyEntryId = manager.appendMessage(assistantMsg(`确认 ${body}`));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tconst capture = createCapture({ store: retainStore, paoHome: retainHome, now: () => AT });\n\t\t\tcapture.registerSession(\"session-reply-keeper-retain\", file);\n\t\t\tconst captured = capture.captureCommittedEntries(\"session-reply-keeper-retain\", manager.getEntries(), AT);\n\t\t\tconst userSourceId = captured.find((entry) => entry.entryId === userEntryId)?.sourceId;\n\t\t\tconst replySourceId = captured.find((entry) => entry.entryId === replyEntryId)?.sourceId;\n\t\t\tif (!userSourceId || !replySourceId) throw new Error(\"keeper 回复来源未采集\");\n\t\t\tconst targetId = await createMemory(retainService, \"待删除目标\", [userSourceId]);\n\t\t\tconst keeperId = await createMemory(retainService, \"回复支撑的保留记忆\", [replySourceId]);\n\n\t\t\tconst preview = await retainService.previewMemoryDeletion({ memoryId: targetId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\texpect(preview.targets.map((target) => target.memoryId)).toEqual([targetId]);\n\t\t\texpect(preview.sources.find((source) => source.sourceId === replySourceId)).toMatchObject({\n\t\t\t\taction: \"retain\",\n\t\t\t\tresolution: \"shared-retained\",\n\t\t\t\tsharedWithMemoryIds: [keeperId],\n\t\t\t});\n\t\t\texpect(\n\t\t\t\tpreview.sessions.find((session) => session.sessionId === \"session-reply-keeper-retain\")?.derivedEntryIds,\n\t\t\t).not.toContain(replyEntryId);\n\n\t\t\tconst deleted = await retainService.deleteMemory({\n\t\t\t\tmemoryIds: [targetId],\n\t\t\t\trevisions: { [targetId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-reply-keeper-retain\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tconst after = SessionManager.open(file);\n\t\t\texpect(JSON.stringify(after.getEntry(replyEntryId))).toContain(body);\n\t\t\texpect(retainStore.db.prepare(\"SELECT 1 FROM memories WHERE id = ?\").get(keeperId)).toBeDefined();\n\t\t\texpect(retainStore.db.prepare(\"SELECT 1 FROM sources WHERE source_id = ?\").get(replySourceId)).toBeDefined();\n\t\t} finally {\n\t\t\tawait retainService.close();\n\t\t\tretainStore.close();\n\t\t}\n\n\t\tconst includeHome = tempDir(\"pao-del-reply-keeper-include-\");\n\t\tconst includeStore = openMemoryStore(includeHome, \"readwrite\");\n\t\tconst includeService = openMemoryService({ paoHome: includeHome, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(includeHome, join(includeHome, \"agent\", \"sessions\"), {\n\t\t\t\tid: \"session-reply-keeper-include\",\n\t\t\t});\n\t\t\tconst userEntryId = manager.appendMessage(userMsg(\"目标来源递归状态。\"));\n\t\t\tconst replyEntryId = manager.appendMessage(assistantMsg(`确认 ${body}`));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tconst capture = createCapture({ store: includeStore, paoHome: includeHome, now: () => AT });\n\t\t\tcapture.registerSession(\"session-reply-keeper-include\", file);\n\t\t\tconst captured = capture.captureCommittedEntries(\"session-reply-keeper-include\", manager.getEntries(), AT);\n\t\t\tconst userSourceId = captured.find((entry) => entry.entryId === userEntryId)?.sourceId;\n\t\t\tconst replySourceId = captured.find((entry) => entry.entryId === replyEntryId)?.sourceId;\n\t\t\tif (!userSourceId || !replySourceId) throw new Error(\"keeper 回复来源未采集\");\n\t\t\tconst targetId = await createMemory(includeService, \"待递归删除目标\", [userSourceId]);\n\t\t\tconst keeperId = await createMemory(includeService, \"回复支撑的递归记忆\", [replySourceId]);\n\n\t\t\tconst preview = await includeService.previewMemoryDeletion({\n\t\t\t\tmemoryId: targetId,\n\t\t\t\tsharedSourcePolicy: \"include-referencing-memories\",\n\t\t\t});\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (!preview.ok) return;\n\t\t\texpect(preview.targets.map((target) => target.memoryId).sort()).toEqual([targetId, keeperId].sort());\n\t\t\texpect(preview.sources.find((source) => source.sourceId === replySourceId)).toMatchObject({\n\t\t\t\taction: \"redact\",\n\t\t\t\tsharedWithMemoryIds: [],\n\t\t\t});\n\n\t\t\tconst deleted = await includeService.deleteMemory({\n\t\t\t\tmemoryIds: [targetId, keeperId],\n\t\t\t\trevisions: { [targetId]: 1, [keeperId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-reply-keeper-include\" },\n\t\t\t\tsharedSourcePolicy: \"include-referencing-memories\",\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\texpect(JSON.stringify(SessionManager.open(file).getEntry(replyEntryId))).not.toContain(body);\n\t\t\texpect(includeStore.db.prepare(\"SELECT COUNT(*) AS count FROM memories\").get()).toEqual({ count: 0 });\n\t\t} finally {\n\t\t\tawait includeService.close();\n\t\t\tincludeStore.close();\n\t\t}\n\t});\n\n\tit(\"无目标用户来源的 recall 回复按同一策略保留或递归纳入\", async () => {\n\t\tconst exercise = async (policy: SharedSourcePolicy) => {\n\t\t\tconst home = tempDir(`pao-del-recall-reply-keeper-${policy}-`);\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\t\ttry {\n\t\t\t\tconst sourceManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\t\tid: \"session-recall-reply-source\",\n\t\t\t\t});\n\t\t\t\tconst targetUser = sourceManager.appendMessage(userMsg(\"记住待删除的模型配置。\"));\n\t\t\t\tconst sourceFile = sourceManager.getSessionFile()!;\n\t\t\t\tconst sourceCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\t\tsourceCapture.registerSession(\"session-recall-reply-source\", sourceFile);\n\t\t\t\tconst targetSourceId = sourceCapture\n\t\t\t\t\t.captureCommittedEntries(\"session-recall-reply-source\", sourceManager.getEntries(), AT)\n\t\t\t\t\t.find((entry) => entry.entryId === targetUser)?.sourceId;\n\t\t\t\tif (!targetSourceId) throw new Error(\"目标用户来源未采集\");\n\t\t\t\tconst targetId = await createMemory(service, \"待删除的模型配置\", [targetSourceId]);\n\n\t\t\t\tconst recallManager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), {\n\t\t\t\t\tid: \"session-recall-reply-keeper\",\n\t\t\t\t});\n\t\t\t\tconst requestUser = recallManager.appendMessage(userMsg(\"恢复刚才的模型配置。\"));\n\t\t\t\tconst hits = [{ 记忆ID: targetId, 修订号: 1, 内容: \"待删除的模型配置\", 来源: \"内置记忆库\" }];\n\t\t\t\tconst _recallEntry = recallManager.appendCustomMessageEntry(\n\t\t\t\t\t\"pao-auto-recall\",\n\t\t\t\t\trenderRecallSection(hits),\n\t\t\t\t\tfalse,\n\t\t\t\t\t{ vendor: \"builtin\", hits },\n\t\t\t\t);\n\t\t\t\tconst replyBody = `keeper-recall-reply-${policy}`;\n\t\t\t\tconst replyEntry = recallManager.appendMessage(assistantMsg(`已恢复：${replyBody}`));\n\t\t\t\tconst recallFile = recallManager.getSessionFile()!;\n\t\t\t\tconst recallCapture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\t\trecallCapture.registerSession(\"session-recall-reply-keeper\", recallFile);\n\t\t\t\tconst captured = recallCapture.captureCommittedEntries(\n\t\t\t\t\t\"session-recall-reply-keeper\",\n\t\t\t\t\trecallManager.getEntries(),\n\t\t\t\t\tAT,\n\t\t\t\t);\n\t\t\t\tconst replySourceId = captured.find((entry) => entry.entryId === replyEntry)?.sourceId;\n\t\t\t\tif (!replySourceId) throw new Error(\"recall 回复来源未采集\");\n\t\t\t\tconst keeperId = await createMemory(service, \"由 recall 回复支撑的保留记忆\", [replySourceId]);\n\n\t\t\t\tconst preview = await service.previewMemoryDeletion({\n\t\t\t\t\tmemoryId: targetId,\n\t\t\t\t\tsharedSourcePolicy: policy,\n\t\t\t\t});\n\t\t\t\texpect(preview.ok).toBe(true);\n\t\t\t\tif (!preview.ok) return;\n\t\t\t\tconst recallPreview = preview.sessions.find(\n\t\t\t\t\t(session) => session.sessionId === \"session-recall-reply-keeper\",\n\t\t\t\t);\n\t\t\t\texpect(\n\t\t\t\t\tpreview.sources.filter(\n\t\t\t\t\t\t(source) => source.sessionId === \"session-recall-reply-keeper\" && source.eventType === \"user\",\n\t\t\t\t\t),\n\t\t\t\t).toEqual([]);\n\n\t\t\t\tconst expectedMemoryIds = policy === \"retain\" ? [targetId] : [targetId, keeperId].sort();\n\t\t\t\texpect(preview.targets.map((target) => target.memoryId).sort()).toEqual(expectedMemoryIds);\n\t\t\t\texpect(preview.sources.find((source) => source.sourceId === replySourceId)).toMatchObject(\n\t\t\t\t\tpolicy === \"retain\"\n\t\t\t\t\t\t? {\n\t\t\t\t\t\t\t\taction: \"retain\",\n\t\t\t\t\t\t\t\tresolution: \"shared-retained\",\n\t\t\t\t\t\t\t\tsharedWithMemoryIds: [keeperId],\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t: {\n\t\t\t\t\t\t\t\taction: \"redact\",\n\t\t\t\t\t\t\t\tsharedWithMemoryIds: [],\n\t\t\t\t\t\t\t},\n\t\t\t\t);\n\t\t\t\texpect(recallPreview?.derivedEntryIds.includes(replyEntry)).toBe(policy !== \"retain\");\n\n\t\t\t\tconst deleteIds = policy === \"retain\" ? [targetId] : [targetId, keeperId];\n\t\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\t\tmemoryIds: deleteIds,\n\t\t\t\t\trevisions: Object.fromEntries(deleteIds.map((memoryId) => [memoryId, 1])),\n\t\t\t\t\tsource: { sessionId: \"session-recall-reply-keeper\", entryId: requestUser },\n\t\t\t\t\tsharedSourcePolicy: policy,\n\t\t\t\t});\n\t\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\", pendingObjects: [] });\n\n\t\t\t\tconst replyAfter = JSON.stringify(SessionManager.open(recallFile).getEntry(replyEntry));\n\t\t\t\tconst segment = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT original_path, compressed_path\n\t\t\t\t\t\t FROM archive_segments\n\t\t\t\t\t\t WHERE session_id = ?\n\t\t\t\t\t\t ORDER BY segment_id DESC LIMIT 1`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(\"session-recall-reply-keeper\") as {\n\t\t\t\t\toriginal_path: string;\n\t\t\t\t\tcompressed_path: string | null;\n\t\t\t\t};\n\t\t\t\tconst archivePath = segment.compressed_path ?? segment.original_path;\n\t\t\t\tif (policy === \"retain\") {\n\t\t\t\t\texpect(replyAfter).toContain(replyBody);\n\t\t\t\t\texpect(archiveContains(archivePath, segment.compressed_path !== null, replyBody)).toBe(true);\n\t\t\t\t\texpect(store.db.prepare(\"SELECT 1 FROM memories WHERE id = ?\").get(keeperId)).toBeDefined();\n\t\t\t\t\texpect(store.db.prepare(\"SELECT 1 FROM sources WHERE source_id = ?\").get(replySourceId)).toBeDefined();\n\t\t\t\t} else {\n\t\t\t\t\texpect(replyAfter).not.toContain(replyBody);\n\t\t\t\t\texpect(archiveContains(archivePath, segment.compressed_path !== null, replyBody)).toBe(false);\n\t\t\t\t\texpect(store.db.prepare(\"SELECT COUNT(*) AS count FROM memories\").get()).toEqual({ count: 0 });\n\t\t\t\t}\n\t\t\t} finally {\n\t\t\t\tawait service.close();\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t};\n\n\t\tawait exercise(\"retain\");\n\t\tawait exercise(\"include-referencing-memories\");\n\t});\n\n\tit(\"协调器安全关闭真实活动 owner 后从 pending 续作完成，且只重载一次\", async () => {\n\t\tconst home = tempDir(\"pao-del-coordinator-\");\n\t\tlet releaseOnClose = false;\n\t\tconst calls: string[] = [];\n\t\tconst coordinator: DeletionSessionCoordinator = {\n\t\t\tasync prepare(session) {\n\t\t\t\tcalls.push(`prepare:${session.sessionId}`);\n\t\t\t},\n\t\t\tasync close(session) {\n\t\t\t\tcalls.push(`close:${session.sessionId}`);\n\t\t\t\tif (releaseOnClose && control) {\n\t\t\t\t\tawait control.release();\n\t\t\t\t\tcontrol = undefined;\n\t\t\t\t}\n\t\t\t},\n\t\t\tasync reload(session) {\n\t\t\t\tcalls.push(`reload:${session.sessionId}`);\n\t\t\t},\n\t\t};\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\", deletionCoordinator: coordinator });\n\t\tlet control: Awaited<ReturnType<typeof acquireSessionControl>> | undefined;\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-coordinated\" });\n\t\t\tconst entryId = manager.appendMessage(userMsg(\"协调器关闭的活动会话删除正文寅卯辰巳\"));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-coordinated\",\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tcreateCapture({ store, paoHome: home, now: () => AT }).registerSession(\"session-coordinated\", file);\n\t\t\tconst memoryId = await createMemory(service, \"协调器活动会话删除目标午未申酉\", [sourceId]);\n\t\t\tcontrol = await acquireSessionControl({\n\t\t\t\tpaoHome: home,\n\t\t\t\tsessionId: \"session-coordinated\",\n\t\t\t\tsurface: \"active-host\",\n\t\t\t});\n\n\t\t\tconst pending = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-coordinated\" },\n\t\t\t});\n\t\t\texpect(pending).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\tif (!pending.ok) return;\n\t\t\texpect(calls).toEqual([\n\t\t\t\t\"prepare:session-coordinated\",\n\t\t\t\t\"close:session-coordinated\",\n\t\t\t\t\"reload:session-coordinated\",\n\t\t\t]);\n\t\t\tconst operationRow = store.db\n\t\t\t\t.prepare(\"SELECT scope_json FROM deletion_operations WHERE operation_id = ?\")\n\t\t\t\t.get(pending.operationId) as { scope_json: string };\n\t\t\texpect(JSON.parse(operationRow.scope_json)).toMatchObject({ plan: { databaseDone: false } });\n\n\t\t\treleaseOnClose = true;\n\t\t\tconst resumed = await service.resumeDeletion({ operationId: pending.operationId });\n\t\t\texpect(resumed).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\texpect(calls).toEqual([\n\t\t\t\t\"prepare:session-coordinated\",\n\t\t\t\t\"close:session-coordinated\",\n\t\t\t\t\"reload:session-coordinated\",\n\t\t\t\t\"prepare:session-coordinated\",\n\t\t\t\t\"close:session-coordinated\",\n\t\t\t\t\"reload:session-coordinated\",\n\t\t\t]);\n\t\t\texpect(readFileSync(file, \"utf8\")).not.toContain(\"协调器关闭的活动会话删除正文\");\n\t\t\texpect(readFileSync(file, \"utf8\")).toContain(\"关联记忆已彻底删除\");\n\t\t} finally {\n\t\t\tawait control?.release().catch(() => undefined);\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"活动 owner 时真实会话保持 pending，关库重开 read/resume 后完成\", async () => {\n\t\tconst home = tempDir(\"pao-del-lock-\");\n\t\tlet service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tlet store = openMemoryStore(home, \"readwrite\");\n\t\tlet control: Awaited<ReturnType<typeof acquireSessionControl>> | undefined;\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-lock\" });\n\t\t\tconst entryId = manager.appendMessage(userMsg(\"活动会话里要删除的真实正文戊己庚辛\"));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-lock\",\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO memory_sessions (session_id, session_file, availability, updated_at)\n\t\t\t\t\t VALUES (?, ?, 'active', ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\"session-lock\", file, AT);\n\t\t\tconst memoryId = await createMemory(service, \"活动会话删除目标壬癸子丑\", [sourceId]);\n\t\t\tcontrol = await acquireSessionControl({\n\t\t\t\tpaoHome: home,\n\t\t\t\tsessionId: \"session-lock\",\n\t\t\t\tsurface: \"foreign-writer\",\n\t\t\t});\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-lock\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(deleted.pendingObjects.some((item) => item.kind === \"session\")).toBe(true);\n\t\t\tconst operationId = deleted.operationId;\n\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t\tawait control.release();\n\t\t\tcontrol = undefined;\n\t\t\tservice = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\t\tstore = openMemoryStore(home, \"readwrite\");\n\t\t\tconst persisted = await service.readDeletionOperation({ operationId });\n\t\t\texpect(persisted).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\tconst operationRow = store.db\n\t\t\t\t.prepare(\"SELECT scope_json FROM deletion_operations WHERE operation_id = ?\")\n\t\t\t\t.get(operationId) as { scope_json: string };\n\t\t\texpect(JSON.parse(operationRow.scope_json)).toMatchObject({ plan: { databaseDone: false } });\n\t\t\texpect(store.db.prepare(\"SELECT 1 FROM memories WHERE id = ?\").get(memoryId)).toBeDefined();\n\t\t\tconst resumed = await service.resumeDeletion({ operationId });\n\t\t\texpect(resumed).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\texpect(readFileSync(file, \"utf8\")).not.toContain(\"活动会话里要删除\");\n\t\t\texpect(readFileSync(file, \"utf8\")).toContain(\"关联记忆已彻底删除\");\n\t\t} finally {\n\t\t\tawait control?.release().catch(() => undefined);\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"数据库清理前会话重扫失败时保持 pending 且不清库\", async () => {\n\t\tconst home = tempDir(\"pao-del-prescan-failed-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tlet control: Awaited<ReturnType<typeof acquireSessionControl>> | undefined;\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-prescan\" });\n\t\t\tconst entryId = manager.appendMessage(userMsg(\"重扫失败时保留的会话删除正文戌亥\"));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-prescan\",\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tcreateCapture({ store, paoHome: home, now: () => AT }).registerSession(\"session-prescan\", file);\n\t\t\tconst memoryId = await createMemory(service, \"预扫描失败不得清库目标甲乙\", [sourceId]);\n\t\t\tcontrol = await acquireSessionControl({\n\t\t\t\tpaoHome: home,\n\t\t\t\tsessionId: \"session-prescan\",\n\t\t\t\tsurface: \"foreign-writer\",\n\t\t\t});\n\t\t\tconst first = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-prescan\" },\n\t\t\t});\n\t\t\texpect(first).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\tif (!first.ok) return;\n\n\t\t\tawait control.release();\n\t\t\tcontrol = undefined;\n\t\t\trmSync(file, { force: true });\n\t\t\tmkdirSync(file);\n\t\t\tconst resumed = await service.resumeDeletion({ operationId: first.operationId });\n\t\t\texpect(resumed).toMatchObject({\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"pending\",\n\t\t\t\tpendingObjects: expect.arrayContaining([\n\t\t\t\t\texpect.objectContaining({\n\t\t\t\t\t\tkind: \"session\",\n\t\t\t\t\t\treason: expect.stringContaining(\"数据库清理前重新扫描会话失败\"),\n\t\t\t\t\t}),\n\t\t\t\t]),\n\t\t\t});\n\t\t\tif (!resumed.ok) return;\n\t\t\tconst operationRow = store.db\n\t\t\t\t.prepare(\"SELECT scope_json FROM deletion_operations WHERE operation_id = ?\")\n\t\t\t\t.get(resumed.operationId) as { scope_json: string };\n\t\t\texpect(JSON.parse(operationRow.scope_json)).toMatchObject({ plan: { databaseDone: false } });\n\t\t\texpect(store.db.prepare(\"SELECT 1 FROM memories WHERE id = ?\").get(memoryId)).toBeDefined();\n\t\t} finally {\n\t\t\tawait control?.release().catch(() => undefined);\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"修订快照不符时持久化为 failed 且不清理数据库\", async () => {\n\t\tconst home = tempDir(\"pao-del-failed-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"legacy-failed-source\",\n\t\t\t\tentryId: \"entry-1\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst memoryId = await createMemory(service, \"修订快照必须与预览一致\", [sourceId]);\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 99 },\n\t\t\t\tsource: { sessionId: \"memory-deletion\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"failed\",\n\t\t\t\tfailureReason: expect.stringContaining(\"修订号已变化\"),\n\t\t\t});\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(await service.readDeletionOperation({ operationId: deleted.operationId })).toMatchObject({\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"failed\",\n\t\t\t});\n\t\t\tconst current = await service.getMemory({ id: memoryId });\n\t\t\texpect(current.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n\ndescribe(\"归档专属来源与升级兼容\", () => {\n\tit(\"page_operation 与回执仅重写归档，不虚构聊天会话\", async () => {\n\t\tconst home = tempDir(\"pao-del-archive-only-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst sources: string[] = [];\n\t\t\tfor (const [sessionId, entryId, entryType] of [\n\t\t\t\t[\"desktop-page-operations\", \"page-operation-1\", \"page_operation\"],\n\t\t\t\t[\"receipt-archive\", \"receipt-1-attempt-1\", \"receipt\"],\n\t\t\t] as const) {\n\t\t\t\tconst appended = appendToOpenSegment(\n\t\t\t\t\tstore.db,\n\t\t\t\t\thome,\n\t\t\t\t\tsessionId,\n\t\t\t\t\t{\n\t\t\t\t\t\tv: 1,\n\t\t\t\t\t\tsessionId,\n\t\t\t\t\t\tentryId,\n\t\t\t\t\t\tentryType,\n\t\t\t\t\t\teventType: \"user\",\n\t\t\t\t\t\ttimestamp: AT,\n\t\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\t\tcontent: `归档专属正文-${entryId}`,\n\t\t\t\t\t},\n\t\t\t\t\tAT,\n\t\t\t\t);\n\t\t\t\tsources.push(\n\t\t\t\t\tregisterSource(store.db, {\n\t\t\t\t\t\tsessionId,\n\t\t\t\t\t\tentryId,\n\t\t\t\t\t\teventType: \"user\",\n\t\t\t\t\t\tsegmentId: appended.segmentId,\n\t\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\t}),\n\t\t\t\t);\n\t\t\t}\n\t\t\tconst memoryId = await createMemory(service, \"归档专属删除目标正文\", sources);\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (preview.ok) {\n\t\t\t\texpect(preview.sources.every((source) => source.resolution === \"archive-only\")).toBe(true);\n\t\t\t\texpect(preview.sessions).toEqual([]);\n\t\t\t}\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"desktop-page-operations\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\tfor (const segment of store.db\n\t\t\t\t.prepare(\"SELECT original_path FROM archive_segments\")\n\t\t\t\t.all() as unknown as Array<{\n\t\t\t\toriginal_path: string;\n\t\t\t}>) {\n\t\t\t\texpect(readFileSync(segment.original_path, \"utf8\")).not.toContain(\"归档专属正文\");\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"归档专属来源缺少段定位时保持 pending，且不产生虚构会话\", async () => {\n\t\tconst home = tempDir(\"pao-del-archive-missing-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"desktop-page-operations\",\n\t\t\t\tentryId: \"page-operation-without-segment\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst memoryId = await createMemory(service, \"缺少归档段定位的页面操作\", [sourceId]);\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"memory-deletion\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"pending\", sessions: [] });\n\t\t\tif (!deleted.ok) return;\n\t\t\texpect(deleted.pendingObjects).toEqual(\n\t\t\t\texpect.arrayContaining([\n\t\t\t\t\texpect.objectContaining({\n\t\t\t\t\t\tkind: \"archive\",\n\t\t\t\t\t\tsourceId,\n\t\t\t\t\t\treason: expect.stringContaining(\"没有受管归档段定位\"),\n\t\t\t\t\t}),\n\t\t\t\t]),\n\t\t\t);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"目标附件的路径未登记在受管目录时保留现场并保持 pending\", async () => {\n\t\tconst home = tempDir(\"pao-del-attachment-\");\n\t\tconst outside = join(tempDir(\"pao-del-attachment-outside-\"), \"payload.bin\");\n\t\twriteFileSync(outside, \"不能误删的外部文件\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst sessionId = \"desktop-page-operations\";\n\t\t\tconst entryId = \"page-operation-external-attachment\";\n\t\t\tconst appended = appendToOpenSegment(\n\t\t\t\tstore.db,\n\t\t\t\thome,\n\t\t\t\tsessionId,\n\t\t\t\t{\n\t\t\t\t\tv: 1,\n\t\t\t\t\tsessionId,\n\t\t\t\t\tentryId,\n\t\t\t\t\tentryType: \"page_operation\",\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\ttimestamp: AT,\n\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\tcontent: { managedPath: outside, attachmentId: \"outside-asset\" },\n\t\t\t\t},\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tlocation: `${appended.segmentId}#${appended.lineNo}`,\n\t\t\t\tsegmentId: appended.segmentId,\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst memoryId = await createMemory(service, \"带受管范围外附件的目标\", [sourceId]);\n\t\t\tconst preview = await service.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (preview.ok) {\n\t\t\t\texpect(preview.pendingObjects).toEqual(\n\t\t\t\t\texpect.arrayContaining([\n\t\t\t\t\t\texpect.objectContaining({\n\t\t\t\t\t\t\tkind: \"attachment\",\n\t\t\t\t\t\t\treason: expect.stringContaining(outside),\n\t\t\t\t\t\t}),\n\t\t\t\t\t]),\n\t\t\t\t);\n\t\t\t}\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"memory-deletion\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"pending\" });\n\t\t\texpect(existsSync(outside)).toBe(true);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"旧库缺新映射/作业表时 readonly 预览正常给 unknown，不偷偷建表\", async () => {\n\t\tconst home = tempDir(\"pao-del-old-schema-\");\n\t\tlet service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"legacy-session\",\n\t\t\t\tentryId: \"legacy-entry\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tawait createMemory(service, \"旧库来源定位未知但删除范围准确\", [sourceId]);\n\t\t\tawait service.close();\n\t\t\tstore.db.exec(\"DROP TABLE memory_sessions\");\n\t\t\tstore.db.exec(\"DROP TABLE deletion_operations\");\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\n\t\tservice = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\t\ttry {\n\t\t\tconst preview = await service.previewMemoryDeletion({ sourceId: \"src-legacy-session-legacy-entry-user\" });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (preview.ok) {\n\t\t\t\texpect(preview.sources[0]).toMatchObject({\n\t\t\t\t\tresolution: \"unknown\",\n\t\t\t\t\taction: \"redact\",\n\t\t\t\t});\n\t\t\t\texpect(preview.pendingObjects.some((item) => item.kind === \"session\")).toBe(true);\n\t\t\t}\n\t\t\tconst op = await service.readDeletionOperation({ operationId: \"del-old\" });\n\t\t\texpect(op.ok).toBe(false);\n\t\t\tif (!op.ok) expect(op.error.code).toBe(\"invalid_input\");\n\t\t\tconst probe = openMemoryStore(home, \"readonly\");\n\t\t\ttry {\n\t\t\t\tconst table = probe.db\n\t\t\t\t\t.prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'memory_sessions'\")\n\t\t\t\t\t.get();\n\t\t\t\texpect(table).toBeUndefined();\n\t\t\t} finally {\n\t\t\t\tprobe.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n});\n\ndescribe(\"CLI 工具入口\", () => {\n\tit(\"注册工具写→关重开读原文→删除定位真实 assistant entry 与 JSONL\", async () => {\n\t\tconst home = tempDir(\"pao-del-cli-\");\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-cli\" });\n\t\tmanager.appendMessage(userMsg(\"CLI 真实来源上下文\"));\n\t\tconst assistantId = manager.appendMessage(\n\t\t\ttoolCallContent(\"调用内置写入\", [\n\t\t\t\t{ id: \"call-write\", args: { content: \"CLI 真实写入记忆目标正文\" } },\n\t\t\t\t{ id: \"call-other\", args: { command: \"pwd\" } },\n\t\t\t]),\n\t\t);\n\t\tconst file = manager.getSessionFile()!;\n\t\tconst ctx = {\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tmodelRegistry: { find: () => undefined },\n\t\t};\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\tlet reopened: MemoryService | undefined;\n\t\ttry {\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\");\n\t\t\texpect(writeTool).toBeDefined();\n\t\t\tconst written = await writeTool!.execute(\n\t\t\t\t\"call-write\",\n\t\t\t\t{ content: \"CLI 真实写入记忆目标正文\" } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(written.isError).not.toBe(true);\n\t\t\tconst toolResultId = manager.appendMessage({\n\t\t\t\trole: \"toolResult\",\n\t\t\t\ttoolCallId: \"call-write\",\n\t\t\t\ttoolName: \"pao_memory_write\",\n\t\t\t\tcontent: [{ type: \"text\", text: JSON.stringify(written.content) }],\n\t\t\t\tisError: false,\n\t\t\t\ttimestamp: Date.now(),\n\t\t\t});\n\t\t\tconst rows = await registration.service.searchMemory({\n\t\t\t\tscope: scopeFromContext(ctx as never),\n\t\t\t\tquery: \"CLI 真实写入\",\n\t\t\t\tmode: \"current\",\n\t\t\t});\n\t\t\texpect(rows.ok).toBe(true);\n\t\t\tif (!rows.ok) return;\n\t\t\tconst memoryId = rows.hits[0]!.memoryId;\n\t\t\tconst source = registration.service.getMemory({ id: memoryId });\n\t\t\tconst detail = await source;\n\t\t\texpect(detail.ok).toBe(true);\n\t\t\tif (!detail.ok) return;\n\t\t\tconst sourceId = detail.sourceSummaries[0]!.sourceId;\n\t\t\texpect(detail.sourceSummaries[0]!.capturedAt).toMatch(/^20/);\n\t\t\tawait registration.close();\n\n\t\t\treopened = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\t\tconst read = await reopened.readMemorySource({ sourceId });\n\t\t\texpect(read.ok).toBe(true);\n\t\t\tif (read.ok) {\n\t\t\t\texpect(read.entryId).toBe(assistantId);\n\t\t\t\texpect(read.content).toContain(\"CLI 真实写入记忆目标正文\");\n\t\t\t}\n\t\t\tconst preview = await reopened.previewMemoryDeletion({ memoryId });\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (preview.ok) {\n\t\t\t\texpect(preview.sources[0]).toMatchObject({\n\t\t\t\t\tentryId: assistantId,\n\t\t\t\t\teventType: \"toolcall:call-write\",\n\t\t\t\t\tresolution: \"session\",\n\t\t\t\t});\n\t\t\t\texpect(preview.sessions[0]?.sessionFile).toBe(file);\n\t\t\t}\n\t\t\tconst deleted = await reopened.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-cli\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\n\t\t\tconst after = SessionManager.open(file);\n\t\t\tconst assistant = after.getEntry(assistantId) as SessionMessageEntry;\n\t\t\texpect((assistant.message as { content: unknown[] }).content).toEqual(\n\t\t\t\texpect.arrayContaining([\n\t\t\t\t\texpect.objectContaining({ id: \"call-write\", arguments: {} }),\n\t\t\t\t\texpect.objectContaining({ id: \"call-other\", arguments: { command: \"pwd\" } }),\n\t\t\t\t]),\n\t\t\t);\n\t\t\texpect(JSON.stringify(after.getEntry(toolResultId))).not.toContain(memoryId);\n\t\t\texpect((after.getEntry(toolResultId) as SessionMessageEntry).message).toMatchObject({\n\t\t\t\ttoolCallId: \"call-write\",\n\t\t\t});\n\t\t} finally {\n\t\t\tawait registration.close();\n\t\t\tawait reopened?.close();\n\t\t}\n\t});\n});\n\ndescribe(\"共享来源显式递归\", () => {\n\tit(\"include-referencing-memories 精确纳入引用记忆并按实际范围重写\", async () => {\n\t\tconst home = tempDir(\"pao-del-include-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-include\" });\n\t\t\tconst entryId = manager.appendMessage(userMsg(\"显式递归共享来源正文寅卯辰巳\"));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tcreateCapture({ store, paoHome: home }).registerSession(\"session-include\", file);\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-include\",\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst first = await createMemory(service, \"递归目标一\", [sourceId]);\n\t\t\tconst second = await createMemory(service, \"递归目标二\", [sourceId]);\n\t\t\tconst policy: SharedSourcePolicy = \"include-referencing-memories\";\n\t\t\tconst preview = await service.previewMemoryDeletion({\n\t\t\t\tmemoryId: first,\n\t\t\t\tsharedSourcePolicy: policy,\n\t\t\t});\n\t\t\texpect(preview.ok).toBe(true);\n\t\t\tif (preview.ok) {\n\t\t\t\texpect(preview.targets.map((target) => target.memoryId).sort()).toEqual([first, second].sort());\n\t\t\t\texpect(preview.sources[0]?.action).toBe(\"redact\");\n\t\t\t}\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [first, second],\n\t\t\t\trevisions: { [first]: 1, [second]: 1 },\n\t\t\t\tsource: { sessionId: \"session-include\" },\n\t\t\t\tsharedSourcePolicy: policy,\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\t\t\texpect(readFileSync(file, \"utf8\")).not.toContain(\"显式递归共享来源正文\");\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n\ndescribe(\"O12/E11 进化来源删除贯通\", () => {\n\tit(\"deleteMemory 沿 evolution_source_links 清 problem/candidate/validation 受管正文与盘文件\", async () => {\n\t\tconst home = tempDir(\"pao-del-evolve-\");\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\ttry {\n\t\t\t// 真实会话来源 → capture → memory。\n\t\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: \"session-evo\" });\n\t\t\tconst entryId = manager.appendMessage(userMsg(\"进化证据正文甲乙丙丁\"));\n\t\t\tconst file = manager.getSessionFile()!;\n\t\t\tcreateCapture({ store, paoHome: home }).registerSession(\"session-evo\", file);\n\t\t\tconst sourceId = registerSource(store.db, {\n\t\t\t\tsessionId: \"session-evo\",\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst memoryId = await createMemory(service, \"进化关联记忆\", [sourceId]);\n\n\t\t\t// 种进化链：problem（evidenceRefs 含该来源 + 一条保留引用）→ candidate（未终态）\n\t\t\t// → testPlan 冻结计划。resource 行是外键前提，先登记一条 skill 资源。\n\t\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"evo-skill\");\n\t\t\tmkdirSync(skillDir, { recursive: true });\n\t\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# evo-skill\\n\", \"utf8\");\n\t\t\tconst { registerResource } = await import(\"../../src/pao/evolution/resources.ts\");\n\t\t\tconst reg = registerResource(store, { kind: \"skill\", name: \"evo-skill\", paoHome: home });\n\t\t\tif (!reg.ok) throw new Error(\"registerResource failed\");\n\t\t\tconst resourceId = \"skill:evo-skill\";\n\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t\"prob-del\", \"implementation_defect\", \"modify\", \"进化问题\",\n\t\t\t\t\t\"应 A\", \"实际 B\",\n\t\t\t\t\tJSON.stringify([sourceId, \"evidence:keep-1\"]),\n\t\t\t\t\t1, resourceId, \"v-base0000000\",\n\t\t\t\t\t\"classified\", \"candidate\", AT, AT,\n\t\t\t\t);\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t\t VALUES (?, 'problem', ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\"link-p-del\", \"prob-del\", sourceId, AT);\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t\"cand-del\", \"prob-del\", resourceId, \"v-base0000000\", \"tp-del\",\n\t\t\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\t\t\"修正依据\", \"[]\", \"proposed\", AT, AT,\n\t\t\t\t);\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t\t VALUES (?, 'candidate', ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\"link-c-del\", \"cand-del\", sourceId, AT);\n\t\t\t// 冻结计划 owner（tp-*）+ 盘文件 plan.json。\n\t\t\tconst { evolutionPaths } = await import(\"../../src/pao/memory/paths.ts\");\n\t\t\tconst planDir = join(evolutionPaths(home).validations, \"tp-del\");\n\t\t\tmkdirSync(planDir, { recursive: true });\n\t\t\twriteFileSync(join(planDir, \"plan.json\"), JSON.stringify({ testPlanId: \"tp-del\", cases: [] }), \"utf8\");\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t\t VALUES (?, 'validation', ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\"link-tp-del\", \"tp-del\", sourceId, AT);\n\t\t\t// 候选盘文件目录。\n\t\t\tconst candDir = join(evolutionPaths(home).candidates, \"skill_evo-skill\", \"cand-del\");\n\t\t\tmkdirSync(candDir, { recursive: true });\n\t\t\twriteFileSync(join(candDir, \"SKILL.md\"), \"# patched\\n\", \"utf8\");\n\n\t\t\tconst deleted = await service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: \"session-evo\" },\n\t\t\t});\n\t\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\n\t\t\t// 贯通断言（同一删除事务内 dbCleanupSourceReferences 生效）：\n\t\t\t// - problem evidenceRefs 缩减（保留引用仍在）。\n\t\t\tconst prob = store.db\n\t\t\t\t.prepare(`SELECT evidence_refs_json FROM evolution_problems WHERE problem_id = 'prob-del'`)\n\t\t\t\t.get() as { evidence_refs_json: string };\n\t\t\texpect(JSON.parse(prob.evidence_refs_json)).toEqual([\"evidence:keep-1\"]);\n\t\t\t// - candidate 取消 + 受管正文清空。\n\t\t\tconst cand = store.db\n\t\t\t\t.prepare(`SELECT status, failure_reason, diffs_json, rationale FROM evolution_candidates WHERE candidate_id = 'cand-del'`)\n\t\t\t\t.get() as { status: string; failure_reason: string; diffs_json: string; rationale: string };\n\t\t\texpect(cand.status).toBe(\"cancelled\");\n\t\t\texpect(cand.failure_reason).toContain(\"已删除\");\n\t\t\texpect(cand.diffs_json).toBe(\"[]\");\n\t\t\texpect(cand.rationale).toBe(\"[cleared]\");\n\t\t\t// - 候选盘文件目录被移除。\n\t\t\texpect(existsSync(candDir)).toBe(false);\n\t\t\t// - 冻结计划 plan.json 标 invalidated。\n\t\t\tconst planJson = JSON.parse(readFileSync(join(planDir, \"plan.json\"), \"utf8\")) as { invalidated?: boolean };\n\t\t\texpect(planJson.invalidated).toBe(true);\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S7-10 定向测试：记忆「运行与用量」三读桥。\n *\t\t// 旧目录）、新会话文件 mtime 最新——按 mtime 先选候选后新会话必须进结果。\n\t\tconst home = tempHome();\n\t\tconst oldFile = writeContextSession(home, \"--proj-a-old--\", [\n\t\t\t{ requestId: \"req-old\", sessionId: \"sess-old\" },\n\t\t]);\n\t\tconst newFile = writeContextSession(home, \"--proj-b-new--\", [{ requestId: \"req-new\", sessionId: \"sess-new\" }]);\n\t\t// 把旧文件 mtime 拨早、新文件拨晚，制造「目录序靠前但更新」的落差。\n\t\tconst past = new Date(\"2026-11-01T00:00:00.000Z\");\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":369}},{"diffOp":{"equal":{"range":[70,267]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"equal":{"range":[271,318]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"equal":{"range":[322,389]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"equal":{"range":[389,436]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"equal":{"range":[436,592]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[592,601]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-desktop-usage-bridge.test.ts"},"span":null,"sourceCode":"/**\n * S7-10 定向测试：记忆「运行与用量」三读桥。\n *\n * 覆盖：\n * - readDesktopMemoryMaintenance：库未建空队列；pending/running/done/failed\n *   分桶计数；source_scope 里的 sessionId/taskId 透出；kind 过滤。\n * - readDesktopTaskMemoryCost：按用途（extract/embed/…）分组；逐请求明细\n *   去重；totalTokens>0 计 known、=0 或 cost 缺记 unknown；taskId/jobId 过滤；\n *   DTO 可 JSON 序列化。\n * - readDesktopContextUsage：按 requestId 定位单条快照；requestId 未命中\n *   notFound；旁列同会话相邻真实 usage（note 含 requestId）；sessionId 过滤；\n *   坏会话文件跳过不炸。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-desktop-usage-bridge.test.ts --maxWorkers=2\n */\nimport { mkdirSync, mkdtempSync, rmSync, utimesSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Usage } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport {\n\treadDesktopContextUsage,\n\treadDesktopMemoryMaintenance,\n\treadDesktopTaskMemoryCost,\n} from \"../../src/pao/desktop/memory.ts\";\nimport { claimJob, completeJob, createJob, failJob } from \"../../src/pao/memory/extraction-jobs.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-desk-usage-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-10T10:00:00.000Z\";\n\nfunction usage(overrides: Partial<Usage> = {}): Usage {\n\treturn {\n\t\tinput: 0,\n\t\toutput: 0,\n\t\tcacheRead: 0,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 0,\n\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n\t\t...overrides,\n\t};\n}\n\n/** 在 <home>/memory/background-ledger/<jobId>/ 落一条 usage 条目。 */\nfunction writeUsage(home: string, jobId: string, options: { kind?: string; usage: Usage; note?: string }): void {\n\t// readDesktopTaskMemoryCost 先 databaseExists 拦截：appendUsage 只写会话\n\t// .jsonl 不建 memory.sqlite——先开库建文件再写账本条目。\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tstore.close();\n\tconst sessionDir = join(home, \"memory\", \"background-ledger\", jobId);\n\tconst ledger = SessionManager.continueRecent(home, sessionDir);\n\t// usage-query 的用途分组读 attribution.kind 或 note 的 kind= 字段；\n\t// appendUsage 第一参是 UsageEntry.kind（记账类别），不进用途分组——\n\t// note 里补 kind= 前缀对齐真实记账（embeddings 经 attribution.kind 写入）。\n\tconst kind = options.kind ?? \"extract\";\n\tconst note = options.note === undefined ? `kind=${kind}` : `kind=${kind} ${options.note}`;\n\tledger.appendUsage(kind, \"faux\", \"m-1\", options.usage, note);\n\tledger.flush();\n}\n\n/** 造一个含 pao-context-usage custom entry + 相邻 usage 条目的会话文件。 */\nfunction writeContextSession(\n\thome: string,\n\tdirName: string,\n\tentries: Array<{ requestId: string; sessionId: string; withUsage?: boolean }>,\n): string {\n\t// sessionDir 必须是目录——SessionManager.create 在里面自建 .jsonl 文件。\n\tconst dir = join(home, \"agent\", \"sessions\", dirName);\n\tmkdirSync(dir, { recursive: true });\n\tconst ledger = SessionManager.create(home, dir);\n\tfor (const { requestId, sessionId, withUsage } of entries) {\n\t\tledger.appendCustomEntry(\"pao-context-usage\", {\n\t\t\trequestId,\n\t\t\tsessionId,\n\t\t\tsampledAt: \"2026-11-10T10:00:00.000Z\",\n\t\t\testimateMethod: \"chars4\",\n\t\t\tbyCategory: {\n\t\t\t\tsystem_prompt: 100,\n\t\t\t\ttool_definitions: 50,\n\t\t\t\tmemory: 30,\n\t\t\t\ttool_results: 20,\n\t\t\t\tconversation: 200,\n\t\t\t\tother: 0,\n\t\t\t},\n\t\t\testimatedTotal: 400,\n\t\t\tmessageCount: 5,\n\t\t\tunestimated: [],\n\t\t\tnotes: [],\n\t\t});\n\t\tif (withUsage) {\n\t\t\tledger.appendUsage(\n\t\t\t\t\"chat\",\n\t\t\t\t\"faux\",\n\t\t\t\t\"m-1\",\n\t\t\t\tusage({\n\t\t\t\t\tinput: 500,\n\t\t\t\t\toutput: 100,\n\t\t\t\t\ttotalTokens: 600,\n\t\t\t\t\tcost: { input: 0.005, output: 0.001, cacheRead: 0, cacheWrite: 0, total: 0.006 },\n\t\t\t\t}),\n\t\t\t\t`requestId=${requestId}`,\n\t\t\t);\n\t\t}\n\t}\n\tledger.flush();\n\treturn ledger.getSessionFile()!;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// readDesktopMemoryMaintenance\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"readDesktopMemoryMaintenance\", () => {\n\tit(\"库未建返回空队列 + 全零计数\", async () => {\n\t\tconst home = tempHome();\n\t\tconst result = await readDesktopMemoryMaintenance({ home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(0);\n\t\texpect(result.counts).toEqual({ pending: 0, running: 0, done: 0, failed: 0 });\n\t});\n\n\tit(\"分桶计数 + source_scope 透出 sessionId/taskId\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\t// pending job（extract 会话）。\n\t\t\tcreateJob(store, {\n\t\t\t\tjobKind: \"extract\",\n\t\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-1\", taskId: \"card-1\" }),\n\t\t\t\tscopeKey: \"session:sess-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\t// running job（embed 项目）。\n\t\t\tconst embed = createJob(store, {\n\t\t\t\tjobKind: \"embed\",\n\t\t\t\tsourceScope: JSON.stringify({ projectId: \"proj-1\" }),\n\t\t\t\tscopeKey: \"embed:proj-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tclaimJob(store, { jobId: embed.jobId, ownerProcess: \"pid-1\", claimedAt: AT });\n\t\t\t// done job。\n\t\t\tconst done = createJob(store, {\n\t\t\t\tjobKind: \"organize\",\n\t\t\t\tsourceScope: \"{}\",\n\t\t\t\tscopeKey: \"organize:proj-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tcompleteJob(store, { jobId: done.jobId, completedAt: AT });\n\t\t\t// failed job。\n\t\t\tconst failed = createJob(store, {\n\t\t\t\tjobKind: \"archive\",\n\t\t\t\tsourceScope: \"{}\",\n\t\t\t\tscopeKey: \"archive:scope-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tfailJob(store, { jobId: failed.jobId, reason: \"磁盘满\", failedAt: AT });\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\n\t\tconst result = await readDesktopMemoryMaintenance({ home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(4);\n\t\texpect(result.counts).toEqual({ pending: 1, running: 1, done: 1, failed: 1 });\n\t\tconst extract = result.items.find((j) => j.scopeKey === \"session:sess-1\")!;\n\t\texpect(extract.sourceSessionId).toBe(\"sess-1\");\n\t\texpect(extract.taskId).toBe(\"card-1\");\n\t\tconst running = result.items.find((j) => j.scopeKey === \"embed:proj-1\")!;\n\t\texpect(running.status).toBe(\"running\");\n\t\texpect(running.ownerProcess).toBe(\"pid-1\");\n\t\tconst failItem = result.items.find((j) => j.scopeKey === \"archive:scope-1\")!;\n\t\texpect(failItem.status).toBe(\"failed\");\n\t\texpect(failItem.lastError).toBe(\"磁盘满\");\n\t});\n\n\tit(\"kind 过滤只返回对应类别\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\tcreateJob(store, { jobKind: \"extract\", sourceScope: \"{}\", scopeKey: \"session:s1\", createdAt: AT });\n\t\t\tcreateJob(store, { jobKind: \"embed\", sourceScope: \"{}\", scopeKey: \"embed:p1\", createdAt: AT });\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t\tconst result = await readDesktopMemoryMaintenance({ home, kind: \"embed\" });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(1);\n\t\texpect(result.items[0]!.jobKind).toBe(\"embed\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// readDesktopTaskMemoryCost\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"readDesktopTaskMemoryCost\", () => {\n\tit(\"按用途分组 + 明细去重 + 已知/未知分列\", async () => {\n\t\tconst home = tempHome();\n\t\twriteUsage(home, \"job-a\", {\n\t\t\tkind: \"extract\",\n\t\t\tusage: usage({\n\t\t\t\tinput: 100,\n\t\t\t\toutput: 40,\n\t\t\t\ttotalTokens: 140,\n\t\t\t\tcost: { input: 0.001, output: 0.0004, cacheRead: 0, cacheWrite: 0, total: 0.0014 },\n\t\t\t}),\n\t\t\tnote: \"requestId=req-1 sourceSessionId=sess-1 taskId=card-1\",\n\t\t});\n\t\t// 同 requestId 迟到重复：只计一次。\n\t\twriteUsage(home, \"job-a\", {\n\t\t\tkind: \"extract\",\n\t\t\tusage: usage({ input: 100, output: 40, totalTokens: 140 }),\n\t\t\tnote: \"requestId=req-1 sourceSessionId=sess-1 taskId=card-1\",\n\t\t});\n\t\twriteUsage(home, \"job-a\", {\n\t\t\tkind: \"embed\",\n\t\t\tusage: usage({ input: 50, output: 0, totalTokens: 50 }),\n\t\t\tnote: \"requestId=req-2 sourceSessionId=sess-1 taskId=card-1\",\n\t\t});\n\t\twriteUsage(home, \"job-b\", {\n\t\t\tkind: \"extract\",\n\t\t\tusage: usage({ input: 0, output: 0, totalTokens: 0 }),\n\t\t\tnote: \"requestId=req-3 sourceSessionId=sess-2\",\n\t\t});\n\n\t\tconst result = await readDesktopTaskMemoryCost({ home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// 分组：extract 2 条（1 known+1 unknown）、embed 1 条 known。\n\t\tconst extract = result.byPurpose.find((p) => p.purpose === \"extract\")!;\n\t\texpect(extract.requestCount).toBe(2);\n\t\texpect(extract.knownTokens).toBe(140);\n\t\texpect(extract.knownCost).toBeCloseTo(0.0014);\n\t\texpect(extract.unknownCount).toBe(1);\n\t\tconst embed = result.byPurpose.find((p) => p.purpose === \"embed\")!;\n\t\texpect(embed.requestCount).toBe(1);\n\t\texpect(embed.knownTokens).toBe(50);\n\t\t// 明细去重：3 条（req-1/req-2/req-3）。\n\t\texpect(result.entries).toHaveLength(3);\n\t\texpect(result.total.requestCount).toBe(3);\n\t\texpect(result.total.knownTokens).toBe(190);\n\t\texpect(result.total.unknownCount).toBe(1);\n\t\t// DTO 可 JSON 序列化。\n\t\texpect(() => JSON.stringify(result)).not.toThrow();\n\t});\n\n\tit(\"taskId / sourceSessionId / jobId 过滤\", async () => {\n\t\tconst home = tempHome();\n\t\twriteUsage(home, \"job-x\", {\n\t\t\tkind: \"extract\",\n\t\t\tusage: usage({ input: 10, output: 5, totalTokens: 15 }),\n\t\t\tnote: \"requestId=r1 sourceSessionId=s-a taskId=card-1\",\n\t\t});\n\t\twriteUsage(home, \"job-x\", {\n\t\t\tkind: \"extract\",\n\t\t\tusage: usage({ input: 20, output: 5, totalTokens: 25 }),\n\t\t\tnote: \"requestId=r2 sourceSessionId=s-b taskId=card-2\",\n\t\t});\n\t\tconst onlyCard1 = await readDesktopTaskMemoryCost({ home, taskId: \"card-1\" });\n\t\texpect(onlyCard1.ok).toBe(true);\n\t\tif (!onlyCard1.ok) return;\n\t\texpect(onlyCard1.entries).toHaveLength(1);\n\t\texpect(onlyCard1.entries[0]!.taskId).toBe(\"card-1\");\n\t\tconst onlySessB = await readDesktopTaskMemoryCost({ home, sourceSessionId: \"s-b\" });\n\t\texpect(onlySessB.ok).toBe(true);\n\t\tif (!onlySessB.ok) return;\n\t\texpect(onlySessB.entries).toHaveLength(1);\n\t\texpect(onlySessB.entries[0]!.sourceSessionId).toBe(\"s-b\");\n\t});\n\n\tit(\"库未建返回空结果\", async () => {\n\t\tconst home = tempHome();\n\t\tconst result = await readDesktopTaskMemoryCost({ home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.byPurpose).toHaveLength(0);\n\t\texpect(result.entries).toHaveLength(0);\n\t\texpect(result.total.requestCount).toBe(0);\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// readDesktopContextUsage\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"readDesktopContextUsage\", () => {\n\tit(\"按 requestId 定位单条快照，旁列同会话真实 usage\", async () => {\n\t\tconst home = tempHome();\n\t\twriteContextSession(home, \"--proj-a--\", [\n\t\t\t{ requestId: \"req-ctx-1\", sessionId: \"sess-x\", withUsage: true },\n\t\t\t{ requestId: \"req-ctx-2\", sessionId: \"sess-x\", withUsage: false },\n\t\t]);\n\t\tconst result = await readDesktopContextUsage({ home, requestId: \"req-ctx-1\" });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(1);\n\t\texpect(result.items[0]!.requestId).toBe(\"req-ctx-1\");\n\t\texpect(result.items[0]!.estimatedTotal).toBe(400);\n\t\texpect(result.items[0]!.byCategory.conversation).toBe(200);\n\t\t// 旁列真实 usage（note 含 requestId）。\n\t\texpect(result.items[0]!.actual?.totalTokens).toBe(600);\n\t\texpect(result.items[0]!.actual?.cost).toBeCloseTo(0.006);\n\t});\n\n\tit(\"requestId 未命中标 notFound，不伪造空快照\", async () => {\n\t\tconst home = tempHome();\n\t\twriteContextSession(home, \"--proj-a--\", [{ requestId: \"req-other\", sessionId: \"sess-x\" }]);\n\t\tconst result = await readDesktopContextUsage({ home, requestId: \"req-missing\" });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(0);\n\t\texpect(result.notFound).toBe(true);\n\t});\n\n\tit(\"requestId 缺省列最近若干条；sessionId 过滤\", async () => {\n\t\tconst home = tempHome();\n\t\twriteContextSession(home, \"--proj-a--\", [\n\t\t\t{ requestId: \"req-1\", sessionId: \"sess-x\" },\n\t\t\t{ requestId: \"req-2\", sessionId: \"sess-y\" },\n\t\t]);\n\t\tconst all = await readDesktopContextUsage({ home });\n\t\texpect(all.ok).toBe(true);\n\t\tif (!all.ok) return;\n\t\texpect(all.items.length).toBe(2);\n\t\tconst onlyY = await readDesktopContextUsage({ home, sessionId: \"sess-y\" });\n\t\texpect(onlyY.ok).toBe(true);\n\t\tif (!onlyY.ok) return;\n\t\texpect(onlyY.items).toHaveLength(1);\n\t\texpect(onlyY.items[0]!.sessionId).toBe(\"sess-y\");\n\t});\n\n\tit(\"坏会话文件跳过不炸；无 sessions 目录返回空\", async () => {\n\t\tconst home = tempHome();\n\t\tconst dir = join(home, \"agent\", \"sessions\", \"--proj-b--\");\n\t\tmkdirSync(dir, { recursive: true });\n\t\twriteFileSync(join(dir, \"broken.jsonl\"), \"这不是有效会话文件\\n{{{\");\n\t\twriteContextSession(home, \"--proj-c--\", [{ requestId: \"req-ok\", sessionId: \"sess-z\" }]);\n\t\tconst result = await readDesktopContextUsage({ home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.items).toHaveLength(1);\n\t\texpect(result.items[0]!.requestId).toBe(\"req-ok\");\n\t\t// 空 home：无 sessions 目录。\n\t\tconst emptyHome = tempHome();\n\t\tconst empty = await readDesktopContextUsage({ home: emptyHome });\n\t\texpect(empty.ok).toBe(true);\n\t\tif (!empty.ok) return;\n\t\texpect(empty.items).toHaveLength(0);\n\t});\n\n\tit(\"O14：按文件 mtime 先选候选——旧会话占满 limit 时新会话仍被取到\", async () => {\n\t\t// 验收夹具：两个目录、limit 只容下旧会话窗口（目录枚举顺序先枚举到\n\t\t// 旧目录）、新会话文件 mtime 最新——按 mtime 先选候选后新会话必须进结果。\n\t\tconst home = tempHome();\n\t\tconst oldFile = writeContextSession(home, \"--proj-a-old--\", [\n\t\t\t{ requestId: \"req-old\", sessionId: \"sess-old\" },\n\t\t]);\n\t\tconst newFile = writeContextSession(home, \"--proj-b-new--\", [\n\t\t\t{ requestId: \"req-new\", sessionId: \"sess-new\" },\n\t\t]);\n\t\t// 把旧文件 mtime 拨早、新文件拨晚，制造「目录序靠前但更新」的落差。\n\t\tconst past = new Date(\"2026-11-01T00:00:00.000Z\");\n\t\tconst future = new Date(\"2026-11-14T00:00:00.000Z\");\n\t\tutimesSync(oldFile, past, past);\n\t\tutimesSync(newFile, future, future);\n\n\t\tconst result = await readDesktopContextUsage({ home, limit: 1 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// limit=1 只取 mtime 最新的候选文件：新会话的快照必须被取到。\n\t\texpect(result.items).toHaveLength(1);\n\t\texpect(result.items[0]!.requestId).toBe(\"req-new\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S2 批次 A 定向测试：extraction_jobs 持久任务与 source_exclusions 查询。\n *\t\t// O03/F07：重试判据是 consecutive_failures 而非 attempt_count——\n\t\t// 直接把连续失败推到上限，attempt_count 仍可低于上限。\n\t\tstore.db.preparestore.db\n\t\t\t.prepare(\"UPDATE extraction_jobs SET consecutive_failures = ? WHERE job_id = ?\")\n\t\t\t.run(MAX_ATTEMPTS, job.jobId);\n\t\t// 用死进程 claim（running + 持有者已死）\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT2 });\t\t// 多次成功批次后 attempt_count 累积很高，但 consecutive_failures 已清零——\n\t\t// 正常会话第三轮一次临时失败不该耗尽额度（O03/F07 修正目标）。\n\t\t(\"UPDATE extraction_jobs SET attempt_count = ? WHERE job_id = ?\").run(MAX_ATTEMPTS + 2, job.jobId);\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT2 });\n\t\t// attempt_count 超 MAX_ATTEMPTS 但 consecutive_failures=0：仍被恢复。\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,96]}}},{"equalLines":{"line_count":236}},{"diffOp":{"equal":{"range":[96,254]}}},{"diffOp":{"delete":{"range":[254,270]}}},{"diffOp":{"insert":{"range":[270,290]}}},{"diffOp":{"equal":{"range":[290,362]}}},{"diffOp":{"insert":{"range":[362,366]}}},{"diffOp":{"equal":{"range":[366,535]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[535,726]}}},{"diffOp":{"delete":{"range":[254,270]}}},{"diffOp":{"insert":{"range":[270,290]}}},{"diffOp":{"equal":{"range":[726,791]}}},{"diffOp":{"insert":{"range":[362,366]}}},{"diffOp":{"equal":{"range":[791,990]}}},{"equalLines":{"line_count":128}},{"diffOp":{"equal":{"range":[990,999]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-extraction-jobs.test.ts"},"span":null,"sourceCode":"/**\n * S2 批次 A 定向测试：extraction_jobs 持久任务与 source_exclusions 查询。\n *\n * 覆盖：同 scope_key 幂等、并发领取恰一个成功、游标推进不重复、\n * 崩溃恢复（running 持有者已死→可重取）、失败保留原因与范围、\n * 重试上限转终态、isSourceExcluded 命中/未命中、listExcludedSourceIds 过滤。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-extraction-jobs.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport {\n\tadvanceCursor,\n\tclaimJob,\n\tcompleteJob,\n\tcreateJob,\n\tfailJob,\n\tMAX_ATTEMPTS,\n\trecoverJobs,\n} from \"../../src/pao/memory/extraction-jobs.ts\";\nimport { isSourceExcluded, listExcludedSourceIds } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-jobs-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst AT3 = \"2026-11-08T10:02:00.000Z\";\n\ndescribe(\"createJob\", () => {\n\tit(\"同 scopeKey 幂等：重复创建返回已有 job，不重复入库\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst first = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\", fromEntry: \"e1\", toEntry: \"e10\" }),\n\t\t\tscopeKey: \"s1:e1:e10\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.status).toBe(\"pending\");\n\t\texpect(first.attemptCount).toBe(0);\n\n\t\t// 同 scopeKey 再建：返回同一 jobId，不新建\n\t\tconst second = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\", fromEntry: \"e1\", toEntry: \"e10\" }),\n\t\t\tscopeKey: \"s1:e1:e10\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.jobId).toBe(first.jobId);\n\t\texpect(second.createdAt).toBe(AT); // 保留首次创建时间\n\n\t\t// 不同 scopeKey 新建\n\t\tconst third = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\", fromEntry: \"e11\", toEntry: \"e20\" }),\n\t\t\tscopeKey: \"s1:e11:e20\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(third.jobId).not.toBe(first.jobId);\n\n\t\tconst count = store.db.prepare(\"SELECT COUNT(*) AS c FROM extraction_jobs\").get() as { c: number };\n\t\texpect(count.c).toBe(2);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"claimJob\", () => {\n\tit(\"pending→running：记 owner_process 与 attempt_count\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tconst claimed = claimJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\tclaimedAt: AT2,\n\t\t});\n\t\texpect(claimed).not.toBeUndefined();\n\t\texpect(claimed!.job.status).toBe(\"running\");\n\t\texpect(claimed!.job.ownerProcess).toBe(`pid-${process.pid}`);\n\t\texpect(claimed!.job.attemptCount).toBe(1);\n\t\texpect(claimed!.attemptId).toMatch(/^att-/);\n\t\tstore.close();\n\t});\n\n\tit(\"并发领取：两个进程同时 claim 同一 pending job，恰一个成功\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 两个\"进程\"同时领取：第一个成功，第二个被拒（job 已 running）\n\t\tconst first = claimJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\tclaimedAt: AT2,\n\t\t});\n\t\texpect(first).not.toBeUndefined();\n\n\t\t// 模拟另一个进程（用不存在的 PID 伪装另一个 owner）\n\t\t// running 状态下持有者存活 → 不抢\n\t\tconst second = claimJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\townerProcess: \"pid-99999\",\n\t\t\tclaimedAt: AT3,\n\t\t});\n\t\texpect(second).toBeUndefined();\n\t\tstore.close();\n\t});\n\n\tit(\"done/failed 终态不可领取\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT2 });\n\t\tcompleteJob(store, { jobId: job.jobId, completedAt: AT3 });\n\t\tconst again = claimJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\tclaimedAt: AT3,\n\t\t});\n\t\texpect(again).toBeUndefined();\n\n\t\t// failed 终态也不可直接领取（需 recoverJobs 先重取为 pending）\n\t\tconst job2 = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s2\" }),\n\t\t\tscopeKey: \"s2:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tclaimJob(store, { jobId: job2.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT2 });\n\t\tfailJob(store, { jobId: job2.jobId, reason: \"测试失败\", failedAt: AT3 });\n\t\tconst claimFailed = claimJob(store, {\n\t\t\tjobId: job2.jobId,\n\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\tclaimedAt: AT3,\n\t\t});\n\t\texpect(claimFailed).toBeUndefined();\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"advanceCursor\", () => {\n\tit(\"游标推进后重跑只处理未提交范围\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\", fromEntry: \"e1\", toEntry: \"e10\" }),\n\t\t\tscopeKey: \"s1:e1:e10\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT2 });\n\n\t\t// 推进游标到 e5\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e5\", advancedAt: AT2 });\n\t\tconst row = store.db.prepare(\"SELECT cursor FROM extraction_jobs WHERE job_id = ?\").get(job.jobId) as {\n\t\t\tcursor: string;\n\t\t};\n\t\texpect(row.cursor).toBe(\"e5\");\n\n\t\t// 再推进到 e8\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e8\", advancedAt: AT3 });\n\t\tconst row2 = store.db.prepare(\"SELECT cursor FROM extraction_jobs WHERE job_id = ?\").get(job.jobId) as {\n\t\t\tcursor: string;\n\t\t};\n\t\texpect(row2.cursor).toBe(\"e8\");\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"recoverJobs\", () => {\n\tit(\"running 持有者已死 → 重取为 pending，可再被 claimJob 领取\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 用一个不存在的 PID 模拟已死持有者\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT2 });\n\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered).toHaveLength(1);\n\t\texpect(recovered.recovered[0].jobId).toBe(job.jobId);\n\t\texpect(recovered.recovered[0].status).toBe(\"pending\");\n\n\t\t// 恢复后可再领取\n\t\tconst reclaimed = claimJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\tclaimedAt: AT3,\n\t\t});\n\t\texpect(reclaimed).not.toBeUndefined();\n\t\texpect(reclaimed!.job.status).toBe(\"running\");\n\t\tstore.close();\n\t});\n\n\tit(\"running 持有者存活 → 不恢复\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 当前进程 PID 存活\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT2 });\n\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered).toHaveLength(0);\n\t\tstore.close();\n\t});\n\n\tit(\"consecutive_failures 达上限不恢复；attempt_count 只作历史总次数\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// O03/F07：重试判据是 consecutive_failures 而非 attempt_count——\n\t\t// 直接把连续失败推到上限，attempt_count 仍可低于上限。\n\t\tstore.db.prepare(\"UPDATE extraction_jobs SET consecutive_failures = ? WHERE job_id = ?\").run(MAX_ATTEMPTS, job.jobId);\n\t\t// 用死进程 claim（running + 持有者已死）\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT2 });\n\t\t// consecutive_failures 已超限：普通 failed 死进程 job 不再被恢复。\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered).toHaveLength(0); // 超限不恢复\n\t\tstore.close();\n\t});\n\n\tit(\"attempt_count 高但 consecutive_failures 未超限仍可恢复（历史累计不耗额度）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 多次成功批次后 attempt_count 累积很高，但 consecutive_failures 已清零——\n\t\t// 正常会话第三轮一次临时失败不该耗尽额度（O03/F07 修正目标）。\n\t\tstore.db.prepare(\"UPDATE extraction_jobs SET attempt_count = ? WHERE job_id = ?\").run(MAX_ATTEMPTS + 2, job.jobId);\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT2 });\n\t\t// attempt_count 超 MAX_ATTEMPTS 但 consecutive_failures=0：仍被恢复。\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered).toHaveLength(1);\n\t\texpect(recovered.recovered[0].jobId).toBe(job.jobId);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"failJob\", () => {\n\tit(\"失败保留原因、已知用量与未提交范围\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\", fromEntry: \"e1\", toEntry: \"e10\" }),\n\t\t\tscopeKey: \"s1:e1:e10\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT2 });\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e3\", advancedAt: AT2 });\n\n\t\tconst failed = failJob(store, {\n\t\t\tjobId: job.jobId,\n\t\t\treason: \"模型调用超时\",\n\t\t\tlastUsage: JSON.stringify({ inputTokens: 100, outputTokens: 50 }),\n\t\t\tfailedAt: AT3,\n\t\t});\n\t\texpect(failed.status).toBe(\"failed\");\n\t\texpect(failed.lastError).toBe(\"模型调用超时\");\n\t\texpect(failed.lastUsage).toBe(JSON.stringify({ inputTokens: 100, outputTokens: 50 }));\n\t\texpect(failed.cursor).toBe(\"e3\"); // 未提交范围保留\n\t\tstore.close();\n\t});\n\n\tit(\"重试上限：attempt_count 达 MAX_ATTEMPTS 后 failJob 转终态\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"s1\" }),\n\t\t\tscopeKey: \"s1:all\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 循环 claim→fail 直到上限\n\t\tfor (let i = 0; i < MAX_ATTEMPTS; i++) {\n\t\t\tconst claimed = claimJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\townerProcess: `pid-${process.pid}`,\n\t\t\t\tclaimedAt: AT,\n\t\t\t});\n\t\t\texpect(claimed).not.toBeUndefined();\n\t\t\tconst failed = failJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `第 ${i + 1} 次失败`,\n\t\t\t\tfailedAt: AT,\n\t\t\t});\n\t\t\texpect(failed.attemptCount).toBe(i + 1);\n\t\t\tif (i < MAX_ATTEMPTS - 1) {\n\t\t\t\t// 未达上限：recoverJobs 可重取\n\t\t\t\tconst recovered = recoverJobs(store, AT2);\n\t\t\t\texpect(recovered.recovered).toHaveLength(1);\n\t\t\t}\n\t\t}\n\t\t// 达上限后：failed 终态，recoverJobs 不再恢复\n\t\tconst finalRow = store.db\n\t\t\t.prepare(\"SELECT status, attempt_count FROM extraction_jobs WHERE job_id = ?\")\n\t\t\t.get(job.jobId) as { status: string; attempt_count: number };\n\t\texpect(finalRow.status).toBe(\"failed\");\n\t\texpect(finalRow.attempt_count).toBe(MAX_ATTEMPTS);\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered).toHaveLength(0);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"isSourceExcluded / listExcludedSourceIds\", () => {\n\tit(\"按 sourceId 命中/未命中\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t// 手动插入排除记录（模拟 deletion.ts 的写入）\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO source_exclusions (exclusion_id, source_id, session_id, entry_id, reason, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"exc-1\", \"src-s1-e1-user\", \"s1\", \"e1\", \"memory 删除:mem-x\", AT);\n\n\t\texpect(isSourceExcluded(store.db, { sourceId: \"src-s1-e1-user\" })).toBe(true);\n\t\texpect(isSourceExcluded(store.db, { sourceId: \"src-other\" })).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"按 sessionId+entryId 命中/未命中\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO source_exclusions (exclusion_id, source_id, session_id, entry_id, reason, created_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"exc-1\", null, \"s1\", \"e1\", \"memory 删除:mem-x\", AT);\n\n\t\texpect(isSourceExcluded(store.db, { sessionId: \"s1\", entryId: \"e1\" })).toBe(true);\n\t\texpect(isSourceExcluded(store.db, { sessionId: \"s1\", entryId: \"e2\" })).toBe(false);\n\t\texpect(isSourceExcluded(store.db, { sessionId: \"s2\", entryId: \"e1\" })).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"listExcludedSourceIds：按会话过滤与全量\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst stmt = store.db.prepare(\n\t\t\t`INSERT INTO source_exclusions (exclusion_id, source_id, session_id, entry_id, reason, created_at)\n\t\t\t VALUES (?, ?, ?, ?, ?, ?)`,\n\t\t);\n\t\tstmt.run(\"exc-1\", \"src-s1-e1\", \"s1\", \"e1\", \"删除1\", AT);\n\t\tstmt.run(\"exc-2\", \"src-s1-e2\", \"s1\", \"e2\", \"删除2\", AT);\n\t\tstmt.run(\"exc-3\", \"src-s2-e1\", \"s2\", \"e1\", \"删除3\", AT);\n\t\tstmt.run(\"exc-4\", null, \"s1\", \"e9\", \"删除无source_id\", AT); // 无 source_id 不返\n\n\t\tconst all = listExcludedSourceIds(store.db);\n\t\texpect(all).toHaveLength(3);\n\t\texpect(all).toContain(\"src-s1-e1\");\n\t\texpect(all).toContain(\"src-s1-e2\");\n\t\texpect(all).toContain(\"src-s2-e1\");\n\n\t\tconst s1Only = listExcludedSourceIds(store.db, \"s1\");\n\t\texpect(s1Only).toHaveLength(2);\n\t\texpect(s1Only).toContain(\"src-s1-e1\");\n\t\texpect(s1Only).toContain(\"src-s1-e2\");\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";import { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { createCapturereadSegmentLines, sealSegment } from \"../../src/pao/memory/capture.tsarchive.ts\";\n\tadvanceCursor,\n\tclaimJob,\n\tcreateJob,\n\tfailJob,\n\tMAX_ATTEMPTS,\n\trecoverJobs,\n createCapture extraction-jobs.ts readSegmentLines, sealSegment \n\tclaimJob,\n\tcreateJob,\n\tfailJob,\n\tMAX_ATTEMPTS,\n\trecoverJobs,\n\nimport { registerExtractionScheduler } from \"../../src/pao/memory/extraction-scheduler.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,114]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[114,333]}}},{"diffOp":{"equal":{"range":[333,343]}}},{"diffOp":{"delete":{"range":[343,356]}}},{"diffOp":{"insert":{"range":[356,373]}}},{"diffOp":{"equal":{"range":[373,374]}}},{"diffOp":{"insert":{"range":[374,386]}}},{"diffOp":{"equal":{"range":[386,415]}}},{"diffOp":{"delete":{"range":[415,425]}}},{"diffOp":{"insert":{"range":[425,435]}}},{"diffOp":{"equal":{"range":[435,437]}}},{"diffOp":{"equal":{"range":[333,342]}}},{"diffOp":{"delete":{"range":[437,516]}}},{"diffOp":{"insert":{"range":[516,531]}}},{"diffOp":{"equal":{"range":[386,415]}}},{"diffOp":{"delete":{"range":[531,549]}}},{"diffOp":{"insert":{"range":[415,425]}}},{"diffOp":{"equal":{"range":[435,437]}}},{"diffOp":{"equal":{"range":[333,342]}}},{"diffOp":{"delete":{"range":[549,566]}}},{"diffOp":{"insert":{"range":[437,452]}}},{"diffOp":{"equal":{"range":[566,567]}}},{"diffOp":{"delete":{"range":[567,580]}}},{"diffOp":{"insert":{"range":[580,643]}}},{"diffOp":{"equal":{"range":[386,415]}}},{"diffOp":{"delete":{"range":[425,435]}}},{"diffOp":{"insert":{"range":[531,549]}}},{"diffOp":{"equal":{"range":[435,437]}}},{"diffOp":{"equal":{"range":[643,804]}}},{"equalLines":{"line_count":950}},{"diffOp":{"equal":{"range":[804,813]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-extraction-scheduler.test.ts"},"span":[0,46],"sourceCode":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage } from \"@pao/ai\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport {\n\tadvanceCursor,\n\tclaimJob,\n\tcreateJob,\n\tfailJob,\n\tMAX_ATTEMPTS,\n\trecoverJobs,\n} from \"../../src/pao/memory/extraction-jobs.ts\";\nimport { readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { registerExtractionScheduler } from \"../../src/pao/memory/extraction-scheduler.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type {\n\tExtractModelInput,\n\tExtractModelOutput,\n\tMemoryScope,\n\tRelatedMemorySummary,\n} from \"../../src/pao/memory/types.ts\";\n\nconst requestState = vi.hoisted(() => ({\n\thandle: undefined as ((deps: unknown, input: ExtractModelInput) => Promise<ExtractModelOutput>) | undefined,\n}));\n\nvi.mock(\"../../src/pao/memory/extract-model.ts\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"../../src/pao/memory/extract-model.ts\")>();\n\treturn {\n\t\t...actual,\n\t\trequestExtraction: (deps: unknown, input: ExtractModelInput) => {\n\t\t\tif (requestState.handle === undefined) throw new Error(\"测试未安装提炼响应\");\n\t\t\treturn requestState.handle(deps, input);\n\t\t},\n\t};\n});\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-09T10:00:00.000Z\";\nconst AT2 = \"2026-11-09T10:01:00.000Z\";\nconst AT3 = \"2026-11-09T10:02:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-scheduler-stale\" };\n\nafterEach(() => {\n\trequestState.handle = undefined;\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite/WAL handles may still be closing on Windows.\n\t\t}\n\t}\n});\n\nasync function waitFor(check: () => boolean): Promise<void> {\n\tfor (let attempt = 0; attempt < 100; attempt++) {\n\t\tif (check()) return;\n\t\tawait new Promise((resolve) => setTimeout(resolve, 10));\n\t}\n\tthrow new Error(\"等待 scheduler 收尾超时\");\n}\n\ndescribe(\"extraction scheduler\", () => {\n\tit(\"stale 候选保留 failed 与 cursor，其他候选正常提交且 recovery 不自动重放\", async () => {\n\t\tconst home = mkdtempSync(join(tmpdir(), \"pao-mem-scheduler-\"));\n\t\ttempDirs.push(home);\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sessionId = \"sess-scheduler-stale\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst assistantEntryId = manager.appendMessage(\n\t\t\tfauxAssistantMessage(\"目前缺省 top3。\", { timestamp: Date.parse(AT) }),\n\t\t);\n\t\tconst userEntryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"改成 top5。\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst independentEntryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"侧边栏宽度固定为 320px。\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst capture = createCapture({\n\t\t\tstore,\n\t\t\tpaoHome: home,\n\t\t\tnow: () => AT,\n\t\t\tresolveSessionProject: () => SCOPE.projectId,\n\t\t});\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst assistantSourceId = capture.captureCommittedEntry(\n\t\t\tsessionId,\n\t\t\tmanager.getEntry(assistantEntryId)!,\n\t\t\tundefined,\n\t\t\tAT,\n\t\t).sourceId!;\n\t\tconst userSourceId = capture.captureCommittedEntry(sessionId, manager.getEntry(userEntryId)!, undefined, AT)\n\t\t\t.sourceId!;\n\t\tconst independentSourceId = capture.captureCommittedEntry(\n\t\t\tsessionId,\n\t\t\tmanager.getEntry(independentEntryId)!,\n\t\t\tundefined,\n\t\t\tAT,\n\t\t).sourceId!;\n\t\tconst sourceIds = [assistantSourceId, userSourceId];\n\t\tconst old = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...SCOPE, sessionId },\n\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds,\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!old.ok) throw new Error(old.error.message);\n\t\tconst existingJob = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId, projectId: SCOPE.projectId }),\n\t\t\tscopeKey: `session:${sessionId}`,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tadvanceCursor(store, {\n\t\t\tjobId: existingJob.jobId,\n\t\t\tcursor: \"cursor-before-stale-batch\",\n\t\t\tadvancedAt: AT,\n\t\t});\n\n\t\tlet requestSnapshot: RelatedMemorySummary[] | undefined;\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\trequestCount += 1;\n\t\t\trequestSnapshot = input.relatedMemories;\n\t\t\tconst corrected = await service.correctMemory({\n\t\t\t\tid: old.id,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: \"自动召回每轮 top3\",\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t},\n\t\t\t\tsource: { sessionId },\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tif (!corrected.ok) throw new Error(corrected.error.message);\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds,\n\t\t\t\t\t\tquotedSpans: [\n\t\t\t\t\t\t\t{ sourceId: assistantSourceId, text: \"缺省 top3\" },\n\t\t\t\t\t\t\t{ sourceId: userSourceId, text: \"改成 top5\" },\n\t\t\t\t\t\t],\n\t\t\t\t\t\tspanLocations: [\n\t\t\t\t\t\t\t{ sourceId: assistantSourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t\t{ sourceId: userSourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t],\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"侧边栏宽度固定为 320px。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [independentSourceId],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: independentSourceId, text: \"320px\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: independentSourceId, match: \"exact\", offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-scheduler-stale\",\n\t\t\t};\n\t\t};\n\n\t\tconst handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();\n\t\tconst pi = {\n\t\t\ton(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {\n\t\t\t\thandlers.set(event, handler);\n\t\t\t\treturn () => handlers.delete(event);\n\t\t\t},\n\t\t} as unknown as ExtensionAPI;\n\t\tconst unmount = registerExtractionScheduler(pi, {\n\t\t\tstore,\n\t\t\tservice,\n\t\t\tpaoHome: home,\n\t\t\tledger: {\n\t\t\t\tappendUsage: vi.fn(),\n\t\t\t\tappendCustomEntry: vi.fn(),\n\t\t\t} as never,\n\t\t\tresolveScope: () => ({ ...SCOPE, sessionId }),\n\t\t\tnow: () => AT,\n\t\t});\n\t\tconst ctx = {\n\t\t\tsessionManager: manager,\n\t\t\tcwd: home,\n\t\t\tmodelRegistry: {},\n\t\t} as unknown as ExtensionContext;\n\n\t\ttry {\n\t\t\tawait handlers.get(\"turn_end\")?.({}, ctx);\n\t\t\tawait handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, ctx);\n\t\t\tawait waitFor(() => {\n\t\t\t\tconst row = store.db\n\t\t\t\t\t.prepare(\"SELECT status FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t\t.get(`session:${sessionId}`) as { status: string } | undefined;\n\t\t\t\treturn row?.status === \"failed\";\n\t\t\t});\n\n\t\t\texpect(requestSnapshot).toEqual([\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\tmemoryId: old.id,\n\t\t\t\t\tcurrentRevision: 1,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t]);\n\t\t\tconst job = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT status, cursor, attempt_count, last_error\n\t\t\t\t\t FROM extraction_jobs WHERE scope_key = ?`,\n\t\t\t\t)\n\t\t\t\t.get(`session:${sessionId}`) as {\n\t\t\t\tstatus: string;\n\t\t\t\tcursor: string | null;\n\t\t\t\tattempt_count: number;\n\t\t\t\tlast_error: string | null;\n\t\t\t};\n\t\t\texpect(job).toMatchObject({\n\t\t\t\tstatus: \"failed\",\n\t\t\t\tcursor: \"cursor-before-stale-batch\",\n\t\t\t\tattempt_count: 1,\n\t\t\t});\n\t\t\texpect(job.last_error).toContain(\"stale_request_snapshot:\");\n\t\t\texpect(job.last_error).toContain(`${old.id}@rev1`);\n\t\t\texpect(job.last_error).toContain(\"已提交候选=1\");\n\n\t\t\tconst recovered = recoverJobs(store, AT2);\n\t\t\texpect(recovered.recovered).toEqual([]);\n\t\t\tconst stillFailed = store.db\n\t\t\t\t.prepare(\"SELECT status FROM extraction_jobs WHERE job_id = ?\")\n\t\t\t\t.get(existingJob.jobId) as { status: string };\n\t\t\texpect(stillFailed.status).toBe(\"failed\");\n\t\t\texpect(requestCount).toBe(1);\n\n\t\t\tconst activeRows = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.id, m.current_revision, r.content_json\n\t\t\t\t\t FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?`,\n\t\t\t\t)\n\t\t\t\t.all(SCOPE.projectId) as Array<{ id: string; current_revision: number; content_json: string }>;\n\t\t\texpect(activeRows).toHaveLength(2);\n\t\t\tconst corrected = activeRows.find((row) => row.id === old.id);\n\t\t\texpect(corrected!.current_revision).toBe(2);\n\t\t\texpect(JSON.parse(corrected!.content_json).conclusion).toBe(\"自动召回每轮 top3\");\n\t\t\texpect(\n\t\t\t\tactiveRows.filter((row) => JSON.parse(row.content_json).conclusion === \"侧边栏宽度固定为 320px。\"),\n\t\t\t).toHaveLength(1);\n\t\t} finally {\n\t\t\tunmount();\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\t// ════════════════════════════════════════════════════════════════════\n\t// O03 定向用例：跨会话续作 / 重试预算 / 读失败游标 / 停用不复活 / 忙不新领\n\t// ════════════════════════════════════════════════════════════════════\n\n\tinterface SchedulerFixture {\n\t\thome: string;\n\t\tstore: ReturnType<typeof openMemoryStore>;\n\t\tservice: ReturnType<typeof openMemoryService>;\n\t\tmanager: SessionManager;\n\t\tcapture: ReturnType<typeof createCapture>;\n\t\thandlers: Map<string, (event: unknown, ctx: ExtensionContext) => unknown>;\n\t\tctx: ExtensionContext;\n\t\tunmount: () => void;\n\t\tsessionId: string;\n\t}\n\n\t/** 装配一个会话 + 调度器（ledger 用空实现；ctx 只带调度器用到的字段）。 */\n\tasync function schedulerFixture(\n\t\tsessionId: string,\n\t\tscope: MemoryScope,\n\t\topts: {\n\t\t\thome?: string;\n\t\t\tstore?: ReturnType<typeof openMemoryStore>;\n\t\t\tservice?: ReturnType<typeof openMemoryService>;\n\t\t\treadSegment?: (\n\t\t\t\tsegment: { segmentId: string },\n\t\t\t) => Promise<{ lines: string[]; archived: boolean } | undefined>;\n\t\t} = {},\n\t): Promise<SchedulerFixture> {\n\t\tconst home = opts.home ?? mkdtempSync(join(tmpdir(), \"pao-mem-scheduler-\"));\n\t\ttempDirs.push(home);\n\t\tconst store = opts.store ?? openMemoryStore(home, \"readwrite\");\n\t\tconst service = opts.service ?? openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst capture = createCapture({\n\t\t\tstore,\n\t\t\tpaoHome: home,\n\t\t\tnow: () => AT,\n\t\t\tresolveSessionProject: () => scope.projectId,\n\t\t});\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();\n\t\tconst pi = {\n\t\t\ton(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {\n\t\t\t\thandlers.set(event, handler);\n\t\t\t\treturn () => handlers.delete(event);\n\t\t\t},\n\t\t} as unknown as ExtensionAPI;\n\t\tconst unmount = registerExtractionScheduler(pi, {\n\t\t\tstore,\n\t\t\tservice,\n\t\t\tpaoHome: home,\n\t\t\tledger: { appendUsage: vi.fn(), appendCustomEntry: vi.fn() } as never,\n\t\t\tresolveScope: () => scope,\n\t\t\t...(opts.readSegment === undefined ? {} : { readSegment: opts.readSegment }),\n\t\t\tnow: () => AT,\n\t\t});\n\t\tconst ctx = { sessionManager: manager, cwd: home, modelRegistry: {} } as unknown as ExtensionContext;\n\t\treturn { home, store, service, manager, capture, handlers, ctx, unmount, sessionId };\n\t}\n\n\tfunction appendUserSource(fx: SchedulerFixture, text: string, sessionId = fx.sessionId, at = AT): string {\n\t\tconst entryId = fx.manager.appendMessage({ role: \"user\", content: text, timestamp: Date.parse(at) });\n\t\tconst captured = fx.capture.captureCommittedEntry(sessionId, fx.manager.getEntry(entryId)!, undefined, at);\n\t\treturn captured.sourceId!;\n\t}\n\n\tfunction jobRow(store: ReturnType<typeof openMemoryStore>, scopeKey: string) {\n\t\treturn store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT job_id, status, cursor, attempt_count, consecutive_failures, last_error\n\t\t\t\t FROM extraction_jobs WHERE scope_key = ?`,\n\t\t\t)\n\t\t\t.get(scopeKey) as\n\t\t\t| { job_id: string; status: string; cursor: string | null; attempt_count: number; consecutive_failures: number; last_error: string | null }\n\t\t\t| undefined;\n\t}\n\n\tit(\"O03/F06：A 会话退出后，B 会话的调度器捞起库内 pending job 并按 A 的身份续作\", async () => {\n\t\t// 会话 A：建库留 1 条用户来源 + 1 个 pending job（A 随后「退出」=不再装配）。\n\t\tconst scopeA: MemoryScope = { projectId: \"proj-a\", sessionId: \"sess-a\" };\n\t\tconst fxA = await schedulerFixture(\"sess-a\", scopeA);\n\t\tconst sourceA = appendUserSource(fxA, \"构建命令固定为 pnpm build。\");\n\t\tcreateJob(fxA.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-a\", projectId: \"proj-a\" }),\n\t\t\tscopeKey: \"session:sess-a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// A 的调度器不触发任何 drain——模拟 A 直接退出（保留库内 pending）。\n\t\tfxA.unmount();\n\n\t\t// 会话 B：同一 PAO_HOME、不同 SessionManager/scope——B 不该拿自己的身份做 A 的 job。\n\t\tconst scopeB: MemoryScope = { projectId: \"proj-b\", sessionId: \"sess-b\" };\n\t\tconst fxB = await schedulerFixture(\"sess-b\", scopeB, {\n\t\t\thome: fxA.home,\n\t\t\tstore: fxA.store,\n\t\t\tservice: fxA.service,\n\t\t});\n\t\tlet requestCount = 0;\n\t\tlet requestSourceSession: string | undefined;\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\trequestCount += 1;\n\t\t\trequestSourceSession = input.sourceSessionId;\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [sourceA],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: sourceA, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: sourceA, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-continuation\",\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fxB.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fxB.ctx);\n\t\t\tawait waitFor(() => jobRow(fxB.store, \"session:sess-a\")?.status === \"done\");\n\n\t\t\texpect(requestCount).toBe(1);\n\t\t\t// 提炼请求的归属会话是 job 自带的 A，不是消费方 B。\n\t\t\texpect(requestSourceSession).toBe(\"sess-a\");\n\t\t\t// 记忆落 A 的 scope（projectId=proj-a、sessionId=sess-a），不借 B 的身份。\n\t\t\tconst memory = fxB.store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.scope_json FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t\t WHERE json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t\t)\n\t\t\t\t.get(\"构建命令固定为 pnpm build。\") as { scope_json: string } | undefined;\n\t\t\texpect(memory).toBeDefined();\n\t\t\tconst scope = JSON.parse(memory!.scope_json) as { projectId: string; sessionId?: string };\n\t\t\texpect(scope.projectId).toBe(\"proj-a\");\n\t\t\texpect(scope.sessionId).toBe(\"sess-a\");\n\t\t} finally {\n\t\t\tfxB.unmount();\n\t\t\tawait fxB.service.close();\n\t\t\tfxB.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F07：连续失败按未提交批次计——成功批次清零 consecutive_failures，临时失败可恢复\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f07\", sessionId: \"sess-f07\" };\n\t\tconst fx = await schedulerFixture(\"sess-f07\", scope);\n\t\tconst store = fx.store;\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-f07\", projectId: \"proj-f07\" }),\n\t\t\tscopeKey: \"session:sess-f07\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 三次连续失败（未提交批次）：consecutive_failures 到上限 → 终态不恢复。\n\t\tfor (let i = 0; i < MAX_ATTEMPTS; i++) {\n\t\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT });\n\t\t\tfailJob(store, { jobId: job.jobId, reason: `第${i + 1}次失败`, failedAt: AT });\n\t\t\tif (i < MAX_ATTEMPTS - 1) recoverJobs(store, AT);\n\t\t}\n\t\texpect(recoverJobs(store, AT2).recovered).toHaveLength(0);\n\t\tconst afterMax = jobRow(store, \"session:sess-f07\")!;\n\t\texpect(afterMax.status).toBe(\"failed\");\n\t\texpect(afterMax.consecutive_failures).toBe(MAX_ATTEMPTS);\n\n\t\t// 模拟「失败之间有成功批次」：advanceCursor（已提交批次边界）清零连续失败，\n\t\t// 此后一次临时失败不应触终态——这正是 attempt_count 口径会误杀的场景。\n\t\tstore.db\n\t\t\t.prepare(\"UPDATE extraction_jobs SET status='running', consecutive_failures=2 WHERE job_id=?\")\n\t\t\t.run(job.jobId);\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"src-batch-committed\", advancedAt: AT2 });\n\t\tconst reset = jobRow(store, \"session:sess-f07\")!;\n\t\texpect(reset.consecutive_failures).toBe(0);\n\t\tfailJob(store, { jobId: job.jobId, reason: \"临时失败\", failedAt: AT2 });\n\t\t// consecutive_failures=1 < 上限：recoverJobs 恢复为 pending。\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered.map((r) => r.jobId)).toContain(job.jobId);\n\t\tfx.unmount();\n\t\tawait fx.service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"O03/F13：批内中间来源读取失败 → 游标停在失败批前，恢复后不重跑已提交候选\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f13\", sessionId: \"sess-f13\" };\n\t\tconst fx = await schedulerFixture(\"sess-f13\", scope);\n\t\t// captured_at 递增保证来源顺序（同刻回退 source_id 排序不可控）。\n\t\tconst s1 = appendUserSource(fx, \"第一条：保留窗口一。\", fx.sessionId, AT);\n\t\tconst s2 = appendUserSource(fx, \"第二条：保留窗口二。\", fx.sessionId, AT2);\n\t\tconst s3 = appendUserSource(fx, \"第三条：保留窗口三。\", fx.sessionId, AT3);\n\t\t// 末尾再挂一条全排除批：task-c 的 s4 记进 source_exclusions——\n\t\t// 整批被排除时游标应照常推进（确定状态，不发请求）。\n\t\tconst s4 = appendUserSource(fx, \"第四条：已被删除排除。\", fx.sessionId, \"2026-11-09T10:03:00.000Z\");\n\t\tfx.store.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO source_exclusions (exclusion_id, source_id, session_id, entry_id, reason, created_at)\n\t\t\t\t VALUES (?, ?, ?, NULL, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"exc-f13\", s4, \"sess-f13\", \"memory 删除:mem-x\", AT3);\n\t\t// 把来源切成三批：s1 归 task-a，s2/s3 归 task-b，s4 归 task-c——\n\t\t// 批1提交后批2读失败；恢复后批2续跑、批3全排除只推游标。\n\t\tfx.store.db.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-a' WHERE source_id=?\").run(s1);\n\t\tfx.store.db\n\t\t\t.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-b' WHERE source_id IN (?, ?)\")\n\t\t\t.run(s2, s3);\n\t\tfx.store.db.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-c' WHERE source_id=?\").run(s4);\n\n\t\t// 让 s2 回读失败：来源行的段引用指向不存在的段——readSourceEvents 如实\n\t\t// 返回 source_missing（同会话三个来源共用同一段文件，动文件会误伤 s1/s3）。\n\t\tconst s2Segment = (fx.store.db\n\t\t\t.prepare(\"SELECT segment_id FROM sources WHERE source_id=?\")\n\t\t\t.get(s2) as { segment_id: string }).segment_id;\n\t\tfx.store.db.prepare(\"UPDATE sources SET segment_id='seg-gone' WHERE source_id=?\").run(s2);\n\n\t\tconst seenBatches: string[][] = [];\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\tseenBatches.push(input.entries.map((e) => e.sourceId));\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"experience\",\n\t\t\t\t\t\tconclusion: `经验-${input.entries[0]!.sourceId}`,\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [input.entries[0]!.sourceId],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: input.entries[0]!.sourceId, text: input.entries[0]!.content.slice(0, 10) }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: input.entries[0]!.sourceId, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-${seenBatches.length}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\t// s1 先提交（批1）→ s2 读失败（批2）→ failJob，游标停在 s1（失败批前）。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f13\")?.status === \"failed\");\n\n\t\t\tconst failed = jobRow(fx.store, \"session:sess-f13\")!;\n\t\t\texpect(failed.cursor).toBe(s1);\n\t\t\texpect(failed.last_error).toContain(\"来源读取失败\");\n\t\t\texpect(failed.last_error).toContain(s2);\n\t\t\texpect(seenBatches).toEqual([[s1]]); // 只请求过批1\n\n\t\t\t// 恢复 s2 段引用 → 下轮从 s2 续，不重跑 s1（不重复提交）。\n\t\t\tfx.store.db.prepare(\"UPDATE sources SET segment_id=? WHERE source_id=?\").run(s2Segment, s2);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f13\")?.status === \"done\");\n\t\t\t// 批2 续跑 s2/s3；批3（s4）整批排除不发请求，游标仍推进到 s4 → job done。\n\t\t\texpect(seenBatches).toEqual([[s1], [s2, s3]]);\n\t\t\texpect(jobRow(fx.store, \"session:sess-f13\")!.cursor).toBe(s4);\n\t\t\tconst memoryCount = fx.store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS c FROM memories\")\n\t\t\t\t.get() as { c: number };\n\t\t\texpect(memoryCount.c).toBe(2); // s1 一条 + s2/s3 批一条，s1 未重复。\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F05：同来源候选不复活已停用记忆；全新来源同结论可正常新建\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f05\", sessionId: \"sess-f05\" };\n\t\tconst fx = await schedulerFixture(\"sess-f05\", scope);\n\t\tconst s1 = appendUserSource(fx, \"构建命令固定为 pnpm build。\");\n\t\tconst created = await fx.service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...scope },\n\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\t// 用户明确停用该记忆（rev2 继承来源链接）。\n\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-f05\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\tif (!stopped.ok) throw new Error(stopped.error.message);\n\n\t\trequestState.handle = async (_deps, _input) => ({\n\t\t\tcandidates: [\n\t\t\t\t{\n\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\tsourceIds: [s1],\n\t\t\t\t\tquotedSpans: [{ sourceId: s1, text: \"pnpm build\" }],\n\t\t\t\t\tspanLocations: [{ sourceId: s1, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t},\n\t\t\t],\n\t\t\trejected: [],\n\t\t\trequestId: \"req-f05\",\n\t\t});\n\n\t\ttry {\n\t\t\t// 同来源重放：候选命中 stopped 记忆 → source_resting_stopped → 需重评，不新建。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f05\")?.status === \"failed\");\n\t\t\tconst failed = jobRow(fx.store, \"session:sess-f05\")!;\n\t\t\t// source_resting_stopped 与语义冲突同口径：记需重评前缀 + stopped=<memoryId>，\n\t\t\t// 游标不推进（last_error 前缀即「不自动重放」的 needs-reevaluation 标记）。\n\t\t\texpect(failed.last_error).toContain(\"stale_request_snapshot:\");\n\t\t\texpect(failed.last_error).toContain(`stopped=${created.id}`);\n\t\t\tconst activeCount = fx.store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS c FROM memories WHERE usage_state='active'\")\n\t\t\t\t.get() as { c: number };\n\t\t\texpect(activeCount.c).toBe(0); // 没有复活出 active 副本\n\n\t\t\t// 全新来源同结论：不在 stopped 记忆的 source_links 里 → 正常新建。\n\t\t\t// captured_at 用更晚的 AT3：来源表按 (captured_at, source_id) 排序——\n\t\t\t// 同刻时 sourceId 是 uuid 无序，晚到的「新来源」须排在尝试边界之后。\n\t\t\tconst s2 = appendUserSource(fx, \"再确认一次：构建命令固定为 pnpm build。\", fx.sessionId, AT3);\n\t\t\trequestState.handle = async (_deps, _input) => ({\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。（复核）\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [s2],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: s2, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: s2, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-f05b\",\n\t\t\t});\n\t\t\t// 真实事件链：turn_end 登记新来源 → settled → failed job 检出\n\t\t\t// 上次尝试边界之后的新来源 → reopenFailedJobForNewSources 重开续跑（O03/I01）。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f05\")?.status === \"done\");\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.usage_state FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id=m.id AND r.revision=m.current_revision\n\t\t\t\t\t WHERE json_extract(r.content_json,'$.conclusion') LIKE '%pnpm build%'`,\n\t\t\t\t)\n\t\t\t\t.all() as Array<{ usage_state: string }>;\n\t\t\texpect(rows.filter((r) => r.usage_state === \"active\")).toHaveLength(1);\n\t\t\texpect(rows.filter((r) => r.usage_state === \"stopped\")).toHaveLength(1);\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F03：本进程前台忙（agent_start 未 settled）时 drain 不新领后台 job\", async () => {\n\t\t// 两个会话各留一个 pending job；处理第一个时在请求里触发 agent_start——\n\t\t// busy 置位后，drain 的 per-target 检查应让第二个 job 留在 pending。\n\t\tconst scope1: MemoryScope = { projectId: \"proj-busy\", sessionId: \"sess-busy-1\" };\n\t\tconst fx1 = await schedulerFixture(\"sess-busy-1\", scope1);\n\t\tappendUserSource(fx1, \"会话一的决定。\");\n\t\tcreateJob(fx1.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-busy-1\", projectId: \"proj-busy\" }),\n\t\t\tscopeKey: \"session:sess-busy-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 会话二的 job 也由同一调度器捞起（跨会话 pending 扫描）。\n\t\tconst manager2 = SessionManager.create(fx1.home, join(fx1.home, \"agent\", \"sessions\"), { id: \"sess-busy-2\" });\n\t\tfx1.capture.registerSession(\"sess-busy-2\", manager2.getSessionFile()!);\n\t\tconst e2 = manager2.appendMessage({ role: \"user\", content: \"会话二的决定。\", timestamp: Date.parse(AT) });\n\t\tfx1.capture.captureCommittedEntry(\"sess-busy-2\", manager2.getEntry(e2)!, undefined, AT);\n\t\tcreateJob(fx1.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-busy-2\", projectId: \"proj-busy\" }),\n\t\t\tscopeKey: \"session:sess-busy-2\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tconst processed: string[] = [];\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\tprocessed.push(input.sourceSessionId);\n\t\t\t// 第一个 job 的请求进行中前台来活：agent_start 置 busy → 后续 target 不领。\n\t\t\tif (processed.length === 1) {\n\t\t\t\tawait fx1.handlers.get(\"agent_start\")?.({ type: \"agent_start\" }, fx1.ctx);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tcandidates: [],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-busy-${processed.length}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fx1.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx1.ctx);\n\t\t\tawait waitFor(() => jobRow(fx1.store, \"session:sess-busy-1\")?.status === \"done\");\n\t\t\t// 第二个 job 应仍是 pending——busy 期间 drain 提前返回，没有领取它。\n\t\t\texpect(jobRow(fx1.store, \"session:sess-busy-2\")?.status).toBe(\"pending\");\n\t\t\texpect(processed).toEqual([\"sess-busy-1\"]);\n\n\t\t\t// 下一轮 settled（busy 复位）才领第二个。\n\t\t\tawait fx1.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx1.ctx);\n\t\t\tawait waitFor(() => jobRow(fx1.store, \"session:sess-busy-2\")?.status === \"done\");\n\t\t\texpect(processed).toEqual([\"sess-busy-1\", \"sess-busy-2\"]);\n\t\t} finally {\n\t\t\tfx1.unmount();\n\t\t\tawait fx1.service.close();\n\t\t\tfx1.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/I01 反例：needs-reevaluation 后无新来源，settled 不反复重跑\", async () => {\n\t\t// 与 F05 同前置：stopped 拦截 → failed(stale 前缀)。此后没有新来源——\n\t\t// 已尝试未提交的游标后旧批不算新依据，普通 settled 保持 failed 不重跑。\n\t\tconst scope: MemoryScope = { projectId: \"proj-i01-neg\", sessionId: \"sess-i01-neg\" };\n\t\tconst fx = await schedulerFixture(\"sess-i01-neg\", scope);\n\t\tconst s1 = appendUserSource(fx, \"构建命令固定为 pnpm build。\");\n\t\tconst created = await fx.service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...scope },\n\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-i01-neg\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\tif (!stopped.ok) throw new Error(stopped.error.message);\n\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async () => {\n\t\t\trequestCount += 1;\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [s1],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: s1, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: s1, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-i01-neg-${requestCount}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-i01-neg\")?.status === \"failed\");\n\t\t\texpect(requestCount).toBe(1);\n\t\t\texpect(jobRow(fx.store, \"session:sess-i01-neg\")!.last_error).toContain(\"stale_request_snapshot:\");\n\n\t\t\t// 无新来源的空闲事件：job 保持 failed，不再发模型请求（不自动重放）。\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\texpect(requestCount).toBe(1);\n\t\t\texpect(jobRow(fx.store, \"session:sess-i01-neg\")!.status).toBe(\"failed\");\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/I02：同 home 同进程两调度器共享前台忙——A 忙时 B 的 settled 不领\", async () => {\n\t\t// 同 home 同 store 装两个会话调度器（桌面 session-supervisor 同进程多会话）。\n\t\tconst scopeA: MemoryScope = { projectId: \"proj-i02\", sessionId: \"sess-i02-a\" };\n\t\tconst fxA = await schedulerFixture(\"sess-i02-a\", scopeA);\n\t\tconst sourceA = appendUserSource(fxA, \"会话一的持久任务。\");\n\t\tcreateJob(fxA.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-i02-a\", projectId: \"proj-i02\" }),\n\t\t\tscopeKey: \"session:sess-i02-a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tconst scopeB: MemoryScope = { projectId: \"proj-i02\", sessionId: \"sess-i02-b\" };\n\t\tconst fxB = await schedulerFixture(\"sess-i02-b\", scopeB, {\n\t\t\thome: fxA.home,\n\t\t\tstore: fxA.store,\n\t\t\tservice: fxA.service,\n\t\t});\n\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async () => {\n\t\t\trequ