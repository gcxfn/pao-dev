"range":[331,340]}}},{"diffOp":{"delete":{"range":[691,778]}}},{"diffOp":{"insert":{"range":[778,797]}}},{"diffOp":{"equal":{"range":[797,826]}}},{"diffOp":{"delete":{"range":[826,836]}}},{"diffOp":{"insert":{"range":[654,664]}}},{"diffOp":{"equal":{"range":[329,331]}}},{"diffOp":{"equal":{"range":[331,340]}}},{"diffOp":{"delete":{"range":[836,859]}}},{"diffOp":{"insert":{"range":[691,778]}}},{"diffOp":{"equal":{"range":[797,826]}}},{"diffOp":{"delete":{"range":[859,867]}}},{"diffOp":{"insert":{"range":[826,836]}}},{"diffOp":{"equal":{"range":[329,331]}}},{"diffOp":{"equal":{"range":[867,1016]}}},{"diffOp":{"equal":{"range":[867,877]}}},{"diffOp":{"delete":{"range":[1016,1037]}}},{"diffOp":{"insert":{"range":[1037,1058]}}},{"diffOp":{"equal":{"range":[515,527]}}},{"diffOp":{"delete":{"range":[1058,1070]}}},{"diffOp":{"insert":{"range":[1070,1096]}}},{"diffOp":{"equal":{"range":[329,331]}}},{"diffOp":{"equal":{"range":[1096,1128]}}},{"equalLines":{"line_count":2}},{"diffOp":{"equal":{"range":[1128,1211]}}},{"diffOp":{"equal":{"range":[867,875]}}},{"diffOp":{"delete":{"range":[219,224]}}},{"diffOp":{"equal":{"range":[224,226]}}},{"diffOp":{"delete":{"range":[1211,1225]}}},{"diffOp":{"insert":{"range":[1016,1037]}}},{"diffOp":{"equal":{"range":[515,527]}}},{"diffOp":{"delete":{"range":[1225,1256]}}},{"diffOp":{"insert":{"range":[1058,1070]}}},{"diffOp":{"equal":{"range":[329,331]}}},{"diffOp":{"equal":{"range":[1256,1467]}}},{"equalLines":{"line_count":988}},{"diffOp":{"equal":{"range":[1467,1476]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-correction.test.ts"},"span":[562,608],"sourceCode":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *\n * 覆盖：延迟提炼不覆盖页面/对话纠正、停用/删除后旧候选不复活、\n * 关机取消与重启继续（不重复已提交事件）、双会话 scope 修订感知、\n * builtin 纠正走 service.correctMemory 单步。\n *\n * 模型一律假；真实 UI/事件挂接由 D 批实现，本文件测数据层正确性。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-correction.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { archiveProjectOperationSource } from \"../../src/pao/memory/project-operation-source.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport {\n\tBUILTIN_PROVIDER,\n\tbindBuiltinMemoryService,\n\tregisterMemoryCommand,\n\tsessionMemory,\n} from \"../../src/pao/memory/session.ts\";\nimport { registerBuiltinMemory } from \"../../src/pao/memory/tools.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\nimport type {\n\tCommitSourceRef,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";\nimport type { ToolDefinition } from \"../../src/core/extensions/types.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-cor-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst AT3 = \"2026-11-08T10:02:00.000Z\";\nconst AT4 = \"2026-11-08T10:03:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-alpha\" };\n\nafterEach(async () => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nfunction seedSource(\n\tstore: MemoryStore,\n\tover: { sessionId?: string; entryId?: string; eventType?: string; capturedAt?: string } = {},\n) {\n\tconst sessionId = over.sessionId ?? \"sess-1\";\n\tconst entryId = over.entryId ?? `e-${Math.random().toString(36).slice(2, 8)}`;\n\tconst eventType = over.eventType ?? \"user\";\n\tconst sourceId = registerSource(store.db, { sessionId, entryId, eventType, capturedAt: over.capturedAt ?? AT });\n\treturn { sourceId, ref: { sourceId, sessionId, entryId, eventType } as CommitSourceRef };\n}\n\nfunction candidate(over: Partial<ValidatedCandidate> & { sourceId: string }): ValidatedCandidate {\n\tconst { sourceId, ...rest } = over;\n\treturn {\n\t\tkind: \"decision\",\n\t\tconclusion: \"旧结论：存储用 PostgreSQL\",\n\t\tconditions: \"原条件\",\n\t\trationale: \"旧理由\",\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [sourceId],\n\t\tquotedSpans: [{ sourceId, text: \"span\" }],\n\t\tspanLocations: [{ sourceId, match: \"exact\", offset: 0 }],\n\t\t...rest,\n\t};\n}\n\nasync function relatedSnapshot(service: MemoryService, memoryId: string): Promise<RelatedMemorySummary> {\n\tconst got = await service.getMemory({ id: memoryId });\n\tif (!got.ok) throw new Error(got.error.message);\n\treturn {\n\t\tmemoryId: got.memory.id,\n\t\tkind: got.memory.kind,\n\t\tcurrentRevision: got.memory.currentRevision,\n\t\tconclusion: got.memory.content.conclusion,\n\t\t...(got.memory.content.conditions === undefined ? {} : { conditions: got.memory.content.conditions }),\n\t\tconfirmation: got.memory.content.confirmation,\n\t\tusageState: got.memory.usageState,\n\t};\n}\n\n// ── S2-09 提交核对：延迟提炼不能撤销页面/对话纠正 ────────────────────────\n\ndescribe(\"提交核对（延迟提炼 vs 纠正）\", () => {\n\tit(\"页面 r1→r2 后旧候选提交：top3 保持唯一 active，旧 top5 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t});\n\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"页面召回返回 top3\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.usageState).toBe(\"active\");\n\t\t}\n\t\tconst activeTop3 = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top3\") as { count: number };\n\t\tconst top5Rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top5\") as { count: number };\n\t\texpect(activeTop3.count).toBe(1);\n\t\texpect(top5Rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"自然措辞变化沿用旧来源时仍按 request 快照修订跳过\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst assistantSource = seedSource(store, { entryId: \"e-assistant\" });\n\t\tconst userSource = seedSource(store, { entryId: \"e-user\" });\n\t\tconst sourceIds = [assistantSource.sourceId, userSource.sourceId];\n\t\tconst r1Candidate = candidate({\n\t\t\tsourceId: assistantSource.sourceId,\n\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\tsourceIds,\n\t\t\tquotedSpans: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t],\n\t\t\tspanLocations: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t],\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [r1Candidate],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"自动召回每轮 top3\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"sess-1\", entryId: \"e-page-correction\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: assistantSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t\tsourceIds,\n\t\t\t\t\tquotedSpans: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t\t\t],\n\t\t\t\t\tspanLocations: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t],\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t\tsourceIds,\n\t\t});\n\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.all(SCOPE.projectId) as Array<{ id: string; content_json: string }>;\n\t\texpect(activeRows).toHaveLength(1);\n\t\texpect(activeRows[0].id).toBe(memoryId);\n\t\texpect(JSON.parse(activeRows[0].content_json).conclusion).toBe(\"自动召回每轮 top3\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"停用后旧候选重放：跳过迟到候选，不新建 active 旧结论\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId: s.sourceId,\n\t\t\tconclusion: \"存储决定改为使用 SQLite。\",\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst stopped = await service.setMemoryUsage({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(stopped.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"存储决定改使用 SQLite。\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t});\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) expect(got.memory.usageState).toBe(\"stopped\");\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories\n\t\t\t\t WHERE usage_state = 'active'\n\t\t\t\t   AND json_extract(scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId) as { count: number };\n\t\texpect(activeRows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"删除后旧候选重放：沿用来源排除，不重建旧记忆\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sessionId = \"sess-delete-late\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst entryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"旧结论：页面召回返回 top5\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst captured = capture.captureCommittedEntry(sessionId, manager.getEntry(entryId)!, undefined, AT);\n\t\tconst s = {\n\t\t\tsourceId: captured.sourceId!,\n\t\t\tref: {\n\t\t\t\tsourceId: captured.sourceId!,\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t} satisfies CommitSourceRef,\n\t\t};\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst deleted = await service.deleteMemory({\n\t\t\tmemoryIds: [memoryId],\n\t\t\trevisions: { [memoryId]: 1 },\n\t\t\tsource: { sessionId },\n\t\t});\n\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"source_excluded\" });\n\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories WHERE id = ?\").get(memoryId) as {\n\t\t\tcount: number;\n\t\t};\n\t\texpect(rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源的独立候选在旧修订失效时转新请求，不冒充独立提交\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" }),\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" }),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.submitted).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源独立候选在相关修订未变化时正常落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\texpect(result.submitted).toBe(1);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"新来源明确重申旧决定：不被旧请求快照误判为迟到结果\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst oldSource = seedSource(store, { entryId: \"e-old\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: oldSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [oldSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst newSource = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-reaffirm\", capturedAt: AT3 });\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: newSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [newSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\tconst newMemoryId = (result.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst linked = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM memory_source_links\n\t\t\t\t WHERE memory_id = ? AND revision = 1`,\n\t\t\t)\n\t\t\t.all(newMemoryId) as Array<{ source_id: string }>;\n\t\texpect(linked.map((row) => row.source_id)).toEqual([newSource.sourceId]);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── S2-12 失败可续 + 关机/重启恢复 ───────────────────────────────────────\n\ndescribe(\"失败可续与重启恢复\", () => {\n\tit(\"job 失败后 recoverJobs 重取，已提交游标不重复处理\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { createJob, claimJob, advanceCursor, failJob, recoverJobs } = await import(\n\t\t\t\"../../src/pao/memory/extraction-jobs.ts\"\n\t\t);\n\t\t// 建 job + 领取 + 推进游标（已提交一半）+ 失败\n\t\tconst job = createJob(store, { sourceScope: \"{}\", scopeKey: \"s1\", createdAt: AT });\n\t\tconst claimed = claimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT });\n\t\texpect(claimed).toBeDefined();\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e5\", advancedAt: AT2 });\n\t\tfailJob(store, { jobId: job.jobId, reason: \"模型超时\", failedAt: AT3 });\n\n\t\t// 持有者 pid-99999 已死（非本进程），recover 重取为 pending\n\t\tconst recovered = recoverJobs(store, AT4);\n\t\texpect(recovered.recovered.some((j) => j.jobId === job.jobId)).toBe(true);\n\t\tconst after = store.db.prepare(`SELECT status, cursor FROM extraction_jobs WHERE job_id = ?`).get(job.jobId) as {\n\t\t\tstatus: string;\n\t\t\tcursor: string | null;\n\t\t};\n\t\texpect(after.status).toBe(\"pending\");\n\t\texpect(after.cursor).toBe(\"e5\"); // 游标保留——重跑只处理 e5 之后\n\t\tstore.close();\n\t});\n});\n\n// ── S2-10 scope 修订感知：双会话一写一读一致 ─────────────────────────────\n\ndescribe(\"scope 修订感知\", () => {\n\tit(\"会话A写入后 scopeRevision 递增；会话B比对发现变化\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scopeId = SCOPE.projectId!;\n\n\t\t// 会话B 先读一次基线（无记录 → revision 0）\n\t\tconst base = await service.readScopeRevision({ scopeId });\n\t\tif (base.ok) expect(base.revision).toBe(0);\n\n\t\t// 会话A 写入一条决定 → scope_revisions 递增\n\t\tconst s = seedSource(store, { sessionId: \"sess-A\" });\n\t\tawait commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"jA\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"A 会话的决定\" })],\n\t\t\trelatedMemories: [],\n\t\t\tsourceRefs: [s.ref],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst after = await service.readScopeRevision({ scopeId });\n\t\tif (after.ok) expect(after.revision).toBeGreaterThan(0);\n\n\t\t// 会话B 的 lastScopeRevisions 记的是 0 → 比对 after.revision !== 0 即发现变化\n\t\t//（SessionMemory.lastScopeRevisions 的比对逻辑由 D 批钩子实现，此处验证数据面）\n\t\tconst lastSeen = 0;\n\t\texpect(after.ok && after.revision !== lastSeen).toBe(true);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── builtin 纠正路由（S2-08）：correctMemory 单步而非两步写新忘旧 ────────\n\ndescribe(\"builtin 纠正数据面\", () => {\n\tit(\"correctMemory 单步修订：新结论为当前版本，旧结论进历史+supersedes\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: SCOPE,\n\t\t\tconclusion: \"旧：用 Mongo\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) return;\n\n\t\t// builtin 纠正 = correctMemory 单步（runBuiltinMemoryCommand 内部即此调用）\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"新：用 SQLite\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新：用 SQLite\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t// 同一 memoryId 下修订前进，不是「写新记忆+忘旧记忆」两步——ID 不变\n\t\t\texpect(got.memory.id).toBe(created.id);\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：提交语义修订（F04 确认升级/语义冲突、F11 重议保来源）─────────────\n\ndescribe(\"O02 提交语义\", () => {\n\tit(\"F04 确认升级：tentative + 同结论同条件候选 confirmed → corrected 修订，来源并集\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\t// 既有记忆：tentative + 同归一结论 + 同条件/理由\n\t\tconst c1 = candidate({\n\t\t\tsourceId: s1.sourceId,\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tconfirmation: \"tentative\",\n\t\t});\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c1],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\t// 新来源的同结论同条件候选 confirmation=confirmed → 确认升级走 correctMemory\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-confirm\", capturedAt: AT2 });\n\t\tconst createSpy = vi.spyOn(service, \"createMemory\");\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s2.sourceId,\n\t\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"corrected\", memoryId, revision: 2 });\n\t\texpect(second.corrected).toBe(1);\n\t\texpect(createSpy).not.toHaveBeenCalled();\n\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t// 旧来源 + 本次触发来源都在当前修订 sourceIds 内（O02 并集口径）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F04 理由变化：同结论同条件 rationale 不同 → skipped/semantic_conflict 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-rationale\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, rationale: \"换了个理由\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"semantic_conflict\",\n\t\t\tmemoryId,\n\t\t});\n\t\texpect(second.skipped).toBe(1);\n\t\texpect(second.submitted).toBe(0);\n\t\t// 记忆本体未被改写（不替用户裁语义）\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t\texpect(got.memory.content.rationale).toBe(\"旧理由\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F11 重议保来源：同结论异条件 → flagged 新修订同时含旧来源与触发来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-new-cond\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, conditions: \"条件已变\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"flagged\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBe(true);\n\t\t\t// 标记修订来源 = 本次触发来源 ∪ 旧修订来源（旧决定的原始依据不丢）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：明确纠正进同一入口（F03 工具 correct_id、F09 CLI 保字段保来源）──\n\ndescribe(\"O02 纠正入口\", () => {\n\tit(\"F03 工具纠正：pao_memory_write 带 correct_id → 同一 ID 新修订，字段沿用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"背景：旧决定带条件与理由。\"));\n\t\tconst assistant = assistantMsg(\"写入纠正\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"correct\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\ttry {\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\t\tconst created = await registration.service.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"proj-tool\", sessionId },\n\t\t\t\tconclusion: \"旧结论\",\n\t\t\t\tconditions: \"原条件\",\n\t\t\t\trationale: \"原理由\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tcreatedBy: \"user\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(created.error.message);\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\");\n\t\t\tconst corrected = await writeTool!.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"新结论\", correct_id: created.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst got = await registration.service.getMemory({ id: created.id, includeHistory: true });\n\t\t\tif (got.ok) {\n\t\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t\t// 新修订来源 = 工具调用来源 ∪ 旧来源\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds).toContain(s.sourceId);\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds.length).toBe(2);\n\t\t\t}\n\t\t\t// 同一 ID 修订,未新建第二条记忆\n\t\t\tconst all = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories\").get() as { count: number };\n\t\t\texpect(all.count).toBe(1);\n\t\t\tstore.close();\n\t\t} finally {\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 工具写入降级：pao_memory_write 无 correct_id → model_inference/tentative；带 correct_id → 同口径降级\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-downgrade\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"比较数据库方案，尚未定。\"));\n\t\tconst assistant = assistantMsg(\"我推测用 SQLite\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-new\", name: \"pao_memory_write\", arguments: { content: \"推测\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst assistant2 = assistantMsg(\"纠正既有条目\");\n\t\t(assistant2 as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"纠正\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant2);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\t// 无 correct_id：新建 → toolcall 来源不顶替用户确认。\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\")!;\n\t\t\tconst written = await writeTool.execute(\n\t\t\t\t\"call-new\",\n\t\t\t\t{ content: \"我推测使用 SQLite 更适合\" } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(written.isError).not.toBe(true);\n\t\t\tconst createdRow = store.db\n\t\t\t\t.prepare(\"SELECT id FROM memories ORDER BY created_at DESC LIMIT 1\")\n\t\t\t\t.get() as { id: string } | undefined;\n\t\t\texpect(createdRow).toBeDefined();\n\t\t\tconst created = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(created.ok).toBe(true);\n\t\t\tif (created.ok) {\n\t\t\t\texpect(created.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(created.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\n\t\t\t// 带 correct_id：修订同一 ID，确认同样降级为 model_inference/tentative。\n\t\t\tconst corrected = await writeTool.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"更正后的推测\", correct_id: createdRow!.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst after = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(after.ok).toBe(true);\n\t\t\tif (after.ok) {\n\t\t\t\texpect(after.memory.currentRevision).toBe(2);\n\t\t\t\texpect(after.memory.content.conclusion).toBe(\"更正后的推测\");\n\t\t\t\texpect(after.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(after.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\t\t} finally {\n\t\t\tstore.close();\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 用户通道不受影响：/pao memory correct 仍落 confirmed/user_statement\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-confirm\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli-confirm\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record([{ 内容: \"旧结论\", 记忆ID: created.id, 修订号: 1, 来源: \"内置记忆库\" }], BUILTIN_PROVIDER);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.evidenceKind).toBe(\"user_statement\");\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F09 CLI 纠正：带条件/理由的条目经 /pao memory correct → 新修订保留字段,来源含操作归档+旧来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tconditions: \"原条件\",\n\t\t\trationale: \"原理由\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record(\n\t\t\t[\n\t\t\t\t{\n\t\t\t\t\t内容: \"旧结论\",\n\t\t\t\t\t记忆ID: created.id,\n\t\t\t\t\t修订号: 1,\n\t\t\t\t\t来源: \"内置记忆库\",\n\t\t\t\t},\n\t\t\t],\n\t\t\tBUILTIN_PROVIDER,\n\t\t);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t// 未编辑字段沿用旧值——纠正不清空条件/理由\n\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t// 新修订来源 = 归档操作来源 ∪ 旧来源；归档来源可回读到 memoryCorrect 操作正文\n\t\t\tconst newSourceIds = got.revisions?.[1]?.sourceIds ?? [];\n\t\t\texpect(newSourceIds).toContain(s.sourceId);\n\t\t\texpect(newSourceIds.length).toBe(2);\n\t\t\tconst archivedId = newSourceIds.find((id) => id !== s.sourceId)!;\n\t\t\tconst archived = await service.readMemorySource({ sourceId: archivedId });\n\t\t\texpect(archived.ok).toBe(true);\n\t\t\tif (archived.ok) {\n\t\t\t\texpect(archived.content).toContain(\"memoryCorrect\");\n\t\t\t\texpect(archived.content).toContain(created.id);\n\t\t\t}\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *\t\t\t);\n\t\t\texpect(written.isError).not.toBe(true);\n\t\t\tconst createdRow = store.db\n\t\t\t\t.preparestore.db.prepare(\"SELECT id FROM memories ORDER BY created_at DESC LIMIT 1\")\n\t\t\t\t.get() as\n\t\t\t\t| { id: string }| undefined;\n\t\t\texpect(createdRow).toBeDefined();\n\t\t\tconst created = await registration.service.getMemory({ id: createdRow!.id });\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi,() => undefined,() => home,\n\t\t);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record([{ 内容: \"旧结论\", 记忆ID: created.id, 修订号: 1, 来源: \"内置记忆库\" }], BUILTIN_PROVIDER);\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,82]}}},{"equalLines":{"line_count":877}},{"diffOp":{"equal":{"range":[82,153]}}},{"diffOp":{"delete":{"range":[153,174]}}},{"diffOp":{"insert":{"range":[174,190]}}},{"diffOp":{"equal":{"range":[190,250]}}},{"diffOp":{"delete":{"range":[250,255]}}},{"diffOp":{"equal":{"range":[255,264]}}},{"diffOp":{"insert":{"range":[264,270]}}},{"diffOp":{"equal":{"range":[270,285]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[264,269]}}},{"diffOp":{"equal":{"range":[285,415]}}},{"equalLines":{"line_count":48}},{"diffOp":{"equal":{"range":[415,552]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[552,555]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[555,571]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[571,581]}}},{"diffOp":{"insert":{"range":[581,585]}}},{"diffOp":{"equal":{"range":[585,746]}}},{"equalLines":{"line_count":42}},{"diffOp":{"equal":{"range":[415,552]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[552,555]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[555,571]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[571,581]}}},{"diffOp":{"insert":{"range":[581,585]}}},{"diffOp":{"equal":{"range":[585,638]}}},{"equalLines":{"line_count":42}},{"diffOp":{"equal":{"range":[746,755]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-correction.test.ts"},"span":null,"sourceCode":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *\n * 覆盖：延迟提炼不覆盖页面/对话纠正、停用/删除后旧候选不复活、\n * 关机取消与重启继续（不重复已提交事件）、双会话 scope 修订感知、\n * builtin 纠正走 service.correctMemory 单步。\n *\n * 模型一律假；真实 UI/事件挂接由 D 批实现，本文件测数据层正确性。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-correction.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { archiveProjectOperationSource } from \"../../src/pao/memory/project-operation-source.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport {\n\tBUILTIN_PROVIDER,\n\tbindBuiltinMemoryService,\n\tregisterMemoryCommand,\n\tsessionMemory,\n} from \"../../src/pao/memory/session.ts\";\nimport { registerBuiltinMemory } from \"../../src/pao/memory/tools.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\nimport type {\n\tCommitSourceRef,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";\nimport type { ToolDefinition } from \"../../src/core/extensions/types.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-cor-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst AT3 = \"2026-11-08T10:02:00.000Z\";\nconst AT4 = \"2026-11-08T10:03:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-alpha\" };\n\nafterEach(async () => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nfunction seedSource(\n\tstore: MemoryStore,\n\tover: { sessionId?: string; entryId?: string; eventType?: string; capturedAt?: string } = {},\n) {\n\tconst sessionId = over.sessionId ?? \"sess-1\";\n\tconst entryId = over.entryId ?? `e-${Math.random().toString(36).slice(2, 8)}`;\n\tconst eventType = over.eventType ?? \"user\";\n\tconst sourceId = registerSource(store.db, { sessionId, entryId, eventType, capturedAt: over.capturedAt ?? AT });\n\treturn { sourceId, ref: { sourceId, sessionId, entryId, eventType } as CommitSourceRef };\n}\n\nfunction candidate(over: Partial<ValidatedCandidate> & { sourceId: string }): ValidatedCandidate {\n\tconst { sourceId, ...rest } = over;\n\treturn {\n\t\tkind: \"decision\",\n\t\tconclusion: \"旧结论：存储用 PostgreSQL\",\n\t\tconditions: \"原条件\",\n\t\trationale: \"旧理由\",\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [sourceId],\n\t\tquotedSpans: [{ sourceId, text: \"span\" }],\n\t\tspanLocations: [{ sourceId, match: \"exact\", offset: 0 }],\n\t\t...rest,\n\t};\n}\n\nasync function relatedSnapshot(service: MemoryService, memoryId: string): Promise<RelatedMemorySummary> {\n\tconst got = await service.getMemory({ id: memoryId });\n\tif (!got.ok) throw new Error(got.error.message);\n\treturn {\n\t\tmemoryId: got.memory.id,\n\t\tkind: got.memory.kind,\n\t\tcurrentRevision: got.memory.currentRevision,\n\t\tconclusion: got.memory.content.conclusion,\n\t\t...(got.memory.content.conditions === undefined ? {} : { conditions: got.memory.content.conditions }),\n\t\tconfirmation: got.memory.content.confirmation,\n\t\tusageState: got.memory.usageState,\n\t};\n}\n\n// ── S2-09 提交核对：延迟提炼不能撤销页面/对话纠正 ────────────────────────\n\ndescribe(\"提交核对（延迟提炼 vs 纠正）\", () => {\n\tit(\"页面 r1→r2 后旧候选提交：top3 保持唯一 active，旧 top5 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t});\n\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"页面召回返回 top3\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.usageState).toBe(\"active\");\n\t\t}\n\t\tconst activeTop3 = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top3\") as { count: number };\n\t\tconst top5Rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top5\") as { count: number };\n\t\texpect(activeTop3.count).toBe(1);\n\t\texpect(top5Rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"自然措辞变化沿用旧来源时仍按 request 快照修订跳过\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst assistantSource = seedSource(store, { entryId: \"e-assistant\" });\n\t\tconst userSource = seedSource(store, { entryId: \"e-user\" });\n\t\tconst sourceIds = [assistantSource.sourceId, userSource.sourceId];\n\t\tconst r1Candidate = candidate({\n\t\t\tsourceId: assistantSource.sourceId,\n\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\tsourceIds,\n\t\t\tquotedSpans: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t],\n\t\t\tspanLocations: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t],\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [r1Candidate],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"自动召回每轮 top3\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"sess-1\", entryId: \"e-page-correction\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: assistantSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t\tsourceIds,\n\t\t\t\t\tquotedSpans: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t\t\t],\n\t\t\t\t\tspanLocations: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t],\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t\tsourceIds,\n\t\t});\n\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.all(SCOPE.projectId) as Array<{ id: string; content_json: string }>;\n\t\texpect(activeRows).toHaveLength(1);\n\t\texpect(activeRows[0].id).toBe(memoryId);\n\t\texpect(JSON.parse(activeRows[0].content_json).conclusion).toBe(\"自动召回每轮 top3\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"停用后旧候选重放：跳过迟到候选，不新建 active 旧结论\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId: s.sourceId,\n\t\t\tconclusion: \"存储决定改为使用 SQLite。\",\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst stopped = await service.setMemoryUsage({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(stopped.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"存储决定改使用 SQLite。\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t});\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) expect(got.memory.usageState).toBe(\"stopped\");\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories\n\t\t\t\t WHERE usage_state = 'active'\n\t\t\t\t   AND json_extract(scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId) as { count: number };\n\t\texpect(activeRows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"删除后旧候选重放：沿用来源排除，不重建旧记忆\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sessionId = \"sess-delete-late\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst entryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"旧结论：页面召回返回 top5\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst captured = capture.captureCommittedEntry(sessionId, manager.getEntry(entryId)!, undefined, AT);\n\t\tconst s = {\n\t\t\tsourceId: captured.sourceId!,\n\t\t\tref: {\n\t\t\t\tsourceId: captured.sourceId!,\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t} satisfies CommitSourceRef,\n\t\t};\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst deleted = await service.deleteMemory({\n\t\t\tmemoryIds: [memoryId],\n\t\t\trevisions: { [memoryId]: 1 },\n\t\t\tsource: { sessionId },\n\t\t});\n\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"source_excluded\" });\n\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories WHERE id = ?\").get(memoryId) as {\n\t\t\tcount: number;\n\t\t};\n\t\texpect(rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源的独立候选在旧修订失效时转新请求，不冒充独立提交\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" }),\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" }),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.submitted).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源独立候选在相关修订未变化时正常落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\texpect(result.submitted).toBe(1);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"新来源明确重申旧决定：不被旧请求快照误判为迟到结果\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst oldSource = seedSource(store, { entryId: \"e-old\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: oldSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [oldSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst newSource = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-reaffirm\", capturedAt: AT3 });\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: newSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [newSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\tconst newMemoryId = (result.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst linked = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM memory_source_links\n\t\t\t\t WHERE memory_id = ? AND revision = 1`,\n\t\t\t)\n\t\t\t.all(newMemoryId) as Array<{ source_id: string }>;\n\t\texpect(linked.map((row) => row.source_id)).toEqual([newSource.sourceId]);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── S2-12 失败可续 + 关机/重启恢复 ───────────────────────────────────────\n\ndescribe(\"失败可续与重启恢复\", () => {\n\tit(\"job 失败后 recoverJobs 重取，已提交游标不重复处理\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { createJob, claimJob, advanceCursor, failJob, recoverJobs } = await import(\n\t\t\t\"../../src/pao/memory/extraction-jobs.ts\"\n\t\t);\n\t\t// 建 job + 领取 + 推进游标（已提交一半）+ 失败\n\t\tconst job = createJob(store, { sourceScope: \"{}\", scopeKey: \"s1\", createdAt: AT });\n\t\tconst claimed = claimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT });\n\t\texpect(claimed).toBeDefined();\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e5\", advancedAt: AT2 });\n\t\tfailJob(store, { jobId: job.jobId, reason: \"模型超时\", failedAt: AT3 });\n\n\t\t// 持有者 pid-99999 已死（非本进程），recover 重取为 pending\n\t\tconst recovered = recoverJobs(store, AT4);\n\t\texpect(recovered.recovered.some((j) => j.jobId === job.jobId)).toBe(true);\n\t\tconst after = store.db.prepare(`SELECT status, cursor FROM extraction_jobs WHERE job_id = ?`).get(job.jobId) as {\n\t\t\tstatus: string;\n\t\t\tcursor: string | null;\n\t\t};\n\t\texpect(after.status).toBe(\"pending\");\n\t\texpect(after.cursor).toBe(\"e5\"); // 游标保留——重跑只处理 e5 之后\n\t\tstore.close();\n\t});\n});\n\n// ── S2-10 scope 修订感知：双会话一写一读一致 ─────────────────────────────\n\ndescribe(\"scope 修订感知\", () => {\n\tit(\"会话A写入后 scopeRevision 递增；会话B比对发现变化\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scopeId = SCOPE.projectId!;\n\n\t\t// 会话B 先读一次基线（无记录 → revision 0）\n\t\tconst base = await service.readScopeRevision({ scopeId });\n\t\tif (base.ok) expect(base.revision).toBe(0);\n\n\t\t// 会话A 写入一条决定 → scope_revisions 递增\n\t\tconst s = seedSource(store, { sessionId: \"sess-A\" });\n\t\tawait commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"jA\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"A 会话的决定\" })],\n\t\t\trelatedMemories: [],\n\t\t\tsourceRefs: [s.ref],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst after = await service.readScopeRevision({ scopeId });\n\t\tif (after.ok) expect(after.revision).toBeGreaterThan(0);\n\n\t\t// 会话B 的 lastScopeRevisions 记的是 0 → 比对 after.revision !== 0 即发现变化\n\t\t//（SessionMemory.lastScopeRevisions 的比对逻辑由 D 批钩子实现，此处验证数据面）\n\t\tconst lastSeen = 0;\n\t\texpect(after.ok && after.revision !== lastSeen).toBe(true);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── builtin 纠正路由（S2-08）：correctMemory 单步而非两步写新忘旧 ────────\n\ndescribe(\"builtin 纠正数据面\", () => {\n\tit(\"correctMemory 单步修订：新结论为当前版本，旧结论进历史+supersedes\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: SCOPE,\n\t\t\tconclusion: \"旧：用 Mongo\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) return;\n\n\t\t// builtin 纠正 = correctMemory 单步（runBuiltinMemoryCommand 内部即此调用）\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"新：用 SQLite\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新：用 SQLite\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t// 同一 memoryId 下修订前进，不是「写新记忆+忘旧记忆」两步——ID 不变\n\t\t\texpect(got.memory.id).toBe(created.id);\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：提交语义修订（F04 确认升级/语义冲突、F11 重议保来源）─────────────\n\ndescribe(\"O02 提交语义\", () => {\n\tit(\"F04 确认升级：tentative + 同结论同条件候选 confirmed → corrected 修订，来源并集\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\t// 既有记忆：tentative + 同归一结论 + 同条件/理由\n\t\tconst c1 = candidate({\n\t\t\tsourceId: s1.sourceId,\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tconfirmation: \"tentative\",\n\t\t});\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c1],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\t// 新来源的同结论同条件候选 confirmation=confirmed → 确认升级走 correctMemory\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-confirm\", capturedAt: AT2 });\n\t\tconst createSpy = vi.spyOn(service, \"createMemory\");\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s2.sourceId,\n\t\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"corrected\", memoryId, revision: 2 });\n\t\texpect(second.corrected).toBe(1);\n\t\texpect(createSpy).not.toHaveBeenCalled();\n\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t// 旧来源 + 本次触发来源都在当前修订 sourceIds 内（O02 并集口径）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F04 理由变化：同结论同条件 rationale 不同 → skipped/semantic_conflict 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-rationale\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, rationale: \"换了个理由\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"semantic_conflict\",\n\t\t\tmemoryId,\n\t\t});\n\t\texpect(second.skipped).toBe(1);\n\t\texpect(second.submitted).toBe(0);\n\t\t// 记忆本体未被改写（不替用户裁语义）\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t\texpect(got.memory.content.rationale).toBe(\"旧理由\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F11 重议保来源：同结论异条件 → flagged 新修订同时含旧来源与触发来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-new-cond\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, conditions: \"条件已变\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"flagged\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBe(true);\n\t\t\t// 标记修订来源 = 本次触发来源 ∪ 旧修订来源（旧决定的原始依据不丢）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：明确纠正进同一入口（F03 工具 correct_id、F09 CLI 保字段保来源）──\n\ndescribe(\"O02 纠正入口\", () => {\n\tit(\"F03 工具纠正：pao_memory_write 带 correct_id → 同一 ID 新修订，字段沿用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"背景：旧决定带条件与理由。\"));\n\t\tconst assistant = assistantMsg(\"写入纠正\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"correct\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\ttry {\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\t\tconst created = await registration.service.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"proj-tool\", sessionId },\n\t\t\t\tconclusion: \"旧结论\",\n\t\t\t\tconditions: \"原条件\",\n\t\t\t\trationale: \"原理由\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tcreatedBy: \"user\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(created.error.message);\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\");\n\t\t\tconst corrected = await writeTool!.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"新结论\", correct_id: created.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst got = await registration.service.getMemory({ id: created.id, includeHistory: true });\n\t\t\tif (got.ok) {\n\t\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t\t// 新修订来源 = 工具调用来源 ∪ 旧来源\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds).toContain(s.sourceId);\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds.length).toBe(2);\n\t\t\t}\n\t\t\t// 同一 ID 修订,未新建第二条记忆\n\t\t\tconst all = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories\").get() as { count: number };\n\t\t\texpect(all.count).toBe(1);\n\t\t\tstore.close();\n\t\t} finally {\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 工具写入降级：pao_memory_write 无 correct_id → model_inference/tentative；带 correct_id → 同口径降级\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-downgrade\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"比较数据库方案，尚未定。\"));\n\t\tconst assistant = assistantMsg(\"我推测用 SQLite\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-new\", name: \"pao_memory_write\", arguments: { content: \"推测\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst assistant2 = assistantMsg(\"纠正既有条目\");\n\t\t(assistant2 as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"纠正\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant2);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\t// 无 correct_id：新建 → toolcall 来源不顶替用户确认。\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\")!;\n\t\t\tconst written = await writeTool.execute(\n\t\t\t\t\"call-new\",\n\t\t\t\t{ content: \"我推测使用 SQLite 更适合\" } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(written.isError).not.toBe(true);\n\t\t\tconst createdRow = store.db\n\t\t\t\t.prepare(\"SELECT id FROM memories ORDER BY created_at DESC LIMIT 1\")\n\t\t\t\t.get() as { id: string } | undefined;\n\t\t\texpect(createdRow).toBeDefined();\n\t\t\tconst created = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(created.ok).toBe(true);\n\t\t\tif (created.ok) {\n\t\t\t\texpect(created.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(created.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\n\t\t\t// 带 correct_id：修订同一 ID，确认同样降级为 model_inference/tentative。\n\t\t\tconst corrected = await writeTool.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"更正后的推测\", correct_id: createdRow!.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst after = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(after.ok).toBe(true);\n\t\t\tif (after.ok) {\n\t\t\t\texpect(after.memory.currentRevision).toBe(2);\n\t\t\t\texpect(after.memory.content.conclusion).toBe(\"更正后的推测\");\n\t\t\t\texpect(after.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(after.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\t\t} finally {\n\t\t\tstore.close();\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 用户通道不受影响：/pao memory correct 仍落 confirmed/user_statement\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-confirm\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli-confirm\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record([{ 内容: \"旧结论\", 记忆ID: created.id, 修订号: 1, 来源: \"内置记忆库\" }], BUILTIN_PROVIDER);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.evidenceKind).toBe(\"user_statement\");\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F09 CLI 纠正：带条件/理由的条目经 /pao memory correct → 新修订保留字段,来源含操作归档+旧来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tconditions: \"原条件\",\n\t\t\trationale: \"原理由\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record(\n\t\t\t[\n\t\t\t\t{\n\t\t\t\t\t内容: \"旧结论\",\n\t\t\t\t\t记忆ID: created.id,\n\t\t\t\t\t修订号: 1,\n\t\t\t\t\t来源: \"内置记忆库\",\n\t\t\t\t},\n\t\t\t],\n\t\t\tBUILTIN_PROVIDER,\n\t\t);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t// 未编辑字段沿用旧值——纠正不清空条件/理由\n\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t// 新修订来源 = 归档操作来源 ∪ 旧来源；归档来源可回读到 memoryCorrect 操作正文\n\t\t\tconst newSourceIds = got.revisions?.[1]?.sourceIds ?? [];\n\t\t\texpect(newSourceIds).toContain(s.sourceId);\n\t\t\texpect(newSourceIds.length).toBe(2);\n\t\t\tconst archivedId = newSourceIds.find((id) => id !== s.sourceId)!;\n\t\t\tconst archived = await service.readMemorySource({ sourceId: archivedId });\n\t\t\texpect(archived.ok).toBe(true);\n\t\t\tif (archived.ok) {\n\t\t\t\texpect(archived.content).toContain(\"memoryCorrect\");\n\t\t\t\texpect(archived.content).toContain(created.id);\n\t\t\t}\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t\"prob-del\", \n\t\t\t\t\t\"implementation_defect\",\"modify\",\"进化问题\",\n\t\t\t\t\t\"应 A\",\"实际 B\",\n\t\t\t\t\tJSON.stringify([sourceId, \"evidence:keep-1\"]),\n\t\t\t\t\t1,resourceId,\"v-base0000000\",\n\t\t\t\t\t\"classified\",\"candidate\",AT,AT,\n\t\t\t\t);\n\t\t\tstore.db\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t\"cand-del\",\"prob-del\",\"tp-del\",\n\t\t\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\t\t\"修正依据\",\"[]\",\"proposed\",\t\t\t// - candidate 取消 + 受管正文清空。\n\t\t\tconst cand = store.db\n\t\t\t\t.prepare(`SELECT status, failure_reason, diffs_json, rationale FROM evolution_candidates WHERE candidate_id = 'cand-del'`,\n\t\t\t\t)\n\t\t\t\t.get() as { status: string; failure_reason: string; diffs_json: string; rationale: string };\n\t\t\texpect(cand.status).toBe(\"cancelled\");\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,166]}}},{"equalLines":{"line_count":1662}},{"diffOp":{"equal":{"range":[166,198]}}},{"diffOp":{"delete":{"range":[198,199]}}},{"diffOp":{"insert":{"range":[199,205]}}},{"diffOp":{"equal":{"range":[205,229]}}},{"diffOp":{"delete":{"range":[198,199]}}},{"diffOp":{"insert":{"range":[199,205]}}},{"diffOp":{"equal":{"range":[229,238]}}},{"diffOp":{"delete":{"range":[198,199]}}},{"diffOp":{"insert":{"range":[199,205]}}},{"diffOp":{"equal":{"range":[238,267]}}},{"