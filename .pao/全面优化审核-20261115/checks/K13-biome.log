t\t\t});\r\n\t\t\t\tclaimed.claimBaseline = {\r\n\t\t\t\t\tavailable: baseline.可用,\r\n\t\t\t\t\tsnapshotPath: baseline.快照路径,\r\n\t\t\t\t\texistingEntryCount: baseline.既有条目数,\r\n\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\treason: baseline.原因,\r\n\t\t\t\t};\r\n\t\t\t\tif (!baseline.可用 && workspace.commonGitDir)\r\n\t\t\t\t\tthrow new PaoWorkerError(\"无效参数\", `认领基线未建立，拒绝启动工人：${baseline.原因}`);\r\n\r\n\t\t\t\tconst verification = await verifyDispatchSnapshot(snapshot, {\r\n\t\t\t\t\tupstreamRefs,\r\n\t\t\t\t\tcardsDir: input.cardsDir,\r\n\t\t\t\t\tcardPath: claimed.card.path,\r\n\t\t\t\t\tprojectRoot,\r\n\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\tclaim,\r\n\t\t\t\t\tworkspace: {\r\n\t\t\t\t\t\t...(workspace.worktreeId ? { worktreeId: workspace.worktreeId } : {}),\r\n\t\t\t\t\t\tworktreeKind: authoritative.kind,\r\n\t\t\t\t\t\trepositoryRoot: workspace.repositoryRoot,\r\n\t\t\t\t\t\t...(workspace.commonGitDir ? { commonGitDir: workspace.commonGitDir } : {}),\r\n\t\t\t\t\t\tbaseHead: workspace.baseHead,\r\n\t\t\t\t\t\tbaseTreeId: workspace.baseTreeId,\r\n\t\t\t\t\t\tinputVersion: workspace.inputVersion,\r\n\t\t\t\t\t\t// 宿主摘要说明“这次解析到了哪个执行根”；attempt 摘要只说明\r\n\t\t\t\t\t\t// cards/execution-context 的关联记录。冻结和实时复核必须使用同一个宿主摘要。\r\n\t\t\t\t\t\tbindingDigest: authoritative.bindingDigest,\r\n\t\t\t\t\t},\r\n\t\t\t\t});\r\n\t\t\t\tif (!verification.ok) {\r\n\t\t\t\t\tthrow new PaoWorkerError(\"无效参数\", `膨胀输入复核失败：${verification.message}`, {\r\n\t\t\t\t\t\tcode: verification.code,\r\n\t\t\t\t\t\tissues: verification.issues,\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\tdispatchDetails = {\r\n\t\t\t\t\t...dispatchDetails,\r\n\t\t\t\t\tworktreeId: authoritative.kind === \"managed\" ? authoritative.worktreeId : undefined,\r\n\t\t\t\t\tinputVersion: authoritative.inputVersion,\r\n\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\tsnapshotDigest: snapshot.snapshotDigest,\r\n\t\t\t\t\tworktreeBindingDigest: authoritative.bindingDigest,\r\n\t\t\t\t\texecutionBindingDigest: executionIdentity.bindingDigest,\r\n\t\t\t\t};\r\n\t\t\t\t// 附加系统提示词是追加语义:配方提示(resolveDispatchParameters)与调用方注入\r\n\t\t\t\t// (M2-01 宿主的交接页指针等)拼接,不互相覆盖;黑板指针压轴(最贴近接卡动作);\r\n\t\t\t\t// 冻结简报正文是任务主入口,由 buildWorkerPrompt 直接注入。\r\n\t\t\t\tconst extraPrompt = [\r\n\t\t\t\t\t...(resolved.附加系统提示词 ?? []),\r\n\t\t\t\t\t...(extra.附加系统提示词 ?? []),\r\n\t\t\t\t\tblackboardPointer(input.cardsDir),\r\n\t\t\t\t];\r\n\t\t\t\tpythonCacheDir = createPythonCacheDir(tmpdir(), \"pao-worker-python-cache-\");\r\n\t\t\t\tconst runOptions = buildDispatchRunOptions({\r\n\t\t\t\t\tcard: claimed.card,\r\n\t\t\t\t\t尝试号: claimed.尝试号,\r\n\t\t\t\t\tfrozenBrief: snapshot,\r\n\t\t\t\t\t...(claimed.claimBaseline ? { claimBaseline: claimed.claimBaseline } : {}),\r\n\t\t\t\t\t公共参数: {\r\n\t\t\t\t\t\t...resolved,\r\n\t\t\t\t\t\t...extra,\r\n\t\t\t\t\t\t...(extraPrompt.length > 0 ? { 附加系统提示词: extraPrompt } : {}),\r\n\t\t\t\t\t\t// 侦察工具只接受派发链的权威身份，不接受模型参数自报。受控变量最后合并，\r\n\t\t\t\t\t\t// 覆盖调用方同名配置，其他环境变量保持原样。Python 缓存放系统临时目录，\r\n\t\t\t\t\t\t// 防止工人的 py_compile/import/子进程把 __pycache__ 写进业务工作区。\r\n\t\t\t\t\t\t// 缓存目录只在所有准备和复核都通过、即将启动时创建；任何拒派或早失败\r\n\t\t\t\t\t\t// 都不应留下空目录。\r\n\t\t\t\t\t\t环境变量: {\r\n\t\t\t\t\t\t\t...(resolved.环境变量 ?? {}),\r\n\t\t\t\t\t\t\t...(extra.环境变量 ?? {}),\r\n\t\t\t\t\t\t\t[PYTHON_CACHE_ENV]: pythonCacheDir,\r\n\t\t\t\t\t\t\t...dispatchReconWorkerEnvironment(\r\n\t\t\t\t\t\t\t\tinput.cardsDir,\r\n\t\t\t\t\t\t\t\tclaimed.card.card_no,\r\n\t\t\t\t\t\t\t\tclaimed.尝试号,\r\n\t\t\t\t\t\t\t\tclaim.owner,\r\n\t\t\t\t\t\t\t),\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t},\r\n\t\t\t\t\t追加参数: {\r\n\t\t\t\t\t\t预算: budget,\r\n\t\t\t\t\t\ttaskRoot: projectRoot,\r\n\t\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\t\tcwd: authoritative.executionRoot,\r\n\t\t\t\t\t\t...(authoritative.kind === \"managed\" ? { worktreeId: authoritative.worktreeId } : {}),\r\n\t\t\t\t\t\tsnapshotDigest: snapshot.snapshotDigest,\r\n\t\t\t\t\t\tworktreeBindingDigest: authoritative.bindingDigest,\r\n\t\t\t\t\t\texecutionBindingDigest: executionIdentity.bindingDigest,\r\n\t\t\t\t\t\texecutionBinding: executionIdentity,\r\n\t\t\t\t\t\t...(claimed.claimBaseline?.available && claimed.claimBaseline.snapshotPath\r\n\t\t\t\t\t\t\t? { claimBaselinePath: claimed.claimBaseline.snapshotPath }\r\n\t\t\t\t\t\t\t: {}),\r\n\t\t\t\t\t},\r\n\t\t\t\t\t派单理由: input.dispatch_reason,\r\n\t\t\t\t});\r\n\t\t\t\tif (supervisionRoute) runOptions.supervisionRoute = supervisionRoute;\r\n\t\t\t\t// 脚本卡（批3b-E）：命令/参数覆盖路径取代 pi worker 调用——要求回执:false 用原生\r\n\t\t\t\t// exitCode→status。解释器/脚本体物化失败时按规格落 failed+script_start 单次终态\r\n\t\t\t\t// 回执（真实证据文件 + 原生退出码语义），不另建失败路径也不拒派。\r\n\t\t\t\tconst scriptCard = isScriptCard(claimed.card);\r\n\t\t\t\tlet scriptStartFailure: WorkerReceipt | undefined;\r\n\t\t\t\tif (scriptCard) {\r\n\t\t\t\t\tconst evidenceDir = join(dirname(dirname(claimed.card.path)), \"worker-evidence\");\r\n\t\t\t\t\ttry {\r\n\t\t\t\t\t\tconst scriptPlan = await planScriptRun({\r\n\t\t\t\t\t\t\tcard: claimed.card,\r\n\t\t\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\t\t\tevidenceDir,\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\trunOptions.命令 = scriptPlan.interpreter;\r\n\t\t\t\t\t\trunOptions.参数 = scriptPlan.args;\r\n\t\t\t\t\t\trunOptions.要求回执 = false;\r\n\t\t\t\t\t\trunOptions.超时毫秒 = scriptPlan.超时毫秒;\r\n\t\t\t\t\t\t// 脚本无模型提示词：buildDispatchRunOptions 已带提示词，覆盖路径把它清空，\r\n\t\t\t\t\t\t// buildArgs 对空提示词不再追加参数（runner.ts 提示词分支）。\r\n\t\t\t\t\t\trunOptions.提示词 = \"\";\r\n\t\t\t\t\t\t// pi 专属参数不得尾随进脚本解释器 argv：buildArgs 会把这些字段各拼成\r\n\t\t\t\t\t\t// 命令行开关，脚本走 参数 覆盖后这些键仍残留就要清掉（含 blackboardPointer\r\n\t\t\t\t\t\t// 注入的附加系统提示词）。\r\n\t\t\t\t\t\trunOptions.模型 = undefined;\r\n\t\t\t\t\t\trunOptions.思考档 = undefined;\r\n\t\t\t\t\t\trunOptions.工具白名单 = undefined;\r\n\t\t\t\t\t\trunOptions.skills = undefined;\r\n\t\t\t\t\t\trunOptions.附加系统提示词 = undefined;\r\n\t\t\t\t\t\trunOptions.会话标识 = undefined;\r\n\t\t\t\t\t\trunOptions.延续会话 = undefined;\r\n\t\t\t\t\t\trunOptions.会话目录 = undefined;\r\n\t\t\t\t\t} catch (error) {\r\n\t\t\t\t\t\t// 解释器缺失/正文超限/物化失败——不抛派发异常，合成本次尝试的\r\n\t\t\t\t\t\t// script_start 终态回执；证据落真实文件，走完同一条 appendDispatchReceipt 通道。\r\n\t\t\t\t\t\tconst reason = error instanceof Error ? error.message : String(error);\r\n\t\t\t\t\t\tawait mkdir(evidenceDir, { recursive: true });\r\n\t\t\t\t\t\tconst evidencePath = join(\r\n\t\t\t\t\t\t\tevidenceDir,\r\n\t\t\t\t\t\t\t`卡${String(claimed.card.card_no).padStart(4, \"0\")}-尝试${claimed.尝试号}-script_start.json`,\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\tawait writeFileAtomic(\r\n\t\t\t\t\t\t\tevidencePath,\r\n\t\t\t\t\t\t\t`${JSON.stringify({\r\n\t\t\t\t\t\t\t\ttype: \"pao_script_start\",\r\n\t\t\t\t\t\t\t\t卡号: claimed.card.card_no,\r\n\t\t\t\t\t\t\t\t卡路径: claimed.card.path,\r\n\t\t\t\t\t\t\t\t尝试: claimed.尝试号,\r\n\t\t\t\t\t\t\t\t执行标识: randomUUID(),\r\n\t\t\t\t\t\t\t\t原因: reason,\r\n\t\t\t\t\t\t\t\t时间: utcNow(),\r\n\t\t\t\t\t\t\t})}\\n`,\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t\tscriptStartFailure = {\r\n\t\t\t\t\t\t\tcard_no: String(claimed.card.card_no).padStart(4, \"0\"),\r\n\t\t\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\t\t\tstatus: \"failed\",\r\n\t\t\t\t\t\t\tartifact_path: [],\r\n\t\t\t\t\t\t\tsummary: `脚本启动失败：${reason}`,\r\n\t\t\t\t\t\t\tusage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0, turns: 0 },\r\n\t\t\t\t\t\t\texitCode: -1,\r\n\t\t\t\t\t\t\tstopReason: \"script_start\",\r\n\t\t\t\t\t\t\tfailure_type: \"script_start\",\r\n\t\t\t\t\t\t\tevidence_path: evidencePath,\r\n\t\t\t\t\t\t\tscriptRun: true,\r\n\t\t\t\t\t\t\tcommand: `script_start:${reason}`,\r\n\t\t\t\t\t\t\tpid: -1,\r\n\t\t\t\t\t\t\tduration_ms: 0,\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// O13/E14 受控技能绑定（派发装配点）：新会话 worker 在 spawn 前把将装载的\r\n\t\t\t\t// 受控技能绑进本任务——taskId = runOptions.会话标识（worker 子进程\r\n\t\t\t\t// sessionId 经 --session-id 收到同一值，worker 内 createRuntime 的绑定\r\n\t\t\t\t// 解析天然命中同一键）。技能路径 basename → `skill:<name>` resourceId。\r\n\t\t\t\t// 延续会话与脚本卡不绑——绑定语义是「本任务若用就固定这个版本」，延续\r\n\t\t\t\t// 会话已由旧 taskId 持有绑定；无会话 worker（--no-session）没有\r\n\t\t\t\t// sessionId 可传，不参与绑定换版。\r\n\t\t\t\t// 绑定失败记派发告警不拒派（技能装载不阻塞业务；残余失败如实留痕）。\r\n\t\t\t\tlet workerBindingTaskId: string | undefined;\r\n\t\t\t\tlet workerBoundResourceIds: string[] = [];\r\n\t\t\t\tif (!scriptCard && runOptions.skills !== undefined && runOptions.skills.length > 0 && options.paoHome) {\r\n\t\t\t\t\tconst bindingTaskId = runOptions.会话标识 ?? randomUUID();\r\n\t\t\t\t\tif (runOptions.会话标识 === undefined) runOptions.会话标识 = bindingTaskId;\r\n\t\t\t\t\tworkerBindingTaskId = bindingTaskId;\r\n\t\t\t\t\tconst resourceIds = [\r\n\t\t\t\t\t\t...new Set(\r\n\t\t\t\t\t\t\trunOptions.skills\r\n\t\t\t\t\t\t\t\t.map((skillPath) => basename(skillPath))\r\n\t\t\t\t\t\t\t\t.filter((name) => name !== \"\")\r\n\t\t\t\t\t\t\t\t.map((name) => `skill:${name}`),\r\n\t\t\t\t\t\t),\r\n\t\t\t\t\t];\r\n\t\t\t\t\tworkerBoundResourceIds = resourceIds;\r\n\t\t\t\t\tif (resourceIds.length > 0 && existsSync(memoryPaths(options.paoHome).database)) {\r\n\t\t\t\t\t\tconst bindStore = openMemoryStore(options.paoHome, \"readwrite\");\r\n\t\t\t\t\t\ttry {\r\n\t\t\t\t\t\t\tconst ensured = ensureTaskBindings(bindStore, {\r\n\t\t\t\t\t\t\t\ttaskId: bindingTaskId,\r\n\t\t\t\t\t\t\t\tpaoHome: options.paoHome,\r\n\t\t\t\t\t\t\t\tresourceIds,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\tif (!ensured.ok) {\r\n\t\t\t\t\t\t\t\trunOptions.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t...(runOptions.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t`[evolution] 任务绑定初始化失败（taskId=${bindingTaskId}）：${ensured.error.message}（worker 沿用资源根装载）`,\r\n\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t} finally {\r\n\t\t\t\t\t\t\tbindStore.close();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// 派发缺省超时(兜底护栏):调用方未显式给 超时毫秒 时按保温配置兜底(缺省 24 小时)——\r\n\t\t\t\t// 到点走与主动停止相同的收敛路径(树杀→证据→超时回执→finally 放锁/名额),不留无限期悬挂。\r\n\t\t\t\t// B 档定位:静默提醒叫人裁决是主判决,本超时只兜「无人应答」的底。\r\n\t\t\t\trunOptions.超时毫秒 ??= readDispatchTimeoutMs(options.paoHome);\r\n\t\t\t\t// 认领租约(S5 包3,运行器事实):认领时间/租约到期＝监督信号(到期不自动放权,amber 呈现),\r\n\t\t\t\t// 认领代数＝接管代际;时长与派发超时同源配置,随 run() 落登记表条目。\r\n\t\t\t\trunOptions.租约 = buildClaimLease(\r\n\t\t\t\t\tnew Date(),\r\n\t\t\t\t\trunOptions.超时毫秒,\r\n\t\t\t\t\trunner.registry.claimGeneration(claimed.card.path),\r\n\t\t\t\t);\r\n\t\t\t\t// 门禁放行且认领成功＝这次真开跑:把\"预留\"转成\"已提交\"（此刻之后不再归还,\r\n\t\t\t\t// 因为 worker 可能已经花了钱）。commit 只落盘记账,不拉起任何进程。\r\n\t\t\t\t// 清空 gate 的时机在 commit 成功之后:commit 自己抛错＝还没开跑,交给 finally 归还。\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t\tif (gate) {\r\n\t\t\t\t\tawait gate.commit();\r\n\t\t\t\t\tcommittedGate = gate;\r\n\t\t\t\t\tgate = undefined;\r\n\t\t\t\t\tgatePhase.value = \"committed\";\r\n\t\t\t\t}\r\n\t\t\t\tlet receipt: WorkerReceipt;\r\n\t\t\t\ttry {\r\n\t\t\t\t\tif (scriptStartFailure) {\r\n\t\t\t\t\t\treceipt = scriptStartFailure;\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\trunnerPhase = \"started\";\r\n\t\t\t\t\t\tfailurePhase = \"started\";\r\n\t\t\t\t\t\treceipt = await runner.run(runOptions);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tpreStartClaimRollback = undefined;\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tconst settlementNote =\r\n\t\t\t\t\t\tgatePhase.value === \"committed\"\r\n\t\t\t\t\t\t\t? await settleGateOnce(committedGate, gatePhase, (committed) =>\r\n\t\t\t\t\t\t\t\t\tcommitted.settleUnknown(errorMessage(error)),\r\n\t\t\t\t\t\t\t\t)\r\n\t\t\t\t\t\t\t: undefined;\r\n\t\t\t\t\tthrow errorWithSettlementNote(error, settlementNote);\r\n\t\t\t\t}\r\n\t\t\t\t// 脚本卡后置核对（批3b-E 调用层归类）：exit 0 且声明产物缺失 → script_artifact_missing；\r\n\t\t\t\t// 非零退出 → script_exit:<code>；超时 → script_timeout；进程没拉起 → script_start。\r\n\t\t\t\t// 取消沿既有 canceled 终态不改写；success 且产物齐全保持成功。\r\n\t\t\t\tif (scriptCard && !scriptStartFailure) {\r\n\t\t\t\t\treceipt.scriptRun = true;\r\n\t\t\t\t\tconst scriptDeclared = claimed.card.frontmatter.artifacts ?? [];\r\n\t\t\t\t\tif (receipt.status === \"success\" && receipt.exitCode === 0 && scriptDeclared.length > 0) {\r\n\t\t\t\t\t\tconst projectRoot = scriptArtifactProjectRoot(claimed.card, claimed.尝试号);\r\n\t\t\t\t\t\tconst checked = checkScriptArtifacts(scriptDeclared, projectRoot);\r\n\t\t\t\t\t\tif (checked.缺失.length > 0) {\r\n\t\t\t\t\t\t\treceipt.status = \"failed\";\r\n\t\t\t\t\t\t\treceipt.failure_type = \"script_artifact_missing\";\r\n\t\t\t\t\t\t\treceipt.artifact_path = checked.存在;\r\n\t\t\t\t\t\t\treceipt.summary = [\r\n\t\t\t\t\t\t\t\t`脚本退出码 0 但声明产物缺失：${checked.缺失.join(\"、\")}`,\r\n\t\t\t\t\t\t\t\t`已有产物已保留作诊断；按项目根 ${projectRoot} 复核`,\r\n\t\t\t\t\t\t\t].join(\"\\n\");\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t// 退出 0 且全部声明产物存在：产物按绝对路径写实收清单。\r\n\t\t\t\t\t\t\treceipt.artifact_path = checked.存在;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.stopReason === \"timeout\") {\r\n\t\t\t\t\t\treceipt.failure_type = \"script_timeout\";\r\n\t\t\t\t\t} else if (receipt.status === \"failed\" && receipt.exitCode !== 0 && receipt.exitCode > 0) {\r\n\t\t\t\t\t\treceipt.failure_type = scriptExitFailureType(receipt.exitCode);\r\n\t\t\t\t\t} else if (\r\n\t\t\t\t\t\t(receipt.status === \"failed\" || receipt.status === \"unknown\") &&\r\n\t\t\t\t\t\treceipt.exitCode < 0 &&\r\n\t\t\t\t\t\treceipt.pid <= 0\r\n\t\t\t\t\t) {\r\n\t\t\t\t\t\treceipt.status = \"failed\";\r\n\t\t\t\t\t\treceipt.failure_type = \"script_start\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// 两路尾部注明流名与是否截断（批3b-E 规格「写卡时注明流名及是否截断」）：\r\n\t\t\t\t\t// 卡面摘要 ≤3 行是硬校验，标注并入末行（不新增行）防顶破上限；\r\n\t\t\t\t\t// 尾部原文经 stdoutTail/stderrFullTail 送达调用方与证据。\r\n\t\t\t\t\tconst tailNote = [\r\n\t\t\t\t\t\treceipt.stdoutTail !== undefined\r\n\t\t\t\t\t\t\t? `stdout 尾部${receipt.stdoutTruncated ? \"（已截断）\" : \"（未截断）\"}`\r\n\t\t\t\t\t\t\t: undefined,\r\n\t\t\t\t\t\treceipt.stderrFullTail !== undefined\r\n\t\t\t\t\t\t\t? `stderr 尾部${receipt.stderrTruncated ? \"（已截断）\" : \"（未截断）\"}`\r\n\t\t\t\t\t\t\t: undefined,\r\n\t\t\t\t\t]\r\n\t\t\t\t\t\t.filter(Boolean)\r\n\t\t\t\t\t\t.join(\"；\");\r\n\t\t\t\t\tif (tailNote) {\r\n\t\t\t\t\t\tconst lines = receipt.summary.split(\"\\n\");\r\n\t\t\t\t\t\tlines[lines.length - 1] = `${lines[lines.length - 1]}（${tailNote}）`;\r\n\t\t\t\t\t\treceipt.summary = lines.join(\"\\n\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t// 单卡、扇出、自动链都在同一处按回执结算，业务回调只处理各自结果，避免漏结或重复结算。\r\n\t\t\t\tconst settlementNote =\r\n\t\t\t\t\tgatePhase.value === \"committed\"\r\n\t\t\t\t\t\t? await settleGateOnce(committedGate, gatePhase, (committed) => committed.settle(receipt))\r\n\t\t\t\t\t\t: undefined;\r\n\t\t\t\tif (settlementNote) {\r\n\t\t\t\t\treceipt.派发告警 = [...(receipt.派发告警 ?? []), settlementNote];\r\n\t\t\t\t}\r\n\t\t\t\t// O13/S9-06/07：worker 回执终态按绑定清单逐条 recordUsed（outcome 映射\r\n\t\t\t\t// success/failure，receiptRef 定位回执）；失败终态再做一次\r\n\t\t\t\t// handleRegression 判定（problemId 无明确线索时不传，靠 used 行 +\r\n\t\t\t\t// 本任务 active 绑定判 normal_breakage）。invalid_input（无绑定）\r\n\t\t\t\t// 预期内不噪音；其他错误记派发告警不阻塞结果。\r\n\t\t\t\tif (workerBindingTaskId !== undefined && workerBoundResourceIds.length > 0 && options.paoHome) {\r\n\t\t\t\t\tconst usedStore = openMemoryStore(options.paoHome, \"readwrite\");\r\n\t\t\t\t\ttry {\r\n\t\t\t\t\t\tconst outcome = receipt.status === \"success\" ? \"success\" : \"failure\";\r\n\t\t\t\t\t\tconst receiptRef = `receipt:${claimed.card.path}:attempt:${claimed.尝试号}`;\r\n\t\t\t\t\t\t// worker 真实运行的会话 ID：会话文件名是 {时间戳}_{sessionId}.jsonl。\r\n\t\t\t\t\t\t// 延续会话时 worker resume 旧 sessionId（=旧 taskId，旧绑定），与派发层\r\n\t\t\t\t\t\t// 本轮写的绑定键不同——used/退步必须记到 worker 实际跑的那个键下。\r\n\t\t\t\t\t\tlet usedTaskId = workerBindingTaskId;\r\n\t\t\t\t\t\tif (receipt.会话路径) {\r\n\t\t\t\t\t\t\tconst m = /_([^_\\\\/]+)\\.jsonl$/i.exec(basename(receipt.会话路径));\r\n\t\t\t\t\t\t\tif (m && m[1] !== workerBindingTaskId) {\r\n\t\t\t\t\t\t\t\tusedTaskId = m[1];\r\n\t\t\t\t\t\t\t\t// 本轮派发前写的绑定挂在派发期 taskId 下，worker 实际用了旧\r\n\t\t\t\t\t\t\t\t// sessionId 的旧绑定——孤儿行清掉，避免以后被当成受影响任务。\r\n\t\t\t\t\t\t\t\tfor (const resourceId of workerBoundResourceIds) {\r\n\t\t\t\t\t\t\t\t\tdeactivateTaskBinding(usedStore, { taskId: workerBindingTaskId, resourceId });\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tfor (const resourceId of workerBoundResourceIds) {\r\n\t\t\t\t\t\t\tconst written = recordUsed(usedStore, {\r\n\t\t\t\t\t\t\t\tresourceId,\r\n\t\t\t\t\t\t\t\ttaskId: usedTaskId,\r\n\t\t\t\t\t\t\t\treceiptRef,\r\n\t\t\t\t\t\t\t\toutcome,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\tif (!written.ok && written.error.code !== \"invalid_input\") {\r\n\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t`[evolution] worker 对 ${resourceId} 记 used 失败：${written.error.message}`,\r\n\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tif (outcome === \"failure\") {\r\n\t\t\t\t\t\t\t\tconst regression = handleRegression(usedStore, {\r\n\t\t\t\t\t\t\t\t\tresourceId,\r\n\t\t\t\t\t\t\t\t\ttaskId: usedTaskId,\r\n\t\t\t\t\t\t\t\t\tfailureDescription: receipt.summary,\r\n\t\t\t\t\t\t\t\t\tpaoHome: options.paoHome,\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t\tif (!regression.ok) {\r\n\t\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t\t`[evolution] worker 对 ${resourceId} 退步判定失败：${regression.error.message}`,\r\n\t\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t\t} else if (regression.judgement.isRegression) {\r\n\t\t\t\t\t\t\t\t\treceipt.派发告警 = [\r\n\t\t\t\t\t\t\t\t\t\t...(receipt.派发告警 ?? []),\r\n\t\t\t\t\t\t\t\t\t\t`[evolution] ${resourceId} 版本 ${regression.badVersion} 判退步（${regression.judgement.kind}），` +\r\n\t\t\t\t\t\t\t\t\t\t\t`已回退至 ${regression.notification?.currentVersion ?? regression.badVersion}；` +\r\n\t\t\t\t\t\t\t\t\t\t\t`受影响任务 ${regression.notification?.affectedTaskIds.length ?? 0} 个`,\r\n\t\t\t\t\t\t\t\t\t];\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t} finally {\r\n\t\t\t\t\t\tusedStore.close();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tsharedLock = await acquireSharedLock({\r\n\t\t\t\t\troot: projectRoot,\r\n\t\t\t\t\tholder: claimed.card.path,\r\n\t\t\t\t\twait: true,\r\n\t\t\t\t\tretries: 60,\r\n\t\t\t\t});\r\n\t\t\t\toutcome = {\r\n\t\t\t\t\t可派: true,\r\n\t\t\t\t\tresult: await completed(claimed, receipt),\r\n\t\t\t\t\t...(supervisionRoute ? { supervisionRoute } : {}),\r\n\t\t\t\t};\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t\tconst proof = runner.confirmStopped(claimed.card.path);\r\n\t\t\t\tawait releaseDispatchLock(executionLock, proof, dispatchDetails);\r\n\t\t\t\texecutionLock = undefined;\r\n\t\t\t\texecutionStopProven = true;\r\n\t\t\t\trunnerPhase = \"stopProven\";\r\n\t\t\t}\r\n\t\t}\r\n\t} catch (error) {\r\n\t\tbodyError = error;\r\n\t} finally {\r\n\t\tif (bodyError !== undefined && runnerPhase === \"notStarted\" && preStartClaimRollback) {\r\n\t\t\ttry {\r\n\t\t\t\trollbackPreStartClaim(preStartClaimRollback);\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconst note = `启动前卡面回滚失败：${errorMessage(error)}`;\r\n\t\t\t\tlogWarn(`[pao] ${note}:${preStartClaimRollback.path}`);\r\n\t\t\t\tif (bodyError instanceof PaoWorkerError) {\r\n\t\t\t\t\tbodyError = new PaoWorkerError(bodyError.code, `${errorMessage(bodyError)}；${note}`, bodyError.detail);\r\n\t\t\t\t} else if (bodyError instanceof Error) {\r\n\t\t\t\t\tbodyError = new Error(`${bodyError.message}；${note}`, { cause: bodyError });\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t// 预留归还（G4）:只在\"确定没开跑\"时归还——gate 仍挂着＝commit 没成功（或压根没认领成功）,\r\n\t\t// 线程从未拉起,这笔钱没花;已 commit 或已有回执的都不归还（结果不明按 G2 口径留给人工查）。\r\n\t\tif (gate && gatePhase.value === \"notCommitted\") await releaseGateQuietly(gate, input);\r\n\t\ttry {\r\n\t\t\tif (sharedLock) {\r\n\t\t\t\tawait releaseSharedLock(sharedLock);\r\n\t\t\t\tsharedLock = undefined;\r\n\t\t\t}\r\n\t\t} catch (error) {\r\n\t\t\tlogWarn(`[pao] 共享事务锁释放失败:${errorMessage(error)}`);\r\n\t\t}\r\n\t\tif (executionLock && !executionStopProven) {\r\n\t\t\tconst heldLock = executionLock;\r\n\t\t\ttry {\r\n\t\t\t\tconst proof = runner.confirmStopped(dispatchIdentity);\r\n\t\t\t\tawait releaseDispatchLock(heldLock, proof, dispatchDetails);\r\n\t\t\t\texecutionLock = undefined;\r\n\t\t\t\texecutionStopProven = true;\r\n\t\t\t\trunnerPhase = \"stopProven\";\r\n\t\t\t} catch (error) {\r\n\t\t\t\tstopConfirmFailed = error;\r\n\t\t\t\tretainDispatchLock(heldLock, \"停止未确认，保留执行长锁\", {\r\n\t\t\t\t\terror: errorMessage(error),\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (releaseSlot) {\r\n\t\t\tif (runnerPhase === \"stopProven\") {\r\n\t\t\t\treleaseSlot();\r\n\t\t\t} else if (runnerPhase === \"notStarted\") {\r\n\t\t\t\t// 执行长锁尚未取得时不可能进入 runner.run；这里复核一次，避免把“尚未拿到锁”\r\n\t\t\t\t// 误当成进程已停。确认失败则保留名额，等人工核对。\r\n\t\t\t\ttry {\r\n\t\t\t\t\trunner.confirmStopped(dispatchIdentity);\r\n\t\t\t\t\treleaseSlot();\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tstopConfirmFailed ??= error;\r\n\t\t\t\t\tlogWarn(`[pao] 派发未进入运行但无法确认无进程，保留共享名额:${errorMessage(error)}`);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tlogWarn(`[pao] worker 停止未确认，保留共享名额与执行长锁:${dispatchIdentity}`);\r\n\t\t\t}\r\n\t\t}\r\n\t\treleaseBudgetQueue?.();\r\n\t\tif (executionRootGuard) {\r\n\t\t\t// 执行长锁从未取得时不可能启动 runner；可安全回滚获取锁前拿到的守卫。\r\n\t\t\tif (executionStopProven || (!executionLock && runnerPhase === \"notStarted\")) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tawait executionRootGuard.release();\r\n\t\t\t\t\texecutionRootGuard = undefined;\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tlogWarn(`[pao] 执行根守卫释放失败（执行已停止，守卫仍保留供人工核对）:${errorMessage(error)}`);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\t// 停止未确认时 guard 与 execution 长锁一样保留；不能只释放守卫，\r\n\t\t\t\t// 否则清理流程可能在孤儿 worker 仍写执行根时删除工作树。\r\n\t\t\t\tlogWarn(`[pao] 停止未确认，保留执行根守卫:${executionRootGuard.executionRoot}`);\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (pythonCacheDir && (executionStopProven || (!executionLock && runnerPhase === \"notStarted\"))) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(pythonCacheDir, { recursive: true, force: true });\r\n\t\t\t} catch (error) {\r\n\t\t\t\tlogWarn(`[pao] Python 缓存目录清理失败（保留供人工核对）:${pythonCacheDir}:${errorMessage(error)}`);\r\n\t\t\t}\r\n\t\t} else if (pythonCacheDir) {\r\n\t\t\tlogWarn(`[pao] worker 停止未确认，保留 Python 缓存目录:${pythonCacheDir}`);\r\n\t\t}\r\n\t\tif (stopConfirmFailed !== undefined && bodyError !== undefined) {\r\n\t\t\t// 原始错误优先上抛,停止确认失败单独记录不遮蔽\r\n\t\t\tlogWarn(\r\n\t\t\t\t`[pao] 派发停止确认失败(锁未放,先停后放锁):${stopConfirmFailed instanceof Error ? stopConfirmFailed.message : String(stopConfirmFailed)}`,\r\n\t\t\t);\r\n\t\t}\r\n\t}\r\n\tif (bodyError !== undefined) {\r\n\t\tif (bodyError instanceof PaoWorkerError) {\r\n\t\t\tbodyError.dispatchFailurePhase ??= failurePhase;\r\n\t\t}\r\n\t\tthrow bodyError;\r\n\t}\r\n\tif (stopConfirmFailed !== undefined) throw stopConfirmFailed;\r\n\treturn outcome;\r\n}\r\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\r\n\n * 单卡派发共享核心(pao_dispatch_card 与 pao_fanout 同一条链路,2026-10-02 定案): * 校验 → 认领(unclaimed→in_progress,失败卡先重开)＋认领基线快照 → 构建 runOptions → 拉起 → 登记。 * 从 fanout/execute.ts 提取(认领状态迁移＋基线快照＋runOptions 构建),fanout 改为调用本模块; * 依赖方向 fanout→worker 单向——本模块不得 import fanout,故 worker 提示词构建 * (buildWorkerPrompt)与回执缺省分型(classifyWorkerFailure)随之迁入,fanout/plan 再转发导出 * 保公共面不变。权限(fail-closed)与部门并发上限(保温配置)是 pao_dispatch_card 的派前校验,也在此。 */\r\n\r\n\n\nimport { randomUUID } from \"node:crypto\";import { existsSync, readFileSync, rmSync } from \"node:fs\";import { mkdir } from \"node:fs/promises\";import { tmpdir } from \"node:os\";import { basename, dirname, join, resolve } from \"node:path\";import { findCardFile } from \"../cards/cardfile.ts\";\tbindExecutionContext,\ttype ExecutionBinding,\texecutionContextPath,\tresolveExecutionContext,} from \"../cards/execution-context.ts\";import type { FailureType } from \"../cards/index.ts\";\tappendReceipt,\tblackboardPointer,\tchangeCardStatus,\tcheckDependencies,\tensureBlackboard,\tformatCardNumber,\tlistCards,\tPaoCardError,\ttype ParsedCard,\tparseCardRef,\tprojectRootForCards,\ttype ReceiptOutcome,\treadCard,\tscanCards,\tserializeCard,\tsnapshotClaimBaseline,\twriteFileAtomic,} from \"../cards/index.ts\";import type { CardBudget } from \"../cards/types.ts\";import { DEPT_RECIPE_METHOD_HEADING, splitRecipeMethod } from \"../dept/render.ts\";\ttype DispatchInputSnapshot,\ttype DispatchWorkspaceInput,\tdispatchInputSnapshotPath,\tdispatchReconWorkerEnvironment,\tfreezeDispatchBrief,\tprepareDispatchBrief,\tresolveCurrentAttemptReconRefs,\ttryReadGitIdentity,\tverifyDispatchSnapshot,} from \"../dispatch-brief/index.ts\";import { readWarmConfig } from \"../host/config.ts\";import { deactivateTaskBinding } from \"../evolution/binding.ts\";import { ensureTaskBindings } from \"../evolution/host-mount.ts\";import { recordUsed } from \"../evolution/observe.ts\";import { handleRegression } from \"../evolution/regression.ts\";import { memoryPaths } from \"../memory/paths.ts\";import { openMemoryStore } from \"../memory/store.ts\";import type { SelectedMemoryReference } from \"../memory/session.ts\";import { isPatrolGoal } from \"../patrol/draft.ts\";import { resolvePaoRole } from \"../role.ts\";import { loadTierConfig, resolveTierConfigPath, tierNameToModel } from \"../routing/config.ts\";import { logWarn } from \"../shared/log.ts\";import { pathKey } from \"../shared/path-key.ts\";import { createPythonCacheDir, PYTHON_CACHE_ENV } from \"../shared/python-cache.ts\";import { nowString, utcNow } from \"../shared/time.ts\";\tcreateSingleRootWorktreeHost,\ttype PaoWorktreeHost,\ttype WorktreeBinding,\ttype WorktreeTarget,} from \"../worktrees/types.ts\";import { checkCleanupReadyForDispatch } from \"./cleanup.ts\";// 工作流解释已归 workflow/dispatch-context（T02）:worker 只经注入回调消费其最小上下文,// 这里仅类型引用（import type,运行期零依赖）——worker 不得再 import workflow 实现。import type { WorkflowDispatchContext } from \"./dispatch-types.ts\";import { PaoWorkerError } from \"./errors.ts\";\tacquireExecutionLock,\tacquireExecutionRootGuard,\tacquireSharedLock,\ttype DispatchWriteLock,\ttype ExecutionRootGuard,\treleaseDispatchLock,\treleaseSharedLock,\tretainDispatchLock,} from \"./lock.ts\";import type { WorkerReceipt } from \"./receipt.ts\";import type { ProcessEntry } from \"./registry.ts\";import type { StopProof, WorkerRunner, WorkerRunOptions } from \"./runner.ts\";\tcheckScriptArtifacts,\tisScriptCard,\tplanScriptRun,\tscriptArtifactProjectRoot,\tscriptExitFailureType,} from \"./script-run.ts\";import type { WorkerSupervisionRoute } from \"./supervision.ts\";// ── 提示词与分型(自 fanout/plan 迁入;fanout/plan 转发导出,公共面不变) ──────────/** worker 提示词：冻结简报携带本次任务，卡文件用于追溯。 *  结果协议优先经托管工具交给父进程，旧 JSON 文本作为同一 schema 的兼容入口。 */export function buildWorkerPrompt(\tcard: ParsedCard,\tattemptNo: number,\tfrozenBrief?: Pick<DispatchInputSnapshot, \"briefMarkdown\" | \"brief\" | \"snapshotDigest\">,\tclaimBaseline?: Pick<DispatchBaseline, \"available\" | \"snapshotPath\" | \"existingEntryCount\" | \"reason\">,): string {\treturn [\t\t`你是 pao worker,执行${formatCardNumber(card.card_no)}(尝试 ${attemptNo})。`,\t\t...(frozenBrief\t\t\t? [\t\t\t\t\t\"以下是本次冻结的执行简报，它是任务说明的主入口：\",\t\t\t\t\tfrozenBrief.briefMarkdown.trim(),\t\t\t\t\t`冻结简报：${frozenBrief.brief.ref}（${frozenBrief.brief.digest}）；输入快照：${frozenBrief.snapshotDigest}`,\t\t\t\t]\t\t\t: []),\t\t`卡文件只用于追溯与状态：${card.path}`,\t\t...(claimBaseline\t\t\t\t\t`本次尝试的认领基线：${\t\t\t\t\t\tclaimBaseline.available && claimBaseline.snapshotPath\t\t\t\t\t\t\t? claimBaseline.snapshotPath\t\t\t\t\t\t\t: `不可用（${claimBaseline.reason ?? \"原因未记\"}）`\t\t\t\t\t}；认领时已有 ${claimBaseline.existingEntryCount} 条改动，属于认领前现场，不计入本次尝试。`,\t\t...(card.body.includes(\"<!-- pao-dispatch-result -->\") ||\t\t(card.frontmatter.inputs ?? []).some((ref) => ref.includes(\"侦察-\"))\t\t\t\t\t\"这是侦察卡：交回执前必须调用 pao_save_dispatch_recon，按 facts、unknowns、scope、acceptance、risks、evidence、integration 分类保存实际结论、未知项和证据；不得从回执 summary 伪造结构化侦察结果。\",\t\t\"核对目标、限制与验收；可读取依赖文件、必要定义及直接调用点，限任务影响范围。简报、地图或契约与源码冲突时停止并报告。延续会话中的旧现场仅作背景，以本次任务、权限和认领基线为准。\",\t\t'任务完成或确定失败后，优先调用 pao_submit_receipt：{\"result\":\"success\",\"artifact_path\":[],\"summary\":\"不超过 3 行\",\"任务态\":\"completed\",\"verification\":[],\"changes\":[]}。该调用成功后的最后一条助手消息可写普通说明，不必重复 JSON。失败/未知必须给 failure_type（transient/missing_input/insufficient_capability/unknown_outcome）。',\t\t\"若当前环境没有该工具，才在最后一条助手消息输出上面同一 schema 的 JSON 回执。工具已开始但未成功结束、调用失败或多次调用时不能改用文本回执；普通退出码不能代替回执。\",\t\t'任务态：completed=验收全达标；completed_with_deviations=有未达项但可交付；blocked=缺用户输入；checkpoint=到决策点须指引。verification 逐项记录 {\"条件\":\"…\",\"结论\":\"pass|fail|not_run\",\"证据\":\"…\"}，没跑写 not_run。changes 记录 {\"路径\":\"…\",\"类型\":\"created|modified|deleted|moved\",\"说明\":\"…\"}，含源码等本次所有写操作。artifact_path 仅列本次新增或改写且真实存在的文件产物，相对当前执行根；没有则 []。认领前及前次成果、只读复验只能作证据，不列为本次 changes 或 artifact_path。交回前与认领基线核对；自报不代替程序验收。',\t\t\"不得在结果参数中填写卡号、尝试号、run 标识、执行根、用量、证据路径或退出码；这些程序事实由宿主从事件流和当前 ExecutionBinding 采集。工具只提交当前尝试的自述结果，不改卡状态、不验收、不交卷、不再派发。\",\t\t\"verification 记录本次由你负责的检查：必做却未做的检查必须写 not_run，失败必须写 fail。明确交给后续部长或独立审核员的复核职责，留在任务要求中并在 summary 注明待审，不混入你的自检结果，也不得冒称已通过。自检未达由主控逐项裁决；后续审核由系统另行发起。\",\t\t\"verification 每项都须含非空条件和合法结论；补充说明放 summary，不在数组中插入说明对象，否则整份回执无效。\",\t\t...(process.platform === \"win32\"\t\t\t? [\"含中文的 .ps1 用 UTF-8 BOM 保存，并实际运行验证（兼容 PowerShell 5.1）。\"]\t\t// 只许/禁止清单（S5 包4 四写法③：纪律白纸黑字进角色提示词,不只留在架构文档）\t\t\"只许:按卡干活;一次性任务,完成即交回执并退出;只写任务工作区与目标项目。\",\t\t\"禁止:不得再派发子任务;不得改卡状态与信封字段（程序维护）;不得谎报 pass 或漏报改动。\",\t].join(\"\\n\"); * worker 回执状态 → 失败四型的缺省分型(架构 §2.1;与 cards 的 routeFailure 同一口径)。 * - unknown(runner 的 \"unknown\":已改项目但拿不到结果)→ \"unknown_outcome\"; * - failed → 缺省按 \"transient\"(可自动重派)路由;missing_input/insufficient_capability 的精细分型由回执审查阶段订正, *   机器不冒充判断; * - success/canceled 不算失败,返回 undefined。export function classifyWorkerFailure(\treceipt: Pick<WorkerReceipt, \"status\" | \"failure_type\">,): FailureType | undefined {\tif (receipt.failure_type && (receipt.status === \"failed\" || receipt.status === \"unknown\"))\t\treturn receipt.failure_type;\tif (receipt.status === \"unknown\") return \"unknown_outcome\";\tif (receipt.status === \"failed\") return \"transient\";\treturn undefined;// ── S5 包4 四写法②：回执标签路由（任务态→处理动作,单源）＋③ 主控/部长纪律块 ────/** 任务态标签 → owner 处理动作对照（办完即停,不忙等;消费面:派单结果/扇出摘要,别处引用不复制正文） */export function taskStateRoutingLine(任务态: NonNullable<WorkerReceipt[\"任务态\"]>): string {\tswitch (任务态) {\t\tcase \"completed\":\t\t\treturn \"任务态 completed（自报验收全达标）→ pao_verify_card 机械验收，过则交付；办完即停，不忙等\";\t\tcase \"completed_with_deviations\":\t\t\treturn \"任务态 completed_with_deviations（有未达项）→ 先审 verification 中 fail/not_run 条目再定验收；办完即停，不忙等\";\t\tcase \"blocked\":\t\t\treturn \"任务态 blocked（须用户输入）→ 补输入或退回补卡，不忙等\";\t\tcase \"checkpoint\":\t\t\treturn \"任务态 checkpoint（到决策点须指引）→ 给指引后可另开新尝试续跑，不忙等\";\t}/** 主控/部长只处理任务判断；程序承担状态、正常交接和并发限制。 */export const OWNER_DISPATCH_DISCIPLINES =\t\"卡状态与信封字段由程序单写者维护，并发和共享名额由派发器检查。优先用受理入口自动完成验收与交付；底层派卡入口保留显式验收责任。主控按需读取产物和证据作判断，部长负责必要拆解与整合。\" +\t\"派完即停，等结果通知，不轮询；正常交接由程序推进，仅处理失败、待确认或需判断事项。\";// ── S5 包3：同号重试去重（唯一操作号＝卡路径＋尝试号）与认领租约 ──────────────── * 拒派原因＋同号去重信息（S5 包3）：进行中卡的拒因附带当前尝试既有回执结果—— * 已有回执＝返回既有结果（同号不重派,按回执处理）;无回执＝结果未知（先查现场,重启不盲重放）。 * 其余状态沿用 claimRefusalReason 原文案。export function claimRefusalDetail(card: ParsedCard): string | undefined {\tconst reason = claimRefusalReason(card.frontmatter.status);\tif (reason === undefined || card.frontmatter.status !== \"in_progress\") return reason;\tconst attempt = card.frontmatter.attempt;\tconst receipts = card.receipts.filter((r) => r.attempt === attempt && !r.archive_flag);\tif (receipts.length === 0) {\t\treturn `${reason}。当前尝试 ${attempt} 无回执＝结果未知：先查现场（pao_inventory；live 证据以登记表为准），重启后不盲重放在途操作`;\tconst last = receipts[receipts.length - 1];\treturn `${reason}。同号重试去重：当前尝试 ${attempt} 已有回执（result ${last.result ?? \"未记\"}${last.任务态 ? `，任务态 ${last.任务态}` : \"\"}）——按回执处理（机械验收/落终态），同号不重派`;/** 认领租约三字段（S5 包3,运行器事实）：到期＝监督信号（不自动放权）;时长与派发超时同源配置 */export function buildClaimLease(\tnow: Date,\tleaseMs: number,\tgeneration: number,): { 认领时间: string; 租约到期: string; 认领代数: number } {\treturn {\t\t认领时间: now.toISOString(),\t\t租约到期: new Date(now.getTime() + leaseMs).toISOString(),\t\t认领代数: generation,\t};/** 路径等价判定（shared/path-key 唯一实现,与 runner executionKey 同口径）;pao_terminate_card 同号收窄同用 */export function sameCardPath(a: string, b: string): boolean {\treturn pathKey(a) === pathKey(b); * 孤儿显式接管（S5 包3,仅 接管=true 时进入）：进行中卡＋登记表无活条目 → 推进代数、 * 卡走状态机落失败（结果未知,依据＝孤儿接管）,随后 claimCardForDispatch 按失败重开分支 * 开新尝试。三种拒绝:已有当前尝试回执（同号去重优先）、登记表有活进程（先终止）、非进行中 * （走常规认领分支,接管参数无效）。跨进程旧链在途由项目写锁拦（锁被占用即拒）。async function takeoverOrphanForDispatch(\tregistry: { list(): ProcessEntry[]; bumpClaimGeneration(cardPath: string): number },\tinput: DispatchClaimInput,): Promise<string | undefined> {\tconst located = locateDispatchCard(input.cardsDir, input.card_no);\tif (located.frontmatter.status !== \"in_progress\") return undefined;\tconst receipts = located.receipts.filter((r) => r.attempt === located.frontmatter.attempt && !r.archive_flag);\tif (receipts.length > 0) {\t\tconst last = receipts[receipts.length - 1];\t\treturn `接管被拒：当前尝试 ${located.frontmatter.attempt} 已有回执（result ${last.result ?? \"未记\"}${last.任务态 ? `，任务态 ${last.任务态}` : \"\"}）——同号不重派，按回执处理（机械验收/落终态），要重做先落终态再派`;\tconst live = registry\t\t.list()\t\t.find((entry) => entry.running && entry.card_path !== undefined && sameCardPath(entry.card_path, located.path));\tif (live) {\t\treturn `接管被拒：卡${formatCardNumber(located.card_no)} 尝试 ${located.frontmatter.attempt} 仍有活进程(pid=${live.pid})——先 pao_terminate_card 停掉再接管，不双跑`;\t// 推进代数（旧条目随之打 被接管）,再走状态机落失败——依据留痕进回执区\tregistry.bumpClaimGeneration(located.path);\tchangeCardStatus(located, {\t\t操作者: input.operator,\t\tto: \"failed\",\t\t失败类型: \"unknown_outcome\",\t\t依据: `孤儿接管：当前尝试 ${located.frontmatter.attempt} 无回执且登记表无活进程，由 ${input.operator} 显式接管推进代际`,\t\t时间: input.time,\t});// ── 时间与回执落卡(自 fanout/execute 迁入,两条链路同一实现) ──────────────────// 回执/owner 记录的时间格式是卡片协议冻结的本地「YYYY-MM-DD HH:mm」——唯一实现在// shared/time(9 处重复定义合一);机器可读字段(登记表等)才用 UTC ISO,别混。/** 回执使用启动时捕获的尝试号；重读只为按当前状态判断旧尝试/迟到回执。 */export async function appendDispatchReceipt(\treceipt: WorkerReceipt,\tnow: () => Date = () => new Date(),): Promise<ReceiptOutcome> {\tconst current = readCard(card.path);\t// receipt_format_recovery 的类型由回执模块维护；派发层只负责把恢复说明里的真实证据\t// 并入卡面证据列表。所有身份、产物和验收校验仍由下面的 appendReceipt 统一执行。\tconst recoveryEvidencePath = (\t\treceipt as WorkerReceipt & {\t\t\treceipt_format_recovery?: { strict_error: string; evidence_path?: string };\t\t}\t).receipt_format_recovery?.evidence_path;\tconst evidence = [\t\t...new Set([receipt.evidence_path, recoveryEvidencePath].filter((path): path is string => Boolean(path))),\t];\treturn appendReceipt(current, {\t\t尝试号: receipt.attempt,\t\t时间: nowString(now()),\t\t结果: receipt.status,\t\t摘要: receipt.summary,\t\t产物路径: receipt.artifact_path,\t\t证据: evidence.length > 0 ? evidence : undefined,\t\t// 脚本回执（批3b-E）：无模型用量不落零 token——turns/cost 给零值当已知零成本叶子，\t\t// 显式标 来源:\"脚本\"（显式说明，非缺省零值）；toolCalls/run_id 保留真实计数。\t\t// 聚合侧（receiptBudgetTotal）按数值字段求和：零值已知不计未知，来源标识仅供显示层文案。\t\t用量:\t\t\treceipt.stopReason === \"script_start\" || receipt.scriptRun === true\t\t\t\t? {\t\t\t\t\t\t来源: \"脚本\",\t\t\t\t\t\tturns: 0,\t\t\t\t\t\tcost: 0,\t\t\t\t\t\ttoolCalls: receipt.工具调用次数 ?? 0,\t\t\t\t\t\trun_id: receipt.run_id,\t\t\t\t: {\t\t\t\t\t\t...receipt.usage,\t\t\t\t\t\ttoolCalls: receipt.工具调用次数,\t\t\t\t\t\tmissing_usage_rounds: receipt.missing_usage_rounds,\t\t\t\t\t},\t\t失败类型: classifyWorkerFailure(receipt),\t\t// F-A7 自报透传（S5 包1）：任务态/verification/changes 落卡，机械验收消费。\t\t任务态: receipt.任务态,\t\tverification: receipt.verification,\t\tchanges: receipt.changes,// ── 认领链路(自 fanout/execute 提取;操作者参数化:扇出=主控,派单=派单者) ────────/** 扇出以主控身份做 owner 侧动作(认领/重开);架构 §1「蜂群是主会话的一个动作」 */export const FANOUT_OPERATOR = \"主控\";export function locateDispatchCard(cardsDir: string, cardNo: string): ParsedCard {\tconst target = parseCardRef(cardNo);\ttry {\t\tconst fileName = findCardFile(cardsDir, target);\t\tif (fileName) {\t\t\tconst card = readCard(join(cardsDir, fileName));\t\t\tif (card.card_no === target) return card;\t} catch {\t\t// 全量扫描保留读取问题和原有定位错误。\tconst { cards, problems } = scanCards(cardsDir);\tconst card = cards.find((parsed) => parsed.card_no === target);\tif (!card) {\t\t// 坏卡会让「找不到」变成假结论：把读不到的卡一并报出来，别让 owner 去猜（审查第 5 项）\t\tconst unreadable =\t\t\tproblems.length > 0\t\t\t\t? `；另有 ${problems.length} 张卡读不出来：${problems.map((p) => `${p.path}（${p.reason}）`).join(\"；\")}`\t\t\t\t: \"\";\t\tthrow new PaoCardError(\"INVALID_CARD\", `卡目录 ${cardsDir} 中找不到卡${cardNo}${unreadable}`, {\t\t\t卡号: cardNo,\t\t\tcardsDir,\t\t\t读取问题: problems,\t\t});\treturn card; * 同步拒派判定(纯函数,2026-10-05 修):终态/进行中卡不可认领的拒派原因——claimCard 的 * 链内把关与 pao_dispatch_card 的即时回执共用一份文案,已交付卡重复派单不再只等下一轮派卡通知 * 才能看到原因。可认领状态(unclaimed/failed)返回 undefined。export function claimRefusalReason(status: string): string | undefined {\tif (status === \"delivered\" || status === \"canceled\") return `卡已终态(${status}),不重跑;要重做请另立新卡`;\tif (status === \"in_progress\") {\t\treturn \"卡在先前的尝试手中(in_progress),不双跑;先由 owner 查现场并落终态(failed/canceled)再重派(架构 §2.1)\"; * 拉起前的卡状态处理(owner 侧,经 changeCardStatus 走状态机,不手写 frontmatter): * - 待认领 → 认领进行中(尝试 +1,无主则 owner=操作者); * - 失败 → 点名即重派决定:失败→待认领(校验 owner 与尝试上限)→进行中; * - 进行中 → 不拉起(在先前尝试手中,防双跑;先由 owner 查现场落终态再重派,架构 §2.1); * - 已交付/取消 → 不拉起(已终态,重做请另立新卡)。function claimCard(\toperator: string,\ttime: string,\tidentity?: import(\"../friction/drafts.ts\").FrictionEventIdentity,): { card: ParsedCard } | { 原因: string } {\tconst status = card.frontmatter.status;\tconst refusal = claimRefusalDetail(card);\tif (refusal) return { 原因: refusal };\tif (status === \"failed\") {\t\t// 失败→待认领会撞尝试上限门（重试到顶落摩擦草稿）——identity 透传（O10/E02）。\t\tconst reopened = changeCardStatus(card, {\t\t\t操作者: operator,\t\t\tto: \"unclaimed\",\t\t\t时间: time,\t\t\t...(identity === undefined ? {} : { identity }),\t\treturn {\t\t\tcard: changeCardStatus(reopened, {\t\t\t\t操作者: operator,\t\t\t\tto: \"in_progress\",\t\t\t\t时间: time,\t\t\t\t...(identity === undefined ? {} : { identity }),\t\t\t}),\t\t};\t\tcard: changeCardStatus(card, {\t\t\tto: \"in_progress\",\t\t}),/** 认领基线快照结果(R14/架构 §14):扇出与派单同一形状 */export interface DispatchBaseline {\tavailable: boolean;\t/** 快照文件路径(可用时才有) */\tsnapshotPath?: string;\t/** 认领当刻工作树已有的改动条数(用户既有脏文件数,不计 worker 的账) */\texistingEntryCount: number;\t/** 本基线对应的尝试号；旧版仅状态快照可缺省。 */\tattempt?: number;\t/** 不可用原因(非 git 仓库/git 不可用) */\treason?: string; * 认领基线快照(§14/R14):认领与新尝试(原状态 unclaimed/failed)才落快照,与工具层 pao_change_status * 走同一快照入口 snapshotClaimBaseline,交回执比对与交卷清点才有依据。 * 非认领(终态/进行中卡)返回 undefined;快照不可用不阻断认领,原因如实带上不静默。export async function claimBaselineForDispatch(input: {\tcardsDir: string;\t卡号: number;\t/** 认领前的卡状态(只有 unclaimed/failed 是新尝试认领) */\t原状态: string;\t/** 本次认领后的尝试号；基线必须按尝试隔离，重试不得覆盖旧尝试。 */\tattempt: number;\t/** 认领时的验收声明原文（S5 包2：哈希记账进快照，机械验收自动交付前比对，一变即失效须重审） */\t验收?: string;\towner?: string;\t时间: string;}): Promise<DispatchBaseline | undefined> {\tif (input.原状态 !== \"unclaimed\" && input.原状态 !== \"failed\") return undefined;\t\tconst baseline = await snapshotClaimBaseline(input.cardsDir, input.卡号, {\t\t\towner: input.owner,\t\t\t时间: input.时间,\t\t\tattempt: input.attempt,\t\t\t...(input.验收 !== undefined ? { 验收: input.验收 } : {}),\t\treturn baseline.可用\t\t\t? {\t\t\t\t\tavailable: true,\t\t\t\t\tsnapshotPath: baseline.快照路径,\t\t\t\t\texistingEntryCount: baseline.既有条目数,\t\t\t\t\tattempt: input.attempt,\t\t\t\t}\t\t\t: { available: false, existingEntryCount: 0, reason: baseline.原因 };\t} catch (error) {\t\t\tavailable: false,\t\t\texistingEntryCount: 0,\t\t\treason: error instanceof Error ? error.message : String(error),export interface DispatchClaimInput {\t/** 任务工作区卡目录 */\t/** 卡引用(卡0017 / 卡#17 / 17 均可) */\tcard_no: string;\t/** owner 侧动作身份(扇出=主控;pao_dispatch_card=派单者:主控写「主控」,部长写 PAO_DEPT 值) */\toperator: string;\ttime: string;\t * 孤儿显式接管(S5 包3):进行中卡＋登记表无活条目＋当前尝试无回执时,推进认领代数并\t * 落失败重开新尝试。缺省 false＝进行中卡一律拒派(同号去重/查现场)。\t */\t接管?: boolean;\t/** 受保护派发在确定真实执行根后捕获基线。 */\tdeferBaseline?: boolean;\t/** O10/E02：摩擦事件身份（认领路径的重试到顶草稿用；工具/扇出沿调用链下传）。 */\tfriction?: import(\"../friction/drafts.ts\").FrictionEventIdentity;export type DispatchClaimResult =\t| {\t\t\t可派: true;\t\t\t/** 认领后的卡(已写盘) */\t\t\tcard: ParsedCard;\t\t\t尝试号: number;\t\t\t/** 认领前的状态(unclaimed/failed = 本次是真认领,已落基线快照) */\t\t\t原状态: string;\t\t\tclaimBaseline?: DispatchBaseline;\t  }\t| { 可派: false; 原因: string }; * 定位卡 → 认领(unclaimed→in_progress,失败卡先重开)＋认领基线快照。 * 找不到卡抛 PaoCardError(调用方扇出记 未拉起/派单报错);状态不允许返回 可派:false。export async function claimCardForDispatch(input: DispatchClaimInput): Promise<DispatchClaimResult> {\tconst cards = listCards(input.cardsDir);\tconst gate = checkDependencies(\t\tlocated.frontmatter.depends_on ?? [],\t\t(number) => cards.find((card) => card.card_no === number)?.frontmatter.status,\t);\tif (!gate.放行)\t\t\t可派: false,\t\t\t原因: `依赖未放行：${gate.阻塞.map((item) => `${formatCardNumber(item.卡号)}(${item.状态})`).join(\"、\")}`,\tconst previousStatus = located.frontmatter.status;\tconst prepared = claimCard(located, input.operator, input.time, input.friction);\tif (\"原因\" in prepared) return { 可派: false, 原因: prepared.原因 };\tconst claimBaseline = input.deferBaseline\t\t? undefined\t\t: await claimBaselineForDispatch({\t\t\t\tcardsDir: input.cardsDir,\t\t\t\t卡号: located.card_no,\t\t\t\t原状态: previousStatus,\t\t\t\tattempt: prepared.card.frontmatter.attempt,\t\t\t\t验收: located.frontmatter.acceptance,\t\t\t\towner: prepared.card.frontmatter.owner,\t\t\t\t时间: input.time,\t\t\t});\t\t可派: true,\t\tcard: prepared.card,\t\t尝试号: prepared.card.frontmatter.attempt,\t\t原状态: previousStatus,\t\tclaimBaseline: claimBaseline, * 精确当前尝试停止。只复用 WorkerRunner 的活动条目停止链； * 卡路径与尝试任一不一致时拒绝，不把“没找到”猜成已停止。export async function stopCurrentDispatchAttempt(\trunner: WorkerRunner,\tcardPath: string,\tattempt: number,): Promise<StopProof> {\treturn runner.stopCurrentAttempt(cardPath, attempt);// ── runOptions 构建(公共参数/每卡参数合并 + 部门/派单理由进登记表) ──────────────export function buildDispatchRunOptions(input: {\tcard: ParsedCard;\t尝试号: number;\t/** 已冻结并由 verifyDispatchSnapshot 复核的本次执行输入。 */\tfrozenBrief?: Pick<DispatchInputSnapshot, \"briefMarkdown\" | \"brief\" | \"snapshotDigest\">;\t/** 本次尝试认领时建立的基线；只作为 worker 核算本次改动与只读证据的参照。 */\tclaimBaseline?: DispatchBaseline;\t/** 公共参数(cwd/超时/环境变量/工具白名单/证据目录等) */\t公共参数?: Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">>;\t/** 按卡/按次追加参数;与公共参数浅合并,本参数优先 */\t追加参数?: Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">>;\t/** 派单理由留痕(进登记表;扇出=批次理由,派单=单卡理由) */\t派单理由?: string | null;}): WorkerRunOptions {\tconst merged: Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">> = { ...input.公共参数, ...(input.追加参数 ?? {}) };\t// 巡库卡=无人值守(§6 预案①硬门槛):锁定工作区随派发注入,worker 会话 shell 全过护栏。\t// 锁定值=实际 spawn cwd(runner 对缺省 cwd 回落 process.cwd(),这里同步解析保持一致)。\tif (isPatrolGoal(input.card.frontmatter.goal ?? \"\")) {\t\tmerged.锁定工作区 = resolve(merged.cwd ?? process.cwd());\t\t...merged,\t\t卡号: String(input.card.card_no).padStart(4, \"0\"),\t\t卡路径: input.card.path,\t\t尝试号: input.尝试号,\t\t要求回执: true,\t\t提示词: buildWorkerPrompt(input.card, input.尝试号, input.frozenBrief, input.claimBaseline),\t\t部门: input.card.frontmatter.dept ?? null,\t\t派单理由: input.派单理由 ?? null,// ── pao_dispatch_card 派前校验:权限(fail-closed)与部门并发上限(配额护栏) ─────────────────export type DispatchPermission =\t| { 允许: true /** owner 侧动作身份:主控写「主控」,部长写 PAO_DEPT 值 */; 操作者: string }\t| { 允许: false; 原因: string }; * 派单权限(fail-closed,2026-10-02 定案):主控角色任意卡;部长角色必须 PAO_DEPT env 已设 * 且与卡的「部门」frontmatter 一致,否则拒派(报错写明缺什么/差什么)。 * worker 角色显式拒派——worker 面本就整模块跳过,这里是纵深防御,不留「非部长即主控」的暗门。export function checkDispatchPermission(input: { 卡部门: string; env?: NodeJS.ProcessEnv }): DispatchPermission {\tconst env = input.env ?? process.env;\tconst role = resolvePaoRole(env);\tif (role === \"worker\") {\t\treturn { 允许: false, 原因: \"worker 角色不得派单(worker 一次一卡,不得再派发子任务);派单是主控/部长共面\" };\tif (role !== \"部长\") return { 允许: true, 操作者: \"主控\" };\tconst dept = env.PAO_DEPT?.trim();\tif (!dept) {\t\t\t允许: false,\t\t\t原因: \"部长角色派单须先设 PAO_DEPT 环境变量(标明本部门);当前缺 PAO_DEPT,按 fail-closed 拒派\",\tif (input.卡部门 !== dept) {\t\t\t原因: `部长只派本部门卡:卡的部门是「${input.卡部门}」,与 PAO_DEPT「${dept}」不一致,拒派`,\treturn { 允许: true, 操作者: dept }; * 部门并发上限缺省 3:保温配置文件不存在或键缺失时照样生效。 * 这是配额护栏——安全默认开;与「缺保温文件=不保温」的功能语义(开关缺省关)相反,勿混。export const DEFAULT_DEPT_CONCURRENCY = 3;/** 部门并发上限配置文件相对 PAO_HOME 的路径(保温.json 共享读取模块同源,host/config) */export { WARM_CONFIG_RELATIVE_PATH as DEPT_CONCURRENCY_CONFIG_RELATIVE_PATH } from \"../host/config.ts\";/** 读部门并发上限:配置缺失/坏 JSON/键缺失/非法值一律回落缺省 3(护栏不因配置坏而失效)。 * 读取统一走保温配置共享模块(host/config.ts readWarmConfig),键语义全仓一份。 */export function readDeptConcurrencyCap(paoHome: string | undefined): number {\treturn readWarmConfig(paoHome).部门并发上限 ?? DEFAULT_DEPT_CONCURRENCY; * 读上游并发上限(M2-03 共享额度):登记表全部活进程＋在途名额的账号级硬顶(跨部门合并计, * 「模型名称不同但共用账号配额的不能各算一套并发」)。键缺失/非法＝undefined＝不启用 * 配置层(派单缺省 2/扇出计划值照旧)——这是「配额已知超卖才显式收紧」的功能语义, * 与部门上限护栏的安全默认开相反。真正的名额检查在 runner.reserveDispatchSlot。export function readUpstreamConcurrencyCap(paoHome: string | undefined): number | undefined {\treturn readWarmConfig(paoHome).上游并发上限; * 派发超时缺省 24 小时(B 档,2026-10-03 定案):机械超时的定位从主判决降级为 * 「静默提醒叫了人但无人应答」的最后底线——监督链路是 静默→叫醒上级看输出→上级裁决 * (pao_terminate_card),机械杀只在无人应答时兜底,防止 worker 挂死无限期占着项目写锁 * (同项目所有卡堵死)与并发名额。此前 2h 会把还在慢跑的正常任务误杀。export const DEFAULT_DISPATCH_TIMEOUT_MS = 86_400_000;/** 读派发超时(毫秒):保温.json「派发超时分钟」×60_000,与空闲分钟/停滞阈值分钟同款数值键口径。 *  键缺失/非法/文件缺失/坏 JSON 一律回落缺省 24 小时(护栏语义,安全默认开:派发链不留无限期悬挂; *  静默提醒才是主判决,本超时只兜「叫了人也没人应答」的底)。 */export function readDispatchTimeoutMs(paoHome: string | undefined): number {\tconst value = readWarmConfig(paoHome).派发超时分钟;\treturn value !== undefined ? Math.floor(value) * 60_000 : DEFAULT_DISPATCH_TIMEOUT_MS;export { projectRootForCards };function recipeField(recipe: string, name: string): string | undefined {\treturn (\t\trecipe.match(new RegExp(`^[\\\\t ]*-[\\\\t ]*${name}[\\\\t ]*[:：][\\\\t ]*([^\\\\r\\\\n]*)$`, \"m\"))?.[1].trim() || undefined// ── 仓库内容不得自我提权（S5 包2/架构 §4:98,参照 maestro B-6）──────────────────// 仓内工作流冻结实例声明的「技能」是 allow 类规则(装载面)；未经用户确认落本地前整体忽略并告警。// 允许清单 PAO_HOME/pao配置/skills/允许清单.json 只读不写——「总是允许」只经本地用户确认写本地,// PAO 任何代码路径不写该文件。部门配方住 PAO_HOME(用户本地,对位受信的 local settings)不受此门。/** 技能允许清单相对 PAO_HOME 的路径。 */export const SKILL_ALLOW_LIST_RELATIVE_PATH = join(\"pao配置\", \"skills\", \"允许清单.json\");/** 只读技能允许清单（技能名集合）；文件缺失/坏 JSON/表外类型一律空集（fail-closed，不猜）。 */export function loadSkillAllowList(paoHome: string | undefined): Set<string> {\tif (!paoHome) return new Set();\t\tconst raw: unknown = JSON.parse(readFileSync(join(paoHome, SKILL_ALLOW_LIST_RELATIVE_PATH), \"utf8\"));\t\tif (!Array.isArray(raw)) return new Set();\t\treturn new Set(raw.filter((name): name is string => typeof name === \"string\" && name.trim().length > 0));\t\treturn new Set();/** 配方「详细干法」段标题（S5 包4 双层配方切分标记）：该标题起的正文不常驻注入,worker 按需读取 */export const RECIPE_METHOD_HEADING = DEPT_RECIPE_METHOD_HEADING;/** 按卡→配方默认档位→档位.json 部门默认→主力解析；显式配置损坏或找不到档位时直接拒派。 *  工作流标记/冻结配方/实例校验已归 workflow/dispatch-context（T02）——这里只接收其解析出的 *  节点技能（workflowSkills）与部门配方技能合并去重,worker 不再知道配方版本。 */export function resolveDispatchParameters(\tcardsDir: string,\tpaoHome?: string,\tworkflowSkills?: string[],): Partial<WorkerRunOptions> {\tconst result: Partial<WorkerRunOptions> = { cwd: projectRootForCards(cardsDir) };\tconst recipePath = paoHome ? join(paoHome, \"部门\", card.frontmatter.dept, \"配方.md\") : undefined;\tconst recipe = recipePath && existsSync(recipePath) ? readFileSync(recipePath, \"utf8\") : \"\";\tif (recipePath && recipe) {\t\t// 配方双层（S5 包4 四写法①）：概要（「## 干法」段之前）常驻注入,干法正文不常驻——\t\t// 配方加厚不增加常驻 token,worker 按指针自取。无标记的旧配方整文件路径注入,零行为变化。\t\tconst split = splitRecipeMethod(recipe);\t\tresult.附加系统提示词 = !split.hasMethod\t\t\t? [recipePath]\t\t\t\t\t`${split.overview}\\n\\n（详细干法不常驻：按需读取 ${recipePath} 的「${RECIPE_METHOD_HEADING}」段；概要与职责边界以本段为准）`,\t\t\t\t];\tconst recipeTier = recipeField(recipe, \"默认档位\")?.split(/[（(]/)[0].trim();\tconst configPath = paoHome ? resolveTierConfigPath(paoHome) : undefined;\t// §22 第三级:档位.json「部门默认」(/model 编辑器可改)——卡与配方未指定时的部门级缺省,再兜底主力\tconst deptTier =\t\tconfigPath && existsSync(configPath) ? loadTierConfig(configPath).部门默认?.[card.frontmatter.dept] : undefined;\tconst tierName = card.frontmatter.tier ?? recipeTier ?? deptTier ?? \"primary\";\tif (configPath && (existsSync(configPath) || card.frontmatter.tier || recipeField(recipe, \"默认档位\"))) {\t\tconst tier = tierNameToModel(loadTierConfig(configPath), tierName);\t\tresult.模型 = tier.model;\t\tresult.思考档 = tier.thinkingLevel;\t} else if (card.frontmatter.tier) {\t\tthrow new PaoWorkerError(\"无效参数\", `卡指定档位「${tierName}」，但缺少 PAO_HOME/档位配置`);\tconst 派发告警: string[] = [];\tconst toolField = recipeField(recipe, \"工具\");\tif (toolField && !toolField.includes(\"待填\")) {\t\tconst tools = toolField.split(/[,，、\\s]+/).filter(Boolean);\t\tconst builtins = new Set([\"read\", \"grep\", \"find\", \"ls\", \"bash\", \"powershell\", \"write\", \"edit\"]);\t\tif (tools.length) {\t\t\t// 默认权限只可收紧（S5 包2）：表外名不再让整张白名单作废回全默认面（放宽方向），\t\t\t// 而是截到合法子集并告警；全表外名无合法子集可留，维持不设白名单但同样告警留痕。\t\t\tconst valid = tools.filter((tool) => builtins.has(tool));\t\t\tconst invalid = tools.filter((tool) => !builtins.has(tool));\t\t\tif (invalid.length > 0) {\t\t\t\t派发告警.push(\t\t\t\t\t`配方「工具」含表外名（${invalid.join(\"、\")}），已截到合法子集（默认权限只可收紧，不整表放宽）`,\t\t\t\t);\t\t\tif (valid.length > 0) result.工具白名单 = valid;\tconst skillField = recipeField(recipe, \"skills\") ?? recipeField(recipe, \"技能\");\tif (skillField && !skillField.includes(\"待填\") && paoHome) {\t\tresult.skills = skillField.split(/[,，、]+/).map((skill) => resolve(paoHome, \"pao配置\", \"skills\", skill.trim()));\t\tfor (const skill of result.skills)\t\t\tif (!existsSync(skill)) throw new PaoWorkerError(\"无效参数\", `配方技能路径不存在：${skill}`);\t// §11.6 按需技能挂载:卡面工作流标记→配方节点「技能」声明的解析（含 v2 实例校验）已归\t// workflow/dispatch-context;本函数只做与部门配方技能的合并去重（手动链/自动链统一生效）。\t// 技能装载面收窄（S5 包2/§4:98）：仓内实例声明的技能未经本地允许清单确认 → 整体忽略并告警。\tif (workflowSkills?.length) {\t\tconst allow = loadSkillAllowList(paoHome);\t\tconst allowed = workflowSkills.filter((skill) => allow.has(basename(skill)));\t\tconst ignored = workflowSkills.filter((skill) => !allow.has(basename(skill)));\t\tif (ignored.length > 0) {\t\t\t派发告警.push(\t\t\t\t`仓内工作流声明的技能未经本地允许清单确认，已忽略：${ignored.map((skill) => basename(skill)).join(\"、\")}` +\t\t\t\t\t`（人工确认后写入 $PAO_HOME/${SKILL_ALLOW_LIST_RELATIVE_PATH} 才生效；该清单只经本地用户确认，程序不代写）`,\t\t\t);\t\tif (allowed.length > 0) result.skills = [...new Set([...(result.skills ?? []), ...allowed])];\tif (派发告警.length > 0) result.派发告警 = 派发告警;\treturn result;function receiptBudgetTotal(\tcards: ParsedCard[],\tactiveAncestors: Set<number>,): { turns: number; toolCalls: number; cost: number; unknown: Set<string> } {\tconst descendants = new Set<number>([card.card_no]);\tfor (;;) {\t\tconst size = descendants.size;\t\tfor (const candidate of cards) {\t\t\tif (candidate.frontmatter.parent && descendants.has(parseCardRef(candidate.frontmatter.parent)))\t\t\t\tdescendants.add(candidate.card_no);\t\tif (descendants.size === size) break;\tconst total = { turns: 0, toolCalls: 0, cost: 0, unknown: new Set<string>() };\tconst seen = new Set<string>();\tfor (const candidate of cards.filter((item) => descendants.has(item.card_no))) {\t\t// 母卡当前可能正等待子卡；它的本次未完回执不等于 worker 已执行却缺账。\t\t// 其他已认领尝试（含本卡旧尝试）若缺回执，不能按零消耗继续分同一预算。\t\tconst reportedAttempts = new Set(\t\t\tcandidate.receipts.filter((receipt) => receipt.usage?.来源 !== \"汇总\").map((receipt) => receipt.attempt),\t\t);\t\tfor (let attempt = 1; attempt <= candidate.frontmatter.attempt; attempt++) {\t\t\t\tactiveAncestors.has(candidate.card_no) &&\t\t\t\tcandidate.frontmatter.status === \"in_progress\" &&\t\t\t\tattempt === candidate.frontmatter.attempt\t\t\t\tcontinue;\t\t\tif (!reportedAttempts.has(attempt)) {\t\t\t\tfor (const key of [\"turns\", \"toolCalls\", \"cost\"]) total.unknown.add(key);\t\tfor (const receipt of candidate.receipts) {\t\t\tconst usage = receipt.usage;\t\t\tif (usage?.来源 === \"汇总\") continue;\t\t\tconst id =\t\t\t\ttypeof usage?.run_id === \"string\" ? usage.run_id : `${candidate.path}:${receipt.attempt}:${receipt.time}`;\t\t\tif (seen.has(id)) continue;\t\t\tseen.add(id);\t\t\tfor (const key of [\"turns\", \"toolCalls\", \"cost\"] as const) {\t\t\t\tconst value = usage?.[key];\t\t\t\tif (typeof value === \"number\" && Number.isFinite(value) && value >= 0) total[key] += value;\t\t\t\telse total.unknown.add(key);\t\t\t\tusage?.来源 === \"未知\" ||\t\t\t\t(typeof usage?.missing_usage_rounds === \"number\" && usage.missing_usage_rounds > 0)\t\t\t\ttotal.unknown.add(\"cost\");\treturn total;/** 重试与协作子卡都从同一预算池扣已用量；费用缺账不影响已知轮次/工具次数。 */function budgetOwners(card: ParsedCard, cards: ParsedCard[]): ParsedCard[] {\tconst owners = [card];\tconst seen = new Set<number>([card.card_no]);\tlet cursor = card;\twhile (cursor.frontmatter.parent) {\t\tconst number = parseCardRef(cursor.frontmatter.parent);\t\tif (seen.has(number)) throw new PaoWorkerError(\"无效参数\", \"parent 预算归属形成循环\");\t\tseen.add(number);\t\tconst parent = cards.find((candidate) => candidate.card_no === number);\t\tif (!parent) throw new PaoWorkerError(\"无效参数\", `找不到 parent 预算归属卡：${cursor.frontmatter.parent}`);\t\towners.push(parent);\t\tcursor = parent;\treturn owners;export function remainingDispatchBudget(card: ParsedCard, cards: ParsedCard[]): CardBudget | undefined {\tconst owners = budgetOwners(card, cards);\tconst activeAncestors = new Set(owners.slice(1).map((owner) => owner.card_no));\tconst remaining: CardBudget = {};\tfor (const owner of owners) {\t\tconst budget = owner.frontmatter.budget;\t\tif (!budget) continue;\t\tconst total = receiptBudgetTotal(owner, cards, activeAncestors);\t\tfor (const key of [\"turns\", \"toolCalls\", \"cost\"] as const) {\t\t\tconst limit = budget[key];\t\t\tif (limit === undefined) continue;\t\t\tif (total.unknown.has(key))\t\t\t\tthrow new PaoWorkerError(\t\t\t\t\t\"无效参数\",\t\t\t\t\t`卡${formatCardNumber(owner.card_no)} 的 ${key} 已用量未知，不能确认剩余预算`,\t\t\tconst value = limit - total[key];\t\t\tif (value <= 0) throw new PaoWorkerError(\"无效参数\", `卡${formatCardNumber(owner.card_no)} 预算耗尽：${key}`);\t\t\tremaining[key] = Math.min(remaining[key] ?? value, value);\treturn Object.keys(remaining).length ? remaining : undefined;const projectQueues = new Map<string, Promise<void>>(); * 同一任务根或预算池的进程内串行队列；跨进程仍由持久预算门禁与共享短锁约束。 * 持有者必须在派发事务真正收尾后调用 release：同池下一张要先看到本次回执的已用量， * 不能在第一张仍运行时把“已认领、未回执”的占用报成未知后永久拒派。async function queueProjectWrite(root: string, signal?: AbortSignal): Promise<() => void> {\tconst key = pathKey(root);\tconst previous = projectQueues.get(key) ?? Promise.resolve();\tlet release: () => void = () => {};\tconst held = new Promise<void>((resolveHeld) => {\t\trelease = resolveHeld;\tconst tail = previous.then(() => held);\tprojectQueues.set(key, tail);\tvoid tail.then(() => {\t\tif (projectQueues.get(key) === tail) projectQueues.delete(key);\tlet onAbort: (() => void) | undefined;\t\tawait Promise.race([\t\t\tprevious,\t\t\tnew Promise<never>((_resolve, reject) => {\t\t\t\tonAbort = () => reject(new PaoWorkerError(\"已取消\", \"等待项目写锁期间已取消\"));\t\t\t\tif (signal?.aborted) onAbort();\t\t\t\telse signal?.addEventListener(\"abort\", onAbort, { once: true });\t\t]);\t\treturn release;\t\trelease();\t\tthrow error;\t} finally {\t\tif (onAbort) signal?.removeEventListener(\"abort\", onAbort);export interface ExecuteDispatchOptions {\t运行器: WorkerRunner;\tpaoHome?: string;\t * 在共享短锁内、正式认领前执行调用方的原子事务。\t * 工作流自动链用它同时完成实例额度预留与卡认领；普通派发不传时行为不变。\tclaimTransaction?: (claim: () => Promise<DispatchClaimResult>) => Promise<DispatchClaimResult>;\t * 宿主解析本次执行的权威工作树证明。正式派发必须提供；单根 CLI 显式安装\t * createSingleRootWorktreeHost，桌面通过 PaoWorktreeHost 的 RPC 代理注入。\tworktreeHost?: PaoWorktreeHost;\t/** 显式选择主目录或受管理工作树。 */\tworktreeTarget?: WorktreeTarget;\t/** 调度端已经绑定的工作树输入版本；为空时采用宿主本次解析结果。 */\texpectedInputVersion?: string;\t并发上限?: number;\t等待名额?: boolean;\t每卡参数?: (card: ParsedCard) => Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">>;\t信号?: AbortSignal;\t认领?: (claim: Extract<DispatchClaimResult, { 可派: true }>) => void;\t * 工作流派发校验回调（T02 装配注入,实现归 workflow/dispatch-context）:\t * 派发准备期解析工作流卡最小上下文（按需技能+实例身份;普通卡 undefined,非法即抛错拒派）;\t * executeDispatch 在取得项目写锁后、认领拉起前用同一回调重读控制正本做最终重核\t * （实例/轮次/owner/暂停/冻结版本,任一漂移即拒绝启动）。缺回调一律拒派——\t * 工作流卡不能绕过实例校验（fail-closed,不默认放行）。\tworkflowCheck: (card: ParsedCard) => WorkflowDispatchContext | undefined;\t * 总预算门禁接线（计划 §8.2，G4）:在**认领之前**问一次「这次派发允不允许花钱」。\t * 不传 = 完全零行为变化（跨任务额度未启用时的常态,也是既有所有调用方的现状）。\t * 传了就必须表态:放行交回 `commit`（预留已落盘）、`release`（确定未开跑时归还）\t * 与 `settle`（拿到回执后按真实用量结算）,拒绝交回 `reason`（给用户看的真实原因）。\t * 拒绝发生在锁后重核之后、认领之前——\t * 此刻卡还没有任何写盘动作,因此\"拒绝\"不会留下已派发的痕迹（卡状态/in-flight/通知都不会变）。\t * 为什么不在认领之后再拦:状态机没有 `in_progress → unclaimed` 这条迁移（见\t * cards/statemachine.ts:17-23 的 ALLOWED_TRANSITIONS），认领之后再拒绝,卡会卡在\t * 「进行中」而根本没有 worker 在跑——那正是要防的\"已派发\"假象。认领只许发生在\t * 「这一步之后不会再被拒」的位置上,所以门禁必须前置。\t预算门禁?: (card: ParsedCard, 尝试号: number, 剩余预算?: CardBudget) => Promise<DispatchBudgetGateResult>;\t/** 认领后、开跑前解析直接上级路由；null 明确表示本次不参与周期监督。 */\t解析监督路由?: (card: ParsedCard) => WorkerSupervisionRoute | null | undefined;\t/** 派发时读取主控/部长会话已选定的内置记忆；缺省零行为。 */\tresolveMemoryReferences?: () => SelectedMemoryReference[]; * 门禁结果的操作阶段： * - committed：runner 可能开始花钱，必须走 settle 或 settleUnknown； * - settled：本链已处理唯一一次结算，finally 不归还； * - notCommitted：commit 前中断，finally 负责 release。type DispatchGatePhase = \"notCommitted\" | \"committed\" | \"settled\";/** 总预算门禁的接线契约（dispatch-core 只认这个形状,不 import usage/ 的实现）。 */export type DispatchBudgetGateResult =\t/** 放行:`commit` 在即将拉起 runner 前调用;`release` 在确定没开跑时归还;`settle` 在拿到回执后结算。 */\t\t\tok: true;\t\t\t/** 预留判据/身份说明（进通知与回执,便于人对照账本）。 */\t\t\t说明?: string;\t\t\tcommit: () => Promise<void>;\t\t\trelease: () => Promise<void>;\t\t\tsettle: (receipt: WorkerReceipt) => Promise<string | undefined>;\t\t\t/** runner 已提交但没有回执时，按「费用未知」结算。 */\t\t\tsettleUnknown: (reason: string) => Promise<string | undefined>;\t/** 拒绝:`reason` 是给用户看的真实原因（含下一步）。 */\t| { ok: false; reason: string };/** 派发在返回结构化拒派前就抛错时的阶段；用于扇出区分未启动和结果未知。 */export type DispatchFailurePhase = \"before_start\" | \"started\"; * 归还门禁预留（G4）:只有\"确定没开跑\"的路径才调到这里。 * 归还本身失败不推翻派发结果（卡状态与拒派原因才是真相）,记警示后放行—— * 与认领基线/四指标账同款边界:派生数据落不了账不影响主判决。async function releaseGateQuietly(\tgate: Extract<DispatchBudgetGateResult, { ok: true }>,): Promise<void> {\t\tawait gate.release();\t\tlogWarn(\t\t\t`[pao] 总预算门禁预留归还失败（派发结果不受影响,额度可能仍占着,请核对总预算账）:卡${input.card_no} ${\t\t\t\terror instanceof Error ? error.message : String(error)\t\t\t}`,function errorMessage(error: unknown): string {\treturn error instanceof Error ? error.message : String(error); * 认领后、runner 真正进入启动边界前失败时，撤回本次认领对卡信封的改动。 * 状态机没有 in_progress -> unclaimed 的常规迁移；这里是派发事务自身的补偿动作。 * 只恢复状态机在认领时改过的四个字段，正文始终取盘上最新版本，避免覆盖同时发生的其他内容编辑。function rollbackPreStartClaim(rollback: {\tpath: string;\tstatus: ParsedCard[\"frontmatter\"][\"status\"];\toriginalAttempt: number;\tcompleted?: string;}): void {\tconst latest = readCard(rollback.path);\tif (latest.frontmatter.status !== \"in_progress\" || latest.frontmatter.attempt !== rollback.attempt) {\t\t\t\"无效参数\",\t\t\t`启动前回滚拒绝覆盖已变化的卡：期望 in_progress/attempt=${rollback.attempt}，实际 ${latest.frontmatter.status}/attempt=${latest.frontmatter.attempt}`,\t\t\t{ path: rollback.path },\tlatest.frontmatter.status = rollback.status;\tlatest.frontmatter.attempt = rollback.originalAttempt;\tif (rollback.owner === undefined) delete latest.frontmatter.owner;\telse latest.frontmatter.owner = rollback.owner;\tif (rollback.completed === undefined) delete latest.frontmatter.completed;\telse latest.frontmatter.completed = rollback.completed;\twriteFileAtomic(latest.path, serializeCard(latest.frontmatter, latest.body)); * 依赖卡的已保存结论只经执行上下文路由，不复制正文、不做语义改写。 * 依赖卡当前 attempt 没有可读 binding/brief 时跳过；坏记录或引用了不同当前尝试时显式拒派， * 避免把另一个尝试的结论冒充为本次输入。async function upstreamBriefReferences(): Promise<{ ref: string; purpose: string }[]> {\tconst refs: { ref: string; purpose: string }[] = [];\tfor (const dependency of card.frontmatter.depends_on ?? []) {\t\tconst dependencyNo = parseCardRef(dependency);\t\tconst dependencyCard = readCard(locateDispatchCard(cardsDir, dependency).path);\t\tif (dependencyCard.frontmatter.attempt < 1) continue;\t\ttry {\t\t\tconst execution = await resolveExecutionContext(\t\t\t\t{\t\t\t\t\tcardsDir,\t\t\t\t\tcardNo: dependencyNo,\t\t\t\t\tattempt: dependencyCard.frontmatter.attempt,\t\t\t\t},\t\t\t\t{ expectedCurrentAttempt: dependencyCard.frontmatter.attempt },\t\t\tif (execution.briefRef) {\t\t\t\trefs.push({\t\t\t\t\tref: execution.briefRef,\t\t\t\t\tpurpose: `依赖${formatCardNumber(dependencyNo)}尝试${dependencyCard.frontmatter.attempt}的已保存简报`,\t\t\t\t});\t\t\tconst outputs = resolveCurrentAttemptReconRefs({\t\t\t\tcardsDir,\t\t\t\tcardNo: dependencyNo,\t\t\t\tattempt: dependencyCard.frontmatter.attempt,\t\t\t\texecutionBindingDigest: execution.bindingDigest,\t\t\t\texecutionBindingRef: executionContextPath({\t\t\t\t}),\t\t\tfor (const output of outputs) {\t\t\t\t\tref: output.ref,\t\t\t\t\tpurpose: `依赖${formatCardNumber(dependencyNo)}尝试${dependencyCard.frontmatter.attempt}的侦察输出`,\t\t} catch (error) {\t\t\tif (error instanceof Error && \"code\" in error && error.code === \"EXECUTION_CONTEXT_NOT_FOUND\") continue;\t\t\tthrow new PaoWorkerError(\t\t\t\t\"无效参数\",\t\t\t\t`依赖${formatCardNumber(dependencyNo)}的 execution-context 不可用，拒绝冒充上游结论：${errorMessage(error)}`,\t\t\t\t{ cause: errorMessage(error), dependency: dependencyCard.path },\treturn refs; * 已提交的门禁只能结算一次。settle 自身失败不推翻 worker 结果，但必须返回可见告警， * 不能把“钱没结上”伪装成成功。async function settleGateOnce(\tgate: Extract<DispatchBudgetGateResult, { ok: true }> | undefined,\tphase: { value: DispatchGatePhase },\tsettle: (gate: Extract<DispatchBudgetGateResult, { ok: true }>) => Promise<string | undefined>,\tif (!gate) throw new PaoWorkerError(\"无效参数\", \"预算门禁已提交但结算句柄丢失，拒绝伪装成功\");\tif (phase.value !== \"committed\")\t\t\tphase.value === \"notCommitted\" ? \"预算门禁尚未提交，拒绝提前结算\" : \"同一次派发的预算门禁被重复结算\",\tphase.value = \"settled\";\t\treturn await settle(gate);\t\treturn `总预算结算失败（派发结果不受影响，但账未结清，请核对总预算账）：${errorMessage(error)}`;function errorWithSettlementNote(error: unknown, note: string | undefined): unknown {\tif (!note) return error;\tconst message = `${errorMessage(error)}；${note}`;\tif (error instanceof PaoWorkerError) return new PaoWorkerError(error.code, message, error.detail);\treturn new Error(message, { cause: error }); * 单一受保护派发入口（T03:正式派发只有这一条事务链）。单卡(pao_dispatch_card)、扇出(pao_fanout)、 * 工作流自动链三个入口都经它派发,准入判断同源;职责按五段拆在本模块既有函数,不另设管理器: * ①参数准备 resolveDispatchParameters/buildDispatchRunOptions * ②准入 checkDispatchPermission(工具层)/预算/名额/项目写锁/workflowCheck 锁后重核 * ③认领 claimCardForDispatch(含基线快照) ④启动 runner.run ⑤结果处理 completed 回调＋finally 逆序释放 * （写锁→名额→预算队列→项目队列;先停后放锁,停止确认失败不放锁）。 * 锁序固定:项目队列→预算队列→并发名额→项目写锁→重核→认领,与既有安全约束一致。export async function executeDispatch<T>(\tinput: DispatchClaimInput & { dispatch_reason?: string },\toptions: ExecuteDispatchOptions,\tcompleted: (claim: Extract<DispatchClaimResult, { 可派: true }>, receipt: WorkerReceipt) => Promise<T>,): Promise<{ 可派: true; result: T; supervisionRoute?: WorkerSupervisionRoute } | { 可派: false; 原因: string }> {\tconst runner = options.运行器;\t// 工作流校验回调必填（fail-closed）:没有它就无法保证工作流卡的实例校验,任何卡都不放行。\tconst workflowCheck = options.workflowCheck;\tif (!workflowCheck)\t\t\t\"缺工作流派发校验回调（workflowCheck）:工作流卡不能绕过实例校验,拒派（fail-closed）\",\tconst projectRoot = projectRootForCards(input.cardsDir);\t// 旧 SDK 直调契约没有宿主参数；只在入口内补单根适配器。正式扩展、桌面和 managed\t// 目标仍由装配层要求真实宿主，这里不会把受管目标降级成普通目录。\tconst worktreeHost = options.worktreeHost ?? createSingleRootWorktreeHost(projectRoot);\tconst worktreeTarget = options.worktreeTarget ?? { kind: \"primary\" as const };\tconst resolveWorkspace = (card: ParsedCard, binding: WorktreeBinding): DispatchWorkspaceInput => {\t\t// 无论 primary 还是 managed，都以实际执行根重新读取 Git 身份。宿主的\t\t// commonGitDir 用于交叉核验，不能让准备期从目录读到的身份和认领后从\t\t// binding 推断的身份走成两条分支。\t\tconst gitIdentity = tryReadGitIdentity(binding.executionRoot);\t\tconst hasStructuredGitReferences =\t\t\tcard.frontmatter.inputs?.some(\t\t\t\t(value) => value.startsWith(\"pao-map://\") || value.startsWith(\"pao-contract://\"),\t\t\t) ?? false;\t\tconst requiresGit =\t\t\tbinding.kind === \"managed\" || binding.commonGitDir.trim().length > 0 || hasStructuredGitReferences;\t\tif (requiresGit && !gitIdentity.ok) {\t\t\tthrow new PaoWorkerError(\"无效参数\", `执行根必须具有可核验的 Git 身份：${gitIdentity.reason}`, {\t\t\t\texecutionRoot: binding.executionRoot,\t\t\t\tworktreeKind: binding.kind,