 captured.handlers.get(event) ?? []) {\n\t\tawait handler({ type: event } as never, ctx);\n\t}\n}\n\nfunction flushMicrotasks(): Promise<void> {\n\treturn new Promise((resolve) => setTimeout(resolve, 0));\n}\n\ndescribe(\"organize 经维护调度器领取执行（F01）\", () => {\n\tit(\"enqueue organize → agent_settled → handler 跑完合并\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst captured = capturePi();\n\t\t\tconst deps: MaintenanceSchedulerDeps = {\n\t\t\t\tstore: fx.store,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tservice: fx.service,\n\t\t\t\tresolveScope: () => resolveMemoryScope(process.cwd()),\n\t\t\t\thandlers: {\n\t\t\t\t\torganize: async (_ctx, job, d) => {\n\t\t\t\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\t\t\t\tstore: d.store,\n\t\t\t\t\t\t\tservice: d.service!,\n\t\t\t\t\t\t\tpaoHome: d.paoHome,\n\t\t\t\t\t\t\tsourceScope: job.sourceScope,\n\t\t\t\t\t\t\tjobId: job.jobId,\n\t\t\t\t\t\t\t...(job.cursor === undefined ? {} : { cursor: job.cursor }),\n\t\t\t\t\t\t});\n\t\t\t\t\t\treturn { done: result.done, ...(result.cursor === undefined ? {} : { cursor: result.cursor }) };\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tnow: () => AT3,\n\t\t\t};\n\t\t\tconst scheduler = registerMaintenanceScheduler(captured.pi, deps);\n\t\t\tscheduler.enqueue(\"organize\", `organize:${PROJECT}`, JSON.stringify({ kind: \"organize\", projectId: PROJECT }));\n\t\t\tawait emit(captured, \"agent_settled\", testCtx());\n\t\t\tawait flushMicrotasks();\n\n\t\t\tconst row = fx.store.db\n\t\t\t\t.prepare(\"SELECT status, job_kind FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t.get(`organize:${PROJECT}`) as { status: string; job_kind: string } | undefined;\n\t\t\texpect(row?.job_kind).toBe(\"organize\");\n\t\t\texpect(row?.status).toBe(\"done\");\n\t\t\t// 一条 merged_into 指向另一条（方向由组内排序决定，不假定）。\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\t\t\tscheduler.unmount();\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *function fixture(): Fixture {\n\tconst home = tempHome();\n\treturn { \n\t\thome,store: openMemoryStore(home, \"readwrite\"),service: openMemoryService({ paoHome: home, mode: \"readwrite\" }),\n\t};\n}\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.preparefx.store.db.prepare(\"SELECT id, usage_state, merged_into FROM memories\")\n\t\t\t\t.all() as Array<{id: string;usage_state: string;merged_into: string | null;\n\t\t\t}>;\n\t\t\tconst stoppedRow = rows.find((r) => r.id === mergeId)!;\n\t\t\texpect(stoppedRow.usage_state).toBe(\"stopped\");\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\thandlers.set(\n\t\t\t\t\tevent,list.filter((h) => h !== handler),\n\t\t\t\t);\n\t\t\t};\n\t\t},\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,89]}}},{"equalLines":{"line_count":56}},{"diffOp":{"equal":{"range":[89,154]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[155,158]}}},{"diffOp":{"equal":{"range":[158,163]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[155,158]}}},{"diffOp":{"equal":{"range":[163,205]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[155,158]}}},{"diffOp":{"equal":{"range":[205,269]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[269,272]}}},{"diffOp":{"equal":{"range":[272,277]}}},{"equalLines":{"line_count":284}},{"diffOp":{"equal":{"range":[277,334]}}},{"diffOp":{"delete":{"range":[334,358]}}},{"diffOp":{"insert":{"range":[358,377]}}},{"diffOp":{"equal":{"range":[377,430]}}},{"diffOp":{"delete":{"range":[430,435]}}},{"diffOp":{"equal":{"range":[435,452]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[430,435]}}},{"diffOp":{"equal":{"range":[452,463]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[430,435]}}},{"diffOp":{"equal":{"range":[463,483]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[430,435]}}},{"diffOp":{"equal":{"range":[483,509]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[509,514]}}},{"diffOp":{"equal":{"range":[514,627]}}},{"equalLines":{"line_count":144}},{"diffOp":{"equal":{"range":[627,692]}}},{"diffOp":{"insert":{"range":[692,698]}}},{"diffOp":{"equal":{"range":[698,704]}}},{"diffOp":{"delete":{"range":[154,155]}}},{"diffOp":{"insert":{"range":[692,698]}}},{"diffOp":{"equal":{"range":[704,737]}}},{"diffOp":{"insert":{"range":[737,743]}}},{"diffOp":{"equal":{"range":[743,756]}}},{"equalLines":{"line_count":82}},{"diffOp":{"equal":{"range":[756,765]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-organize.test.ts"},"span":null,"sourceCode":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *\n * 覆盖：\n * - collectChangedMemories 复合游标（updated_at|id）：首批、无变化、新增、\n *   旧记录修订、同时间戳超 200 条不漏；\n * - organize handler 全链：变化→分组→词法候选→复核→service.mergeMemories\n *   实际合并（merged_into 指向、修订推进）；\n * - 提交保护：双 confirmed 结论不同拒并；等待期停用/来源被排除的旧候选不提交；\n * - handler 经 registerMaintenanceScheduler 领取 organize job 分派执行。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-organize.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { registerMaintenanceScheduler, type MaintenanceSchedulerDeps } from \"../../src/pao/memory/maintenance.ts\";\nimport {\n\tcollectChangedMemories,\n\trunOrganizeMaintenance,\n\tserializeOrganizeCursor,\n\tstaleOrganizeMembers,\n} from \"../../src/pao/memory/organize.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope, MemoryService } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst PROJECT = \"proj-organize\";\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst AT2 = \"2026-11-14T10:01:00.000Z\";\nconst AT3 = \"2026-11-14T10:02:00.000Z\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-org-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\ninterface Fixture {\n\thome: string;\n\tstore: MemoryStore;\n\tservice: MemoryService;\n}\n\nfunction fixture(): Fixture {\n\tconst home = tempHome();\n\treturn { home, store: openMemoryStore(home, \"readwrite\"), service: openMemoryService({ paoHome: home, mode: \"readwrite\" }) };\n}\n\nasync function closeFixture(fx: Fixture): Promise<void> {\n\tawait fx.service.close();\n\tfx.store.close();\n}\n\nlet sourceSeq = 0;\nfunction seedSource(store: MemoryStore, capturedAt: string = AT): string {\n\tsourceSeq += 1;\n\treturn registerSource(store.db, {\n\t\tsessionId: \"sess-org\",\n\t\tentryId: `e-org-${sourceSeq}`,\n\t\teventType: \"user\",\n\t\tcapturedAt,\n\t});\n}\n\nasync function seedMemory(\n\tservice: MemoryService,\n\tover: {\n\t\tconclusion: string;\n\t\tkind?: \"decision\" | \"experience\";\n\t\tconfirmation?: \"confirmed\" | \"tentative\";\n\t\tconditions?: string;\n\t\ttaskId?: string;\n\t\tprojectId?: string;\n\t\tsourceIds: string[];\n\t\tcreatedAt?: string;\n\t},\n): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: over.kind ?? \"experience\",\n\t\tscope: {\n\t\t\tprojectId: over.projectId ?? PROJECT,\n\t\t\t...(over.taskId === undefined ? {} : { taskId: over.taskId }),\n\t\t},\n\t\tconclusion: over.conclusion,\n\t\t...(over.conditions === undefined ? {} : { conditions: over.conditions }),\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: over.confirmation ?? \"tentative\",\n\t\tsourceIds: over.sourceIds,\n\t\tcreatedBy: \"user\",\n\t\t...(over.createdAt === undefined ? {} : { createdAt: over.createdAt }),\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\n/** 直改 updated_at 造同时间戳批次（createdAt 控制不了 updated_at 列的独立值）。 */\nfunction setUpdatedAt(store: MemoryStore, memoryId: string, updatedAt: string): void {\n\tstore.db.prepare(\"UPDATE memories SET updated_at = ? WHERE id = ?\").run(updatedAt, memoryId);\n}\n\n// ── J02：复合游标 ────────────────────────────────────────────────────────\n\ndescribe(\"collectChangedMemories 复合游标（F02）\", () => {\n\tit(\"首批返回、无变化原样返回 cursor、新增/修订只回增量\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst id1 = await seedMemory(fx.service, { conclusion: \"结论一\", sourceIds: [s1], createdAt: AT });\n\t\t\tconst id2 = await seedMemory(fx.service, { conclusion: \"结论二\", sourceIds: [s2], createdAt: AT });\n\t\t\tsetUpdatedAt(fx.store, id1, AT);\n\t\t\tsetUpdatedAt(fx.store, id2, AT2);\n\n\t\t\tconst first = collectChangedMemories(fx.store, { projectId: PROJECT }, undefined);\n\t\t\texpect(first.items.map((m) => m.memoryId)).toEqual([id1, id2]);\n\t\t\texpect(first.nextCursor).toBe(serializeOrganizeCursor(AT2, id2));\n\t\t\texpect(first.scanned).toBe(2);\n\n\t\t\t// 无变化：同游标再查为空且 cursor 原样。\n\t\t\tconst none = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(none.items).toHaveLength(0);\n\t\t\texpect(none.nextCursor).toBe(first.nextCursor);\n\n\t\t\t// 新增一条（更晚 updated_at）只返回新条目。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst id3 = await seedMemory(fx.service, { conclusion: \"结论三\", sourceIds: [s3], createdAt: AT3 });\n\t\t\tsetUpdatedAt(fx.store, id3, AT3);\n\t\t\tconst added = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(added.items.map((m) => m.memoryId)).toEqual([id3]);\n\n\t\t\t// 旧记录修订：id1 再修订使 updated_at 前进，重扫应只返回 id1。\n\t\t\tconst corrected = await fx.service.correctMemory({\n\t\t\t\tid: id1,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: { conclusion: \"结论一（修订）\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(corrected.ok).toBe(true);\n\t\t\tsetUpdatedAt(fx.store, id1, \"2026-11-14T10:05:00.000Z\");\n\t\t\tconst revised = collectChangedMemories(fx.store, { projectId: PROJECT }, added.nextCursor);\n\t\t\texpect(revised.items.map((m) => m.memoryId)).toEqual([id1]);\n\t\t\texpect(revised.items[0]!.currentRevision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"同时间戳超过 200 条不漏：复合游标按 (updated_at,id) 推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst total = 250;\n\t\t\tconst ids: string[] = [];\n\t\t\tfor (let i = 0; i < total; i++) {\n\t\t\t\tconst sourceId = seedSource(fx.store);\n\t\t\t\tconst id = await seedMemory(fx.service, {\n\t\t\t\t\tconclusion: `同时间批次结论 ${i}`,\n\t\t\t\t\tsourceIds: [sourceId],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\tsetUpdatedAt(fx.store, id, AT);\n\t\t\t\tids.push(id);\n\t\t\t}\n\t\t\tconst seen = new Set<string>();\n\t\t\tlet cursor: string | undefined;\n\t\t\tfor (let round = 0; round < 5; round++) {\n\t\t\t\tconst batch = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\t\tfor (const item of batch.items) seen.add(item.memoryId);\n\t\t\t\tcursor = batch.nextCursor;\n\t\t\t\tif (batch.scanned < 200) break;\n\t\t\t}\n\t\t\texpect(seen.size).toBe(total);\n\t\t\tfor (const id of ids) expect(seen.has(id)).toBe(true);\n\t\t\t// 全部扫完后再查应为空。\n\t\t\tconst tail = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\texpect(tail.items).toHaveLength(0);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\n// ── J01：organize handler 全链 ───────────────────────────────────────────\n\ndescribe(\"runOrganizeMaintenance（F01）\", () => {\n\tit(\"词法重复候选经 mergeMemories 合并：merged_into 指向 keep、keep 修订推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 两条同结论 active 记忆（同 kind+同 taskId 组内）→ 词法候选。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-1\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\texpect(result.done).toBe(true);\n\n\t\t\t// keep/merge 方向由 sortByExpiry+memoryId 排序决定（UUID 随机），\n\t\t\t// 只断言一条 merged_into 指向另一条且 keep 修订推进。\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into, current_revision FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null; current_revision: number }>;\n\t\t\tconst mergedOne = rows.find((r) => r.merged_into !== null);\n\t\t\tconst keptOne = rows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedOne).toBeDefined();\n\t\t\texpect(keptOne).toBeDefined();\n\t\t\texpect(mergedOne!.merged_into).toBe(keptOne!.id);\n\t\t\texpect(keptOne!.current_revision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"双 confirmed 同结论可并；不同结论的服务层拒并保护仍在\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 双 confirmed 同结论 → organize 的候选合并不被「双 confirmed」误拦。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-2\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(keptPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\n\t\t\t// 服务层保护仍在：不同结论的双 confirmed 直接调 mergeMemories 被拒——\n\t\t\t// organize 走同一入口，语义/词法候选若命中这类对同样会被拒。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst s4 = seedSource(fx.store);\n\t\t\tconst conflictA = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"缓存层选 Redis\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s3],\n\t\t\t\tcreatedAt: AT3,\n\t\t\t});\n\t\t\tconst conflictB = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"缓存层选 Memcached\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s4],\n\t\t\t\tcreatedAt: AT3,\n\t\t\t});\n\t\t\tconst rejected = await fx.service.mergeMemories({\n\t\t\t\tkeepId: conflictA,\n\t\t\t\tkeepExpectedRevision: 1,\n\t\t\t\tmergeId: conflictB,\n\t\t\t\tmergeExpectedRevision: 1,\n\t\t\t\trationale: \"验证拒并保护\",\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(rejected.ok).toBe(false);\n\t\t\tif (!rejected.ok) expect(rejected.error.code).toBe(\"merge_conflict\");\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"等待期停用的成员不进规整收集；快照复核 staleOrganizeMembers 直接判 stale\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"相同结论被停用前\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"相同结论被停用前\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\t// 先 collect 拿到 active 快照（模拟调度器 enqueue 时的状态）。\n\t\t\tconst collected = collectChangedMemories(fx.store, { projectId: PROJECT }, undefined);\n\t\t\tconst snapshot = collected.items.find((m) => m.memoryId === mergeId);\n\t\t\texpect(snapshot).toBeDefined();\n\t\t\t// 等待期把 mergeId 停用——快照 revision 前进，staleOrganizeMembers 判 stale。\n\t\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\t\tid: mergeId,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\ttarget: \"stopped\",\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(stopped.ok).toBe(true);\n\t\t\texpect(staleOrganizeMembers(fx.store.db, [snapshot!]).map((m) => m.memoryId)).toEqual([mergeId]);\n\t\t\t// 端到端：停用成员不再被 collect（usage_state 过滤），无组可成对。\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-3\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, usage_state, merged_into FROM memories\")\n\t\t\t\t.all() as Array<{ id: string; usage_state: string; merged_into: string | null }>;\n\t\t\tconst stoppedRow = rows.find((r) => r.id === mergeId)!;\n\t\t\texpect(stoppedRow.usage_state).toBe(\"stopped\");\n\t\t\texpect(stoppedRow.merged_into).toBeNull();\n\t\t\texpect(rows.find((r) => r.id === keepId)!.merged_into).toBeNull();\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"无变化零请求：done、merged=0、游标原样\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-empty\",\n\t\t\t});\n\t\t\texpect(result.done).toBe(true);\n\t\t\texpect(result.merged).toBe(0);\n\t\t\texpect(result.skipped).toBe(0);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\ndescribe(\"O06/R1：自动整理不改判正式决定\", () => {\n\tit(\"条件互斥（单机 vs 多机）的同结论 confirmed 决定不自动合并\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst a = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限单机部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst b = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限多机部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-cond\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\texpect(result.skipped).toBeGreaterThan(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(a, b) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.every((r) => r.merged_into === null)).toBe(true);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"confirmed 与 tentative 同结论不自动合并：正本保持 confirmed\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst tentative = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"tentative\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst confirmed = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-conf\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(tentative, confirmed) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.every((r) => r.merged_into === null)).toBe(true);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"条件归一等价的同状态决定可合并（条件空白合一/大小写差异不挡）\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst a = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限  单机   部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst b = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限 单机 部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-equiv\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(a, b) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.filter((r) => r.merged_into !== null)).toHaveLength(1);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\n// ── J01：经调度器分派 ───────────────────────────────────────────────────\n\ntype Handler = (event: never, ctx: unknown) => unknown;\nfunction capturePi(): { handlers: Map<string, Handler[]>; pi: ExtensionAPI } {\n\tconst handlers = new Map<string, Handler[]>();\n\tconst pi = {\n\t\ton(event: string, handler: Handler) {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\thandlers.set(event, list.filter((h) => h !== handler));\n\t\t\t};\n\t\t},\n\t} as unknown as ExtensionAPI;\n\treturn { handlers, pi };\n}\n\nfunction testCtx(sessionId = \"sess-org-sched\"): ExtensionContext {\n\treturn {\n\t\tcwd: process.cwd(),\n\t\tsessionManager: { getSessionId: () => sessionId },\n\t\tsignal: undefined,\n\t} as unknown as ExtensionContext;\n}\n\nasync function emit(captured: { handlers: Map<string, Handler[]> }, event: string, ctx: ExtensionContext) {\n\tfor (const handler of captured.handlers.get(event) ?? []) {\n\t\tawait handler({ type: event } as never, ctx);\n\t}\n}\n\nfunction flushMicrotasks(): Promise<void> {\n\treturn new Promise((resolve) => setTimeout(resolve, 0));\n}\n\ndescribe(\"organize 经维护调度器领取执行（F01）\", () => {\n\tit(\"enqueue organize → agent_settled → handler 跑完合并\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst captured = capturePi();\n\t\t\tconst deps: MaintenanceSchedulerDeps = {\n\t\t\t\tstore: fx.store,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tservice: fx.service,\n\t\t\t\tresolveScope: () => resolveMemoryScope(process.cwd()),\n\t\t\t\thandlers: {\n\t\t\t\t\torganize: async (_ctx, job, d) => {\n\t\t\t\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\t\t\t\tstore: d.store,\n\t\t\t\t\t\t\tservice: d.service!,\n\t\t\t\t\t\t\tpaoHome: d.paoHome,\n\t\t\t\t\t\t\tsourceScope: job.sourceScope,\n\t\t\t\t\t\t\tjobId: job.jobId,\n\t\t\t\t\t\t\t...(job.cursor === undefined ? {} : { cursor: job.cursor }),\n\t\t\t\t\t\t});\n\t\t\t\t\t\treturn { done: result.done, ...(result.cursor === undefined ? {} : { cursor: result.cursor }) };\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tnow: () => AT3,\n\t\t\t};\n\t\t\tconst scheduler = registerMaintenanceScheduler(captured.pi, deps);\n\t\t\tscheduler.enqueue(\"organize\", `organize:${PROJECT}`, JSON.stringify({ kind: \"organize\", projectId: PROJECT }));\n\t\t\tawait emit(captured, \"agent_settled\", testCtx());\n\t\t\tawait flushMicrotasks();\n\n\t\t\tconst row = fx.store.db\n\t\t\t\t.prepare(\"SELECT status, job_kind FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t.get(`organize:${PROJECT}`) as { status: string; job_kind: string } | undefined;\n\t\t\texpect(row?.job_kind).toBe(\"organize\");\n\t\t\texpect(row?.status).toBe(\"done\");\n\t\t\t// 一条 merged_into 指向另一条（方向由组内排序决定，不假定）。\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\t\t\tscheduler.unmount();\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S3 定向测试：内置记忆可信范围解析（scope.ts 过滤规则）。\n *import { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { \n\tappliesToBranch,currentScopeFilter,historyScopeFilter,isReferenceOnly,\n} from \"../../src/pao/memory/scope.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,88]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[88,188]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,191]}}},{"diffOp":{"equal":{"range":[191,207]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,191]}}},{"diffOp":{"equal":{"range":[207,226]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,191]}}},{"diffOp":{"equal":{"range":[226,245]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,191]}}},{"diffOp":{"equal":{"range":[245,260]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[262,436]}}},{"equalLines":{"line_count":268}},{"diffOp":{"equal":{"range":[436,445]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-scope.test.ts"},"span":null,"sourceCode":"/**\n * S3 定向测试：内置记忆可信范围解析（scope.ts 过滤规则）。\n *\n * 覆盖：\n * - 同名两项目（projectId 不同）互不串：A 项目的决定不进 B 项目召回。\n * - worktree 共享 projectId：不同 executionRoot/branch 不分裂项目决定，\n *   同一 projectId 下的记忆对本项目各 worktree 可见。\n * - 任务粒度：通用经验（无 taskId）对本项目各任务可见；任务记忆只本任务可见。\n * - 停用记忆不进 current 命中。\n * - 跨项目命中标 referenceOnly（isReferenceOnly 判定 + 本批不跨项目召回）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-scope.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { appliesToBranch, currentScopeFilter, historyScopeFilter, isReferenceOnly } from \"../../src/pao/memory/scope.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-scope-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；清理失败不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\n\ninterface Seed {\n\thome: string;\n\tsvc: ReturnType<typeof openMemoryService>;\n\tstore: ReturnType<typeof openMemoryStore>;\n}\n\nfunction seed(): Seed {\n\tconst home = tempHome();\n\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\tconst store = openMemoryStore(home, \"readwrite\");\n\treturn { home, svc, store };\n}\n\nasync function addMemory(\n\ts: Seed,\n\targs: {\n\t\tscope: MemoryScope;\n\t\tconclusion: string;\n\t\tsessionId?: string;\n\t\tentryId?: string;\n\t},\n): Promise<string> {\n\tconst sessionId = args.sessionId ?? \"sess-1\";\n\tconst entryId = args.entryId ?? `e-${Math.random().toString(36).slice(2)}`;\n\tconst src = registerSource(s.store.db, { sessionId, entryId, eventType: \"user\", capturedAt: AT });\n\tconst created = await s.svc.createMemory({\n\t\tkind: \"decision\",\n\t\tscope: args.scope,\n\t\tconclusion: args.conclusion,\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [src],\n\t\tcreatedAt: AT,\n\t});\n\tif (!created.ok) throw new Error(`造数失败:${created.error.message}`);\n\treturn created.id;\n}\n\ndescribe(\"scope 项目隔离\", () => {\n\tit(\"kind 过滤进入 current/history lane 的 SQL 条件，缺省不改变范围\", () => {\n\t\tconst current = currentScopeFilter({ projectId: \"p1\" }, \"active\", \"experience\");\n\t\texpect(current.where).toContain(\"m.kind = ?\");\n\t\texpect(current.params).toContain(\"experience\");\n\t\tconst history = historyScopeFilter({ projectId: \"p1\" }, \"experience\");\n\t\texpect(history.where).toContain(\"m.kind = ?\");\n\t\texpect(history.params).toContain(\"experience\");\n\t\texpect(currentScopeFilter({ projectId: \"p1\" }).where).not.toContain(\"m.kind = ?\");\n\t});\n\n\tit(\"同名两项目（不同 projectId）互不串：A 项目决定不进 B 项目召回\", async () => {\n\t\tconst s = seed();\n\t\t// 两个「同名」项目：不同物理根 → 不同 projectId（pathKey 口径）。\n\t\tconst projA: MemoryScope = { projectId: \"d:/work/app\" };\n\t\tconst projB: MemoryScope = { projectId: \"d:/other/app\" };\n\t\tawait addMemory(s, { scope: projA, conclusion: \"项目A数据库决定用PostgreSQL\" });\n\t\tawait addMemory(s, { scope: projB, conclusion: \"项目B数据库决定用MySQL\" });\n\n\t\t// A 项目召回：只见自己的决定。\n\t\tconst a = await s.svc.searchMemory({ scope: projA, query: \"数据库\", mode: \"current\" });\n\t\texpect(a.ok).toBe(true);\n\t\tif (a.ok) {\n\t\t\texpect(a.hits.map((h) => h.content.conclusion)).toEqual([\"项目A数据库决定用PostgreSQL\"]);\n\t\t}\n\t\tconst b = await s.svc.searchMemory({ scope: projB, query: \"数据库\", mode: \"current\" });\n\t\texpect(b.ok && b.hits.map((h) => h.content.conclusion)).toEqual([\"项目B数据库决定用MySQL\"]);\n\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"worktree 共享 projectId：不同 executionRoot 不分裂项目决定\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"d:/work/pao-dev\";\n\t\t// 主线写入的决定\n\t\tawait addMemory(s, {\n\t\t\tscope: { projectId, executionRoot: \"d:/work/pao-dev\", branch: \"main\" },\n\t\t\tconclusion: \"worktree决定共享项目内的决定\",\n\t\t});\n\t\t// worktree 召回（同 projectId，不同 executionRoot/branch）照样命中。\n\t\tconst hit = await s.svc.searchMemory({\n\t\t\tscope: { projectId, executionRoot: \"d:/work/pao-dev-wt-fix\", branch: \"fix-x\" },\n\t\t\tquery: \"worktree决定\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(hit.ok).toBe(true);\n\t\tif (hit.ok) {\n\t\t\texpect(hit.hits.map((h) => h.content.conclusion)).toEqual([\"worktree决定共享项目内的决定\"]);\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"任务粒度：通用经验全项目可见；任务记忆只本任务可见\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"p1\";\n\t\tawait addMemory(s, { scope: { projectId }, conclusion: \"通用经验不带任务\" });\n\t\tawait addMemory(s, { scope: { projectId, taskId: \"task-1\" }, conclusion: \"任务一的存储决定\" });\n\t\tawait addMemory(s, { scope: { projectId, taskId: \"task-2\" }, conclusion: \"任务二的存储决定\" });\n\n\t\t// 无 taskId 的调用方：只见通用经验。\n\t\tconst generic = await s.svc.searchMemory({ scope: { projectId }, query: \"存储决定 通用经验\", mode: \"current\" });\n\t\texpect(generic.ok).toBe(true);\n\t\tif (generic.ok) {\n\t\t\tconst conclusions = generic.hits.map((h) => h.content.conclusion).sort();\n\t\t\texpect(conclusions).toEqual([\"通用经验不带任务\"]);\n\t\t}\n\n\t\t// task-1 召回：通用 + 本任务。\n\t\tconst t1 = await s.svc.searchMemory({\n\t\t\tscope: { projectId, taskId: \"task-1\" },\n\t\t\tquery: \"存储决定 通用经验\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(t1.ok).toBe(true);\n\t\tif (t1.ok) {\n\t\t\tconst conclusions = t1.hits.map((h) => h.content.conclusion).sort();\n\t\t\texpect(conclusions).toEqual([\"任务一的存储决定\", \"通用经验不带任务\"].sort());\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"停用记忆不进 current 命中\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"p1\";\n\t\tconst id = await addMemory(s, { scope: { projectId }, conclusion: \"将被停用的存储决定\" });\n\t\tawait s.svc.setMemoryUsage({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\tconst hit = await s.svc.searchMemory({ scope: { projectId }, query: \"存储决定\", mode: \"current\" });\n\t\texpect(hit.ok && hit.hits).toHaveLength(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"isReferenceOnly：跨项目 scope 标 true，同项目 false\", () => {\n\t\texpect(isReferenceOnly({ projectId: \"a\" }, { projectId: \"b\" })).toBe(true);\n\t\texpect(isReferenceOnly({ projectId: \"a\" }, { projectId: \"a\" })).toBe(false);\n\t});\n});\n\ndescribe(\"分支语义：来源身份 vs 明示适用\", () => {\n\tit(\"appliesToBranch：从 conditions 解析出声明的适用分支名\", () => {\n\t\tconst base = { evidenceKind: \"user_statement\" as const, confirmation: \"confirmed\" as const };\n\t\t// 「分支名 + 关键词」与「关键词 + 分支名」两种语序都解析出分支名。\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"仅适用 feature-a 分支\" })).toBe(\"feature-a\");\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"仅适用 feature-a branch\" })).toBe(\"feature-a\");\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"仅适用分支 feature-b\" })).toBe(\"feature-b\");\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"branch: feature-b\" })).toBe(\"feature-b\");\n\t\t// 无分支名 → 无法判定限到哪个分支，不算受限。\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"注意分支差异\" })).toBeUndefined();\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\" })).toBeUndefined();\n\t\texpect(appliesToBranch({ ...base, conclusion: \"x\", conditions: \"上线前需回归测试\" })).toBeUndefined();\n\t});\n\n\tit(\"无受限标记的 branch 记忆跨分支共享（项目决定不回退）\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"p1\";\n\t\tawait addMemory(s, {\n\t\t\tscope: { projectId, branch: \"feature-a\", executionRoot: \"d:/work/wt-a\" },\n\t\t\tconclusion: \"分支共享项目级决定\",\n\t\t});\n\t\t// 调用方在 feature-b：无受限标记 → 仍命中（branch 只做来源身份）。\n\t\tconst hit = await s.svc.searchMemory({\n\t\t\tscope: { projectId, branch: \"feature-b\", executionRoot: \"d:/work/wt-b\" },\n\t\t\tquery: \"分支共享\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(hit.ok && hit.hits.map((h) => h.content.conclusion)).toEqual([\"分支共享项目级决定\"]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"conditions 声明适用分支：适用分支调用命中，其他分支调用剔除\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"p1\";\n\t\tconst src = registerSource(s.store.db, { sessionId: \"s-1\", entryId: \"e-br\", eventType: \"user\", capturedAt: AT });\n\t\tconst created = await s.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId, branch: \"feature-a\", executionRoot: \"d:/work/wt-a\" },\n\t\t\tconclusion: \"分支受限条目结论\",\n\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [src],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(\"造数失败\");\n\n\t\t// 声明适用 feature-a → feature-b 调用剔除。\n\t\tconst other = await s.svc.searchMemory({\n\t\t\tscope: { projectId, branch: \"feature-b\", executionRoot: \"d:/work/wt-b\" },\n\t\t\tquery: \"分支受限\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(other.ok && other.hits).toHaveLength(0);\n\t\t// feature-a 调用 → 命中（适用分支==调用方分支）。\n\t\tconst same = await s.svc.searchMemory({\n\t\t\tscope: { projectId, branch: \"feature-a\", executionRoot: \"d:/work/wt-a\" },\n\t\t\tquery: \"分支受限\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(same.ok && same.hits).toHaveLength(1);\n\t\t// 通用调用（无 branch）→ 不触发受限核对，命中。\n\t\tconst generic = await s.svc.searchMemory({ scope: { projectId }, query: \"分支受限\", mode: \"current\" });\n\t\texpect(generic.ok && generic.hits).toHaveLength(1);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"适用分支与来源分支解耦：A 写「仅适用 B」→ A 剔除、B 命中\", async () => {\n\t\tconst s = seed();\n\t\tconst projectId = \"p1\";\n\t\tconst src = registerSource(s.store.db, { sessionId: \"s-1\", entryId: \"e-ab\", eventType: \"user\", capturedAt: AT });\n\t\tconst created = await s.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\t// 记忆在 feature-a 写入，但 conditions 声明仅适用 feature-b。\n\t\t\tscope: { projectId, branch: \"feature-a\", executionRoot: \"d:/work/wt-a\" },\n\t\t\tconclusion: \"跨分支适用约定结论\",\n\t\t\tconditions: \"仅适用 feature-b 分支\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [src],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(\"造数失败\");\n\n\t\t// 来源分支 feature-a 调用 → 剔除（适用分支是 B 不是 A）。\n\t\tconst origin = await s.svc.searchMemory({\n\t\t\tscope: { projectId, branch: \"feature-a\", executionRoot: \"d:/work/wt-a\" },\n\t\t\tquery: \"跨分支适用\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(origin.ok && origin.hits).toHaveLength(0);\n\t\t// 适用分支 feature-b 调用 → 命中。\n\t\tconst target = await s.svc.searchMemory({\n\t\t\tscope: { projectId, branch: \"feature-b\", executionRoot: \"d:/work/wt-b\" },\n\t\t\tquery: \"跨分支适用\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(target.ok && target.hits).toHaveLength(1);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S3 定向测试：内置记忆双路召回（search.ts）。\n *\t\tconst otherId = await add(s, \"范围外项目向量条目\", { projectId: \"other-proj\" });\n\t\tconst stoppedId = await add(s, \"停用向量条目\");\n\t\tawait s.svc.setMemoryUsage({ \n\t\t\tid: stoppedId,expectedRevision: 1,target: \"stopped\",source: { sessionId: \"s-1\" },\n\t\t});\n\t\tputVector(s, inScopeId, 1, [1, 0]);\n\t\tputVector(s, otherId, 1, [1, 0]);\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"修订截断回归 新结论乙\",evidenceKind: \"user_statement\",confirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":260}},{"diffOp":{"equal":{"range":[70,248]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[253,267]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[267,287]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[287,305]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[305,333]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[333,337]}}},{"diffOp":{"equal":{"range":[337,414]}}},{"equalLines":{"line_count":69}},{"diffOp":{"equal":{"range":[414,462]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[462,467]}}},{"diffOp":{"equal":{"range":[467,513]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[462,467]}}},{"diffOp":{"equal":{"range":[513,544]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[462,467]}}},{"diffOp":{"equal":{"range":[544,569]}}},{"diffOp":{"delete":{"range":[248,249]}}},{"diffOp":{"insert":{"range":[569,574]}}},{"diffOp":{"equal":{"range":[574,615]}}},{"equalLines":{"line_count":563}},{"diffOp":{"equal":{"range":[615,624]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-search.test.ts"},"span":null,"sourceCode":"/**\n * S3 定向测试：内置记忆双路召回（search.ts）。\n *\n * 覆盖：\n * - 无关键词交集的同义查询能进语义候选（固定向量夹具，不走真实端点）。\n * - 单路第一名不因先取另一路集合而消失（词法路与语义路独立取候选）。\n * - 短中文两字词（<3 字符走 LIKE）/ 完整工具名 / 含引号输入正确。\n * - current 只返当前修订；history 缺省含两版；superseded 只返旧修订。\n * - 历史修订范围在词法/语义 lane 截断前生效。\n * - 来源被排除的记忆不进命中；排除在语义 lane 截断前生效。\n * - 分支受限候选在 lane 截取前与合并前剔除，不占 perLane/limit 位；\n *   history 查阅不按分支剔除。\n * - 准确 ID 定点读在 superseded 模式返回最新旧修订。\n * - search/inject 写 memory_usage 行（requestId/memoryId/revision 齐全）。\n * - 降级：未许可外发/无端点 → 词法照返 + degraded + degradeReason。\n * - AbortSignal → 抛 abortError（取消不是降级）。\n * - history 模式含被替代修订。\n *\n * 语义路效果用固定向量夹具机械检索通过（非真实端点验证）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-search.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { encodeVector, readMemoryVectors } from \"../../src/pao/memory/embeddings.ts\";\nimport { currentScopeFilter } from \"../../src/pao/memory/scope.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryKind, MemoryScope } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-search-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"p1\" };\nconst MODEL = \"fixture\";\n\ninterface Seed {\n\thome: string;\n\tsvc: ReturnType<typeof openMemoryService>;\n\tstore: ReturnType<typeof openMemoryStore>;\n}\nfunction seed(): Seed {\n\tconst home = tempHome();\n\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\tconst store = openMemoryStore(home, \"readwrite\");\n\treturn { home, svc, store };\n}\n\nasync function add(\n\ts: Seed,\n\tconclusion: string,\n\tscope: MemoryScope = SCOPE,\n\toptions: { kind?: MemoryKind; evidenceKind?: \"user_statement\" | \"execution\" | \"model_inference\" } = {},\n): Promise<string> {\n\tconst src = registerSource(s.store.db, {\n\t\tsessionId: \"s-1\",\n\t\tentryId: `e-${Math.random().toString(36).slice(2)}`,\n\t\teventType: \"user\",\n\t\tcapturedAt: AT,\n\t});\n\tconst r = await s.svc.createMemory({\n\t\tkind: options.kind ?? \"decision\",\n\t\tscope,\n\t\tconclusion,\n\t\tevidenceKind: options.evidenceKind ?? \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [src],\n\t\tcreatedAt: AT,\n\t});\n\tif (!r.ok) throw new Error(r.error.message);\n\treturn r.id;\n}\n\n/** 直写一条向量夹具（不走真实端点）。 */\nfunction putVector(s: Seed, memoryId: string, revision: number, vector: number[], model: string = MODEL): void {\n\ts.store.db\n\t\t.prepare(\"INSERT INTO memory_vectors (memory_id, revision, model, dimension, vector) VALUES (?, ?, ?, ?, ?)\")\n\t\t.run(memoryId, revision, model, vector.length, encodeVector(vector));\n}\n\n/** 固定向量检索：searchDeps.queryVector 直注，model 取 fixture。 */\nconst fixtureDeps = (vector: number[]) => ({ queryVector: vector });\n\ndescribe(\"词法路\", () => {\n\tit(\"kind 在词法 lane 截断前生效：经验不会被同词决定挤出 top_k\", async () => {\n\t\tconst s = seed();\n\t\tfor (let index = 0; index < 24; index++) {\n\t\t\tawait add(s, `类型过滤回归 决定 ${index}`);\n\t\t}\n\t\tconst experienceId = await add(s, \"类型过滤回归 经验目标\", SCOPE, {\n\t\t\tkind: \"experience\",\n\t\t\tevidenceKind: \"execution\",\n\t\t});\n\t\tconst result = await s.svc.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"类型过滤回归\",\n\t\t\tmode: \"current\",\n\t\t\tkind: \"experience\",\n\t\t\tlimit: 1,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (result.ok) {\n\t\t\texpect(result.hits.map((hit) => hit.memoryId)).toEqual([experienceId]);\n\t\t\texpect(result.hits[0]?.kind).toBe(\"experience\");\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"短中文两字词（<3 字符）走 LIKE 命中\", async () => {\n\t\tconst s = seed();\n\t\tawait add(s, \"数据库选型定为PostgreSQL\");\n\t\t// \"选型\" 2 字 → LIKE 路。\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"选型\", mode: \"current\" });\n\t\texpect(r.ok && r.hits.map((h) => h.content.conclusion)).toEqual([\"数据库选型定为PostgreSQL\"]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"完整工具标识/长词 FTS 命中\", async () => {\n\t\tconst s = seed();\n\t\tawait add(s, \"内置记忆召回用 pao_memory_recall 工具\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"pao_memory_recall\", mode: \"current\" });\n\t\texpect(r.ok && r.hits.length).toBeGreaterThan(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"含引号输入按字面词处理不报错\", async () => {\n\t\tconst s = seed();\n\t\tawait add(s, \"用户说「保留旧方案」的决定\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: '\"旧方案\"', mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\t// 不炸即合格；命中与否取决于引号是否被子串命中（LIKE 兜底）。\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"词法命中返回 sourceIds 与 matchKind=lexical\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"词法检索测试结论\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"词法检索\", mode: \"current\" });\n\t\texpect(r.ok && r.hits.length).toBe(1);\n\t\tif (r.ok) {\n\t\t\texpect(r.hits[0].matchKind).toBe(\"lexical\");\n\t\t\texpect(r.hits[0].memoryId).toBe(id);\n\t\t\texpect(r.hits[0].sourceIds?.length).toBe(1);\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"语义路（固定向量夹具：机械检索通过）\", () => {\n\tit(\"kind 在语义 lane 截断前生效：低分经验仍能进入自己的 top_k\", async () => {\n\t\tconst s = seed();\n\t\tconst decisionIds: string[] = [];\n\t\tfor (let index = 0; index < 4; index++) {\n\t\t\tdecisionIds.push(await add(s, `高相似决定 ${index}`));\n\t\t}\n\t\tconst experienceId = await add(s, \"低相似但目标类型经验\", SCOPE, {\n\t\t\tkind: \"experience\",\n\t\t\tevidenceKind: \"execution\",\n\t\t});\n\t\tfor (const id of decisionIds) putVector(s, id, 1, [1, 0]);\n\t\tputVector(s, experienceId, 1, [0.8, 0.6]);\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0]));\n\n\t\tconst mixed = await svc2.searchMemory({ scope: SCOPE, query: \"无语义同词\", mode: \"current\", limit: 1 });\n\t\texpect(mixed.ok && mixed.hits[0]?.kind).toBe(\"decision\");\n\t\tconst filtered = await svc2.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"无语义同词\",\n\t\t\tmode: \"current\",\n\t\t\tkind: \"experience\",\n\t\t\tlimit: 1,\n\t\t});\n\t\texpect(filtered.ok).toBe(true);\n\t\tif (filtered.ok) {\n\t\t\texpect(filtered.hits.map((hit) => hit.memoryId)).toEqual([experienceId]);\n\t\t\texpect(filtered.hits[0]?.matchKind).toBe(\"semantic\");\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"无关键词交集的同义查询进语义候选\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"缓存策略改成最近最少使用淘汰\");\n\t\tputVector(s, id, 1, [1, 0, 0, 0]);\n\t\t// 查询向量与记忆向量同方向、词面完全不同（同义改写）→ 语义路命中。\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0, 0, 0]));\n\t\tconst r2 = await svc2.searchMemory({ scope: SCOPE, query: \"内存置换算法怎么选\", mode: \"current\" });\n\t\texpect(r2.ok).toBe(true);\n\t\tif (r2.ok) {\n\t\t\texpect(r2.hits.length).toBe(1);\n\t\t\texpect(r2.hits[0].matchKind).toBe(\"semantic\");\n\t\t\texpect(r2.hits[0].memoryId).toBe(id);\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"单路第一名不因先取另一路集合而消失\", async () => {\n\t\tconst s = seed();\n\t\tconst idLex = await add(s, \"词法路专属：数据存储用SQLite\");\n\t\tconst idSem = await add(s, \"语义路专属结论：无词面交集\");\n\t\t// 语义向量：idSem 高分，idLex 低分。\n\t\tputVector(s, idSem, 1, [1, 0, 0, 0]);\n\t\tputVector(s, idLex, 1, [0, 1, 0, 0]);\n\t\t// 查询：词法命中 idLex；向量同向 idSem。\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0, 0, 0]));\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"数据存储\", mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\t// 词法第一名 idLex 不因语义路先取而消失。\n\t\t\texpect(r.hits.map((h) => h.memoryId)).toContain(idLex);\n\t\t\texpect(r.hits.map((h) => h.memoryId)).toContain(idSem);\n\t\t\t// idSem 仅语义命中 → matchKind=semantic；idLex 仅词法 → lexical。\n\t\t\texpect(r.hits.find((h) => h.memoryId === idSem)?.matchKind).toBe(\"semantic\");\n\t\t\texpect(r.hits.find((h) => h.memoryId === idLex)?.matchKind).toBe(\"lexical\");\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"维度不同的向量不混算\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"维度测试结论\");\n\t\t// 写一个 3 维向量；查询向量给 4 维 → 该记忆不在语义路（不同 dimension）。\n\t\tputVector(s, id, 1, [1, 0, 0]);\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0, 0, 0]));\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"查询\", mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) expect(r.hits.find((h) => h.memoryId === id)).toBeUndefined();\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"向量读取按范围下推：范围外行不进入 readMemoryVectors 结果\", async () => {\n\t\tconst s = seed();\n\t\tconst inScopeId = await add(s, \"范围内向量条目\");\n\t\tconst otherId = await add(s, \"范围外项目向量条目\", { projectId: \"other-proj\" });\n\t\tconst stoppedId = await add(s, \"停用向量条目\");\n\t\tawait s.svc.setMemoryUsage({ id: stoppedId, expectedRevision: 1, target: \"stopped\", source: { sessionId: \"s-1\" } });\n\t\tputVector(s, inScopeId, 1, [1, 0]);\n\t\tputVector(s, otherId, 1, [1, 0]);\n\t\tputVector(s, stoppedId, 1, [1, 0]);\n\n\t\t// 不过滤时三行都读到（旧行为保留）；传 scope filter 时只剩范围内行。\n\t\texpect(readMemoryVectors(s.store.db, MODEL, 2)).toHaveLength(3);\n\t\tconst scoped = readMemoryVectors(s.store.db, MODEL, 2, currentScopeFilter(SCOPE));\n\t\texpect(scoped.map((v) => v.memoryId)).toEqual([inScopeId]);\n\t\t// 查询同向：命中结果不变（范围内条目照常命中，范围外不进语义候选）。\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0]));\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"无语面交集查询\", mode: \"current\" });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([inScopeId]);\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"修订与删除的身份核对\", () => {\n\tit(\"修订发生后旧修订不返回\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"旧结论：用方案A\");\n\t\t// 纠正产生 rev-2。\n\t\tawait s.svc.correctMemory({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"新结论：用方案B\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\t// 旧结论词 \"方案A\" 只在 rev-1 的 FTS 行里 → 旧修订不返回。\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"方案A\", mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) expect(r.hits.map((h) => h.revision)).not.toContain(1);\n\t\t// 新结论词 \"方案B\" → rev-2 命中。\n\t\tconst r2 = await s.svc.searchMemory({ scope: SCOPE, query: \"方案B\", mode: \"current\" });\n\t\texpect(r2.ok && r2.hits.map((h) => h.revision)).toEqual([2]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"来源被排除的记忆不进命中\", async () => {\n\t\tconst s = seed();\n\t\tconst src = registerSource(s.store.db, { sessionId: \"s-1\", entryId: \"e-exc\", eventType: \"user\", capturedAt: AT });\n\t\tconst created = await s.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: SCOPE,\n\t\t\tconclusion: \"来源已排除的结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [src],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t// 记 source_exclusions。\n\t\ts.store.db\n\t\t\t.prepare(\"INSERT INTO source_exclusions (exclusion_id, source_id, created_at) VALUES (?, ?, ?)\")\n\t\t\t.run(\"exc-1\", src, AT);\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"已排除\", mode: \"current\" });\n\t\texpect(r.ok && r.hits.length).toBe(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"当前修订在 lane 截断前生效：limit=1 不被旧修订挤出\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"修订截断回归 旧结论甲\");\n\t\tawait s.svc.correctMemory({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"修订截断回归 新结论乙\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\t// 两修订含同词，limit=1：lane SQL 已卡 f.revision = m.current_revision → 只返 rev-2。\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"修订截断回归\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits.map((h) => h.revision)).toEqual([2]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"来源排除在 lane 截断前生效：被排除条目占满候选时范围内有效条目仍返回\", async () => {\n\t\tconst s = seed();\n\t\t// 25 条同词但来源已排除的记忆（超 perLane=20）+ 一条有效记忆；\n\t\t// limit=1 时若排除不下推，lane 被排除项占满 → 有效条目丢失。\n\t\tfor (let index = 0; index < 25; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-exc-lane-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: SCOPE,\n\t\t\t\tconclusion: `lane排除回归 占位${index}`,\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t\ts.store.db\n\t\t\t\t.prepare(\"INSERT INTO source_exclusions (exclusion_id, source_id, created_at) VALUES (?, ?, ?)\")\n\t\t\t\t.run(`exc-lane-${index}`, src, AT);\n\t\t}\n\t\tconst keptId = await add(s, \"lane排除回归 有效条目\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"lane排除回归\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"来源排除在语义 lane 截断前生效：已排除向量候选不占 lane\", async () => {\n\t\tconst s = seed();\n\t\t// 21 条向量同向但来源已排除的记忆（超 perLane=20）+ 一条有效向量记忆；\n\t\t// 查询词与正文无交集 → 只靠语义路；若排除在 slice 后才核对，已排除\n\t\t// 候选占满 lane → 有效条目进不了合并，limit=1 返回空。\n\t\tfor (let index = 0; index < 21; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-sem-exc-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: SCOPE,\n\t\t\t\tconclusion: `语义排除占位条目${index}`,\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t\tputVector(s, created.id, 1, [1, 0]);\n\t\t\ts.store.db\n\t\t\t\t.prepare(\"INSERT INTO source_exclusions (exclusion_id, source_id, created_at) VALUES (?, ?, ?)\")\n\t\t\t\t.run(`exc-sem-${index}`, src, AT);\n\t\t}\n\t\tconst keptId = await add(s, \"语义路有效条目\");\n\t\tputVector(s, keptId, 1, [0.8, 0.6]);\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0]));\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"无词面交集查询\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"准确记忆 ID 定点召回\", () => {\n\tit(\"纯 ID 查询召回该条（正文不含自身 ID）\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"定点召回目标结论\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: id, mode: \"current\" });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([id]);\n\t\texpect(r.ok && r.hits[0]?.relevance).toBe(1);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"混合查询中准确 ID 命中置顶\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"混合置顶目标\");\n\t\tawait add(s, \"混合置顶其他结论\");\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: `${id} 混合置顶`, mode: \"current\", limit: 5 });\n\t\texpect(r.ok && r.hits[0]?.memoryId).toBe(id);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"停用条目的准确 ID 不绕过状态过滤（current 返回空）\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"将被停用的定点目标\");\n\t\tawait s.svc.setMemoryUsage({ id, expectedRevision: 1, target: \"stopped\", source: { sessionId: \"s-1\" } });\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: id, mode: \"current\" });\n\t\texpect(r.ok && r.hits).toHaveLength(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"其他项目的准确 ID 不命中\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"别项目定点目标\", { projectId: \"other-project\" });\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: id, mode: \"current\" });\n\t\texpect(r.ok && r.hits).toHaveLength(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"分支受限候选（O04）\", () => {\n\tit(\"分支受限候选在合并前剔除：limit=1 不挤出项目共享条目\", async () => {\n\t\tconst s = seed();\n\t\t// 受限条目声明「仅适用 feature-a」，调用方在 feature-b → 该候选在\n\t\t// 合并前剔除，不占 limit；无标记的共享条目仍应返回。\n\t\tconst src = registerSource(s.store.db, {\n\t\t\tsessionId: \"s-1\",\n\t\t\tentryId: \"e-branch-lane\",\n\t\t\teventType: \"user\",\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst restricted = await s.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\tconclusion: \"分支占位回归 受限甲\",\n\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [src],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!restricted.ok) throw new Error(\"造数失败\");\n\t\tconst sharedId = await add(s, \"分支占位回归 共享乙\");\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\tconst narrow = await s.svc.searchMemory({ scope: caller, query: \"分支占位回归\", mode: \"current\", limit: 1 });\n\t\t// 若剔除仍在合并后：受限条目已占 limit=1 → 返回空；前移后共享条目中。\n\t\texpect(narrow.ok && narrow.hits.map((h) => h.memoryId)).toEqual([sharedId]);\n\t\tconst wide = await s.svc.searchMemory({ scope: caller, query: \"分支占位回归\", mode: \"current\", limit: 3 });\n\t\texpect(wide.ok && wide.hits.map((h) => h.memoryId)).toEqual([sharedId]);\n\t\t// 适用分支 feature-a 的调用方：受限条目正常命中（对照）。\n\t\tconst origin = await s.svc.searchMemory({\n\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\tquery: \"分支占位回归\",\n\t\t\tmode: \"current\",\n\t\t\tlimit: 3,\n\t\t});\n\t\texpect(origin.ok && origin.hits.map((h) => h.memoryId)).toContain(restricted.id);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\t// J01：分支适用核对下推到各路 perLane 截取前；history 不按分支剔除。\n\tit(\"分支受限候选占满词法 lane 时有效条目仍返回\", async () => {\n\t\tconst s = seed();\n\t\t// 21 条同词且声明「仅适用 feature-a」（超 perLane=20）+ 1 条共享；\n\t\t// 核对若在 slice 后才跑，受限候选占满 lane → limit=1 返回空。\n\t\tfor (let index = 0; index < 21; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-j01-lex-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\t\tconclusion: `lane分支回归 受限${index}`,\n\t\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t}\n\t\tconst keptId = await add(s, \"lane分支回归 共享有效\");\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\tconst narrow = await s.svc.searchMemory({ scope: caller, query: \"lane分支回归\", mode: \"current\", limit: 1 });\n\t\texpect(narrow.ok && narrow.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tconst wide = await s.svc.searchMemory({ scope: caller, query: \"lane分支回归\", mode: \"current\", limit: 30 });\n\t\texpect(wide.ok && wide.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"分支受限候选占满语义 lane 时有效条目仍返回\", async () => {\n\t\tconst s = seed();\n\t\tfor (let index = 0; index < 21; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-j01-sem-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\t\tconclusion: `语义分支占位条目${index}`,\n\t\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t\tputVector(s, created.id, 1, [1, 0]);\n\t\t}\n\t\tconst keptId = await add(s, \"语义路共享有效条目\");\n\t\tputVector(s, keptId, 1, [0.8, 0.6]);\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0]));\n\t\t// 查询词与正文无交集 → 只靠语义路。\n\t\tconst r = await svc2.searchMemory({ scope: caller, query: \"无词面交集查询\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\t// J02：受限候选超过固定余量（>40 条）时按批补取，limit=1 仍返有效条目。\n\tit(\"分支受限候选超过固定余量时 limit=1 仍返回有效条目\", async () => {\n\t\tconst s = seed();\n\t\t// 41 条同词且声明「仅适用 feature-a」（超原固定余量 laneFetch=40）+\n\t\t// 1 条共享；补取前第 42 位共享条目进不了 SQL 结果 → limit=1 空。\n\t\tfor (let index = 0; index < 41; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-j02-sat-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\t\tconclusion: `j02饱和回归 受限${index}`,\n\t\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t}\n\t\tconst keptId = await add(s, \"j02饱和回归 共享有效条目\");\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\tconst r = await s.svc.searchMemory({ scope: caller, query: \"j02饱和回归\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits.map((h) => h.memoryId)).toEqual([keptId]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"候选全部受限耗尽查询：正常返空不卡死\", async () => {\n\t\tconst s = seed();\n\t\t// 50 条全部「仅适用 feature-a」，feature-b 调用方无任何有效候选；\n\t\t// 补取循环须在查询耗尽（所有词取空）后正常退出，不空转。\n\t\tfor (let index = 0; index < 50; index++) {\n\t\t\tconst src = registerSource(s.store.db, {\n\t\t\t\tsessionId: \"s-1\",\n\t\t\t\tentryId: `e-j02-drain-${index}`,\n\t\t\t\teventType: \"user\",\n\t\t\t\tcapturedAt: AT,\n\t\t\t});\n\t\t\tconst created = await s.svc.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\t\tconclusion: `j02耗尽回归 受限${index}`,\n\t\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\t}\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\tconst r = await s.svc.searchMemory({ scope: caller, query: \"j02耗尽回归\", mode: \"current\", limit: 1 });\n\t\texpect(r.ok && r.hits).toHaveLength(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"history 查询不受分支适用限制：跨分支历史修订可见\", async () => {\n\t\tconst s = seed();\n\t\tconst src = registerSource(s.store.db, {\n\t\t\tsessionId: \"s-1\",\n\t\t\tentryId: \"e-j01-hist\",\n\t\t\teventType: \"user\",\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst created = await s.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"p1\", branch: \"feature-a\" },\n\t\t\tconclusion: \"历史分支约定结论\",\n\t\t\tconditions: \"仅适用 feature-a 分支\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [src],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(\"造数失败\");\n\t\tconst caller = { projectId: \"p1\", branch: \"feature-b\" };\n\t\t// current 模式仍剔除（对照）；history 是查阅性质不按当前分支剔除。\n\t\tconst current = await s.svc.searchMemory({ scope: caller, query: \"历史分支约定\", mode: \"current\" });\n\t\texpect(current.ok && current.hits).toHaveLength(0);\n\t\tconst history = await s.svc.searchMemory({ scope: caller, query: \"历史分支约定\", mode: \"history\" });\n\t\texpect(history.ok && history.hits.map((h) => h.memoryId)).toEqual([created.id]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"降级与取消\", () => {\n\tit(\"未许可外发：词法照返 + degraded + degradeReason\", async () => {\n\t\tconst s = seed();\n\t\tawait add(s, \"本地词法命中的结论\");\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, { outbound: { projects: {} } });\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"词法命中\", mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.degraded).toBe(true);\n\t\t\texpect(r.degradeReason).toContain(\"禁外发\");\n\t\t\t// 词法命中照返。\n\t\t\texpect(r.hits.length).toBe(1);\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"无端点（embed:null + 无 env 配置）：词法照返 + degraded\", async () => {\n\t\tconst s = seed();\n\t\tawait add(s, \"无端点仍本地查的结论\");\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, { embed: null });\n\t\tconst r = await svc2.searchMemory({ scope: SCOPE, query: \"本地查\", mode: \"current\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.degraded).toBe(true);\n\t\t\texpect(r.hits.length).toBe(1);\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"AbortSignal → 抛 abortError，不是降级\", async () => {\n\t\tconst s = seed();\n\t\tconst controller = new AbortController();\n\t\tcontroller.abort();\n\t\tawait expect(\n\t\t\ts.svc.searchMemory({ scope: SCOPE, query: \"测试\", mode: \"current\", signal: controller.signal }),\n\t\t).rejects.toThrow();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"usage 记录\", () => {\n\tit(\"search 命中写 memory_usage 行（requestId/memoryId/revision 齐全）\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"usage归因测试结论\");\n\t\tconst r = await s.svc.searchMemory({\n\t\t\tscope: { projectId: \"p1\", taskId: \"task-x\", sessionId: \"sess-x\" },\n\t\t\tquery: \"usage归因\",\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(r.ok && r.hits.length).toBe(1);\n\t\tconst rows = s.store.db\n\t\t\t.prepare(\n\t\t\t\t\"SELECT request_id, task_id, session_id, memory_id, revision, action FROM memory_usage WHERE memory_id = ?\",\n\t\t\t)\n\t\t\t.all(id) as unknown as Array<{\n\t\t\trequest_id: string;\n\t\t\ttask_id: string;\n\t\t\tsession_id: string;\n\t\t\tmemory_id: string;\n\t\t\trevision: number;\n\t\t\taction: string;\n\t\t}>;\n\t\texpect(rows.length).toBe(1);\n\t\texpect(rows[0].action).toBe(\"search\");\n\t\texpect(rows[0].memory_id).toBe(id);\n\t\texpect(rows[0].revision).toBe(1);\n\t\texpect(rows[0].task_id).toBe(\"task-x\");\n\t\texpect(rows[0].session_id).toBe(\"sess-x\");\n\t\texpect(rows[0].request_id.length).toBeGreaterThan(0);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"recordMemoryUsage 登记 used 事件\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"used登记测试\");\n\t\tconst r = await s.svc.recordMemoryUsage({\n\t\t\taction: \"used\",\n\t\t\tmemoryId: id,\n\t\t\trevision: 1,\n\t\t\trequestId: \"req-1\",\n\t\t\tsessionId: \"sess-1\",\n\t\t});\n\t\texpect(r.ok).toBe(true);\n\t\tconst row = s.store.db\n\t\t\t.prepare(\"SELECT action, request_id FROM memory_usage WHERE memory_id = ? AND action = 'used'\")\n\t\t\t.get(id) as { action: string; request_id: string } | undefined;\n\t\texpect(row?.request_id).toBe(\"req-1\");\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n\ndescribe(\"history 模式\", () => {\n\tit(\"缺省同时返回当前修订与被替代修订\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"历史共同话题旧结论\");\n\t\tawait s.svc.correctMemory({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"历史共同话题新结论\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\tconst r = await s.svc.searchMemory({ scope: SCOPE, query: \"历史共同话题\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(new Set(r.hits.map((hit) => hit.revision))).toEqual(new Set([1, 2]));\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"superseded 只返回 revision < current_revision\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"显式历史范围旧结论\");\n\t\tawait s.svc.correctMemory({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"显式历史范围新结论\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\tconst r = await s.svc.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"显式历史范围\",\n\t\t\tmode: \"history\",\n\t\t\thistoryRevisions: \"superseded\",\n\t\t});\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) expect(r.hits.map((hit) => hit.revision)).toEqual([1]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"current 与历史修订范围组合明确 invalid_input\", async () => {\n\t\tconst s = seed();\n\t\tconst result = await s.svc.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"非法组合\",\n\t\t\tmode: \"current\",\n\t\t\thistoryRevisions: \"superseded\",\n\t\t});\n\t\texpect(result).toMatchObject({\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"historyRevisions 仅适用于 history 模式\",\n\t\t\t},\n\t\t});\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"superseded 在词法 lane 截断前生效\", async () => {\n\t\tconst s = seed();\n\t\tfor (let index = 0; index < 24; index++) {\n\t\t\tawait add(s, `history-cutoff-lexical ${index}`);\n\t\t}\n\t\tconst targetId = await add(s, `history-cutoff-lexical ${\"filler \".repeat(200)}`);\n\t\tawait s.svc.correctMemory({\n\t\t\tid: targetId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"current revision only\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\tconst result = await s.svc.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"history-cutoff-lexical\",\n\t\t\tmode: \"history\",\n\t\t\thistoryRevisions: \"superseded\",\n\t\t\tlimit: 1,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (result.ok) {\n\t\t\texpect(result.hits.map((hit) => `${hit.memoryId}#${hit.revision}`)).toEqual([`${targetId}#1`]);\n\t\t}\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"准确 ID 定点读在 superseded 模式返回最新旧修订\", async () => {\n\t\tconst s = seed();\n\t\tconst id = await add(s, \"定点历史目标旧结论\");\n\t\tawait s.svc.correctMemory({\n\t\t\tid,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"定点历史目标新结论\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\t// 查询只给准确 ID（rev-1/rev-2 正文都不含该串）→ 走定点读；\n\t\t// superseded 应返回 rev-1 而非被回表剔除后的空集。\n\t\tconst r = await s.svc.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: id,\n\t\t\tmode: \"history\",\n\t\t\thistoryRevisions: \"superseded\",\n\t\t\tlimit: 1,\n\t\t});\n\t\texpect(r.ok && r.hits.map((h) => `${h.memoryId}#${h.revision}`)).toEqual([`${id}#1`]);\n\t\t// history all 定点仍取当前修订。\n\t\tconst all = await s.svc.searchMemory({ scope: SCOPE, query: id, mode: \"history\", historyRevisions: \"all\" });\n\t\texpect(all.ok && all.hits.map((h) => `${h.memoryId}#${h.revision}`)).toEqual([`${id}#2`]);\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n\n\tit(\"superseded 在语义 lane 截断前生效\", async () => {\n\t\tconst s = seed();\n\t\tfor (let index = 0; index < 24; index++) {\n\t\t\tconst id = await add(s, `语义截断当前项 ${index}`);\n\t\t\tputVector(s, id, 1, [1, 0]);\n\t\t}\n\t\tconst targetId = await add(s, \"语义截断历史目标\");\n\t\tawait s.svc.correctMemory({\n\t\t\tid: targetId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"语义截断当前修订\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"s-1\" },\n\t\t});\n\t\tputVector(s, targetId, 1, [0.6, 0.8]);\n\t\tputVector(s, targetId, 2, [0.99, 0.141]);\n\t\tconst svc2 = openMemoryService({ paoHome: s.home, mode: \"readwrite\" }, fixtureDeps([1, 0]));\n\t\tconst result = await svc2.searchMemory({\n\t\t\tscope: SCOPE,\n\t\t\tquery: \"semantic-history-cutoff\",\n\t\t\tmode: \"history\",\n\t\t\thistoryRevisions: \"superseded\",\n\t\t\tlimit: 1,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (result.ok) {\n\t\t\texpect(result.hits.map((hit) => `${hit.memoryId}#${hit.revision}`)).toEqual([`${targetId}#1`]);\n\t\t}\n\t\tawait svc2.close();\n\t\tawait s.svc.close();\n\t\ts.store.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *import { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { \n\tappendToOpenSegment,findOpenSegment,getSegment,readSourceEvents,readSourceEventsBatch,readSegmentLines,sealSegment,\n} from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\ttry {\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"batch-read\",[0, 1, 2].map(() => msgUser(\"batch-parse-event-\" + i)) as never,AT,\n\t\t);\n\t\tconst ids = captured.map(item => item.sourceId!);\n\t\tconst expected = await Promise.all(ids.map( => readSourceEvents(store.db, home, id, { offset: -1, limit: 2 })));\n\t\tconst parse = JSON.parse;\n\t\tlet parses = 0;\t\t\tconst actual = await readSourceEventsBatch(store.db, home, [...ids, \"missing-source\"], {\n\t\t\t\trange: { offset: -1, limit: 2 },\n\t\t\t\treadSegment: async segment => {\n\t\t\t\t\treads++;return readSegmentLines(segment);},\n\t\t\t});\n\t\t\texpect(ids.map( => actual.get(id))).toEqual(expected);\n\t\t\texpect(actual.get(\"missing-source\")).toMatchObject({ ok: false, error: { code: \"source_missing\" } });\n\t\t\texpect(reads).toBe(1);\n\t\t\texpect(parses).toBe(3);\n\t\t} finally {spy.mockRestore();}\n\t\tconst withBadLine = await readSourceEventsBatch(store.db, home, ids, {\n\t\t\trange: { limit: 1 },\n\t\t\treadSegment: async  => {\n\t\t\t\tconst data = await readSegmentLines(segment);\n\t\t\t\treturn data === undefined ? undefined : { ...data, lines: [\"{\", ...data.lines] };\t\t\tif (result?.ok) expect(result.events).toHaveLength(1);\n\t\t}\n\t} finally {store.close();}\n});\n","ops":[{"diffOp":{"equal":{"range":[0,118]}}},{"equalLines":{"line_count":8}},{"diffOp":{"equal":{"range":[118,222]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[225,245]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[245,261]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[261,272]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[272,289]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[289,311]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[311,328]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[328,339]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[339,341]}}},{"diffOp":{"equal":{"range":[341,508]}}},{"equalLines":{"line_count":465}},{"diffOp":{"equal":{"range":[508,640]}}},{"diffOp":{"insert":{"range":[640,644]}}},{"diffOp":{"equal":{"range":[644,657]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[640,644]}}},{"diffOp":{"equal":{"range":[657,671]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[118,119]}}},{"diffOp":{"insert":{"range":[672,673]}}},{"diffOp":{"equal":{"range":[673,721]}}},{"diffOp":{"delete":{"range":[673,674]}}},{"diffOp":{"insert":{"range":[640,644]}}},{"diffOp":{"equal":{"range":[721,723]}}},{"diffOp":{"insert":{"range":[723,727]}}},{"diffOp":{"equal":{"range":[727,757]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[757,761]}}},{"diffOp":{"insert":{"range":[727,728]}}},{"diffOp":{"equal":{"range":[761,819]}}},{"diffOp":{"insert":{"range":[640,644]}}},{"diffOp":{"equal":{"range":[819,827]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[819,821]}}},{"diffOp":{"insert":{"range":[727,728]}}},{"diffOp":{"equal":{"range":[827,894]}}},{"diffOp":{"insert":{"range":[723,727]}}},{"diffOp":{"equal":{"range":[894,942]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[942,1094]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[1094,1101]}}},{"diffOp":{"insert":{"range":[894,895]}}},{"diffOp":{"equal":{"range":[1101,1106]}}},{"diffOp":{"delete":{"range":[1101,1102]}}},{"diffOp":{"insert":{"range":[1106,1112]}}},{"diffOp":{"equal":{"range":[1112,1120]}}},{"diffOp":{"delete":{"range":[1101,1102]}}},{"diffOp":{"insert":{"range":[1106,1112]}}},{"diffOp":{"equal":{"range":[1120,1153]}}},{"diffOp":{"delete":{"range":[1101,1102]}}},{"diffOp":{"insert":{"range":[1106,1111]}}},{"diffOp":{"equal":{"range":[1153,1181]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[819,821]}}},{"diffOp":{"insert":{"range":[894,895]}}},{"diffOp":{"equal":{"range":[1181,1392]}}},{"diffOp":{"delete":{"range":[1101,1102]}}},{"diffOp":{"insert":{"range":[1106,1110]}}},{"diffOp":{"equal":{"range":[1392,1410]}}},{"diffOp":{"delete":{"range":[1101,1102]}}},{"diffOp":{"insert":{"range":[1106,1109]}}},{"diffOp":{"equal":{"range":[1410,1531]}}},{"diffOp":{"insert":{"range":[671,672]}}},{"diffOp":{"equal":{"range":[1094,1101]}}},{"diffOp":{"insert":{"range":[894,895]}}},{"diffOp":{"equal":{"range":[1531,1672]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1672,1746]}}},{"diffOp":{"delete":{"range":[1531,1532]}}},{"diffOp":{"insert":{"range":[1106,1109]}}},{"diffOp":{"equal":{"range":[1746,1760]}}},{"diffOp":{"delete":{"range":[1531,1532]}}},{"diffOp":{"insert":{"range":[1106,1108]}}},{"diffOp":{"equal":{"range":[1760,1766]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-source.test.ts"},"span":null,"sourceCode":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *\n * 覆盖：首次启用边界登记不回追历史、增量采集与幂等去重、凭证剔除（数据库/段文件/\n * 附件字节级）、附件受管副本、sealSegment 压缩与小段 uncompressed、未封存/已封存\n * 两条回读路、邻近窗口、缺来源与段文件丢失如实 source_missing、跨重启定位。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-source.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { appendToOpenSegment, findOpenSegment, getSegment, readSourceEvents, readSourceEventsBatch, readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-src-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 下 SQLite 句柄释放与文件可见性有延迟；清理失败不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T12:00:00.000Z\";\nconst SECRET = \"uh27r73wSECRET\"; // 测试凭证值：不应出现在任何落盘字节里\nconst PNG_B64 = \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\";\n\nlet seq = 0;\nfunction entry(partial: Record<string, unknown>) {\n\tseq += 1;\n\treturn { id: `e-${seq}`, parentId: seq > 1 ? `e-${seq - 1}` : null, timestamp: AT, ...partial };\n}\nconst msgUser = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({ type: \"message\", message: { role: \"user\", content, timestamp: 1, ...extra } });\nconst msgAssistant = (blocks: unknown[]) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: { role: \"assistant\", content: blocks, provider: \"p\", model: \"m\", usage: {}, stopReason: \"stop\" },\n\t});\nconst msgTool = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: {\n\t\t\trole: \"toolResult\",\n\t\t\ttoolCallId: \"tc1\",\n\t\t\ttoolName: \"bash\",\n\t\t\tcontent,\n\t\t\tisError: false,\n\t\t\ttimestamp: 1,\n\t\t\t...extra,\n\t\t},\n\t});\n\n/** 递归收集目录下全部文件（字节级凭证扫描用）。 */\nfunction allFiles(root: string): string[] {\n\tconst files: string[] = [];\n\tconst stack = [root];\n\twhile (stack.length > 0) {\n\t\tconst dir = stack.pop();\n\t\tif (dir === undefined || !existsSync(dir)) continue;\n\t\tfor (const name of readdirSync(dir)) {\n\t\t\tconst path = join(dir, name);\n\t\t\tif (statSync(path).isDirectory()) stack.push(path);\n\t\t\telse files.push(path);\n\t\t}\n\t}\n\treturn files;\n}\n\ndescribe(\"capture 边界与增量采集\", () => {\n\tit(\"首次启用记 boundary，不追采启用前历史；增量采集、幂等去重、不可采集类型跳过\", () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cap\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\t// 启用前历史登记为边界\n\t\tconst history = [msgUser(\"启用前的旧消息 1\"), msgAssistant([{ type: \"text\", text: \"启用前的旧回复\" }])];\n\t\tcapture.markBoundary(\n\t\t\tsessionId,\n\t\t\thistory.map((e) => e.id as string),\n\t\t\tAT,\n\t\t);\n\t\texpect(history.every((e) => capture.isCaptured(sessionId, e.id as string))).toBe(true);\n\n\t\t// 新提交条目（最后一条复用边界内 id，验证去重而非新增）\n\t\tconst committed = [\n\t\t\tmsgUser(\"决定：内置记忆用 SQLite\"),\n\t\t\tmsgAssistant([{ type: \"text\", text: \"已记录\" }]),\n\t\t\tmsgTool([{ type: \"text\", text: \"回执\" }]),\n\t\t\tentry({ type: \"custom_message\", customType: \"pao-note\", content: \"自定义\", display: false }),\n\t\t\tentry({ type: \"usage\", kind: \"main\", provider: \"p\", model: \"m\", usage: {} }),\n\t\t\tmsgUser(\"这条复用旧 id\"),\n\t\t];\n\t\t(committed[5] as { id: string }).id = history[0].id as string;\n\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\tconst byEntry = new Map(captured.map((r) => [r.entryId, r]));\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(4);\n\t\texpect(byEntry.get(history[0].id as string)?.outcome).toBe(\"skipped\");\n\t\texpect(byEntry.get((committed[4] as { id: string }).id)?.reason).toContain(\"usage\");\n\t\texpect(captured.filter((r) => r.outcome === \"captured\").every((r) => r.sourceId && r.segmentId)).toBe(true);\n\n\t\t// 重复采集同批：全部 skipped（同 sessionId+entryId+eventType 幂等）\n\t\tconst dup = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(dup.every((r) => r.outcome === \"skipped\")).toBe(true);\n\n\t\t// 段文件与 sources 行已落\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"凭证剔除与附件\", () => {\n\tit(\"已知凭证值不出现在 sources 行、段文件、附件副本（字节级断言）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-secret\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\tconst committed = [\n\t\t\tmsgAssistant([{ type: \"text\", text: `配置 password=${SECRET} 与 sk-live-${SECRET}` }]),\n\t\t\tmsgUser([\n\t\t\t\t{ type: \"text\", text: \"截图里的凭证\" },\n\t\t\t\t{ type: \"image\", data: PNG_B64, mimeType: \"image/png\" },\n\t\t\t]),\n\t\t\tmsgTool([{ type: \"text\", text: `env: api_key=${SECRET}` }], {\n\t\t\t\tdetails: { credentials: { secret: SECRET }, note: \"ok\" },\n\t\t\t}),\n\t\t];\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(3);\n\n\t\t// 附件副本落 attachments/，字节与原始一致（PNG 无凭证）\n\t\tconst attRoot = memoryPaths(home).attachments;\n\t\tconst attDirs = existsSync(attRoot) ? readdirSync(attRoot) : [];\n\t\texpect(attDirs).toHaveLength(1);\n\t\tconst attFile = join(attRoot, attDirs[0], \"data.png\");\n\t\texpect(readFileSync(attFile).equals(Buffer.from(PNG_B64, \"base64\"))).toBe(true);\n\n\t\t// 字节级扫描：数据库 + 归档段 + 附件均无凭证值\n\t\tconst paths = memoryPaths(home);\n\t\texpect(readFileSync(paths.database).includes(SECRET)).toBe(false);\n\t\tconst segBytes = Buffer.concat(allFiles(paths.archives).map((p) => readFileSync(p)));\n\t\texpect(segBytes.includes(SECRET)).toBe(false);\n\t\texpect(segBytes.includes(Buffer.from(PNG_B64, \"base64\"))).toBe(false); // base64 原文不落段\n\n\t\t// 段内事件：图片块不落 base64（附件字节在受管副本，段内只有脱敏后的引用形态），\n\t\t// 文本块里的凭证已被替换为脱敏标记。\n\t\tconst lines = readFileSync(findOpenSegment(store.db, sessionId)!.originalPath, \"utf8\")\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((l) => l.length > 0)\n\t\t\t.map((l) => JSON.parse(l) as { content: unknown });\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(PNG_B64))).toBe(true);\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(SECRET))).toBe(true);\n\t\texpect(lines.some((l) => JSON.stringify(l.content).includes(\"[已脱敏]\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"封存与回读\", () => {\n\tit(\"sealSegment：过阈值走 gzip 发布、原 JSONL 清理、行标 sealed；回读走解压路\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-seal\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 大条目把段推过 256KiB 压缩阈值\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[\n\t\t\t\tmsgUser(\"锚点：SQLite 决定\"),\n\t\t\t\tmsgAssistant([{ type: \"text\", text: `长回执 ${\"甲\".repeat(300 * 1024)}` }]),\n\t\t\t] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured.find((r) => r.outcome === \"captured\")?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"sealed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(existsSync(sealed?.compressedPath ?? `${segment!.originalPath}.gz`)).toBe(true);\n\t\texpect(existsSync(segment!.originalPath)).toBe(false); // 原 JSONL 已清\n\n\t\t// 已封存段回读：内容一致且 archived=true\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(true);\n\t\t\texpect(read.segmentId).toBe(segment!.segmentId);\n\t\t\texpect(read.content).toContain(\"SQLite\");\n\t\t\texpect(read.startLine).toBe(1);\n\t\t\texpect(read.endLine).toBe(2);\n\t\t\texpect(read.hasMore).toBe(false);\n\t\t\texpect(read.nextOffset).toBeUndefined();\n\t\t\texpect(read.metadata).toBeTypeOf(\"object\");\n\t\t}\n\t\t// 重复封存幂等\n\t\tconst again = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(again.ok).toBe(true);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"小段封存：未过阈值记 sealed 但无压缩文件，回读走 original_path\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-small\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"小段一条\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"uncompressed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(sealed?.compressedPath).toBeUndefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true); // 原文保留\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false); // 无压缩段 → 按未封存回读\n\t\t\texpect(read.content).toContain(\"小段一条\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"邻近窗口 offset/limit 取上下文；缺来源与段内无条目如实 source_missing\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-window\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[msgUser(\"第一条\"), msgUser(\"第二条\"), msgUser(\"第三条\"), msgUser(\"第四条\"), msgUser(\"第五条\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst mid = captured[1]?.sourceId as string;\n\t\tconst anchorEntryId = captured[2]?.entryId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst win = await svc.readMemorySource({\n\t\t\tsourceId: mid,\n\t\t\tentryId: anchorEntryId,\n\t\t\toffset: -1,\n\t\t\tlimit: 2,\n\t\t});\n\t\texpect(win.ok).toBe(true);\n\t\tif (win.ok) {\n\t\t\tconst lines = win.content.split(\"\\n\");\n\t\t\tconst events = lines.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\texpect(events).toHaveLength(2);\n\t\t\texpect(events[0]?.entryId).toBe(captured[1]?.entryId);\n\t\t\texpect(JSON.stringify(events[0]?.content)).toContain(\"第二条\");\n\t\t\texpect(events[1]?.entryId).toBe(anchorEntryId);\n\t\t\texpect(win.metadata.lineNo).toBe(3);\n\t\t\texpect(win.startLine).toBe(2);\n\t\t\texpect(win.endLine).toBe(3);\n\t\t\texpect(win.hasMore).toBe(true);\n\t\t\texpect(win.nextOffset).toBe(1);\n\n\t\t\tconst next = await svc.readMemorySource({\n\t\t\t\tsourceId: mid,\n\t\t\t\tentryId: anchorEntryId,\n\t\t\t\toffset: win.nextOffset,\n\t\t\t\tlimit: 2,\n\t\t\t});\n\t\t\texpect(next.ok).toBe(true);\n\t\t\tif (next.ok) {\n\t\t\t\tconst nextEvents = next.content\n\t\t\t\t\t.split(\"\\n\")\n\t\t\t\t\t.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\t\texpect(nextEvents.map((event) => event.entryId)).toEqual([captured[3]?.entryId, captured[4]?.entryId]);\n\t\t\t\texpect(next.startLine).toBe(4);\n\t\t\t\texpect(next.endLine).toBe(5);\n\t\t\t\texpect(next.hasMore).toBe(false);\n\t\t\t\texpect(next.nextOffset).toBeUndefined();\n\t\t\t}\n\t\t}\n\n\t\tconst miss = await svc.readMemorySource({ sourceId: \"src-no-such\" });\n\t\texpect(miss.ok).toBe(false);\n\t\tif (!miss.ok) expect(miss.error.code).toBe(\"source_missing\");\n\n\t\t// 段内不存在的 entryId → source_missing 而非伪造\n\t\tconst noEntry = await svc.readMemorySource({ sourceId: mid, entryId: \"e-nonexistent\" });\n\t\texpect(noEntry.ok).toBe(false);\n\t\tif (!noEntry.ok) expect(noEntry.error.code).toBe(\"source_missing\");\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"来源分页默认 50 条、单页上限 200，nextOffset 连续可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-bounded\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tlet segmentId = \"\";\n\t\tfor (let index = 0; index < 205; index += 1) {\n\t\t\tconst appended = appendToOpenSegment(\n\t\t\t\tstore.db,\n\t\t\t\thome,\n\t\t\t\tsessionId,\n\t\t\t\t{\n\t\t\t\t\tv: 1,\n\t\t\t\t\tsessionId,\n\t\t\t\t\tentryId: `e-page-${String(index).padStart(3, \"0\")}`,\n\t\t\t\t\tentryType: \"message\",\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\ttimestamp: AT,\n\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\tcontent: `分页事件 ${index}`,\n\t\t\t\t},\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tsegmentId = appended.segmentId;\n\t\t}\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId,\n\t\t\tentryId: \"e-page-000\",\n\t\t\teventType: \"user\",\n\t\t\tsegmentId,\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\n\t\tconst defaults = await svc.readMemorySource({ sourceId });\n\t\texpect(defaults.ok).toBe(true);\n\t\tif (defaults.ok) {\n\t\t\texpect(defaults.content.split(\"\\n\")).toHaveLength(50);\n\t\t\texpect(defaults.startLine).toBe(1);\n\t\t\texpect(defaults.endLine).toBe(50);\n\t\t\texpect(defaults.hasMore).toBe(true);\n\t\t\texpect(defaults.nextOffset).toBe(50);\n\t\t}\n\n\t\tconst capped = await svc.readMemorySource({ sourceId, limit: 999 });\n\t\texpect(capped.ok).toBe(true);\n\t\tif (capped.ok) {\n\t\t\texpect(capped.content.split(\"\\n\")).toHaveLength(200);\n\t\t\texpect(capped.endLine).toBe(200);\n\t\t\texpect(capped.hasMore).toBe(true);\n\t\t\texpect(capped.nextOffset).toBe(200);\n\t\t}\n\n\t\tconst tail = await svc.readMemorySource({ sourceId, offset: capped.ok ? capped.nextOffset : 200 });\n\t\texpect(tail.ok).toBe(true);\n\t\tif (tail.ok) {\n\t\t\tconst events = tail.content.split(\"\\n\").map((line) => JSON.parse(line) as { entryId: string });\n\t\t\texpect(events).toHaveLength(5);\n\t\t\texpect(events[0]?.entryId).toBe(\"e-page-200\");\n\t\t\texpect(events[4]?.entryId).toBe(\"e-page-204\");\n\t\t\texpect(tail.hasMore).toBe(false);\n\t\t\texpect(tail.nextOffset).toBeUndefined();\n\t\t}\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"段文件丢失如实 source_missing，不伪造内容\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-lost\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"要丢的段\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\t// 删除段文件制造丢失\n\t\tconst segment = findOpenSegment(store.db, sessionId)!;\n\t\trmSync(segment.originalPath);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(false);\n\t\tif (!read.ok) {\n\t\t\texpect(read.error.code).toBe(\"source_missing\");\n\t\t\texpect(read.error.message).toContain(\"段文件缺失\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"跨重启定位\", () => {\n\tit(\"关库重开后 readMemorySource 仍定位原文；readonly 实例也能回读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-reopen\";\n\t\tlet sourceId = \"\";\n\t\t{\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsourceId = capture.captureCommittedEntries(sessionId, [msgUser(\"跨重启找得到我\")] as never, AT)[0]\n\t\t\t\t?.sourceId as string;\n\t\t\tstore.close();\n\t\t}\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false);\n\t\t\texpect(read.content).toContain(\"跨重启找得到我\");\n\t\t\texpect(read.entryId).toBeTruthy();\n\t\t\texpect(read.eventType).toBe(\"user\");\n\t\t}\n\t\tconst ro = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\t\tconst readRo = await ro.readMemorySource({ sourceId });\n\t\texpect(readRo.ok).toBe(true);\n\t\tawait ro.close();\n\t\tawait svc.close();\n\t});\n});\n\ndescribe(\"验收演示：完整链路（工具写入→退出→重开→详情→原文回读）\", () => {\n\tit(\"createMemory 写入 → 关闭 → 重开 → getMemory 详情 → readMemorySource 回读来源原文\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-demo\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 采集会话原文，作为记忆来源\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"用户拍板：存储用 SQLite\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"pao-dev\", sessionId },\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(created.ok).toBe(true);\n\t\tconst memId = created.ok ? created.id : \"\";\n\t\tawait svc.close();\n\t\tstore.close();\n\n\t\t// 模拟进程退出重开\n\t\tconst svc2 = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst got = await svc2.getMemory({ id: memId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\");\n\t\tconst srcSummary = got.sourceSummaries[0];\n\t\texpect(srcSummary?.readable).toBe(true);\n\t\tconst back = await svc2.readMemorySource({ sourceId: srcSummary!.sourceId });\n\t\texpect(back.ok).toBe(true);\n\t\tif (back.ok) {\n\t\t\texpect(back.content).toContain(\"用户拍板：存储用 SQLite\");\n\t\t\texpect(back.sessionId).toBe(sessionId);\n\t\t}\n\t\tawait svc2.close();\n\t});\n});\n\nit(\"同段批读只解析一次，窗口、坏行与缺来源保持逐条回读语义\", async () => {\n\tconst home = tempHome();\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\"batch-read\", [0, 1, 2].map(i => msgUser(\"batch-parse-event-\" + i)) as never, AT);\n\t\tconst ids = captured.map(item => item.sourceId!);\n\t\tconst expected = await Promise.all(ids.map(id => readSourceEvents(store.db, home, id, { offset: -1, limit: 2 })));\n\t\tconst parse = JSON.parse;\n\t\tlet parses = 0;\n\t\tlet reads = 0;\n\t\tconst spy = vi.spyOn(JSON, \"parse\").mockImplementation((value, reviver) => {\n\t\t\tif (typeof value === \"string\" && value.includes(\"batch-parse-event-\")) parses++;\n\t\t\treturn parse(value, reviver);\n\t\t});\n\t\ttry {\n\t\t\tconst actual = await readSourceEventsBatch(store.db, home, [...ids, \"missing-source\"], {\n\t\t\t\trange: { offset: -1, limit: 2 },\n\t\t\t\treadSegment: async segment => { reads++; return readSegmentLines(segment); },\n\t\t\t});\n\t\t\texpect(ids.map(id => actual.get(id))).toEqual(expected);\n\t\t\texpect(actual.get(\"missing-source\")).toMatchObject({ ok: false, error: { code: \"source_missing\" } });\n\t\t\texpect(reads).toBe(1);\n\t\t\texpect(parses).toBe(3);\n\t\t} finally { spy.mockRestore(); }\n\t\tconst withBadLine = await readSourceEventsBatch(store.db, home, ids, {\n\t\t\trange: { limit: 1 },\n\t\t\treadSegment: async segment => {\n\t\t\t\tconst data = await readSegmentLines(segment);\n\t\t\t\treturn data === undefined ? undefined : { ...data, lines: [\"{\", ...data.lines] };\n\t\t\t},\n\t\t});\n\t\tfor (const id of ids) {\n\t\t\tconst result = withBadLine.get(id);\n\t\t\texpect(result?.ok).toBe(true);\n\t\t\tif (result?.ok) expect(result.events).toHaveLength(1);\n\t\t}\n\t} finally { store.close(); }\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { appendToOpenSegment, findOpenSegment, getSegment, readSegmentLines, readSourceEvents, readSourceEventsBatch, readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\t} finally { store.close(); }\n});\n","ops":[{"diffOp":{"equal":{"range":[0,118]}}},{"equalLines":{"line_count":7}},{"diffOp":{"equal":{"range":[118,247]}}},{"diffOp":{"equal":{"range":[247,307]}}},{"diffOp":{"insert":{"range":[307,325]}}},{"diffOp":{"equal":{"range":[325,364]}}},{"diffOp":{"delete":{"range":[364,382]}}},{"diffOp":{"equal":{"range":[382,437]}}},{"diffOp":{"equal":{"range":[437,563]}}},{"equalLines":{"line_count":499}},{"diffOp":{"equal":{"range":[563,597]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-source.test.ts"},"span":[592,687],"sourceCode":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *\n * 覆盖：首次启用边界登记不回追历史、增量采集与幂等去重、凭证剔除（数据库/段文件/\n * 附件字节级）、附件受管副本、sealSegment 压缩与小段 uncompressed、未封存/已封存\n * 两条回读路、邻近窗口、缺来源与段文件丢失如实 source_missing、跨重启定位。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-source.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { appendToOpenSegment, findOpenSegment, getSegment, readSourceEvents, readSourceEventsBatch, readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-src-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 下 SQLite 句柄释放与文件可见性有延迟；清理失败不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T12:00:00.000Z\";\nconst SECRET = \"uh27r73wSECRET\"; // 测试凭证值：不应出现在任何落盘字节里\nconst PNG_B64 = \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\";\n\nlet seq = 0;\nfunction entry(partial: Record<string, unknown>) {\n\tseq += 1;\n\treturn { id: `e-${seq}`, parentId: seq > 1 ? `e-${seq - 1}` : null, timestamp: AT, ...partial };\n}\nconst msgUser = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({ type: \"message\", message: { role: \"user\", content, timestamp: 1, ...extra } });\nconst msgAssistant = (blocks: unknown[]) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: { role: \"assistant\", content: blocks, provider: \"p\", model: \"m\", usage: {}, stopReason: \"stop\" },\n\t});\nconst msgTool = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: {\n\t\t\trole: \"toolResult\",\n\t\t\ttoolCallId: \"tc1\",\n\t\t\ttoolName: \"bash\",\n\t\t\tcontent,\n\t\t\tisError: false,\n\t\t\ttimestamp: 1,\n\t\t\t...extra,\n\t\t},\n\t});\n\n/** 递归收集目录下全部文件（字节级凭证扫描用）。 */\nfunction allFiles(root: string): string[] {\n\tconst files: string[] = [];\n\tconst stack = [root];\n\twhile (stack.length > 0) {\n\t\tconst dir = stack.pop();\n\t\tif (dir === undefined || !existsSync(dir)) continue;\n\t\tfor (const name of readdirSync(dir)) {\n\t\t\tconst path = join(dir, name);\n\t\t\tif (statSync(path).isDirectory()) stack.push(path);\n\t\t\telse files.push(path);\n\t\t}\n\t}\n\treturn files;\n}\n\ndescribe(\"capture 边界与增量采集\", () => {\n\tit(\"首次启用记 boundary，不追采启用前历史；增量采集、幂等去重、不可采集类型跳过\", () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cap\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\t// 启用前历史登记为边界\n\t\tconst history = [msgUser(\"启用前的旧消息 1\"), msgAssistant([{ type: \"text\", text: \"启用前的旧回复\" }])];\n\t\tcapture.markBoundary(\n\t\t\tsessionId,\n\t\t\thistory.map((e) => e.id as string),\n\t\t\tAT,\n\t\t);\n\t\texpect(history.every((e) => capture.isCaptured(sessionId, e.id as string))).toBe(true);\n\n\t\t// 新提交条目（最后一条复用边界内 id，验证去重而非新增）\n\t\tconst committed = [\n\t\t\tmsgUser(\"决定：内置记忆用 SQLite\"),\n\t\t\tmsgAssistant([{ type: \"text\", text: \"已记录\" }]),\n\t\t\tmsgTool([{ type: \"text\", text: \"回执\" }]),\n\t\t\tentry({ type: \"custom_message\", customType: \"pao-note\", content: \"自定义\", display: false }),\n\t\t\tentry({ type: \"usage\", kind: \"main\", provider: \"p\", model: \"m\", usage: {} }),\n\t\t\tmsgUser(\"这条复用旧 id\"),\n\t\t];\n\t\t(committed[5] as { id: string }).id = history[0].id as string;\n\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\tconst byEntry = new Map(captured.map((r) => [r.entryId, r]));\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(4);\n\t\texpect(byEntry.get(history[0].id as string)?.outcome).toBe(\"skipped\");\n\t\texpect(byEntry.get((committed[4] as { id: string }).id)?.reason).toContain(\"usage\");\n\t\texpect(captured.filter((r) => r.outcome === \"captured\").every((r) => r.sourceId && r.segmentId)).toBe(true);\n\n\t\t// 重复采集同批：全部 skipped（同 sessionId+entryId+eventType 幂等）\n\t\tconst dup = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(dup.every((r) => r.outcome === \"skipped\")).toBe(true);\n\n\t\t// 段文件与 sources 行已落\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"凭证剔除与附件\", () => {\n\tit(\"已知凭证值不出现在 sources 行、段文件、附件副本（字节级断言）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-secret\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\tconst committed = [\n\t\t\tmsgAssistant([{ type: \"text\", text: `配置 password=${SECRET} 与 sk-live-${SECRET}` }]),\n\t\t\tmsgUser([\n\t\t\t\t{ type: \"text\", text: \"截图里的凭证\" },\n\t\t\t\t{ type: \"image\", data: PNG_B64, mimeType: \"image/png\" },\n\t\t\t]),\n\t\t\tmsgTool([{ type: \"text\", text: `env: api_key=${SECRET}` }], {\n\t\t\t\tdetails: { credentials: { secret: SECRET }, note: \"ok\" },\n\t\t\t}),\n\t\t];\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(3);\n\n\t\t// 附件副本落 attachments/，字节与原始一致（PNG 无凭证）\n\t\tconst attRoot = memoryPaths(home).attachments;\n\t\tconst attDirs = existsSync(attRoot) ? readdirSync(attRoot) : [];\n\t\texpect(attDirs).toHaveLength(1);\n\t\tconst attFile = join(attRoot, attDirs[0], \"data.png\");\n\t\texpect(readFileSync(attFile).equals(Buffer.from(PNG_B64, \"base64\"))).toBe(true);\n\n\t\t// 字节级扫描：数据库 + 归档段 + 附件均无凭证值\n\t\tconst paths = memoryPaths(home);\n\t\texpect(readFileSync(paths.database).includes(SECRET)).toBe(false);\n\t\tconst segBytes = Buffer.concat(allFiles(paths.archives).map((p) => readFileSync(p)));\n\t\texpect(segBytes.includes(SECRET)).toBe(false);\n\t\texpect(segBytes.includes(Buffer.from(PNG_B64, \"base64\"))).toBe(false); // base64 原文不落段\n\n\t\t// 段内事件：图片块不落 base64（附件字节在受管副本，段内只有脱敏后的引用形态），\n\t\t// 文本块里的凭证已被替换为脱敏标记。\n\t\tconst lines = readFileSync(findOpenSegment(store.db, sessionId)!.originalPath, \"utf8\")\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((l) => l.length > 0)\n\t\t\t.map((l) => JSON.parse(l) as { content: unknown });\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(PNG_B64))).toBe(true);\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(SECRET))).toBe(true);\n\t\texpect(lines.some((l) => JSON.stringify(l.content).includes(\"[已脱敏]\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"封存与回读\", () => {\n\tit(\"sealSegment：过阈值走 gzip 发布、原 JSONL 清理、行标 sealed；回读走解压路\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-seal\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 大条目把段推过 256KiB 压缩阈值\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[\n\t\t\t\tmsgUser(\"锚点：SQLite 决定\"),\n\t\t\t\tmsgAssistant([{ type: \"text\", text: `长回执 ${\"甲\".repeat(300 * 1024)}` }]),\n\t\t\t] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured.find((r) => r.outcome === \"captured\")?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"sealed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(existsSync(sealed?.compressedPath ?? `${segment!.originalPath}.gz`)).toBe(true);\n\t\texpect(existsSync(segment!.originalPath)).toBe(false); // 原 JSONL 已清\n\n\t\t// 已封存段回读：内容一致且 archived=true\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(true);\n\t\t\texpect(read.segmentId).toBe(segment!.segmentId);\n\t\t\texpect(read.content).toContain(\"SQLite\");\n\t\t\texpect(read.startLine).toBe(1);\n\t\t\texpect(read.endLine).toBe(2);\n\t\t\texpect(read.hasMore).toBe(false);\n\t\t\texpect(read.nextOffset).toBeUndefined();\n\t\t\texpect(read.metadata).toBeTypeOf(\"object\");\n\t\t}\n\t\t// 重复封存幂等\n\t\tconst again = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(again.ok).toBe(true);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"小段封存：未过阈值记 sealed 但无压缩文件，回读走 original_path\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-small\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"小段一条\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"uncompressed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(sealed?.compressedPath).toBeUndefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true); // 原文保留\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false); // 无压缩段 → 按未封存回读\n\t\t\texpect(read.content).toContain(\"小段一条\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"邻近窗口 offset/limit 取上下文；缺来源与段内无条目如实 source_missing\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-window\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[msgUser(\"第一条\"), msgUser(\"第二条\"), msgUser(\"第三条\"), msgUser(\"第四条\"), msgUser(\"第五条\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst mid = captured[1]?.sourceId as string;\n\t\tconst anchorEntryId = captured[2]?.entryId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst win = await svc.readMemorySource({\n\t\t\tsourceId: mid,\n\t\t\tentryId: anchorEntryId,\n\t\t\toffset: -1,\n\t\t\tlimit: 2,\n\t\t});\n\t\texpect(win.ok).toBe(true);\n\t\tif (win.ok) {\n\t\t\tconst lines = win.content.split(\"\\n\");\n\t\t\tconst events = lines.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\texpect(events).toHaveLength(2);\n\t\t\texpect(events[0]?.entryId).toBe(captured[1]?.entryId);\n\t\t\texpect(JSON.stringify(events[0]?.content)).toContain(\"第二条\");\n\t\t\texpect(events[1]?.entryId).toBe(anchorEntryId);\n\t\t\texpect(win.metadata.lineNo).toBe(3);\n\t\t\texpect(win.startLine).toBe(2);\n\t\t\texpect(win.endLine).toBe(3);\n\t\t\texpect(win.hasMore).toBe(true);\n\t\t\texpect(win.nextOffset).toBe(1);\n\n\t\t\tconst next = await svc.readMemorySource({\n\t\t\t\tsourceId: mid,\n\t\t\t\tentryId: anchorEntryId,\n\t\t\t\toffset: win.nextOffset,\n\t\t\t\tlimit: 2,\n\t\t\t});\n\t\t\texpect(next.ok).toBe(true);\n\t\t\tif (next.ok) {\n\t\t\t\tconst nextEvents = next.content\n\t\t\t\t\t.split(\"\\n\")\n\t\t\t\t\t.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\t\texpect(nextEvents.map((event) => event.entryId)).toEqual([captured[3]?.entryId, captured[4]?.entryId]);\n\t\t\t\texpect(next.startLine).toBe(4);\n\t\t\t\texpect(next.endLine).toBe(5);\n\t\t\t\texpect(next.hasMore).toBe(false);\n\t\t\t\texpect(next.nextOffset).toBeUndefined();\n\t\t\t}\n\t\t}\n\n\t\tconst miss = await svc.readMemorySource({ sourceId: \"src-no-such\" });\n\t\texpect(miss.ok).toBe(false);\n\t\tif (!miss.ok) expect(miss.error.code).toBe(\"source_missing\");\n\n\t\t// 段内不存在的 entryId → source_missing 而非伪造\n\t\tconst noEntry = await svc.readMemorySource({ sourceId: mid, entryId: \"e-nonexistent\" });\n\t\texpect(noEntry.ok).toBe(false);\n\t\tif (!noEntry.ok) expect(noEntry.error.code).toBe(\"source_missing\");\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"来源分页默认 50 条、单页上限 200，nextOffset 连续可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-bounded\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tlet segmentId = \"\";\n\t\tfor (let index = 0; index < 205; index += 1) {\n\t\t\tconst appended = appendToOpenSegment(\n\t\t\t\tstore.db,\n\t\t\t\thome,\n\t\t\t\tsessionId,\n\t\t\t\t{\n\t\t\t\t\tv: 1,\n\t\t\t\t\tsessionId,\n\t\t\t\t\tentryId: `e-page-${String(index).padStart(3, \"0\")}`,\n\t\t\t\t\tentryType: \"message\",\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\ttimestamp: AT,\n\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\tcontent: `分页事件 ${index}`,\n\t\t\t\t},\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tsegmentId = appended.segmentId;\n\t\t}\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId,\n\t\t\tentryId: \"e-page-000\",\n\t\t\teventType: \"user\",\n\t\t\tsegmentId,\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\n\t\tconst defaults = await svc.readMemorySource({ sourceId });\n\t\texpect(defaults.ok).toBe(true);\n\t\tif (defaults.ok) {\n\t\t\texpect(defaults.content.split(\"\\n\")).toHaveLength(50);\n\t\t\texpect(defaults.startLine).toBe(1);\n\t\t\texpect(defaults.endLine).toBe(50);\n\t\t\texpect(defaults.hasMore).toBe(true);\n\t\t\texpect(defaults.nextOffset).toBe(50);\n\t\t}\n\n\t\tconst capped = await svc.readMemorySource({ sourceId, limit: 999 });\n\t\texpect(capped.ok).toBe(true);\n\t\tif (capped.ok) {\n\t\t\texpect(capped.content.split(\"\\n\")).toHaveLength(200);\n\t\t\texpect(capped.endLine).toBe(200);\n\t\t\texpect(capped.hasMore).toBe(true);\n\t\t\texpect(capped.nextOffset).toBe(200);\n\t\t}\n\n\t\tconst tail = await svc.readMemorySource({ sourceId, offset: capped.ok ? capped.nextOffset : 200 });\n\t\texpect(tail.ok).toBe(true);\n\t\tif (tail.ok) {\n\t\t\tconst events = tail.content.split(\"\\n\").map((line) => JSON.parse(line) as { entryId: string });\n\t\t\texpect(events).toHaveLength(5);\n\t\t\texpect(events[0]?.entryId).toBe(\"e-page-200\");\n\t\t\texpect(events[4]?.entryId).toBe(\"e-page-204\");\n\t\t\texpect(tail.hasMore).toBe(false);\n\t\t\texpect(tail.nextOffset).toBeUndefined();\n\t\t}\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"段文件丢失如实 source_missing，不伪造内容\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-lost\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"要丢的段\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\t// 删除段文件制造丢失\n\t\tconst segment = findOpenSegment(store.db, sessionId)!;\n\t\trmSync(segment.originalPath);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(false);\n\t\tif (!read.ok) {\n\t\t\texpect(read.error.code).toBe(\"source_missing\");\n\t\t\texpect(read.error.message).toContain(\"段文件缺失\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"跨重启定位\", () => {\n\tit(\"关库重开后 readMemorySource 仍定位原文；readonly 实例也能回读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-reopen\";\n\t\tlet sourceId = \"\";\n\t\t{\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsourceId = capture.captureCommittedEntries(sessionId, [msgUser(\"跨重启找得到我\")] as never, AT)[0]\n\t\t\t\t?.sourceId as string;\n\t\t\tstore.close();\n\t\t}\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false);\n\t\t\texpect(read.content).toContain(\"跨重启找得到我\");\n\t\t\texpect(read.entryId).toBeTruthy();\n\t\t\texpect(read.eventType).toBe(\"user\");\n\t\t}\n\t\tconst ro = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\t\tconst readRo = await ro.readMemorySource({ sourceId });\n\t\texpect(readRo.ok).toBe(true);\n\t\tawait ro.close();\n\t\tawait svc.close();\n\t});\n});\n\ndescribe(\"验收演示：完整链路（工具写入→退出→重开→详情→原文回读）\", () => {\n\tit(\"createMemory 写入 → 关闭 → 重开 → getMemory 详情 → readMemorySource 回读来源原文\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-demo\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 采集会话原文，作为记忆来源\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"用户拍板：存储用 SQLite\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"pao-dev\", sessionId },\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(created.ok).toBe(true);\n\t\tconst memId = created.ok ? created.id : \"\";\n\t\tawait svc.close();\n\t\tstore.close();\n\n\t\t// 模拟进程退出重开\n\t\tconst svc2 = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst got = await svc2.getMemory({ id: memId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\");\n\t\tconst srcSummary = got.sourceSummaries[0];\n\t\texpect(srcSummary?.readable).toBe(true);\n\t\tconst back = await svc2.readMemorySource({ sourceId: srcSummary!.sourceId });\n\t\texpect(back.ok).toBe(true);\n\t\tif (back.ok) {\n\t\t\texpect(back.content).toContain(\"用户拍板：存储用 SQLite\");\n\t\t\texpect(back.sessionId).toBe(sessionId);\n\t\t}\n\t\tawait svc2.close();\n\t});\n});\n\nit(\"同段批读只解析一次，窗口、坏行与缺来源保持逐条回读语义\", async () => {\n\tconst home = tempHome();\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\"batch-read\", [0, 1, 2].map(i => msgUser(\"batch-parse-event-\" + i)) as never, AT);\n\t\tconst ids = captured.map(item => item.sourceId!);\n\t\tconst expected = await Promise.all(ids.map(id => readSourceEvents(store.db, home, id, { offset: -1, limit: 2 })));\n\t\tconst parse = JSON.parse;\n\t\tlet parses = 0;\n\t\tlet reads = 0;\n\t\tconst spy = vi.spyOn(JSON, \"parse\").mockImplementation((value, reviver) => {\n\t\t\tif (typeof value === \"string\" && value.includes(\"batch-parse-event-\")) parses++;\n\t\t\treturn parse(value, reviver);\n\t\t});\n\t\ttry {\n\t\t\tconst actual = await readSourceEventsBatch(store.db, home, [...ids, \"missing-source\"], {\n\t\t\t\trange: { offset: -1, limit: 2 },\n\t\t\t\treadSegment: async segment => { reads++; return readSegmentLines(segment); },\n\t\t\t});\n\t\t\texpect(ids.map(id => actual.get(id))).toEqual(expected);\n\t\t\texpect(actual.get(\"missing-source\")).toMatchObject({ ok: false, error: { code: \"source_missing\" } });\n\t\t\texpect(reads).toBe(1);\n\t\t\texpect(parses).toBe(3);\n\t\t} finally { spy.mockRestore(); }\n\t\tconst withBadLine = await readSourceEventsBatch(store.db, home, ids, {\n\t\t\trange: { limit: 1 },\n\t\t\treadSegment: async segment => {\n\t\t\t\tconst data = await readSegmentLines(segment);\n\t\t\t\treturn data === undefined ? undefined : { ...data, lines: [\"{\", ...data.lines] };\n\t\t\t},\n\t\t});\n\t\tfor (const id of ids) {\n\t\t\tconst result = withBadLine.get(id);\n\t\t\texpect(result?.ok).toBe(true);\n\t\t\tif (result?.ok) expect(result.events).toHaveLength(1);\n\t\t}\n\t} finally { store.close(); }\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S5 承诺任务接线：真实 AgentSession + faux provider + 隔离 PAO_HOME/SQLite/JSONL。\n *\t\t\"utf8\",\n\t);\n\twriteFileSync(\n\t\tjoin(home, \"pao配置\", \"记忆后台预算.json\"), `${JSON.stringify({ unlimited: true })}\\n`,\"utf8\",\n\t);\n\twriteFileSync(\n\t\tjoin(home, \"总预算账.json\"),\n\t\t`${JSON.stringify({\n\t\t\tversion: 1,\n\t\t\tgrants: [\n\t\t\t\t{\n\t\t\t\t\tversion: 1,总预算: 999,授权时间: new Date().toISOString(),余额依据: { 已花: 0, 授权前总预算: 0 },授权人: \"test\",\n\t\t\t\t}],\n\t\t\treservations: [],\n\t\t})}\\n`,\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,103]}}},{"equalLines":{"line_count":114}},{"diffOp":{"equal":{"range":[103,132]}}},{"diffOp":{"delete":{"range":[132,135]}}},{"diffOp":{"equal":{"range":[135,186]}}},{"diffOp":{"delete":{"range":[132,135]}}},{"diffOp":{"insert":{"range":[186,187]}}},{"diffOp":{"equal":{"range":[187,230]}}},{"diffOp":{"delete":{"range":[132,135]}}},{"diffOp":{"insert":{"range":[186,187]}}},{"diffOp":{"equal":{"range":[230,236]}}},{"diffOp":{"delete":{"range":[236,239]}}},{"diffOp":{"equal":{"range":[239,342]}}},{"diffOp":{"insert":{"range":[342,347]}}},{"diffOp":{"equal":{"range":[347,348]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[348,354]}}},{"diffOp":{"equal":{"range":[354,365]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[348,354]}}},{"diffOp":{"equal":{"range":[365,380]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[348,354]}}},{"diffOp":{"equal":{"range":[380,419]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[348,354]}}},{"diffOp":{"equal":{"range":[419,470]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[348,354]}}},{"diffOp":{"equal":{"range":[470,487]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[487,493]}}},{"diffOp":{"equal":{"range":[493,494]}}},{"diffOp":{"insert":{"range":[487,492]}}},{"diffOp":{"equal":{"range":[494,527]}}},{"equalLines":{"line_count":706}},{"diffOp":{"equal":{"range":[527,536]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-task-commitment-chain.test.ts"},"span":null,"sourceCode":"/**\n * S5 承诺任务接线：真实 AgentSession + faux provider + 隔离 PAO_HOME/SQLite/JSONL。\n *\n * 验证自动提炼从采集时来源身份继承真实 taskId，当前任务提醒只读本任务承诺；\n * 同会话切任务、压缩、重启、失败后补提炼都保持原来源归属。\n */\nimport * as childProcess from \"node:child_process\";\nimport { existsSync, mkdirSync, mkdtempSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport {\n\ttype Context,\n\ttype FauxResponseFactory,\n\tfauxAssistantMessage,\n\tfauxProvider,\n\tfauxToolCall,\n\tgetCurrentSystemPrompt,\n\tInMemoryModelsStore,\n} from \"@pao/ai\";\nimport { Type } from \"typebox\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { ModelRuntime } from \"../../src/core/model-runtime.ts\";\nimport { createAgentSession } from \"../../src/core/sdk.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { SettingsManager } from \"../../src/core/settings-manager.ts\";\nimport { createCard } from \"../../src/pao/cards/index.ts\";\nimport { registerPaoCommand } from \"../../src/pao/command-router.ts\";\nimport { readOpenCommitments } from \"../../src/pao/memory/commitments.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerProjectGoalCommand } from \"../../src/pao/memory/project-goal-command.ts\";\nimport { resolveMemoryProjectIdentity } from \"../../src/pao/memory/project-identity.ts\";\nimport { type ProjectSessionBinding, registerProjectSession } from \"../../src/pao/memory/project-session.ts\";\nimport { sourcesForRevision } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\nimport { type BuiltinMemoryRegistration, registerBuiltinMemory, scopeFromContext } from \"../../src/pao/memory/tools.ts\";\nimport { createTestUiContext } from \"../suite/harness.ts\";\nimport { createTestExtensionsResult, createTestResourceLoader } from \"../utilities.ts\";\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawn: vi.fn(actual.spawn),\n\t\texec: vi.fn(actual.exec),\n\t\texecFile: vi.fn(actual.execFile),\n\t\texecFileSync: vi.fn(actual.execFileSync),\n\t};\n});\n\nconst A_COMMIT = \"A-COMMIT:完成 A 的自动验收\";\nconst A_DECISION = \"A-DECISION:A/B 任务共享的项目规则\";\nconst B_COMMIT = \"B-COMMIT:完成 B 的自动验收\";\nconst CARD_COMMIT = \"CARD-COMMIT:完成卡任务自动验收\";\n\nconst roots: string[] = [];\nconst fixtures: SdkFixture[] = [];\n\ninterface SdkFixture {\n\troot: string;\n\thome: string;\n\tproject: string;\n\tprojectId: string;\n\tcardsDir: string;\n\tsessionManager: SessionManager;\n\tsession: Awaited<ReturnType<typeof createAgentSession>>[\"session\"];\n\tregistration: BuiltinMemoryRegistration;\n\tfaux: ReturnType<typeof fauxProvider>;\n\tpromptSystems: string[];\n\tclose: () => Promise<void>;\n}\n\ninterface FixtureOptions {\n\troot?: string;\n\tsessionManager?: SessionManager;\n\tdispatchSpy?: (params: { cards_dir?: string; card_no: number }) => void;\n}\n\ninterface ActiveMemory {\n\tid: string;\n\tkind: string;\n\tscope: { projectId: string; taskId?: string };\n\trevision: number;\n\tcontent: { conclusion: string; commitmentStatus?: string };\n}\n\nfunction tempDir(prefix: string): string {\n\tconst path = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(path);\n\treturn path;\n}\n\nfunction fixturePaths(root = tempDir(\"pao-task-commitments-\")) {\n\tconst home = join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\twriteFileSync(\n\t\tjoin(home, \"pao配置\", \"档位.json\"),\n\t\t`${JSON.stringify({\n\t\t\tprovider: \"pao\",\n\t\t\t档位: [{ 名: \"fast\", provider: \"faux\", model: \"faux-1\", thinkingLevel: \"off\" }],\n\t\t})}\\n`,\n\t\t\"utf8\",\n\t);\n\t// O15 收口：O01 外发许可门+预算门生效后，测试 home 必须显式授权，否则\n\t// 提炼 job 永远卡在 pending（request 阶段 outbound/budget 拦）。临时\n\t// projectRoot 解析到的外发项目名是 basename \"project\"（无 .git 祖先）。\n\tmkdirSync(join(home, \"知识库配置\"), { recursive: true });\n\twriteFileSync(\n\t\tjoin(home, \"知识库配置\", \"外发许可.json\"),\n\t\t`${JSON.stringify({ projects: { project: { allowed: true, asOf: \"2099-12-31\" } } })}\\n`,\n\t\t\"utf8\",\n\t);\n\twriteFileSync(\n\t\tjoin(home, \"pao配置\", \"记忆后台预算.json\"),\n\t\t`${JSON.stringify({ unlimited: true })}\\n`,\n\t\t\"utf8\",\n\t);\n\twriteFileSync(\n\t\tjoin(home, \"总预算账.json\"),\n\t\t`${JSON.stringify({\n\t\t\tversion: 1,\n\t\t\tgrants: [{ version: 1, 总预算: 999, 授权时间: new Date().toISOString(), 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\t\treservations: [],\n\t\t})}\\n`,\n\t\t\"utf8\",\n\t);\n\treturn {\n\t\troot,\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tprojectId: resolveMemoryProjectIdentity(project).projectId,\n\t};\n}\n\nfunction registerFakeDispatch(pi: ExtensionAPI, spy: (params: { cards_dir?: string; card_no: number }) => void): void {\n\tpi.registerTool({\n\t\tname: \"pao_dispatch_card\",\n\t\tlabel: \"测试派卡\",\n\t\tdescription: \"返回真实成功结果形状，不启动 worker。\",\n\t\tparameters: Type.Object({\n\t\t\tcards_dir: Type.Optional(Type.String()),\n\t\t\tcard_no: Type.Number(),\n\t\t}),\n\t\tasync execute(_toolCallId, params) {\n\t\t\tspy(params);\n\t\t\treturn {\n\t\t\t\tcontent: [{ type: \"text\" as const, text: `已派发 ${params.card_no}` }],\n\t\t\t\tdetails: { dispatched: true, card_no: params.card_no },\n\t\t\t};\n\t\t},\n\t});\n}\n\nasync function createSdkFixture(options: FixtureOptions = {}): Promise<SdkFixture> {\n\tconst paths = fixturePaths(options.root ?? tempDir(\"pao-task-commitments-\"));\n\tconst sessionManager =\n\t\toptions.sessionManager ?? SessionManager.create(paths.project, paths.sessions, { id: \"task-chain-session\" });\n\n\tconst runtime = await ModelRuntime.create({\n\t\tcredentials: AuthStorage.inMemory(),\n\t\tmodelsStore: new InMemoryModelsStore(),\n\t\tmodelsPath: null,\n\t\tallowModelNetwork: false,\n\t});\n\tconst faux = fauxProvider({ tokensPerSecond: 1_000_000 });\n\truntime.registerNativeProvider(faux.provider);\n\tawait runtime.refresh({ allowNetwork: false });\n\n\tlet registration: BuiltinMemoryRegistration | undefined;\n\tconst extensionsResult = await createTestExtensionsResult(\n\t\t[\n\t\t\t(pi) => {\n\t\t\t\tregistration = registerBuiltinMemory(pi, {\n\t\t\t\t\tpaoHome: paths.home,\n\t\t\t\t\tembedding: { timeoutMs: 20 },\n\t\t\t\t});\n\t\t\t\tregisterProjectSession(pi, {\n\t\t\t\t\tresolvePaoHome: () => paths.home,\n\t\t\t\t\tresolveMemoryService: () => (registration?.service.opened ? registration.service : undefined),\n\t\t\t\t\tresolveCardsDir: () => paths.cardsDir,\n\t\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t\t});\n\t\t\t\tregisterProjectGoalCommand(pi, {\n\t\t\t\t\tresolvePaoHome: () => paths.home,\n\t\t\t\t\tresolveMemoryService: () => registration?.service,\n\t\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t\t});\n\t\t\t\tif (options.dispatchSpy) registerFakeDispatch(pi, options.dispatchSpy);\n\t\t\t\tregisterPaoCommand(pi, () => undefined);\n\t\t\t},\n\t\t],\n\t\tpaths.project,\n\t);\n\tconst { session } = await createAgentSession({\n\t\tcwd: paths.project,\n\t\tagentDir: join(paths.root, \"agent\"),\n\t\tmodelRuntime: runtime,\n\t\tmodel: faux.getModel(),\n\t\tsessionManager,\n\t\tsettingsManager: SettingsManager.inMemory({\n\t\t\tcompaction: { enabled: false, reserveTokens: 0, keepRecentTokens: 1 },\n\t\t\tretry: { enabled: false },\n\t\t}),\n\t\tresourceLoader: createTestResourceLoader({ extensionsResult }),\n\t});\n\tawait session.bindExtensions({\n\t\tuiContext: createTestUiContext(),\n\t});\n\tif (!registration) throw new Error(\"内置记忆装配未完成\");\n\tconst openedRegistration = registration;\n\n\tlet closed = false;\n\tconst fixture: SdkFixture = {\n\t\t...paths,\n\t\tsessionManager,\n\t\tsession,\n\t\tregistration: openedRegistration,\n\t\tfaux,\n\t\tpromptSystems: [],\n\t\tclose: async () => {\n\t\t\tif (closed) return;\n\t\t\tclosed = true;\n\t\t\tsession.dispose();\n\t\t\tawait openedRegistration.close();\n\t\t},\n\t};\n\tfixtures.push(fixture);\n\treturn fixture;\n}\n\nafterEach(async () => {\n\tfor (const fixture of fixtures.splice(0).reverse()) await fixture.close();\n\tfor (const root of roots.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(root, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 40));\n\t\t\t}\n\t\t}\n\t}\n});\n\nfunction currentTask(sessionManager: SessionManager): ProjectSessionBinding | undefined {\n\treturn sessionManager\n\t\t.getBranch()\n\t\t.flatMap((entry): ProjectSessionBinding[] =>\n\t\t\tentry.type === \"custom\" &&\n\t\t\tentry.customType === \"pao-project-session-binding\" &&\n\t\t\t(entry.data as { version?: unknown } | undefined)?.version === 2\n\t\t\t\t? [entry.data as ProjectSessionBinding]\n\t\t\t\t: [],\n\t\t)\n\t\t.at(-1);\n}\n\nfunction textContent(content: unknown): string {\n\tif (typeof content === \"string\") return content;\n\tif (!Array.isArray(content)) return \"\";\n\treturn content\n\t\t.filter(\n\t\t\t(block): block is { type: \"text\"; text: string } =>\n\t\t\t\tBoolean(block) &&\n\t\t\t\ttypeof block === \"object\" &&\n\t\t\t\t(block as { type?: unknown }).type === \"text\" &&\n\t\t\t\ttypeof (block as { text?: unknown }).text === \"string\",\n\t\t)\n\t\t.map((block) => block.text)\n\t\t.join(\"\\n\");\n}\n\nfunction contextText(context: Context): string {\n\treturn context.messages.map((message) => textContent(message.content)).join(\"\\n\\n\");\n}\n\nfunction latestUserText(context: Context): string | undefined {\n\tfor (let index = context.messages.length - 1; index >= 0; index--) {\n\t\tconst message = context.messages[index]!;\n\t\tif (message.role === \"user\") return textContent(message.content);\n\t}\n\treturn undefined;\n}\n\ninterface ExtractedEntry {\n\tsourceId: string;\n\tbody: string;\n}\n\nfunction extractionEntries(text: string): ExtractedEntry[] {\n\tconst headers = [...text.matchAll(/--- 条目 sourceId=([^ ]+) entryId=[^ ]+ eventType=[^ ]+ ---/g)];\n\treturn headers.map((header, index) => {\n\t\tconst start = (header.index ?? 0) + header[0].length + 1;\n\t\tconst next = headers[index + 1]?.index ?? text.length;\n\t\tconst related = text.indexOf(\"\\n# 同范围已有决定\", start);\n\t\tconst output = text.indexOf(\"\\n请输出候选 JSON 数组。\", start);\n\t\tconst end = Math.min(next, ...(related === -1 ? [] : [related]), ...(output === -1 ? [] : [output]));\n\t\treturn { sourceId: header[1]!, body: text.slice(start, end) };\n\t});\n}\n\nfunction candidatesFrom(context: Context): unknown[] {\n\tconst candidates: unknown[] = [];\n\tfor (const entry of extractionEntries(contextText(context))) {\n\t\tconst add = (kind: \"decision\" | \"commitment\", marker: string) => {\n\t\t\tif (!entry.body.includes(marker)) return;\n\t\t\tcandidates.push({\n\t\t\t\tkind,\n\t\t\t\tconclusion: marker,\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [entry.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: entry.sourceId, text: marker }],\n\t\t\t});\n\t\t};\n\t\tadd(\"commitment\", A_COMMIT);\n\t\tadd(\"commitment\", B_COMMIT);\n\t\tadd(\"commitment\", CARD_COMMIT);\n\t\tadd(\"decision\", A_DECISION);\n\t}\n\treturn candidates;\n}\n\nfunction mainResponse(fixture: SdkFixture, text: string, expectedUserText?: string): FauxResponseFactory {\n\treturn (context) => {\n\t\tconst systemPrompt = getCurrentSystemPrompt(context.messages);\n\t\tif (systemPrompt.includes(\"你是记忆提炼器\")) {\n\t\t\treturn fauxAssistantMessage(JSON.stringify(candidatesFrom(context)));\n\t\t}\n\t\tif (expectedUserText === undefined || latestUserText(context) === expectedUserText) {\n\t\t\tfixture.promptSystems.push(systemPrompt);\n\t\t}\n\t\treturn fauxAssistantMessage(text);\n\t};\n}\n\nfunction extractionResponse(fixture: SdkFixture): FauxResponseFactory {\n\tconst respond: FauxResponseFactory = (context) => {\n\t\tfixture.faux.appendResponses([respond]);\n\t\treturn fauxAssistantMessage(JSON.stringify(candidatesFrom(context)));\n\t};\n\treturn respond;\n}\n\nasync function command(fixture: SdkFixture, commandText: string): Promise<void> {\n\tfixture.faux.setResponses([]);\n\tawait fixture.session.prompt(commandText);\n}\n\nasync function promptWithExtraction(fixture: SdkFixture, userText: string, assistantText: string): Promise<void> {\n\tfixture.promptSystems.length = 0;\n\tfixture.faux.setResponses([mainResponse(fixture, assistantText, userText), extractionResponse(fixture)]);\n\tawait fixture.session.prompt(userText);\n\tawait waitForExtractionCaughtUp(fixture);\n}\n\nasync function waitFor(check: () => boolean, message = \"等待自动提炼收尾超时\"): Promise<void> {\n\tfor (let attempt = 0; attempt < 500; attempt++) {\n\t\tif (check()) return;\n\t\tawait new Promise((resolve) => setTimeout(resolve, 10));\n\t}\n\tthrow new Error(message);\n}\n\nfunction withStore<T>(\n\thome: string,\n\tmode: \"readonly\" | \"readwrite\",\n\toperation: (store: ReturnType<typeof openMemoryStore>) => T,\n): T {\n\tconst store = openMemoryStore(home, mode);\n\ttry {\n\t\treturn operation(store);\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\nfunction activeMemories(home: string): ActiveMemory[] {\n\treturn withStore(home, \"readonly\", (store) => {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, m.kind, m.scope_json, m.current_revision, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active' AND m.merged_into IS NULL`,\n\t\t\t)\n\t\t\t.all() as unknown as Array<{\n\t\t\tid: string;\n\t\t\tkind: string;\n\t\t\tscope_json: string;\n\t\t\tcurrent_revision: number;\n\t\t\tcontent_json: string;\n\t\t}>;\n\t\treturn rows.map((row) => ({\n\t\t\tid: row.id,\n\t\t\tkind: row.kind,\n\t\t\tscope: JSON.parse(row.scope_json) as ActiveMemory[\"scope\"],\n\t\t\trevision: row.current_revision,\n\t\t\tcontent: JSON.parse(row.content_json) as ActiveMemory[\"content\"],\n\t\t}));\n\t});\n}\n\nfunction memoryByConclusion(home: string, conclusion: string): ActiveMemory {\n\tconst memory = activeMemories(home).find((candidate) => candidate.content.conclusion === conclusion);\n\tif (!memory) throw new Error(`未找到记忆：${conclusion}`);\n\treturn memory;\n}\n\nasync function waitForMemories(fixture: SdkFixture, conclusions: string[]): Promise<ActiveMemory[]> {\n\tawait waitFor(() => {\n\t\tconst have = new Set(activeMemories(fixture.home).map((memory) => memory.content.conclusion));\n\t\treturn conclusions.every((conclusion) => have.has(conclusion));\n\t});\n\treturn activeMemories(fixture.home);\n}\n\nasync function waitForJobStatus(fixture: SdkFixture, status: \"done\" | \"failed\"): Promise<void> {\n\ttry {\n\t\tawait waitFor(\n\t\t\t() =>\n\t\t\t\twithStore(fixture.home, \"readonly\", (store) => {\n\t\t\t\t\tconst row = store.db\n\t\t\t\t\t\t.prepare(\"SELECT status, consecutive_failures FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t\t\t.get(`session:${fixture.sessionManager.getSessionId()}`) as\n\t\t\t\t\t\t| { status: string; consecutive_failures: number }\n\t\t\t\t\t\t| undefined;\n\t\t\t\t\t// O15 收口：O03/F07 后 failed 是瞬态（被 recoverJobs 重取为 pending\n\t\t\t\t\t// 直到 consecutive_failures>=MAX_ATTEMPTS）。failed 断言看是否「已经\n\t\t\t\t\t// 发生过失败」，否则瞬态窗口错过就一直 pending。\n\t\t\t\t\tif (status === \"failed\") return row !== undefined && row.consecutive_failures >= 1;\n\t\t\t\t\treturn row?.status === status;\n\t\t\t\t}),\n\t\t\t`等待提炼 job 进入 ${status} 超时`,\n\t\t);\n\t} catch (error) {\n\t\t// 诊断：超时把 job 全字段抛出帮助定位（last_error 是排查的关键证据）。\n\t\tconst jobs = withStore(fixture.home, \"readonly\", (store) =>\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT status, cursor, last_error, attempt_count, consecutive_failures FROM extraction_jobs WHERE scope_key = ?\",\n\t\t\t\t)\n\t\t\t\t.all(`session:${fixture.sessionManager.getSessionId()}`),\n\t\t);\n\t\tconsole.log(`[pao-diag] expected status=${status}, jobs:`, JSON.stringify(jobs));\n\t\tthrow error;\n\t}\n}\n\nasync function waitForExtractionCaughtUp(fixture: SdkFixture): Promise<void> {\n\ttry {\n\t\tawait waitFor(\n\t\t\t() =>\n\t\t\t\twithStore(fixture.home, \"readonly\", (store) => {\n\t\t\t\t\tconst latest = store.db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT source_id FROM sources\n\t\t\t\t\t\t\t WHERE session_id = ? AND event_type != 'boundary'\n\t\t\t\t\t\t\t ORDER BY captured_at DESC, source_id DESC LIMIT 1`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.get(fixture.sessionManager.getSessionId()) as { source_id: string } | undefined;\n\t\t\t\t\tif (!latest) return false;\n\t\t\t\t\tconst job = store.db\n\t\t\t\t\t\t.prepare(\"SELECT status, cursor FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t\t\t.get(`session:${fixture.sessionManager.getSessionId()}`) as\n\t\t\t\t\t\t| { status: string; cursor: string | null }\n\t\t\t\t\t\t| undefined;\n\t\t\t\t\treturn job?.status === \"done\" && job.cursor === latest.source_id;\n\t\t\t\t}),\n\t\t\t\"等待自动提炼追平最新来源超时\",\n\t\t);\n\t} catch (error) {\n\t\t// 诊断：超时把 job 的 last_error/attempt_count 抛出来帮助定位。\n\t\tconst jobs = withStore(fixture.home, \"readonly\", (store) =>\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT status, cursor, last_error, attempt_count, consecutive_failures FROM extraction_jobs WHERE scope_key = ?\",\n\t\t\t\t)\n\t\t\t\t.all(`session:${fixture.sessionManager.getSessionId()}`),\n\t\t);\n\t\tconsole.log(\"[pao-diag] extraction_jobs:\", JSON.stringify(jobs));\n\t\tthrow error;\n\t}\n}\n\nfunction linkedSources(home: string, memory: ActiveMemory) {\n\treturn withStore(home, \"readonly\", (store) => sourcesForRevision(store.db, memory.id, memory.revision));\n}\n\ndescribe(\"自动提炼到当前任务承诺提醒\", () => {\n\tit(\"两个空 SDK 会话仅 A 先写目标，B 首轮用户承诺直接提炼并绑定 B\", async () => {\n\t\tconst fixtureA = await createSdkFixture();\n\t\texpect(existsSync(memoryPaths(fixtureA.home).database)).toBe(false);\n\t\tconst fixtureB = await createSdkFixture({\n\t\t\troot: fixtureA.root,\n\t\t\tsessionManager: SessionManager.create(fixtureA.project, join(fixtureA.root, \"sessions\"), {\n\t\t\t\tid: \"first-prompt-B\",\n\t\t\t}),\n\t\t});\n\t\tawait command(fixtureA, \"/pao task new\");\n\t\tawait command(fixtureB, \"/pao task new\");\n\t\tconst taskA = currentTask(fixtureA.sessionManager)!;\n\t\tconst taskB = currentTask(fixtureB.sessionManager)!;\n\t\texpect(existsSync(memoryPaths(fixtureB.home).database)).toBe(false);\n\t\tawait command(fixtureA, \"/pao goal set 核对两个任务的实际交付\");\n\t\texpect(\n\t\t\twithStore(fixtureB.home, \"readonly\", (store) =>\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"SELECT COUNT(*) AS count FROM sources WHERE session_id = ?\")\n\t\t\t\t\t.get(fixtureB.sessionManager.getSessionId()),\n\t\t\t),\n\t\t).toEqual({ count: 0 });\n\t\texpect(\n\t\t\twithStore(fixtureA.home, \"readonly\", (store) =>\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"SELECT COUNT(*) AS count FROM sources WHERE session_id = ?\")\n\t\t\t\t\t.get(fixtureA.sessionManager.getSessionId()),\n\t\t\t),\n\t\t).toEqual({ count: 1 });\n\n\t\tawait promptWithExtraction(fixtureA, A_COMMIT, \"已记录 A\");\n\t\tawait promptWithExtraction(fixtureB, B_COMMIT, \"已记录 B\");\n\t\tfor (const [fixture, task, conclusion] of [\n\t\t\t[fixtureA, taskA, A_COMMIT],\n\t\t\t[fixtureB, taskB, B_COMMIT],\n\t\t] as const) {\n\t\t\tconst memory = memoryByConclusion(fixture.home, conclusion);\n\t\t\texpect(memory.scope).toMatchObject({ projectId: fixture.projectId, taskId: task.taskId });\n\t\t\tconst user = fixture.sessionManager\n\t\t\t\t.getBranch()\n\t\t\t\t.find(\n\t\t\t\t\t(entry) =>\n\t\t\t\t\t\tentry.type === \"message\" &&\n\t\t\t\t\t\tentry.message.role === \"user\" &&\n\t\t\t\t\t\ttextContent(entry.message.content) === conclusion,\n\t\t\t\t)!;\n\t\t\texpect(linkedSources(fixture.home, memory)).toContainEqual(\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\tentryId: user.id,\n\t\t\t\t\tsessionId: fixture.sessionManager.getSessionId(),\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\ttaskId: task.taskId,\n\t\t\t\t}),\n\t\t\t);\n\t\t}\n\t\tconst openB = await readOpenCommitments({\n\t\t\tpaoHome: fixtureB.home,\n\t\t\tprojectId: fixtureB.projectId,\n\t\t\ttaskId: taskB.taskId,\n\t\t});\n\t\texpect(openB.ok && openB.commitments.map((item) => item.conclusion)).toEqual([B_COMMIT]);\n\t\tawait promptWithExtraction(fixtureB, \"读取 B 当前任务\", \"B 继续\");\n\t\texpect(fixtureB.promptSystems.at(-1)).toContain(B_COMMIT);\n\t\texpect(fixtureB.promptSystems.at(-1)).not.toContain(A_COMMIT);\n\t\texpect(\n\t\t\twithStore(fixtureB.home, \"readonly\", (store) =>\n\t\t\t\tstore.db.prepare(\"SELECT COUNT(*) AS count FROM memory_usage WHERE action = 'used'\").get(),\n\t\t\t),\n\t\t).toEqual({ count: 0 });\n\t});\n\n\tit(\"空 SDK 会话仅启用和关闭不创建数据库或发起模型请求\", async () => {\n\t\tconst fixture = await createSdkFixture();\n\t\texpect(existsSync(memoryPaths(fixture.home).database)).toBe(false);\n\t\texpect(fixture.sessionManager.getEntries().some((entry) => entry.type === \"usage\")).toBe(false);\n\t\tawait fixture.close();\n\t\texpect(existsSync(memoryPaths(fixture.home).database)).toBe(false);\n\t});\n\n\tit(\"已有历史的 SDK 会话启用后首轮只采集新用户，不提炼旧承诺\", async () => {\n\t\tconst paths = fixturePaths();\n\t\tconst manager = SessionManager.create(paths.project, paths.sessions);\n\t\tconst historyId = manager.appendMessage({ role: \"user\", content: A_COMMIT, timestamp: 1 });\n\t\tconst fixture = await createSdkFixture({ root: paths.root, sessionManager: manager });\n\t\tawait command(fixture, \"/pao task new\");\n\t\tconst task = currentTask(manager)!;\n\t\tawait promptWithExtraction(fixture, B_COMMIT, \"已记录新承诺\");\n\t\texpect(\n\t\t\twithStore(fixture.home, \"readonly\", (store) =>\n\t\t\t\tstore.db.prepare(\"SELECT event_type, segment_id FROM sources WHERE entry_id = ?\").get(historyId),\n\t\t\t),\n\t\t).toEqual({ event_type: \"boundary\", segment_id: null });\n\t\texpect(activeMemories(fixture.home).map((memory) => memory.content.conclusion)).toEqual([B_COMMIT]);\n\t\texpect(memoryByConclusion(fixture.home, B_COMMIT).scope.taskId).toBe(task.taskId);\n\t});\n\n\tit(\"A/B 自动承诺按任务隔离，选回/压缩/重启恢复原任务，普通召回不串承诺且读取不产生 used\", async () => {\n\t\tconst dispatchSpy = vi.fn();\n\t\tlet fixture = await createSdkFixture({ dispatchSpy });\n\t\tvi.mocked(childProcess.spawn).mockClear();\n\t\tvi.mocked(childProcess.exec).mockClear();\n\t\tvi.mocked(childProcess.execFile).mockClear();\n\t\tvi.mocked(childProcess.execFileSync).mockClear();\n\n\t\tawait command(fixture, \"/pao task new\");\n\t\tconst taskA = currentTask(fixture.sessionManager)!;\n\t\texpect(taskA.taskKind).toBe(\"session\");\n\t\tawait promptWithExtraction(fixture, \"先建立任务会话边界\", \"已建立\");\n\t\tawait waitForJobStatus(fixture, \"done\");\n\n\t\tawait promptWithExtraction(fixture, `${A_COMMIT}；${A_DECISION}`, \"A 任务已记录\");\n\t\tawait waitForMemories(fixture, [A_COMMIT, A_DECISION]);\n\t\tawait waitForJobStatus(fixture, \"done\");\n\n\t\tconst aCommitment = memoryByConclusion(fixture.home, A_COMMIT);\n\t\tconst aDecision = memoryByConclusion(fixture.home, A_DECISION);\n\t\texpect(aCommitment.scope).toMatchObject({\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: taskA.taskId,\n\t\t});\n\t\texpect(aDecision.scope.projectId).toBe(fixture.projectId);\n\t\texpect(aDecision.scope.taskId).toBeUndefined();\n\t\tconst aSources = linkedSources(fixture.home, aCommitment);\n\t\texpect(aSources.length).toBeGreaterThan(0);\n\t\texpect(aSources).toEqual(\n\t\t\texpect.arrayContaining([\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\tprojectId: fixture.projectId,\n\t\t\t\t\ttaskId: taskA.taskId,\n\t\t\t\t}),\n\t\t\t]),\n\t\t);\n\n\t\tawait command(fixture, \"/pao task new\");\n\t\tconst taskB = currentTask(fixture.sessionManager)!;\n\t\texpect(taskB.taskId).not.toBe(taskA.taskId);\n\t\tawait promptWithExtraction(fixture, B_COMMIT, \"B 任务已记录\");\n\t\tawait waitForMemories(fixture, [B_COMMIT]);\n\t\tawait waitForJobStatus(fixture, \"done\");\n\t\tconst bCommitment = memoryByConclusion(fixture.home, B_COMMIT);\n\t\texpect(bCommitment.scope).toMatchObject({ projectId: fixture.projectId, taskId: taskB.taskId });\n\t\texpect(linkedSources(fixture.home, bCommitment)).toEqual(\n\t\t\texpect.arrayContaining([expect.objectContaining({ eventType: \"user\", taskId: taskB.taskId })]),\n\t\t);\n\n\t\tawait promptWithExtraction(fixture, \"B 任务继续\", \"B 已继续\");\n\t\texpect(fixture.promptSystems.at(-1)).toContain(B_COMMIT);\n\t\texpect(fixture.promptSystems.at(-1)).not.toContain(A_COMMIT);\n\t\texpect(fixture.promptSystems.at(-1)).toContain(linkedSources(fixture.home, bCommitment)[0]!.sourceId);\n\n\t\tconst recalledFromB = await fixture.registration.service.searchMemory({\n\t\t\tscope: { projectId: fixture.projectId, taskId: taskB.taskId },\n\t\t\tquery: A_DECISION,\n\t\t\tmode: \"current\",\n\t\t});\n\t\texpect(recalledFromB.ok).toBe(true);\n\t\tif (recalledFromB.ok) {\n\t\t\texpect(recalledFromB.hits).toContainEqual(\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\tmemoryId: aDecision.id,\n\t\t\t\t\tscope: expect.objectContaining({ projectId: fixture.projectId }),\n\t\t\t\t}),\n\t\t\t);\n\t\t}\n\t\tconst sharedScope = scopeFromContext({\n\t\t\tcwd: fixture.project,\n\t\t\tsessionManager: fixture.sessionManager,\n\t\t});\n\t\texpect(sharedScope.taskId).toBeUndefined();\n\t\tconst automaticScopeRecall = await fixture.registration.service.searchMemory({\n\t\t\tscope: sharedScope,\n\t\t\tquery: `${A_COMMIT} ${B_COMMIT} ${A_DECISION}`,\n\t\t\tmode: \"current\",\n\t\t\tlimit: 10,\n\t\t});\n\t\texpect(automaticScopeRecall.ok).toBe(true);\n\t\tif (automaticScopeRecall.ok) {\n\t\t\texpect(automaticScopeRecall.hits.map((hit) => hit.memoryId)).toEqual([aDecision.id]);\n\t\t}\n\n\t\tawait command(fixture, `/pao task select ${taskA.taskId}`);\n\t\tawait promptWithExtraction(fixture, \"A 任务继续\", \"A 已继续\");\n\t\texpect(fixture.promptSystems.at(-1)).toContain(A_COMMIT);\n\t\texpect(fixture.promptSystems.at(-1)).not.toContain(B_COMMIT);\n\t\texpect(currentTask(fixture.sessionManager)?.taskId).toBe(taskA.taskId);\n\n\t\tfixture.faux.setResponses([\n\t\t\tmainResponse(fixture, \"压缩摘要一\"),\n\t\t\tmainResponse(fixture, \"压缩摘要二\"),\n\t\t\tmainResponse(fixture, \"压缩摘要三\"),\n\t\t]);\n\t\tawait fixture.session.compact();\n\t\texpect(currentTask(fixture.sessionManager)?.taskId).toBe(taskA.taskId);\n\t\tawait promptWithExtraction(fixture, \"压缩后继续 A\", \"仍在 A\");\n\t\texpect(fixture.promptSystems.at(-1)).toContain(A_COMMIT);\n\t\texpect(currentTask(fixture.sessionManager)?.taskId).toBe(taskA.taskId);\n\n\t\tconst sessionFile = fixture.sessionManager.getSessionFile()!;\n\t\tconst root = fixture.root;\n\t\tawait fixture.close();\n\t\tfixtures.splice(fixtures.indexOf(fixture), 1);\n\t\tfixture = await createSdkFixture({\n\t\t\troot,\n\t\t\tsessionManager: SessionManager.open(sessionFile),\n\t\t\tdispatchSpy,\n\t\t});\n\t\tawait promptWithExtraction(fixture, \"重启后继续 A\", \"重启仍为 A\");\n\t\texpect(currentTask(fixture.sessionManager)?.taskId).toBe(taskA.taskId);\n\t\texpect(fixture.promptSystems.at(-1)).toContain(A_COMMIT);\n\t\texpect(fixture.promptSystems.at(-1)).not.toContain(B_COMMIT);\n\n\t\tconst openA = await readOpenCommitments({\n\t\t\tpaoHome: fixture.home,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: taskA.taskId,\n\t\t});\n\t\tconst openB = await readOpenCommitments({\n\t\t\tpaoHome: fixture.home,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: taskB.taskId,\n\t\t});\n\t\texpect(openA.ok && openA.commitments.map((item) => item.conclusion)).toEqual([A_COMMIT]);\n\t\texpect(openB.ok && openB.commitments.map((item) => item.conclusion)).toEqual([B_COMMIT]);\n\t\texpect(openA.ok && openA.commitments[0]?.sourceIds).toEqual(\n\t\t\tlinkedSources(fixture.home, aCommitment).map((source) => source.sourceId),\n\t\t);\n\n\t\texpect(\n\t\t\twithStore(\n\t\t\t\tfixture.home,\n\t\t\t\t\"readonly\",\n\t\t\t\t(store) =>\n\t\t\t\t\t(\n\t\t\t\t\t\tstore.db.prepare(\"SELECT COUNT(*) AS count FROM memory_usage WHERE action = 'used'\").get() as {\n\t\t\t\t\t\t\tcount: number;\n\t\t\t\t\t\t}\n\t\t\t\t\t).count,\n\t\t\t),\n\t\t).toBe(0);\n\t\texpect(dispatchSpy).not.toHaveBeenCalled();\n\t\texpect(readdirSync(fixture.cardsDir)).toEqual([]);\n\t\texpect(childProcess.spawn).not.toHaveBeenCalled();\n\t\texpect(childProcess.exec).not.toHaveBeenCalled();\n\t\texpect(childProcess.execFile).not.toHaveBeenCalled();\n\t\texpect(childProcess.execFileSync).not.toHaveBeenCalled();\n\t});\n\n\tit(\"A 首次提炼失败后切 B，恢复时旧来源与新来源仍各归原 taskId\", async () => {\n\t\tconst fixture = await createSdkFixture();\n\t\tawait command(fixture, \"/pao task new\");\n\t\tconst taskA = currentTask(fixture.sessionManager)!;\n\t\tawait promptWithExtraction(fixture, \"建立 A 的来源边界\", \"A 边界已建立\");\n\t\tawait waitForJobStatus(fixture, \"done\");\n\n\t\tfixture.faux.setResponses([\n\t\t\tmainResponse(fixture, \"A 已留下待提炼内容\"),\n\t\t\tfauxAssistantMessage(\"not a json array\"),\n\t\t]);\n\t\tawait fixture.session.prompt(A_COMMIT);\n\t\tawait waitForJobStatus(fixture, \"failed\");\n\t\texpect(activeMemories(fixture.home).some((memory) => memory.content.conclusion === A_COMMIT)).toBe(false);\n\n\t\tawait command(fixture, \"/pao task new\");\n\t\tconst taskB = currentTask(fixture.sessionManager)!;\n\t\tawait promptWithExtraction(fixture, B_COMMIT, \"B 已开始\");\n\t\tawait waitForMemories(fixture, [A_COMMIT, B_COMMIT]);\n\t\tawait waitForJobStatus(fixture, \"done\");\n\n\t\tconst a = memoryByConclusion(fixture.home, A_COMMIT);\n\t\tconst b = memoryByConclusion(fixture.home, B_COMMIT);\n\t\texpect(a.scope).toMatchObject({ projectId: fixture.projectId, taskId: taskA.taskId });\n\t\texpect(b.scope).toMatchObject({ projectId: fixture.projectId, taskId: taskB.taskId });\n\t\texpect(linkedSources(fixture.home, a)).toEqual(\n\t\t\texpect.arrayContaining([expect.objectContaining({ eventType: \"user\", taskId: taskA.taskId })]),\n\t\t);\n\t\texpect(linkedSources(fixture.home, b)).toEqual(\n\t\t\texpect.arrayContaining([expect.objectContaining({ eventType: \"user\", taskId: taskB.taskId })]),\n\t\t);\n\t});\n\n\tit(\"真实派发成功结果建立卡任务，后续自动承诺继承卡 taskId 并只在该任务提醒\", async () => {\n\t\tconst dispatchSpy = vi.fn();\n\t\tconst fixture = await createSdkFixture({ dispatchSpy });\n\t\tconst card = await createCard(fixture.cardsDir, {\n\t\t\t目标: \"S5 自动承诺卡任务\",\n\t\t\t部门: \"研发\",\n\t\t\t验收: \"承诺读回不派发\",\n\t\t\t创建: \"2026-11-09 14:00\",\n\t\t});\n\t\tvi.mocked(childProcess.spawn).mockClear();\n\t\tvi.mocked(childProcess.exec).mockClear();\n\t\tvi.mocked(childProcess.execFile).mockClear();\n\t\tvi.mocked(childProcess.execFileSync).mockClear();\n\n\t\tfixture.faux.setResponses([\n\t\t\t(context: Context) => {\n\t\t\t\tfixture.promptSystems.push(getCurrentSystemPrompt(context.messages));\n\t\t\t\treturn fauxAssistantMessage(\n\t\t\t\t\tfauxToolCall(\n\t\t\t\t\t\t\"pao_dispatch_card\",\n\t\t\t\t\t\t{ cards_dir: fixture.cardsDir, card_no: card.card_no },\n\t\t\t\t\t\t{ id: \"dispatch-task-chain\" },\n\t\t\t\t\t),\n\t\t\t\t);\n\t\t\t},\n\t\t\tmainResponse(fixture, \"卡已派发\"),\n\t\t\textractionResponse(fixture),\n\t\t]);\n\t\tawait fixture.session.prompt(\"派发当前卡\");\n\t\tconst cardTask = currentTask(fixture.sessionManager)!;\n\t\texpect(cardTask).toMatchObject({\n\t\t\ttaskKind: \"card\",\n\t\t\ttaskId: taskIdForCard(fixture.cardsDir, card.card_no),\n\t\t});\n\t\texpect(dispatchSpy).toHaveBeenCalledTimes(1);\n\t\tawait waitForJobStatus(fixture, \"done\");\n\n\t\tawait promptWithExtraction(fixture, CARD_COMMIT, \"卡任务承诺已记录\");\n\t\tawait waitForMemories(fixture, [CARD_COMMIT]);\n\t\tawait waitForJobStatus(fixture, \"done\");\n\t\tconst commitment = memoryByConclusion(fixture.home, CARD_COMMIT);\n\t\texpect(commitment.scope).toMatchObject({\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: cardTask.taskId,\n\t\t});\n\t\texpect(linkedSources(fixture.home, commitment)).toEqual(\n\t\t\texpect.arrayContaining([expect.objectContaining({ eventType: \"user\", taskId: cardTask.taskId })]),\n\t\t);\n\n\t\tawait promptWithExtraction(fixture, \"继续卡任务\", \"读取当前任务\");\n\t\texpect(fixture.promptSystems.at(-1)).toContain(CARD_COMMIT);\n\t\texpect(dispatchSpy).toHaveBeenCalledTimes(1);\n\t\texpect(childProcess.spawn).not.toHaveBeenCalled();\n\t\texpect(childProcess.exec).not.toHaveBeenCalled();\n\t\texpect(childProcess.execFile).not.toHaveBeenCalled();\n\t\texpect(childProcess.execFileSync).not.toHaveBeenCalled();\n\t});\n});\n"},"tags":[],"source":null}],"command":"check"}
