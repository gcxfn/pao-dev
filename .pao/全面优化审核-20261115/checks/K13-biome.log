{"summary":{"changed":0,"unchanged":648,"matches":0,"duration":{"secs":3,"nanos":836948300},"scannerDuration":{"secs":0,"nanos":20650300},"errors":130,"warnings":44,"infos":5,"skipped":0,"suggestedFixesSkipped":0,"diagnosticsNotPrinted":0},"diagnostics":[{"category":"lint/complexity/useLiteralKeys","severity":"information","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n *\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"]sourceLinks.activation === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":435}},{"diffOp":{"equal":{"range":[51,185]}}},{"diffOp":{"delete":{"range":[185,210]}}},{"diffOp":{"insert":{"range":[210,232]}}},{"diffOp":{"equal":{"range":[232,233]}}},{"diffOp":{"equal":{"range":[233,305]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[305,311]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":[18381,18393],"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"information","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n *\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"]links.candidateId === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":201}},{"diffOp":{"equal":{"range":[51,147]}}},{"diffOp":{"delete":{"range":[147,167]}}},{"diffOp":{"insert":{"range":[167,184]}}},{"diffOp":{"equal":{"range":[184,185]}}},{"diffOp":{"equal":{"range":[185,289]}}},{"equalLines":{"line_count":69}},{"diffOp":{"equal":{"range":[289,324]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":[9234,9247],"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"information","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n *\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"]links.candidateId;\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":202}},{"diffOp":{"equal":{"range":[51,167]}}},{"diffOp":{"delete":{"range":[167,187]}}},{"diffOp":{"insert":{"range":[187,204]}}},{"diffOp":{"equal":{"range":[204,248]}}},{"equalLines":{"line_count":68}},{"diffOp":{"equal":{"range":[248,283]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":[9301,9314],"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"information","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n *\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"]links.activation === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":199}},{"diffOp":{"equal":{"range":[51,151]}}},{"diffOp":{"delete":{"range":[151,170]}}},{"diffOp":{"insert":{"range":[170,186]}}},{"diffOp":{"equal":{"range":[186,187]}}},{"diffOp":{"equal":{"range":[187,291]}}},{"equalLines":{"line_count":71}},{"diffOp":{"equal":{"range":[291,326]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":[9146,9158],"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"information","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *\ttry {\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\"batch-read\", [0, 1, 2].map(i => msgUser(\"`batch-parse-event-\" + ${i}`)) as never, AT);\n\t\tconst ids = captured.map(item => item.sourceId!);\n\t\tconst expected = await Promise.all(ids.map(id => readSourceEvents(store.db, home, id, { offset: -1, limit: 2 })));\t} finally { store.close(); }\n});\n","ops":[{"diffOp":{"equal":{"range":[0,118]}}},{"equalLines":{"line_count":478}},{"diffOp":{"equal":{"range":[118,291]}}},{"diffOp":{"delete":{"range":[291,292]}}},{"diffOp":{"insert":{"range":[292,293]}}},{"diffOp":{"equal":{"range":[293,311]}}},{"diffOp":{"delete":{"range":[311,315]}}},{"diffOp":{"insert":{"range":[315,317]}}},{"diffOp":{"equal":{"range":[317,318]}}},{"diffOp":{"insert":{"range":[318,320]}}},{"diffOp":{"equal":{"range":[320,506]}}},{"equalLines":{"line_count":29}},{"diffOp":{"equal":{"range":[506,540]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-source.test.ts"},"span":[19356,19380],"sourceCode":"/**\n * S1-15 定向测试：内置记忆来源链（capture 采集 / archive 封存 / readMemorySource 回读）。\n *\n * 覆盖：首次启用边界登记不回追历史、增量采集与幂等去重、凭证剔除（数据库/段文件/\n * 附件字节级）、附件受管副本、sealSegment 压缩与小段 uncompressed、未封存/已封存\n * 两条回读路、邻近窗口、缺来源与段文件丢失如实 source_missing、跨重启定位。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-source.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { appendToOpenSegment, findOpenSegment, getSegment, readSourceEvents, readSourceEventsBatch, readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-src-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 下 SQLite 句柄释放与文件可见性有延迟；清理失败不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T12:00:00.000Z\";\nconst SECRET = \"uh27r73wSECRET\"; // 测试凭证值：不应出现在任何落盘字节里\nconst PNG_B64 = \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\";\n\nlet seq = 0;\nfunction entry(partial: Record<string, unknown>) {\n\tseq += 1;\n\treturn { id: `e-${seq}`, parentId: seq > 1 ? `e-${seq - 1}` : null, timestamp: AT, ...partial };\n}\nconst msgUser = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({ type: \"message\", message: { role: \"user\", content, timestamp: 1, ...extra } });\nconst msgAssistant = (blocks: unknown[]) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: { role: \"assistant\", content: blocks, provider: \"p\", model: \"m\", usage: {}, stopReason: \"stop\" },\n\t});\nconst msgTool = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: {\n\t\t\trole: \"toolResult\",\n\t\t\ttoolCallId: \"tc1\",\n\t\t\ttoolName: \"bash\",\n\t\t\tcontent,\n\t\t\tisError: false,\n\t\t\ttimestamp: 1,\n\t\t\t...extra,\n\t\t},\n\t});\n\n/** 递归收集目录下全部文件（字节级凭证扫描用）。 */\nfunction allFiles(root: string): string[] {\n\tconst files: string[] = [];\n\tconst stack = [root];\n\twhile (stack.length > 0) {\n\t\tconst dir = stack.pop();\n\t\tif (dir === undefined || !existsSync(dir)) continue;\n\t\tfor (const name of readdirSync(dir)) {\n\t\t\tconst path = join(dir, name);\n\t\t\tif (statSync(path).isDirectory()) stack.push(path);\n\t\t\telse files.push(path);\n\t\t}\n\t}\n\treturn files;\n}\n\ndescribe(\"capture 边界与增量采集\", () => {\n\tit(\"首次启用记 boundary，不追采启用前历史；增量采集、幂等去重、不可采集类型跳过\", () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cap\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\t// 启用前历史登记为边界\n\t\tconst history = [msgUser(\"启用前的旧消息 1\"), msgAssistant([{ type: \"text\", text: \"启用前的旧回复\" }])];\n\t\tcapture.markBoundary(\n\t\t\tsessionId,\n\t\t\thistory.map((e) => e.id as string),\n\t\t\tAT,\n\t\t);\n\t\texpect(history.every((e) => capture.isCaptured(sessionId, e.id as string))).toBe(true);\n\n\t\t// 新提交条目（最后一条复用边界内 id，验证去重而非新增）\n\t\tconst committed = [\n\t\t\tmsgUser(\"决定：内置记忆用 SQLite\"),\n\t\t\tmsgAssistant([{ type: \"text\", text: \"已记录\" }]),\n\t\t\tmsgTool([{ type: \"text\", text: \"回执\" }]),\n\t\t\tentry({ type: \"custom_message\", customType: \"pao-note\", content: \"自定义\", display: false }),\n\t\t\tentry({ type: \"usage\", kind: \"main\", provider: \"p\", model: \"m\", usage: {} }),\n\t\t\tmsgUser(\"这条复用旧 id\"),\n\t\t];\n\t\t(committed[5] as { id: string }).id = history[0].id as string;\n\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\tconst byEntry = new Map(captured.map((r) => [r.entryId, r]));\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(4);\n\t\texpect(byEntry.get(history[0].id as string)?.outcome).toBe(\"skipped\");\n\t\texpect(byEntry.get((committed[4] as { id: string }).id)?.reason).toContain(\"usage\");\n\t\texpect(captured.filter((r) => r.outcome === \"captured\").every((r) => r.sourceId && r.segmentId)).toBe(true);\n\n\t\t// 重复采集同批：全部 skipped（同 sessionId+entryId+eventType 幂等）\n\t\tconst dup = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(dup.every((r) => r.outcome === \"skipped\")).toBe(true);\n\n\t\t// 段文件与 sources 行已落\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"凭证剔除与附件\", () => {\n\tit(\"已知凭证值不出现在 sources 行、段文件、附件副本（字节级断言）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-secret\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\n\t\tconst committed = [\n\t\t\tmsgAssistant([{ type: \"text\", text: `配置 password=${SECRET} 与 sk-live-${SECRET}` }]),\n\t\t\tmsgUser([\n\t\t\t\t{ type: \"text\", text: \"截图里的凭证\" },\n\t\t\t\t{ type: \"image\", data: PNG_B64, mimeType: \"image/png\" },\n\t\t\t]),\n\t\t\tmsgTool([{ type: \"text\", text: `env: api_key=${SECRET}` }], {\n\t\t\t\tdetails: { credentials: { secret: SECRET }, note: \"ok\" },\n\t\t\t}),\n\t\t];\n\t\tconst captured = capture.captureCommittedEntries(sessionId, committed as never, AT);\n\t\texpect(captured.filter((r) => r.outcome === \"captured\")).toHaveLength(3);\n\n\t\t// 附件副本落 attachments/，字节与原始一致（PNG 无凭证）\n\t\tconst attRoot = memoryPaths(home).attachments;\n\t\tconst attDirs = existsSync(attRoot) ? readdirSync(attRoot) : [];\n\t\texpect(attDirs).toHaveLength(1);\n\t\tconst attFile = join(attRoot, attDirs[0], \"data.png\");\n\t\texpect(readFileSync(attFile).equals(Buffer.from(PNG_B64, \"base64\"))).toBe(true);\n\n\t\t// 字节级扫描：数据库 + 归档段 + 附件均无凭证值\n\t\tconst paths = memoryPaths(home);\n\t\texpect(readFileSync(paths.database).includes(SECRET)).toBe(false);\n\t\tconst segBytes = Buffer.concat(allFiles(paths.archives).map((p) => readFileSync(p)));\n\t\texpect(segBytes.includes(SECRET)).toBe(false);\n\t\texpect(segBytes.includes(Buffer.from(PNG_B64, \"base64\"))).toBe(false); // base64 原文不落段\n\n\t\t// 段内事件：图片块不落 base64（附件字节在受管副本，段内只有脱敏后的引用形态），\n\t\t// 文本块里的凭证已被替换为脱敏标记。\n\t\tconst lines = readFileSync(findOpenSegment(store.db, sessionId)!.originalPath, \"utf8\")\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((l) => l.length > 0)\n\t\t\t.map((l) => JSON.parse(l) as { content: unknown });\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(PNG_B64))).toBe(true);\n\t\texpect(lines.every((l) => !JSON.stringify(l.content).includes(SECRET))).toBe(true);\n\t\texpect(lines.some((l) => JSON.stringify(l.content).includes(\"[已脱敏]\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"封存与回读\", () => {\n\tit(\"sealSegment：过阈值走 gzip 发布、原 JSONL 清理、行标 sealed；回读走解压路\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-seal\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 大条目把段推过 256KiB 压缩阈值\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[\n\t\t\t\tmsgUser(\"锚点：SQLite 决定\"),\n\t\t\t\tmsgAssistant([{ type: \"text\", text: `长回执 ${\"甲\".repeat(300 * 1024)}` }]),\n\t\t\t] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured.find((r) => r.outcome === \"captured\")?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeDefined();\n\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"sealed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(existsSync(sealed?.compressedPath ?? `${segment!.originalPath}.gz`)).toBe(true);\n\t\texpect(existsSync(segment!.originalPath)).toBe(false); // 原 JSONL 已清\n\n\t\t// 已封存段回读：内容一致且 archived=true\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(true);\n\t\t\texpect(read.segmentId).toBe(segment!.segmentId);\n\t\t\texpect(read.content).toContain(\"SQLite\");\n\t\t\texpect(read.startLine).toBe(1);\n\t\t\texpect(read.endLine).toBe(2);\n\t\t\texpect(read.hasMore).toBe(false);\n\t\t\texpect(read.nextOffset).toBeUndefined();\n\t\t\texpect(read.metadata).toBeTypeOf(\"object\");\n\t\t}\n\t\t// 重复封存幂等\n\t\tconst again = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(again.ok).toBe(true);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"小段封存：未过阈值记 sealed 但无压缩文件，回读走 original_path\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-small\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"小段一条\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(seal.outcome).toBe(\"uncompressed\");\n\t\tconst sealed = getSegment(store.db, segment!.segmentId);\n\t\texpect(sealed?.status).toBe(\"sealed\");\n\t\texpect(sealed?.compressedPath).toBeUndefined();\n\t\texpect(existsSync(segment!.originalPath)).toBe(true); // 原文保留\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false); // 无压缩段 → 按未封存回读\n\t\t\texpect(read.content).toContain(\"小段一条\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"邻近窗口 offset/limit 取上下文；缺来源与段内无条目如实 source_missing\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-window\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\tsessionId,\n\t\t\t[msgUser(\"第一条\"), msgUser(\"第二条\"), msgUser(\"第三条\"), msgUser(\"第四条\"), msgUser(\"第五条\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst mid = captured[1]?.sourceId as string;\n\t\tconst anchorEntryId = captured[2]?.entryId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst win = await svc.readMemorySource({\n\t\t\tsourceId: mid,\n\t\t\tentryId: anchorEntryId,\n\t\t\toffset: -1,\n\t\t\tlimit: 2,\n\t\t});\n\t\texpect(win.ok).toBe(true);\n\t\tif (win.ok) {\n\t\t\tconst lines = win.content.split(\"\\n\");\n\t\t\tconst events = lines.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\texpect(events).toHaveLength(2);\n\t\t\texpect(events[0]?.entryId).toBe(captured[1]?.entryId);\n\t\t\texpect(JSON.stringify(events[0]?.content)).toContain(\"第二条\");\n\t\t\texpect(events[1]?.entryId).toBe(anchorEntryId);\n\t\t\texpect(win.metadata.lineNo).toBe(3);\n\t\t\texpect(win.startLine).toBe(2);\n\t\t\texpect(win.endLine).toBe(3);\n\t\t\texpect(win.hasMore).toBe(true);\n\t\t\texpect(win.nextOffset).toBe(1);\n\n\t\t\tconst next = await svc.readMemorySource({\n\t\t\t\tsourceId: mid,\n\t\t\t\tentryId: anchorEntryId,\n\t\t\t\toffset: win.nextOffset,\n\t\t\t\tlimit: 2,\n\t\t\t});\n\t\t\texpect(next.ok).toBe(true);\n\t\t\tif (next.ok) {\n\t\t\t\tconst nextEvents = next.content\n\t\t\t\t\t.split(\"\\n\")\n\t\t\t\t\t.map((line) => JSON.parse(line) as { entryId: string; content: unknown });\n\t\t\t\texpect(nextEvents.map((event) => event.entryId)).toEqual([captured[3]?.entryId, captured[4]?.entryId]);\n\t\t\t\texpect(next.startLine).toBe(4);\n\t\t\t\texpect(next.endLine).toBe(5);\n\t\t\t\texpect(next.hasMore).toBe(false);\n\t\t\t\texpect(next.nextOffset).toBeUndefined();\n\t\t\t}\n\t\t}\n\n\t\tconst miss = await svc.readMemorySource({ sourceId: \"src-no-such\" });\n\t\texpect(miss.ok).toBe(false);\n\t\tif (!miss.ok) expect(miss.error.code).toBe(\"source_missing\");\n\n\t\t// 段内不存在的 entryId → source_missing 而非伪造\n\t\tconst noEntry = await svc.readMemorySource({ sourceId: mid, entryId: \"e-nonexistent\" });\n\t\texpect(noEntry.ok).toBe(false);\n\t\tif (!noEntry.ok) expect(noEntry.error.code).toBe(\"source_missing\");\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"来源分页默认 50 条、单页上限 200，nextOffset 连续可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-bounded\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tlet segmentId = \"\";\n\t\tfor (let index = 0; index < 205; index += 1) {\n\t\t\tconst appended = appendToOpenSegment(\n\t\t\t\tstore.db,\n\t\t\t\thome,\n\t\t\t\tsessionId,\n\t\t\t\t{\n\t\t\t\t\tv: 1,\n\t\t\t\t\tsessionId,\n\t\t\t\t\tentryId: `e-page-${String(index).padStart(3, \"0\")}`,\n\t\t\t\t\tentryType: \"message\",\n\t\t\t\t\teventType: \"user\",\n\t\t\t\t\ttimestamp: AT,\n\t\t\t\t\tcapturedAt: AT,\n\t\t\t\t\tcontent: `分页事件 ${index}`,\n\t\t\t\t},\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tsegmentId = appended.segmentId;\n\t\t}\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId,\n\t\t\tentryId: \"e-page-000\",\n\t\t\teventType: \"user\",\n\t\t\tsegmentId,\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\n\t\tconst defaults = await svc.readMemorySource({ sourceId });\n\t\texpect(defaults.ok).toBe(true);\n\t\tif (defaults.ok) {\n\t\t\texpect(defaults.content.split(\"\\n\")).toHaveLength(50);\n\t\t\texpect(defaults.startLine).toBe(1);\n\t\t\texpect(defaults.endLine).toBe(50);\n\t\t\texpect(defaults.hasMore).toBe(true);\n\t\t\texpect(defaults.nextOffset).toBe(50);\n\t\t}\n\n\t\tconst capped = await svc.readMemorySource({ sourceId, limit: 999 });\n\t\texpect(capped.ok).toBe(true);\n\t\tif (capped.ok) {\n\t\t\texpect(capped.content.split(\"\\n\")).toHaveLength(200);\n\t\t\texpect(capped.endLine).toBe(200);\n\t\t\texpect(capped.hasMore).toBe(true);\n\t\t\texpect(capped.nextOffset).toBe(200);\n\t\t}\n\n\t\tconst tail = await svc.readMemorySource({ sourceId, offset: capped.ok ? capped.nextOffset : 200 });\n\t\texpect(tail.ok).toBe(true);\n\t\tif (tail.ok) {\n\t\t\tconst events = tail.content.split(\"\\n\").map((line) => JSON.parse(line) as { entryId: string });\n\t\t\texpect(events).toHaveLength(5);\n\t\t\texpect(events[0]?.entryId).toBe(\"e-page-200\");\n\t\t\texpect(events[4]?.entryId).toBe(\"e-page-204\");\n\t\t\texpect(tail.hasMore).toBe(false);\n\t\t\texpect(tail.nextOffset).toBeUndefined();\n\t\t}\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"段文件丢失如实 source_missing，不伪造内容\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-lost\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"要丢的段\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\t// 删除段文件制造丢失\n\t\tconst segment = findOpenSegment(store.db, sessionId)!;\n\t\trmSync(segment.originalPath);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(false);\n\t\tif (!read.ok) {\n\t\t\texpect(read.error.code).toBe(\"source_missing\");\n\t\t\texpect(read.error.message).toContain(\"段文件缺失\");\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n\ndescribe(\"跨重启定位\", () => {\n\tit(\"关库重开后 readMemorySource 仍定位原文；readonly 实例也能回读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-reopen\";\n\t\tlet sourceId = \"\";\n\t\t{\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t\tsourceId = capture.captureCommittedEntries(sessionId, [msgUser(\"跨重启找得到我\")] as never, AT)[0]\n\t\t\t\t?.sourceId as string;\n\t\t\tstore.close();\n\t\t}\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst read = await svc.readMemorySource({ sourceId });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) {\n\t\t\texpect(read.archived).toBe(false);\n\t\t\texpect(read.content).toContain(\"跨重启找得到我\");\n\t\t\texpect(read.entryId).toBeTruthy();\n\t\t\texpect(read.eventType).toBe(\"user\");\n\t\t}\n\t\tconst ro = openMemoryService({ paoHome: home, mode: \"readonly\" });\n\t\tconst readRo = await ro.readMemorySource({ sourceId });\n\t\texpect(readRo.ok).toBe(true);\n\t\tawait ro.close();\n\t\tawait svc.close();\n\t});\n});\n\ndescribe(\"验收演示：完整链路（工具写入→退出→重开→详情→原文回读）\", () => {\n\tit(\"createMemory 写入 → 关闭 → 重开 → getMemory 详情 → readMemorySource 回读来源原文\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-demo\";\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\t// 采集会话原文，作为记忆来源\n\t\tconst captured = capture.captureCommittedEntries(sessionId, [msgUser(\"用户拍板：存储用 SQLite\")] as never, AT);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"pao-dev\", sessionId },\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(created.ok).toBe(true);\n\t\tconst memId = created.ok ? created.id : \"\";\n\t\tawait svc.close();\n\t\tstore.close();\n\n\t\t// 模拟进程退出重开\n\t\tconst svc2 = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst got = await svc2.getMemory({ id: memId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\");\n\t\tconst srcSummary = got.sourceSummaries[0];\n\t\texpect(srcSummary?.readable).toBe(true);\n\t\tconst back = await svc2.readMemorySource({ sourceId: srcSummary!.sourceId });\n\t\texpect(back.ok).toBe(true);\n\t\tif (back.ok) {\n\t\t\texpect(back.content).toContain(\"用户拍板：存储用 SQLite\");\n\t\t\texpect(back.sessionId).toBe(sessionId);\n\t\t}\n\t\tawait svc2.close();\n\t});\n});\n\nit(\"同段批读只解析一次，窗口、坏行与缺来源保持逐条回读语义\", async () => {\n\tconst home = tempHome();\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\"batch-read\", [0, 1, 2].map(i => msgUser(\"batch-parse-event-\" + i)) as never, AT);\n\t\tconst ids = captured.map(item => item.sourceId!);\n\t\tconst expected = await Promise.all(ids.map(id => readSourceEvents(store.db, home, id, { offset: -1, limit: 2 })));\n\t\tconst parse = JSON.parse;\n\t\tlet parses = 0;\n\t\tlet reads = 0;\n\t\tconst spy = vi.spyOn(JSON, \"parse\").mockImplementation((value, reviver) => {\n\t\t\tif (typeof value === \"string\" && value.includes(\"batch-parse-event-\")) parses++;\n\t\t\treturn parse(value, reviver);\n\t\t});\n\t\ttry {\n\t\t\tconst actual = await readSourceEventsBatch(store.db, home, [...ids, \"missing-source\"], {\n\t\t\t\trange: { offset: -1, limit: 2 },\n\t\t\t\treadSegment: async segment => { reads++; return readSegmentLines(segment); },\n\t\t\t});\n\t\t\texpect(ids.map(id => actual.get(id))).toEqual(expected);\n\t\t\texpect(actual.get(\"missing-source\")).toMatchObject({ ok: false, error: { code: \"source_missing\" } });\n\t\t\texpect(reads).toBe(1);\n\t\t\texpect(parses).toBe(3);\n\t\t} finally { spy.mockRestore(); }\n\t\tconst withBadLine = await readSourceEventsBatch(store.db, home, ids, {\n\t\t\trange: { limit: 1 },\n\t\t\treadSegment: async segment => {\n\t\t\t\tconst data = await readSegmentLines(segment);\n\t\t\t\treturn data === undefined ? undefined : { ...data, lines: [\"{\", ...data.lines] };\n\t\t\t},\n\t\t});\n\t\tfor (const id of ids) {\n\t\t\tconst result = withBadLine.get(id);\n\t\t\texpect(result?.ok).toBe(true);\n\t\t\tif (result?.ok) expect(result.events).toHaveLength(1);\n\t\t}\n\t} finally { store.close(); }\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n *import { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem\n\tEvolutionResource,\n\tEvolutionSampleGroup\n\tMemoryResult,\n\tValidationPlan\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":32}},{"diffOp":{"equal":{"range":[57,169]}}},{"diffOp":{"delete":{"range":[169,189]}}},{"diffOp":{"delete":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[190,210]}}},{"diffOp":{"delete":{"range":[210,228]}}},{"diffOp":{"delete":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[228,248]}}},{"diffOp":{"delete":{"range":[248,270]}}},{"diffOp":{"delete":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[270,285]}}},{"diffOp":{"delete":{"range":[285,301]}}},{"diffOp":{"delete":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[301,377]}}},{"equalLines":{"line_count":798}},{"diffOp":{"equal":{"range":[377,383]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[2528,2660],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function listFilesRecursive is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"listFilesRecursive"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"listFilesRecursive"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive_listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":202}},{"diffOp":{"equal":{"range":[57,195]}}},{"diffOp":{"delete":{"range":[195,213]}}},{"diffOp":{"insert":{"range":[213,232]}}},{"diffOp":{"equal":{"range":[232,410]}}},{"equalLines":{"line_count":635}},{"diffOp":{"equal":{"range":[410,416]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[9752,9770],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedFunctionParameters","severity":"warning","description":"This parameter is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"parameter"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused parameters might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"allowedFiles"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles_allowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":278}},{"diffOp":{"equal":{"range":[57,179]}}},{"diffOp":{"equal":{"range":[179,181]}}},{"diffOp":{"delete":{"range":[181,193]}}},{"diffOp":{"insert":{"range":[193,206]}}},{"diffOp":{"equal":{"range":[206,301]}}},{"equalLines":{"line_count":558}},{"diffOp":{"equal":{"range":[301,307]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[12489,12501],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedFunctionParameters","severity":"warning","description":"This parameter is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"parameter"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused parameters might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"resource"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource_resource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":279}},{"diffOp":{"equal":{"range":[57,181]}}},{"diffOp":{"equal":{"range":[181,183]}}},{"diffOp":{"delete":{"range":[183,191]}}},{"diffOp":{"insert":{"range":[191,200]}}},{"diffOp":{"equal":{"range":[200,314]}}},{"equalLines":{"line_count":557}},{"diffOp":{"equal":{"range":[314,320]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":[12514,12522],"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"warning","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n *\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith?.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":191}},{"diffOp":{"equal":{"range":[51,145]}}},{"diffOp":{"equal":{"range":[145,155]}}},{"diffOp":{"delete":{"range":[155,189]}}},{"diffOp":{"insert":{"range":[189,201]}}},{"diffOp":{"equal":{"range":[201,212]}}},{"diffOp":{"equal":{"range":[212,280]}}},{"equalLines":{"line_count":259}},{"diffOp":{"equal":{"range":[280,286]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":[9152,9207],"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedFunctionParameters","severity":"warning","description":"This parameter is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"parameter"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused parameters might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"resourceId"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n * */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId_resourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":214}},{"diffOp":{"equal":{"range":[51,115]}}},{"diffOp":{"equal":{"range":[115,117]}}},{"diffOp":{"delete":{"range":[117,127]}}},{"diffOp":{"insert":{"range":[127,138]}}},{"diffOp":{"equal":{"range":[138,205]}}},{"equalLines":{"line_count":235}},{"diffOp":{"equal":{"range":[205,211]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":[10206,10216],"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"warning","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * 受控自进化用户控制（S9-10）。\n *\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith?.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":449}},{"diffOp":{"equal":{"range":[51,155]}}},{"diffOp":{"equal":{"range":[155,165]}}},{"diffOp":{"delete":{"range":[165,199]}}},{"diffOp":{"insert":{"range":[199,211]}}},{"diffOp":{"equal":{"range":[211,222]}}},{"diffOp":{"equal":{"range":[222,244]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[244,250]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\control.ts"},"span":[18887,18942],"sourceCode":"/**\n * 受控自进化用户控制（S9-10）。\n *\n * 职责：\n * - `setResourceAutoEvolution`：单资源停用/恢复自动进化的薄封装（语义注释：\n *   停止新候选领取、保留当前有效版、不影响其他资源）。\n * - `restoreResourceVersion`：把历史版本恢复为当前生效版——**必须重新过\n *   发布判据**（目录指纹完整、有未停用 publish 凭据、来源依据仍有效、\n *   当前指向与 expectedEffectiveVersion 一致），全过后走单事务\n *   UPDATE effective_version + INSERT kind='restore' activation。\n * - `listActivationHistory`：版本时间线数据（publish/restore/rollback 全量\n *   按时间），供界面「版本历史」区展示。\n *\n * 契约（S9 任务书 §5）：\n * - 关闭某 resourceId 自动进化 → 停止新候选领取、保留当前有效版、不影响\n *   其他资源；候选不能自行重新开启——`auto_evolution_enabled` 检查在\n *   `activateCandidate` 前置 d（生效入口拦截）；`proposeCandidate` 侧目前\n *   未查该开关（本批不补，候选生成归宿主流程控制，生效时统一拦截）。\n * - 恢复历史版本必须重新过发布判据；曾失败/未通过验证/依据失效的版本\n *   拒绝直接恢复，返回 needs_reevaluation；页面不能绕过判据直接改指向。\n * - `restoreResourceVersion` 与 `activateCandidate` 同为单事务切换；\n *   事务不含模型/进程调用。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { setAutoEvolution, getResource } from \"./resources.ts\";\nimport type { EvolutionResource } from \"./types.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. setResourceAutoEvolution（薄封装 + 语义注释）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `setResourceAutoEvolution` 的输入。 */\nexport interface SetResourceAutoEvolutionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** true=恢复自动进化；false=停用。 */\n\tenabled: boolean;\n\t/** 操作原因（人读；写入审计备注位——本批只透传不落库，库内无该列）。 */\n\treason?: string;\n\t/** 操作时间（夹具注入）。 */\n\tupdatedAt?: string;\n}\n\n/**\n * 停用/恢复单资源自动进化（薄封装 resources.ts setAutoEvolution）。\n *\n * 语义（S9 任务书 §5）：\n * - 关闭后停止该资源新候选领取（激活入口 `activateCandidate` 前置 d 检查\n *   `auto_evolution_enabled`，被停用时生效直接 conflict）；\n * - 保留当前 `effective_version` 指向（停用不改指向，已发布的版本仍可加载）；\n * - 不影响其他资源（`auto_evolution_enabled` 是单行字段，只 UPDATE 本 resourceId）；\n * - 候选不能自行重新开启：开关只能由本入口写入，候选路径（proposeCandidate →\n *   validation → publish → activate）无写 `auto_evolution_enabled` 的代码路径；\n *   `proposeCandidate` 目前不查该开关——生效时 `activateCandidate` 统一拦截。\n */\nexport function setResourceAutoEvolution(\n\tstore: MemoryStore,\n\tinput: SetResourceAutoEvolutionInput,\n): MemoryResult<EvolutionResource> {\n\t// reason 目前不落库（表无该列）；语义在函数注释说明，透传 updatedAt 供夹具。\n\treturn setAutoEvolution(store, {\n\t\tresourceId: input.resourceId,\n\t\tenabled: input.enabled,\n\t\t...(input.updatedAt === undefined ? {} : { updatedAt: input.updatedAt }),\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. restoreResourceVersion：历史版本恢复（重过发布判据）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `restoreResourceVersion` 的输入。 */\nexport interface RestoreResourceVersionInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 要恢复成的版本 ID。 */\n\ttargetVersionId: string;\n\t/**\n\t * 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突，\n\t * 防并发下把别人刚换的指向覆盖）。\n\t */\n\texpectedEffectiveVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 恢复原因（人读，记入 activation.reason）。 */\n\treason?: string;\n\t/** 恢复时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `restoreResourceVersion` 的成功输出。 */\nexport interface RestoreResult {\n\trestored: true;\n\t/** 本次写入的 restore activation ID。 */\n\tactivationId: string;\n\t/** 恢复后的版本（= targetVersionId）。 */\n\tversionId: string;\n}\n\n/** `restoreResourceVersion` 的业务拒绝输出。 */\nexport interface RestoreRejected {\n\tstatus: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（逐条说明哪条判据没过）。 */\n\treason: string;\n\t/** 当前实际生效版本（供调用方重取；资源行缺失时缺省）。 */\n\tcurrentEffectiveVersion?: string;\n}\n\n/** 版本时间线一行（publish/restore/rollback 全量）。 */\nexport interface ActivationHistoryEntry {\n\tactivationId: string;\n\tresourceId: string;\n\tfromVersion?: string;\n\ttoVersion: string;\n\tkind: \"publish\" | \"restore\" | \"rollback\";\n\treason?: string;\n\t/** source_links_json 解析结果（原样透传；无或非法 JSON 时缺省）。 */\n\tsourceLinks?: Record<string, unknown>;\n\tcreatedAt: string;\n\t/** 该 to_version 当前是否被「停用:」标记（reason 前缀判定）。 */\n\tdisabled: boolean;\n\t/** 该 to_version 是否为生效凭据（kind='publish' 且 activation='effective'）。 */\n\teffective: boolean;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 内部：行读取、指纹与判据\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\n\t// O12/E12：三处私有重复收拢为 versions.ts 共享实现（文件/目录统一分派）。\n\treturn fingerprintResourceRoot(root);\n}\n\n/** 版本目录完整性（与 activation.ts isVersionDirComplete 同口径，独立实现不跨模块导入）。 */\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintDirectory(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ResourceRow {\n\tresource_id: string;\n\teffective_version: string | null;\n}\n\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT resource_id, effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as ResourceRow | undefined;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 判据 b：该版本有 kind='publish' 凭据且未被「停用:」标记。\n *\n * 返回凭据里解析出的 candidateId（供判据 c 查 source_links）；\n * 无凭据/已停用/非 JSON 行 → undefined。\n */\nfunction findUsablePublishCredential(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tversionId: string,\n): { candidateId?: string } | undefined {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId, versionId) as unknown as ActivationRow[];\n\tfor (const row of rows) {\n\t\tif (row.reason !== null && row.reason.startsWith(\"停用:\")) continue;\n\t\tif (row.source_links_json === null) return {};\n\t\ttry {\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\n\t\t\treturn { ...(links.candidateId === undefined ? {} : { candidateId: links.candidateId }) };\n\t\t} catch {\n\t\t\treturn {};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 判据 c：该版本当时验证的 source_links 仍有效（O12/E11 强化，与\n * activation.ts checkSourceLinksIntact 同口径）。\n *\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」。\n * candidateId 缺失（凭据无 candidateId）→ 跳过候选侧核对，返回 undefined（有效）。\n */\nfunction checkRestoreSourceLinksIntact(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tcandidateId: string | undefined,\n): string | undefined {\n\tif (candidateId === undefined) return undefined;\n\tconst cand = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, test_plan_id FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(candidateId) as\n\t\t| { candidate_id: string; problem_id: string; test_plan_id: string }\n\t\t| undefined;\n\tif (!cand) return `候选 ${candidateId} 已不存在（凭据指向的候选行丢失）`;\n\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id FROM evolution_validations\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(candidateId) as { validation_id: string } | undefined;\n\n\t// O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享。\n\treturn checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: cand.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: cand.test_plan_id, label: \"冻结计划\" },\n\t\t\t...(latestValidation === undefined\n\t\t\t\t? []\n\t\t\t\t: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\townerKind: \"validation\" as const,\n\t\t\t\t\t\t\townerId: latestValidation.validation_id,\n\t\t\t\t\t\t\tlabel: \"验证\",\n\t\t\t\t\t\t},\n\t\t\t\t\t]),\n\t\t],\n\t});\n}\n\n/**\n * 恢复历史版本为当前生效版（重新过发布判据）。\n *\n * 判据（全部满足才进事务）：\n * a. 资源已登记；expectedEffectiveVersion === 当前 effective_version（CAS）。\n * b. targetVersionId 对应版本目录完整（versionId 即清单哈希，重算指纹比对）；\n *    且该版本有未被「停用:」标记的 kind='publish' 凭据\n *    （曾失败/被回退标停用的版本拒绝直接恢复 → needs_reevaluation）。\n * c. 凭据指向候选的 source_links 仍有效（关联记忆未被删除）；依据失效 →\n *    needs_reevaluation。\n *\n * 事务内：UPDATE effective_version → targetVersionId + INSERT kind='restore'\n * activation（from=当前指向，to=targetVersionId）。\n */\nexport function restoreResourceVersion(\n\tstore: MemoryStore,\n\tinput: RestoreResourceVersionInput,\n): MemoryResult<RestoreResult | RestoreRejected> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst resource = getResourceRow(store, input.resourceId);\n\tif (!resource) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\n\t}\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason:\n\t\t\t\t`expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ` +\n\t\t\t\t`${resource.effective_version ?? \"（空）\"} 不一致`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tif (resource.effective_version === input.targetVersionId) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"conflict\",\n\t\t\treason: `目标版本 ${input.targetVersionId} 已是当前生效版，无需恢复`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 b：目录完整 + 有未停用 publish 凭据。\n\tconst versionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeId(input.resourceId),\n\t\tinput.targetVersionId,\n\t);\n\tif (!isVersionDirComplete(versionDir, input.targetVersionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本目录缺失或指纹不匹配:${versionDir}（versionId ${input.targetVersionId} 是内容` +\n\t\t\t\t`清单哈希，文件被删/改都会改变指纹；不完整版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\tconst cred = findUsablePublishCredential(store, input.resourceId, input.targetVersionId);\n\tif (cred === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason:\n\t\t\t\t`版本 ${input.targetVersionId} 无可用发布凭据（kind='publish' 行缺失或已被「停用:」` +\n\t\t\t\t`标记——曾失败/被回退的版本不能直接恢复，须重新评估）`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 判据 c：来源依据仍有效。\n\tconst sourceViolation = checkRestoreSourceLinksIntact(store, input.resourceId, cred.candidateId);\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"needs_reevaluation\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t\t...(resource.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { currentEffectiveVersion: resource.effective_version }),\n\t\t};\n\t}\n\n\t// 事务：UPDATE effective_version + INSERT kind='restore' activation。\n\t// 事务内重读 expectedEffectiveVersion（BEGIN IMMEDIATE 到写入前的竞态窗）。\n\treturn store.transaction(() => {\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\n\t\tif (inTx.effective_version !== input.expectedEffectiveVersion) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"conflict\",\n\t\t\t\treason:\n\t\t\t\t\t`恢复期间指向已由 ${input.expectedEffectiveVersion} 变为 ` +\n\t\t\t\t\t`${inTx.effective_version ?? \"（空）\"}，不覆盖`,\n\t\t\t\t...(inTx.effective_version === null\n\t\t\t\t\t? {}\n\t\t\t\t\t: { currentEffectiveVersion: inTx.effective_version }),\n\t\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t\t}\n\n\t\tconst activationId = `act-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'restore', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tactivationId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.expectedEffectiveVersion,\n\t\t\t\tinput.targetVersionId,\n\t\t\t\tinput.reason ?? `恢复历史版本 ${input.targetVersionId}`,\n\t\t\t\tJSON.stringify({ restoreFrom: input.expectedEffectiveVersion }),\n\t\t\t\tnow,\n\t\t\t);\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(input.targetVersionId, now, input.resourceId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\trestored: true,\n\t\t\tactivationId,\n\t\t\tversionId: input.targetVersionId,\n\t\t} as MemoryResult<RestoreResult | RestoreRejected>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listActivationHistory\n// ════════════════════════════════════════════════════════════════════════\n\ninterface HistoryRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\n/**\n * 版本时间线数据：该资源全部 activation（publish/restore/rollback）按时间正序。\n *\n * disabled 标记从 reason 前缀读；effective 标记只认 kind='publish' 且\n * `source_links_json.activation='effective'` 的凭据行（生效过的版本），\n * publish-落盘凭据与 restore/rollback 行 effective=false。\n */\nexport function listActivationHistory(\n\tstore: MemoryStore,\n\tresourceId: string,\n): MemoryResult<{ items: ActivationHistoryEntry[] }> {\n\tconst resource = getResource(store, resourceId);\n\tif (!resource.ok) return resource;\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as HistoryRow[];\n\treturn {\n\t\tok: true,\n\t\titems: rows.map((row) => {\n\t\t\tlet sourceLinks: Record<string, unknown> | undefined;\n\t\t\tlet effective = false;\n\t\t\tif (row.source_links_json !== null) {\n\t\t\t\ttry {\n\t\t\t\t\tsourceLinks = JSON.parse(row.source_links_json) as Record<string, unknown>;\n\t\t\t\t\teffective = row.kind === \"publish\" && sourceLinks[\"activation\"] === \"effective\";\n\t\t\t\t} catch {\n\t\t\t\t\t// 非 JSON 行当无 sourceLinks。\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tactivationId: row.activation_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\t...(row.from_version === null ? {} : { fromVersion: row.from_version }),\n\t\t\t\ttoVersion: row.to_version,\n\t\t\t\tkind: row.kind as ActivationHistoryEntry[\"kind\"],\n\t\t\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\t\t\t...(sourceLinks === undefined ? {} : { sourceLinks }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tdisabled: row.reason !== null && row.reason.startsWith(\"停用:\"),\n\t\t\t\teffective,\n\t\t\t};\n\t\t}),\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *import { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":26}},{"diffOp":{"equal":{"range":[57,149]}}},{"diffOp":{"delete":{"range":[149,176]}}},{"diffOp":{"delete":{"range":[176,177]}}},{"diffOp":{"equal":{"range":[177,232]}}},{"equalLines":{"line_count":542}},{"diffOp":{"equal":{"range":[232,238]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\evaluate.ts"},"span":[1807,1832],"sourceCode":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *\n * 职责：\n * - `evaluateCandidate`：同一 testPlan 分别绑定 baseline 和 candidate 运行结果，\n *   逐项比较预期行为、输出、退出码和受影响文件。\n * - 判定规则（S8 任务书 §5）：\n *   **原问题从失败到通过 + 关键正常用法及保留样例全部通过 + 范围检查通过 → `passed`**；\n *   启动失败/环境缺依赖/进程停止未确认 → `incomplete`（保留原因并停止发布）；\n *   业务结果不符 → `failed`。\n * - 候选定稿后才运行独立保留样例（reproduction+normal 在定稿前跑，\n *   holdout 在定稿后跑——由调用方传入的 caseResults 分组保证）。\n * - 模型随机性使同一用例前后结论矛盾时才补做该用例成对运行；\n *   证据仍不稳定则不宣称改善。\n * - 总分仅用于报告，不能覆盖关键失败；开发样例通过不直接标 passed。\n * - 完整费用归因到该候选（evolution_candidates.usage_refs_json 追加）；\n *   写 evolution_validations 行 + evolution_source_links（owner_kind='validation'）。\n * - 推进 candidate 状态机 proposed→testing→passed|failed|cancelled。\n *\n * 契约（S8-11）：\n * - `passed ≠ active`；不自动发布正式资源。\n * - 验证失败/取消/额度不足分别写状态，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\n\ttype ValidationPlan,\n\ttype ValidationRunResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `evaluateCandidate` 的输入：调用方已跑完 baseline/candidate 对照，逐项组装结果。 */\nexport interface EvaluateCandidateInput {\n\t/** 已生成候选 ID。 */\n\tcandidateId: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/**\n\t * PAO_HOME 根（O11/E06）：eval 读取 `<paoHome>/evolution/validations/\n\t * <testPlanId>/plan.json` 核对结果完整集合（plan 每个 caseId×side 都要有\n\t * 回执）。与 `plan` 互斥——注入其一即可。\n\t */\n\tpaoHome?: string;\n\t/** 直接注入计划对象（测试夹具可传；与 paoHome 互斥）。 */\n\tplan?: ValidationPlan;\n\t/** 逐项对照结果：reproduction + normal 在候选定稿前已跑完；holdout 在定稿后跑完。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 总费用/用量引用（候选生成+验证的全部 usageRefs 汇总）。 */\n\ttotalUsageRef?: string;\n\t/** 评估时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/**\n\t * 是否补做过成对运行（同 case 前后矛盾时由调用方重跑并替换旧结果）。\n\t * 补做后仍不稳定的用例在 verdict 标 incomplete 而非宣称改善。\n\t */\n\trepairedContradictions?: boolean;\n\t/** 来源引用（写入 evolution_source_links owner_kind='validation'）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `evaluateCandidate` 的输出。 */\nexport interface EvaluateCandidateResult {\n\t/** 验证记录 ID（evolution_validations.validation_id）。 */\n\tvalidationId: string;\n\t/** 总体判定。 */\n\tverdict: \"passed\" | \"failed\" | \"incomplete\";\n\t/** 逐项判定汇总（与输入 caseResults 一致）。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 各组通过率（报告用，不覆盖关键失败）。 */\n\tscore: {\n\t\treproduction: { passed: number; failed: number; incomplete: number; total: number };\n\t\tnormal: { passed: number; failed: number; incomplete: number; total: number };\n\t\tholdout: { passed: number; failed: number; incomplete: number; total: number };\n\t\t/** 总分：仅作报告摘要，不用于覆盖关键失败。 */\n\t\ttotal: { passed: number; failed: number; incomplete: number; total: number };\n\t};\n\t/** 完整验证记录。 */\n\tvalidation: EvolutionValidation;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 判定一个用例是否「关键失败」：reproduction 组失败 + normal/holdout 组任何非 passed。 */\nfunction isCriticalFailure(result: ValidationCaseResult): boolean {\n\tif (result.verdict === \"incomplete\") return true;\n\tif (result.verdict === \"failed\") {\n\t\t// reproduction 组失败永远是关键失败；normal/holdout 组失败也是关键失败。\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n/** 逐组统计通过率。 */\nfunction computeScore(caseResults: ValidationCaseResult[]): EvaluateCandidateResult[\"score\"] {\n\tconst group = (name: string) => {\n\t\tconst items = caseResults.filter((r) => r.caseId.startsWith(`${name}-`));\n\t\treturn {\n\t\t\tpassed: items.filter((r) => r.verdict === \"passed\").length,\n\t\t\tfailed: items.filter((r) => r.verdict === \"failed\").length,\n\t\t\tincomplete: items.filter((r) => r.verdict === \"incomplete\").length,\n\t\t\ttotal: items.length,\n\t\t};\n\t};\n\tconst reproduction = group(\"reproduction\");\n\tconst normal = group(\"normal\");\n\tconst holdout = group(\"holdout\");\n\tconst total = {\n\t\tpassed: reproduction.passed + normal.passed + holdout.passed,\n\t\tfailed: reproduction.failed + normal.failed + holdout.failed,\n\t\tincomplete: reproduction.incomplete + normal.incomplete + holdout.incomplete,\n\t\ttotal: reproduction.total + normal.total + holdout.total,\n\t};\n\treturn { reproduction, normal, holdout, total };\n}\n\n/**\n * 判断运行结果是否为「环境/启动失败」（O11/E07）：\n * 凭结构化 `executionFailure` 字段判定（start/timeout/cancel），不再靠\n * output/exitCode 启发式——启动失败/超时的进程也可能带 output 和 exitCode\n * （如 127/124），启发式会把启动故障误当业务失败或通过。\n * 环境失败标 incomplete，不画成业务失败或通过。\n */\nfunction isEnvironmentFailure(run: ValidationRunResult): boolean {\n\treturn run.executionFailure !== undefined;\n}\n\n/**\n * 读取冻结计划（O11/E06）：plan 对象优先，其次 `<paoHome>/evolution/\n * validations/<testPlanId>/plan.json`；都拿不到返回 undefined。\n */\nfunction readValidationPlan(input: EvaluateCandidateInput): ValidationPlan | undefined {\n\tif (input.plan !== undefined) return input.plan;\n\tif (input.paoHome === undefined) return undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, input.testPlanId, \"plan.json\");\n\tif (!existsSync(planPath)) return undefined;\n\ttry {\n\t\treturn JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/** plan 全部 caseId（三组展开）。 */\nfunction planCaseIds(plan: ValidationPlan): string[] {\n\treturn [...plan.reproduction, ...plan.normal, ...plan.holdout].map((c) => c.caseId);\n}\n\n/**\n * 解析 validation 的 sourceRefs（O12/E11）：显式传入优先；否则先取候选自身\n * links（O12 起 proposeCandidate 已从 problem 继承），候选无 links 时回退\n * problem 的 links（兼容 O12 之前生成的旧候选行）。\n */\nfunction resolveValidationSourceRefs(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): Array<{ sourceId: string; memoryId?: string; revision?: number }> {\n\tif (input.sourceRefs !== undefined) return input.sourceRefs;\n\tconst problemId = (\n\t\tstore.db\n\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { problem_id: string } | undefined\n\t)?.problem_id;\n\tconst readLinks = (ownerKind: string, ownerId: string) =>\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(ownerKind, ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\tlet rows = readLinks(\"candidate\", input.candidateId);\n\tif (rows.length === 0 && problemId !== undefined) rows = readLinks(\"problem\", problemId);\n\treturn rows.map((link) => ({\n\t\tsourceId: link.source_id,\n\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t}));\n}\n\n/**\n * O11/E06：完整集合不齐时收尾——写一条 verdict=incomplete 的验证记录，\n * 逐项 caseResults 原样落库，候选状态推 cancelled，返回 incomplete。\n * 不抛错（这是业务结论「验收不完整」，不是系统故障）。\n */\nfunction completeWithIncompleteVerdict(\n\tstore: MemoryStore,\n\tover: {\n\t\tcandidateId: string;\n\t\ttestPlanId: string;\n\t\tcandidateRow: { problem_id: string; resource_id: string; base_version: string; usage_refs_json: string };\n\t\tcurrentStatus: string;\n\t\tcaseResults: ValidationCaseResult[];\n\t\treason: string;\n\t\ttotalUsageRef?: string;\n\t\tsourceRefs: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n\t\tnow: string;\n\t},\n): MemoryResult<EvaluateCandidateResult> {\n\tconst validationId = `val-${randomUUID()}`;\n\tconst normalized = over.caseResults.map((r) => ({\n\t\t...r,\n\t\tverdict: \"incomplete\" as const,\n\t\treason: r.reason ?? `回执不完整:${over.reason}`,\n\t}));\n\tconst score = computeScore(normalized);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: over.testPlanId,\n\t\tcandidateId: over.candidateId,\n\t\tproblemId: over.candidateRow.problem_id,\n\t\tresourceId: over.candidateRow.resource_id,\n\t\tbaseVersion: over.candidateRow.base_version,\n\t\tcaseResults: normalized,\n\t\tverdict: \"incomplete\",\n\t\t...(over.totalUsageRef === undefined ? {} : { totalUsageRef: over.totalUsageRef }),\n\t\tcreatedAt: over.now,\n\t\tupdatedAt: over.now,\n\t};\n\tconst candidateUsageRefs = JSON.parse(over.candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs =\n\t\tover.totalUsageRef !== undefined ? [...new Set([...candidateUsageRefs, over.totalUsageRef])] : candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tover.testPlanId,\n\t\t\t\tover.candidateId,\n\t\t\t\tover.candidateRow.problem_id,\n\t\t\t\tover.candidateRow.resource_id,\n\t\t\t\tover.candidateRow.base_version,\n\t\t\t\tJSON.stringify(normalized),\n\t\t\t\t\"incomplete\",\n\t\t\t\tover.totalUsageRef ?? null,\n\t\t\t\tover.now,\n\t\t\t\tover.now,\n\t\t\t);\n\t\tfor (const ref of over.sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tover.now,\n\t\t\t\t);\n\t\t}\n\t\tif (over.currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(over.now, over.candidateId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = 'cancelled', failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(`验证未完成:${over.reason}`, JSON.stringify(nextUsageRefs), over.now, over.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict: \"incomplete\",\n\t\tcaseResults: normalized,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 逐项评估候选：原问题改善且关键正常/保留样例通过才 passed。\n *\n * 判定：\n * - 任一 incomplete → 总体 incomplete（保留原因并停止发布）。\n * - reproduction 组未全部从失败到通过 → failed（即使总分提高也不宣称改善）。\n * - normal/holdout 组任一失败 → failed（关键用法退步）。\n * - reproduction+normal+holdout 全部通过 + 范围检查通过 → passed。\n *\n * 开发样例通过不直接标 passed（开发样例是 devCases，不是验收样例）。\n */\nexport function evaluateCandidate(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): MemoryResult<EvaluateCandidateResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst validationId = `val-${randomUUID()}`;\n\n\t// 1. 校验 candidate：必须存在且状态允许进入 testing。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, usage_refs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tusage_refs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.test_plan_id !== input.testPlanId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 登记的 testPlanId 与输入不一致`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst currentStatus = candidateRow.status as import(\"./types.ts\").EvolutionCandidateStatus;\n\tif (!isCandidateTransitionAllowed(currentStatus, \"testing\")) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 状态 ${currentStatus} 不允许进入 testing`,\n\t\t\tinput.candidateId,\n\t\t);\n\t}\n\n\t// 1b. O11/E06：核对冻结计划完整集合——plan 每个 caseId×side 都要有回执。\n\t// 空集、缺项、未知/重复 caseId 一律不接受（标 incomplete 不落 passed）。\n\tif (input.caseResults.length === 0) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`caseResults 为空集——空验收不允许 passed（E06：plan 每个 caseId 双侧回执必须齐全）`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst plan = readValidationPlan(input);\n\tconst completenessViolations: string[] = [];\n\tif (plan === undefined) {\n\t\tcompletenessViolations.push(\n\t\t\t`未提供 plan（注入 paoHome 或 plan 对象）且读不到 plan.json，无法核对完整集合`,\n\t\t);\n\t} else {\n\t\tconst expectedIds = planCaseIds(plan);\n\t\tconst seen = new Map<string, number>();\n\t\tfor (const r of input.caseResults) {\n\t\t\tseen.set(r.caseId, (seen.get(r.caseId) ?? 0) + 1);\n\t\t\tif (!expectedIds.includes(r.caseId)) {\n\t\t\t\tcompletenessViolations.push(`未知 caseId:${r.caseId}（不在冻结计划内）`);\n\t\t\t}\n\t\t}\n\t\tfor (const [caseId, count] of seen) {\n\t\t\tif (count > 1) completenessViolations.push(`重复 caseId:${caseId}（出现 ${count} 次）`);\n\t\t}\n\t\tfor (const caseId of expectedIds) {\n\t\t\tif (!seen.has(caseId)) completenessViolations.push(`缺 caseId:${caseId} 的回执（漏跑/未交付）`);\n\t\t}\n\t}\n\tif (completenessViolations.length > 0) {\n\t\t// 完整集合不齐 → 不落 passed：写一条 incomplete 验证记录并把候选标 cancelled。\n\t\treturn completeWithIncompleteVerdict(store, {\n\t\t\tcandidateId: input.candidateId,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tcandidateRow,\n\t\t\tcurrentStatus,\n\t\t\tcaseResults: input.caseResults,\n\t\t\treason: completenessViolations.join(\"；\"),\n\t\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\t\tsourceRefs: resolveValidationSourceRefs(store, input),\n\t\t\tnow,\n\t\t});\n\t}\n\n\t// 2. 逐项判定：环境失败标 incomplete；reproduction 组必须「失败→通过」才算改善。\n\t//    逐项 verdict 已由调用方给定（调用方跑完 baseline/candidate 后组装），\n\t//    这里核对每个 case 的判定一致性：若某项 baseline 也 passed，\n\t//    reproduction 组不能宣称「修复了原问题」。\n\tconst normalizedCaseResults: ValidationCaseResult[] = input.caseResults.map((result) => {\n\t\t// 环境失败统一标 incomplete（不画成业务失败或通过）。\n\t\tif (isEnvironmentFailure(result.baseline) || isEnvironmentFailure(result.candidate)) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\treason: result.reason ?? `环境/启动失败:${result.baseline.failureReason ?? result.candidate.failureReason ?? \"进程停止未确认\"}`,\n\t\t\t};\n\t\t}\n\t\t// 调用方已标 incomplete（不稳定/无法定论，如补做成对运行后仍矛盾）\n\t\t// 不升级为 failed——incomplete 是「证据不足」结论，不是「候选未过」；\n\t\t// 本层只对「调用方没下结论或结论与双侧结果矛盾」的项做判定。\n\t\tif (result.verdict === \"incomplete\") {\n\t\t\treturn { ...result, verdict: \"incomplete\" as const };\n\t\t}\n\t\t// reproduction 组：baseline 必须先真失败，candidate 后通过才算修复。\n\t\tif (result.caseId.startsWith(\"reproduction-\")) {\n\t\t\tif (result.baseline.passed === true) {\n\t\t\t\t// baseline 未失败——复现不了原问题，验证前提不成立，标 incomplete 而非宣称改善。\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\t\treason: result.reason ?? \"baseline 未复现原问题（baseline.passed=true），验证前提不成立\",\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (result.candidate.passed !== true) {\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\t\treason: result.reason ?? \"原问题未修复：候选未通过复现样例\",\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn { ...result, verdict: \"passed\" as const };\n\t\t}\n\t\t// normal / holdout 组：candidate 未通过即关键失败。\n\t\tif (result.candidate.passed !== true) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\treason: result.reason ?? `候选未通过${result.caseId.startsWith(\"normal-\") ? \"正常用法\" : \"保留\"}样例`,\n\t\t\t};\n\t\t}\n\t\treturn { ...result, verdict: \"passed\" as const };\n\t});\n\n\t// 3. 总体判定：任一 incomplete → incomplete；任一关键失败 → failed；全过 → passed。\n\tconst hasIncomplete = normalizedCaseResults.some((r) => r.verdict === \"incomplete\");\n\tconst hasFailed = normalizedCaseResults.some((r) => r.verdict === \"failed\");\n\tlet verdict: EvolutionValidation[\"verdict\"];\n\tif (hasIncomplete) {\n\t\tverdict = \"incomplete\";\n\t} else if (hasFailed) {\n\t\tverdict = \"failed\";\n\t} else {\n\t\tverdict = \"passed\";\n\t}\n\n\t// 补做成对运行后仍不稳定（有 incomplete）→ 不宣称改善，保留 incomplete 结论。\n\t// 调用方传入 repairedContradictions=true 时，若结果仍含 incomplete，\n\t// 说明证据不稳定，verdict 保持 incomplete（已由上面逻辑覆盖）。\n\n\tconst score = computeScore(normalizedCaseResults);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: input.testPlanId,\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\tcaseResults: normalizedCaseResults,\n\t\tverdict,\n\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\n\t// 4. 写库：evolution_validations 行 + evolution_source_links + 候选状态推进。\n\t//    完整费用归因到该候选（usage_refs_json 追加）。\n\tconst sourceRefs = resolveValidationSourceRefs(store, input);\n\tconst candidateUsageRefs = JSON.parse(candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs = input.totalUsageRef !== undefined\n\t\t? [...new Set([...candidateUsageRefs, input.totalUsageRef])]\n\t\t: candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\t// evolution_validations 行：候选 ID 此时已存在（外键满足）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tinput.candidateId,\n\t\t\t\tcandidateRow.problem_id,\n\t\t\t\tcandidateRow.resource_id,\n\t\t\t\tcandidateRow.base_version,\n\t\t\t\tJSON.stringify(normalizedCaseResults),\n\t\t\t\tverdict,\n\t\t\t\tinput.totalUsageRef ?? null,\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 来源关联：evolution_source_links owner_kind='validation'。\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\n\t\t// 候选状态推进：proposed → testing → passed | failed | cancelled。\n\t\t// 先推到 testing（若尚未在 testing），再推到终态。\n\t\tif (currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(now, input.candidateId);\n\t\t}\n\t\tconst nextCandidateStatus =\n\t\t\tverdict === \"passed\" ? \"passed\" : verdict === \"failed\" ? \"failed\" : \"cancelled\";\n\t\t// 状态机校验：testing → passed|failed|cancelled 全部合法。\n\t\tconst statusBeforeUpdate = currentStatus === \"proposed\" ? \"testing\" : currentStatus;\n\t\tif (!isCandidateTransitionAllowed(statusBeforeUpdate, nextCandidateStatus)) {\n\t\t\tthrow new Error(\n\t\t\t\t`候选 ${input.candidateId} 状态机不允许 ${statusBeforeUpdate} → ${nextCandidateStatus}`,\n\t\t\t);\n\t\t}\n\t\tconst failureReason =\n\t\t\tverdict === \"incomplete\"\n\t\t\t\t? `验证未完成:${normalizedCaseResults.find((r) => r.verdict === \"incomplete\")?.reason ?? \"环境/启动失败\"}`\n\t\t\t\t: verdict === \"failed\"\n\t\t\t\t\t? `验证失败:${normalizedCaseResults.find((r) => r.verdict === \"failed\")?.reason ?? \"业务结果不符\"}`\n\t\t\t\t\t: null;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = ?, failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(nextCandidateStatus, failureReason, JSON.stringify(nextUsageRefs), now, input.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict,\n\t\tcaseResults: normalizedCaseResults,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function isCriticalFailure is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"isCriticalFailure"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"isCriticalFailure"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *\n/** 判定一个用例是否「关键失败」：reproduction 组失败 + normal/holdout 组任何非 passed。 */\nfunction isCriticalFailure_isCriticalFailure(result: ValidationCaseResult): boolean {\n\tif (result.verdict === \"incomplete\") return true;\n\tif (result.verdict === \"failed\") {\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":96}},{"diffOp":{"equal":{"range":[57,182]}}},{"diffOp":{"delete":{"range":[182,199]}}},{"diffOp":{"insert":{"range":[199,217]}}},{"diffOp":{"equal":{"range":[217,345]}}},{"equalLines":{"line_count":473}},{"diffOp":{"equal":{"range":[345,351]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\evaluate.ts"},"span":[5444,5461],"sourceCode":"/**\n * 受控自进化逐项评估决策（S8-10）。\n *\n * 职责：\n * - `evaluateCandidate`：同一 testPlan 分别绑定 baseline 和 candidate 运行结果，\n *   逐项比较预期行为、输出、退出码和受影响文件。\n * - 判定规则（S8 任务书 §5）：\n *   **原问题从失败到通过 + 关键正常用法及保留样例全部通过 + 范围检查通过 → `passed`**；\n *   启动失败/环境缺依赖/进程停止未确认 → `incomplete`（保留原因并停止发布）；\n *   业务结果不符 → `failed`。\n * - 候选定稿后才运行独立保留样例（reproduction+normal 在定稿前跑，\n *   holdout 在定稿后跑——由调用方传入的 caseResults 分组保证）。\n * - 模型随机性使同一用例前后结论矛盾时才补做该用例成对运行；\n *   证据仍不稳定则不宣称改善。\n * - 总分仅用于报告，不能覆盖关键失败；开发样例通过不直接标 passed。\n * - 完整费用归因到该候选（evolution_candidates.usage_refs_json 追加）；\n *   写 evolution_validations 行 + evolution_source_links（owner_kind='validation'）。\n * - 推进 candidate 状态机 proposed→testing→passed|failed|cancelled。\n *\n * 契约（S8-11）：\n * - `passed ≠ active`；不自动发布正式资源。\n * - 验证失败/取消/额度不足分别写状态，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCaseVerdict,\n\ttype EvolutionValidation,\n\ttype ValidationCaseResult,\n\ttype ValidationPlan,\n\ttype ValidationRunResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `evaluateCandidate` 的输入：调用方已跑完 baseline/candidate 对照，逐项组装结果。 */\nexport interface EvaluateCandidateInput {\n\t/** 已生成候选 ID。 */\n\tcandidateId: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/**\n\t * PAO_HOME 根（O11/E06）：eval 读取 `<paoHome>/evolution/validations/\n\t * <testPlanId>/plan.json` 核对结果完整集合（plan 每个 caseId×side 都要有\n\t * 回执）。与 `plan` 互斥——注入其一即可。\n\t */\n\tpaoHome?: string;\n\t/** 直接注入计划对象（测试夹具可传；与 paoHome 互斥）。 */\n\tplan?: ValidationPlan;\n\t/** 逐项对照结果：reproduction + normal 在候选定稿前已跑完；holdout 在定稿后跑完。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 总费用/用量引用（候选生成+验证的全部 usageRefs 汇总）。 */\n\ttotalUsageRef?: string;\n\t/** 评估时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/**\n\t * 是否补做过成对运行（同 case 前后矛盾时由调用方重跑并替换旧结果）。\n\t * 补做后仍不稳定的用例在 verdict 标 incomplete 而非宣称改善。\n\t */\n\trepairedContradictions?: boolean;\n\t/** 来源引用（写入 evolution_source_links owner_kind='validation'）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `evaluateCandidate` 的输出。 */\nexport interface EvaluateCandidateResult {\n\t/** 验证记录 ID（evolution_validations.validation_id）。 */\n\tvalidationId: string;\n\t/** 总体判定。 */\n\tverdict: \"passed\" | \"failed\" | \"incomplete\";\n\t/** 逐项判定汇总（与输入 caseResults 一致）。 */\n\tcaseResults: ValidationCaseResult[];\n\t/** 各组通过率（报告用，不覆盖关键失败）。 */\n\tscore: {\n\t\treproduction: { passed: number; failed: number; incomplete: number; total: number };\n\t\tnormal: { passed: number; failed: number; incomplete: number; total: number };\n\t\tholdout: { passed: number; failed: number; incomplete: number; total: number };\n\t\t/** 总分：仅作报告摘要，不用于覆盖关键失败。 */\n\t\ttotal: { passed: number; failed: number; incomplete: number; total: number };\n\t};\n\t/** 完整验证记录。 */\n\tvalidation: EvolutionValidation;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 判定一个用例是否「关键失败」：reproduction 组失败 + normal/holdout 组任何非 passed。 */\nfunction isCriticalFailure(result: ValidationCaseResult): boolean {\n\tif (result.verdict === \"incomplete\") return true;\n\tif (result.verdict === \"failed\") {\n\t\t// reproduction 组失败永远是关键失败；normal/holdout 组失败也是关键失败。\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n/** 逐组统计通过率。 */\nfunction computeScore(caseResults: ValidationCaseResult[]): EvaluateCandidateResult[\"score\"] {\n\tconst group = (name: string) => {\n\t\tconst items = caseResults.filter((r) => r.caseId.startsWith(`${name}-`));\n\t\treturn {\n\t\t\tpassed: items.filter((r) => r.verdict === \"passed\").length,\n\t\t\tfailed: items.filter((r) => r.verdict === \"failed\").length,\n\t\t\tincomplete: items.filter((r) => r.verdict === \"incomplete\").length,\n\t\t\ttotal: items.length,\n\t\t};\n\t};\n\tconst reproduction = group(\"reproduction\");\n\tconst normal = group(\"normal\");\n\tconst holdout = group(\"holdout\");\n\tconst total = {\n\t\tpassed: reproduction.passed + normal.passed + holdout.passed,\n\t\tfailed: reproduction.failed + normal.failed + holdout.failed,\n\t\tincomplete: reproduction.incomplete + normal.incomplete + holdout.incomplete,\n\t\ttotal: reproduction.total + normal.total + holdout.total,\n\t};\n\treturn { reproduction, normal, holdout, total };\n}\n\n/**\n * 判断运行结果是否为「环境/启动失败」（O11/E07）：\n * 凭结构化 `executionFailure` 字段判定（start/timeout/cancel），不再靠\n * output/exitCode 启发式——启动失败/超时的进程也可能带 output 和 exitCode\n * （如 127/124），启发式会把启动故障误当业务失败或通过。\n * 环境失败标 incomplete，不画成业务失败或通过。\n */\nfunction isEnvironmentFailure(run: ValidationRunResult): boolean {\n\treturn run.executionFailure !== undefined;\n}\n\n/**\n * 读取冻结计划（O11/E06）：plan 对象优先，其次 `<paoHome>/evolution/\n * validations/<testPlanId>/plan.json`；都拿不到返回 undefined。\n */\nfunction readValidationPlan(input: EvaluateCandidateInput): ValidationPlan | undefined {\n\tif (input.plan !== undefined) return input.plan;\n\tif (input.paoHome === undefined) return undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, input.testPlanId, \"plan.json\");\n\tif (!existsSync(planPath)) return undefined;\n\ttry {\n\t\treturn JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/** plan 全部 caseId（三组展开）。 */\nfunction planCaseIds(plan: ValidationPlan): string[] {\n\treturn [...plan.reproduction, ...plan.normal, ...plan.holdout].map((c) => c.caseId);\n}\n\n/**\n * 解析 validation 的 sourceRefs（O12/E11）：显式传入优先；否则先取候选自身\n * links（O12 起 proposeCandidate 已从 problem 继承），候选无 links 时回退\n * problem 的 links（兼容 O12 之前生成的旧候选行）。\n */\nfunction resolveValidationSourceRefs(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): Array<{ sourceId: string; memoryId?: string; revision?: number }> {\n\tif (input.sourceRefs !== undefined) return input.sourceRefs;\n\tconst problemId = (\n\t\tstore.db\n\t\t\t.prepare(`SELECT problem_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { problem_id: string } | undefined\n\t)?.problem_id;\n\tconst readLinks = (ownerKind: string, ownerId: string) =>\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(ownerKind, ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\tlet rows = readLinks(\"candidate\", input.candidateId);\n\tif (rows.length === 0 && problemId !== undefined) rows = readLinks(\"problem\", problemId);\n\treturn rows.map((link) => ({\n\t\tsourceId: link.source_id,\n\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t}));\n}\n\n/**\n * O11/E06：完整集合不齐时收尾——写一条 verdict=incomplete 的验证记录，\n * 逐项 caseResults 原样落库，候选状态推 cancelled，返回 incomplete。\n * 不抛错（这是业务结论「验收不完整」，不是系统故障）。\n */\nfunction completeWithIncompleteVerdict(\n\tstore: MemoryStore,\n\tover: {\n\t\tcandidateId: string;\n\t\ttestPlanId: string;\n\t\tcandidateRow: { problem_id: string; resource_id: string; base_version: string; usage_refs_json: string };\n\t\tcurrentStatus: string;\n\t\tcaseResults: ValidationCaseResult[];\n\t\treason: string;\n\t\ttotalUsageRef?: string;\n\t\tsourceRefs: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n\t\tnow: string;\n\t},\n): MemoryResult<EvaluateCandidateResult> {\n\tconst validationId = `val-${randomUUID()}`;\n\tconst normalized = over.caseResults.map((r) => ({\n\t\t...r,\n\t\tverdict: \"incomplete\" as const,\n\t\treason: r.reason ?? `回执不完整:${over.reason}`,\n\t}));\n\tconst score = computeScore(normalized);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: over.testPlanId,\n\t\tcandidateId: over.candidateId,\n\t\tproblemId: over.candidateRow.problem_id,\n\t\tresourceId: over.candidateRow.resource_id,\n\t\tbaseVersion: over.candidateRow.base_version,\n\t\tcaseResults: normalized,\n\t\tverdict: \"incomplete\",\n\t\t...(over.totalUsageRef === undefined ? {} : { totalUsageRef: over.totalUsageRef }),\n\t\tcreatedAt: over.now,\n\t\tupdatedAt: over.now,\n\t};\n\tconst candidateUsageRefs = JSON.parse(over.candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs =\n\t\tover.totalUsageRef !== undefined ? [...new Set([...candidateUsageRefs, over.totalUsageRef])] : candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tover.testPlanId,\n\t\t\t\tover.candidateId,\n\t\t\t\tover.candidateRow.problem_id,\n\t\t\t\tover.candidateRow.resource_id,\n\t\t\t\tover.candidateRow.base_version,\n\t\t\t\tJSON.stringify(normalized),\n\t\t\t\t\"incomplete\",\n\t\t\t\tover.totalUsageRef ?? null,\n\t\t\t\tover.now,\n\t\t\t\tover.now,\n\t\t\t);\n\t\tfor (const ref of over.sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tover.now,\n\t\t\t\t);\n\t\t}\n\t\tif (over.currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(over.now, over.candidateId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = 'cancelled', failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(`验证未完成:${over.reason}`, JSON.stringify(nextUsageRefs), over.now, over.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict: \"incomplete\",\n\t\tcaseResults: normalized,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 逐项评估候选：原问题改善且关键正常/保留样例通过才 passed。\n *\n * 判定：\n * - 任一 incomplete → 总体 incomplete（保留原因并停止发布）。\n * - reproduction 组未全部从失败到通过 → failed（即使总分提高也不宣称改善）。\n * - normal/holdout 组任一失败 → failed（关键用法退步）。\n * - reproduction+normal+holdout 全部通过 + 范围检查通过 → passed。\n *\n * 开发样例通过不直接标 passed（开发样例是 devCases，不是验收样例）。\n */\nexport function evaluateCandidate(\n\tstore: MemoryStore,\n\tinput: EvaluateCandidateInput,\n): MemoryResult<EvaluateCandidateResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst validationId = `val-${randomUUID()}`;\n\n\t// 1. 校验 candidate：必须存在且状态允许进入 testing。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, usage_refs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tusage_refs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.test_plan_id !== input.testPlanId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 登记的 testPlanId 与输入不一致`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst currentStatus = candidateRow.status as import(\"./types.ts\").EvolutionCandidateStatus;\n\tif (!isCandidateTransitionAllowed(currentStatus, \"testing\")) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`候选 ${input.candidateId} 状态 ${currentStatus} 不允许进入 testing`,\n\t\t\tinput.candidateId,\n\t\t);\n\t}\n\n\t// 1b. O11/E06：核对冻结计划完整集合——plan 每个 caseId×side 都要有回执。\n\t// 空集、缺项、未知/重复 caseId 一律不接受（标 incomplete 不落 passed）。\n\tif (input.caseResults.length === 0) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`caseResults 为空集——空验收不允许 passed（E06：plan 每个 caseId 双侧回执必须齐全）`,\n\t\t\tinput.testPlanId,\n\t\t);\n\t}\n\tconst plan = readValidationPlan(input);\n\tconst completenessViolations: string[] = [];\n\tif (plan === undefined) {\n\t\tcompletenessViolations.push(\n\t\t\t`未提供 plan（注入 paoHome 或 plan 对象）且读不到 plan.json，无法核对完整集合`,\n\t\t);\n\t} else {\n\t\tconst expectedIds = planCaseIds(plan);\n\t\tconst seen = new Map<string, number>();\n\t\tfor (const r of input.caseResults) {\n\t\t\tseen.set(r.caseId, (seen.get(r.caseId) ?? 0) + 1);\n\t\t\tif (!expectedIds.includes(r.caseId)) {\n\t\t\t\tcompletenessViolations.push(`未知 caseId:${r.caseId}（不在冻结计划内）`);\n\t\t\t}\n\t\t}\n\t\tfor (const [caseId, count] of seen) {\n\t\t\tif (count > 1) completenessViolations.push(`重复 caseId:${caseId}（出现 ${count} 次）`);\n\t\t}\n\t\tfor (const caseId of expectedIds) {\n\t\t\tif (!seen.has(caseId)) completenessViolations.push(`缺 caseId:${caseId} 的回执（漏跑/未交付）`);\n\t\t}\n\t}\n\tif (completenessViolations.length > 0) {\n\t\t// 完整集合不齐 → 不落 passed：写一条 incomplete 验证记录并把候选标 cancelled。\n\t\treturn completeWithIncompleteVerdict(store, {\n\t\t\tcandidateId: input.candidateId,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tcandidateRow,\n\t\t\tcurrentStatus,\n\t\t\tcaseResults: input.caseResults,\n\t\t\treason: completenessViolations.join(\"；\"),\n\t\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\t\tsourceRefs: resolveValidationSourceRefs(store, input),\n\t\t\tnow,\n\t\t});\n\t}\n\n\t// 2. 逐项判定：环境失败标 incomplete；reproduction 组必须「失败→通过」才算改善。\n\t//    逐项 verdict 已由调用方给定（调用方跑完 baseline/candidate 后组装），\n\t//    这里核对每个 case 的判定一致性：若某项 baseline 也 passed，\n\t//    reproduction 组不能宣称「修复了原问题」。\n\tconst normalizedCaseResults: ValidationCaseResult[] = input.caseResults.map((result) => {\n\t\t// 环境失败统一标 incomplete（不画成业务失败或通过）。\n\t\tif (isEnvironmentFailure(result.baseline) || isEnvironmentFailure(result.candidate)) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\treason: result.reason ?? `环境/启动失败:${result.baseline.failureReason ?? result.candidate.failureReason ?? \"进程停止未确认\"}`,\n\t\t\t};\n\t\t}\n\t\t// 调用方已标 incomplete（不稳定/无法定论，如补做成对运行后仍矛盾）\n\t\t// 不升级为 failed——incomplete 是「证据不足」结论，不是「候选未过」；\n\t\t// 本层只对「调用方没下结论或结论与双侧结果矛盾」的项做判定。\n\t\tif (result.verdict === \"incomplete\") {\n\t\t\treturn { ...result, verdict: \"incomplete\" as const };\n\t\t}\n\t\t// reproduction 组：baseline 必须先真失败，candidate 后通过才算修复。\n\t\tif (result.caseId.startsWith(\"reproduction-\")) {\n\t\t\tif (result.baseline.passed === true) {\n\t\t\t\t// baseline 未失败——复现不了原问题，验证前提不成立，标 incomplete 而非宣称改善。\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"incomplete\" as const,\n\t\t\t\t\treason: result.reason ?? \"baseline 未复现原问题（baseline.passed=true），验证前提不成立\",\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (result.candidate.passed !== true) {\n\t\t\t\treturn {\n\t\t\t\t\t...result,\n\t\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\t\treason: result.reason ?? \"原问题未修复：候选未通过复现样例\",\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn { ...result, verdict: \"passed\" as const };\n\t\t}\n\t\t// normal / holdout 组：candidate 未通过即关键失败。\n\t\tif (result.candidate.passed !== true) {\n\t\t\treturn {\n\t\t\t\t...result,\n\t\t\t\tverdict: \"failed\" as const,\n\t\t\t\treason: result.reason ?? `候选未通过${result.caseId.startsWith(\"normal-\") ? \"正常用法\" : \"保留\"}样例`,\n\t\t\t};\n\t\t}\n\t\treturn { ...result, verdict: \"passed\" as const };\n\t});\n\n\t// 3. 总体判定：任一 incomplete → incomplete；任一关键失败 → failed；全过 → passed。\n\tconst hasIncomplete = normalizedCaseResults.some((r) => r.verdict === \"incomplete\");\n\tconst hasFailed = normalizedCaseResults.some((r) => r.verdict === \"failed\");\n\tlet verdict: EvolutionValidation[\"verdict\"];\n\tif (hasIncomplete) {\n\t\tverdict = \"incomplete\";\n\t} else if (hasFailed) {\n\t\tverdict = \"failed\";\n\t} else {\n\t\tverdict = \"passed\";\n\t}\n\n\t// 补做成对运行后仍不稳定（有 incomplete）→ 不宣称改善，保留 incomplete 结论。\n\t// 调用方传入 repairedContradictions=true 时，若结果仍含 incomplete，\n\t// 说明证据不稳定，verdict 保持 incomplete（已由上面逻辑覆盖）。\n\n\tconst score = computeScore(normalizedCaseResults);\n\tconst validation: EvolutionValidation = {\n\t\tvalidationId,\n\t\ttestPlanId: input.testPlanId,\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\tcaseResults: normalizedCaseResults,\n\t\tverdict,\n\t\t...(input.totalUsageRef === undefined ? {} : { totalUsageRef: input.totalUsageRef }),\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\n\t// 4. 写库：evolution_validations 行 + evolution_source_links + 候选状态推进。\n\t//    完整费用归因到该候选（usage_refs_json 追加）。\n\tconst sourceRefs = resolveValidationSourceRefs(store, input);\n\tconst candidateUsageRefs = JSON.parse(candidateRow.usage_refs_json) as string[];\n\tconst nextUsageRefs = input.totalUsageRef !== undefined\n\t\t? [...new Set([...candidateUsageRefs, input.totalUsageRef])]\n\t\t: candidateUsageRefs;\n\n\tstore.transaction(() => {\n\t\t// evolution_validations 行：候选 ID 此时已存在（外键满足）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tvalidationId,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tinput.candidateId,\n\t\t\t\tcandidateRow.problem_id,\n\t\t\t\tcandidateRow.resource_id,\n\t\t\t\tcandidateRow.base_version,\n\t\t\t\tJSON.stringify(normalizedCaseResults),\n\t\t\t\tverdict,\n\t\t\t\tinput.totalUsageRef ?? null,\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 来源关联：evolution_source_links owner_kind='validation'。\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${validationId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\tvalidationId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\n\t\t// 候选状态推进：proposed → testing → passed | failed | cancelled。\n\t\t// 先推到 testing（若尚未在 testing），再推到终态。\n\t\tif (currentStatus === \"proposed\") {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_candidates SET status = 'testing', updated_at = ? WHERE candidate_id = ?`)\n\t\t\t\t.run(now, input.candidateId);\n\t\t}\n\t\tconst nextCandidateStatus =\n\t\t\tverdict === \"passed\" ? \"passed\" : verdict === \"failed\" ? \"failed\" : \"cancelled\";\n\t\t// 状态机校验：testing → passed|failed|cancelled 全部合法。\n\t\tconst statusBeforeUpdate = currentStatus === \"proposed\" ? \"testing\" : currentStatus;\n\t\tif (!isCandidateTransitionAllowed(statusBeforeUpdate, nextCandidateStatus)) {\n\t\t\tthrow new Error(\n\t\t\t\t`候选 ${input.candidateId} 状态机不允许 ${statusBeforeUpdate} → ${nextCandidateStatus}`,\n\t\t\t);\n\t\t}\n\t\tconst failureReason =\n\t\t\tverdict === \"incomplete\"\n\t\t\t\t? `验证未完成:${normalizedCaseResults.find((r) => r.verdict === \"incomplete\")?.reason ?? \"环境/启动失败\"}`\n\t\t\t\t: verdict === \"failed\"\n\t\t\t\t\t? `验证失败:${normalizedCaseResults.find((r) => r.verdict === \"failed\")?.reason ?? \"业务结果不符\"}`\n\t\t\t\t\t: null;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t SET status = ?, failure_reason = ?, usage_refs_json = ?, updated_at = ?\n\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t)\n\t\t\t.run(nextCandidateStatus, failureReason, JSON.stringify(nextUsageRefs), now, input.candidateId);\n\t});\n\n\treturn {\n\t\tok: true,\n\t\tvalidationId,\n\t\tverdict,\n\t\tcaseResults: normalizedCaseResults,\n\t\tscore,\n\t\tvalidation,\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *import type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCandidateStatus,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,76]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[76,252]}}},{"diffOp":{"delete":{"range":[252,345]}}},{"diffOp":{"equal":{"range":[345,566]}}},{"equalLines":{"line_count":758}},{"diffOp":{"equal":{"range":[566,660]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\observe.ts"},"span":[1587,1653],"sourceCode":"/**\n * 受控自进化观察骨架与来源/旧候选处理（S8-11）。\n *\n * 职责：\n * - **来源删除处理**：沿 `evolution_source_links` 清除候选输入/回执里的目标正文；\n *   清理未完成保持未完成状态，只保留排除所需定位。\n * - **依据失效/基础版本过期处理**：纠正、停用或 baseVersion 变动导致依据失效时标待重评估；\n *   **旧候选不得直接重新排发布**。\n * - **观察骨架**：viewed/used/patched 三态计数与关联（S9-06 才接 taskBinding，\n *   本阶段先落数据结构与只读计数入口）。\n * - **验证失败/取消/额度不足分别写状态**，保留原有效版本；\n *   同一候选重试沿现有上限，新改动才生成新候选。\n *\n * 契约（S8 任务书 §5 / 计划 §S8-11）：\n * - 清理未完成保持未完成状态，只保留排除所需定位（sourceId/候选 ID/版本号）。\n * - 旧候选不绕过删除及纠正语义重新入库；依据失效的旧候选不重新排发布。\n * - 来源删除时沿关联清除候选输入中的目标正文（evidenceRefs、devCases 引用）。\n * - `passed ≠ active`；本阶段不自动发布正式资源。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tisCandidateTransitionAllowed,\n\ttype EvolutionCandidateStatus,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 0. outcome 编码约定（S9-06）\n// ════════════════════════════════════════════════════════════════════════\n//\n// `evolution_observations` 表无 outcome 列；`recordUsed` 的成败编进\n// `receipt_ref` 前缀：`<outcome>:<回执引用>`（outcome ∈ success|failure）。\n// 选前缀而不加列：CREATE TABLE IF NOT EXISTS 不能给已有库追加列，加列要另走\n// ALTER 迁移；当前 outcome 只被 countUsageByVersion 读，前缀方案改动最小。\n// 无 outcome 的 used 行（receipt_ref 无前缀或为空）不计入 success/failure。\nconst OUTCOME_PREFIXES = [\"success\", \"failure\"] as const;\ntype UsedOutcome = (typeof OUTCOME_PREFIXES)[number];\n\n/** 把 outcome 编进 receipt_ref；无 outcome 或无回执时原样返回。 */\nfunction encodeReceiptRef(receiptRef: string | undefined, outcome: UsedOutcome | undefined): string | undefined {\n\tif (outcome === undefined) return receiptRef;\n\treturn `${outcome}:${receiptRef ?? \"\"}`;\n}\n\n/** 从 receipt_ref 拆 outcome；无前缀 → undefined（不算成功/失败）。 */\nexport function decodeObservationOutcome(receiptRef: string | null): UsedOutcome | undefined {\n\tif (receiptRef === null) return undefined;\n\tfor (const prefix of OUTCOME_PREFIXES) {\n\t\tif (receiptRef.startsWith(`${prefix}:`)) return prefix;\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 来源删除：沿关联清理候选输入/回执里的目标正文\n// ════════════════════════════════════════════════════════════════════════\n\n/** `cleanupSourceReferences` 的输入。 */\nexport interface CleanupSourceReferencesInput {\n\t/** 被删除/排除的来源 ID。 */\n\tsourceId: string;\n\t/** 清理时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 是否保留最小定位（默认 true：保留 sourceId/候选 ID，清正文）。 */\n\tkeepExclusionLocator?: boolean;\n}\n\n/** `cleanupSourceReferences` 的输出。 */\nexport interface CleanupSourceReferencesResult {\n\t/** 被清理的问题数。 */\n\tproblemsCleaned: number;\n\t/** 被清理的候选数（状态被标 cancelled 或内容被清除）。 */\n\tcandidatesCleaned: number;\n\t/** 被清理的验证数（未完成验证保留 incomplete，已完成的不动）。 */\n\tvalidationsCleaned: number;\n\t/** 仍保持未完成状态的对象（清理无法完成时）。 */\n\tpendingObjects: Array<{ kind: \"problem\" | \"candidate\" | \"validation\"; id: string; reason: string }>;\n}\n\n/**\n * 沿 `evolution_source_links` 清除来源删除后残留的目标正文（db 级，无自身事务）。\n *\n * 供两处调用：\n * - 外层 `cleanupSourceReferences`（包 store.transaction 的公开 API，兼容旧调用）；\n * - `memory/deletion.ts applyDatabasePlan` 的事务内（store.transaction 是裸\n *   BEGIN IMMEDIATE 不能嵌套，故拆出本函数）。\n *\n * 对每个关联对象（O12/E11 清理范围扩到受管正文与盘文件）：\n * - **problem**：缩减 evidenceRefs；若全部证据被清空，summary/reason/\n *   expected/actual 是受该来源支撑的受管正文——清空标 `[cleared]`，\n *   状态回 pending_classification 待重新分类（依据已失效）。清不掉记 limitation。\n * - **candidate**：未终态的取消（不再排发布），failureReason 注明来源已删除；\n *   受该来源支撑的 diffs/rationale 是受管正文——清空为 `[]`/`[cleared]`；\n *   传了 paoHome 时候选目录盘文件按既有删除惯例 rmSync 移除（不再作为可发布\n *   内容）。已 passed/failed 的不改状态但同样清受管正文与盘文件。\n * - **validation**：owner_id 为 tp-*（冻结计划）时 plan.json 重写标 invalidated\n *   （来源已删除，验收依据失效）；owner_id 为 val-*（运行验证）时已完成的保留\n *   结论，未完成保持 incomplete。\n *\n * 清理未完成保持未完成状态，只保留排除所需定位；清不掉的如实计\n * pendingObjects（limitation），不伪装成功。\n */\nexport function dbCleanupSourceReferences(\n\tdb: DatabaseSync,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): CleanupSourceReferencesResult {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst keepLocator = input.keepExclusionLocator ?? true;\n\tconst pendingObjects: CleanupSourceReferencesResult[\"pendingObjects\"] = [];\n\n\t// 1. 查该来源关联的全部对象。\n\tconst links = db\n\t\t.prepare(\n\t\t\t`SELECT link_id, owner_kind, owner_id FROM evolution_source_links\n\t\t\t WHERE source_id = ?`,\n\t\t)\n\t\t.all(input.sourceId) as Array<{ link_id: string; owner_kind: string; owner_id: string }>;\n\n\tlet problemsCleaned = 0;\n\tlet candidatesCleaned = 0;\n\tlet validationsCleaned = 0;\n\t// 候选目录清理要去重（同一候选可能多条 links 指向该来源）。\n\tconst cleanedCandidateDirs = new Set<string>();\n\n\tfor (const link of links) {\n\t\tif (link.owner_kind === \"problem\") {\n\t\t\t// problem：缩减 evidenceRefs（只保留非本来源的引用）。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT evidence_refs_json FROM evolution_problems WHERE problem_id = ?`)\n\t\t\t\t.get(link.owner_id) as { evidence_refs_json: string } | undefined;\n\t\t\tif (row) {\n\t\t\t\tconst refs = JSON.parse(row.evidence_refs_json) as string[];\n\t\t\t\tconst remaining = refs.filter((r) => r !== input.sourceId);\n\t\t\t\tif (remaining.length < refs.length) {\n\t\t\t\t\tif (remaining.length === 0) {\n\t\t\t\t\t\t// 全部证据被清空：summary/reason/expected/actual 是受该来源支撑\n\t\t\t\t\t\t// 的受管正文——清空标 [cleared]，状态回 observed + disposition\n\t\t\t\t\t\t// pending_classification（重新分类的起点；'pending_classification'\n\t\t\t\t\t\t// 是 disposition 值，不是 status 合法值——CHECK 约束拒绝）。\n\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t\t\t\t\t SET evidence_refs_json = '[]', summary = '[cleared]',\n\t\t\t\t\t\t\t\t     reason = NULL, expected_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     actual_behavior = '[cleared]',\n\t\t\t\t\t\t\t\t     status = 'observed', disposition = 'pending_classification', updated_at = ?\n\t\t\t\t\t\t\t\t WHERE problem_id = ?`,\n\t\t\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\t\tkind: \"problem\",\n\t\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t} else {\n\t\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t\t`UPDATE evolution_problems SET evidence_refs_json = ?, updated_at = ? WHERE problem_id = ?`,\n\t\t\t\t\t\t).run(JSON.stringify(remaining), now, link.owner_id);\n\t\t\t\t\t}\n\t\t\t\t\tproblemsCleaned += 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 删除该 link（排除所需定位已由 keepLocator 控制）。\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"candidate\") {\n\t\t\t// candidate：未终态的取消（不再排发布）；受管正文清空 + 盘文件移除。\n\t\t\tconst row = db\n\t\t\t\t.prepare(`SELECT status, resource_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t\t.get(link.owner_id) as { status: string; resource_id: string } | undefined;\n\t\t\tif (row && row.status !== \"passed\" && row.status !== \"failed\" && row.status !== \"cancelled\") {\n\t\t\t\tconst reason = `来源 ${input.sourceId} 已删除，候选依据失效`;\n\t\t\t\tdb.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates SET status = 'cancelled', failure_reason = ?, updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t).run(reason, now, link.owner_id);\n\t\t\t\tcandidatesCleaned += 1;\n\t\t\t}\n\t\t\tif (row) {\n\t\t\t\t// 受管正文：diffs_json/rationale 是该来源支撑的内容——清空标 [cleared]。\n\t\t\t\ttry {\n\t\t\t\t\tdb.prepare(\n\t\t\t\t\t\t`UPDATE evolution_candidates SET diffs_json = '[]', rationale = '[cleared]', updated_at = ? WHERE candidate_id = ?`,\n\t\t\t\t\t).run(now, link.owner_id);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: `受管正文清空失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\t// 盘文件：候选目录按既有删除惯例移除（去重防重复 rm）。\n\t\t\t\tif (input.paoHome !== undefined && !cleanedCandidateDirs.has(link.owner_id)) {\n\t\t\t\t\tcleanedCandidateDirs.add(link.owner_id);\n\t\t\t\t\tconst dirSafeResourceId = row.resource_id.replace(/:/g, \"_\");\n\t\t\t\t\tconst candidateDir = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).candidates,\n\t\t\t\t\t\tdirSafeResourceId,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(candidateDir)) {\n\t\t\t\t\t\t\trmSync(candidateDir, { recursive: true, force: true });\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"candidate\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `候选目录清理失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t} else if (link.owner_kind === \"validation\") {\n\t\t\t// validation 两类 owner：testPlanId（tp-*，冻结计划）与 validationId\n\t\t\t// （val-*，运行验证）。已完成的保留结论；未完成保持 incomplete。\n\t\t\tif (link.owner_id.startsWith(\"tp-\")) {\n\t\t\t\t// testPlan 形态：plan.json 重写标 invalidated（验收依据已失效）。\n\t\t\t\tif (input.paoHome !== undefined) {\n\t\t\t\t\tconst planPath = join(\n\t\t\t\t\t\tevolutionPaths(input.paoHome).validations,\n\t\t\t\t\t\tlink.owner_id,\n\t\t\t\t\t\t\"plan.json\",\n\t\t\t\t\t);\n\t\t\t\t\ttry {\n\t\t\t\t\t\tif (existsSync(planPath)) {\n\t\t\t\t\t\t\tlet planJson: unknown = {};\n\t\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\t\tplanJson = JSON.parse(readFileSync(planPath, \"utf8\"));\n\t\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\t\t// plan.json 已损坏：仍写 invalidated 包装。\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tconst invalidated = {\n\t\t\t\t\t\t\t\tinvalidated: true,\n\t\t\t\t\t\t\t\tinvalidatedReason: `来源 ${input.sourceId} 已删除，验收依据失效`,\n\t\t\t\t\t\t\t\tinvalidatedAt: now,\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t\twriteFileSync(\n\t\t\t\t\t\t\t\tplanPath,\n\t\t\t\t\t\t\t\tJSON.stringify(\n\t\t\t\t\t\t\t\t\ttypeof planJson === \"object\" && planJson !== null\n\t\t\t\t\t\t\t\t\t\t? { ...(planJson as Record<string, unknown>), ...invalidated }\n\t\t\t\t\t\t\t\t\t\t: invalidated,\n\t\t\t\t\t\t\t\t\tnull,\n\t\t\t\t\t\t\t\t\t2,\n\t\t\t\t\t\t\t\t),\n\t\t\t\t\t\t\t\t\"utf8\",\n\t\t\t\t\t\t\t);\n\t\t\t\t\t\t}\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\t\treason: `plan.json 标 invalidated 失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t} else {\n\t\t\t\tconst row = db\n\t\t\t\t\t.prepare(`SELECT verdict FROM evolution_validations WHERE validation_id = ?`)\n\t\t\t\t\t.get(link.owner_id) as { verdict: string } | undefined;\n\t\t\t\tif (row && row.verdict === \"incomplete\") {\n\t\t\t\t\t// 未完成验证保持 incomplete（清理未完成保持未完成状态）。\n\t\t\t\t\tpendingObjects.push({\n\t\t\t\t\t\tkind: \"validation\",\n\t\t\t\t\t\tid: link.owner_id,\n\t\t\t\t\t\treason: \"验证未完成，保留 incomplete 状态供排除定位\",\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\tvalidationsCleaned += 1;\n\t\t\t}\n\t\t\tif (!keepLocator) {\n\t\t\t\tdb.prepare(`DELETE FROM evolution_source_links WHERE link_id = ?`).run(link.link_id);\n\t\t\t}\n\t\t}\n\t}\n\n\treturn {\n\t\tproblemsCleaned,\n\t\tcandidatesCleaned,\n\t\tvalidationsCleaned,\n\t\tpendingObjects,\n\t};\n}\n\n/**\n * `cleanupSourceReferences` 的公开 API：包 store.transaction 调 db 级实现。\n * 兼容旧调用（不带 paoHome 时跳过盘文件清理，只清库内受管正文与 links）。\n */\nexport function cleanupSourceReferences(\n\tstore: MemoryStore,\n\tinput: CleanupSourceReferencesInput & { paoHome?: string },\n): MemoryResult<CleanupSourceReferencesResult> {\n\treturn store.transaction(() => ({ ok: true, ...dbCleanupSourceReferences(store.db, input) }));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 依据失效/基础版本过期：标待重评估\n// ════════════════════════════════════════════════════════════════════════\n\n/** `markStaleCandidates` 的输入。 */\nexport interface MarkStaleCandidatesInput {\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 当前基础版本（新的 baseVersion；旧候选的 baseVersion 若与此不同即过期）。 */\n\tcurrentBaseVersion: string;\n\t/** 判定时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 具体失效原因（可选，人读）。 */\n\treason?: string;\n}\n\n/** `markStaleCandidates` 的输出。 */\nexport interface MarkStaleCandidatesResult {\n\t/** 被标过期的候选数。 */\n\tstaleCount: number;\n\t/** 被标过期的候选 ID。 */\n\tstaleCandidateIds: string[];\n}\n\n/**\n * 基础版本变动导致依据失效时标待重评估。\n *\n * 规则：\n * - 同 resourceId 下 base_version ≠ currentBaseVersion 的候选，\n *   若状态为 proposed/testing（未终态），标为 cancelled，\n *   failureReason 注明「基础版本已变动，待重评估」。\n * - **旧候选不得直接重新排发布**：即使回到同一 baseVersion，\n *   旧候选的验证证据已失效，不自动恢复为 proposed。\n */\nexport function markStaleCandidates(\n\tstore: MemoryStore,\n\tinput: MarkStaleCandidatesInput,\n): MemoryResult<MarkStaleCandidatesResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst reason = input.reason ?? `基础版本已变动:${input.currentBaseVersion}，待重评估`;\n\n\treturn store.transaction(() => {\n\t\tconst staleRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT candidate_id, base_version, status FROM evolution_candidates\n\t\t\t\t WHERE resource_id = ? AND base_version != ? AND status IN ('proposed', 'testing')`,\n\t\t\t)\n\t\t\t.all(input.resourceId, input.currentBaseVersion) as Array<{\n\t\t\tcandidate_id: string;\n\t\t\tbase_version: string;\n\t\t\tstatus: string;\n\t\t}>;\n\n\t\tfor (const row of staleRows) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`UPDATE evolution_candidates\n\t\t\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\n\t\t\t\t\t WHERE candidate_id = ?`,\n\t\t\t\t)\n\t\t\t\t.run(`${reason}（旧候选不得直接重新排发布）`, now, row.candidate_id);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstaleCount: staleRows.length,\n\t\t\tstaleCandidateIds: staleRows.map((r) => r.candidate_id),\n\t\t};\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 观察骨架：viewed/used/patched 三态计数与关联\n// ════════════════════════════════════════════════════════════════════\n\n/** 观察动作三态（S9-06 才接 taskBinding，本阶段先落计数入口）。 */\nexport const EVOLUTION_OBSERVATION_ACTIONS = [\n\t/** 查看详情是 viewed。 */\n\t\"viewed\",\n\t/** 任务明确选择该技能并引用 taskBinding 是 used（S9-06 接入）。 */\n\t\"used\",\n\t/** 新版本发布是 patched（S9 接入）。 */\n\t\"patched\",\n] as const;\n\nexport type EvolutionObservationAction = (typeof EVOLUTION_OBSERVATION_ACTIONS)[number];\n\n/** 一条观察记录。 */\nexport interface EvolutionObservation {\n\t/** 观察 ID。 */\n\tobservationId: string;\n\t/** 观察动作。 */\n\taction: EvolutionObservationAction;\n\t/** 目标资源 ID。 */\n\tresourceId: string;\n\t/** 关联的版本 ID（used 时为 taskBinding 绑定的 versionId；patched 时为新版本）。 */\n\tversionId?: string;\n\t/** 关联候选 ID（viewed 详情时定位候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 关联任务 ID（S9-06 接 taskBinding 后填充）。 */\n\ttaskId?: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/** 执行回执引用（used 时关联成功/失败）。 */\n\treceiptRef?: string;\n\t/** 观察时间。 */\n\tcreatedAt: string;\n}\n\n/** `recordEvolutionObservation` 的输入。 */\nexport interface RecordEvolutionObservationInput {\n\taction: EvolutionObservationAction;\n\tresourceId: string;\n\tversionId?: string;\n\tcandidateId?: string;\n\tproblemId?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n\treceiptRef?: string;\n\tcreatedAt?: string;\n}\n\n/** `recordEvolutionObservation` 的输出。 */\nexport interface RecordEvolutionObservationResult {\n\tobservationId: string;\n}\n\n/**\n * 记录一次资源观察（只读计数入口；S9-06 接 taskBinding）。\n *\n * - `viewed`：详情查看，关联 candidateId/problemId。\n * - `used`：实际使用（S9-06 才有 taskBinding），关联 versionId + receiptRef；\n *   本阶段只登记数据，不关联执行回执。\n * - `patched`：新版本发布（S9 接入），关联 versionId。\n *\n * 只有带实际执行回执的 used 才可关联成功/失败；仅资源已加载不能算实际采用。\n */\nexport function recordEvolutionObservation(\n\tstore: MemoryStore,\n\tinput: RecordEvolutionObservationInput,\n): MemoryResult<RecordEvolutionObservationResult> {\n\tif (!EVOLUTION_OBSERVATION_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知观察动作:${String(input.action)}`, String(input.action));\n\t}\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tconst observationId = `obs-${randomUUID()}`;\n\n\t// 观察落 evolution_observations 表（SCHEMA_SQL 建表；S9-06 接 taskBinding\n\t// 时复用同一表）。表缺失属环境异常，直接抛出不伪装成功。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_observations (\n\t\t\t\tobservation_id, action, resource_id, version_id, candidate_id, problem_id,\n\t\t\t\ttask_id, session_id, receipt_ref, created_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tobservationId,\n\t\t\tinput.action,\n\t\t\tinput.resourceId,\n\t\t\tinput.versionId ?? null,\n\t\t\tinput.candidateId ?? null,\n\t\t\tinput.problemId ?? null,\n\t\t\tinput.taskId ?? null,\n\t\t\tinput.sessionId ?? null,\n\t\t\tinput.receiptRef ?? null,\n\t\t\tnow,\n\t\t);\n\n\treturn { ok: true, observationId };\n}\n\n/** `countEvolutionObservations` 的输入。 */\nexport interface CountEvolutionObservationsInput {\n\tresourceId: string;\n\t/** 按动作过滤；缺省返回三态汇总。 */\n\taction?: EvolutionObservationAction;\n\t/** 按候选过滤。 */\n\tcandidateId?: string;\n\t/** 按版本过滤。 */\n\tversionId?: string;\n\t/** 按任务过滤（S9-06 后有效）。 */\n\ttaskId?: string;\n}\n\n/** `countEvolutionObservations` 的输出。 */\nexport interface CountEvolutionObservationsResult {\n\t/** 三态各自计数。 */\n\tcounts: Record<EvolutionObservationAction, number>;\n\t/** 总观察数。 */\n\ttotal: number;\n\t/** 是否从持久化表读取（恒为 true：SCHEMA_SQL 保证表存在）。 */\n\tpersisted: boolean;\n}\n\n/**\n * 只读观察计数：按 resourceId 汇总 viewed/used/patched 三态。\n *\n * 数据来自 SCHEMA_SQL 建的 evolution_observations 表；表缺失属环境异常，直接抛出。\n */\nexport function countEvolutionObservations(\n\tstore: MemoryStore,\n\tinput: CountEvolutionObservationsInput,\n): MemoryResult<CountEvolutionObservationsResult> {\n\tconst where: string[] = [\"resource_id = ?\"];\n\tconst params: unknown[] = [input.resourceId];\n\tif (input.action !== undefined) {\n\t\twhere.push(\"action = ?\");\n\t\tparams.push(input.action);\n\t}\n\tif (input.candidateId !== undefined) {\n\t\twhere.push(\"candidate_id = ?\");\n\t\tparams.push(input.candidateId);\n\t}\n\tif (input.versionId !== undefined) {\n\t\twhere.push(\"version_id = ?\");\n\t\tparams.push(input.versionId);\n\t}\n\tif (input.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(input.taskId);\n\t}\n\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, COUNT(*) AS n FROM evolution_observations\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t GROUP BY action`,\n\t\t)\n\t\t.all(...(params as never[])) as Array<{ action: string; n: number }>;\n\n\tconst counts: Record<EvolutionObservationAction, number> = {\n\t\tviewed: 0,\n\t\tused: 0,\n\t\tpatched: 0,\n\t};\n\tlet total = 0;\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\" || row.action === \"used\" || row.action === \"patched\") {\n\t\t\tcounts[row.action] = row.n;\n\t\t\ttotal += row.n;\n\t\t}\n\t}\n\treturn { ok: true, counts, total, persisted: true };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. S9-06：used / patched 写入入口与按版本计数\n// ════════════════════════════════════════════════════════════════════════\n\n/** `recordUsed` 的输入。 */\nexport interface RecordUsedInput {\n\t/** 被使用的资源 ID。 */\n\tresourceId: string;\n\t/** 实际使用该资源的任务 ID。 */\n\ttaskId: string;\n\t/** 关联会话 ID。 */\n\tsessionId?: string;\n\t/**\n\t * 使用的版本 ID；缺省取该任务对该资源的 active 绑定值。\n\t * 显式传值但 ≠ 绑定值 → 照实记录，返回 `versionMismatch:true` 供调用方区分\n\t * （绑定版本与实际加载版本不一致属宿主装配问题，不归因到绑定版本）。\n\t */\n\tversionId?: string;\n\t/** 执行回执引用（用于关联成功/失败与定位日志）。 */\n\treceiptRef?: string;\n\t/** 使用结果；写入时编进 receipt_ref 前缀（见文件头约定）。 */\n\toutcome?: \"success\" | \"failure\";\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `recordUsed` 的输出。 */\nexport interface RecordUsedResult {\n\tobservationId: string;\n\t/** 实际落库的 versionId（缺省时取自绑定）。 */\n\tversionId: string;\n\t/** 显式传入的 versionId 与绑定值不一致时为 true（照实记录，不归因绑定版）。 */\n\tversionMismatch: boolean;\n}\n\n/**\n * 记一次实际使用（action='used'）。\n *\n * 校验「已加载 ≠ 实际采用」：必须存在该 (taskId, resourceId) 的 active\n * task_binding 才写；绑定不存在或已停用 → 业务错误（invalid_input），不硬写。\n * 「未使用候选的错误不归因」即由此保证：无绑定任务的失败不进 observations。\n */\nexport function recordUsed(\n\tstore: MemoryStore,\n\tinput: RecordUsedInput,\n): MemoryResult<RecordUsedResult> {\n\tif (input.outcome !== undefined && !OUTCOME_PREFIXES.includes(input.outcome)) {\n\t\treturn fail(\"invalid_input\", `未知 outcome:${String(input.outcome)}`, input.resourceId);\n\t}\n\tconst binding = store.db\n\t\t.prepare(\n\t\t\t`SELECT version_id, active FROM evolution_task_bindings\n\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as { version_id: string; active: number } | undefined;\n\tif (!binding) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}：已加载 ≠ 实际采用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tif (binding.active !== 1) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用，拒绝记 used`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst versionId = input.versionId ?? binding.version_id;\n\tconst versionMismatch = input.versionId !== undefined && input.versionId !== binding.version_id;\n\n\tconst written = recordEvolutionObservation(store, {\n\t\taction: \"used\",\n\t\tresourceId: input.resourceId,\n\t\tversionId,\n\t\ttaskId: input.taskId,\n\t\t...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),\n\t\treceiptRef: encodeReceiptRef(input.receiptRef, input.outcome),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n\tif (!written.ok) return { ok: false, error: written.error };\n\treturn { ok: true, observationId: written.observationId, versionId, versionMismatch };\n}\n\n/** `recordPatched` 的输入。 */\nexport interface RecordPatchedInput {\n\t/** 被发布的资源 ID。 */\n\tresourceId: string;\n\t/** 新发布/新生效的版本 ID。 */\n\tversionId: string;\n\t/** 关联候选 ID（activation 路径可定位到候选）。 */\n\tcandidateId?: string;\n\t/** 关联问题 ID。 */\n\tproblemId?: string;\n\t/** 观察时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/**\n * 记一次版本发布/生效（action='patched'）。\n *\n * 由 activation.ts `activateCandidate` 成功事务内调用（同事务：patched 是\n * 生效历史的一部分，activation 行与 used/patched 观察同生同死）；也可由\n * 宿主在其他生效路径（restore 等）调用。本函数只 INSERT 一行观察，不开\n * 自己的事务——调用方决定事务边界。\n */\nexport function recordPatched(\n\tstore: MemoryStore,\n\tinput: RecordPatchedInput,\n): MemoryResult<{ observationId: string }> {\n\treturn recordEvolutionObservation(store, {\n\t\taction: \"patched\",\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.versionId,\n\t\t...(input.candidateId === undefined ? {} : { candidateId: input.candidateId }),\n\t\t...(input.problemId === undefined ? {} : { problemId: input.problemId }),\n\t\t...(input.createdAt === undefined ? {} : { createdAt: input.createdAt }),\n\t});\n}\n\n/** `countUsageByVersion` 的输出。 */\nexport interface UsageByVersionCounts {\n\t/** 三态各自计数。 */\n\tviewed: number;\n\tused: number;\n\tpatched: number;\n\t/** used 行中 outcome=success 的计数（receipt_ref 前缀解析）。 */\n\tsuccess: number;\n\t/** used 行中 outcome=failure 的计数。 */\n\tfailure: number;\n}\n\n/**\n * 按 (resourceId, versionId) 汇总观察计数（界面「实际观察」区用）。\n *\n * success/failure 从 used 行的 receipt_ref 前缀解析（见文件头约定）；\n * 无 outcome 的 used 行只计入 used 总数，不进 success/failure。\n */\nexport function countUsageByVersion(\n\tstore: MemoryStore,\n\tinput: { resourceId: string; versionId: string },\n): MemoryResult<UsageByVersionCounts> {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT action, receipt_ref FROM evolution_observations\n\t\t\t WHERE resource_id = ? AND version_id = ?`,\n\t\t)\n\t\t.all(input.resourceId, input.versionId) as Array<{ action: string; receipt_ref: string | null }>;\n\n\tconst counts: UsageByVersionCounts = { viewed: 0, used: 0, patched: 0, success: 0, failure: 0 };\n\tfor (const row of rows) {\n\t\tif (row.action === \"viewed\") counts.viewed += 1;\n\t\telse if (row.action === \"patched\") counts.patched += 1;\n\t\telse if (row.action === \"used\") {\n\t\t\tcounts.used += 1;\n\t\t\tconst outcome = decodeObservationOutcome(row.receipt_ref);\n\t\t\tif (outcome === \"success\") counts.success += 1;\n\t\t\telse if (outcome === \"failure\") counts.failure += 1;\n\t\t}\n\t}\n\treturn { ok: true, ...counts };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 必要来源失效检测（O12/E11 可复用 helper）\n// ════════════════════════════════════════════════════════════════════════\n\n/** `checkOwnerSourceLinksIntact` 的输入。 */\nexport interface OwnerSourceLinkCheckInput {\n\t/** owner 清单（按 problem→candidate→testPlan→validation 顺序给出最直观）。 */\n\towners: Array<{ ownerKind: \"problem\" | \"candidate\" | \"validation\"; ownerId: string; label: string }>;\n}\n\n/**\n * 核对一组 owner 的 source links 仍有效（必要来源失效检测）。\n *\n * 与 activation.ts checkSourceLinksIntact / control.ts\n * checkRestoreSourceLinksIntact 同口径——供 publish 门、activation、control\n * 三处共用，避免各写一份发散：\n * - 任一 owner 没有任何 link 行 → 返回「{label}没有登记任何来源关联」；\n * - src- 前缀 link 查 sources 行存在、source_exclusions 无命中；\n * - 带 memory_id 的 link 查 memories 行存在且 current_revision ≥ link.revision。\n * 返回首个失效原因；全部有效返回 undefined。\n */\nexport function checkOwnerSourceLinksIntact(\n\tdb: DatabaseSync,\n\tinput: OwnerSourceLinkCheckInput,\n): string | undefined {\n\tconst memoryCheck = db.prepare(`SELECT id, current_revision FROM memories WHERE id = ?`);\n\tconst sourceCheck = db.prepare(`SELECT source_id FROM sources WHERE source_id = ?`);\n\tconst exclusionCheck = db.prepare(\n\t\t`SELECT 1 AS hit FROM source_exclusions WHERE source_id = ? LIMIT 1`,\n\t);\n\tfor (const owner of input.owners) {\n\t\tconst links = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = ? AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(owner.ownerKind, owner.ownerId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>;\n\t\tif (links.length === 0) {\n\t\t\treturn `${owner.label}没有登记任何来源关联（空关联不能代替有效依据）`;\n\t\t}\n\t\tfor (const link of links) {\n\t\t\tif (link.source_id.startsWith(\"src-\") && !sourceCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被删除`;\n\t\t\t}\n\t\t\tif (exclusionCheck.get(link.source_id)) {\n\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 已被排除`;\n\t\t\t}\n\t\t\tif (link.memory_id !== null) {\n\t\t\t\tconst mem = memoryCheck.get(link.memory_id) as\n\t\t\t\t\t| { id: string; current_revision: number }\n\t\t\t\t\t| undefined;\n\t\t\t\tif (!mem) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 已被删除排除`;\n\t\t\t\t}\n\t\t\t\tif (link.revision !== null && mem.current_revision < link.revision) {\n\t\t\t\t\treturn `${owner.label}的来源 ${link.source_id} 引用的记忆 ${link.memory_id} 当前修订 r${mem.current_revision} 低于关联修订 r${link.revision}`;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化授权策略（S8-01）。\n *\ttype EvolutionProblemAction,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tEVOLUTION_RESOURCE_OPS,\n\ttype EvolutionResourceOp,\n\tformatResourceId,\n\tparseResourceId\n} from \"./types.ts\";\n\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":16}},{"diffOp":{"equal":{"range":[51,134]}}},{"diffOp":{"delete":{"range":[134,158]}}},{"diffOp":{"delete":{"range":[158,159]}}},{"diffOp":{"equal":{"range":[159,205]}}},{"diffOp":{"delete":{"range":[205,222]}}},{"diffOp":{"delete":{"range":[158,159]}}},{"diffOp":{"equal":{"range":[222,244]}}},{"equalLines":{"line_count":305}},{"diffOp":{"equal":{"range":[244,249]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\policy.ts"},"span":[984,1070],"sourceCode":"/**\n * 受控自进化授权策略（S8-01）。\n *\n * 职责：把已授权类别（C4）落实为 resourceId/资源根/允许操作，并钉死\n * 固定禁止对象；候选越界一律拒绝并给具体理由。\n *\n * 契约（S8 任务书 §2/§5）：\n * - `FORBIDDEN_EVOLUTION_TARGETS`：固定禁止对象，候选改这些即拒。\n * - `resolveEvolutionResource`：类别+目标名 → resourceId/资源根/允许操作；\n *   不在已授权类别内返回拒绝理由，不伪造授权。\n * - `assertCandidateWithinScope`：核对候选文件清单与策略引用未扩大授权；\n *   越界返回具体拒绝理由。\n * - 资源登记不重复请求已授予的类别权限（同一 resourceId 幂等复用）。\n */\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport {\n\tEVOLUTION_RESOURCE_KINDS,\n\ttype EvolutionFileDiff,\n\ttype EvolutionProblemAction,\n\ttype EvolutionResource,\n\ttype EvolutionResourceKind,\n\tEVOLUTION_RESOURCE_OPS,\n\ttype EvolutionResourceOp,\n\tformatResourceId,\n\tparseResourceId,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 固定禁止对象（S8 任务书 §2 冻结清单）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 固定禁止对象：任何候选改动这些位置一律拒绝。\n * 使用前缀匹配（相对 PAO_HOME 或项目根的 POSIX 路径）。\n */\nexport const FORBIDDEN_EVOLUTION_TARGETS = [\n\t/** 内核/pi 源码与上游文件。 */\n\t\"src/\",\n\t\"packages/\",\n\t\"node_modules/\",\n\t\"dist/\",\n\t/** memory.sqlite 表结构（SCHEMA_SQL 本身不可被候选修改）。 */\n\t\"memory/memory.sqlite\",\n\t/** 权限/角色门控。 */\n\t\"src/pao/role.ts\",\n\t/** 预算上限、用量账正本、档位.json 数值、记忆后台预算.json。 */\n\t\"pao配置/档位.json\",\n\t\"pao配置/记忆后台预算.json\",\n\t\"usage/\",\n\t\"memory/budget-ledger\",\n\t/** 资源加载与更新机制本身。 */\n\t\"src/core/resource-loader.ts\",\n\t\"src/pao/evolution/policy.ts\",\n\t\"src/pao/evolution/resources.ts\",\n\t/** 正式决定与授权范围变更。 */\n\t\"plans/\",\n\t\".agents/notes/\",\n] as const;\n\n/**\n * 固定禁止对象的人类可读描述（拒绝理由用）。\n */\nexport const FORBIDDEN_TARGET_REASONS: Record<string, string> = {\n\t\"src/\": \"内核/pi 源码属于固定禁止对象，不可由候选修改\",\n\t\"packages/\": \"上游包源码属于固定禁止对象\",\n\t\"node_modules/\": \"依赖目录属于固定禁止对象\",\n\t\"dist/\": \"构建产物属于固定禁止对象\",\n\t\"memory/memory.sqlite\": \"memory.sqlite 表结构属于固定禁止对象\",\n\t\"src/pao/role.ts\": \"权限/角色门控属于固定禁止对象\",\n\t\"pao配置/档位.json\": \"档位配置数值属于固定禁止对象\",\n\t\"pao配置/记忆后台预算.json\": \"记忆后台预算配置属于固定禁止对象\",\n\t\"usage/\": \"用量账正本属于固定禁止对象\",\n\t\"memory/budget-ledger\": \"预算账正本属于固定禁止对象\",\n\t\"src/core/resource-loader.ts\": \"资源加载与更新机制本身属于固定禁止对象\",\n\t\"src/pao/evolution/policy.ts\": \"策略机制本身属于固定禁止对象\",\n\t\"src/pao/evolution/resources.ts\": \"资源登记机制本身属于固定禁止对象\",\n\t\"plans/\": \"正式决定/计划文件属于固定禁止对象\",\n\t\".agents/notes/\": \"授权范围变更记录属于固定禁止对象\",\n};\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 授权类别 → 资源落点（S8 任务书 §2 冻结表）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 每种类别的资源根模板与允许操作。 */\ninterface CategoryProfile {\n\t/** 资源根相对路径模板（`{name}` 为占位符）。 */\n\trelativeRootTemplate: string;\n\t/** 允许操作集。 */\n\tallowedOps: EvolutionResourceOp[];\n\t/** 能力范围描述。 */\n\tcapabilityScope: string[];\n\t/** 加载方式。 */\n\tloadMethod: import(\"./types.ts\").EvolutionLoadMethod;\n\t/** 禁止改的内容（人读描述）。 */\n\tforbidden: string[];\n}\n\nconst CATEGORY_PROFILES: Record<EvolutionResourceKind, CategoryProfile> = {\n\tskill: {\n\t\trelativeRootTemplate: \"pao配置/skills/{name}\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"SKILL.md 正文\", \"示例\", \"局部步骤\"],\n\t\tloadMethod: \"skill-path\",\n\t\tforbidden: [\"权限\", \"预算\", \"验收条件\"],\n\t},\n\ttemplate: {\n\t\trelativeRootTemplate: \"工作流/{name}.md\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"模板正文\", \"目标\", \"约束\"],\n\t\tloadMethod: \"template-file\",\n\t\tforbidden: [\"frontmatter 预算对象\", \"验收字段\"],\n\t},\n\tcommand: {\n\t\trelativeRootTemplate: \"pao配置/commands/{name}\",\n\t\tallowedOps: [\"adjust-params\"],\n\t\tcapabilityScope: [\"参数组织\"],\n\t\tloadMethod: \"command-registry\",\n\t\tforbidden: [\"工具能力授予\", \"可写边界\"],\n\t},\n\textension: {\n\t\trelativeRootTemplate: \"pao配置/extensions/{name}\",\n\t\tallowedOps: [\"edit-content\", \"adjust-params\"],\n\t\tcapabilityScope: [\"工具实现\", \"参数组织\"],\n\t\tloadMethod: \"extension-path\",\n\t\tforbidden: [\"能力授予\", \"宿主权限检查\"],\n\t},\n\t\"memory-policy\": {\n\t\trelativeRootTemplate: \"memory/{name}\",\n\t\tallowedOps: [\"adjust-policy\"],\n\t\tcapabilityScope: [\"检索参数\", \"条件选择\", \"提炼提示\"],\n\t\tloadMethod: \"policy-resource\",\n\t\tforbidden: [\"表结构\", \"来源可信分类\", \"纠正优先\", \"删除语义\"],\n\t},\n\trecipe: {\n\t\trelativeRootTemplate: \"部门/{name}/配方.md\",\n\t\tallowedOps: [\"edit-content\"],\n\t\tcapabilityScope: [\"人设\", \"职责边界描述\"],\n\t\tloadMethod: \"recipe-file\",\n\t\tforbidden: [\"工具清单授权\", \"默认档位越权\"],\n\t},\n};\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `resolveEvolutionResource` 的输入。 */\nexport interface ResolveEvolutionResourceInput {\n\t/** 已授权类别。 */\n\tkind: EvolutionResourceKind;\n\t/** 目标名（如技能名、部门名、命令名）。 */\n\tname: string;\n\t/** PAO_HOME 根（用于校验资源根确实落在 home 内）。 */\n\tpaoHome: string;\n}\n\n/** `resolveEvolutionResource` 的成功结果。 */\nexport interface ResolveEvolutionResourceResult {\n\tresourceId: string;\n\trelativeRoot: string;\n\tabsoluteRoot: string;\n\tallowedOps: EvolutionResourceOp[];\n\tcapabilityScope: string[];\n\tloadMethod: EvolutionResource[\"loadMethod\"];\n}\n\n/** `assertCandidateWithinScope` 的输入。 */\nexport interface AssertCandidateScopeInput {\n\t/** 候选声明要改的文件差异。 */\n\tdiffs: EvolutionFileDiff[];\n\t/** 候选声明的动作。 */\n\taction?: EvolutionProblemAction;\n\t/** 已登记的资源（含允许范围）。 */\n\tresource: EvolutionResource;\n\t/** 候选给出的策略引用（如 memory-policy 的检索参数名）。 */\n\tpolicyRefs?: string[];\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 实现\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\nfunction normalizeRelativePath(path: string): string {\n\treturn path.replace(/\\\\/g, \"/\").replace(/^\\.\\//, \"\").replace(/\\/+/g, \"/\");\n}\n\n/** 检查相对路径是否命中固定禁止对象；命中返回理由，未命中返回 undefined。 */\nexport function checkForbiddenTarget(relativePath: string): string | undefined {\n\tconst normalized = normalizeRelativePath(relativePath);\n\t// 最长前缀优先：具体条目（如 src/pao/role.ts）先于泛前缀（如 src/）给出准确理由。\n\tconst sorted = [...FORBIDDEN_EVOLUTION_TARGETS].sort((a, b) => b.length - a.length);\n\tfor (const target of sorted) {\n\t\tconst normalizedTarget = normalizeRelativePath(target);\n\t\tif (normalized === normalizedTarget || normalized.startsWith(normalizedTarget)) {\n\t\t\treturn FORBIDDEN_TARGET_REASONS[target] ?? `路径 ${normalized} 属于固定禁止对象`;\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 检查相对路径是否落在资源根内。 */\nfunction isPathUnderRoot(relativePath: string, relativeRoot: string): boolean {\n\tconst normalized = normalizeRelativePath(relativePath);\n\tconst normalizedRoot = normalizeRelativePath(relativeRoot);\n\treturn normalized === normalizedRoot || normalized.startsWith(`${normalizedRoot}/`);\n}\n\n/**\n * 把类别+目标名解析为 resourceId/资源根/允许操作。\n * 不在已授权类别内返回拒绝理由；不展开、不猜测、不自动授权新类别。\n */\nexport function resolveEvolutionResource(\n\tinput: ResolveEvolutionResourceInput,\n): MemoryResult<ResolveEvolutionResourceResult> {\n\tif (!EVOLUTION_RESOURCE_KINDS.includes(input.kind)) {\n\t\treturn fail(\"invalid_input\", `未授权的进化资源类别:${String(input.kind)}`, String(input.kind));\n\t}\n\tif (typeof input.name !== \"string\" || input.name.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"资源目标名不能为空\", input.kind);\n\t}\n\tconst profile = CATEGORY_PROFILES[input.kind];\n\tconst relativeRoot = profile.relativeRootTemplate.replace(\"{name}\", input.name.trim());\n\tconst resourceId = formatResourceId(input.kind, input.name.trim());\n\tconst absoluteRoot = join(input.paoHome, relativeRoot);\n\treturn {\n\t\tok: true,\n\t\tresourceId,\n\t\trelativeRoot,\n\t\tabsoluteRoot,\n\t\tallowedOps: [...profile.allowedOps],\n\t\tcapabilityScope: [...profile.capabilityScope],\n\t\tloadMethod: profile.loadMethod,\n\t};\n}\n\n/**\n * 核对候选是否在已授权范围内。\n *\n * 检查项：\n * 1. 每条 diff 的 path 必须在 resource.relativeRoot 内；\n * 2. 每条 diff 的 path 不能命中固定禁止对象；\n * 3. 候选动作必须与资源允许操作一致（modify→edit-content，等）；\n * 4. policyRefs 不能声明超出 capabilityScope 的策略名。\n *\n * 越界返回具体拒绝理由；全部通过返回 `{ ok: true }`。\n */\nexport function assertCandidateWithinScope(input: AssertCandidateScopeInput): MemoryResult<{ checked: number }> {\n\tconst { diffs, action, resource, policyRefs } = input;\n\tconst profile = CATEGORY_PROFILES[resource.kind];\n\n\t// 动作与允许操作核对\n\tif (action !== undefined) {\n\t\tconst requiredOp = actionToRequiredOp(action);\n\t\tif (requiredOp !== undefined && !resource.allowedOps.includes(requiredOp)) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`候选动作 ${action} 需要操作 ${requiredOp}，但资源 ${resource.resourceId} 仅允许 ${resource.allowedOps.join(\"、\")}`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t}\n\n\t// 文件范围核对\n\tfor (const diff of diffs) {\n\t\tconst normalized = normalizeRelativePath(diff.path);\n\t\tconst forbiddenReason = checkForbiddenTarget(normalized);\n\t\tif (forbiddenReason !== undefined) {\n\t\t\treturn fail(\"invalid_input\", `候选越界:${forbiddenReason}`, normalized);\n\t\t}\n\t\tif (!isPathUnderRoot(normalized, resource.relativeRoot)) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`候选文件 ${normalized} 超出资源根 ${resource.relativeRoot}（资源 ${resource.resourceId} 的可写范围）`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t}\n\n\t// 策略引用核对（memory-policy 专用；其他类别传 policyRefs 直接拒绝）\n\tif (policyRefs !== undefined && policyRefs.length > 0) {\n\t\tif (resource.kind !== \"memory-policy\") {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`资源 ${resource.resourceId} 非记忆策略类别，不接受 policyRefs`,\n\t\t\t\tresource.resourceId,\n\t\t\t);\n\t\t}\n\t\tfor (const ref of policyRefs) {\n\t\t\tif (!profile.capabilityScope.includes(ref)) {\n\t\t\t\treturn fail(\n\t\t\t\t\t\"invalid_input\",\n\t\t\t\t\t`策略引用 ${ref} 超出记忆策略能力范围（允许:${profile.capabilityScope.join(\"、\")}）`,\n\t\t\t\t\tresource.resourceId,\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\treturn { ok: true, checked: diffs.length };\n}\n\n/**\n * 检查候选是否未扩大授权（简版：只传文件清单与 resourceId）。\n * 供调用方在尚未拿到完整 resource 对象时做快速前置检查。\n */\nexport function assertCandidatePathsWithinScope(\n\tresource: EvolutionResource,\n\tpaths: string[],\n): MemoryResult<{ checked: number }> {\n\treturn assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: paths.map((path) => ({ path, kind: \"edit\" })),\n\t});\n}\n\n/** 把问题动作映射为所需资源操作。 */\nfunction actionToRequiredOp(action: EvolutionProblemAction): EvolutionResourceOp | undefined {\n\tswitch (action) {\n\t\tcase \"modify\":\n\t\tcase \"delete\":\n\t\tcase \"merge\":\n\t\t\treturn \"edit-content\";\n\t\tcase \"no_change\":\n\t\tcase \"development_suggestion\":\n\t\t\treturn undefined;\n\t\tdefault:\n\t\t\treturn undefined;\n\t}\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n *import {\n\tEVOLUTION_PROBLEM_ACTIONS,\n\tEVOLUTION_PROBLEM_KINDS,\n\tEVOLUTION_PROBLEM_STATUSES,\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\treturn rows.map(rowToProblem);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":24}},{"diffOp":{"equal":{"range":[63,125]}}},{"diffOp":{"delete":{"range":[125,153]}}},{"diffOp":{"delete":{"range":[153,154]}}},{"diffOp":{"equal":{"range":[154,208]}}},{"equalLines":{"line_count":599}},{"diffOp":{"equal":{"range":[208,242]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\problems.ts"},"span":[1600,1626],"sourceCode":"/**\n * 受控自进化问题登记与分类（S8-03/04）。\n *\n * 职责：\n * - `declareImprovementIntent`：统一问题登记入口。输入含 kind/action/summary/\n *   expectedBehavior/actualBehavior/evidenceRefs；宿主补 projectId/taskId/\n *   sessionId/entryId/toolCallId，**不信模型自报身份**。返回\n *   `{accepted, problemId?, disposition, reason?}`。\n * - `collectEvolutionProblem`：从失败回执/用户纠正/使用记录取得事实输入，\n *   只读事实，已有同来源问题复用 ID。\n * - `classifyProblem`：S8-04 分类——先查是否未采用已有经验（unused_experience，\n *   优先改检索/提示策略），再查调用参数/实现版本（invocation/implementation_defect），\n *   核心缺陷输出 development_suggestion。\n * - 来源关联写入 `evolution_source_links`（owner_kind='problem'）。\n *\n * 契约（S8 任务书 §5）：\n * - `occurrenceCount` 只由独立事实来源计算，不算摘要指纹；模型单次申报不能标\n *   「重复失败」。\n * - 同 sourceId + resourceId + action 重复申报复用已有 problemId，返回\n *   disposition='merged'。\n * - 证据为空且非「有依据的机会」类时返回不受理理由，不伪造失败记录。\n * - 登记后资源文件未改；模型验证调用为零。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getSource } from \"../memory/sources.ts\";\nimport {\n\tEVOLUTION_PROBLEM_ACTIONS,\n\tEVOLUTION_PROBLEM_KINDS,\n\tEVOLUTION_PROBLEM_STATUSES,\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemKind,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 行映射\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * evolution_problems 全列行形状与映射：本模块唯一正本。\n * select.ts 等其他模块需要完整 Problem 时复用本行读取（O14：字段增补只改这里）。\n */\nexport interface EvolutionProblemDbRow {\n\tproblem_id: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpected_behavior: string;\n\tactual_behavior: string;\n\tevidence_refs_json: string;\n\toccurrence_count: number;\n\tresource_id: string | null;\n\tbase_version: string | null;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsession_id: string | null;\n\tentry_id: string | null;\n\ttool_call_id: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\nexport function rowToProblem(row: EvolutionProblemDbRow): EvolutionProblem {\n\treturn {\n\t\tproblemId: row.problem_id,\n\t\tkind: row.kind as EvolutionProblemKind,\n\t\t...(row.action === null ? {} : { action: row.action as EvolutionProblemAction }),\n\t\tsummary: row.summary,\n\t\t...(row.reason === null ? {} : { reason: row.reason }),\n\t\texpectedBehavior: row.expected_behavior,\n\t\tactualBehavior: row.actual_behavior,\n\t\tevidenceRefs: JSON.parse(row.evidence_refs_json) as string[],\n\t\toccurrenceCount: row.occurrence_count,\n\t\t...(row.resource_id === null ? {} : { resourceId: row.resource_id }),\n\t\t...(row.base_version === null ? {} : { baseVersion: row.base_version }),\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t...(row.session_id === null ? {} : { sessionId: row.session_id }),\n\t\t...(row.entry_id === null ? {} : { entryId: row.entry_id }),\n\t\t...(row.tool_call_id === null ? {} : { toolCallId: row.tool_call_id }),\n\t\tstatus: row.status as EvolutionProblemStatus,\n\t\tdisposition: row.disposition as EvolutionProblemDisposition,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. declareImprovementIntent —— 统一问题登记\n// ════════════════════════════════════════════════════════════════════════\n\n/** `declareImprovementIntent` 的输入。 */\nexport interface DeclareImprovementIntentInput {\n\t/** 问题类别（宿主/模型申报）。 */\n\tkind: EvolutionProblemKind;\n\t/** 建议动作（可选；登记时未分类可缺省）。 */\n\taction?: EvolutionProblemAction;\n\t/** 一句话摘要。 */\n\tsummary: string;\n\t/** 发生原因（模型推测标 model_inference）。 */\n\treason?: string;\n\t/** 预期行为。 */\n\texpectedBehavior: string;\n\t/** 实际行为（有真实回执时必填）。 */\n\tactualBehavior: string;\n\t/** 证据引用：sourceId / memoryId / revision / toolCallId / receiptRef。 */\n\tevidenceRefs: string[];\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本（问题发生时的资源版本）。 */\n\tbaseVersion?: string;\n\t/** 宿主补的项目 ID。 */\n\tprojectId?: string;\n\t/** 宿主补的任务 ID。 */\n\ttaskId?: string;\n\t/** 宿主补的会话 ID。 */\n\tsessionId?: string;\n\t/** 宿主补的会话条目 ID。 */\n\tentryId?: string;\n\t/** 宿主补的工具调用 ID。 */\n\ttoolCallId?: string;\n\t/** 登记时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1，不给模型自报「重复」。 */\n\toccurrenceCount?: number;\n}\n\n/** `declareImprovementIntent` 的输出。 */\nexport interface DeclareImprovementIntentResult {\n\t/** 是否受理。 */\n\taccepted: boolean;\n\t/** 已登记/复用的问题 ID。 */\n\tproblemId?: string;\n\t/** 处置结果。 */\n\tdisposition?: EvolutionProblemDisposition;\n\t/** 不受理理由。 */\n\treason?: string;\n}\n\n/**\n * 统一问题登记。\n *\n * 证据校验：evidenceRefs 为空且非「有依据的机会」类时返回不受理理由。\n * 去重：同 sourceId + resourceId + action 复用已有 problemId（查\n * evolution_source_links + evolution_problems），不算摘要指纹。\n * occurrenceCount 只由独立事实来源计算；不给模型自报「重复」。\n */\nexport function declareImprovementIntent(\n\tstore: MemoryStore,\n\tinput: DeclareImprovementIntentInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\t// 基础输入校验\n\tif (!EVOLUTION_PROBLEM_KINDS.includes(input.kind)) {\n\t\treturn fail(\"invalid_input\", `未知问题类别:${String(input.kind)}`, String(input.kind));\n\t}\n\tif (input.action !== undefined && !EVOLUTION_PROBLEM_ACTIONS.includes(input.action)) {\n\t\treturn fail(\"invalid_input\", `未知问题动作:${String(input.action)}`, String(input.action));\n\t}\n\tif (typeof input.summary !== \"string\" || input.summary.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"问题摘要不能为空\", input.kind);\n\t}\n\tif (typeof input.expectedBehavior !== \"string\" || input.expectedBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"预期行为不能为空\", input.kind);\n\t}\n\tif (typeof input.actualBehavior !== \"string\" || input.actualBehavior.trim().length === 0) {\n\t\treturn fail(\"invalid_input\", \"实际行为不能为空\", input.kind);\n\t}\n\n\t// 证据校验：evidenceRefs 为空且非「有依据的机会」类时不受理。\n\t// 「有依据的机会」类（unused_experience / invocation / implementation_defect / core_issue）\n\t// 都须至少一条证据；空证据的泛化建议不伪造失败记录。\n\tif (input.evidenceRefs.length === 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: \"无证据引用：evidenceRefs 至少一条，不接受空证据的泛化建议\",\n\t\t};\n\t}\n\n\t// 证据引用分两类：\n\t// - src- 前缀：sources 表已登记来源，校验存在性（缺失即整体拒绝）。\n\t// - 其他（friction:/toolcall:/mem-*@rev-* 等）：宿主给的稳定引用，不入 sources 表\n\t//   但同样作为去重键写 evolution_source_links。\n\tconst realSourceIds = input.evidenceRefs.filter((ref) => ref.startsWith(\"src-\"));\n\tconst missingSources = realSourceIds.filter((id) => !getSource(store.db, id));\n\tif (missingSources.length > 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: false,\n\t\t\treason: `来源不存在:${missingSources.join(\"、\")}——不伪造失败记录`,\n\t\t};\n\t}\n\n\t// 去重：同来源引用（任一 evidenceRef）+ 同 resourceId + 同 action 复用已有 problemId。\n\t// 「同来源」指同一稳定证据引用，不限 src- 前缀——摩擦草稿、回执、toolcall 等\n\t// 宿主生成的稳定引用同样算来源。不算摘要指纹。\n\tconst normalizedResourceId = input.resourceId?.trim() || null;\n\tconst normalizedAction = input.action ?? null;\n\tlet mergedProblemId: string | undefined;\n\tfor (const ref of input.evidenceRefs) {\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT p.problem_id FROM evolution_source_links l\n\t\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t\t   AND COALESCE(p.resource_id, '') = COALESCE(?, '')\n\t\t\t\t   AND COALESCE(p.action, '') = COALESCE(?, '')\n\t\t\t\t LIMIT 1`,\n\t\t\t)\n\t\t\t.get(ref, normalizedResourceId, normalizedAction) as { problem_id: string } | undefined;\n\t\tif (row) {\n\t\t\tmergedProblemId = row.problem_id;\n\t\t\tbreak;\n\t\t}\n\t}\n\n\treturn store.transaction(() => {\n\t\tif (mergedProblemId !== undefined) {\n\t\t\t// 同来源重复申报：复用已有 problemId，返回 merged。\n\t\t\t// 把本次全部证据引用补进关联（UNIQUE 约束幂等防重），后续任一引用再申报都能命中。\n\t\t\t// O10/E02 幂等口径：同一 evidenceRef 重报 = 同一事件重放，不累计\n\t\t\t// occurrence_count；只有本次申报带「尚未关联到该 problem 的新引用」\n\t\t\t// （不同真实事件命中同 problem）才 +1——本次申报本身是「再次发生」\n\t\t\t// 的证据，不依赖模型自报（缺省 1）。\n\t\t\tlet hasNewRef = false;\n\t\t\tfor (const ref of input.evidenceRefs) {\n\t\t\t\tif (insertProblemSourceLink(store, mergedProblemId, ref, now)) hasNewRef = true;\n\t\t\t}\n\t\t\tif (hasNewRef) {\n\t\t\t\tconst bump = input.occurrenceCount ?? 1;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(`UPDATE evolution_problems SET occurrence_count = occurrence_count + ?, updated_at = ? WHERE problem_id = ?`)\n\t\t\t\t\t.run(bump, now, mergedProblemId);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\taccepted: true,\n\t\t\t\tproblemId: mergedProblemId,\n\t\t\t\tdisposition: \"merged\" as const,\n\t\t\t};\n\t\t}\n\n\t\tconst problemId = `prob-${randomUUID()}`;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\t\tproblem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\t\tproject_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tproblemId,\n\t\t\t\tinput.kind,\n\t\t\t\tnormalizedAction,\n\t\t\t\tinput.summary.trim(),\n\t\t\t\tinput.reason ?? null,\n\t\t\t\tinput.expectedBehavior.trim(),\n\t\t\t\tinput.actualBehavior.trim(),\n\t\t\t\tJSON.stringify(input.evidenceRefs),\n\t\t\t\tinput.occurrenceCount ?? 1,\n\t\t\t\tnormalizedResourceId,\n\t\t\t\tinput.baseVersion ?? null,\n\t\t\t\tinput.projectId ?? null,\n\t\t\t\tinput.taskId ?? null,\n\t\t\t\tinput.sessionId ?? null,\n\t\t\t\tinput.entryId ?? null,\n\t\t\t\tinput.toolCallId ?? null,\n\t\t\t\t\"observed\",\n\t\t\t\t\"pending_classification\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\n\t\t// 全部证据引用写入 evolution_source_links（owner_kind='problem'）：\n\t\t// src- 前缀是真 sources 行；其他是宿主稳定引用（friction:/toolcall: 等），\n\t\t// 都作去重键。来源删除回查按 src- ID 查，不受其他引用影响。\n\t\tfor (const ref of input.evidenceRefs) {\n\t\t\tinsertProblemSourceLink(store, problemId, ref, now);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\taccepted: true,\n\t\t\tproblemId,\n\t\t\tdisposition: \"pending_classification\" as const,\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形引用解析为记忆修订坐标；不匹配返回 undefined。 */\nconst MEMORY_REVISION_REF_RE = /^mem-(.+?)@rev-(\\d+)$/;\n\n/**\n * 插入 problem → source 关联；同 (owner_kind, owner_id, source_id) 幂等跳过。\n * 返回 true = 本次新插入（此前未关联）；false = 关联已存在（同事件重放）。\n * O10/E02：mem-*@rev-* 形引用补写 memory_id/revision 列，供详情页按记忆回读。\n */\nfunction insertProblemSourceLink(store: MemoryStore, problemId: string, sourceId: string, createdAt: string): boolean {\n\tconst mem = MEMORY_REVISION_REF_RE.exec(sourceId);\n\ttry {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-${randomUUID()}`, problemId, sourceId, mem?.[1] ?? null, mem?.[2] === undefined ? null : Number(mem[2]), createdAt);\n\t\treturn true;\n\t} catch (error) {\n\t\t// UNIQUE(owner_kind, owner_id, source_id) 冲突：同来源重复申报的幂等补链，跳过。\n\t\tif (error instanceof Error && error.message.includes(\"UNIQUE\")) return false;\n\t\tthrow error;\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. collectEvolutionProblem —— 从失败回执/用户纠正收集事实\n// ════════════════════════════════════════════════════════════════════════\n\n/** `collectEvolutionProblem` 的输入。 */\nexport interface CollectEvolutionProblemInput {\n\t/** 失败条件/实际行为描述。 */\n\tactualBehavior: string;\n\t/** 预期行为描述。 */\n\texpectedBehavior: string;\n\t/** 问题摘要。 */\n\tsummary: string;\n\t/** 问题类别（可选；缺省 implementation_defect 先登记待分类）。 */\n\tkind?: EvolutionProblemKind;\n\t/** 建议动作（可选）。 */\n\taction?: EvolutionProblemAction;\n\t/** 目标资源（有明确目标时）。 */\n\tresourceId?: string;\n\t/** 基础版本。 */\n\tbaseVersion?: string;\n\t/** 已用记忆修订（sourceId 列表）。 */\n\tmemoryRevisionRefs?: string[];\n\t/** 宿主补的 taskId。 */\n\ttaskId?: string;\n\t/** 宿主补的 sessionId。 */\n\tsessionId?: string;\n\t/** 宿主补的 entryId。 */\n\tentryId?: string;\n\t/** 宿主补的 toolCallId。 */\n\ttoolCallId?: string;\n\t/** 来源 ID 列表（稳定引用；至少一条）。 */\n\tsourceIds: string[];\n\t/** 登记时间（夹具注入）。 */\n\tcreatedAt?: string;\n\t/** 独立事实来源计算的发生次数；缺省 1。 */\n\toccurrenceCount?: number;\n}\n\n/**\n * 从失败回执/用户纠正/使用记录收集问题事实。\n *\n * 只读事实输入：sourceIds 是已登记来源；memoryRevisionRefs 是已用记忆修订。\n * 已有同来源问题复用 ID；不凭模型建议造「重复发生」。\n */\nexport function collectEvolutionProblem(\n\tstore: MemoryStore,\n\tinput: CollectEvolutionProblemInput,\n): MemoryResult<DeclareImprovementIntentResult> {\n\t// 组装证据引用：sourceIds + memoryRevisionRefs + toolCallId（若有）。\n\tconst evidenceRefs = [...input.sourceIds];\n\tif (input.memoryRevisionRefs) evidenceRefs.push(...input.memoryRevisionRefs);\n\tif (input.toolCallId) evidenceRefs.push(`toolcall:${input.toolCallId}`);\n\n\treturn declareImprovementIntent(store, {\n\t\t// O10：真实 kind 透传（unused_experience 等登记时已知类别的申报不再被\n\t\t// 压成 implementation_defect）；缺省先标实现缺陷，分类时再纠正。\n\t\tkind: input.kind ?? \"implementation_defect\",\n\t\taction: input.action,\n\t\tsummary: input.summary,\n\t\texpectedBehavior: input.expectedBehavior,\n\t\tactualBehavior: input.actualBehavior,\n\t\tevidenceRefs,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\ttaskId: input.taskId,\n\t\tsessionId: input.sessionId,\n\t\tentryId: input.entryId,\n\t\ttoolCallId: input.toolCallId,\n\t\tcreatedAt: input.createdAt,\n\t\toccurrenceCount: input.occurrenceCount,\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. classifyProblem —— S8-04 分类\n// ════════════════════════════════════════════════════════════════════════\n\n/** `classifyProblem` 的输入。 */\nexport interface ClassifyProblemInput {\n\tproblemId: string;\n\t/** 分类时判定的原因（覆盖登记时的 reason）。 */\n\treason?: string;\n\t/** 分类时间（夹具注入）。 */\n\tclassifiedAt?: string;\n}\n\n/** `classifyProblem` 的输出。 */\nexport interface ClassifyProblemResult {\n\tproblemId: string;\n\tkind: EvolutionProblemKind;\n\taction?: EvolutionProblemAction;\n\treason: string;\n}\n\n/**\n * 对已登记问题分类（S8-04）。\n *\n * 顺序：\n * 1. 查当时是否召回/注入正确经验（unused_experience）——优先改检索/提示策略；\n * 2. 查调用参数/实现版本（invocation / implementation_defect）；\n * 3. 核心缺陷输出 development_suggestion。\n *\n * 只读事实：用 memory_usage 表核对同 task/session 下相关记忆是否被\n * search/inject/expand/used；有命中且未 used 则倾向 unused_experience。\n * O10/E03 收窄：仅当问题与某条记忆修订**明确关联**（evidenceRefs 含该\n * memoryId/mem-*@rev-N，或 taskId/toolCallId 与未采用记录的 request_id\n * 重合）才改判 unused_experience；同 task/session 下无关的未采用记忆不覆盖\n * 原分类——禁止对象判断先于可改资源选择。\n */\nexport function classifyProblem(\n\tstore: MemoryStore,\n\tinput: ClassifyProblemInput,\n): MemoryResult<ClassifyProblemResult> {\n\tconst now = input.classifiedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态不再分类。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn fail(\"invalid_input\", `问题已终态(${problem.status})，不再分类`, input.problemId);\n\t\t}\n\n\t\t// 1) 先查是否未采用已有经验：\n\t\t//    同 task/session 下，若有 memory_usage 记录显示某记忆被 search/inject/expand\n\t\t//    但未被 used，说明已有经验没被采用——问题类别应为 unused_experience。\n\t\tlet kind: EvolutionProblemKind = problem.kind;\n\t\tlet action: EvolutionProblemAction | undefined = problem.action;\n\t\tlet reason = input.reason ?? problem.reason ?? \"\";\n\n\t\tconst unused = detectUnusedExperience(store, problem);\n\t\tif (unused !== undefined) {\n\t\t\tkind = \"unused_experience\";\n\t\t\taction = \"modify\"; // 优先改检索/提示策略（memory-policy 资源）\n\t\t\treason = reason || `已有经验 ${unused.memoryId}@rev${unused.revision} 未被采用`;\n\t\t} else if (kind === \"core_issue\") {\n\t\t\t// 2) 核心缺陷：动作固定 development_suggestion。\n\t\t\taction = \"development_suggestion\";\n\t\t} else if (kind === \"invocation\") {\n\t\t\t// 3) 调用方式问题：参数误用/上下文组织错误，动作 modify（改命令/扩展参数组织）。\n\t\t\taction = action ?? \"modify\";\n\t\t} else if (kind === \"implementation_defect\") {\n\t\t\t// 4) 资源实现缺陷：动作 modify（改资源正文/实现）。\n\t\t\taction = action ?? \"modify\";\n\t\t}\n\n\t\t// 写回分类结果并推进状态机。\n\t\tconst nextStatus: EvolutionProblemStatus = \"classified\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET kind = ?, action = ?, reason = ?, status = ?, disposition = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(kind, action ?? null, reason || null, nextStatus, \"pending_classification\", now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\tkind,\n\t\t\t...(action === undefined ? {} : { action }),\n\t\t\treason: reason || \"分类完成\",\n\t\t};\n\t});\n}\n\n/** `mem-<id>@rev-<n>` 形证据引用解析；也容忍裸 memoryId 引用。 */\nconst EVIDENCE_MEMORY_REV_RE = /mem-(.+?)@rev-(\\d+)/;\n\n/**\n * 检测与问题**明确关联**的「已召回但未采用」记忆（O10/E03 收窄）。\n *\n * 关联判据（任一满足才算明确关联，缺省不覆盖原分类）：\n * - 问题 evidenceRefs 含 `mem-<id>@rev-<n>` 引用；\n * - 问题 taskId/toolCallId 命中该未采用记录的 request_id（同一调用上下文）；\n * - 问题与该未采用记录同 session 且 request_id 也命中 taskId/toolCallId\n *   （问题只有 sessionId 时的最窄依据——同请求注入未采用即「当时没用它」）。\n * 同 task/session 下与问题无关的未采用记录不再把问题改判 unused_experience。\n */\nfunction detectUnusedExperience(\n\tstore: MemoryStore,\n\tproblem: EvolutionProblem,\n): { memoryId: string; revision: number } | undefined {\n\tif (problem.taskId === undefined && problem.sessionId === undefined) return undefined;\n\tconst where: string[] = [];\n\tconst params: unknown[] = [];\n\tif (problem.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(problem.taskId);\n\t}\n\tif (problem.sessionId !== undefined) {\n\t\twhere.push(\"session_id = ?\");\n\t\tparams.push(problem.sessionId);\n\t}\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT memory_id, revision, action, request_id, session_id FROM memory_usage\n\t\t\t WHERE ${where.join(\" AND \")}\n\t\t\t ORDER BY created_at`,\n\t\t)\n\t\t.all(...(params as never[])) as unknown as Array<{\n\t\tmemory_id: string;\n\t\trevision: number;\n\t\taction: string;\n\t\trequest_id: string | null;\n\t\tsession_id: string | null;\n\t}>;\n\n\t// 按 memoryId+revision 分组：有 search/inject/expand 但无 used → 未采用。\n\tconst byKey = new Map<\n\t\tstring,\n\t\t{ memoryId: string; revision: number; actions: Set<string>; requestIds: Set<string>; sessionIds: Set<string> }\n\t>();\n\tfor (const row of rows) {\n\t\tconst key = `${row.memory_id}@${row.revision}`;\n\t\tconst entry =\n\t\t\tbyKey.get(key) ?? {\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t\tactions: new Set(),\n\t\t\t\trequestIds: new Set(),\n\t\t\t\tsessionIds: new Set(),\n\t\t\t};\n\t\tentry.actions.add(row.action);\n\t\tif (row.request_id !== null) entry.requestIds.add(row.request_id);\n\t\tif (row.session_id !== null) entry.sessionIds.add(row.session_id);\n\t\tbyKey.set(key, entry);\n\t}\n\n\t// 问题侧关联键：evidenceRefs 里解析出的 mem-*@rev-* 坐标，\n\t// 以及能与 memory_usage.request_id 对齐的身份键（taskId/toolCallId）。\n\tconst refKeys = new Set<string>();\n\tfor (const ref of problem.evidenceRefs) {\n\t\tconst match = EVIDENCE_MEMORY_REV_RE.exec(ref);\n\t\tif (match) refKeys.add(`${match[1]}@${match[2]}`);\n\t}\n\tconst identityKeys = [problem.taskId, problem.toolCallId].filter((value): value is string => value !== undefined);\n\n\tfor (const [key, entry] of byKey.entries()) {\n\t\tif (\n\t\t\t!(entry.actions.has(\"search\") || entry.actions.has(\"inject\") || entry.actions.has(\"expand\")) ||\n\t\t\tentry.actions.has(\"used\")\n\t\t) {\n\t\t\tcontinue;\n\t\t}\n\t\t// 明确关联判据：证据引用指向该修订；身份键与某条记录的 request_id 重合；\n\t\t// 或问题与该记录同 session 且 request_id 也命中身份键——同会话同请求\n\t\t// 注入未采用即「当时没用它」。纯同 task/session 的无关记录不关联。\n\t\tconst linkedByRef = refKeys.has(key);\n\t\tconst linkedByRequest = identityKeys.some((id) => entry.requestIds.has(id));\n\t\tconst linkedBySession =\n\t\t\tproblem.sessionId !== undefined && entry.sessionIds.has(problem.sessionId) && entry.requestIds.size > 0;\n\t\tif (linkedByRef || linkedByRequest || linkedBySession) {\n\t\t\treturn { memoryId: entry.memoryId, revision: entry.revision };\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. 内部 SQL\n// ════════════════════════════════════════════════════════════════════════\n\n/** 按 problemId 取完整行（select 等模块的行读取统一走这里）。 */\nexport function getProblemRow(store: MemoryStore, problemId: string): EvolutionProblemDbRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t        project_id, task_id, session_id, entry_id, tool_call_id,\n\t\t\t        status, disposition, created_at, updated_at\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(problemId) as EvolutionProblemDbRow | undefined;\n}\n\n/** 按 problemId 取已登记问题（公开查询）。 */\nexport function getEvolutionProblem(store: MemoryStore, problemId: string): MemoryResult<EvolutionProblem> {\n\tconst row = getProblemRow(store, problemId);\n\tif (!row) return fail(\"invalid_input\", `问题未登记:${problemId}`, problemId);\n\treturn { ok: true, ...rowToProblem(row) };\n}\n\n/** 取某来源关联的全部问题（沿删除入口回查用）。 */\nexport function problemsForSource(store: MemoryStore, sourceId: string): EvolutionProblem[] {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT p.problem_id, p.kind, p.action, p.summary, p.reason, p.expected_behavior, p.actual_behavior,\n\t\t\t        p.evidence_refs_json, p.occurrence_count, p.resource_id, p.base_version,\n\t\t\t        p.project_id, p.task_id, p.session_id, p.entry_id, p.tool_call_id,\n\t\t\t        p.status, p.disposition, p.created_at, p.updated_at\n\t\t\t FROM evolution_source_links l\n\t\t\t JOIN evolution_problems p ON p.problem_id = l.owner_id\n\t\t\t WHERE l.owner_kind = 'problem' AND l.source_id = ?\n\t\t\t ORDER BY p.created_at`,\n\t\t)\n\t\t.all(sourceId) as unknown as EvolutionProblemDbRow[];\n\treturn rows.map(rowToProblem);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"warning","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * 受控自进化重启恢复（S9-11）。\n *\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith?.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\treturn { ok: true, ...report };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":196}},{"diffOp":{"equal":{"range":[51,85]}}},{"diffOp":{"equal":{"range":[85,95]}}},{"diffOp":{"delete":{"range":[95,129]}}},{"diffOp":{"insert":{"range":[129,141]}}},{"diffOp":{"equal":{"range":[141,152]}}},{"diffOp":{"equal":{"range":[152,266]}}},{"equalLines":{"line_count":74}},{"diffOp":{"equal":{"range":[266,301]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\recovery.ts"},"span":[8962,9017],"sourceCode":"/**\n * 受控自进化重启恢复（S9-11）。\n *\n * 职责：`recoverEvolutionState` 在宿主重启后读全量资源 + activation 凭据 +\n * 任务绑定，核对持久化状态与盘上版本目录的一致性，产出恢复报告。\n * **只读 + 核对，不改任何指向或标记**——决定换版/降级/重激活是宿主的活。\n *\n * 契约（S9 任务书 §5）：\n * - 读 activation/rollback + taskBinding：effective_version 指向的版本目录\n *   必须完整（指纹核对）；不完整则保留旧指向 + 标 pending，不主动改指。\n * - 未完成发布：有 publish-落盘凭据但无 effective 凭据的候选 → 报「待激活」\n *   清单（不自动激活，等宿主流程决定）。\n * - 读 active task_bindings → 核对 versionDir 存在；缺失的标出来（宿主决定\n *   换版/降级），不改绑定。\n * - 不重复付费重验已提交证据：恢复只读库与目录指纹，不触发验证流程。\n * - 不重复通知：activations 行即送达记录，重启重读即可，不去重通知持久化\n *   （通知是瞬时的——宿主重启后从 activations 表能还原全部已发生事件）。\n */\nimport { existsSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { fingerprintResourceRoot } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一个「待激活」候选（publish-落盘凭据在、effective 凭据不在）。 */\nexport interface PendingActivation {\n\t/** 候选 ID（从 publish-落盘凭据的 source_links_json.candidateId 读）。 */\n\tcandidateId: string;\n\t/** 该候选固化成的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录是否完整可读（不完整时宿主不该激活）。 */\n\tdirComplete: boolean;\n\t/** 凭据写入时间。 */\n\tpublishedAt: string;\n}\n\n/** 一个失效绑定（绑定指向的版本目录缺失/不完整）。 */\nexport interface StaleBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定指向的版本 ID。 */\n\tversionId: string;\n\t/** 失效原因（目录缺失/指纹不匹配/目录为空）。 */\n\treason: string;\n}\n\n/** 单个资源的恢复视图。 */\nexport interface ResourceRecovery {\n\tresourceId: string;\n\t/** 当前 effective_version（未设过时缺省）。 */\n\teffectiveVersion?: string;\n\t/** 指向版本目录是否完整可读（无指向时 false）。 */\n\tdirOk: boolean;\n\t/** 指向目录是否完整但缺 activation 凭据（理论异常，如实报）。 */\n\tmissingCredential: boolean;\n\t/** 该资源的待激活候选（publish-落盘凭据在、effective 凭据不在）。 */\n\tpendingPublish: PendingActivation[];\n\t/** 该资源失效的 active 绑定（版本目录缺失）。 */\n\tstaleBindings: StaleBinding[];\n}\n\n/** `recoverEvolutionState` 的输出。 */\nexport interface RecoveryReport {\n\t/** 全部已登记资源的恢复视图（按 resourceId 排序）。 */\n\tresources: ResourceRecovery[];\n\t/** 全部待激活候选（跨资源汇总，便于宿主一次性处理）。 */\n\tunfinishedActivations: PendingActivation[];\n\t/** 需人工/宿主关注项（目录缺失的生效指向、失效绑定、缺凭据的完整目录）。 */\n\tneedsAttention: Array<{\n\t\tresourceId: string;\n\t\tkind: \"effective_dir_missing\" | \"stale_binding\" | \"version_without_credential\";\n\t\tdetail: string;\n\t}>;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 内部：目录指纹与凭据读取\n// ════════════════════════════════════════════════════════════════════════\n\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n// O13/S9-11：目录指纹已收拢到 versions.ts 的 fingerprintResourceRoot 共享实现\n// （本模块的第 4 份私有副本随首次接入生产路径一并收口）。\n\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\n\tconst current = fingerprintResourceRoot(versionDir);\n\tif (current.fileCount === 0) return false;\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tsource_links_json: string | null;\n\tcreated_at: string;\n}\n\nfunction parseSourceLinks(json: string | null): Record<string, unknown> {\n\tif (json === null) return {};\n\ttry {\n\t\treturn JSON.parse(json) as Record<string, unknown>;\n\t} catch {\n\t\treturn {};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. recoverEvolutionState\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 重启后核对全量资源的持久化状态与盘上版本目录。\n *\n * 对每个已登记资源：\n * 1. `effective_version` 指向的版本目录指纹核对 → dirOk；缺失/不完整 →\n *    needsAttention(kind='effective_dir_missing')，**不主动改指向**\n *    （指向的修订只能走 activation/rollback/restore 事务）。\n * 2. 该资源 kind='publish' 且 activation='effective' 的凭据不存在但目录完整 →\n *    needsAttention(kind='version_without_credential')（理论异常，如实报）。\n * 3. publish-落盘凭据在、对应版本无 activation='effective' 凭据 → 待激活清单。\n * 4. active task_bindings 指向的版本目录缺失 → staleBindings +\n *    needsAttention(kind='stale_binding')，不改绑定（宿主决定换版/降级）。\n *\n * 不重复付费重验：全程只读库 + 目录指纹，无验证/进程/模型调用。\n */\nexport function recoverEvolutionState(\n\tstore: MemoryStore,\n\tinput: { paoHome: string },\n): MemoryResult<RecoveryReport> {\n\tconst versions = evolutionPaths(input.paoHome).versions;\n\tconst report: RecoveryReport = {\n\t\tresources: [],\n\t\tunfinishedActivations: [],\n\t\tneedsAttention: [],\n\t};\n\n\tconst resourceRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, effective_version FROM evolution_resources ORDER BY resource_id`,\n\t\t)\n\t\t.all() as Array<{ resource_id: string; effective_version: string | null }>;\n\n\tfor (const rr of resourceRows) {\n\t\tconst resourceId = rr.resource_id;\n\t\tconst dirSafe = dirSafeId(resourceId);\n\t\tconst view: ResourceRecovery = {\n\t\t\tresourceId,\n\t\t\t...(rr.effective_version === null ? {} : { effectiveVersion: rr.effective_version }),\n\t\t\tdirOk: false,\n\t\t\tmissingCredential: false,\n\t\t\tpendingPublish: [],\n\t\t\tstaleBindings: [],\n\t\t};\n\n\t\t// 1. effective_version 指向目录核对。\n\t\tif (rr.effective_version !== null) {\n\t\t\tconst versionDir = join(versions, dirSafe, rr.effective_version);\n\t\t\tview.dirOk = isVersionDirComplete(versionDir, rr.effective_version);\n\t\t\tif (!view.dirOk) {\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"effective_dir_missing\",\n\t\t\t\t\tdetail:\n\t\t\t\t\t\t`effective_version ${rr.effective_version} 指向目录缺失或指纹不匹配:${versionDir}` +\n\t\t\t\t\t\t`（保留旧指向不主动改，宿主须决定恢复/降级路径）`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\t// 2. 该资源全部 activation（找凭据缺口与待激活）。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT activation_id, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t\t)\n\t\t\t.all(resourceId) as unknown as ActivationRow[];\n\n\t\t// 按 to_version 归并：该版本是否已有 activation='effective' 凭据、是否有\n\t\t// publish-落盘凭据（candidateId）。\n\t\tconst versionState = new Map<\n\t\t\tstring,\n\t\t\t{ effective: boolean; publishCandidateId?: string; publishAt?: string; disabled: boolean }\n\t\t>();\n\t\tfor (const act of acts) {\n\t\t\tconst cur = versionState.get(act.to_version) ?? {\n\t\t\t\teffective: false,\n\t\t\t\tdisabled: false,\n\t\t\t};\n\t\t\tif (act.reason !== null && act.reason.startsWith(\"停用:\")) cur.disabled = true;\n\t\t\tif (act.kind === \"publish\") {\n\t\t\t\tconst links = parseSourceLinks(act.source_links_json);\n\t\t\t\tif (links[\"activation\"] === \"effective\") {\n\t\t\t\t\tcur.effective = true;\n\t\t\t\t} else if (typeof links[\"candidateId\"] === \"string\") {\n\t\t\t\t\tcur.publishCandidateId = links[\"candidateId\"];\n\t\t\t\t\tcur.publishAt = act.created_at;\n\t\t\t\t}\n\t\t\t}\n\t\t\tversionState.set(act.to_version, cur);\n\t\t}\n\n\t\t// 3. 待激活：publish-落盘凭据在、effective 凭据不在、未被停用。\n\t\tfor (const [versionId, state] of versionState) {\n\t\t\tif (state.publishCandidateId !== undefined && !state.effective && !state.disabled) {\n\t\t\t\tconst versionDir = join(versions, dirSafe, versionId);\n\t\t\t\tconst pending: PendingActivation = {\n\t\t\t\t\tcandidateId: state.publishCandidateId,\n\t\t\t\t\tversionId,\n\t\t\t\t\tdirComplete: isVersionDirComplete(versionDir, versionId),\n\t\t\t\t\tpublishedAt: state.publishAt ?? \"\",\n\t\t\t\t};\n\t\t\t\tview.pendingPublish.push(pending);\n\t\t\t\treport.unfinishedActivations.push(pending);\n\t\t\t}\n\t\t}\n\n\t\t// 4. 生效指向完整目录但无 effective 凭据（理论异常）。\n\t\tif (\n\t\t\trr.effective_version !== null &&\n\t\t\tview.dirOk &&\n\t\t\tversionState.get(rr.effective_version)?.effective !== true\n\t\t) {\n\t\t\tview.missingCredential = true;\n\t\t\treport.needsAttention.push({\n\t\t\t\tresourceId,\n\t\t\t\tkind: \"version_without_credential\",\n\t\t\t\tdetail:\n\t\t\t\t\t`effective_version ${rr.effective_version} 目录完整但无 activation='effective' ` +\n\t\t\t\t\t`凭据（异常状态：指向被写入但凭据未落库）`,\n\t\t\t});\n\t\t}\n\n\t\t// 5. active 绑定指向目录核对。\n\t\tconst bindings = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, task_id, version_id FROM evolution_task_bindings\n\t\t\t\t WHERE resource_id = ? AND active = 1`,\n\t\t\t)\n\t\t\t.all(resourceId) as Array<{ binding_id: string; task_id: string; version_id: string }>;\n\t\tfor (const b of bindings) {\n\t\t\tconst versionDir = join(versions, dirSafe, b.version_id);\n\t\t\tif (!isVersionDirComplete(versionDir, b.version_id)) {\n\t\t\t\tconst reason = !existsSync(versionDir)\n\t\t\t\t\t? \"版本目录不存在\"\n\t\t\t\t\t: fingerprintResourceRoot(versionDir).fileCount === 0\n\t\t\t\t\t\t? \"版本目录为空\"\n\t\t\t\t\t\t: \"指纹不匹配（文件被删/改）\";\n\t\t\t\tconst stale: StaleBinding = {\n\t\t\t\t\tbindingId: b.binding_id,\n\t\t\t\t\ttaskId: b.task_id,\n\t\t\t\t\tversionId: b.version_id,\n\t\t\t\t\treason,\n\t\t\t\t};\n\t\t\t\tview.staleBindings.push(stale);\n\t\t\t\treport.needsAttention.push({\n\t\t\t\t\tresourceId,\n\t\t\t\t\tkind: \"stale_binding\",\n\t\t\t\t\tdetail: `任务 ${b.task_id} 绑定版本 ${b.version_id} 失效:${reason}`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\n\t\treport.resources.push(view);\n\t}\n\n\treturn { ok: true, ...report };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化隔离验证执行器（S8-08）。\n * */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, join, relative, resolve, sep } from \"node:path\";\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,60]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[60,199]}}},{"diffOp":{"delete":{"range":[199,207]}}},{"diffOp":{"delete":{"range":[207,209]}}},{"diffOp":{"equal":{"range":[209,341]}}},{"equalLines":{"line_count":743}},{"diffOp":{"equal":{"range":[341,347]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\runner.ts"},"span":[1791,1799],"sourceCode":"/**\n * 受控自进化隔离验证执行器（S8-08）。\n *\n * 职责：为一个冻结 `ValidationCase` 分别在 baseline / candidate 两侧各建独立\n * home、cwd、sessionDir，从同一份 `initialFiles` 复制后运行，回收运行回执。\n *\n * 契约（S8 任务书 §5 与实施路径 §6）：\n * - baseline/candidate 各建独立 home、cwd、sessionDir；同一 initialFiles 复制。\n * - 纯命令用例用 `runCardProcess(cmd,args,cwd,timeoutMs,env,signal)` 启动已批准\n *   验证器；命令先过 `checkCommandSafety` 安检门。\n * - 技能效果类用例用隔离验证进程内受控入口：显式传 agentDir、modelRuntime、\n *   sessionManager、resourceLoader、tools；工具只保留 `case.allowedTools`。\n * - 通过 `additionalSkillPaths`/`additionalExtensionPaths` 加载指定版本；\n *   默认自动发现不能带入正式 home 或另一候选。\n * - 运行回执保存输出、退出码、相关文件变化、模型配置、requestId、费用、\n *   取消原因；落盘在 `evolution/validations/<testPlanId>/runs/`（核心管理位置，\n *   不在候选可写目录）。\n * - 子进程模型认证沿现有受控启动方式传入（隔离 home 内 agentDir），不复制\n *   用户凭证文件。\n * - 进程取消及超时能收尾；无正式会话/用户项目文件挂入候选可写区。\n *\n * 边界声明：本模块不提供操作系统沙箱。隔离靠「独立 scratch 目录 + 白名单环境 +\n * 事后文件树对比 + 受控入口」；候选进程能写 scratch 父链上的内容时由\n * `fileChanges` 与 boundary 核对兜底，不声称路径白名单已隔离。\n */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, join, relative, resolve, sep } from \"node:path\";\nimport { type CardProcessResult, runCardProcess } from \"../cards/process.ts\";\nimport { checkCommandSafety } from \"../cards/verifier.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport { resolveValidationToolSet } from \"./boundary.ts\";\nimport type { ValidationCase, ValidationRunResult } from \"./types.ts\";\nimport { fingerprintResourceRoot, listResourceFiles } from \"./versions.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 用例形态：纯命令验证 or 隔离 agent 会话的技能效果验证。 */\nexport type ValidationRunKind = \"command\" | \"agent\";\n\n/** 运行侧：baseline（旧版）或 candidate（候选副本）。 */\nexport type ValidationSide = \"baseline\" | \"candidate\";\n\n/** 已批准验证器（命令型用例）：核心定义的命令，不来自候选。 */\nexport interface ApprovedVerifier {\n\t/** 命令头（相对/可执行名）。 */\n\tcmd: string;\n\t/** 参数数组。 */\n\targs?: string[];\n\t/** 附加环境（白名单净化基础上叠加；不得含凭证）。 */\n\tenv?: Record<string, string>;\n}\n\n/** 隔离 agent 会话工厂的依赖注入面（测试可换假实现）。 */\nexport interface AgentSessionFactoryInput {\n\t/** 隔离 home 根（本次运行专用）。 */\n\thomeDir: string;\n\t/** 隔离工作目录（initialFiles 已复制进来）。 */\n\tcwd: string;\n\t/** 隔离 sessionDir。 */\n\tsessionDir: string;\n\t/** 隔离 agentDir（`<home>/agent`；认证沿受控启动方式从该目录读）。 */\n\tagentDir: string;\n\t/** 冻结用例。 */\n\tvalidationCase: ValidationCase;\n\t/** 版本化资源副本路径（技能/扩展目录；经 additionalSkillPaths/additionalExtensionPaths 挂接）。 */\n\tresourceCopyDir?: string;\n\t/** 资源加载方式（决定挂到 additionalSkillPaths 还是 additionalExtensionPaths）。 */\n\tloadMethod?: \"skill-path\" | \"extension-path\" | string;\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/**\n\t * 超时毫秒（O10/E10）：编排层给的收口上限；到达后等同 abort。\n\t * 接口仅声明字段——工厂实现与超时/AbortSignal 具体收口归 O11。\n\t */\n\ttimeoutMs?: number;\n\t/** 模型配置（档位/模型名；原样传给受控入口）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** 隔离 agent 会话的运行结果。 */\nexport interface AgentSessionRunOutcome {\n\t/** 输出摘要（assistant 文本拼接）。 */\n\toutput: string;\n\t/**\n\t * 会话是否完整结束（O11/E07）：「会话跑完」与「验收通过」分开——\n\t * completed=true 只表示会话正常收尾，不表示判据通过；判据由\n\t * acceptance 核对（编排层/evaluate）给出。未提供时 runner 按 output\n\t * 非空回退判定（兼容只回 output 的旧假工厂）。\n\t */\n\tcompleted?: boolean;\n\t/** requestId（受控入口返回）。 */\n\trequestId?: string;\n\t/** 用量引用。 */\n\tusageRef?: string;\n\t/** 取消原因（被取消/中止时——返回 abortReason 一律按执行故障记，不可通过）。 */\n\tabortReason?: string;\n}\n\n/** `runValidationCase` 的依赖注入面。 */\nexport interface RunValidationCaseDeps {\n\t/** 隔离 agent 会话工厂（技能效果类用例）；缺省时 agent 用例返回 unavailable。 */\n\tagentSessionFactory?: (input: AgentSessionFactoryInput) => Promise<AgentSessionRunOutcome>;\n\t/** 命令执行器（缺省 `runCardProcess`；测试可换假实现）。 */\n\tprocessRunner?: typeof runCardProcess;\n\t/** scratch 根（缺省 `<系统临时目录>/pao-evolution-run`）。 */\n\tscratchRoot?: string;\n\t/** 是否保留 scratch（排障用；缺省 false，run 结束整体删除）。 */\n\tkeepScratch?: boolean;\n}\n\n/** `runValidationCase` 的输入。 */\nexport interface RunValidationCaseInput {\n\t/** 冻结用例。 */\n\tvalidationCase: ValidationCase;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本。 */\n\tbaseVersion: string;\n\t/** 运行侧。 */\n\tside: ValidationSide;\n\t/** 候选 ID（side=candidate 时必填）。 */\n\tcandidateId?: string;\n\t/** 冻结计划 ID（回执落盘归属）。 */\n\ttestPlanId: string;\n\t/** PAO_HOME 根（回执落盘用）。 */\n\tpaoHome: string;\n\t/** 用例形态。 */\n\tkind: ValidationRunKind;\n\t/** 已批准验证器（kind=command 必填）。 */\n\tverifier?: ApprovedVerifier;\n\t/** 单条命令超时毫秒；缺省 120000。 */\n\ttimeoutMs?: number;\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 版本化资源副本目录（kind=agent 时经 additionalSkillPaths/additionalExtensionPaths 挂接）。 */\n\tresourceCopyDir?: string;\n\t/** 资源加载方式（kind=agent 时决定挂接路径）。 */\n\tloadMethod?: \"skill-path\" | \"extension-path\" | string;\n\t/** 运行时间（夹具注入）。 */\n\trunAt?: string;\n}\n\n/** `runValidationCase` 的成功输出。 */\nexport interface RunValidationCaseResult {\n\t/** 运行回执（不含 usageRef 时由调用方聚合）。 */\n\tresult: ValidationRunResult;\n\t/** 回执落盘路径（evolution/validations/<testPlanId>/runs/…）。 */\n\treceiptPath: string;\n\t/** 隔离 scratch 根（keepScratch 时保留供排障；否则已删除）。 */\n\tscratchDir?: string;\n\t/** 取消原因（被取消时）。 */\n\tcancelReason?: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 隔离 scratch 与环境\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 隔离 scratch 布局：`<scratch>/<caseId>-<side>-<rand>/{home,work,session,agent}`。 */\ninterface ScratchLayout {\n\troot: string;\n\thomeDir: string;\n\tworkDir: string;\n\tsessionDir: string;\n\tagentDir: string;\n}\n\nfunction makeScratch(scratchRoot: string | undefined, caseId: string, side: ValidationSide): ScratchLayout {\n\tconst base = scratchRoot ?? join(tmpdir(), \"pao-evolution-run\");\n\tconst root = join(base, `${caseId}-${side}-${randomUUID().slice(0, 8)}`);\n\tconst layout: ScratchLayout = {\n\t\troot,\n\t\thomeDir: join(root, \"home\"),\n\t\tworkDir: join(root, \"work\"),\n\t\tsessionDir: join(root, \"session\"),\n\t\tagentDir: join(root, \"home\", \"agent\"),\n\t};\n\tfor (const dir of [layout.homeDir, layout.workDir, layout.sessionDir, layout.agentDir]) {\n\t\tmkdirSync(dir, { recursive: true });\n\t}\n\treturn layout;\n}\n\n/** 把 initialFiles 复制进 workDir；返回相对路径清单。 */\nfunction materializeInitialFiles(workDir: string, initialFiles: Record<string, string>): string[] {\n\tconst written: string[] = [];\n\tfor (const [rel, content] of Object.entries(initialFiles)) {\n\t\tconst normalized = rel.replace(/\\\\/g, \"/\").replace(/^\\/+/, \"\");\n\t\t// 初始文件不允许越出 workDir；`..` 段直接抛错（输入非法，不是运行时失败）。\n\t\tconst abs = resolve(workDir, normalized);\n\t\tconst relToWork = relative(workDir, abs).replace(/\\\\/g, \"/\");\n\t\tif (relToWork === \"..\" || relToWork.startsWith(`..${sep}`) || relToWork.startsWith(\"../\")) {\n\t\t\tthrow new Error(`initialFiles 含越界路径:${rel}`);\n\t\t}\n\t\tmkdirSync(dirname(abs), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t\twritten.push(normalized);\n\t}\n\treturn written;\n}\n\n/** resourceId → 目录安全名（`:` → `_`，与 versions/candidates 同规则）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/**\n * 版本副本物化（O11/E07）：把「该侧应验证的资源正文」复制进 workDir 下的\n * 固定子目录 `resource/`。\n *\n * - baseline 侧来源：`evolution/versions/<dirSafeResourceId>/<baseVersion>/`\n *   （snapshotResourceFiles 当时固化的旧版正文）；\n * - candidate 侧来源：`evolution/candidates/<dirSafeResourceId>/<candidateId>/`\n *   （proposeCandidate 生成的候选目录）。\n *\n * 两侧差异来自已固化版本/候选目录本身，不由调用方逐侧塞不同 initialFiles\n * 制造。冻结用例的脚本/测试以相对路径 `resource/` 引用它（verifier 在\n * workDir 内执行自然读到对应侧正文）。\n *\n * 源目录缺失或为空时抛错（输入前置缺失，如实暴露——不静默跑一个没装\n * 资源的用例）。\n */\nfunction materializeVersionCopy(layout: ScratchLayout, input: RunValidationCaseInput): { resourceCopyDir: string; sourceDir: string } {\n\tconst dirSafe = dirSafeId(input.resourceId);\n\tconst paths = evolutionPaths(input.paoHome);\n\tconst sourceDir =\n\t\tinput.side === \"baseline\"\n\t\t\t? join(paths.versions, dirSafe, input.baseVersion)\n\t\t\t: join(paths.candidates, dirSafe, input.candidateId!);\n\tif (!existsSync(sourceDir)) {\n\t\tthrow new Error(\n\t\t\t`${input.side} 版本副本源目录不存在:${sourceDir}（baseline 应指向已固化 versions/<baseVersion>，candidate 应指向 candidates/<candidateId>）`,\n\t\t);\n\t}\n\tconst files = listResourceFiles(sourceDir);\n\tif (files.length === 0) {\n\t\tthrow new Error(`${input.side} 版本副本源目录为空:${sourceDir}`);\n\t}\n\tconst dest = join(layout.workDir, \"resource\");\n\tfor (const file of files) {\n\t\tconst target = join(dest, file.relativePath);\n\t\tmkdirSync(dirname(target), { recursive: true });\n\t\tcopyFileSync(file.absolutePath, target);\n\t}\n\treturn { resourceCopyDir: dest, sourceDir };\n}\n\n/** 递归列出目录文件（相对路径 + sha256）。 */\nfunction hashTree(root: string): Map<string, string> {\n\tconst out = new Map<string, string>();\n\tif (!existsSync(root)) return out;\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tconst content = readFileSync(full);\n\t\t\t\tout.set(relative(root, full).replace(/\\\\/g, \"/\"), createHash(\"sha256\").update(content).digest(\"hex\"));\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out;\n}\n\n/** 计算前后文件树差异；返回 相对路径 → 变化描述（`new:<hash>`/`changed:<hash>`/`deleted`）。 */\nfunction diffTrees(before: Map<string, string>, after: Map<string, string>): Record<string, string> {\n\tconst changes: Record<string, string> = {};\n\tfor (const [path, hash] of after) {\n\t\tconst prev = before.get(path);\n\t\tif (prev === undefined) changes[path] = `new:${hash}`;\n\t\telse if (prev !== hash) changes[path] = `changed:${hash}`;\n\t}\n\tfor (const path of before.keys()) {\n\t\tif (!after.has(path)) changes[path] = \"deleted\";\n\t}\n\treturn changes;\n}\n\n/**\n * 验证环境白名单（等价 verifier 的 sanitizedEnv；本模块不复用其私有实现）：\n * 只传进程运行必需的系统变量 + PAO_HOME 指向隔离 home；不带用户凭证/项目配置。\n */\nfunction sanitizedValidationEnv(homeDir: string): NodeJS.ProcessEnv {\n\tconst allowed = [\n\t\t\"PATH\",\n\t\t\"Path\",\n\t\t\"SystemRoot\",\n\t\t\"SYSTEMROOT\",\n\t\t\"SystemDrive\",\n\t\t\"ComSpec\",\n\t\t\"PATHEXT\",\n\t\t\"TEMP\",\n\t\t\"TMP\",\n\t\t\"USERPROFILE\",\n\t\t\"HOME\",\n\t\t\"NO_COLOR\",\n\t\t\"CI\",\n\t];\n\tconst env: NodeJS.ProcessEnv = {};\n\tfor (const key of allowed) {\n\t\tif (process.env[key] !== undefined) env[key] = process.env[key];\n\t}\n\t// 隔离 home：子进程内解析 PAO_HOME 一律落隔离区，不指正式现场。\n\tenv.PAO_HOME = homeDir;\n\treturn env;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 回执落盘（核心管理位置）\n// ════════════════════════════════════════════════════════════════════════\n\ninterface ValidationReceipt {\n\tcaseId: string;\n\tside: ValidationSide;\n\ttestPlanId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\tcandidateId?: string;\n\tkind: ValidationRunKind;\n\t/** 该侧物化的版本副本源目录（O11/E08：已验内容绑定的指纹比对对象）。 */\n\tresourceCopyDir?: string;\n\t/** 版本副本指纹（`v-{sha12(清单)}`——O11/E08 绑定「验过的正文」）。 */\n\tresourceFingerprint?: string;\n\tresult: ValidationRunResult;\n\tmodelConfig?: Record<string, unknown>;\n\trequestId?: string;\n\tcancelReason?: string;\n\trunAt: string;\n}\n\nfunction writeReceipt(paoHome: string, testPlanId: string, receipt: ValidationReceipt): string {\n\tconst dir = join(evolutionPaths(paoHome).validations, testPlanId, \"runs\");\n\tmkdirSync(dir, { recursive: true });\n\tconst filename = `${receipt.caseId}-${receipt.side}-${randomUUID().slice(0, 8)}.json`;\n\tconst file = join(dir, filename);\n\twriteFileSync(file, JSON.stringify(receipt, null, 2), \"utf8\");\n\treturn file;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. 命令型用例\n// ════════════════════════════════════════════════════════════════════════\n\nasync function executeCommandCase(\n\tlayout: ScratchLayout,\n\tinput: RunValidationCaseInput,\n\tdeps: RunValidationCaseDeps,\n\tbeforeTree: Map<string, string>,\n): Promise<{ run: ValidationRunResult; cancelReason?: string }> {\n\tconst verifier = input.verifier;\n\tif (!verifier) {\n\t\treturn { run: { passed: false, failureReason: \"kind=command 但缺 verifier\" } };\n\t}\n\tconst argv = [verifier.cmd, ...(verifier.args ?? [])];\n\tconst joined = argv.join(\" \");\n\tconst safety = checkCommandSafety(joined);\n\tif (!safety.过) {\n\t\treturn {\n\t\t\trun: { passed: false, failureReason: `验证器命令未过安检:${safety.违规.join(\"；\")}` },\n\t\t};\n\t}\n\tconst env = { ...sanitizedValidationEnv(layout.homeDir), ...(verifier.env ?? {}) };\n\tconst runner = deps.processRunner ?? runCardProcess;\n\tlet proc: CardProcessResult;\n\ttry {\n\t\tproc = await runner(\n\t\t\tverifier.cmd,\n\t\t\tverifier.args ?? [],\n\t\t\tlayout.workDir,\n\t\t\tinput.timeoutMs ?? 120000,\n\t\t\tenv,\n\t\t\tinput.signal,\n\t\t);\n\t} catch (error) {\n\t\t// AbortError 与停止未确认分开归类：取消保留取消语义。\n\t\tif (input.signal?.aborted || (error as Error).name === \"AbortError\") {\n\t\t\treturn {\n\t\t\t\trun: {\n\t\t\t\t\tpassed: false,\n\t\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\t\tfailureReason: `已取消:${(error as Error).message ?? String(error)}`,\n\t\t\t\t},\n\t\t\t\tcancelReason: String(input.signal?.reason ?? \"aborted\"),\n\t\t\t};\n\t\t}\n\t\t// 停止未确认/启动故障：如实记未完成（executionFailure=start），不伪装业务失败。\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: `进程启动/停止异常:${(error as Error).message ?? String(error)}`,\n\t\t\t},\n\t\t};\n\t}\n\tconst afterTree = hashTree(layout.workDir);\n\tconst fileChanges = diffTrees(beforeTree, afterTree);\n\tconst output = `${proc.stdout}${proc.stderr ? `\\n--- stderr ---\\n${proc.stderr}` : \"\"}`.trim();\n\t// 环境/执行故障（启动失败/超时）记结构化 executionFailure，不再塞进\n\t// failureReason 字符串——evaluate 据此判 incomplete，不把它当业务失败或通过。\n\tconst executionFailure =\n\t\tproc.failureKind === \"timeout\" || proc.failureKind === \"start\" ? proc.failureKind : undefined;\n\tconst passed = proc.code === 0 && executionFailure === undefined;\n\treturn {\n\t\trun: {\n\t\t\tpassed,\n\t\t\toutput: output.slice(0, 64 * 1024),\n\t\t\texitCode: proc.code,\n\t\t\tfileChanges,\n\t\t\t...(executionFailure ? { executionFailure } : {}),\n\t\t\t...(proc.failureKind ? { failureReason: `failureKind=${proc.failureKind}` } : {}),\n\t\t\t...(proc.outputTruncated ? { failureReason: `输出超过采集上限 ${proc.outputLimitBytes} 字节` } : {}),\n\t\t},\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. agent 会话型用例（技能/模板文本生效验证）\n// ════════════════════════════════════════════════════════════════════════\n\nasync function executeAgentCase(\n\tlayout: ScratchLayout,\n\tinput: RunValidationCaseInput,\n\tdeps: RunValidationCaseDeps,\n\tbeforeTree: Map<string, string>,\n): Promise<{ run: ValidationRunResult; cancelReason?: string; requestId?: string }> {\n\tif (!deps.agentSessionFactory) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: \"kind=agent 但未注入 agentSessionFactory（隔离验证入口未装配）\",\n\t\t\t},\n\t\t};\n\t}\n\tlet outcome: AgentSessionRunOutcome;\n\ttry {\n\t\toutcome = await deps.agentSessionFactory({\n\t\t\thomeDir: layout.homeDir,\n\t\t\tcwd: layout.workDir,\n\t\t\tsessionDir: layout.sessionDir,\n\t\t\tagentDir: layout.agentDir,\n\t\t\tvalidationCase: input.validationCase,\n\t\t\tresourceCopyDir: input.resourceCopyDir,\n\t\t\tloadMethod: input.loadMethod,\n\t\t\tsignal: input.signal,\n\t\t\ttimeoutMs: input.timeoutMs,\n\t\t\tmodelConfig: input.validationCase.modelConfig,\n\t\t});\n\t} catch (error) {\n\t\tif (input.signal?.aborted || (error as Error).name === \"AbortError\") {\n\t\t\treturn {\n\t\t\t\trun: {\n\t\t\t\t\tpassed: false,\n\t\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\t\tfailureReason: `已取消:${(error as Error).message ?? String(error)}`,\n\t\t\t\t},\n\t\t\t\tcancelReason: String(input.signal?.reason ?? \"aborted\"),\n\t\t\t};\n\t\t}\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: `隔离验证会话异常:${(error as Error).message ?? String(error)}`,\n\t\t\t},\n\t\t};\n\t}\n\tconst afterTree = hashTree(layout.workDir);\n\tconst fileChanges = diffTrees(beforeTree, afterTree);\n\n\t// O11/E07：「会话完成」与「验收通过」分开——\n\t// - abortReason 返回 → 会话被中止/取消，执行故障，绝不可通过；\n\t// - completed=false（或 completed 未给但 output 为空）→ 会话未真正收尾，\n\t//   执行故障，不当业务通过；\n\t// - 其余情况 passed=true 只表示「会话完整跑完」（判据仍由 acceptance/evaluate\n\t//   裁决——本层不再无条件放行）。\n\tif (outcome.abortReason !== undefined) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"cancel\",\n\t\t\t\tfailureReason: `会话中止:${outcome.abortReason}`,\n\t\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\t\tfileChanges,\n\t\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t\t},\n\t\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t\t};\n\t}\n\tconst completed = outcome.completed ?? outcome.output.trim().length > 0;\n\tif (!completed) {\n\t\treturn {\n\t\t\trun: {\n\t\t\t\tpassed: false,\n\t\t\t\texecutionFailure: \"start\",\n\t\t\t\tfailureReason: \"隔离会话未完整收尾（completed=false/无输出）\",\n\t\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\t\tfileChanges,\n\t\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t\t},\n\t\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t\t};\n\t}\n\treturn {\n\t\trun: {\n\t\t\tpassed: true, // 会话完整跑完；判据通过与否由 acceptance/evaluate 裁决\n\t\t\toutput: outcome.output.slice(0, 64 * 1024),\n\t\t\tfileChanges,\n\t\t\t...(outcome.usageRef ? { usageRef: outcome.usageRef } : {}),\n\t\t},\n\t\t...(outcome.requestId ? { requestId: outcome.requestId } : {}),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 入口\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 运行一个冻结验证用例的 baseline 或 candidate 侧。\n *\n * 流程：建独立 scratch（home/work/session/agent）→ 复制 initialFiles →\n * **物化版本副本**（baseline=`versions/<baseVersion>`、candidate=\n * `candidates/<candidateId>` 复制进 `workDir/resource/`）→ 记录运行前\n * 文件树 → 按 kind 走命令或隔离会话 → 记录运行后文件树差异 →\n * 回执落盘 `evolution/validations/<testPlanId>/runs/` → 清理 scratch。\n *\n * 取消：AbortSignal 传到 runCardProcess/会话工厂；取消结果保留取消原因，\n * 不把取消伪装成业务失败。\n */\nexport async function runValidationCase(\n\t_store: MemoryStore,\n\tdeps: RunValidationCaseDeps,\n\tinput: RunValidationCaseInput,\n): Promise<MemoryResult<RunValidationCaseResult>> {\n\tinput.signal?.throwIfAborted();\n\tif (input.side === \"candidate\" && !input.candidateId) {\n\t\treturn fail(\"invalid_input\", \"side=candidate 时必须给 candidateId\");\n\t}\n\tconst layout = makeScratch(deps.scratchRoot, input.validationCase.caseId, input.side);\n\tconst runAt = input.runAt ?? new Date().toISOString();\n\tconst keep = deps.keepScratch === true;\n\ttry {\n\t\t// 复制初始文件；越界路径直接抛错（输入非法）。\n\t\tmaterializeInitialFiles(layout.workDir, input.validationCase.initialFiles);\n\t\t// O11/E07：版本副本物化——两侧差异来自已固化版本/候选目录本身；\n\t\t// 冻结用例经相对路径 `resource/` 引用对应侧正文。\n\t\tconst versionCopy = materializeVersionCopy(layout, input);\n\t\t// O11/E08：对版本副本源目录算指纹写回执——publish 门以它绑定「验过的正文」。\n\t\tconst resourceFingerprint = fingerprintResourceRoot(versionCopy.sourceDir).versionId;\n\t\tconst beforeTree = hashTree(layout.workDir);\n\n\t\t// 版本副本路径归一化：调用方显式给的 resourceCopyDir 优先（向后兼容），\n\t\t// 否则用物化出来的固定子目录。\n\t\tconst effectiveInput: RunValidationCaseInput =\n\t\t\tinput.resourceCopyDir === undefined ? { ...input, resourceCopyDir: versionCopy.resourceCopyDir } : input;\n\n\t\tlet run: ValidationRunResult;\n\t\tlet cancelReason: string | undefined;\n\t\tlet requestId: string | undefined;\n\t\tif (input.kind === \"command\") {\n\t\t\tconst out = await executeCommandCase(layout, effectiveInput, deps, beforeTree);\n\t\t\trun = out.run;\n\t\t\tcancelReason = out.cancelReason;\n\t\t} else {\n\t\t\tconst out = await executeAgentCase(layout, effectiveInput, deps, beforeTree);\n\t\t\trun = out.run;\n\t\t\tcancelReason = out.cancelReason;\n\t\t\trequestId = out.requestId;\n\t\t}\n\n\t\t// 回执：运行时间戳取自入参（夹具注入）或当前；requestId 来自受控入口返回。\n\t\tconst receipt: ValidationReceipt = {\n\t\t\tcaseId: input.validationCase.caseId,\n\t\t\tside: input.side,\n\t\t\ttestPlanId: input.testPlanId,\n\t\t\tresourceId: input.resourceId,\n\t\t\tbaseVersion: input.baseVersion,\n\t\t\t...(input.candidateId ? { candidateId: input.candidateId } : {}),\n\t\t\tkind: input.kind,\n\t\t\tresourceCopyDir: versionCopy.sourceDir,\n\t\t\tresourceFingerprint,\n\t\t\tresult: run,\n\t\t\t...(input.validationCase.modelConfig ? { modelConfig: input.validationCase.modelConfig } : {}),\n\t\t\t...(requestId ? { requestId } : {}),\n\t\t\t...(cancelReason ? { cancelReason } : {}),\n\t\t\trunAt,\n\t\t};\n\t\tconst receiptPath = writeReceipt(input.paoHome, input.testPlanId, receipt);\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresult: run,\n\t\t\treceiptPath,\n\t\t\t...(keep ? { scratchDir: layout.root } : {}),\n\t\t\t...(cancelReason ? { cancelReason } : {}),\n\t\t};\n\t} finally {\n\t\t// 收尾：scratch 整体删除（keepScratch 时保留供排障）；取消/异常同路径收尾。\n\t\tif (!keep) {\n\t\t\ttry {\n\t\t\t\trmSync(layout.root, { recursive: true, force: true });\n\t\t\t} catch {\n\t\t\t\t// 清理失败不掩盖运行结果；残留只影响临时空间。\n\t\t\t}\n\t\t}\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 7. 生产 agent 会话工厂（O11/E07：包现成 SDK 函数，不新建框架）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生产版隔离 agent 会话工厂。\n *\n * 装配（全部包现成函数）：\n * 1. `DefaultResourceLoader`：候选/版本副本经 `prioritySkillPaths`（skill-path）\n *    或 `additionalExtensionPaths`（extension-path）挂接——priority 保证\n *    候选版本压过用户目录同名技能；`noContextFiles/noPromptTemplates/noThemes`\n *    隔离用户配置；隔离 agentDir 内无用户技能/扩展来源可发现。\n * 2. `SessionManager.create(cwd, sessionDir)`：隔离会话目录。\n * 3. `createAgentSession`：注入 modelRuntime（假实现可经 modelConfig.modelRuntime\n *    或 deps 注入）、`tools`=`resolveValidationToolSet(case).allowed` 交集、\n *    resourceLoader、sessionManager、agentDir、cwd。\n * 4. 驱动 `session.prompt(input)` → `waitForIdle()`；output 取\n *    `getLastAssistantText()`，usage 取 `getSessionStats()`。\n * 5. 取消/超时：`input.signal` 与 `AbortSignal.timeout(timeoutMs)` 经\n *    `AbortSignal.any` 合成；信号触发即 `session.abort()`+`close()`，返回\n *    abortReason。\n *\n * 不启动扩展：验证只用内置限定工具集（read/grep/find/ls），候选扩展代码\n * 不经本通道激活（extension 资源 publish 侧本就不可自动发布）。\n */\nexport async function createValidationAgentSession(\n\tinput: AgentSessionFactoryInput,\n\toptions: {\n\t\t/** 注入 modelRuntime（假实现经此缝进；缺省用隔离 agentDir 认证创建真实 runtime）。 */\n\t\tmodelRuntime?: unknown;\n\t} = {},\n): Promise<AgentSessionRunOutcome> {\n\tconst { DefaultResourceLoader } = await import(\"../../core/resource-loader.ts\");\n\tconst { SessionManager } = await import(\"../../core/session-manager.ts\");\n\tconst { SettingsManager } = await import(\"../../core/settings-manager.ts\");\n\tconst { ModelRuntime } = await import(\"../../core/model-runtime.ts\");\n\tconst { createAgentSession } = await import(\"../../core/sdk.ts\");\n\n\t// 工具交集：VALIDATION_TOOL_ALLOWLIST ∩ case.allowedTools。\n\tconst toolset = resolveValidationToolSet(input.validationCase);\n\n\t// 资源挂接：skill-path → prioritySkillPaths（压过同名）；extension-path →\n\t// additionalExtensionPaths；其余 loadMethod 不挂（如实不装，不猜测）。\n\tconst loaderOptions: Record<string, unknown> = {};\n\tif (input.resourceCopyDir !== undefined) {\n\t\tif (input.loadMethod === \"skill-path\") {\n\t\t\tloaderOptions.prioritySkillPaths = [input.resourceCopyDir];\n\t\t} else if (input.loadMethod === \"extension-path\") {\n\t\t\tloaderOptions.additionalExtensionPaths = [input.resourceCopyDir];\n\t\t}\n\t}\n\t// 隔离：不带入用户/项目自动发现（隔离 home/agentDir 本身已空，再显式关掉\n\t// context/prompt/theme 发现，防止 cwd 内 AGENTS.md 等影响验证）。\n\tconst settingsManager = SettingsManager.create(input.cwd, input.agentDir);\n\tconst resourceLoader = new DefaultResourceLoader({\n\t\tcwd: input.cwd,\n\t\tagentDir: input.agentDir,\n\t\tsettingsManager,\n\t\tnoContextFiles: true,\n\t\tnoPromptTemplates: true,\n\t\tnoThemes: true,\n\t\t...loaderOptions,\n\t});\n\tawait resourceLoader.reload();\n\n\tconst sessionManager = SessionManager.create(input.cwd, input.sessionDir);\n\tconst modelRuntime =\n\t\toptions.modelRuntime ??\n\t\t(input.modelConfig?.modelRuntime !== undefined\n\t\t\t? input.modelConfig.modelRuntime\n\t\t\t: await ModelRuntime.create({\n\t\t\t\t\tauthPath: join(input.agentDir, \"auth.json\"),\n\t\t\t\t\tmodelsPath: join(input.agentDir, \"models.json\"),\n\t\t\t\t}));\n\n\t// 取消/超时合成：外部 signal 与 timeoutMs 任一先到即中止。\n\tconst timeoutSignal =\n\t\tinput.timeoutMs !== undefined && Number.isFinite(input.timeoutMs)\n\t\t\t? AbortSignal.timeout(input.timeoutMs)\n\t\t\t: undefined;\n\tconst signals = [input.signal, timeoutSignal].filter((s): s is AbortSignal => s !== undefined);\n\tconst runSignal = signals.length === 0 ? undefined : signals.length === 1 ? signals[0] : AbortSignal.any(signals);\n\n\t// 用例固定模型（modelConfig.model=\"provider/id\"）：冻结样例声明的模型优先，\n\t// 否则由 createAgentSession 走 findInitialModel（可用清单首个）。验证需要可\n\t// 复现——生产编排按档位写 modelConfig.model，测试经同一字段固定假模型。\n\tconst runtime = modelRuntime as { getModel?: (provider: string, modelId: string) => unknown };\n\tconst modelRef = typeof input.modelConfig?.model === \"string\" ? input.modelConfig.model : undefined;\n\tconst pinnedModel =\n\t\tmodelRef !== undefined && typeof runtime.getModel === \"function\"\n\t\t\t? (() => {\n\t\t\t\t\tconst slash = modelRef.indexOf(\"/\");\n\t\t\t\t\tif (slash <= 0) return undefined;\n\t\t\t\t\treturn runtime.getModel(modelRef.slice(0, slash), modelRef.slice(slash + 1));\n\t\t\t\t})()\n\t\t\t: undefined;\n\n\tconst { session } = await createAgentSession({\n\t\tcwd: input.cwd,\n\t\tagentDir: input.agentDir,\n\t\tmodelRuntime: modelRuntime as never,\n\t\tsessionManager,\n\t\tsettingsManager,\n\t\tresourceLoader,\n\t\ttools: toolset.allowed,\n\t\t...(pinnedModel !== undefined ? { model: pinnedModel as never } : {}),\n\t});\n\n\t// 信号触发 → abort + close，返回 abortReason。\n\tlet abortReason: string | undefined;\n\tconst onAbort = () => {\n\t\tif (abortReason !== undefined) return;\n\t\tabortReason =\n\t\t\trunSignal?.reason !== undefined\n\t\t\t\t? String(runSignal.reason)\n\t\t\t\t: timeoutSignal?.aborted\n\t\t\t\t\t? `timeout ${input.timeoutMs}ms`\n\t\t\t\t\t: \"aborted\";\n\t\tvoid session\n\t\t\t.abort()\n\t\t\t.catch(() => undefined)\n\t\t\t.finally(() => session.close().catch(() => undefined));\n\t};\n\trunSignal?.addEventListener(\"abort\", onAbort, { once: true });\n\tif (runSignal?.aborted) onAbort();\n\n\tlet output = \"\";\n\ttry {\n\t\tawait session.prompt(input.validationCase.input);\n\t\tawait session.waitForIdle();\n\t\toutput = session.getLastAssistantText() ?? \"\";\n\t} catch (error) {\n\t\tif (abortReason !== undefined || runSignal?.aborted) {\n\t\t\tabortReason ??= String(runSignal?.reason ?? \"aborted\");\n\t\t} else {\n\t\t\tthrow error;\n\t\t}\n\t} finally {\n\t\trunSignal?.removeEventListener(\"abort\", onAbort);\n\t\tawait session.close().catch(() => undefined);\n\t\tsession.dispose();\n\t}\n\n\tif (abortReason !== undefined) {\n\t\treturn { output, abortReason };\n\t}\n\n\tconst stats = session.getSessionStats();\n\treturn {\n\t\toutput,\n\t\tcompleted: true,\n\t\tusageRef: `session:${stats.sessionId}:tokens=${stats.tokens.total}`,\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"warning","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * 受控自进化改进选择（S8-05）。\n *\t\t} else if (problem.kind === \"unused_experience\") {\n\t\t\t// 未采用经验：优先改检索/提示策略。\n\t\t\tif (problem.resourceId !== undefined && problem.resourceId.startsWith?.startsWith(\"memory-policy:\")) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\treturn parts.join(\"；\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":120}},{"diffOp":{"equal":{"range":[51,167]}}},{"diffOp":{"equal":{"range":[167,185]}}},{"diffOp":{"delete":{"range":[185,232]}}},{"diffOp":{"insert":{"range":[232,244]}}},{"diffOp":{"equal":{"range":[244,262]}}},{"diffOp":{"equal":{"range":[262,319]}}},{"equalLines":{"line_count":77}},{"diffOp":{"equal":{"range":[319,348]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\select.ts"},"span":[6173,6256],"sourceCode":"/**\n * 受控自进化改进选择（S8-05）。\n *\n * 职责：按已分类问题选择 modify/delete/merge/no_change/development_suggestion。\n *\n * 契约（S8 任务书 §5）：\n * - 核心问题（core_issue）→ development_suggestion，并输出具体文件/函数建议；\n *   结束自动路径。\n * - 未采用经验（unused_experience）→ 优先改检索/提示策略（memory-policy 资源）。\n * - 只有资源行为可改善才返回 modify 供 candidates 消费；no_change 是合法终态。\n * - 不要求每问题都产补丁；没有「必须产补丁」的完成条件。\n */\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { getProblemRow, rowToProblem } from \"./problems.ts\";\nimport {\n\ttype EvolutionProblem,\n\ttype EvolutionProblemAction,\n\ttype EvolutionProblemDisposition,\n\ttype EvolutionProblemStatus,\n\tisProblemTransitionAllowed,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 类型\n// ════════════════════════════════════════════════════════════════════════\n\n/** `selectImprovement` 的输入。 */\nexport interface SelectImprovementInput {\n\tproblemId: string;\n\t/** 选择时间（夹具注入）。 */\n\tselectedAt?: string;\n}\n\n/** `selectImprovement` 的输出。 */\nexport interface SelectImprovementResult {\n\tproblemId: string;\n\taction: EvolutionProblemAction;\n\t/** 处置结果（与 action 对应）。 */\n\tdisposition: EvolutionProblemDisposition;\n\t/** 选择理由。 */\n\treason: string;\n\t/** development_suggestion 时的具体建议（文件/函数）。 */\n\tsuggestion?: string;\n\t/** modify 时建议的目标资源与基础版本（供 candidates 消费）。 */\n\ttarget?: {\n\t\tresourceId: string;\n\t\tbaseVersion?: string;\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 内部\n// ════════════════════════════════════════════════════════════════════════\n//\n// O14：完整 Problem 行读取（getProblemRow/rowToProblem）统一由 problems.ts 导出，\n// 本模块只负责选择决策与状态提交；字段增补只改 problems.ts 一处。\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// selectImprovement\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按已分类问题选择改进动作。\n *\n * 选择规则：\n * - core_issue → development_suggestion（输出具体文件/函数建议，结束自动路径）。\n * - unused_experience → 优先改检索/提示策略（memory-policy 资源）；若问题已指向\n *   具体 memory-policy 资源则返回 modify，否则返回 development_suggestion（缺目标）。\n * - invocation / implementation_defect → 有 resourceId 时返回 modify；无目标返回\n *   no_change（无资源可改不强行产补丁）。\n * - 已终态（no_change/development_suggestion）返回原动作，不重复推进。\n */\nexport function selectImprovement(\n\tstore: MemoryStore,\n\tinput: SelectImprovementInput,\n): MemoryResult<SelectImprovementResult> {\n\tconst now = input.selectedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = getProblemRow(store, input.problemId);\n\t\tif (!row) return fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t\tconst problem = rowToProblem(row);\n\n\t\t// 终态直接返回原结果。\n\t\tif (problem.status === \"no_change\" || problem.status === \"development_suggestion\") {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tproblemId: problem.problemId,\n\t\t\t\taction: problem.action ?? \"no_change\",\n\t\t\t\tdisposition: problem.disposition,\n\t\t\t\treason: problem.reason ?? \"问题已终态\",\n\t\t\t};\n\t\t}\n\n\t\t// 未分类问题先分类（防御：调用方应按顺序先 classify）。\n\t\tif (problem.status === \"observed\") {\n\t\t\treturn fail(\"invalid_input\", `问题尚未分类:${input.problemId}`, input.problemId);\n\t\t}\n\n\t\tlet action: EvolutionProblemAction;\n\t\tlet disposition: EvolutionProblemDisposition;\n\t\tlet reason: string;\n\t\tlet suggestion: string | undefined;\n\t\tlet target: SelectImprovementResult[\"target\"] | undefined;\n\n\t\tif (problem.action === \"delete\" || problem.action === \"merge\" || problem.action === \"no_change\") {\n\t\t\t// O10/E04：登记时声明的非 modify 动作（delete/merge/no_change）不被无条件\n\t\t\t// 改成 modify——这些动作不产生候选补丁，按终态语义收口并保留原动作；\n\t\t\t// 资源处置本身（删除/合并）走单独通道，不在自动候选链内完成。\n\t\t\taction = problem.action;\n\t\t\tdisposition = \"no_change\";\n\t\t\treason = `登记动作 ${problem.action} 不产生候选补丁，收口为 no_change（资源处置走单独通道）`;\n\t\t} else if (problem.kind === \"core_issue\") {\n\t\t\t// 核心缺口：转开发建议，结束自动路径。\n\t\t\taction = \"development_suggestion\";\n\t\t\tdisposition = \"development_suggestion\";\n\t\t\tsuggestion = buildDevelopmentSuggestion(problem);\n\t\t\treason = `核心问题转开发建议:${suggestion}`;\n\t\t} else if (problem.kind === \"unused_experience\") {\n\t\t\t// 未采用经验：优先改检索/提示策略。\n\t\t\tif (problem.resourceId !== undefined && problem.resourceId.startsWith(\"memory-policy:\")) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `未采用经验 ${problem.reason ?? \"\"}，改检索/提示策略(${problem.resourceId})`;\n\t\t\t} else {\n\t\t\t\taction = \"development_suggestion\";\n\t\t\t\tdisposition = \"development_suggestion\";\n\t\t\t\tsuggestion = `未采用经验 ${problem.reason ?? \"\"}，但问题未指向具体 memory-policy 资源；请确认检索/提示策略目标后登记 resourceId`;\n\t\t\t\treason = suggestion;\n\t\t\t}\n\t\t} else {\n\t\t\t// invocation / implementation_defect：有资源目标才 modify。\n\t\t\tif (problem.resourceId !== undefined) {\n\t\t\t\taction = \"modify\";\n\t\t\t\tdisposition = \"candidate\";\n\t\t\t\ttarget = { resourceId: problem.resourceId, baseVersion: problem.baseVersion };\n\t\t\t\treason = `资源 ${problem.resourceId} 行为可改善，进入候选生成`;\n\t\t\t} else {\n\t\t\t\taction = \"no_change\";\n\t\t\t\tdisposition = \"no_change\";\n\t\t\t\treason = \"无明确资源目标，不强行产补丁（no_change 合法终态）\";\n\t\t\t}\n\t\t}\n\n\t\t// O10/E04：可改问题（disposition=candidate）状态保持 classified，只写\n\t\t// action/disposition——candidate 状态由 proposeCandidate 成功后推进；\n\t\t// 若 select 抢先把 status 写成 candidate，freezeValidationPlan（只收\n\t\t// classified）会拒绝，链路冻死在 select 与 freeze 之间。终态动作仍\n\t\t// 推进 status（no_change/development_suggestion）。\n\t\tconst nextStatus: EvolutionProblemStatus =\n\t\t\tdisposition === \"candidate\" ? \"classified\" : disposition === \"no_change\" ? \"no_change\" : \"development_suggestion\";\n\t\tif (!isProblemTransitionAllowed(problem.status, nextStatus)) {\n\t\t\treturn fail(\"invalid_input\", `问题状态机不允许 ${problem.status} → ${nextStatus}`, input.problemId);\n\t\t}\n\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE evolution_problems\n\t\t\t\t SET action = ?, disposition = ?, status = ?, updated_at = ?\n\t\t\t\t WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.run(action, disposition, nextStatus, now, input.problemId);\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblemId: input.problemId,\n\t\t\taction,\n\t\t\tdisposition,\n\t\t\treason,\n\t\t\t...(suggestion === undefined ? {} : { suggestion }),\n\t\t\t...(target === undefined ? {} : { target }),\n\t\t};\n\t});\n}\n\n/** 给核心问题生成具体定位与建议（人读）：从问题的真实字段（资源/版本/证据/身份）解析位置，不只拼泛化禁止对象。 */\nfunction buildDevelopmentSuggestion(problem: EvolutionProblem): string {\n\tconst parts: string[] = [`核心问题:${problem.summary}`];\n\tif (problem.reason) parts.push(`原因:${problem.reason}`);\n\tparts.push(`预期:${problem.expectedBehavior}`);\n\tparts.push(`实际:${problem.actualBehavior}`);\n\t// 实际定位：登记时绑定的资源/版本/发生现场是排查入口（O10/E04——\n\t// 建议须带真实位置，不是只有泛化对象清单）。\n\tconst locations: string[] = [];\n\tif (problem.resourceId !== undefined) {\n\t\tlocations.push(`资源 ${problem.resourceId}${problem.baseVersion !== undefined ? `@${problem.baseVersion}` : \"\"}`);\n\t}\n\tconst identity = [\n\t\tproblem.projectId !== undefined ? `项目 ${problem.projectId}` : undefined,\n\t\tproblem.taskId !== undefined ? `任务 ${problem.taskId}` : undefined,\n\t\tproblem.sessionId !== undefined ? `会话 ${problem.sessionId}` : undefined,\n\t\tproblem.entryId !== undefined ? `条目 ${problem.entryId}` : undefined,\n\t\tproblem.toolCallId !== undefined ? `工具调用 ${problem.toolCallId}` : undefined,\n\t].filter((value): value is string => value !== undefined);\n\tif (identity.length > 0) locations.push(`发生现场:${identity.join(\" / \")}`);\n\tif (problem.evidenceRefs.length > 0) locations.push(`证据引用:${problem.evidenceRefs.join(\"、\")}`);\n\tif (locations.length > 0) parts.push(`定位:${locations.join(\"；\")}`);\n\t// 指向固定禁止对象清单中的相关位置（内核/表结构/权限/预算/加载机制）。\n\tparts.push(\"涉及固定禁止对象：内核源码 / memory.sqlite 表结构 / 权限角色门控 / 预算上限 / 资源加载与更新机制\");\n\treturn parts.join(\"；\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化冻结验收（S8-06）。\n *import { createHash } from \"node:crypto\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\treturn { ok: true, testPlanId, plan, planPath };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[51,154]}}},{"diffOp":{"delete":{"range":[154,161]}}},{"diffOp":{"delete":{"range":[161,163]}}},{"diffOp":{"equal":{"range":[163,311]}}},{"equalLines":{"line_count":222}},{"diffOp":{"equal":{"range":[311,363]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\validation.ts"},"span":[988,995],"sourceCode":"/**\n * 受控自进化冻结验收（S8-06）。\n *\n * 职责：从已分类 problem + baseVersion 生成三组冻结样例，testPlanId 绑定 baseVersion，\n * 验收依据存核心管理位置（evolution_validations 行 + `<home>/evolution/` 受管区），\n * 不在候选可写目录。测试命令由核心定义。\n *\n * 契约（S8 任务书 §5）：\n * - `reproduction`：原问题复现（至少一条；先跑旧版必须真失败，复现不了回问题分类，\n *   不继续制造改进）。\n * - `normal`：受影响正常用法。\n * - `holdout`：独立保留样例（候选生成器读不到其内容）。\n * - 每项固定 input、initialFiles、allowedTools、acceptance、modelConfig。\n * - testPlanId 绑定 baseVersion；验收依据不入候选可写目录；测试命令由核心定义。\n * - `passed ≠ active`：本阶段不发布正式资源。\n */\nimport { createHash } from \"node:crypto\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_SAMPLE_GROUPS,\n\ttype EvolutionSampleGroup,\n\ttype ValidationCase,\n\ttype ValidationPlan,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 单个冻结样例的输入（调用方组装，不含 caseId）。 */\nexport interface FreezeCaseInput {\n\t/** 固定输入（可回放的初始状态/文件/参数）。 */\n\tinput: string;\n\t/** 初始文件清单（相对路径 → 内容）。 */\n\tinitialFiles: Record<string, string>;\n\t/** 允许工具清单。 */\n\tallowedTools: string[];\n\t/** 完成判据（如何算通过）。 */\n\tacceptance: string;\n\t/** 模型配置（档位/模型名等）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** `freezeValidationPlan` 的输入。 */\nexport interface FreezeValidationPlanInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 冻结时的基础版本。 */\n\tbaseVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 原问题复现样例（至少一条）。 */\n\treproduction: FreezeCaseInput[];\n\t/** 受影响正常用法样例。 */\n\tnormal: FreezeCaseInput[];\n\t/** 独立保留样例（生成器不可见）。 */\n\tholdout: FreezeCaseInput[];\n\t/** 冻结时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 来源引用（写入 evolution_source_links）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `freezeValidationPlan` 的成功输出。 */\nexport interface FreezeValidationPlanResult {\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 完整计划（含三组样例）。 */\n\tplan: ValidationPlan;\n\t/** 落盘的 plan.json 路径。 */\n\tplanPath: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 生成 testPlanId：`tp-{resourceId}-{baseVersion}-{hash}`，保证同 resource+base 幂等。 */\nfunction makeTestPlanId(resourceId: string, baseVersion: string, cases: ValidationCase[]): string {\n\tconst fingerprint = testPlanCaseFingerprint(cases);\n\treturn `tp-${resourceId.replace(/:/g, \"_\")}-${baseVersion}-${fingerprint}`;\n}\n\n/**\n * 用例集合指纹（O11/E08 共用）：plan.json 内容被篡改时重算值与\n * testPlanId 尾段对不上——publish 门据此做实质篡改核对（快照自比只\n * 能证明「此刻可读」）。\n */\nexport function testPlanCaseFingerprint(cases: ValidationCase[]): string {\n\treturn createHash(\"sha256\")\n\t\t.update(\n\t\t\tJSON.stringify(\n\t\t\t\tcases.map((c) => [c.group, c.input, c.initialFiles, c.allowedTools, c.acceptance, c.modelConfig]),\n\t\t\t),\n\t\t)\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n}\n\n/** 把 FreezeCaseInput 展开为带 caseId 的 ValidationCase。 */\nfunction expandCases(group: EvolutionSampleGroup, inputs: FreezeCaseInput[]): ValidationCase[] {\n\treturn inputs.map((input, index) => ({\n\t\tcaseId: `${group}-${index}`,\n\t\tgroup,\n\t\tinput: input.input,\n\t\tinitialFiles: input.initialFiles,\n\t\tallowedTools: input.allowedTools,\n\t\tacceptance: input.acceptance,\n\t\t...(input.modelConfig !== undefined ? { modelConfig: input.modelConfig } : {}),\n\t}));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. freezeValidationPlan\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 冻结验收计划：三组样例一次冻结，testPlanId 绑定 baseVersion。\n *\n * 验收依据存核心管理位置：\n * - evolution_validations 行（verdict 先占位 \"incomplete\"）。\n * - `<home>/evolution/validations/<testPlanId>/plan.json`。\n * 不在候选可写目录（candidates/ 下无写入口）。\n *\n * reproduction 组至少一条；旧版必须先真失败（由调用方在 freeze 前跑 baseline 验证，\n * 复现不了回问题分类，不继续制造改进）。\n */\nexport function freezeValidationPlan(\n\tstore: MemoryStore,\n\tinput: FreezeValidationPlanInput,\n): MemoryResult<FreezeValidationPlanResult> {\n\t// 校验：problem 必须已分类（classified），目标资源已登记。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, resource_id, base_version\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| { problem_id: string; status: string; resource_id: string | null; base_version: string | null }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\tif (problemRow.status !== \"classified\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 才能冻结验收`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 登记的资源 ${problemRow.resource_id ?? \"无\"} 与输入 ${input.resourceId} 不一致`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst resolvedBase = input.baseVersion ?? problemRow.base_version;\n\tif (!resolvedBase) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 未绑定 baseVersion，无法冻结验收`, input.problemId);\n\t}\n\n\t// 三组样例展开。\n\tconst reproduction = expandCases(\"reproduction\", input.reproduction);\n\tconst normal = expandCases(\"normal\", input.normal);\n\tconst holdout = expandCases(\"holdout\", input.holdout);\n\tif (reproduction.length === 0) {\n\t\treturn fail(\"invalid_input\", \"原问题复现样例至少一条\", input.problemId);\n\t}\n\tconst allCases = [...reproduction, ...normal, ...holdout];\n\tconst testPlanId = makeTestPlanId(input.resourceId, resolvedBase, allCases);\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst plan: ValidationPlan = {\n\t\ttestPlanId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: resolvedBase,\n\t\treproduction,\n\t\tnormal,\n\t\tholdout,\n\t\tcreatedAt: now,\n\t};\n\n\t// 验收依据落盘：核心管理位置，不在候选可写目录。\n\tconst planDir = join(evolutionPaths(input.paoHome).validations, testPlanId);\n\tmkdirSync(planDir, { recursive: true });\n\tconst planPath = join(planDir, \"plan.json\");\n\twriteFileSync(planPath, JSON.stringify(plan, null, 2), \"utf8\");\n\n\t// 验收依据存核心管理位置：\n\t// - plan.json 落盘（<home>/evolution/validations/<testPlanId>/）。\n\t// - evolution_validations 行由 evaluateCandidate 在运行时创建（外键约束要求\n\t//   candidate_id 已存在，freeze 阶段尚无候选，故不在此写行）。\n\t// - evolution_source_links 以 owner_kind=\"validation\"、owner_id=testPlanId 写入，\n\t//   供来源删除时沿关联清理。\n\t// O12/E11：sourceRefs 未传时自动继承 problem 已登记的 links（内核内部默认\n\t// 继承，不依赖编排层重复传参）；显式传入时以传入为准。\n\tconst sourceRefs =\n\t\tinput.sourceRefs ??\n\t\t(store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>).map((link) => ({\n\t\t\tsourceId: link.source_id,\n\t\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t\t}));\n\tstore.transaction(() => {\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${testPlanId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\ttestPlanId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\t});\n\n\treturn { ok: true, testPlanId, plan, planPath };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * 受控自进化冻结验收（S8-06）。\n *import type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_SAMPLE_GROUPS,\n\ttype EvolutionSampleGroup,\n\ttype ValidationCase,\treturn { ok: true, testPlanId, plan, planPath };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[51,167]}}},{"diffOp":{"delete":{"range":[167,192]}}},{"diffOp":{"delete":{"range":[192,193]}}},{"diffOp":{"equal":{"range":[193,243]}}},{"equalLines":{"line_count":217}},{"diffOp":{"equal":{"range":[243,295]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\validation.ts"},"span":[1209,1232],"sourceCode":"/**\n * 受控自进化冻结验收（S8-06）。\n *\n * 职责：从已分类 problem + baseVersion 生成三组冻结样例，testPlanId 绑定 baseVersion，\n * 验收依据存核心管理位置（evolution_validations 行 + `<home>/evolution/` 受管区），\n * 不在候选可写目录。测试命令由核心定义。\n *\n * 契约（S8 任务书 §5）：\n * - `reproduction`：原问题复现（至少一条；先跑旧版必须真失败，复现不了回问题分类，\n *   不继续制造改进）。\n * - `normal`：受影响正常用法。\n * - `holdout`：独立保留样例（候选生成器读不到其内容）。\n * - 每项固定 input、initialFiles、allowedTools、acceptance、modelConfig。\n * - testPlanId 绑定 baseVersion；验收依据不入候选可写目录；测试命令由核心定义。\n * - `passed ≠ active`：本阶段不发布正式资源。\n */\nimport { createHash } from \"node:crypto\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tEVOLUTION_SAMPLE_GROUPS,\n\ttype EvolutionSampleGroup,\n\ttype ValidationCase,\n\ttype ValidationPlan,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 单个冻结样例的输入（调用方组装，不含 caseId）。 */\nexport interface FreezeCaseInput {\n\t/** 固定输入（可回放的初始状态/文件/参数）。 */\n\tinput: string;\n\t/** 初始文件清单（相对路径 → 内容）。 */\n\tinitialFiles: Record<string, string>;\n\t/** 允许工具清单。 */\n\tallowedTools: string[];\n\t/** 完成判据（如何算通过）。 */\n\tacceptance: string;\n\t/** 模型配置（档位/模型名等）。 */\n\tmodelConfig?: Record<string, unknown>;\n}\n\n/** `freezeValidationPlan` 的输入。 */\nexport interface FreezeValidationPlanInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 冻结时的基础版本。 */\n\tbaseVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 原问题复现样例（至少一条）。 */\n\treproduction: FreezeCaseInput[];\n\t/** 受影响正常用法样例。 */\n\tnormal: FreezeCaseInput[];\n\t/** 独立保留样例（生成器不可见）。 */\n\tholdout: FreezeCaseInput[];\n\t/** 冻结时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 来源引用（写入 evolution_source_links）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `freezeValidationPlan` 的成功输出。 */\nexport interface FreezeValidationPlanResult {\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 完整计划（含三组样例）。 */\n\tplan: ValidationPlan;\n\t/** 落盘的 plan.json 路径。 */\n\tplanPath: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 生成 testPlanId：`tp-{resourceId}-{baseVersion}-{hash}`，保证同 resource+base 幂等。 */\nfunction makeTestPlanId(resourceId: string, baseVersion: string, cases: ValidationCase[]): string {\n\tconst fingerprint = testPlanCaseFingerprint(cases);\n\treturn `tp-${resourceId.replace(/:/g, \"_\")}-${baseVersion}-${fingerprint}`;\n}\n\n/**\n * 用例集合指纹（O11/E08 共用）：plan.json 内容被篡改时重算值与\n * testPlanId 尾段对不上——publish 门据此做实质篡改核对（快照自比只\n * 能证明「此刻可读」）。\n */\nexport function testPlanCaseFingerprint(cases: ValidationCase[]): string {\n\treturn createHash(\"sha256\")\n\t\t.update(\n\t\t\tJSON.stringify(\n\t\t\t\tcases.map((c) => [c.group, c.input, c.initialFiles, c.allowedTools, c.acceptance, c.modelConfig]),\n\t\t\t),\n\t\t)\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n}\n\n/** 把 FreezeCaseInput 展开为带 caseId 的 ValidationCase。 */\nfunction expandCases(group: EvolutionSampleGroup, inputs: FreezeCaseInput[]): ValidationCase[] {\n\treturn inputs.map((input, index) => ({\n\t\tcaseId: `${group}-${index}`,\n\t\tgroup,\n\t\tinput: input.input,\n\t\tinitialFiles: input.initialFiles,\n\t\tallowedTools: input.allowedTools,\n\t\tacceptance: input.acceptance,\n\t\t...(input.modelConfig !== undefined ? { modelConfig: input.modelConfig } : {}),\n\t}));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. freezeValidationPlan\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 冻结验收计划：三组样例一次冻结，testPlanId 绑定 baseVersion。\n *\n * 验收依据存核心管理位置：\n * - evolution_validations 行（verdict 先占位 \"incomplete\"）。\n * - `<home>/evolution/validations/<testPlanId>/plan.json`。\n * 不在候选可写目录（candidates/ 下无写入口）。\n *\n * reproduction 组至少一条；旧版必须先真失败（由调用方在 freeze 前跑 baseline 验证，\n * 复现不了回问题分类，不继续制造改进）。\n */\nexport function freezeValidationPlan(\n\tstore: MemoryStore,\n\tinput: FreezeValidationPlanInput,\n): MemoryResult<FreezeValidationPlanResult> {\n\t// 校验：problem 必须已分类（classified），目标资源已登记。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, resource_id, base_version\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| { problem_id: string; status: string; resource_id: string | null; base_version: string | null }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\tif (problemRow.status !== \"classified\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 才能冻结验收`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 登记的资源 ${problemRow.resource_id ?? \"无\"} 与输入 ${input.resourceId} 不一致`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst resolvedBase = input.baseVersion ?? problemRow.base_version;\n\tif (!resolvedBase) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 未绑定 baseVersion，无法冻结验收`, input.problemId);\n\t}\n\n\t// 三组样例展开。\n\tconst reproduction = expandCases(\"reproduction\", input.reproduction);\n\tconst normal = expandCases(\"normal\", input.normal);\n\tconst holdout = expandCases(\"holdout\", input.holdout);\n\tif (reproduction.length === 0) {\n\t\treturn fail(\"invalid_input\", \"原问题复现样例至少一条\", input.problemId);\n\t}\n\tconst allCases = [...reproduction, ...normal, ...holdout];\n\tconst testPlanId = makeTestPlanId(input.resourceId, resolvedBase, allCases);\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst plan: ValidationPlan = {\n\t\ttestPlanId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: resolvedBase,\n\t\treproduction,\n\t\tnormal,\n\t\tholdout,\n\t\tcreatedAt: now,\n\t};\n\n\t// 验收依据落盘：核心管理位置，不在候选可写目录。\n\tconst planDir = join(evolutionPaths(input.paoHome).validations, testPlanId);\n\tmkdirSync(planDir, { recursive: true });\n\tconst planPath = join(planDir, \"plan.json\");\n\twriteFileSync(planPath, JSON.stringify(plan, null, 2), \"utf8\");\n\n\t// 验收依据存核心管理位置：\n\t// - plan.json 落盘（<home>/evolution/validations/<testPlanId>/）。\n\t// - evolution_validations 行由 evaluateCandidate 在运行时创建（外键约束要求\n\t//   candidate_id 已存在，freeze 阶段尚无候选，故不在此写行）。\n\t// - evolution_source_links 以 owner_kind=\"validation\"、owner_id=testPlanId 写入，\n\t//   供来源删除时沿关联清理。\n\t// O12/E11：sourceRefs 未传时自动继承 problem 已登记的 links（内核内部默认\n\t// 继承，不依赖编排层重复传参）；显式传入时以传入为准。\n\tconst sourceRefs =\n\t\tinput.sourceRefs ??\n\t\t(store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>).map((link) => ({\n\t\t\tsourceId: link.source_id,\n\t\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t\t}));\n\tstore.transaction(() => {\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${testPlanId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\ttestPlanId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\t});\n\n\treturn { ok: true, testPlanId, plan, planPath };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedFunctionParameters","severity":"warning","description":"This parameter is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"parameter"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused parameters might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"event"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * 内置记忆的真实使用事件接线。\n *\n\t// 新一轮换发共享 requestId（context-usage 快照与 inject 记录同一身份）。\n\tconst offTurnStart = pi.on(\"turn_start\", (event_event, ctx) => {\n\t\tclearTurn();\n\t\trotateRequestId(ctx.sessionManager);\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,52]}}},{"equalLines":{"line_count":120}},{"diffOp":{"equal":{"range":[52,190]}}},{"diffOp":{"delete":{"range":[190,195]}}},{"diffOp":{"insert":{"range":[195,201]}}},{"diffOp":{"equal":{"range":[201,266]}}},{"equalLines":{"line_count":68}},{"diffOp":{"equal":{"range":[266,272]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\usage.ts"},"span":[4591,4596],"sourceCode":"/**\n * 内置记忆的真实使用事件接线。\n *\n * `context_with_system` 看到的是本请求最终可见消息；直接读取召回消息的 details\n * 并核对正文仍在该消息里，避免把已刷新前的 injected 历史误记成当前可见修订。\n * `before_provider_request` 在预算门之后执行，未取消才写 inject。\n * `turn_end` 只从已完成的助手文本中识别实际可见的 memoryId@rev，写 used。\n * requestId 经 request-identity.ts 与 context-usage 快照共享同一身份：\n * turn_start 换发、turn_end/agent_settled 作废，同 turn 内多次请求沿用同 ID。\n */\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type { MemoryHit } from \"./memory-vendor.ts\";\nimport { requestIdFor, rotateRequestId } from \"./request-identity.ts\";\nimport { BUILTIN_PROVIDER } from \"./session.ts\";\nimport type { MemoryService } from \"./types.ts\";\n\ninterface MemoryReference {\n\tmemoryId: string;\n\trevision: number;\n\trequestId?: string;\n}\n\nfunction textFromContent(content: unknown): string {\n\tif (typeof content === \"string\") return content;\n\tif (!Array.isArray(content)) return \"\";\n\treturn content\n\t\t.filter(\n\t\t\t(block): block is { type: \"text\"; text: string } =>\n\t\t\t\tBoolean(block) && typeof block === \"object\" && block.type === \"text\" && typeof block.text === \"string\",\n\t\t)\n\t\t.map((block) => block.text)\n\t\t.join(\"\\n\");\n}\n\nfunction textFromMessage(message: unknown): string {\n\treturn textFromContent(\n\t\tmessage && typeof message === \"object\" ? (message as { content?: unknown }).content : undefined,\n\t);\n}\n\nfunction normalizeText(text: string): string {\n\treturn text.replace(/\\s+/g, \" \").trim();\n}\n\ninterface RecallDetails {\n\thits?: MemoryHit[];\n\tvendor?: string;\n\tmemories?: MemoryHit[];\n\tprovider?: string;\n}\n\nfunction recallFromMessage(message: unknown): { vendor: string; hits: MemoryHit[] } | undefined {\n\tif (!message || typeof message !== \"object\") return;\n\tconst value = message as Record<string, unknown>;\n\tconst details = value.details as RecallDetails | undefined;\n\tif (\n\t\tvalue.role === \"custom\" &&\n\t\tvalue.customType === \"pao-auto-recall\" &&\n\t\tdetails?.vendor &&\n\t\tArray.isArray(details.hits)\n\t) {\n\t\treturn { vendor: details.vendor, hits: details.hits };\n\t}\n\tif (\n\t\tvalue.role === \"toolResult\" &&\n\t\tvalue.toolName === \"pao_memory_recall\" &&\n\t\tdetails?.provider &&\n\t\tArray.isArray(details.memories)\n\t) {\n\t\treturn { vendor: details.provider, hits: details.memories };\n\t}\n}\n\nfunction visibleReferences(messages: readonly unknown[]): MemoryReference[] {\n\tconst seen = new Set<string>();\n\tconst references: MemoryReference[] = [];\n\tfor (const message of messages) {\n\t\tconst recall = recallFromMessage(message);\n\t\tif (!recall || recall.vendor !== BUILTIN_PROVIDER) continue;\n\t\tconst finalText = normalizeText(textFromMessage(message));\n\t\tif (!finalText) continue;\n\t\tfor (const hit of recall.hits) {\n\t\t\tconst memoryId = hit.记忆ID?.trim();\n\t\t\tconst revision = hit.修订号;\n\t\t\tconst body = normalizeText(hit.内容);\n\t\t\tif (\n\t\t\t\t!memoryId ||\n\t\t\t\t!Number.isInteger(revision) ||\n\t\t\t\trevision === undefined ||\n\t\t\t\trevision < 1 ||\n\t\t\t\t!body ||\n\t\t\t\t!finalText.includes(body)\n\t\t\t) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tconst key = `${memoryId}@rev-${revision}`;\n\t\t\tif (seen.has(key)) continue;\n\t\t\tseen.add(key);\n\t\t\treferences.push({ memoryId, revision });\n\t\t}\n\t}\n\treturn references;\n}\n\nfunction explicitlyReferences(text: string, reference: MemoryReference, visibleRevisionCount: number): boolean {\n\tconst escapedId = reference.memoryId.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n\tconst exactRevision = new RegExp(`(?:^|[^A-Za-z0-9_-])${escapedId}@rev-${reference.revision}(?![A-Za-z0-9_-])`);\n\tif (exactRevision.test(text)) return true;\n\tif (visibleRevisionCount !== 1) return false;\n\t// 当前请求只看到该 ID 的一个修订时，准确 ID 已能唯一归属；不带 @rev 的\n\t// ID 不参与多修订消歧，正文相似也不推导采用。\n\treturn new RegExp(`(?:^|[^A-Za-z0-9_-])${escapedId}(?![A-Za-z0-9_-])(?!@rev-[0-9]+)`).test(text);\n}\n\n/** 安装内置记忆使用记录钩子；返回同步卸载函数。 */\nexport function registerMemoryUsage(pi: ExtensionAPI, service: MemoryService): () => void {\n\t/** undefined=当前 provider 请求没有对应的用户上下文；[]=有上下文但没有可见记忆。 */\n\tlet pending: MemoryReference[] | undefined;\n\tlet delivered: MemoryReference[] = [];\n\tconst clearTurn = (): void => {\n\t\tpending = undefined;\n\t\tdelivered = [];\n\t};\n\n\t// 新一轮换发共享 requestId（context-usage 快照与 inject 记录同一身份）。\n\tconst offTurnStart = pi.on(\"turn_start\", (event, ctx) => {\n\t\tclearTurn();\n\t\trotateRequestId(ctx.sessionManager);\n\t});\n\tconst offContext = pi.on(\"context_with_system\", (event) => {\n\t\tpending = visibleReferences(event.messages);\n\t});\n\tconst offRequest = pi.on(\"before_provider_request\", async (_event, ctx) => {\n\t\t// 后台提炼等辅助模型请求不经过 context_with_system；不消费当前轮或上一轮状态。\n\t\tif (pending === undefined) return;\n\t\tconst references = pending;\n\t\tpending = undefined;\n\t\tif (ctx.signal?.aborted) {\n\t\t\tdelivered = [];\n\t\t\treturn;\n\t\t}\n\t\t// 共享 ID：同 turn 内多次 provider 请求沿用同一 ID，不 rotate。\n\t\tconst requestId = requestIdFor(ctx.sessionManager);\n\t\tconst sessionId = ctx.sessionManager.getSessionId();\n\t\tconst injected = references.map((reference) => ({ ...reference, requestId }));\n\t\tdelivered = injected;\n\t\tfor (const reference of injected) {\n\t\t\tawait service.recordMemoryUsage({\n\t\t\t\taction: \"inject\",\n\t\t\t\tmemoryId: reference.memoryId,\n\t\t\t\trevision: reference.revision,\n\t\t\t\trequestId,\n\t\t\t\tsessionId,\n\t\t\t});\n\t\t}\n\t});\n\tconst offTurnEnd = pi.on(\"turn_end\", async (event, ctx) => {\n\t\ttry {\n\t\t\trotateRequestId(ctx.sessionManager);\n\t\t\tif (event.outcome !== \"completed\" || delivered.length === 0) return;\n\t\t\tconst text = textFromMessage(event.message);\n\t\t\tif (!text) return;\n\t\t\tconst sessionId = ctx.sessionManager.getSessionId();\n\t\t\tconst visibleRevisions = new Map<string, Set<number>>();\n\t\t\tfor (const reference of delivered) {\n\t\t\t\tconst revisions = visibleRevisions.get(reference.memoryId) ?? new Set<number>();\n\t\t\t\trevisions.add(reference.revision);\n\t\t\t\tvisibleRevisions.set(reference.memoryId, revisions);\n\t\t\t}\n\t\t\tfor (const reference of delivered) {\n\t\t\t\tif (!explicitlyReferences(text, reference, visibleRevisions.get(reference.memoryId)?.size ?? 0)) continue;\n\t\t\t\tawait service.recordMemoryUsage({\n\t\t\t\t\taction: \"used\",\n\t\t\t\t\tmemoryId: reference.memoryId,\n\t\t\t\t\trevision: reference.revision,\n\t\t\t\t\t...(reference.requestId === undefined ? {} : { requestId: reference.requestId }),\n\t\t\t\t\tsessionId,\n\t\t\t\t\tusageRef: event.messageEntryId,\n\t\t\t\t});\n\t\t\t}\n\t\t} finally {\n\t\t\tclearTurn();\n\t\t}\n\t});\n\tconst offSettled = pi.on(\"agent_settled\", (_event, ctx) => {\n\t\tclearTurn();\n\t\trotateRequestId(ctx.sessionManager);\n\t});\n\n\treturn () => {\n\t\toffTurnStart();\n\t\toffContext();\n\t\toffRequest();\n\t\toffTurnEnd();\n\t\toffSettled();\n\t\tclearTurn();\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n * * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,136]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[136,312]}}},{"diffOp":{"delete":{"range":[312,324]}}},{"diffOp":{"delete":{"range":[324,326]}}},{"diffOp":{"equal":{"range":[326,433]}}},{"equalLines":{"line_count":668}},{"diffOp":{"equal":{"range":[433,442]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-activation.test.ts"},"span":[1030,1042],"sourceCode":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *\n * 覆盖：\n * - 成功路径：publish → activate → effective_version 更新 + kind='publish'/activation='effective' 行；\n * - expectedEffectiveVersion 不匹配 → conflict；\n * - 验证期资源被改（文件指纹变 → conflict；另起 effective_version 变也 conflict）；\n * - 候选非 passed / 未发布 / 版本目录缺文件 → conflict；\n * - auto_evolution_enabled=false → conflict；\n * - 事务内失败 → 指向只能旧版或完整新版，无半份；\n * - rollbackResource：指向是 badVersion → 切回 + rollback 行 + 坏版凭据标停用；\n *   指向已非 badVersion → no_change 不覆盖其他已生效修复；\n * - getEffectiveVersion 正常/目录缺失。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-act-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直插 problem 行（classified）。O12/E11：补 problem source link（activation 前置核对要求非空 links）。 */\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（非 src- 前缀：不查 sources 行，作为有效来源）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\n/** 直插 candidate 行 + 候选目录文件（默认 passed）。 */\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tfiles?: Record<string, string>;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径，activation 前置核对要求非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? {\n\t\t\"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\",\n\t\t\"examples/a.md\": \"示例 A\\n\",\n\t};\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\treturn { candidateId, candidateDir };\n}\n\n/** 直插 validation 行（默认 passed）。 */\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: {\n\t\tvalidationId?: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tverdict?: string;\n\t\tcreatedAt?: string;\n\t},\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tJSON.stringify([]),\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tnull,\n\t\t\tover.createdAt ?? AT,\n\t\t\tover.createdAt ?? AT,\n\t\t);\n\t// O12/E11：validation（运行验证）级来源关联；冻结计划（tp-1）级同样补一条\n\t// （activation 核对 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", over.createdAt ?? AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", over.createdAt ?? AT);\n\treturn validationId;\n}\n\n/** 一套 ready-to-activate：resource + problem + 合法 passed 链 + publish。 */\nasync function seedPublished(home: string, store: MemoryStore) {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，直接种 passed 行过不了——\n\t// 跑 freeze→双侧 run→evaluate 真实链得到合法 passed。\n\tconst { candidateId, validationId } = await legalPassedChain(store, home, {\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\", \"examples/a.md\": \"示例 A\\n\" },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(`publish failed: ${JSON.stringify(pub)}`);\n\treturn { resourceId, baseVersion, skillDir, problemId, candidateId, validationId, versionId: pub.versionId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── activateCandidate ────────────────────────────────────────────────────\n\ndescribe(\"activateCandidate\", () => {\n\tit(\"publish → activate 成功：effective_version 更新 + effective activation 行落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tauthRef: \"auth-xyz\",\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toBe(versionId);\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\n\t\t// effective_version 指向新版本。\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\t// 新增 activation 行：kind='publish'、activation='effective'、authRef 落 source_links。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, source_links_json, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? ORDER BY created_at`,\n\t\t\t)\n\t\t\t.all(resourceId, versionId) as Array<{ kind: string; source_links_json: string; reason: string }>;\n\t\texpect(acts.length).toBe(2); // 落盘凭据 + 生效凭据\n\t\tconst effective = acts.find((a) => JSON.parse(a.source_links_json).activation === \"effective\");\n\t\texpect(effective).toBeDefined();\n\t\texpect(JSON.parse(effective!.source_links_json).authRef).toBe(\"auth-xyz\");\n\t\texpect(effective!.reason).toContain(candidateId);\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: \"v-notcurrent00\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(baseVersion);\n\t\t// 指向仍停在 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tvoid versionId;\n\t});\n\n\tit(\"验证期资源根被人工改（文件内容变）→ conflict，旧版保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\n\t\t// 验证通过后人工改 SKILL.md（指纹偏离 base_version）。\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t\t// 旧指向未动。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"验证期资源根被人工加文件（指纹变）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\t\twriteFileSync(join(skillDir, \"extra.md\"), \"新增\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"验证期 effective_version 已变（另一生效已写入）→ conflict，不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 另一路径先把 effective_version 改成别的（模拟另一激活已生效）。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, AT3, resourceId);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(versionId);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\t});\n\n\tit(\"候选非 passed → conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion, status: \"testing\" });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"候选未发布（无 publish 凭据）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\t\t// 不走 publishCandidate。\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"版本目录缺文件（指纹不匹配）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 删除版本目录里一个文件。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId, \"examples\", \"a.md\"));\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"auto_evolution_enabled=false → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId } = await seedPublished(home, store);\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"事务内写失败 → 指向只能旧版（无半份：activation 行与 effective_version 同生同死）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先造一条同 activation_id 不可复现的失败：直接 mock——给库加触发器让 INSERT\n\t\t// evolution_activations 失败，观察 rollback（SQLite 触发器属测试夹具注入的故障）。\n\t\tstore.db.exec(\n\t\t\t`CREATE TEMP TRIGGER fail_act_insert BEFORE INSERT ON evolution_activations\n\t\t\t WHEN NEW.kind = 'publish' AND json_extract(NEW.source_links_json, '$.activation') = 'effective'\n\t\t\t BEGIN SELECT RAISE(ABORT, 'simulated insert failure'); END`,\n\t\t);\n\t\tawait expect(\n\t\t\tactivateCandidate(store, {\n\t\t\t\tcandidateId,\n\t\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\t\tpaoHome: home,\n\t\t\t}),\n\t\t).rejects.toThrow();\n\t\tstore.db.exec(`DROP TRIGGER fail_act_insert`);\n\n\t\t// 指向仍停旧版（INSERT 失败回滚了 UPDATE），无 effective 行。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND json_extract(source_links_json, '$.activation') = 'effective'`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t});\n\n\tit(\"来源依据失效（validation 的 source_links 行引用已删记忆）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(home, store);\n\t\tvoid versionId;\n\n\t\t// 给 validation 行加一条引用已删记忆的 source link（记忆行不存在）。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tconst valId = validationId;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'validation', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-del-${valId}`, valId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\t\tvoid problemId;\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"记忆 mem-ghost 已被删除排除\");\n\t});\n});\n\n// ── rollbackResource ─────────────────────────────────────────────────────\n\ndescribe(\"rollbackResource\", () => {\n\tit(\"当前指向是 badVersion → 切回 previousVersion + rollback activation 行 + 坏版凭据标停用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先 activate 到 badVersion。\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"复现原问题回归\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rolled_back\");\n\n\t\t// 指向回到 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// rollback activation 落库，source_links 带 sourceIds。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason, source_links_json\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string; source_links_json: string };\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(JSON.parse(row.source_links_json).sourceIds).toEqual([\"src-reg-1\"]);\n\n\t\t// 坏版的 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t\t   AND json_extract(source_links_json, '$.candidateId') = ?`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId, candidateId) as { reason: string };\n\t\texpect(pubRow.reason.startsWith(\"停用:\")).toBe(true);\n\t});\n\n\tit(\"当前指向已非 badVersion（另一修复已生效）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\n\t\t// 另一路径把 effective_version 改成第三个版本（模拟回退期间另一修复已生效）。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId, // 认为该回退的坏版\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"判定退步\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tif (result.status !== \"no_change\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(otherVersion);\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t\t// 没有 rollback activation 写入。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`)\n\t\t\t.get(resourceId) as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tbadVersion: \"v-xxxxxxxxxxxx\",\n\t\t\tpreviousVersion: \"v-yyyyyyyyyyyy\",\n\t\t\tsourceIds: [],\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── getEffectiveVersion ──────────────────────────────────────────────────\n\ndescribe(\"getEffectiveVersion\", () => {\n\tit(\"激活后返回新 versionId + available=true（目录完整）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(true);\n\t\texpect(info.versionDir).toContain(versionId);\n\t});\n\n\tit(\"未激活时指向 baseVersion（快照目录完整 → available=true）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedPublished(home, store);\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(baseVersion);\n\t\texpect(info.available).toBe(true);\n\t});\n\n\tit(\"指向版本目录缺失/不完整 → available=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\t// 删版本目录文件 → 指纹不匹配。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId), { recursive: true, force: true });\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst info = getEffectiveVersion(store, \"skill:missing\", home);\n\t\texpect(info.ok).toBe(false);\n\t\tif (info.ok) return;\n\t\texpect(info.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable resourceId is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"resourceId"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-activation.test.ts"},"span":[13293,13303],"sourceCode":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *\n * 覆盖：\n * - 成功路径：publish → activate → effective_version 更新 + kind='publish'/activation='effective' 行；\n * - expectedEffectiveVersion 不匹配 → conflict；\n * - 验证期资源被改（文件指纹变 → conflict；另起 effective_version 变也 conflict）；\n * - 候选非 passed / 未发布 / 版本目录缺文件 → conflict；\n * - auto_evolution_enabled=false → conflict；\n * - 事务内失败 → 指向只能旧版或完整新版，无半份；\n * - rollbackResource：指向是 badVersion → 切回 + rollback 行 + 坏版凭据标停用；\n *   指向已非 badVersion → no_change 不覆盖其他已生效修复；\n * - getEffectiveVersion 正常/目录缺失。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-act-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直插 problem 行（classified）。O12/E11：补 problem source link（activation 前置核对要求非空 links）。 */\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（非 src- 前缀：不查 sources 行，作为有效来源）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\n/** 直插 candidate 行 + 候选目录文件（默认 passed）。 */\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tfiles?: Record<string, string>;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径，activation 前置核对要求非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? {\n\t\t\"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\",\n\t\t\"examples/a.md\": \"示例 A\\n\",\n\t};\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\treturn { candidateId, candidateDir };\n}\n\n/** 直插 validation 行（默认 passed）。 */\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: {\n\t\tvalidationId?: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tverdict?: string;\n\t\tcreatedAt?: string;\n\t},\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tJSON.stringify([]),\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tnull,\n\t\t\tover.createdAt ?? AT,\n\t\t\tover.createdAt ?? AT,\n\t\t);\n\t// O12/E11：validation（运行验证）级来源关联；冻结计划（tp-1）级同样补一条\n\t// （activation 核对 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", over.createdAt ?? AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", over.createdAt ?? AT);\n\treturn validationId;\n}\n\n/** 一套 ready-to-activate：resource + problem + 合法 passed 链 + publish。 */\nasync function seedPublished(home: string, store: MemoryStore) {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，直接种 passed 行过不了——\n\t// 跑 freeze→双侧 run→evaluate 真实链得到合法 passed。\n\tconst { candidateId, validationId } = await legalPassedChain(store, home, {\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\", \"examples/a.md\": \"示例 A\\n\" },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(`publish failed: ${JSON.stringify(pub)}`);\n\treturn { resourceId, baseVersion, skillDir, problemId, candidateId, validationId, versionId: pub.versionId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── activateCandidate ────────────────────────────────────────────────────\n\ndescribe(\"activateCandidate\", () => {\n\tit(\"publish → activate 成功：effective_version 更新 + effective activation 行落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tauthRef: \"auth-xyz\",\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toBe(versionId);\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\n\t\t// effective_version 指向新版本。\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\t// 新增 activation 行：kind='publish'、activation='effective'、authRef 落 source_links。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, source_links_json, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? ORDER BY created_at`,\n\t\t\t)\n\t\t\t.all(resourceId, versionId) as Array<{ kind: string; source_links_json: string; reason: string }>;\n\t\texpect(acts.length).toBe(2); // 落盘凭据 + 生效凭据\n\t\tconst effective = acts.find((a) => JSON.parse(a.source_links_json).activation === \"effective\");\n\t\texpect(effective).toBeDefined();\n\t\texpect(JSON.parse(effective!.source_links_json).authRef).toBe(\"auth-xyz\");\n\t\texpect(effective!.reason).toContain(candidateId);\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: \"v-notcurrent00\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(baseVersion);\n\t\t// 指向仍停在 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tvoid versionId;\n\t});\n\n\tit(\"验证期资源根被人工改（文件内容变）→ conflict，旧版保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\n\t\t// 验证通过后人工改 SKILL.md（指纹偏离 base_version）。\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t\t// 旧指向未动。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"验证期资源根被人工加文件（指纹变）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\t\twriteFileSync(join(skillDir, \"extra.md\"), \"新增\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"验证期 effective_version 已变（另一生效已写入）→ conflict，不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 另一路径先把 effective_version 改成别的（模拟另一激活已生效）。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, AT3, resourceId);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(versionId);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\t});\n\n\tit(\"候选非 passed → conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion, status: \"testing\" });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"候选未发布（无 publish 凭据）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\t\t// 不走 publishCandidate。\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"版本目录缺文件（指纹不匹配）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 删除版本目录里一个文件。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId, \"examples\", \"a.md\"));\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"auto_evolution_enabled=false → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId } = await seedPublished(home, store);\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"事务内写失败 → 指向只能旧版（无半份：activation 行与 effective_version 同生同死）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先造一条同 activation_id 不可复现的失败：直接 mock——给库加触发器让 INSERT\n\t\t// evolution_activations 失败，观察 rollback（SQLite 触发器属测试夹具注入的故障）。\n\t\tstore.db.exec(\n\t\t\t`CREATE TEMP TRIGGER fail_act_insert BEFORE INSERT ON evolution_activations\n\t\t\t WHEN NEW.kind = 'publish' AND json_extract(NEW.source_links_json, '$.activation') = 'effective'\n\t\t\t BEGIN SELECT RAISE(ABORT, 'simulated insert failure'); END`,\n\t\t);\n\t\tawait expect(\n\t\t\tactivateCandidate(store, {\n\t\t\t\tcandidateId,\n\t\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\t\tpaoHome: home,\n\t\t\t}),\n\t\t).rejects.toThrow();\n\t\tstore.db.exec(`DROP TRIGGER fail_act_insert`);\n\n\t\t// 指向仍停旧版（INSERT 失败回滚了 UPDATE），无 effective 行。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND json_extract(source_links_json, '$.activation') = 'effective'`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t});\n\n\tit(\"来源依据失效（validation 的 source_links 行引用已删记忆）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(home, store);\n\t\tvoid versionId;\n\n\t\t// 给 validation 行加一条引用已删记忆的 source link（记忆行不存在）。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tconst valId = validationId;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'validation', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-del-${valId}`, valId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\t\tvoid problemId;\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"记忆 mem-ghost 已被删除排除\");\n\t});\n});\n\n// ── rollbackResource ─────────────────────────────────────────────────────\n\ndescribe(\"rollbackResource\", () => {\n\tit(\"当前指向是 badVersion → 切回 previousVersion + rollback activation 行 + 坏版凭据标停用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先 activate 到 badVersion。\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"复现原问题回归\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rolled_back\");\n\n\t\t// 指向回到 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// rollback activation 落库，source_links 带 sourceIds。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason, source_links_json\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string; source_links_json: string };\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(JSON.parse(row.source_links_json).sourceIds).toEqual([\"src-reg-1\"]);\n\n\t\t// 坏版的 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t\t   AND json_extract(source_links_json, '$.candidateId') = ?`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId, candidateId) as { reason: string };\n\t\texpect(pubRow.reason.startsWith(\"停用:\")).toBe(true);\n\t});\n\n\tit(\"当前指向已非 badVersion（另一修复已生效）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\n\t\t// 另一路径把 effective_version 改成第三个版本（模拟回退期间另一修复已生效）。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId, // 认为该回退的坏版\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"判定退步\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tif (result.status !== \"no_change\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(otherVersion);\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t\t// 没有 rollback activation 写入。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`)\n\t\t\t.get(resourceId) as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tbadVersion: \"v-xxxxxxxxxxxx\",\n\t\t\tpreviousVersion: \"v-yyyyyyyyyyyy\",\n\t\t\tsourceIds: [],\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── getEffectiveVersion ──────────────────────────────────────────────────\n\ndescribe(\"getEffectiveVersion\", () => {\n\tit(\"激活后返回新 versionId + available=true（目录完整）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(true);\n\t\texpect(info.versionDir).toContain(versionId);\n\t});\n\n\tit(\"未激活时指向 baseVersion（快照目录完整 → available=true）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedPublished(home, store);\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(baseVersion);\n\t\texpect(info.available).toBe(true);\n\t});\n\n\tit(\"指向版本目录缺失/不完整 → available=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\t// 删版本目录文件 → 指纹不匹配。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId), { recursive: true, force: true });\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst info = getEffectiveVersion(store, \"skill:missing\", home);\n\t\texpect(info.ok).toBe(false);\n\t\tif (info.ok) return;\n\t\texpect(info.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable resourceId is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"resourceId"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-activation.test.ts"},"span":[19359,19369],"sourceCode":"/**\n * S9-02/03 定向测试：版本生效前置核对 + 原子事务（activateCandidate/rollbackResource/getEffectiveVersion）。\n *\n * 覆盖：\n * - 成功路径：publish → activate → effective_version 更新 + kind='publish'/activation='effective' 行；\n * - expectedEffectiveVersion 不匹配 → conflict；\n * - 验证期资源被改（文件指纹变 → conflict；另起 effective_version 变也 conflict）；\n * - 候选非 passed / 未发布 / 版本目录缺文件 → conflict；\n * - auto_evolution_enabled=false → conflict；\n * - 事务内失败 → 指向只能旧版或完整新版，无半份；\n * - rollbackResource：指向是 badVersion → 切回 + rollback 行 + 坏版凭据标停用；\n *   指向已非 badVersion → no_change 不覆盖其他已生效修复；\n * - getEffectiveVersion 正常/目录缺失。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-activation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport {\n\tactivateCandidate,\n\tgetEffectiveVersion,\n\trollbackResource,\n} from \"../../src/pao/evolution/activation.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-act-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 种一个已登记 skill 资源 + baseVersion 快照（effective_version=baseVersion）。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 直插 problem 行（classified）。O12/E11：补 problem source link（activation 前置核对要求非空 links）。 */\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// problem 级来源关联（非 src- 前缀：不查 sources 行，作为有效来源）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\n/** 直插 candidate 行 + 候选目录文件（默认 passed）。 */\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tfiles?: Record<string, string>;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径，activation 前置核对要求非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tconst files = over.files ?? {\n\t\t\"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\",\n\t\t\"examples/a.md\": \"示例 A\\n\",\n\t};\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tconst abs = join(candidateDir, rel);\n\t\tmkdirSync(join(abs, \"..\"), { recursive: true });\n\t\twriteFileSync(abs, content, \"utf8\");\n\t}\n\treturn { candidateId, candidateDir };\n}\n\n/** 直插 validation 行（默认 passed）。 */\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: {\n\t\tvalidationId?: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tverdict?: string;\n\t\tcreatedAt?: string;\n\t},\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, total_usage_ref, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tJSON.stringify([]),\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tnull,\n\t\t\tover.createdAt ?? AT,\n\t\t\tover.createdAt ?? AT,\n\t\t);\n\t// O12/E11：validation（运行验证）级来源关联；冻结计划（tp-1）级同样补一条\n\t// （activation 核对 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", over.createdAt ?? AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", over.createdAt ?? AT);\n\treturn validationId;\n}\n\n/** 一套 ready-to-activate：resource + problem + 合法 passed 链 + publish。 */\nasync function seedPublished(home: string, store: MemoryStore) {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，直接种 passed 行过不了——\n\t// 跑 freeze→双侧 run→evaluate 真实链得到合法 passed。\n\tconst { candidateId, validationId } = await legalPassedChain(store, home, {\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 验证\\n\", \"examples/a.md\": \"示例 A\\n\" },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(`publish failed: ${JSON.stringify(pub)}`);\n\treturn { resourceId, baseVersion, skillDir, problemId, candidateId, validationId, versionId: pub.versionId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── activateCandidate ────────────────────────────────────────────────────\n\ndescribe(\"activateCandidate\", () => {\n\tit(\"publish → activate 成功：effective_version 更新 + effective activation 行落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tauthRef: \"auth-xyz\",\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"versionId\" in result).toBe(true);\n\t\tif (!(\"versionId\" in result)) return;\n\t\texpect(result.versionId).toBe(versionId);\n\t\texpect(result.fromVersion).toBe(baseVersion);\n\n\t\t// effective_version 指向新版本。\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\t// 新增 activation 行：kind='publish'、activation='effective'、authRef 落 source_links。\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, source_links_json, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? ORDER BY created_at`,\n\t\t\t)\n\t\t\t.all(resourceId, versionId) as Array<{ kind: string; source_links_json: string; reason: string }>;\n\t\texpect(acts.length).toBe(2); // 落盘凭据 + 生效凭据\n\t\tconst effective = acts.find((a) => JSON.parse(a.source_links_json).activation === \"effective\");\n\t\texpect(effective).toBeDefined();\n\t\texpect(JSON.parse(effective!.source_links_json).authRef).toBe(\"auth-xyz\");\n\t\texpect(effective!.reason).toContain(candidateId);\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: \"v-notcurrent00\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(baseVersion);\n\t\t// 指向仍停在 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tvoid versionId;\n\t});\n\n\tit(\"验证期资源根被人工改（文件内容变）→ conflict，旧版保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\n\t\t// 验证通过后人工改 SKILL.md（指纹偏离 base_version）。\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t\t// 旧指向未动。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"验证期资源根被人工加文件（指纹变）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, skillDir, candidateId } = await seedPublished(home, store);\n\t\twriteFileSync(join(skillDir, \"extra.md\"), \"新增\\n\", \"utf8\");\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"验证期 effective_version 已变（另一生效已写入）→ conflict，不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 另一路径先把 effective_version 改成别的（模拟另一激活已生效）。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(versionId, AT3, resourceId);\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(versionId);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\t});\n\n\tit(\"候选非 passed → conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion, status: \"testing\" });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n\n\tit(\"候选未发布（无 publish 凭据）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = seedCandidate(store, home, { problemId, resourceId, baseVersion });\n\t\tseedValidation(store, { candidateId, problemId, resourceId, baseVersion });\n\t\t// 不走 publishCandidate。\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"版本目录缺文件（指纹不匹配）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 删除版本目录里一个文件。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId, \"examples\", \"a.md\"));\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"auto_evolution_enabled=false → conflict，指向不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId } = await seedPublished(home, store);\n\t\tsetAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"事务内写失败 → 指向只能旧版（无半份：activation 行与 effective_version 同生同死）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先造一条同 activation_id 不可复现的失败：直接 mock——给库加触发器让 INSERT\n\t\t// evolution_activations 失败，观察 rollback（SQLite 触发器属测试夹具注入的故障）。\n\t\tstore.db.exec(\n\t\t\t`CREATE TEMP TRIGGER fail_act_insert BEFORE INSERT ON evolution_activations\n\t\t\t WHEN NEW.kind = 'publish' AND json_extract(NEW.source_links_json, '$.activation') = 'effective'\n\t\t\t BEGIN SELECT RAISE(ABORT, 'simulated insert failure'); END`,\n\t\t);\n\t\tawait expect(\n\t\t\tactivateCandidate(store, {\n\t\t\t\tcandidateId,\n\t\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\t\tpaoHome: home,\n\t\t\t}),\n\t\t).rejects.toThrow();\n\t\tstore.db.exec(`DROP TRIGGER fail_act_insert`);\n\n\t\t// 指向仍停旧版（INSERT 失败回滚了 UPDATE），无 effective 行。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t\tconst acts = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS n FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND json_extract(source_links_json, '$.activation') = 'effective'`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId) as { n: number };\n\t\texpect(acts.n).toBe(0);\n\t});\n\n\tit(\"来源依据失效（validation 的 source_links 行引用已删记忆）→ conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, problemId, candidateId, validationId, versionId } = await seedPublished(home, store);\n\t\tvoid versionId;\n\n\t\t// 给 validation 行加一条引用已删记忆的 source link（记忆行不存在）。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tconst valId = validationId;\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'validation', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-del-${valId}`, valId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\t\tvoid problemId;\n\n\t\tconst result = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.reason).toContain(\"记忆 mem-ghost 已被删除排除\");\n\t});\n});\n\n// ── rollbackResource ─────────────────────────────────────────────────────\n\ndescribe(\"rollbackResource\", () => {\n\tit(\"当前指向是 badVersion → 切回 previousVersion + rollback activation 行 + 坏版凭据标停用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\n\t\t// 先 activate 到 badVersion。\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(versionId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"复现原问题回归\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rolled_back\");\n\n\t\t// 指向回到 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// rollback activation 落库，source_links 带 sourceIds。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason, source_links_json\n\t\t\t\t FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string; source_links_json: string };\n\t\texpect(row.from_version).toBe(versionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(JSON.parse(row.source_links_json).sourceIds).toEqual([\"src-reg-1\"]);\n\n\t\t// 坏版的 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'\n\t\t\t\t   AND json_extract(source_links_json, '$.candidateId') = ?`,\n\t\t\t)\n\t\t\t.get(resourceId, versionId, candidateId) as { reason: string };\n\t\texpect(pubRow.reason.startsWith(\"停用:\")).toBe(true);\n\t});\n\n\tit(\"当前指向已非 badVersion（另一修复已生效）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tconst act = await activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\texpect(act.ok && \"versionId\" in act).toBe(true);\n\n\t\t// 另一路径把 effective_version 改成第三个版本（模拟回退期间另一修复已生效）。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: versionId, // 认为该回退的坏版\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-reg-1\"],\n\t\t\treason: \"判定退步\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tif (result.status !== \"no_change\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(otherVersion);\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t\t// 没有 rollback activation 写入。\n\t\tconst n = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_activations WHERE resource_id = ? AND kind = 'rollback'`)\n\t\t\t.get(resourceId) as { n: number };\n\t\texpect(n.n).toBe(0);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = rollbackResource(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tbadVersion: \"v-xxxxxxxxxxxx\",\n\t\t\tpreviousVersion: \"v-yyyyyyyyyyyy\",\n\t\t\tsourceIds: [],\n\t\t\treason: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── getEffectiveVersion ──────────────────────────────────────────────────\n\ndescribe(\"getEffectiveVersion\", () => {\n\tit(\"激活后返回新 versionId + available=true（目录完整）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(true);\n\t\texpect(info.versionDir).toContain(versionId);\n\t});\n\n\tit(\"未激活时指向 baseVersion（快照目录完整 → available=true）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedPublished(home, store);\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(baseVersion);\n\t\texpect(info.available).toBe(true);\n\t});\n\n\tit(\"指向版本目录缺失/不完整 → available=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, candidateId, versionId } = await seedPublished(home, store);\n\t\tawait activateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t\tcreatedAt: AT3,\n\t\t});\n\t\t// 删版本目录文件 → 指纹不匹配。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, versionId), { recursive: true, force: true });\n\n\t\tconst info = getEffectiveVersion(store, resourceId, home);\n\t\texpect(info.ok).toBe(true);\n\t\tif (!info.ok) return;\n\t\texpect(info.versionId).toBe(versionId);\n\t\texpect(info.available).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst info = getEffectiveVersion(store, \"skill:missing\", home);\n\t\texpect(info.ok).toBe(false);\n\t\tif (info.ok) return;\n\t\texpect(info.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。import { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,125]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[125,299]}}},{"diffOp":{"delete":{"range":[299,315]}}},{"diffOp":{"delete":{"range":[315,317]}}},{"diffOp":{"equal":{"range":[317,532]}}},{"equalLines":{"line_count":490}},{"diffOp":{"equal":{"range":[532,541]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-control.test.ts"},"span":[1123,1139],"sourceCode":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。\n *\n * 覆盖：\n * - restoreResourceVersion 全部判据分支：成功 / 目录缺失或指纹不匹配 /\n *   无可用发布凭据（曾失败标停用）/ 来源依据失效 / expectedEffectiveVersion 冲突；\n * - 恢复事务：UPDATE effective_version + INSERT kind='restore' activation；\n * - setResourceAutoEvolution：停用/恢复本资源，不影响其他资源；\n * - listActivationHistory：publish/restore/rollback 全量时间线 + disabled/effective 标记。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-control.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../../src/pao/evolution/control.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ctl-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（非 src- 前缀，作有效来源；activation/restore\n\t// 前置核对要求 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string; status?: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string; verdict?: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`val-${over.candidateId}`,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"[]\",\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId, skillDir };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── setResourceAutoEvolution ──────────────────────────────────────────────\n\ndescribe(\"setResourceAutoEvolution\", () => {\n\tit(\"停用本资源不影响其他资源；恢复只动本资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store, \"skill-a\");\n\t\tconst { resourceId: otherId } = seedSkill(home, store, \"skill-b\");\n\n\t\t// 停用 A。\n\t\tconst off = setResourceAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\t\texpect(off.ok).toBe(true);\n\t\tif (!off.ok) return;\n\t\texpect(off.autoEvolutionEnabled).toBe(false);\n\n\t\t// B 不受影响。\n\t\tconst other = store.db\n\t\t\t.prepare(`SELECT auto_evolution_enabled FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(otherId) as { auto_evolution_enabled: number };\n\t\texpect(other.auto_evolution_enabled).toBe(1);\n\n\t\t// 恢复 A。\n\t\tconst on = setResourceAutoEvolution(store, { resourceId, enabled: true, updatedAt: AT4 });\n\t\texpect(on.ok).toBe(true);\n\t\tif (!on.ok) return;\n\t\texpect(on.autoEvolutionEnabled).toBe(true);\n\t});\n});\n\n// ── restoreResourceVersion ───────────────────────────────────────────────\n\ndescribe(\"restoreResourceVersion\", () => {\n\tit(\"成功：UPDATE effective_version + INSERT kind='restore' activation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion 之外再造第二版：把 baseVersion 目录指纹与 publish\n\t\t// 凭据补齐——baseVersion 是快照版（无 publish 凭据），恢复它走不通判据 b。\n\t\t// 改为恢复「另一个已发布但未停用的版本」：先回退到 baseVersion，再恢复 newVersionId。\n\t\t// 但 newVersionId 已被停用……所以换个场景：把 newVersionId 当历史版，再造一个\n\t\t// 第三版当坏版，当前指向第三版时恢复 newVersionId（未停用 → 可恢复）。\n\t\t// 简单做法：直接给 baseVersion 补一条 publish 凭据（模拟它也曾被发布过）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-basepub\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbaseVersion,\n\t\t\t\t\"基础版发布凭据（夹具补）\",\n\t\t\t\tJSON.stringify({ candidateId: \"cand-base\" }),\n\t\t\t\tAT,\n\t\t\t);\n\t\t// cand-base 对应候选行（判据 c 查 candidate source_links；不存在则如实报）。\n\t\t// 这里不种候选 → checkRestoreSourceLinksIntact 会返回候选不存在 → needs_reevaluation。\n\t\t// 所以种一个候选行。\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-base\",\n\t\t\tproblemId: seedProblem(store, { problemId: \"prob-base\", resourceId, baseVersion }),\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\t\t// cand-base 的 test_plan_id=\"tp-1\"：restore 核对「凭据候选的 testPlan\n\t\t// 来源关联非空」——补 tp-1 级 link（原由 seedValidation 顺带写入）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'validation', 'tp-1', 'evidence:probe-1', ?)`,\n\t\t\t)\n\t\t\t.run(\"link-tp-1-restore\", AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t\treason: \"人工恢复基础版\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"restored\" in result && result.restored).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// restore activation 落库。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'restore'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string };\n\t\texpect(row.from_version).toBe(newVersionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(row.reason).toContain(\"人工恢复基础版\");\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: \"v-stale-old000\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(newVersionId);\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"目标版本目录缺失 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: \"v-notexist0000\",\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"目标版本曾失败被停用（publish 凭据标「停用:」）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion：rollbackResource 会给 newVersionId 的 publish 凭据标停用。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\tconst rb = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-x\"],\n\t\t\treason: \"退步\",\n\t\t});\n\t\texpect(rb.ok && rb.status === \"rolled_back\").toBe(true);\n\n\t\t// 现在尝试恢复已停用的 newVersionId → needs_reevaluation。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"目标版本来源依据失效（凭据候选引用已删记忆）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\t// 给 newVersionId 的凭据候选加一条引用已删记忆的 source link。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-ghost-${candidateId}`, candidateId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId === readEffective(store, resourceId) ? baseVersion : newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\t// 当前指向是 newVersionId；targetVersionId 也是 newVersionId → 先撞\n\t\t// 「已是当前生效版」分支。改为先切到别的再恢复。\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\n\t\t// 先把指向切到 baseVersion，再恢复 newVersionId → 应 needs_reevaluation。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, AT4, resourceId);\n\t\tconst result2 = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result2.ok).toBe(true);\n\t\tif (!result2.ok) return;\n\t\texpect(\"status\" in result2 && result2.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result2) || result2.status !== \"needs_reevaluation\") return;\n\t\texpect(result2.reason).toContain(\"mem-ghost\");\n\t});\n\n\tit(\"目标版本无任何 publish 凭据 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// baseVersion 是快照版，盘上目录在但无 publish 凭据。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"目标版本已是当前生效版 → conflict 无需恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n});\n\n// ── listActivationHistory ────────────────────────────────────────────────\n\ndescribe(\"listActivationHistory\", () => {\n\tit(\"返回 publish/restore/rollback 全量按时间序，含 disabled/effective 标记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 手动回退一次（多一条 rollback 行 + 坏版 publish 凭据标停用）。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\trollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-r\"],\n\t\t\treason: \"退步回退\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\n\t\tconst result = listActivationHistory(store, resourceId);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// 落盘凭据(publish) + 生效凭据(publish/effective) + rollback = 3 行。\n\t\texpect(result.items.length).toBe(3);\n\t\tconst kinds = result.items.map((i) => i.kind);\n\t\texpect(kinds).toEqual([\"publish\", \"publish\", \"rollback\"]);\n\n\t\t// 生效凭据行：effective=true。\n\t\tconst effectiveRow = result.items.find((i) => i.effective);\n\t\texpect(effectiveRow).toBeDefined();\n\t\texpect(effectiveRow!.toVersion).toBe(newVersionId);\n\t\texpect(effectiveRow!.kind).toBe(\"publish\");\n\n\t\t// 坏版 publish 凭据被标停用（disabled=true）。\n\t\tconst pubCred = result.items.find(\n\t\t\t(i) => i.kind === \"publish\" && i.toVersion === newVersionId && !i.effective,\n\t\t);\n\t\texpect(pubCred).toBeDefined();\n\t\texpect(pubCred!.disabled).toBe(true);\n\n\t\t// rollback 行 from/to 正确。\n\t\tconst rbRow = result.items.find((i) => i.kind === \"rollback\");\n\t\texpect(rbRow!.fromVersion).toBe(newVersionId);\n\t\texpect(rbRow!.toVersion).toBe(baseVersion);\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function seedValidation is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。}\n\nfunction seedValidation_seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string; verdict?: string },\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,125]}}},{"equalLines":{"line_count":153}},{"diffOp":{"equal":{"range":[125,137]}}},{"diffOp":{"delete":{"range":[137,151]}}},{"diffOp":{"insert":{"range":[151,166]}}},{"diffOp":{"equal":{"range":[166,298]}}},{"equalLines":{"line_count":351}},{"diffOp":{"equal":{"range":[298,307]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-control.test.ts"},"span":[5885,5899],"sourceCode":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。\n *\n * 覆盖：\n * - restoreResourceVersion 全部判据分支：成功 / 目录缺失或指纹不匹配 /\n *   无可用发布凭据（曾失败标停用）/ 来源依据失效 / expectedEffectiveVersion 冲突；\n * - 恢复事务：UPDATE effective_version + INSERT kind='restore' activation；\n * - setResourceAutoEvolution：停用/恢复本资源，不影响其他资源；\n * - listActivationHistory：publish/restore/rollback 全量时间线 + disabled/effective 标记。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-control.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../../src/pao/evolution/control.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ctl-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（非 src- 前缀，作有效来源；activation/restore\n\t// 前置核对要求 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string; status?: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string; verdict?: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`val-${over.candidateId}`,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"[]\",\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId, skillDir };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── setResourceAutoEvolution ──────────────────────────────────────────────\n\ndescribe(\"setResourceAutoEvolution\", () => {\n\tit(\"停用本资源不影响其他资源；恢复只动本资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store, \"skill-a\");\n\t\tconst { resourceId: otherId } = seedSkill(home, store, \"skill-b\");\n\n\t\t// 停用 A。\n\t\tconst off = setResourceAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\t\texpect(off.ok).toBe(true);\n\t\tif (!off.ok) return;\n\t\texpect(off.autoEvolutionEnabled).toBe(false);\n\n\t\t// B 不受影响。\n\t\tconst other = store.db\n\t\t\t.prepare(`SELECT auto_evolution_enabled FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(otherId) as { auto_evolution_enabled: number };\n\t\texpect(other.auto_evolution_enabled).toBe(1);\n\n\t\t// 恢复 A。\n\t\tconst on = setResourceAutoEvolution(store, { resourceId, enabled: true, updatedAt: AT4 });\n\t\texpect(on.ok).toBe(true);\n\t\tif (!on.ok) return;\n\t\texpect(on.autoEvolutionEnabled).toBe(true);\n\t});\n});\n\n// ── restoreResourceVersion ───────────────────────────────────────────────\n\ndescribe(\"restoreResourceVersion\", () => {\n\tit(\"成功：UPDATE effective_version + INSERT kind='restore' activation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion 之外再造第二版：把 baseVersion 目录指纹与 publish\n\t\t// 凭据补齐——baseVersion 是快照版（无 publish 凭据），恢复它走不通判据 b。\n\t\t// 改为恢复「另一个已发布但未停用的版本」：先回退到 baseVersion，再恢复 newVersionId。\n\t\t// 但 newVersionId 已被停用……所以换个场景：把 newVersionId 当历史版，再造一个\n\t\t// 第三版当坏版，当前指向第三版时恢复 newVersionId（未停用 → 可恢复）。\n\t\t// 简单做法：直接给 baseVersion 补一条 publish 凭据（模拟它也曾被发布过）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-basepub\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbaseVersion,\n\t\t\t\t\"基础版发布凭据（夹具补）\",\n\t\t\t\tJSON.stringify({ candidateId: \"cand-base\" }),\n\t\t\t\tAT,\n\t\t\t);\n\t\t// cand-base 对应候选行（判据 c 查 candidate source_links；不存在则如实报）。\n\t\t// 这里不种候选 → checkRestoreSourceLinksIntact 会返回候选不存在 → needs_reevaluation。\n\t\t// 所以种一个候选行。\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-base\",\n\t\t\tproblemId: seedProblem(store, { problemId: \"prob-base\", resourceId, baseVersion }),\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\t\t// cand-base 的 test_plan_id=\"tp-1\"：restore 核对「凭据候选的 testPlan\n\t\t// 来源关联非空」——补 tp-1 级 link（原由 seedValidation 顺带写入）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'validation', 'tp-1', 'evidence:probe-1', ?)`,\n\t\t\t)\n\t\t\t.run(\"link-tp-1-restore\", AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t\treason: \"人工恢复基础版\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"restored\" in result && result.restored).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// restore activation 落库。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'restore'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string };\n\t\texpect(row.from_version).toBe(newVersionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(row.reason).toContain(\"人工恢复基础版\");\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: \"v-stale-old000\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(newVersionId);\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"目标版本目录缺失 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: \"v-notexist0000\",\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"目标版本曾失败被停用（publish 凭据标「停用:」）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion：rollbackResource 会给 newVersionId 的 publish 凭据标停用。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\tconst rb = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-x\"],\n\t\t\treason: \"退步\",\n\t\t});\n\t\texpect(rb.ok && rb.status === \"rolled_back\").toBe(true);\n\n\t\t// 现在尝试恢复已停用的 newVersionId → needs_reevaluation。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"目标版本来源依据失效（凭据候选引用已删记忆）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\t// 给 newVersionId 的凭据候选加一条引用已删记忆的 source link。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-ghost-${candidateId}`, candidateId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId === readEffective(store, resourceId) ? baseVersion : newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\t// 当前指向是 newVersionId；targetVersionId 也是 newVersionId → 先撞\n\t\t// 「已是当前生效版」分支。改为先切到别的再恢复。\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\n\t\t// 先把指向切到 baseVersion，再恢复 newVersionId → 应 needs_reevaluation。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, AT4, resourceId);\n\t\tconst result2 = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result2.ok).toBe(true);\n\t\tif (!result2.ok) return;\n\t\texpect(\"status\" in result2 && result2.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result2) || result2.status !== \"needs_reevaluation\") return;\n\t\texpect(result2.reason).toContain(\"mem-ghost\");\n\t});\n\n\tit(\"目标版本无任何 publish 凭据 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// baseVersion 是快照版，盘上目录在但无 publish 凭据。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"目标版本已是当前生效版 → conflict 无需恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n});\n\n// ── listActivationHistory ────────────────────────────────────────────────\n\ndescribe(\"listActivationHistory\", () => {\n\tit(\"返回 publish/restore/rollback 全量按时间序，含 disabled/effective 标记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 手动回退一次（多一条 rollback 行 + 坏版 publish 凭据标停用）。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\trollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-r\"],\n\t\t\treason: \"退步回退\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\n\t\tconst result = listActivationHistory(store, resourceId);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// 落盘凭据(publish) + 生效凭据(publish/effective) + rollback = 3 行。\n\t\texpect(result.items.length).toBe(3);\n\t\tconst kinds = result.items.map((i) => i.kind);\n\t\texpect(kinds).toEqual([\"publish\", \"publish\", \"rollback\"]);\n\n\t\t// 生效凭据行：effective=true。\n\t\tconst effectiveRow = result.items.find((i) => i.effective);\n\t\texpect(effectiveRow).toBeDefined();\n\t\texpect(effectiveRow!.toVersion).toBe(newVersionId);\n\t\texpect(effectiveRow!.kind).toBe(\"publish\");\n\n\t\t// 坏版 publish 凭据被标停用（disabled=true）。\n\t\tconst pubCred = result.items.find(\n\t\t\t(i) => i.kind === \"publish\" && i.toVersion === newVersionId && !i.effective,\n\t\t);\n\t\texpect(pubCred).toBeDefined();\n\t\texpect(pubCred!.disabled).toBe(true);\n\n\t\t// rollback 行 from/to 正确。\n\t\tconst rbRow = result.items.find((i) => i.kind === \"rollback\");\n\t\texpect(rbRow!.fromVersion).toBe(newVersionId);\n\t\texpect(rbRow!.toVersion).toBe(baseVersion);\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * S8-10/11 定向测试：逐项评估决策与来源/旧候选处理、观察骨架。\n *\tmarkStaleCandidates,\n\trecordEvolutionObservation,\n} from \"../../src/pao/evolution/observe.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { ValidationCaseResult } from \"../../src/pao/evolution/types.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,95]}}},{"equalLines":{"line_count":29}},{"diffOp":{"equal":{"range":[95,190]}}},{"diffOp":{"delete":{"range":[190,254]}}},{"diffOp":{"equal":{"range":[254,333]}}},{"equalLines":{"line_count":907}},{"diffOp":{"equal":{"range":[333,342]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-evaluate.test.ts"},"span":[1904,1922],"sourceCode":"/**\n * S8-10/11 定向测试：逐项评估决策与来源/旧候选处理、观察骨架。\n *\n * 覆盖：\n * - evaluateCandidate：原问题改善且关键正常/保留样例通过才 passed；\n *   总体得分提高不能掩盖关键用法退步；\n *   环境失败记 incomplete 不画成业务失败或通过；\n *   开发样例通过不直接标 passed；\n *   候选定稿后才跑保留样例（holdout 结果参与判定）；\n *   baseline 未复现原问题不宣称改善；\n *   模型随机性补做成对运行后仍不稳定不宣称改善；\n *   evolution_validations 行 + evolution_source_links 写入；\n *   候选状态推进 proposed→testing→passed|failed|cancelled。\n * - cleanupSourceReferences：来源删除沿关联清理候选输入/回执；\n *   未完成保持未完成状态。\n * - markStaleCandidates：基础版本变动标待重评估；旧候选不重新排发布。\n * - recordEvolutionObservation/countEvolutionObservations：三态计数骨架。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-evaluate.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\tcleanupSourceReferences,\n\tcountEvolutionObservations,\n\tmarkStaleCandidates,\n\trecordEvolutionObservation,\n} from \"../../src/pao/evolution/observe.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { ValidationCaseResult } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-eval-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(() => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 残留不阻塞\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nfunction seedSource(store: MemoryStore, sessionId: string, entryId: string, eventType = \"toolResult\"): string {\n\treturn registerSource(store.db, { sessionId, entryId, eventType, capturedAt: AT });\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类 problem。 */\nfunction seedProblem(store: MemoryStore, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n/** 造一个 proposed 状态的候选。 */\nfunction seedCandidate(store: MemoryStore, over: {\n\tcandidateId?: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n\tstatus?: string;\n\tusageRefs?: string[];\n}) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tover.testPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify(over.usageRefs ?? []),\n\t\t\tover.status ?? \"proposed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn candidateId;\n}\n\n/** 组装逐项结果。 */\nfunction makeCaseResult(over: Partial<ValidationCaseResult> & { caseId: string }): ValidationCaseResult {\n\treturn {\n\t\tcaseId: over.caseId,\n\t\tbaseline: over.baseline ?? { passed: false },\n\t\tcandidate: over.candidate ?? { passed: true },\n\t\tverdict: over.verdict ?? \"passed\",\n\t\t...(over.reason === undefined ? {} : { reason: over.reason }),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"evaluateCandidate\", () => {\n\tit(\"原问题改善且关键正常/保留样例全部通过 → passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"holdout-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\ttotalUsageRef: \"req-eval-1\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"passed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.passed).toBe(1);\n\t\texpect(result.score.holdout.passed).toBe(1);\n\t\texpect(result.score.total.passed).toBe(3);\n\n\t\t// 候选状态推进到 passed\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\n\t\t// evolution_validations 行已写入\n\t\tconst valRow = store.db.prepare(`SELECT verdict, case_results_json FROM evolution_validations WHERE candidate_id = ?`).get(candidateId) as { verdict: string; case_results_json: string };\n\t\texpect(valRow.verdict).toBe(\"passed\");\n\t\tconst cases = JSON.parse(valRow.case_results_json) as ValidationCaseResult[];\n\t\texpect(cases).toHaveLength(3);\n\t\texpect(cases[0].verdict).toBe(\"passed\");\n\n\t\t// 费用归因追加到候选\n\t\tconst candRow = store.db.prepare(`SELECT usage_refs_json FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { usage_refs_json: string };\n\t\tconst refs = JSON.parse(candRow.usage_refs_json) as string[];\n\t\texpect(refs).toContain(\"req-eval-1\");\n\n\t\tstore.close();\n\t});\n\n\tit(\"总体得分提高不能掩盖关键用法退步 → failed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 修复但 normal 被破坏——即使总分 1/2 也标 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: false }, verdict: \"failed\", reason: \"正常用法被破坏\" }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.failed).toBe(1);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"failed\");\n\t\texpect(row.failure_reason).toContain(\"验证失败\");\n\t\tstore.close();\n\t});\n\n\tit(\"环境失败记 incomplete 不画成业务失败或通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 启动失败/进程停止未确认 → incomplete（O11/E07：凭 executionFailure 字段判环境失败）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, executionFailure: \"start\", failureReason: \"进程停止未确认\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"环境异常，无法判定业务结果\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\tstore.close();\n\t});\n\n\tit(\"baseline 未复现原问题 → incomplete 而非宣称改善\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline 也 passed——复现不了原问题，验证前提不成立\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"baseline 未复现原问题\");\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 未通过 → failed（即使 candidate 有改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 失败 → 原问题未修复，即使 normal 通过也 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"failed\", reason: \"原问题未修复\" }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型随机性补做成对运行后仍不稳定 → 不宣称改善（保持 incomplete）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 补做后仍 incomplete（前后矛盾未解决）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, failureReason: \"前后结论矛盾，补做后仍不稳定\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"补做成对运行后仍不稳定\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\trepairedContradictions: true,\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tstore.close();\n\t});\n\n\tit(\"evolution_source_links 以 owner_kind=validation 写入\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tsourceRefs: [{ sourceId }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT * FROM evolution_source_links WHERE owner_kind = 'validation' AND owner_id = ?`)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\tstore.close();\n\t});\n\n\tit(\"候选状态机推进 proposed→testing→passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 初始状态 proposed\n\t\tlet row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\");\n\n\t\tevaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\n\t\trow = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\t\tstore.close();\n\t});\n\n\tit(\"testPlanId 不匹配拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: \"tp-wrong\",\n\t\t\tcaseResults: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"testPlanId\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：freezeValidationPlan 不传 sourceRefs 时自动继承 problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-inherit\", \"e-inherit\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 级登记一条来源关联（带 memory 修订定位）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-inherit\", problemId, sourceId, \"mem-9\", 3, AT);\n\n\t\t// 不传 sourceRefs → 内核自动读 problem links。\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(plan.testPlanId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\texpect(links[0].memory_id).toBe(\"mem-9\");\n\t\texpect(links[0].revision).toBe(3);\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：evaluateCandidate 不传 sourceRefs 时自动继承 candidate→problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-eval\", \"e-eval\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 与 candidate 两级各有来源关联：优先继承 candidate 自身 links。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-eval\", problemId, \"evidence:prob-src\", AT);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-cand-eval\", candidateId, sourceId, AT);\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\t// 继承 candidate 自身 links（非 problem）。\n\t\texpect(links.map((l) => l.source_id)).toEqual([sourceId]);\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：plan 内缺 holdout 回执 → incomplete（不宣称改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 只交 reproduction 回执，holdout-0 漏跑 → 完整集合不齐 → incomplete。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\texpect(row.failure_reason).toContain(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：未知 caseId 不在冻结计划内 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"unknown-9\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"未知 caseId:unknown-9\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：重复 caseId 回执 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"重复 caseId:reproduction-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06+E07：baseline 侧 executionFailure 算环境失败 → incomplete（不算 baseline 复现）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline timeout（环境失败）+ candidate passed → 不能据此宣称修复。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false, executionFailure: \"timeout\", failureReason: \"超时\" },\n\t\t\t\t\tcandidate: { passed: true },\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"环境/启动失败\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// cleanupSourceReferences\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"cleanupSourceReferences\", () => {\n\tit(\"来源删除沿关联清理：problem evidenceRefs 缩减，候选取消，link 保留定位\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 登记 source links\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'problem', ?, ?, ?)`)\n\t\t\t.run(\"link-p-1\", problemId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'candidate', ?, ?, ?)`)\n\t\t\t.run(\"link-c-1\", candidateId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", plan.testPlanId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.problemsCleaned).toBeGreaterThanOrEqual(0);\n\t\texpect(result.candidatesCleaned).toBe(1);\n\t\texpect(result.validationsCleaned).toBe(1);\n\n\t\t// 候选被标 cancelled\n\t\tconst candRow = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(candRow.status).toBe(\"cancelled\");\n\t\texpect(candRow.failure_reason).toContain(\"已删除\");\n\t\tstore.close();\n\t});\n\n\tit(\"清理未完成保持未完成状态\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造候选（外键要求 candidate_id 已存在）\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\t// 造一个 incomplete 验证\n\t\tconst validationId = \"val-incomplete-1\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(validationId, plan.testPlanId, candidateId, problemId, resourceId, baseVersion,\n\t\t\t\tJSON.stringify([{ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"incomplete\" }]),\n\t\t\t\t\"incomplete\", AT, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", validationId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.pendingObjects).toHaveLength(1);\n\t\texpect(result.pendingObjects[0].id).toBe(validationId);\n\t\texpect(result.pendingObjects[0].reason).toContain(\"incomplete\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// markStaleCandidates\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"markStaleCandidates\", () => {\n\tit(\"基础版本变动标待重评估；旧候选不得重新排发布\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 新基础版本 → 旧候选标待重评估\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: \"v-new-abc\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(1);\n\t\texpect(result.staleCandidateIds).toContain(candidateId);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"待重评估\");\n\t\texpect(row.failure_reason).toContain(\"不得直接重新排发布\");\n\t\tstore.close();\n\t});\n\n\tit(\"同 baseVersion 的候选不受影响\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: baseVersion, // 同版本\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(0);\n\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\"); // 未变\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 观察骨架：recordEvolutionObservation / countEvolutionObservations\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"观察骨架\", () => {\n\tit(\"viewed/used/patched 三态计数入口（落库后可读回）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\t// 记录观察（evolution_observations 表由 SCHEMA_SQL 建，真实落库）\n\t\tconst viewed = recordEvolutionObservation(store, {\n\t\t\taction: \"viewed\",\n\t\t\tresourceId,\n\t\t\tcandidateId: \"cand-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(viewed.ok).toBe(true);\n\t\tif (!viewed.ok) return;\n\n\t\t// 计数：落库后可读回三态计数\n\t\tconst counts = countEvolutionObservations(store, { resourceId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (!counts.ok) return;\n\t\texpect(counts.persisted).toBe(true);\n\t\texpect(counts.counts.viewed).toBe(1);\n\t\texpect(counts.counts.used).toBe(0);\n\t\texpect(counts.counts.patched).toBe(0);\n\t\texpect(counts.total).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"未知观察动作返回业务错误\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\tconst bad = recordEvolutionObservation(store, {\n\t\t\taction: \"deleted\" as never,\n\t\t\tresourceId,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(bad.ok).toBe(false);\n\t\tif (bad.ok) return;\n\t\texpect(bad.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable sourceId2 is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"sourceId2"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"sourceId2"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S8-10/11 定向测试：逐项评估决策与来源/旧候选处理、观察骨架。\n *\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst sourceId2_sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,95]}}},{"equalLines":{"line_count":750}},{"diffOp":{"equal":{"range":[95,215]}}},{"diffOp":{"delete":{"range":[215,224]}}},{"diffOp":{"insert":{"range":[224,234]}}},{"diffOp":{"equal":{"range":[234,235]}}},{"diffOp":{"equal":{"range":[235,381]}}},{"equalLines":{"line_count":187}},{"diffOp":{"equal":{"range":[381,390]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-evaluate.test.ts"},"span":[30477,30486],"sourceCode":"/**\n * S8-10/11 定向测试：逐项评估决策与来源/旧候选处理、观察骨架。\n *\n * 覆盖：\n * - evaluateCandidate：原问题改善且关键正常/保留样例通过才 passed；\n *   总体得分提高不能掩盖关键用法退步；\n *   环境失败记 incomplete 不画成业务失败或通过；\n *   开发样例通过不直接标 passed；\n *   候选定稿后才跑保留样例（holdout 结果参与判定）；\n *   baseline 未复现原问题不宣称改善；\n *   模型随机性补做成对运行后仍不稳定不宣称改善；\n *   evolution_validations 行 + evolution_source_links 写入；\n *   候选状态推进 proposed→testing→passed|failed|cancelled。\n * - cleanupSourceReferences：来源删除沿关联清理候选输入/回执；\n *   未完成保持未完成状态。\n * - markStaleCandidates：基础版本变动标待重评估；旧候选不重新排发布。\n * - recordEvolutionObservation/countEvolutionObservations：三态计数骨架。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-evaluate.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\tcleanupSourceReferences,\n\tcountEvolutionObservations,\n\tmarkStaleCandidates,\n\trecordEvolutionObservation,\n} from \"../../src/pao/evolution/observe.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { ValidationCaseResult } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-eval-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(() => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 残留不阻塞\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nfunction seedSource(store: MemoryStore, sessionId: string, entryId: string, eventType = \"toolResult\"): string {\n\treturn registerSource(store.db, { sessionId, entryId, eventType, capturedAt: AT });\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类 problem。 */\nfunction seedProblem(store: MemoryStore, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n/** 造一个 proposed 状态的候选。 */\nfunction seedCandidate(store: MemoryStore, over: {\n\tcandidateId?: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n\tstatus?: string;\n\tusageRefs?: string[];\n}) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tover.testPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify(over.usageRefs ?? []),\n\t\t\tover.status ?? \"proposed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn candidateId;\n}\n\n/** 组装逐项结果。 */\nfunction makeCaseResult(over: Partial<ValidationCaseResult> & { caseId: string }): ValidationCaseResult {\n\treturn {\n\t\tcaseId: over.caseId,\n\t\tbaseline: over.baseline ?? { passed: false },\n\t\tcandidate: over.candidate ?? { passed: true },\n\t\tverdict: over.verdict ?? \"passed\",\n\t\t...(over.reason === undefined ? {} : { reason: over.reason }),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"evaluateCandidate\", () => {\n\tit(\"原问题改善且关键正常/保留样例全部通过 → passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"holdout-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\ttotalUsageRef: \"req-eval-1\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"passed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.passed).toBe(1);\n\t\texpect(result.score.holdout.passed).toBe(1);\n\t\texpect(result.score.total.passed).toBe(3);\n\n\t\t// 候选状态推进到 passed\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\n\t\t// evolution_validations 行已写入\n\t\tconst valRow = store.db.prepare(`SELECT verdict, case_results_json FROM evolution_validations WHERE candidate_id = ?`).get(candidateId) as { verdict: string; case_results_json: string };\n\t\texpect(valRow.verdict).toBe(\"passed\");\n\t\tconst cases = JSON.parse(valRow.case_results_json) as ValidationCaseResult[];\n\t\texpect(cases).toHaveLength(3);\n\t\texpect(cases[0].verdict).toBe(\"passed\");\n\n\t\t// 费用归因追加到候选\n\t\tconst candRow = store.db.prepare(`SELECT usage_refs_json FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { usage_refs_json: string };\n\t\tconst refs = JSON.parse(candRow.usage_refs_json) as string[];\n\t\texpect(refs).toContain(\"req-eval-1\");\n\n\t\tstore.close();\n\t});\n\n\tit(\"总体得分提高不能掩盖关键用法退步 → failed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 修复但 normal 被破坏——即使总分 1/2 也标 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: false }, verdict: \"failed\", reason: \"正常用法被破坏\" }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.failed).toBe(1);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"failed\");\n\t\texpect(row.failure_reason).toContain(\"验证失败\");\n\t\tstore.close();\n\t});\n\n\tit(\"环境失败记 incomplete 不画成业务失败或通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 启动失败/进程停止未确认 → incomplete（O11/E07：凭 executionFailure 字段判环境失败）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, executionFailure: \"start\", failureReason: \"进程停止未确认\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"环境异常，无法判定业务结果\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\tstore.close();\n\t});\n\n\tit(\"baseline 未复现原问题 → incomplete 而非宣称改善\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline 也 passed——复现不了原问题，验证前提不成立\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"baseline 未复现原问题\");\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 未通过 → failed（即使 candidate 有改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 失败 → 原问题未修复，即使 normal 通过也 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"failed\", reason: \"原问题未修复\" }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型随机性补做成对运行后仍不稳定 → 不宣称改善（保持 incomplete）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 补做后仍 incomplete（前后矛盾未解决）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, failureReason: \"前后结论矛盾，补做后仍不稳定\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"补做成对运行后仍不稳定\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\trepairedContradictions: true,\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tstore.close();\n\t});\n\n\tit(\"evolution_source_links 以 owner_kind=validation 写入\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tsourceRefs: [{ sourceId }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT * FROM evolution_source_links WHERE owner_kind = 'validation' AND owner_id = ?`)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\tstore.close();\n\t});\n\n\tit(\"候选状态机推进 proposed→testing→passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 初始状态 proposed\n\t\tlet row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\");\n\n\t\tevaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\n\t\trow = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\t\tstore.close();\n\t});\n\n\tit(\"testPlanId 不匹配拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: \"tp-wrong\",\n\t\t\tcaseResults: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"testPlanId\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：freezeValidationPlan 不传 sourceRefs 时自动继承 problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-inherit\", \"e-inherit\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 级登记一条来源关联（带 memory 修订定位）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-inherit\", problemId, sourceId, \"mem-9\", 3, AT);\n\n\t\t// 不传 sourceRefs → 内核自动读 problem links。\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(plan.testPlanId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\texpect(links[0].memory_id).toBe(\"mem-9\");\n\t\texpect(links[0].revision).toBe(3);\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：evaluateCandidate 不传 sourceRefs 时自动继承 candidate→problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-eval\", \"e-eval\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 与 candidate 两级各有来源关联：优先继承 candidate 自身 links。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-eval\", problemId, \"evidence:prob-src\", AT);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-cand-eval\", candidateId, sourceId, AT);\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\t// 继承 candidate 自身 links（非 problem）。\n\t\texpect(links.map((l) => l.source_id)).toEqual([sourceId]);\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：plan 内缺 holdout 回执 → incomplete（不宣称改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 只交 reproduction 回执，holdout-0 漏跑 → 完整集合不齐 → incomplete。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\texpect(row.failure_reason).toContain(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：未知 caseId 不在冻结计划内 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"unknown-9\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"未知 caseId:unknown-9\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：重复 caseId 回执 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"重复 caseId:reproduction-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06+E07：baseline 侧 executionFailure 算环境失败 → incomplete（不算 baseline 复现）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline timeout（环境失败）+ candidate passed → 不能据此宣称修复。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false, executionFailure: \"timeout\", failureReason: \"超时\" },\n\t\t\t\t\tcandidate: { passed: true },\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"环境/启动失败\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// cleanupSourceReferences\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"cleanupSourceReferences\", () => {\n\tit(\"来源删除沿关联清理：problem evidenceRefs 缩减，候选取消，link 保留定位\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 登记 source links\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'problem', ?, ?, ?)`)\n\t\t\t.run(\"link-p-1\", problemId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'candidate', ?, ?, ?)`)\n\t\t\t.run(\"link-c-1\", candidateId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", plan.testPlanId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.problemsCleaned).toBeGreaterThanOrEqual(0);\n\t\texpect(result.candidatesCleaned).toBe(1);\n\t\texpect(result.validationsCleaned).toBe(1);\n\n\t\t// 候选被标 cancelled\n\t\tconst candRow = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(candRow.status).toBe(\"cancelled\");\n\t\texpect(candRow.failure_reason).toContain(\"已删除\");\n\t\tstore.close();\n\t});\n\n\tit(\"清理未完成保持未完成状态\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造候选（外键要求 candidate_id 已存在）\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\t// 造一个 incomplete 验证\n\t\tconst validationId = \"val-incomplete-1\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(validationId, plan.testPlanId, candidateId, problemId, resourceId, baseVersion,\n\t\t\t\tJSON.stringify([{ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"incomplete\" }]),\n\t\t\t\t\"incomplete\", AT, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", validationId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.pendingObjects).toHaveLength(1);\n\t\texpect(result.pendingObjects[0].id).toBe(validationId);\n\t\texpect(result.pendingObjects[0].reason).toContain(\"incomplete\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// markStaleCandidates\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"markStaleCandidates\", () => {\n\tit(\"基础版本变动标待重评估；旧候选不得重新排发布\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 新基础版本 → 旧候选标待重评估\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: \"v-new-abc\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(1);\n\t\texpect(result.staleCandidateIds).toContain(candidateId);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"待重评估\");\n\t\texpect(row.failure_reason).toContain(\"不得直接重新排发布\");\n\t\tstore.close();\n\t});\n\n\tit(\"同 baseVersion 的候选不受影响\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: baseVersion, // 同版本\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(0);\n\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\"); // 未变\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 观察骨架：recordEvolutionObservation / countEvolutionObservations\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"观察骨架\", () => {\n\tit(\"viewed/used/patched 三态计数入口（落库后可读回）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\t// 记录观察（evolution_observations 表由 SCHEMA_SQL 建，真实落库）\n\t\tconst viewed = recordEvolutionObservation(store, {\n\t\t\taction: \"viewed\",\n\t\t\tresourceId,\n\t\t\tcandidateId: \"cand-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(viewed.ok).toBe(true);\n\t\tif (!viewed.ok) return;\n\n\t\t// 计数：落库后可读回三态计数\n\t\tconst counts = countEvolutionObservations(store, { resourceId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (!counts.ok) return;\n\t\texpect(counts.persisted).toBe(true);\n\t\texpect(counts.counts.viewed).toBe(1);\n\t\texpect(counts.counts.used).toBe(0);\n\t\texpect(counts.counts.patched).toBe(0);\n\t\texpect(counts.total).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"未知观察动作返回业务错误\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\tconst bad = recordEvolutionObservation(store, {\n\t\t\taction: \"deleted\" as never,\n\t\t\tresourceId,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(bad.ok).toBe(false);\n\t\tif (bad.ok) return;\n\t\texpect(bad.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\t});\r\n});\r\n","ops":[{"diffOp":{"equal":{"range":[0,223]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[223,394]}}},{"diffOp":{"delete":{"range":[394,405]}}},{"diffOp":{"delete":{"range":[405,407]}}},{"diffOp":{"equal":{"range":[407,517]}}},{"equalLines":{"line_count":414}},{"diffOp":{"equal":{"range":[517,528]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o13.test.ts"},"span":[1326,1337],"sourceCode":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\n *\r\n * 覆盖（对应 O13 任务书 §测试与回归）：\r\n * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出\r\n *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。\r\n * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→\r\n *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后\r\n *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。\r\n * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。\r\n * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression\r\n *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。\r\n * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。\r\n *\r\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { afterEach, describe, expect, it } from \"vitest\";\r\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\r\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\r\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\r\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\r\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\r\nimport { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";\r\nimport { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";\r\nimport { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";\r\nimport { handleRegression } from \"../../src/pao/evolution/regression.ts\";\r\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\r\nimport { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\nconst tempDirs: string[] = [];\r\nconst openStores: MemoryStore[] = [];\r\n\r\nfunction tempHome(): string {\r\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\r\n\ttempDirs.push(dir);\r\n\treturn dir;\r\n}\r\nfunction openStore(home: string): MemoryStore {\r\n\tconst store = openMemoryStore(home, \"readwrite\");\r\n\topenStores.push(store);\r\n\treturn store;\r\n}\r\nafterEach(async () => {\r\n\tfor (const store of openStores.splice(0)) {\r\n\t\ttry {\r\n\t\t\tstore.close();\r\n\t\t} catch {\r\n\t\t\t// 已关\r\n\t\t}\r\n\t}\r\n\tfor (const dir of tempDirs.splice(0)) {\r\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(dir, { recursive: true, force: true });\r\n\t\t\t\tbreak;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tif (attempt === 4) throw error;\r\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\nconst AT = \"2026-11-11T10:00:00.000Z\";\r\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\r\n\r\n/** 种一个已登记 skill 资源 + baseVersion 快照。 */\r\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\r\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\r\n\tmkdirSync(skillDir, { recursive: true });\r\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\r\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\r\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\r\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\r\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\r\n}\r\n\r\n/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */\r\nasync function runRound(\r\n\thome: string,\r\n\tstore: MemoryStore,\r\n\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },\r\n) {\r\n\tconst problemId = seedClassifiedProblem(store, {\r\n\t\tproblemId: `prob-${over.name}`,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t});\r\n\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\tproblemId,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t\tfiles: { \"SKILL.md\": over.newContent },\r\n\t});\r\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\tconst act = await activateCandidate(store, {\r\n\t\tcandidateId,\r\n\t\texpectedEffectiveVersion: over.expectedEffective,\r\n\t\tpaoHome: home,\r\n\t\tcreatedAt: AT2,\r\n\t});\r\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\r\n\treturn { candidateId, versionId: act.versionId };\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E14 新任务初始绑定\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E14 ensureTaskBindings\", () => {\r\n\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\r\n\t\t// task_bindings 行已落。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.ok && bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"无登记资源 → 空清单不建绑定\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths).toEqual([]);\r\n\t\texpect(ensured.mounted).toEqual([]);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(0);\r\n\t});\r\n\r\n\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 首轮 ensure。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\t// 激活新版 → effective 变。\r\n\t\tawait runRound(home, store, {\r\n\t\t\tname: \"r2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tseedSkill(home, store, \"skill-a\");\r\n\t\tseedSkill(home, store, \"skill-b\");\r\n\t\tconst ensured = ensureTaskBindings(store, {\r\n\t\t\ttaskId: \"worker-1\",\r\n\t\t\tpaoHome: home,\r\n\t\t\tresourceIds: [\"skill:skill-a\"],\r\n\t\t});\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E15 激活基线分离（两轮进化）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E15 两轮进化基线分离\", () => {\r\n\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 第一轮 v1。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 资源根不动（不回写正式资源根）。\r\n\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\r\n\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\r\n\t\tconst r2 = await runRound(home, store, {\r\n\t\t\tname: \"v2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion: r1.versionId,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\r\n\t\t\texpectedEffective: r1.versionId,\r\n\t\t});\r\n\t\texpect(r2.versionId).not.toBe(r1.versionId);\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(r2.versionId);\r\n\t});\r\n\r\n\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\r\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\r\n\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\r\n\t\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\t\tproblemId,\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\r\n\t\t});\r\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\t\tconst act = await activateCandidate(store, {\r\n\t\t\tcandidateId,\r\n\t\t\texpectedEffectiveVersion: baseVersion,\r\n\t\t\tpaoHome: home,\r\n\t\t\tcreatedAt: AT2,\r\n\t\t});\r\n\t\texpect(act.ok).toBe(true);\r\n\t\tif (!act.ok) return;\r\n\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\r\n\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\r\n\t\tif (\"status\" in act && act.status === \"conflict\") {\r\n\t\t\texpect(act.reason).toContain(\"根基线\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-06 使用观察（recordUsed 挂点语义）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-06 recordUsed 挂点语义\", () => {\r\n\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\tconst written = recordUsed(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tsessionId: \"sess-1\",\r\n\t\t\treceiptRef: \"session:sess-1:settled:1\",\r\n\t\t\toutcome: \"success\",\r\n\t\t});\r\n\t\texpect(written.ok).toBe(true);\r\n\t\tif (!written.ok) return;\r\n\t\texpect(written.versionId).toBe(baseVersion);\r\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\r\n\t\texpect(counts.ok).toBe(true);\r\n\t\tif (counts.ok) {\r\n\t\t\texpect(counts.used).toBe(1);\r\n\t\t\texpect(counts.success).toBe(1);\r\n\t\t}\r\n\t});\r\n\r\n\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId } = seedSkill(home, store);\r\n\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\r\n\t\texpect(written.ok).toBe(false);\r\n\t\tif (written.ok) return;\r\n\t\texpect(written.error.code).toBe(\"invalid_input\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-08/09 退步回退编排\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-08/09 handleRegression 编排\", () => {\r\n\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 会话绑定到 v1。\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\tproblemId: \"prob-v1\",\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tfailureDescription: \"v1 上线后功能坏\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t\t// effective 回退到上一有效版（baseVersion）。\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(baseVersion);\r\n\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\r\n\t\texpect(regression.affectedTasks.length).toBe(1);\r\n\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\r\n\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\r\n\t\t// 受影响任务换绑定到回退目标（宿主消费）。\r\n\t\tswitchTaskResourceAtSafePoint(store, {\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tresourceId,\r\n\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\r\n\t\t\treason: \"退步回退\",\r\n\t\t});\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\r\n\t\t// 坏版上有 used 行。\r\n\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-2\",\r\n\t\t\tfailureDescription: \"v1 用着坏了\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-11 启动恢复（跨进程一致）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-11 启动恢复\", () => {\r\n\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\t// 进程 A：写入绑定 + 激活。\r\n\t\t{\r\n\t\t\tconst storeA = openStore(home);\r\n\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\r\n\t\t\tawait runRound(home, storeA, {\r\n\t\t\t\tname: \"v1\",\r\n\t\t\t\tresourceId,\r\n\t\t\t\tbaseVersion,\r\n\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\t\texpectedEffective: baseVersion,\r\n\t\t\t});\r\n\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\r\n\t\t}\r\n\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\r\n\t\tconst storeB = openStore(home);\r\n\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\texpect(report.resources.length).toBe(1);\r\n\t\texpect(report.resources[0]!.dirOk).toBe(true);\r\n\t\texpect(report.needsAttention).toEqual([]);\r\n\t\t// 绑定仍在且指 effective 版。\r\n\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\tconst effective = (storeB.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(bindings.items[0]!.resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t});\r\n\r\n\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\r\n\t\t// 删版本目录。\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\r\n\t\tconst report = recoverEvolutionState(store, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\r\n\t\texpect(view!.staleBindings.length).toBe(1);\r\n\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\r\n\t\texpect(attn).toBeDefined();\r\n\t\t// 绑定行未被改动。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n});\r\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable r1 is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"r1"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"r1"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1_r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\t});\r\n});\r\n","ops":[{"diffOp":{"equal":{"range":[0,223]}}},{"equalLines":{"line_count":302}},{"diffOp":{"equal":{"range":[223,361]}}},{"diffOp":{"delete":{"range":[361,363]}}},{"diffOp":{"insert":{"range":[363,366]}}},{"diffOp":{"equal":{"range":[366,367]}}},{"diffOp":{"equal":{"range":[367,431]}}},{"equalLines":{"line_count":124}},{"diffOp":{"equal":{"range":[431,442]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o13.test.ts"},"span":[14847,14849],"sourceCode":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\n *\r\n * 覆盖（对应 O13 任务书 §测试与回归）：\r\n * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出\r\n *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。\r\n * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→\r\n *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后\r\n *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。\r\n * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。\r\n * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression\r\n *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。\r\n * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。\r\n *\r\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { afterEach, describe, expect, it } from \"vitest\";\r\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\r\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\r\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\r\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\r\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\r\nimport { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";\r\nimport { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";\r\nimport { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";\r\nimport { handleRegression } from \"../../src/pao/evolution/regression.ts\";\r\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\r\nimport { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\nconst tempDirs: string[] = [];\r\nconst openStores: MemoryStore[] = [];\r\n\r\nfunction tempHome(): string {\r\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\r\n\ttempDirs.push(dir);\r\n\treturn dir;\r\n}\r\nfunction openStore(home: string): MemoryStore {\r\n\tconst store = openMemoryStore(home, \"readwrite\");\r\n\topenStores.push(store);\r\n\treturn store;\r\n}\r\nafterEach(async () => {\r\n\tfor (const store of openStores.splice(0)) {\r\n\t\ttry {\r\n\t\t\tstore.close();\r\n\t\t} catch {\r\n\t\t\t// 已关\r\n\t\t}\r\n\t}\r\n\tfor (const dir of tempDirs.splice(0)) {\r\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(dir, { recursive: true, force: true });\r\n\t\t\t\tbreak;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tif (attempt === 4) throw error;\r\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\nconst AT = \"2026-11-11T10:00:00.000Z\";\r\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\r\n\r\n/** 种一个已登记 skill 资源 + baseVersion 快照。 */\r\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\r\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\r\n\tmkdirSync(skillDir, { recursive: true });\r\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\r\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\r\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\r\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\r\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\r\n}\r\n\r\n/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */\r\nasync function runRound(\r\n\thome: string,\r\n\tstore: MemoryStore,\r\n\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },\r\n) {\r\n\tconst problemId = seedClassifiedProblem(store, {\r\n\t\tproblemId: `prob-${over.name}`,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t});\r\n\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\tproblemId,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t\tfiles: { \"SKILL.md\": over.newContent },\r\n\t});\r\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\tconst act = await activateCandidate(store, {\r\n\t\tcandidateId,\r\n\t\texpectedEffectiveVersion: over.expectedEffective,\r\n\t\tpaoHome: home,\r\n\t\tcreatedAt: AT2,\r\n\t});\r\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\r\n\treturn { candidateId, versionId: act.versionId };\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E14 新任务初始绑定\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E14 ensureTaskBindings\", () => {\r\n\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\r\n\t\t// task_bindings 行已落。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.ok && bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"无登记资源 → 空清单不建绑定\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths).toEqual([]);\r\n\t\texpect(ensured.mounted).toEqual([]);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(0);\r\n\t});\r\n\r\n\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 首轮 ensure。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\t// 激活新版 → effective 变。\r\n\t\tawait runRound(home, store, {\r\n\t\t\tname: \"r2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tseedSkill(home, store, \"skill-a\");\r\n\t\tseedSkill(home, store, \"skill-b\");\r\n\t\tconst ensured = ensureTaskBindings(store, {\r\n\t\t\ttaskId: \"worker-1\",\r\n\t\t\tpaoHome: home,\r\n\t\t\tresourceIds: [\"skill:skill-a\"],\r\n\t\t});\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E15 激活基线分离（两轮进化）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E15 两轮进化基线分离\", () => {\r\n\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 第一轮 v1。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 资源根不动（不回写正式资源根）。\r\n\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\r\n\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\r\n\t\tconst r2 = await runRound(home, store, {\r\n\t\t\tname: \"v2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion: r1.versionId,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\r\n\t\t\texpectedEffective: r1.versionId,\r\n\t\t});\r\n\t\texpect(r2.versionId).not.toBe(r1.versionId);\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(r2.versionId);\r\n\t});\r\n\r\n\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\r\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\r\n\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\r\n\t\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\t\tproblemId,\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\r\n\t\t});\r\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\t\tconst act = await activateCandidate(store, {\r\n\t\t\tcandidateId,\r\n\t\t\texpectedEffectiveVersion: baseVersion,\r\n\t\t\tpaoHome: home,\r\n\t\t\tcreatedAt: AT2,\r\n\t\t});\r\n\t\texpect(act.ok).toBe(true);\r\n\t\tif (!act.ok) return;\r\n\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\r\n\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\r\n\t\tif (\"status\" in act && act.status === \"conflict\") {\r\n\t\t\texpect(act.reason).toContain(\"根基线\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-06 使用观察（recordUsed 挂点语义）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-06 recordUsed 挂点语义\", () => {\r\n\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\tconst written = recordUsed(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tsessionId: \"sess-1\",\r\n\t\t\treceiptRef: \"session:sess-1:settled:1\",\r\n\t\t\toutcome: \"success\",\r\n\t\t});\r\n\t\texpect(written.ok).toBe(true);\r\n\t\tif (!written.ok) return;\r\n\t\texpect(written.versionId).toBe(baseVersion);\r\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\r\n\t\texpect(counts.ok).toBe(true);\r\n\t\tif (counts.ok) {\r\n\t\t\texpect(counts.used).toBe(1);\r\n\t\t\texpect(counts.success).toBe(1);\r\n\t\t}\r\n\t});\r\n\r\n\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId } = seedSkill(home, store);\r\n\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\r\n\t\texpect(written.ok).toBe(false);\r\n\t\tif (written.ok) return;\r\n\t\texpect(written.error.code).toBe(\"invalid_input\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-08/09 退步回退编排\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-08/09 handleRegression 编排\", () => {\r\n\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 会话绑定到 v1。\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\tproblemId: \"prob-v1\",\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tfailureDescription: \"v1 上线后功能坏\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t\t// effective 回退到上一有效版（baseVersion）。\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(baseVersion);\r\n\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\r\n\t\texpect(regression.affectedTasks.length).toBe(1);\r\n\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\r\n\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\r\n\t\t// 受影响任务换绑定到回退目标（宿主消费）。\r\n\t\tswitchTaskResourceAtSafePoint(store, {\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tresourceId,\r\n\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\r\n\t\t\treason: \"退步回退\",\r\n\t\t});\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\r\n\t\t// 坏版上有 used 行。\r\n\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-2\",\r\n\t\t\tfailureDescription: \"v1 用着坏了\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-11 启动恢复（跨进程一致）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-11 启动恢复\", () => {\r\n\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\t// 进程 A：写入绑定 + 激活。\r\n\t\t{\r\n\t\t\tconst storeA = openStore(home);\r\n\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\r\n\t\t\tawait runRound(home, storeA, {\r\n\t\t\t\tname: \"v1\",\r\n\t\t\t\tresourceId,\r\n\t\t\t\tbaseVersion,\r\n\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\t\texpectedEffective: baseVersion,\r\n\t\t\t});\r\n\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\r\n\t\t}\r\n\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\r\n\t\tconst storeB = openStore(home);\r\n\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\texpect(report.resources.length).toBe(1);\r\n\t\texpect(report.resources[0]!.dirOk).toBe(true);\r\n\t\texpect(report.needsAttention).toEqual([]);\r\n\t\t// 绑定仍在且指 effective 版。\r\n\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\tconst effective = (storeB.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(bindings.items[0]!.resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t});\r\n\r\n\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\r\n\t\t// 删版本目录。\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\r\n\t\tconst report = recoverEvolutionState(store, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\r\n\t\texpect(view!.staleBindings.length).toBe(1);\r\n\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\r\n\t\texpect(attn).toBeDefined();\r\n\t\t// 绑定行未被改动。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n});\r\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable r1 is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"r1"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"r1"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1_r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\t});\r\n});\r\n","ops":[{"diffOp":{"equal":{"range":[0,223]}}},{"equalLines":{"line_count":348}},{"diffOp":{"equal":{"range":[223,328]}}},{"diffOp":{"delete":{"range":[328,330]}}},{"diffOp":{"insert":{"range":[330,333]}}},{"diffOp":{"equal":{"range":[333,334]}}},{"diffOp":{"equal":{"range":[334,398]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[398,409]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-o13.test.ts"},"span":[16911,16913],"sourceCode":"/**\r\n * O13 定向测试：新任务初始绑定（ensureTaskBindings）、激活基线分离（两轮进化）、\r\n * 使用观察（recordUsed 挂点语义）、退步回退（handleRegression 编排）与启动恢复。\r\n *\r\n * 覆盖（对应 O13 任务书 §测试与回归）：\r\n * - E14：ensureTaskBindings 全量口径绑已生效资源 → task_bindings 行 + 解析出\r\n *   versionDir；无登记资源 → 空清单不建绑定；恢复会话重绑走 UPDATE 同行。\r\n * - E15：两轮完整改进——v0 快照→候选→publish→activate(v1)→资源根不动→\r\n *   v2 候选(baseVersion=v1)→publish→activate(v2) 成功不冲突；人工改资源根后\r\n *   激活照走版本目录核对（拦截发生在根基线核对，非 base_version 核对）。\r\n * - S9-06：recordUsed 按 active 绑定逐条写，outcome 前缀正确；无绑定不记。\r\n * - S9-08/09：declare 带 resourceId 满足 original_problem → handleRegression\r\n *   rollback + affectedTasks 列绑定任务 + 同源未终态候选 cancelled。\r\n * - S9-11：recoverEvolutionState 跨进程一致（进程 A 写入→B 读报告与库一致）。\r\n *\r\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-o13.test.ts --maxWorkers=1\r\n */\r\nimport { mkdtempSync, mkdirSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { afterEach, describe, expect, it } from \"vitest\";\r\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\r\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\r\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\r\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\r\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\r\nimport { bindTaskResources, listTaskBindings, switchTaskResourceAtSafePoint } from \"../../src/pao/evolution/binding.ts\";\r\nimport { ensureTaskBindings } from \"../../src/pao/evolution/host-mount.ts\";\r\nimport { recordUsed, countUsageByVersion } from \"../../src/pao/evolution/observe.ts\";\r\nimport { handleRegression } from \"../../src/pao/evolution/regression.ts\";\r\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\r\nimport { legalPassedChain, seedClassifiedProblem } from \"./fixtures/evolution-legal-chain.ts\";\r\n\r\nconst tempDirs: string[] = [];\r\nconst openStores: MemoryStore[] = [];\r\n\r\nfunction tempHome(): string {\r\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-o13-\"));\r\n\ttempDirs.push(dir);\r\n\treturn dir;\r\n}\r\nfunction openStore(home: string): MemoryStore {\r\n\tconst store = openMemoryStore(home, \"readwrite\");\r\n\topenStores.push(store);\r\n\treturn store;\r\n}\r\nafterEach(async () => {\r\n\tfor (const store of openStores.splice(0)) {\r\n\t\ttry {\r\n\t\t\tstore.close();\r\n\t\t} catch {\r\n\t\t\t// 已关\r\n\t\t}\r\n\t}\r\n\tfor (const dir of tempDirs.splice(0)) {\r\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\r\n\t\t\ttry {\r\n\t\t\t\trmSync(dir, { recursive: true, force: true });\r\n\t\t\t\tbreak;\r\n\t\t\t} catch (error) {\r\n\t\t\t\tif (attempt === 4) throw error;\r\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\nconst AT = \"2026-11-11T10:00:00.000Z\";\r\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\r\n\r\n/** 种一个已登记 skill 资源 + baseVersion 快照。 */\r\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\r\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\r\n\tmkdirSync(skillDir, { recursive: true });\r\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\r\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\r\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\r\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\r\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\r\n}\r\n\r\n/** 跑一轮完整合法链：problem → legalPassedChain → publish → activate。 */\r\nasync function runRound(\r\n\thome: string,\r\n\tstore: MemoryStore,\r\n\tover: { name: string; resourceId: string; baseVersion: string; newContent: string; expectedEffective: string },\r\n) {\r\n\tconst problemId = seedClassifiedProblem(store, {\r\n\t\tproblemId: `prob-${over.name}`,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t});\r\n\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\tproblemId,\r\n\t\tresourceId: over.resourceId,\r\n\t\tbaseVersion: over.baseVersion,\r\n\t\tfiles: { \"SKILL.md\": over.newContent },\r\n\t});\r\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\tconst act = await activateCandidate(store, {\r\n\t\tcandidateId,\r\n\t\texpectedEffectiveVersion: over.expectedEffective,\r\n\t\tpaoHome: home,\r\n\t\tcreatedAt: AT2,\r\n\t});\r\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(`activate failed: ${JSON.stringify(act)}`);\r\n\treturn { candidateId, versionId: act.versionId };\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E14 新任务初始绑定\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E14 ensureTaskBindings\", () => {\r\n\tit(\"全量口径：已生效资源绑进新任务，解析出 versionDir 进 skillPaths\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// effective_version = baseVersion（快照即首个可恢复版本）。\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-1\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\texpect(ensured.skillPaths[0]).toBe(join(evolutionPaths(home).versions, dirSafe, baseVersion));\r\n\t\t// task_bindings 行已落。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.ok && bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(resourceId);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"无登记资源 → 空清单不建绑定\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst ensured = ensureTaskBindings(store, { taskId: \"session-empty\", paoHome: home });\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths).toEqual([]);\r\n\t\texpect(ensured.mounted).toEqual([]);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"session-empty\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(0);\r\n\t});\r\n\r\n\tit(\"恢复会话重绑：同一 (task,resource) 走 UPDATE 同行，版本刷新到新 effective\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 首轮 ensure。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\t// 激活新版 → effective 变。\r\n\t\tawait runRound(home, store, {\r\n\t\t\tname: \"r2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\t// 恢复会话重 ensure → 同行走 UPDATE 到新 effective。\r\n\t\tensureTaskBindings(store, { taskId: \"sess\", paoHome: home });\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t\texpect(bindings.items[0]!.versionId).not.toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"显式 resourceIds 清单口径（派发）：只绑清单内资源\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tseedSkill(home, store, \"skill-a\");\r\n\t\tseedSkill(home, store, \"skill-b\");\r\n\t\tconst ensured = ensureTaskBindings(store, {\r\n\t\t\ttaskId: \"worker-1\",\r\n\t\t\tpaoHome: home,\r\n\t\t\tresourceIds: [\"skill:skill-a\"],\r\n\t\t});\r\n\t\texpect(ensured.ok).toBe(true);\r\n\t\tif (!ensured.ok) return;\r\n\t\texpect(ensured.skillPaths.length).toBe(1);\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"worker-1\" });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\texpect(bindings.items[0]!.resourceId).toBe(\"skill:skill-a\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// E15 激活基线分离（两轮进化）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"E15 两轮进化基线分离\", () => {\r\n\tit(\"v0→v1→v2 连续激活成功：资源根不动，第二轮 base_version=v1 走版本目录核对\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 第一轮 v1。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 资源根不动（不回写正式资源根）。\r\n\t\texpect(require(\"node:fs\").readFileSync(join(skillDir, \"SKILL.md\"), \"utf8\")).not.toContain(\"v1\");\r\n\t\t// 第二轮 v2：base_version=v1（新 effective），走版本目录核对。\r\n\t\tconst r2 = await runRound(home, store, {\r\n\t\t\tname: \"v2\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion: r1.versionId,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v2\\n\",\r\n\t\t\texpectedEffective: r1.versionId,\r\n\t\t});\r\n\t\texpect(r2.versionId).not.toBe(r1.versionId);\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(r2.versionId);\r\n\t});\r\n\r\n\tit(\"人工改资源根 → 下一轮激活照走版本目录核对但根基线核对拦截\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store);\r\n\t\t// 人工改资源根（根基线=v0 快照指纹，改动后不一致）。\r\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# test-skill\\n\\n步骤一: 输入\\n步骤三: 人工补丁\\n\", \"utf8\");\r\n\t\tconst problemId = seedClassifiedProblem(store, { problemId: \"prob-x\", resourceId, baseVersion });\r\n\t\tconst { candidateId } = await legalPassedChain(store, home, {\r\n\t\t\tproblemId,\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tfiles: { \"SKILL.md\": \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\" },\r\n\t\t});\r\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\r\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\r\n\t\tconst act = await activateCandidate(store, {\r\n\t\t\tcandidateId,\r\n\t\t\texpectedEffectiveVersion: baseVersion,\r\n\t\t\tpaoHome: home,\r\n\t\t\tcreatedAt: AT2,\r\n\t\t});\r\n\t\texpect(act.ok).toBe(true);\r\n\t\tif (!act.ok) return;\r\n\t\t// 根基线核对拦截（不再是 base_version 核对——版本目录分支本来会过）。\r\n\t\texpect(\"status\" in act && act.status === \"conflict\").toBe(true);\r\n\t\tif (\"status\" in act && act.status === \"conflict\") {\r\n\t\t\texpect(act.reason).toContain(\"根基线\");\r\n\t\t}\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-06 使用观察（recordUsed 挂点语义）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-06 recordUsed 挂点语义\", () => {\r\n\tit(\"active 绑定逐条 used：outcome 前缀编进 receipt_ref\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\tconst written = recordUsed(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tsessionId: \"sess-1\",\r\n\t\t\treceiptRef: \"session:sess-1:settled:1\",\r\n\t\t\toutcome: \"success\",\r\n\t\t});\r\n\t\texpect(written.ok).toBe(true);\r\n\t\tif (!written.ok) return;\r\n\t\texpect(written.versionId).toBe(baseVersion);\r\n\t\tconst counts = countUsageByVersion(store, { resourceId, versionId: baseVersion });\r\n\t\texpect(counts.ok).toBe(true);\r\n\t\tif (counts.ok) {\r\n\t\t\texpect(counts.used).toBe(1);\r\n\t\t\texpect(counts.success).toBe(1);\r\n\t\t}\r\n\t});\r\n\r\n\tit(\"无绑定会话记 used → invalid_input 不写\", () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId } = seedSkill(home, store);\r\n\t\tconst written = recordUsed(store, { resourceId, taskId: \"sess-nobind\", receiptRef: \"x\" });\r\n\t\texpect(written.ok).toBe(false);\r\n\t\tif (written.ok) return;\r\n\t\texpect(written.error.code).toBe(\"invalid_input\");\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-08/09 退步回退编排\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-08/09 handleRegression 编排\", () => {\r\n\tit(\"problem 的候选发布过当前坏版 → original_problem → rollback + affectedTasks + cancelPending\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\t// 一轮进化激活 v1（资源根不动，effective=v1）。\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\t// 会话绑定到 v1。\r\n\t\tbindTaskResources(store, { taskId: \"sess-1\", resourceIds: [resourceId] });\r\n\t\t// 声明问题 resourceId + problemId 指 r1 的 problem（其候选发布了 v1=当前坏版）。\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\tproblemId: \"prob-v1\",\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tfailureDescription: \"v1 上线后功能坏\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"original_problem\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t\t// effective 回退到上一有效版（baseVersion）。\r\n\t\tconst effective = (store.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(effective).toBe(baseVersion);\r\n\t\t// affectedTasks 列出绑坏版的任务 + targetVersion=回退目标。\r\n\t\texpect(regression.affectedTasks.length).toBe(1);\r\n\t\texpect(regression.affectedTasks[0]!.taskId).toBe(\"sess-1\");\r\n\t\texpect(regression.affectedTasks[0]!.targetVersion).toBe(baseVersion);\r\n\t\t// 受影响任务换绑定到回退目标（宿主消费）。\r\n\t\tswitchTaskResourceAtSafePoint(store, {\r\n\t\t\ttaskId: \"sess-1\",\r\n\t\t\tresourceId,\r\n\t\t\tnewVersionId: regression.affectedTasks[0]!.targetVersion,\r\n\t\t\treason: \"退步回退\",\r\n\t\t});\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-1\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n\r\n\tit(\"正常用法破坏（used 行+active 绑定坏版）→ normal_breakage\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tconst r1 = await runRound(home, store, {\r\n\t\t\tname: \"v1\",\r\n\t\t\tresourceId,\r\n\t\t\tbaseVersion,\r\n\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\texpectedEffective: baseVersion,\r\n\t\t});\r\n\t\tbindTaskResources(store, { taskId: \"sess-2\", resourceIds: [resourceId] });\r\n\t\t// 坏版上有 used 行。\r\n\t\trecordUsed(store, { resourceId, taskId: \"sess-2\", receiptRef: \"r1\", outcome: \"success\" });\r\n\t\tconst regression = handleRegression(store, {\r\n\t\t\tresourceId,\r\n\t\t\ttaskId: \"sess-2\",\r\n\t\t\tfailureDescription: \"v1 用着坏了\",\r\n\t\t\tpaoHome: home,\r\n\t\t});\r\n\t\texpect(regression.ok).toBe(true);\r\n\t\tif (!regression.ok) return;\r\n\t\texpect(regression.judgement.isRegression).toBe(true);\r\n\t\texpect(regression.judgement.kind).toBe(\"normal_breakage\");\r\n\t\texpect(regression.rolledBack).toBe(true);\r\n\t});\r\n});\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// S9-11 启动恢复（跨进程一致）\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\ndescribe(\"S9-11 启动恢复\", () => {\r\n\tit(\"进程 A 写绑定+激活 → 进程 B 启动 recover 读到一致状态\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\t// 进程 A：写入绑定 + 激活。\r\n\t\t{\r\n\t\t\tconst storeA = openStore(home);\r\n\t\t\tconst { resourceId, baseVersion } = seedSkill(home, storeA);\r\n\t\t\tawait runRound(home, storeA, {\r\n\t\t\t\tname: \"v1\",\r\n\t\t\t\tresourceId,\r\n\t\t\t\tbaseVersion,\r\n\t\t\t\tnewContent: \"# test-skill\\n\\n步骤一: 输入\\n步骤三: v1\\n\",\r\n\t\t\t\texpectedEffective: baseVersion,\r\n\t\t\t});\r\n\t\t\tensureTaskBindings(storeA, { taskId: \"sess-persist\", paoHome: home });\r\n\t\t}\r\n\t\t// 进程 B：新 store 句柄重开（模拟重启）→ recover 读到一致。\r\n\t\tconst storeB = openStore(home);\r\n\t\tconst report = recoverEvolutionState(storeB, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\texpect(report.resources.length).toBe(1);\r\n\t\texpect(report.resources[0]!.dirOk).toBe(true);\r\n\t\texpect(report.needsAttention).toEqual([]);\r\n\t\t// 绑定仍在且指 effective 版。\r\n\t\tconst bindings = listTaskBindings(storeB, { taskId: \"sess-persist\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items.length).toBe(1);\r\n\t\tconst effective = (storeB.db.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`).get(bindings.items[0]!.resourceId) as { effective_version: string }).effective_version;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(effective);\r\n\t});\r\n\r\n\tit(\"staleBinding：绑定指向目录被删 → 报出且不改绑定\", async () => {\r\n\t\tconst home = tempHome();\r\n\t\tconst store = openStore(home);\r\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\r\n\t\tensureTaskBindings(store, { taskId: \"sess-stale\", paoHome: home });\r\n\t\t// 删版本目录。\r\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\r\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, baseVersion), { recursive: true, force: true });\r\n\t\tconst report = recoverEvolutionState(store, { paoHome: home });\r\n\t\texpect(report.ok).toBe(true);\r\n\t\tif (!report.ok) return;\r\n\t\tconst view = report.resources.find((r) => r.resourceId === resourceId);\r\n\t\texpect(view!.staleBindings.length).toBe(1);\r\n\t\tconst attn = report.needsAttention.find((a) => a.kind === \"stale_binding\");\r\n\t\texpect(attn).toBeDefined();\r\n\t\t// 绑定行未被改动。\r\n\t\tconst bindings = listTaskBindings(store, { taskId: \"sess-stale\", activeOnly: true });\r\n\t\texpect(bindings.ok).toBe(true);\r\n\t\tif (!bindings.ok) return;\r\n\t\texpect(bindings.items[0]!.versionId).toBe(baseVersion);\r\n\t});\r\n});\r\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function skillResource is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"skillResource"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"skillResource"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *// ════════════════════════════════════════════════════════════════════════\n\nfunction skillResource_skillResource(paoHome: string, name = \"code-review\") {\n\tconst result = registerResource(openMemoryStore(paoHome, \"readwrite\"), {\n\t\tkind: \"skill\",\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":149}},{"diffOp":{"equal":{"range":[73,303]}}},{"diffOp":{"delete":{"range":[303,316]}}},{"diffOp":{"insert":{"range":[316,330]}}},{"diffOp":{"equal":{"range":[330,462]}}},{"equalLines":{"line_count":298}},{"diffOp":{"equal":{"range":[462,471]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-policy.test.ts"},"span":[7291,7304],"sourceCode":"/**\n * S8-01/02 定向测试：受控自进化策略与资源登记。\n *\n * 覆盖：\n * - resolveEvolutionResource：授权类别映射 resourceId/资源根/允许操作；\n *   未授权类别返回拒绝；空目标名拒绝。\n * - assertCandidateWithinScope：候选文件必须在资源根内；越界（改核心、\n *   表结构、权限、预算、加载机制）被拒且给理由；策略引用不能扩大授权。\n * - registerResource/getResource/listResources：登记幂等（不重复请求\n *   已授予类别）；未登记 resourceId 返回拒绝。\n * - snapshotResourceFiles：列出当前文件及哈希，生成 baseVersion 底座。\n * - setAutoEvolution：单独停用/恢复某资源。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-policy.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport {\n\tFORBIDDEN_EVOLUTION_TARGETS,\n\tassertCandidatePathsWithinScope,\n\tassertCandidateWithinScope,\n\tcheckForbiddenTarget,\n\tresolveEvolutionResource,\n} from \"../../src/pao/evolution/policy.ts\";\nimport {\n\tlistResources,\n\tregisterResource,\n\tsetAutoEvolution,\n\tsnapshotResourceFiles,\n} from \"../../src/pao/evolution/resources.ts\";\nimport { formatResourceId, parseResourceId } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\n// ════════════════════════════════════════════════════════════════════════\n// resolveEvolutionResource\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resolveEvolutionResource\", () => {\n\tit(\"授权类别映射为 resourceId/资源根/允许操作\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"skill:code-review\");\n\t\texpect(result.relativeRoot).toBe(\"pao配置/skills/code-review\");\n\t\texpect(result.allowedOps).toEqual([\"edit-content\"]);\n\t\texpect(result.loadMethod).toBe(\"skill-path\");\n\t\texpect(result.absoluteRoot).toBe(join(home, \"pao配置/skills/code-review\"));\n\t});\n\n\tit(\"recipe 类别映射到部门配方路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"recipe:研发部\");\n\t\texpect(result.relativeRoot).toBe(\"部门/研发部/配方.md\");\n\t});\n\n\tit(\"memory-policy 类别映射到 memory/ 策略路径\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resourceId).toBe(\"memory-policy:recall\");\n\t\texpect(result.relativeRoot).toBe(\"memory/recall\");\n\t\texpect(result.allowedOps).toEqual([\"adjust-policy\"]);\n\t});\n\n\tit(\"未授权类别返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"kernel\" as never, name: \"core\", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"未授权的进化资源类别\");\n\t});\n\n\tit(\"空目标名返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst result = resolveEvolutionResource({ kind: \"skill\", name: \"  \", paoHome: home });\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// parseResourceId / formatResourceId\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"resourceId 解析与组装\", () => {\n\tit(\"合法 resourceId 解析成功\", () => {\n\t\texpect(parseResourceId(\"skill:code-review\")).toEqual({ kind: \"skill\", name: \"code-review\" });\n\t\texpect(parseResourceId(\"memory-policy:recall\")).toEqual({ kind: \"memory-policy\", name: \"recall\" });\n\t});\n\n\tit(\"非法 resourceId 返回 undefined\", () => {\n\t\texpect(parseResourceId(\"noskill:x\")).toBeUndefined();\n\t\texpect(parseResourceId(\"skill\")).toBeUndefined();\n\t\texpect(parseResourceId(\"\")).toBeUndefined();\n\t});\n\n\tit(\"formatResourceId 组装正确\", () => {\n\t\texpect(formatResourceId(\"skill\", \"a\")).toBe(\"skill:a\");\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// checkForbiddenTarget\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"checkForbiddenTarget\", () => {\n\tit(\"固定禁止对象命中并给出理由\", () => {\n\t\tconst cases: Array<[string, string]> = [\n\t\t\t[\"src/pao/role.ts\", \"权限/角色门控\"],\n\t\t\t[\"pao配置/档位.json\", \"档位配置数值\"],\n\t\t\t[\"pao配置/记忆后台预算.json\", \"记忆后台预算\"],\n\t\t\t[\"memory/memory.sqlite\", \"表结构\"],\n\t\t\t[\"src/core/resource-loader.ts\", \"资源加载与更新机制\"],\n\t\t\t[\"plans/未來.md\", \"正式决定/计划文件\"],\n\t\t];\n\t\tfor (const [path, fragment] of cases) {\n\t\t\tconst reason = checkForbiddenTarget(path);\n\t\t\texpect(reason, `path=${path}`).toBeDefined();\n\t\t\texpect(reason).toContain(fragment);\n\t\t}\n\t});\n\n\tit(\"资源根内普通文件不命中禁止对象\", () => {\n\t\texpect(checkForbiddenTarget(\"pao配置/skills/code-review/SKILL.md\")).toBeUndefined();\n\t\texpect(checkForbiddenTarget(\"部门/研发部/配方.md\")).toBeUndefined();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// assertCandidateWithinScope\n// ════════════════════════════════════════════════════════════════════════\n\nfunction skillResource(paoHome: string, name = \"code-review\") {\n\tconst result = registerResource(openMemoryStore(paoHome, \"readwrite\"), {\n\t\tkind: \"skill\",\n\t\tname,\n\t\tpaoHome,\n\t});\n\tif (!result.ok) throw new Error(\"registerResource failed\");\n\treturn result;\n}\n\ndescribe(\"assertCandidateWithinScope\", () => {\n\tit(\"资源根内文件通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [\n\t\t\t\t{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" },\n\t\t\t\t{ path: \"pao配置/skills/code-review/examples/a.md\", kind: \"edit\" },\n\t\t\t],\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"改内核源码被拒且给理由\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"src/pao/role.ts\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t\texpect(result.error.message).toContain(\"权限/角色门控\");\n\t\tstore.close();\n\t});\n\n\tit(\"改表结构文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/memory.sqlite\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"表结构\");\n\t\tstore.close();\n\t});\n\n\tit(\"改预算配置被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/记忆后台预算.json\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"记忆后台预算\");\n\t\tstore.close();\n\t});\n\n\tit(\"超出资源根的文件被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/other-skill/SKILL.md\", kind: \"edit\" }],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"策略引用超出能力范围被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"memory-policy\", name: \"recall\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"memory/recall/policy.json\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"表结构\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"超出记忆策略能力范围\");\n\t\tstore.close();\n\t});\n\n\tit(\"非 memory-policy 类别传 policyRefs 被拒\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst result = assertCandidateWithinScope({\n\t\t\tresource,\n\t\t\tdiffs: [{ path: \"pao配置/skills/code-review/SKILL.md\", kind: \"edit\" }],\n\t\t\tpolicyRefs: [\"检索参数\"],\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"非记忆策略类别\");\n\t\tstore.close();\n\t});\n\n\tit(\"assertCandidatePathsWithinScope 简版路径检查\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst resource = registerResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tif (!resource.ok) throw new Error(\"register failed\");\n\t\tconst ok = assertCandidatePathsWithinScope(resource, [\"pao配置/skills/code-review/SKILL.md\"]);\n\t\texpect(ok.ok).toBe(true);\n\t\tconst bad = assertCandidatePathsWithinScope(resource, [\"src/pao/role.ts\"]);\n\t\texpect(bad.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// registerResource / getResource / listResources / setAutoEvolution\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"资源登记与开关\", () => {\n\tit(\"登记后 getResource 可读，listResources 可按类别过滤\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst skill = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst recipe = registerResource(store, { kind: \"recipe\", name: \"b\", paoHome: home });\n\t\texpect(skill.ok && recipe.ok).toBe(true);\n\n\t\tconst got = store.db.prepare(\"SELECT COUNT(*) AS n FROM evolution_resources\").get() as { n: number };\n\t\texpect(got.n).toBe(2);\n\n\t\tconst all = listResources(store);\n\t\texpect(all.ok && all.items.length).toBe(2);\n\t\tconst skillsOnly = listResources(store, \"skill\");\n\t\texpect(skillsOnly.ok && skillsOnly.items.length).toBe(1);\n\t\texpect(skillsOnly.ok && skillsOnly.items[0].resourceId).toBe(\"skill:a\");\n\t\tstore.close();\n\t});\n\n\tit(\"重复登记返回已有记录，不重复请求已授予类别\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst first = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\tconst second = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home, registeredAt: AT });\n\t\texpect(first.ok && second.ok).toBe(true);\n\t\tif (!first.ok || !second.ok) return;\n\t\texpect(second.resourceId).toBe(first.resourceId);\n\t\texpect(second.registeredAt).toBe(first.registeredAt);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记 resourceId 返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst result = store.db\n\t\t\t.prepare(\"SELECT resource_id FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:ghost\");\n\t\texpect(result).toBeUndefined();\n\t\tconst got = registerResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\texpect(got.ok).toBe(true);\n\t\t// getResource 对未登记 ID 走 invalid_input\n\t\tconst missing = listResources(store, \"extension\");\n\t\texpect(missing.ok && missing.items.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"setAutoEvolution 单独停用/恢复某资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"a\", paoHome: home });\n\t\tconst disabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: false, updatedAt: AT });\n\t\texpect(disabled.ok && disabled.autoEvolutionEnabled).toBe(false);\n\t\tconst enabled = setAutoEvolution(store, { resourceId: \"skill:a\", enabled: true, updatedAt: AT });\n\t\texpect(enabled.ok && enabled.autoEvolutionEnabled).toBe(true);\n\t\tconst missing = setAutoEvolution(store, { resourceId: \"skill:ghost\", enabled: false });\n\t\texpect(missing.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// snapshotResourceFiles\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"snapshotResourceFiles\", () => {\n\tit(\"登记资源后快照列出文件及哈希，生成 baseVersion 底座\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t// 造一个真实技能目录\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"code-review\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\t\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\t\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\n\t\tregisterResource(store, { kind: \"skill\", name: \"code-review\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:code-review\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(2);\n\t\texpect(snap.files.map((f) => f.path).sort()).toEqual([\"SKILL.md\", \"examples/a.md\"].sort());\n\t\texpect(snap.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 版本底座已写库\n\t\tconst row = store.db\n\t\t\t.prepare(\"SELECT effective_version FROM evolution_resources WHERE resource_id = ?\")\n\t\t\t.get(\"skill:code-review\") as { effective_version: string };\n\t\texpect(row.effective_version).toBe(snap.versionId);\n\t\tstore.close();\n\t});\n\n\tit(\"资源目录不存在时返回空清单（不伪造文件）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"ghost\", paoHome: home });\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home, createdAt: AT });\n\t\texpect(snap.ok).toBe(true);\n\t\tif (!snap.ok) return;\n\t\texpect(snap.files.length).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"未登记资源快照返回拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst snap = snapshotResourceFiles(store, { resourceId: \"skill:ghost\", paoHome: home });\n\t\texpect(snap.ok).toBe(false);\n\t\tif (snap.ok) return;\n\t\texpect(snap.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E12：文件型 relative_root（template/recipe 单文件）快照不抛 ENOTDIR\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\n\t\t// template → 工作流/{name}.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"工作流\"), { recursive: true });\n\t\twriteFileSync(join(home, \"工作流\", \"复盘.md\"), \"# 复盘\\n步骤一\\n\", \"utf8\");\n\t\tconst regT = registerResource(store, { kind: \"template\", name: \"复盘\", paoHome: home });\n\t\texpect(regT.ok).toBe(true);\n\t\tconst snapT = snapshotResourceFiles(store, { resourceId: \"template:复盘\", paoHome: home, createdAt: AT });\n\t\texpect(snapT.ok).toBe(true);\n\t\tif (!snapT.ok) return;\n\t\texpect(snapT.files.length).toBe(1);\n\t\texpect(snapT.files[0].path).toBe(\"复盘.md\");\n\t\texpect(snapT.versionId).toMatch(/^v-[0-9a-f]{12}$/);\n\t\t// 快照落盘在 <home>/evolution/versions/<dirSafeResourceId>/<versionId>/<basename>。\n\t\tconst { existsSync } = require(\"node:fs\") as typeof import(\"node:fs\");\n\t\texpect(\n\t\t\texistsSync(join(home, \"evolution\", \"versions\", \"template_复盘\", snapT.versionId, \"复盘.md\")),\n\t\t).toBe(true);\n\n\t\t// recipe → 部门/{name}/配方.md（单文件相对根）。\n\t\tmkdirSync(join(home, \"部门\", \"研发部\"), { recursive: true });\n\t\twriteFileSync(join(home, \"部门\", \"研发部\", \"配方.md\"), \"# 研发部配方\\n\", \"utf8\");\n\t\tconst regR = registerResource(store, { kind: \"recipe\", name: \"研发部\", paoHome: home });\n\t\texpect(regR.ok).toBe(true);\n\t\tconst snapR = snapshotResourceFiles(store, { resourceId: \"recipe:研发部\", paoHome: home, createdAt: AT });\n\t\texpect(snapR.ok).toBe(true);\n\t\tif (!snapR.ok) return;\n\t\texpect(snapR.files.length).toBe(1);\n\t\texpect(snapR.files[0].path).toBe(\"配方.md\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 固定禁止对象清单完整性\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"固定禁止对象清单\", () => {\n\tit(\"清单包含任务书 §2 全部类别\", () => {\n\t\tconst expected = [\n\t\t\t\"src/\",\n\t\t\t\"memory/memory.sqlite\",\n\t\t\t\"src/pao/role.ts\",\n\t\t\t\"pao配置/档位.json\",\n\t\t\t\"pao配置/记忆后台预算.json\",\n\t\t\t\"src/core/resource-loader.ts\",\n\t\t\t\"plans/\",\n\t\t];\n\t\tfor (const item of expected) {\n\t\t\texpect(FORBIDDEN_EVOLUTION_TARGETS).toContain(item);\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function seedValidation is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *}\n\nfunction seedValidation_seedValidation(\n\tstore: MemoryStore,\n\tover: { validationId?: string; candidateId: string; problemId: string; resourceId: string; baseVersion: string },\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,110]}}},{"equalLines":{"line_count":169}},{"diffOp":{"equal":{"range":[110,122]}}},{"diffOp":{"delete":{"range":[122,136]}}},{"diffOp":{"insert":{"range":[136,151]}}},{"diffOp":{"equal":{"range":[151,288]}}},{"equalLines":{"line_count":356}},{"diffOp":{"equal":{"range":[288,297]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-regression.test.ts"},"span":[6418,6432],"sourceCode":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *\n * 覆盖：\n * - judgeRegression 三种 kind：original_problem（problemId 候选发布过坏版）、\n *   normal_breakage（坏版有 used 行 + 报失败任务绑坏版）、user_reported；\n * - 无关失败不乱归因（无 problemId 无 taskId、problemId 不匹配、任务绑别版）；\n * - handleRegression 完整路径：rollback 事务切回、受影响任务清单、同源未终态\n *   候选标 cancelled、通知载荷（资源/原因/当前有效版/受影响任务）；\n * - 「回退期间另一修复已生效」：指向已非坏版 → no_change 不覆盖；\n * - 无上一有效版 → 不回退，通知如实说明。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-regression.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recordUsed } from \"../../src/pao/evolution/observe.ts\";\nimport { handleRegression, judgeRegression } from \"../../src/pao/evolution/regression.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-reg-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\nconst AT5 = \"2026-11-11T10:04:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId };\n}\n\n/** 直插 problem 行（disposition='candidate' 表示已生成候选解决）。 */\nfunction seedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string; disposition?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\tover.disposition ?? \"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tskillContent?: string;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(\n\t\tjoin(candidateDir, \"SKILL.md\"),\n\t\tover.skillContent ?? `# patched\\n\\n步骤一: 输入\\n步骤三: 验证\\n`,\n\t\t\"utf8\",\n\t);\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { validationId?: string; candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(validationId, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n\treturn validationId;\n}\n\n/** 种到「新版本已激活」：resource + problem + 合法 passed 链 + publish + activate。 */\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── judgeRegression ──────────────────────────────────────────────────────\n\ndescribe(\"judgeRegression\", () => {\n\tit(\"problemId 的候选发布过坏版 → original_problem\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"同样的输出又错了\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"original_problem\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.problemId).toBe(problemId);\n\t\texpect(result.sourceIds).toContain(problemId);\n\t});\n\n\tit(\"坏版有 used 行 + 报失败任务绑坏版 → normal_breakage\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\t// 记一条成功 used（任务用过该版本）。\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r1\", outcome: \"success\" });\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"正常用法现在报错\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"normal_breakage\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"userReported=true → user_reported（无需其他证据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"用户说这版更差了\",\n\t\t\tuserReported: true,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"user_reported\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"无 problemId 无 taskId → isRegression=false 不乱归因\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"不明失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t\texpect(result.reason).toContain(\"保留调查\");\n\t});\n\n\tit(\"problemId 指向的候选没发布过坏版 → isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 另一个 problem 的候选没发布（只种 candidate 行不 publish/activate）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-other\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-other\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId: otherProblemId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"报失败任务绑的是别的版本（非坏版）→ isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 任务绑了坏版后，手动把绑定改回 baseVersion（模拟任务用的旧版）。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = 'task-1'`)\n\t\t\t.run(baseVersion);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── handleRegression ─────────────────────────────────────────────────────\n\ndescribe(\"handleRegression\", () => {\n\tit(\"完整路径：rollback 事务 + 受影响任务清单 + 同源候选标 cancelled + 通知载荷\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 两个任务绑坏版。\n\t\tbindTaskResources(store, { taskId: \"task-a\", resourceIds: [resourceId] });\n\t\tbindTaskResources(store, { taskId: \"task-b\", resourceIds: [resourceId] });\n\t\t// 同源未终态候选（与坏版同 base_version 的 proposed 候选）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-stale\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-stale\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tstatus: \"proposed\",\n\t\t});\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"原问题复现\",\n\t\t\tpaoHome: home,\n\t\t\trollbackAt: AT5,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(true);\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.previousVersion).toBe(baseVersion);\n\n\t\t// 指向切回 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// 受影响任务清单（待切换）。\n\t\texpect(result.affectedTasks.length).toBe(2);\n\t\texpect(result.affectedTasks.map((t) => t.taskId).sort()).toEqual([\"task-a\", \"task-b\"]);\n\t\texpect(result.affectedTasks[0]!.targetVersion).toBe(baseVersion);\n\n\t\t// 通知载荷。\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.resourceId).toBe(resourceId);\n\t\texpect(result.notification!.badVersion).toBe(newVersionId);\n\t\texpect(result.notification!.currentVersion).toBe(baseVersion);\n\t\texpect(result.notification!.affectedTaskIds.sort()).toEqual([\"task-a\", \"task-b\"]);\n\n\t\t// 同源未终态候选标 cancelled。\n\t\tconst staleCand = store.db\n\t\t\t.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = 'cand-stale'`)\n\t\t\t.get() as { status: string; failure_reason: string };\n\t\texpect(staleCand.status).toBe(\"cancelled\");\n\t\texpect(staleCand.failure_reason).toContain(\"已停用\");\n\n\t\t// 坏版 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish' AND reason LIKE '停用:%'`,\n\t\t\t)\n\t\t\t.get(resourceId, newVersionId) as { reason: string } | undefined;\n\t\texpect(pubRow).toBeDefined();\n\t});\n\n\tit(\"回退期间另一修复已生效（指向已非坏版）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 另一路径把 effective_version 改成第三个版本。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tversionId: newVersionId, // 显式指定坏版（因当前指向已变）\n\t\t\tfailureDescription: \"退步判定\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.currentVersion).toBe(otherVersion);\n\t\texpect(result.notification!.reason).toContain(\"另一修复已生效\");\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t});\n\n\tit(\"无上一有效版（坏版是首个生效版且无前版）→ 不回退，通知如实说明\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 种资源但不走 snapshot（effective_version 为 NULL 起步）；\n\t\t// 手动插一条 effective 凭据到坏版，模拟「首个激活版本即坏版」。\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"lonely-skill\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"lonely-skill\", paoHome: home });\n\t\tconst resourceId = \"skill:lonely-skill\";\n\n\t\t// 直接设 effective_version + 一条 effective 凭据（不走快照，模拟无前版场景）。\n\t\tconst badVersion = \"v-firstbad0123\";\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst badDir = join(evolutionPaths(home).versions, dirSafe, badVersion);\n\t\tmkdirSync(badDir, { recursive: true });\n\t\twriteFileSync(join(badDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(badVersion, AT2, resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-first\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbadVersion,\n\t\t\t\t\"首次生效\",\n\t\t\t\tJSON.stringify({ activation: \"effective\", candidateId: \"cand-x\" }),\n\t\t\t\tAT2,\n\t\t\t);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tuserReported: true,\n\t\t\tfailureDescription: \"首个版本就退步\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.reason).toContain(\"找不到上一有效版\");\n\t\texpect(result.notification!.currentVersion).toBe(badVersion);\n\t\t// 指向未改。\n\t\texpect(readEffective(store, resourceId)).toBe(badVersion);\n\t});\n\n\tit(\"judge 为 false → 直接返回 rolledBack=false 不动指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.affectedTasks).toEqual([]);\n\t\texpect(result.notification).toBeUndefined();\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function seedCandidate is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"seedCandidate"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seedCandidate"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *}\n\nfunction seedCandidate_seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\treturn row.effective_version;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":108}},{"diffOp":{"equal":{"range":[73,85]}}},{"diffOp":{"delete":{"range":[85,98]}}},{"diffOp":{"insert":{"range":[98,112]}}},{"diffOp":{"equal":{"range":[112,149]}}},{"equalLines":{"line_count":236}},{"diffOp":{"equal":{"range":[149,182]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-restart.test.ts"},"span":[4384,4397],"sourceCode":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\n * 覆盖：\n * - 正常态：effective_version 指向目录完整 → dirOk=true，无 needsAttention；\n * - 发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单（不自动激活）；\n * - 生效指向目录缺失 → needsAttention(effective_dir_missing)，保留旧指向不主动改；\n * - 绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)，不改绑定；\n * - 生效指向完整但无 effective 凭据 → needsAttention(version_without_credential)；\n * - 多资源混合场景。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-restart.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-rec-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`val-${over.candidateId}`, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { problemId: `prob-${name}`, resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, {\n\t\tcandidateId: `cand-${name}`,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# patched cand-${name}\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId, skillDir };\n}\n\n// ── recoverEvolutionState ────────────────────────────────────────────────\n\ndescribe(\"recoverEvolutionState\", () => {\n\tit(\"正常态：指向目录完整 → dirOk=true 无 needsAttention\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(1);\n\t\texpect(result.resources[0]!.resourceId).toBe(resourceId);\n\t\texpect(result.resources[0]!.effectiveVersion).toBe(newVersionId);\n\t\texpect(result.resources[0]!.dirOk).toBe(true);\n\t\texpect(result.resources[0]!.pendingPublish).toEqual([]);\n\t\texpect(result.resources[0]!.staleBindings).toEqual([]);\n\t\texpect(result.unfinishedActivations).toEqual([]);\n\t\texpect(result.needsAttention).toEqual([]);\n\t});\n\n\tit(\"发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 只 publish 不 activate → 发布中断状态。\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candidateId);\n\t\texpect(result.unfinishedActivations[0]!.versionId).toBe(pub.versionId);\n\t\texpect(result.unfinishedActivations[0]!.dirComplete).toBe(true);\n\n\t\t// 该资源视图也含 pendingPublish。\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.pendingPublish.length).toBe(1);\n\t\texpect(view!.pendingPublish[0]!.candidateId).toBe(candidateId);\n\t});\n\n\tit(\"生效指向目录缺失 → needsAttention(effective_dir_missing) 保留指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\t// 删版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(false);\n\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find(\n\t\t\t(a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\",\n\t\t);\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\n\n\t\t// 指向未被改动。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(row.effective_version).toBe(newVersionId);\n\t});\n\n\tit(\"绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\t// 删绑定的版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.staleBindings.length).toBe(1);\n\t\texpect(view!.staleBindings[0]!.taskId).toBe(\"task-1\");\n\t\texpect(view!.staleBindings[0]!.versionId).toBe(newVersionId);\n\t\texpect(view!.staleBindings[0]!.reason).toContain(\"不存在\");\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"stale_binding\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"task-1\");\n\t});\n\n\tit(\"生效指向目录完整但无 effective 凭据 → version_without_credential\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\t// baseVersion 是快照版：目录完整但无 activation 凭据；\n\t\t// effective_version 指它 → 触发「指向完整但无 effective 凭据」异常。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(true);\n\t\texpect(view!.missingCredential).toBe(true);\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"version_without_credential\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"无 activation='effective' 凭据\");\n\t});\n\n\tit(\"多资源混合：一正常 + 一发布中断 + 一生效目录缺失\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, { candidateId: \"cand-b\", problemId: probB, resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\n\t\t// 生效目录缺失资源（先激活再删目录）。\n\t\tconst c = await seedActivated(home, store, \"skill-c\");\n\t\tconst dirSafeC = c.resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafeC, c.newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(3);\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candB.candidateId);\n\t\tconst missing = result.needsAttention.filter((a) => a.kind === \"effective_dir_missing\");\n\t\texpect(missing.length).toBe(1);\n\t\texpect(missing[0]!.resourceId).toBe(c.resourceId);\n\t});\n});\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function seedValidation is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seedValidation"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *}\n\nfunction seedValidation_seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\treturn row.effective_version;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":148}},{"diffOp":{"equal":{"range":[73,85]}}},{"diffOp":{"delete":{"range":[85,99]}}},{"diffOp":{"insert":{"range":[99,114]}}},{"diffOp":{"equal":{"range":[114,228]}}},{"equalLines":{"line_count":196}},{"diffOp":{"equal":{"range":[228,261]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-restart.test.ts"},"span":[5698,5712],"sourceCode":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\n * 覆盖：\n * - 正常态：effective_version 指向目录完整 → dirOk=true，无 needsAttention；\n * - 发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单（不自动激活）；\n * - 生效指向目录缺失 → needsAttention(effective_dir_missing)，保留旧指向不主动改；\n * - 绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)，不改绑定；\n * - 生效指向完整但无 effective 凭据 → needsAttention(version_without_credential)；\n * - 多资源混合场景。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-restart.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-rec-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`val-${over.candidateId}`, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { problemId: `prob-${name}`, resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, {\n\t\tcandidateId: `cand-${name}`,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# patched cand-${name}\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId, skillDir };\n}\n\n// ── recoverEvolutionState ────────────────────────────────────────────────\n\ndescribe(\"recoverEvolutionState\", () => {\n\tit(\"正常态：指向目录完整 → dirOk=true 无 needsAttention\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(1);\n\t\texpect(result.resources[0]!.resourceId).toBe(resourceId);\n\t\texpect(result.resources[0]!.effectiveVersion).toBe(newVersionId);\n\t\texpect(result.resources[0]!.dirOk).toBe(true);\n\t\texpect(result.resources[0]!.pendingPublish).toEqual([]);\n\t\texpect(result.resources[0]!.staleBindings).toEqual([]);\n\t\texpect(result.unfinishedActivations).toEqual([]);\n\t\texpect(result.needsAttention).toEqual([]);\n\t});\n\n\tit(\"发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 只 publish 不 activate → 发布中断状态。\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candidateId);\n\t\texpect(result.unfinishedActivations[0]!.versionId).toBe(pub.versionId);\n\t\texpect(result.unfinishedActivations[0]!.dirComplete).toBe(true);\n\n\t\t// 该资源视图也含 pendingPublish。\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.pendingPublish.length).toBe(1);\n\t\texpect(view!.pendingPublish[0]!.candidateId).toBe(candidateId);\n\t});\n\n\tit(\"生效指向目录缺失 → needsAttention(effective_dir_missing) 保留指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\t// 删版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(false);\n\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find(\n\t\t\t(a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\",\n\t\t);\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\n\n\t\t// 指向未被改动。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(row.effective_version).toBe(newVersionId);\n\t});\n\n\tit(\"绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\t// 删绑定的版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.staleBindings.length).toBe(1);\n\t\texpect(view!.staleBindings[0]!.taskId).toBe(\"task-1\");\n\t\texpect(view!.staleBindings[0]!.versionId).toBe(newVersionId);\n\t\texpect(view!.staleBindings[0]!.reason).toContain(\"不存在\");\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"stale_binding\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"task-1\");\n\t});\n\n\tit(\"生效指向目录完整但无 effective 凭据 → version_without_credential\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\t// baseVersion 是快照版：目录完整但无 activation 凭据；\n\t\t// effective_version 指它 → 触发「指向完整但无 effective 凭据」异常。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(true);\n\t\texpect(view!.missingCredential).toBe(true);\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"version_without_credential\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"无 activation='effective' 凭据\");\n\t});\n\n\tit(\"多资源混合：一正常 + 一发布中断 + 一生效目录缺失\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, { candidateId: \"cand-b\", problemId: probB, resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\n\t\t// 生效目录缺失资源（先激活再删目录）。\n\t\tconst c = await seedActivated(home, store, \"skill-c\");\n\t\tconst dirSafeC = c.resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafeC, c.newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(3);\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candB.candidateId);\n\t\tconst missing = result.needsAttention.filter((a) => a.kind === \"effective_dir_missing\");\n\t\texpect(missing.length).toBe(1);\n\t\texpect(missing[0]!.resourceId).toBe(c.resourceId);\n\t});\n});\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable a is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"a"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"a"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a_a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\treturn row.effective_version;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":319}},{"diffOp":{"equal":{"range":[73,135]}}},{"diffOp":{"delete":{"range":[135,136]}}},{"diffOp":{"insert":{"range":[136,138]}}},{"diffOp":{"equal":{"range":[138,139]}}},{"diffOp":{"equal":{"range":[139,259]}}},{"equalLines":{"line_count":25}},{"diffOp":{"equal":{"range":[259,292]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-restart.test.ts"},"span":[13505,13506],"sourceCode":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\n * 覆盖：\n * - 正常态：effective_version 指向目录完整 → dirOk=true，无 needsAttention；\n * - 发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单（不自动激活）；\n * - 生效指向目录缺失 → needsAttention(effective_dir_missing)，保留旧指向不主动改；\n * - 绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)，不改绑定；\n * - 生效指向完整但无 effective 凭据 → needsAttention(version_without_credential)；\n * - 多资源混合场景。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-restart.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-rec-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`val-${over.candidateId}`, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { problemId: `prob-${name}`, resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, {\n\t\tcandidateId: `cand-${name}`,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# patched cand-${name}\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId, skillDir };\n}\n\n// ── recoverEvolutionState ────────────────────────────────────────────────\n\ndescribe(\"recoverEvolutionState\", () => {\n\tit(\"正常态：指向目录完整 → dirOk=true 无 needsAttention\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(1);\n\t\texpect(result.resources[0]!.resourceId).toBe(resourceId);\n\t\texpect(result.resources[0]!.effectiveVersion).toBe(newVersionId);\n\t\texpect(result.resources[0]!.dirOk).toBe(true);\n\t\texpect(result.resources[0]!.pendingPublish).toEqual([]);\n\t\texpect(result.resources[0]!.staleBindings).toEqual([]);\n\t\texpect(result.unfinishedActivations).toEqual([]);\n\t\texpect(result.needsAttention).toEqual([]);\n\t});\n\n\tit(\"发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 只 publish 不 activate → 发布中断状态。\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candidateId);\n\t\texpect(result.unfinishedActivations[0]!.versionId).toBe(pub.versionId);\n\t\texpect(result.unfinishedActivations[0]!.dirComplete).toBe(true);\n\n\t\t// 该资源视图也含 pendingPublish。\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.pendingPublish.length).toBe(1);\n\t\texpect(view!.pendingPublish[0]!.candidateId).toBe(candidateId);\n\t});\n\n\tit(\"生效指向目录缺失 → needsAttention(effective_dir_missing) 保留指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\t// 删版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(false);\n\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find(\n\t\t\t(a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\",\n\t\t);\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\n\n\t\t// 指向未被改动。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(row.effective_version).toBe(newVersionId);\n\t});\n\n\tit(\"绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\t// 删绑定的版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.staleBindings.length).toBe(1);\n\t\texpect(view!.staleBindings[0]!.taskId).toBe(\"task-1\");\n\t\texpect(view!.staleBindings[0]!.versionId).toBe(newVersionId);\n\t\texpect(view!.staleBindings[0]!.reason).toContain(\"不存在\");\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"stale_binding\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"task-1\");\n\t});\n\n\tit(\"生效指向目录完整但无 effective 凭据 → version_without_credential\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\t// baseVersion 是快照版：目录完整但无 activation 凭据；\n\t\t// effective_version 指它 → 触发「指向完整但无 effective 凭据」异常。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(true);\n\t\texpect(view!.missingCredential).toBe(true);\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"version_without_credential\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"无 activation='effective' 凭据\");\n\t});\n\n\tit(\"多资源混合：一正常 + 一发布中断 + 一生效目录缺失\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, { candidateId: \"cand-b\", problemId: probB, resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\n\t\t// 生效目录缺失资源（先激活再删目录）。\n\t\tconst c = await seedActivated(home, store, \"skill-c\");\n\t\tconst dirSafeC = c.resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafeC, c.newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(3);\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candB.candidateId);\n\t\tconst missing = result.needsAttention.filter((a) => a.kind === \"effective_dir_missing\");\n\t\texpect(missing.length).toBe(1);\n\t\texpect(missing[0]!.resourceId).toBe(c.resourceId);\n\t});\n});\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *import { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getResource } from \"../../src/pao/evolution/resources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":22}},{"diffOp":{"equal":{"range":[70,317]}}},{"diffOp":{"delete":{"range":[317,385]}}},{"diffOp":{"equal":{"range":[385,450]}}},{"equalLines":{"line_count":754}},{"diffOp":{"equal":{"range":[450,459]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-validation.test.ts"},"span":[1477,1492],"sourceCode":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\n * 覆盖：\n * - 冻结计划三组样例且 testPlanId 绑定 baseVersion；\n * - 验收依据不入候选可写目录；\n * - 旧版须真失败否则回分类（reproduction 至少一条）；\n * - 候选只改批准资源（范围核对）；\n * - 无改进返回 no_change；\n * - 相同差异不重复验证；\n * - 保留组失败结束且不回灌（生成器读不到 holdout）；\n * - 模型调用沿账本记账；\n * - 范围越界候选被拒。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-validation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getResource } from \"../../src/pao/evolution/resources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-val-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\n/** 外发许可（测试注入）：proposeCandidate 的外发门要求编排显式传项目名与许可。 */\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\t// 预算配置：checkMemoryJobBudget 需要此文件存在才允许付费作业。\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\t// 总预算账：checkMemoryJobBudget 检查 reserveBudget 需要已授权的总预算。\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类的 problem。 */\nfunction seedProblem(store: ReturnType<typeof openMemoryStore>, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tconst now = AT;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tnow,\n\t\t\tnow,\n\t\t);\n\treturn problemId;\n}\n\n// ── freezeValidationPlan ────────────────────────────────────────────────\n\ndescribe(\"freezeValidationPlan\", () => {\n\tit(\"冻结计划三组样例且 testPlanId 绑定 baseVersion\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t}],\n\t\t\tnormal: [{\n\t\t\t\tinput: \"正常输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 B\",\n\t\t\t}],\n\t\t\tholdout: [{\n\t\t\t\tinput: \"保留输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 C\",\n\t\t\t}],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.testPlanId).toContain(baseVersion);\n\t\texpect(result.plan.reproduction).toHaveLength(1);\n\t\texpect(result.plan.normal).toHaveLength(1);\n\t\texpect(result.plan.holdout).toHaveLength(1);\n\t\texpect(result.plan.reproduction[0].caseId).toBe(\"reproduction-0\");\n\t\texpect(result.plan.holdout[0].caseId).toBe(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"验收依据存核心管理位置，不在候选可写目录\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\tacceptance: \"x\",\n\t\t\t}],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// plan.json 在 evolution/validations/ 下，不在 candidates/ 下。\n\t\texpect(result.planPath).toContain(\"validations\");\n\t\texpect(result.planPath).not.toContain(\"candidates\");\n\t\t// 文件实际存在。\n\t\tconst planOnDisk = JSON.parse(\n\t\t\trequire(\"node:fs\").readFileSync(result.planPath, \"utf8\"),\n\t\t);\n\t\texpect(planOnDisk.testPlanId).toBe(result.testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 组至少一条；空则拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"复现样例至少一条\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"resourceId 与 problem 登记不一致时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, baseVersion } = seedSkill(home);\n\t\t// 登记另一资源供 problem 绑定（外键要求 resourceId 已登记）。\n\t\tregisterResource(store, { kind: \"skill\", name: \"other\", paoHome: home });\n\t\tconst problemId = seedProblem(store, { resourceId: \"skill:other\", baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ── proposeCandidate ────────────────────────────────────────────────────\n\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan(store: ReturnType<typeof openMemoryStore>, over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t}) {\n\t\treturn freezeValidationPlan(store, {\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\tpaoHome: tempHome(), // 用临时 home；实际测试时传同一 home\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t}\n\n\tit(\"模型返回空编辑列表 → no_change\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({ rationale: \"无需改动\", edits: [] });\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型返回编辑 → changed 且差异正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion, skillDir } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正步骤一\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n步骤一（已修正）\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\t\tif (result.status !== \"changed\") return;\n\t\texpect(result.diffs).toHaveLength(1);\n\t\texpect(result.diffs[0].path).toBe(\"SKILL.md\");\n\t\texpect(result.diffs[0].kind).toBe(\"edit\");\n\t\t// 候选目录已创建且文件已改。\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, \"skill_code-review\", result.candidateId);\n\t\tconst newContent = require(\"node:fs\").readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\");\n\t\texpect(newContent).toContain(\"已修正\");\n\t\t// 问题状态推进到 candidate。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(row.status).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"相同差异不重复付费验证\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\t\tif (!first.ok || first.status !== \"changed\") return;\n\n\t\t// 第二次相同差异 → duplicate。\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.status).toBe(\"duplicate\");\n\t\tif (second.status !== \"duplicate\") return;\n\t\texpect(second.candidateId).toBe(first.candidateId);\n\t\tstore.close();\n\t});\n\n\tit(\"范围越界候选被拒（改资源根外文件）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"改核心\",\n\t\t\tedits: [{ path: \"src/pao/role.ts\", action: \"edit\", content: \"hack\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\tif (result.status !== \"rejected\") return;\n\t\texpect(result.reason).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型调用沿账本记账（attempt + usage）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(ledger.calls.custom.some((c) => c.includes(\"pao-evolution-candidate-attempt\"))).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.kind === \"evolution_candidate\")).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.note.includes(`problemId=${problemId}`))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"保留组样例不喂给生成器（提示词不含 holdout）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留秘密\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst requests: Context[] = [];\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [] });\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply, (ctx) => requests.push(ctx)),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"开发样例\", failure: \"失败\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"开发样例\");\n\t\texpect(prompt).not.toContain(\"保留秘密\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(\"{}\"),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"每问题最多 3 候选\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造 3 个候选。\n\t\tfor (let i = 0; i < 3; i++) {\n\t\t\tconst reply = JSON.stringify({\n\t\t\t\trationale: `修正 ${i}`,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n修正 ${i}\\n` }],\n\t\t\t});\n\t\t\tconst r = await proposeCandidate(store, {\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\tbudgetPaoHome: home,\n\t\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\t\toutbound: OUTBOUND,\n\t\t\t}, {\n\t\t\t\tproblemId,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\t\tcreatedAt: `2026-11-11T10:0${i}:00.000Z`,\n\t\t\t});\n\t\t\texpect(r.ok && r.status === \"changed\").toBe(true);\n\t\t}\n\n\t\t// 第 4 个应被拒。\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"第 4 个\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n第 4 个\\n\" }],\n\t\t});\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"已达候选上限\");\n\t\tstore.close();\n\t});\n\n\tit(\"O01：同 problemId 第二次生成 → 两条不同判据预留，首条已结算费用不被覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst mkReply = (tag: string) =>\n\t\t\tJSON.stringify({\n\t\t\t\trationale: tag,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n${tag}\\n` }],\n\t\t\t});\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正一\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正二\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok && second.status === \"changed\").toBe(true);\n\n\t\t// 账本：两次实际请求各一条独立判据（attemptKey=本次 requestId），不再互相复用/覆盖。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst keys = file.reservations.map((r) => r.idempotencyKey);\n\t\tconst evo = file.reservations.filter((r) => r.idempotencyKey.startsWith(`memory-job:evo-${problemId}:candidate:`));\n\t\t// 假模型 usage 无 cost → settle 记 unknown；两条都各自留痕（首条不被第二条覆盖）。\n\t\texpect(evo).toHaveLength(2);\n\t\texpect(evo.every((r) => r.status === \"unknown\")).toBe(true);\n\t\texpect(new Set(keys).size).toBe(keys.length);\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This function seedValidationPlan is unused.","message":[{"elements":[],"content":"This function "},{"elements":["Emphasis"],"content":"seedValidationPlan"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seedValidationPlan"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan_seedValidationPlan(store: ReturnType<typeof openMemoryStore>, over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":302}},{"diffOp":{"equal":{"range":[70,118]}}},{"diffOp":{"delete":{"range":[118,136]}}},{"diffOp":{"insert":{"range":[136,155]}}},{"diffOp":{"equal":{"range":[155,249]}}},{"equalLines":{"line_count":475}},{"diffOp":{"equal":{"range":[249,258]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-validation.test.ts"},"span":[10751,10769],"sourceCode":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\n * 覆盖：\n * - 冻结计划三组样例且 testPlanId 绑定 baseVersion；\n * - 验收依据不入候选可写目录；\n * - 旧版须真失败否则回分类（reproduction 至少一条）；\n * - 候选只改批准资源（范围核对）；\n * - 无改进返回 no_change；\n * - 相同差异不重复验证；\n * - 保留组失败结束且不回灌（生成器读不到 holdout）；\n * - 模型调用沿账本记账；\n * - 范围越界候选被拒。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-validation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getResource } from \"../../src/pao/evolution/resources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-val-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\n/** 外发许可（测试注入）：proposeCandidate 的外发门要求编排显式传项目名与许可。 */\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\t// 预算配置：checkMemoryJobBudget 需要此文件存在才允许付费作业。\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\t// 总预算账：checkMemoryJobBudget 检查 reserveBudget 需要已授权的总预算。\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类的 problem。 */\nfunction seedProblem(store: ReturnType<typeof openMemoryStore>, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tconst now = AT;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tnow,\n\t\t\tnow,\n\t\t);\n\treturn problemId;\n}\n\n// ── freezeValidationPlan ────────────────────────────────────────────────\n\ndescribe(\"freezeValidationPlan\", () => {\n\tit(\"冻结计划三组样例且 testPlanId 绑定 baseVersion\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t}],\n\t\t\tnormal: [{\n\t\t\t\tinput: \"正常输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 B\",\n\t\t\t}],\n\t\t\tholdout: [{\n\t\t\t\tinput: \"保留输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 C\",\n\t\t\t}],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.testPlanId).toContain(baseVersion);\n\t\texpect(result.plan.reproduction).toHaveLength(1);\n\t\texpect(result.plan.normal).toHaveLength(1);\n\t\texpect(result.plan.holdout).toHaveLength(1);\n\t\texpect(result.plan.reproduction[0].caseId).toBe(\"reproduction-0\");\n\t\texpect(result.plan.holdout[0].caseId).toBe(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"验收依据存核心管理位置，不在候选可写目录\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\tacceptance: \"x\",\n\t\t\t}],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// plan.json 在 evolution/validations/ 下，不在 candidates/ 下。\n\t\texpect(result.planPath).toContain(\"validations\");\n\t\texpect(result.planPath).not.toContain(\"candidates\");\n\t\t// 文件实际存在。\n\t\tconst planOnDisk = JSON.parse(\n\t\t\trequire(\"node:fs\").readFileSync(result.planPath, \"utf8\"),\n\t\t);\n\t\texpect(planOnDisk.testPlanId).toBe(result.testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 组至少一条；空则拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"复现样例至少一条\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"resourceId 与 problem 登记不一致时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, baseVersion } = seedSkill(home);\n\t\t// 登记另一资源供 problem 绑定（外键要求 resourceId 已登记）。\n\t\tregisterResource(store, { kind: \"skill\", name: \"other\", paoHome: home });\n\t\tconst problemId = seedProblem(store, { resourceId: \"skill:other\", baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ── proposeCandidate ────────────────────────────────────────────────────\n\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan(store: ReturnType<typeof openMemoryStore>, over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t}) {\n\t\treturn freezeValidationPlan(store, {\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\tpaoHome: tempHome(), // 用临时 home；实际测试时传同一 home\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t}\n\n\tit(\"模型返回空编辑列表 → no_change\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({ rationale: \"无需改动\", edits: [] });\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型返回编辑 → changed 且差异正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion, skillDir } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正步骤一\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n步骤一（已修正）\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\t\tif (result.status !== \"changed\") return;\n\t\texpect(result.diffs).toHaveLength(1);\n\t\texpect(result.diffs[0].path).toBe(\"SKILL.md\");\n\t\texpect(result.diffs[0].kind).toBe(\"edit\");\n\t\t// 候选目录已创建且文件已改。\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, \"skill_code-review\", result.candidateId);\n\t\tconst newContent = require(\"node:fs\").readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\");\n\t\texpect(newContent).toContain(\"已修正\");\n\t\t// 问题状态推进到 candidate。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(row.status).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"相同差异不重复付费验证\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\t\tif (!first.ok || first.status !== \"changed\") return;\n\n\t\t// 第二次相同差异 → duplicate。\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.status).toBe(\"duplicate\");\n\t\tif (second.status !== \"duplicate\") return;\n\t\texpect(second.candidateId).toBe(first.candidateId);\n\t\tstore.close();\n\t});\n\n\tit(\"范围越界候选被拒（改资源根外文件）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"改核心\",\n\t\t\tedits: [{ path: \"src/pao/role.ts\", action: \"edit\", content: \"hack\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\tif (result.status !== \"rejected\") return;\n\t\texpect(result.reason).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型调用沿账本记账（attempt + usage）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(ledger.calls.custom.some((c) => c.includes(\"pao-evolution-candidate-attempt\"))).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.kind === \"evolution_candidate\")).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.note.includes(`problemId=${problemId}`))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"保留组样例不喂给生成器（提示词不含 holdout）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留秘密\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst requests: Context[] = [];\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [] });\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply, (ctx) => requests.push(ctx)),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"开发样例\", failure: \"失败\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"开发样例\");\n\t\texpect(prompt).not.toContain(\"保留秘密\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(\"{}\"),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"每问题最多 3 候选\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造 3 个候选。\n\t\tfor (let i = 0; i < 3; i++) {\n\t\t\tconst reply = JSON.stringify({\n\t\t\t\trationale: `修正 ${i}`,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n修正 ${i}\\n` }],\n\t\t\t});\n\t\t\tconst r = await proposeCandidate(store, {\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\tbudgetPaoHome: home,\n\t\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\t\toutbound: OUTBOUND,\n\t\t\t}, {\n\t\t\t\tproblemId,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\t\tcreatedAt: `2026-11-11T10:0${i}:00.000Z`,\n\t\t\t});\n\t\t\texpect(r.ok && r.status === \"changed\").toBe(true);\n\t\t}\n\n\t\t// 第 4 个应被拒。\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"第 4 个\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n第 4 个\\n\" }],\n\t\t});\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"已达候选上限\");\n\t\tstore.close();\n\t});\n\n\tit(\"O01：同 problemId 第二次生成 → 两条不同判据预留，首条已结算费用不被覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst mkReply = (tag: string) =>\n\t\t\tJSON.stringify({\n\t\t\t\trationale: tag,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n${tag}\\n` }],\n\t\t\t});\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正一\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正二\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok && second.status === \"changed\").toBe(true);\n\n\t\t// 账本：两次实际请求各一条独立判据（attemptKey=本次 requestId），不再互相复用/覆盖。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst keys = file.reservations.map((r) => r.idempotencyKey);\n\t\tconst evo = file.reservations.filter((r) => r.idempotencyKey.startsWith(`memory-job:evo-${problemId}:candidate:`));\n\t\t// 假模型 usage 无 cost → settle 记 unknown；两条都各自留痕（首条不被第二条覆盖）。\n\t\texpect(evo).toHaveLength(2);\n\t\texpect(evo.every((r) => r.status === \"unknown\")).toBe(true);\n\t\texpect(new Set(keys).size).toBe(keys.length);\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable skillDir is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"skillDir"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-validation.test.ts"},"span":[12569,12577],"sourceCode":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\n * 覆盖：\n * - 冻结计划三组样例且 testPlanId 绑定 baseVersion；\n * - 验收依据不入候选可写目录；\n * - 旧版须真失败否则回分类（reproduction 至少一条）；\n * - 候选只改批准资源（范围核对）；\n * - 无改进返回 no_change；\n * - 相同差异不重复验证；\n * - 保留组失败结束且不回灌（生成器读不到 holdout）；\n * - 模型调用沿账本记账；\n * - 范围越界候选被拒。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-validation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getResource } from \"../../src/pao/evolution/resources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-val-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\n/** 外发许可（测试注入）：proposeCandidate 的外发门要求编排显式传项目名与许可。 */\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\t// 预算配置：checkMemoryJobBudget 需要此文件存在才允许付费作业。\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\t// 总预算账：checkMemoryJobBudget 检查 reserveBudget 需要已授权的总预算。\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类的 problem。 */\nfunction seedProblem(store: ReturnType<typeof openMemoryStore>, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tconst now = AT;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tnow,\n\t\t\tnow,\n\t\t);\n\treturn problemId;\n}\n\n// ── freezeValidationPlan ────────────────────────────────────────────────\n\ndescribe(\"freezeValidationPlan\", () => {\n\tit(\"冻结计划三组样例且 testPlanId 绑定 baseVersion\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t}],\n\t\t\tnormal: [{\n\t\t\t\tinput: \"正常输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 B\",\n\t\t\t}],\n\t\t\tholdout: [{\n\t\t\t\tinput: \"保留输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 C\",\n\t\t\t}],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.testPlanId).toContain(baseVersion);\n\t\texpect(result.plan.reproduction).toHaveLength(1);\n\t\texpect(result.plan.normal).toHaveLength(1);\n\t\texpect(result.plan.holdout).toHaveLength(1);\n\t\texpect(result.plan.reproduction[0].caseId).toBe(\"reproduction-0\");\n\t\texpect(result.plan.holdout[0].caseId).toBe(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"验收依据存核心管理位置，不在候选可写目录\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\tacceptance: \"x\",\n\t\t\t}],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// plan.json 在 evolution/validations/ 下，不在 candidates/ 下。\n\t\texpect(result.planPath).toContain(\"validations\");\n\t\texpect(result.planPath).not.toContain(\"candidates\");\n\t\t// 文件实际存在。\n\t\tconst planOnDisk = JSON.parse(\n\t\t\trequire(\"node:fs\").readFileSync(result.planPath, \"utf8\"),\n\t\t);\n\t\texpect(planOnDisk.testPlanId).toBe(result.testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 组至少一条；空则拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"复现样例至少一条\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"resourceId 与 problem 登记不一致时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, baseVersion } = seedSkill(home);\n\t\t// 登记另一资源供 problem 绑定（外键要求 resourceId 已登记）。\n\t\tregisterResource(store, { kind: \"skill\", name: \"other\", paoHome: home });\n\t\tconst problemId = seedProblem(store, { resourceId: \"skill:other\", baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ── proposeCandidate ────────────────────────────────────────────────────\n\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan(store: ReturnType<typeof openMemoryStore>, over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t}) {\n\t\treturn freezeValidationPlan(store, {\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\tpaoHome: tempHome(), // 用临时 home；实际测试时传同一 home\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t}\n\n\tit(\"模型返回空编辑列表 → no_change\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({ rationale: \"无需改动\", edits: [] });\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型返回编辑 → changed 且差异正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion, skillDir } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正步骤一\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n步骤一（已修正）\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\t\tif (result.status !== \"changed\") return;\n\t\texpect(result.diffs).toHaveLength(1);\n\t\texpect(result.diffs[0].path).toBe(\"SKILL.md\");\n\t\texpect(result.diffs[0].kind).toBe(\"edit\");\n\t\t// 候选目录已创建且文件已改。\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, \"skill_code-review\", result.candidateId);\n\t\tconst newContent = require(\"node:fs\").readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\");\n\t\texpect(newContent).toContain(\"已修正\");\n\t\t// 问题状态推进到 candidate。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(row.status).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"相同差异不重复付费验证\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\t\tif (!first.ok || first.status !== \"changed\") return;\n\n\t\t// 第二次相同差异 → duplicate。\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.status).toBe(\"duplicate\");\n\t\tif (second.status !== \"duplicate\") return;\n\t\texpect(second.candidateId).toBe(first.candidateId);\n\t\tstore.close();\n\t});\n\n\tit(\"范围越界候选被拒（改资源根外文件）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"改核心\",\n\t\t\tedits: [{ path: \"src/pao/role.ts\", action: \"edit\", content: \"hack\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\tif (result.status !== \"rejected\") return;\n\t\texpect(result.reason).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型调用沿账本记账（attempt + usage）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(ledger.calls.custom.some((c) => c.includes(\"pao-evolution-candidate-attempt\"))).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.kind === \"evolution_candidate\")).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.note.includes(`problemId=${problemId}`))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"保留组样例不喂给生成器（提示词不含 holdout）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留秘密\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst requests: Context[] = [];\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [] });\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply, (ctx) => requests.push(ctx)),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"开发样例\", failure: \"失败\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"开发样例\");\n\t\texpect(prompt).not.toContain(\"保留秘密\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(\"{}\"),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"每问题最多 3 候选\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造 3 个候选。\n\t\tfor (let i = 0; i < 3; i++) {\n\t\t\tconst reply = JSON.stringify({\n\t\t\t\trationale: `修正 ${i}`,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n修正 ${i}\\n` }],\n\t\t\t});\n\t\t\tconst r = await proposeCandidate(store, {\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\tbudgetPaoHome: home,\n\t\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\t\toutbound: OUTBOUND,\n\t\t\t}, {\n\t\t\t\tproblemId,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\t\tcreatedAt: `2026-11-11T10:0${i}:00.000Z`,\n\t\t\t});\n\t\t\texpect(r.ok && r.status === \"changed\").toBe(true);\n\t\t}\n\n\t\t// 第 4 个应被拒。\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"第 4 个\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n第 4 个\\n\" }],\n\t\t});\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"已达候选上限\");\n\t\tstore.close();\n\t});\n\n\tit(\"O01：同 problemId 第二次生成 → 两条不同判据预留，首条已结算费用不被覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst mkReply = (tag: string) =>\n\t\t\tJSON.stringify({\n\t\t\t\trationale: tag,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n${tag}\\n` }],\n\t\t\t});\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正一\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正二\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok && second.status === \"changed\").toBe(true);\n\n\t\t// 账本：两次实际请求各一条独立判据（attemptKey=本次 requestId），不再互相复用/覆盖。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst keys = file.reservations.map((r) => r.idempotencyKey);\n\t\tconst evo = file.reservations.filter((r) => r.idempotencyKey.startsWith(`memory-job:evo-${problemId}:candidate:`));\n\t\t// 假模型 usage 无 cost → settle 记 unknown；两条都各自留痕（首条不被第二条覆盖）。\n\t\texpect(evo).toHaveLength(2);\n\t\texpect(evo.every((r) => r.status === \"unknown\")).toBe(true);\n\t\texpect(new Set(keys).size).toBe(keys.length);\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"lint/style/useImportType","severity":"warning","description":"Some named imports are only used as types.","message":[{"elements":[],"content":"Some named imports are only used as types."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"This import is only used as a type."}]]},{"frame":{"path":null,"span":[563,572],"sourceCode":"/**\n * S6-01—05 定向测试：成果登记、确切版本回读与使用归因。\n *\n * 覆盖：一次调用产生两份成果共享 usageRef、登记重放不重复版本/引用、\n * 迟到用量只补引用、人工登记无工具调用时来源为人工、Git 两版本各读各的、\n * 分支名不能代替 commit、临时源删除后仍读受管副本、受管查重复用 versionId。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifacts.test.ts --maxWorkers=2\n */\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { existsSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryService } from \"../../src/pao/memory/types.ts\";\n\n/** O14 探针状态：统计「写事务执行期间」的 git 子进程调用。 */\nconst probe = vi.hoisted(() => ({\n\tgitSpawnsInTx: [] as string[][],\n\tgitSpawnsTotal: 0,\n\tinTx: false,\n\tactive: false,\n}));\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawnSync: (...args: Parameters<typeof spawnSync>) => {\n\t\t\tif (probe.active && args[0] === \"git\") {\n\t\t\t\tprobe.gitSpawnsTotal += 1;\n\t\t\t\tif (probe.inTx) probe.gitSpawnsInTx.push(args[1] as string[]);\n\t\t\t}\n\t\t\treturn (actual.spawnSync as typeof spawnSync)(...args);\n\t\t},\n\t};\n});\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-10T10:00:00.000Z\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite 句柄释放可能比 close 晚几毫秒（Windows）。\n\t\t}\n\t}\n});\n\nfunction openBoth(home: string): { svc: MemoryService; store: ReturnType<typeof openMemoryStore> } {\n\treturn { svc: openMemoryService({ paoHome: home, mode: \"readwrite\" }), store: openMemoryStore(home, \"readwrite\") };\n}\n\nfunction source(home: string, sessionId: string, entryId: string): string {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\treturn registerSource(store.db, { sessionId, entryId, eventType: \"user\", capturedAt: AT });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\ndescribe(\"registerArtifact / resolveArtifactVersion\", () => {\n\tit(\"一次调用产生两份成果共享同一 usageRef，不重复计费\", async () => {\n\t\tconst home = tempDir(\"pao-art-shared-usage-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"a.txt\"), \"交付文件甲\");\n\t\t\twriteFileSync(join(dir, \"b.txt\"), \"交付文件乙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"一次调用两份交付\",\n\t\t\t\tpurpose: \"验证共享用量\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [\n\t\t\t\t\t{ name: \"a.txt\", path: join(dir, \"a.txt\") },\n\t\t\t\t\t{ name: \"b.txt\", path: join(dir, \"b.txt\") },\n\t\t\t\t],\n\t\t\t\toriginTaskId: \"task-1\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tsourceToolName: \"bash\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions).toHaveLength(2);\n\t\t\t// 两份版本共享同一 usageRef\n\t\t\texpect(registered.versions[0]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\texpect(registered.versions[1]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\t// 各是一个版本行，不合并成一份\n\t\t\texpect(registered.versions[0]!.versionId).not.toBe(registered.versions[1]!.versionId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"同一 registrationKey 重放复用版本，不产生重复版本或重复 usageRef\", async () => {\n\t\tconst home = tempDir(\"pao-art-replay-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"out.txt\"), \"重放内容\");\n\n\t\t\tconst input = {\n\t\t\t\tname: \"重放成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"out.txt\", path: join(dir, \"out.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tregistrationKey: \"task-1:call-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t};\n\t\t\tconst first = await svc.registerArtifact(input);\n\t\t\texpect(first.ok && first.replayed).toBe(false);\n\t\t\tif (!first.ok) return;\n\n\t\t\t// 重放：迟到用量只补引用，版本行不新增。\n\t\t\tconst second = await svc.registerArtifact({ ...input, usageRefs: [\"req-1\", \"req-late\"] });\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.replayed).toBe(true);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.versions).toHaveLength(1);\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-late\"]);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"人工登记无工具调用时来源明确为人工（无 sourceToolCallId），不伪造调用\", async () => {\n\t\tconst home = tempDir(\"pao-art-manual-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-human\", \"e-human\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"hand.txt\"), \"人工登记内容\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"人工登记成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"hand.txt\", path: join(dir, \"hand.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceSessionId: \"sess-human\",\n\t\t\t\tsourceEntryId: \"e-human\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions[0]!.sourceToolCallId).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceToolName).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceSessionId).toBe(\"sess-human\");\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"未提交文件写受管副本；删除原临时源后仍读到相同内容\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-tmp-\");\n\t\t\tconst original = join(dir, \"scratch.txt\");\n\t\t\twriteFileSync(original, \"临时文件内容甲乙丙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"临时文件成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"scratch.txt\", path: original }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst version = registered.versions[0]!;\n\t\t\texpect(version.location.kind).toBe(\"managed\");\n\n\t\t\t// 原临时文件删除后，受管副本仍可读回相同字节。\n\t\t\trmSync(original);\n\t\t\texpect(existsSync(original)).toBe(false);\n\t\t\tconst resolved = await svc.resolveArtifactVersion({ versionId: version.versionId });\n\t\t\texpect(resolved.ok && resolved.available).toBe(true);\n\t\t\tif (resolved.ok && resolved.available) {\n\t\t\t\texpect(resolved.content.toString(\"utf8\")).toBe(\"临时文件内容甲乙丙\");\n\t\t\t}\n\t\t\tconst loc = version.location;\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\texpect(loc.dir.startsWith(memoryPaths(home).artifacts)).toBe(true);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"受管查重：相同内容再次登记复用 versionId，不重复保存\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dirA = tempDir(\"pao-art-src-a-\");\n\t\t\tconst dirB = tempDir(\"pao-art-src-b-\");\n\t\t\twriteFileSync(join(dirA, \"same.txt\"), \"相同内容\");\n\t\t\twriteFileSync(join(dirB, \"same.txt\"), \"相同内容\");\n\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirA, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tartifactId: first.artifactId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirB, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 两版本各读各的；分支名不能代替 commit\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本一内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v1\"], { cwd: repo });\n\t\t\tconst commit1 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本二内容已改变\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v2\"], { cwd: repo });\n\t\t\tconst commit2 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst worktreePath = join(repo, \"gen.txt\");\n\n\t\t\tconst v1 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit1, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v1.ok).toBe(true);\n\t\t\tif (!v1.ok) return;\n\t\t\tconst v2 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tartifactId: v1.artifactId,\n\t\t\t\tparentVersionId: v1.versions[0]!.versionId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit2, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v2.ok).toBe(true);\n\t\t\tif (!v2.ok) return;\n\t\t\texpect(v2.versions[0]!.parentVersionId).toBe(v1.versions[0]!.versionId);\n\n\t\t\t// 工作树当前内容是 v2，但 v1 版本读到的仍是 commit1 的确切内容。\n\t\t\tconst read1 = await svc.resolveArtifactVersion({ versionId: v1.versions[0]!.versionId });\n\t\t\texpect(read1.ok && read1.available).toBe(true);\n\t\t\tif (read1.ok && read1.available) {\n\t\t\t\texpect(read1.content.toString(\"utf8\")).toBe(\"版本一内容\");\n\t\t\t}\n\t\t\tconst read2 = await svc.resolveArtifactVersion({ versionId: v2.versions[0]!.versionId });\n\t\t\texpect(read2.ok && read2.available).toBe(true);\n\t\t\tif (read2.ok && read2.available) {\n\t\t\t\texpect(read2.content.toString(\"utf8\")).toBe(\"版本二内容已改变\");\n\t\t\t}\n\n\t\t\t// 分支名登记被拒绝——分支会移动，不能代替固定 commit。\n\t\t\tconst branchRef = await svc.registerArtifact({\n\t\t\t\tname: \"分支登记\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: \"HEAD\", path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(branchRef.ok).toBe(false);\n\t\t\tif (!branchRef.ok) {\n\t\t\t\texpect(branchRef.error.code).toBe(\"invalid_input\");\n\t\t\t\texpect(branchRef.error.message).toContain(\"完整 commit SHA\");\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"O14：登记事务内不发起 git 子进程（事务范围证据）\", async () => {\n\t\t// 验收口径要求「事务范围」具体改善证据：探针包住 store.transaction，\n\t\t// 事务体内任何 spawnSync(\"git\",…) 都被计数——改前 prepareFile 的\n\t\t// rev-parse/cat-file 全在事务内，改后事务内应为 0。\n\t\tconst home = tempDir(\"pao-art-tx-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"g.txt\"), \"git 内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"g.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\n\t\t\t// 包一层 transaction 探针的 store：registerArtifact 只经它开写事务。\n\t\t\tconst probeStore = {\n\t\t\t\tdb: store.db,\n\t\t\t\tmode: \"readwrite\" as const,\n\t\t\t\tclose: () => {},\n\t\t\t\ttransaction: <T>(fn: () => T): T => {\n\t\t\t\t\tprobe.inTx = true;\n\t\t\t\t\ttry {\n\t\t\t\t\t\treturn store.transaction(fn);\n\t\t\t\t\t} finally {\n\t\t\t\t\t\tprobe.inTx = false;\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t};\n\t\t\tconst { registerArtifact } = await import(\"../../src/pao/memory/artifacts.ts\");\n\t\t\tprobe.active = true;\n\t\t\tprobe.gitSpawnsInTx = [];\n\t\t\tprobe.gitSpawnsTotal = 0;\n\t\t\ttry {\n\t\t\t\tconst registered = registerArtifact(probeStore, home, {\n\t\t\t\t\tname: \"事务范围证据\",\n\t\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\t\tfiles: [{ name: \"g.txt\", path: join(repo, \"g.txt\"), git: { commit, path: \"g.txt\" } }],\n\t\t\t\t\tsourceIds: [src],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\texpect(registered.ok).toBe(true);\n\t\t\t} finally {\n\t\t\t\tprobe.active = false;\n\t\t\t}\n\t\t\t// 写事务体内 git 子进程数应为 0（rev-parse/cat-file 都在事务外解析）；\n\t\t\t// 同时确认登记确实起过 git 进程（>0），防止「根本没走到 Git 路径」的\n\t\t\t// 假通过。\n\t\t\texpect(probe.gitSpawnsTotal).toBeGreaterThan(0);\n\t\t\texpect(probe.gitSpawnsInTx).toEqual([]);\n\t\t\texpect(svc).toBeDefined();\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 查重：同一 repo+commit+path 再登记复用版本，不产生第二行\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"a.txt\"), \"git 查重内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"a.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst file = { name: \"a.txt\", path: join(repo, \"a.txt\"), git: { commit, path: \"a.txt\" } };\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果甲\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\t// 另一个成果引用同一 git 身份：复用 versionId，usageRefs 补登不重复。\n\t\t\t// F12：查重命中不另建孤儿 artifacts 行——返回 artifactId 与版本自身归属一致。\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果乙\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\toriginTaskId: \"task-dup-2\",\n\t\t\t\tusageRefs: [\"req-1\", \"req-2\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-2\"]);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.artifactId).toBe(second.versions[0]!.artifactId);\n\t\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions\").get() as { n: number };\n\t\t\texpect(rows.n).toBe(1);\n\t\t\t// F12：查重命中也补当前任务的 aref 'task' 引用（不只新建版本分支记）。\n\t\t\tconst taskRef = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'task' AND owner_id = ?\",\n\t\t\t\t)\n\t\t\t\t.get(first.versions[0]!.versionId, \"task-dup-2\") as { owner_id: string } | undefined;\n\t\t\texpect(taskRef?.owner_id).toBe(\"task-dup-2\");\n\t\t\t// 孤儿行防线：全部查重命中时 artifacts 表仍只有 1 行。\n\t\t\tconst artifactRows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifacts\").get() as { n: number };\n\t\t\texpect(artifactRows.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"recordArtifactUse 记录 taskId/versionId/action 与回执引用\", async () => {\n\t\tconst home = tempDir(\"pao-art-use-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"u.txt\"), \"使用归因内容\");\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"使用归因\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"u.txt\", path: join(dir, \"u.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst used = await svc.recordArtifactUse({\n\t\t\t\tversionId: registered.versions[0]!.versionId,\n\t\t\t\ttaskId: \"task-reuse-1\",\n\t\t\t\taction: \"reuse\",\n\t\t\t\treceiptRef: \"receipt-abc\",\n\t\t\t\tsessionId: \"sess-2\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(used.ok).toBe(true);\n\t\t\tif (!used.ok) return;\n\t\t\tconst row = store.db\n\t\t\t\t.prepare(\"SELECT task_id, action, receipt_ref FROM artifact_uses WHERE use_id = ?\")\n\t\t\t\t.get(used.useId) as { task_id: string; action: string; receipt_ref: string };\n\t\t\texpect(row).toEqual({ task_id: \"task-reuse-1\", action: \"reuse\", receipt_ref: \"receipt-abc\" });\n\t\t\t// use 引用行同步登记（删除预览按它判断共享保留）。\n\t\t\tconst ref = store.db\n\t\t\t\t.prepare(\"SELECT ref_kind, owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'use'\")\n\t\t\t\t.get(registered.versions[0]!.versionId) as { ref_kind: string; owner_id: string };\n\t\t\texpect(ref.owner_id).toBe(used.useId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n"}},{"log":["info",[{"elements":[],"content":"Importing the types with "},{"elements":["Emphasis"],"content":"import type"},{"elements":[],"content":" ensures that they are removed by the compilers and avoids loading unnecessary modules."}]]},{"log":["info",[{"elements":[],"content":"Safe fix: Add inline "},{"elements":["Emphasis"],"content":"type"},{"elements":[],"content":" keywords."}]]},{"diff":{"dictionary":"/**\n * S6-01—05 定向测试：成果登记、确切版本回读与使用归因。\n * * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifacts.test.ts --maxWorkers=2\n */\nimport { execFileSync, type spawnSync } from \"node:child_process\";\nimport { existsSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,87]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[87,249]}}},{"diffOp":{"insert":{"range":[249,254]}}},{"diffOp":{"equal":{"range":[254,264]}}},{"diffOp":{"equal":{"range":[264,400]}}},{"equalLines":{"line_count":476}},{"diffOp":{"equal":{"range":[400,409]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-artifacts.test.ts"},"span":[547,600],"sourceCode":"/**\n * S6-01—05 定向测试：成果登记、确切版本回读与使用归因。\n *\n * 覆盖：一次调用产生两份成果共享 usageRef、登记重放不重复版本/引用、\n * 迟到用量只补引用、人工登记无工具调用时来源为人工、Git 两版本各读各的、\n * 分支名不能代替 commit、临时源删除后仍读受管副本、受管查重复用 versionId。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifacts.test.ts --maxWorkers=2\n */\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { existsSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryService } from \"../../src/pao/memory/types.ts\";\n\n/** O14 探针状态：统计「写事务执行期间」的 git 子进程调用。 */\nconst probe = vi.hoisted(() => ({\n\tgitSpawnsInTx: [] as string[][],\n\tgitSpawnsTotal: 0,\n\tinTx: false,\n\tactive: false,\n}));\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawnSync: (...args: Parameters<typeof spawnSync>) => {\n\t\t\tif (probe.active && args[0] === \"git\") {\n\t\t\t\tprobe.gitSpawnsTotal += 1;\n\t\t\t\tif (probe.inTx) probe.gitSpawnsInTx.push(args[1] as string[]);\n\t\t\t}\n\t\t\treturn (actual.spawnSync as typeof spawnSync)(...args);\n\t\t},\n\t};\n});\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-10T10:00:00.000Z\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite 句柄释放可能比 close 晚几毫秒（Windows）。\n\t\t}\n\t}\n});\n\nfunction openBoth(home: string): { svc: MemoryService; store: ReturnType<typeof openMemoryStore> } {\n\treturn { svc: openMemoryService({ paoHome: home, mode: \"readwrite\" }), store: openMemoryStore(home, \"readwrite\") };\n}\n\nfunction source(home: string, sessionId: string, entryId: string): string {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\treturn registerSource(store.db, { sessionId, entryId, eventType: \"user\", capturedAt: AT });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\ndescribe(\"registerArtifact / resolveArtifactVersion\", () => {\n\tit(\"一次调用产生两份成果共享同一 usageRef，不重复计费\", async () => {\n\t\tconst home = tempDir(\"pao-art-shared-usage-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"a.txt\"), \"交付文件甲\");\n\t\t\twriteFileSync(join(dir, \"b.txt\"), \"交付文件乙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"一次调用两份交付\",\n\t\t\t\tpurpose: \"验证共享用量\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [\n\t\t\t\t\t{ name: \"a.txt\", path: join(dir, \"a.txt\") },\n\t\t\t\t\t{ name: \"b.txt\", path: join(dir, \"b.txt\") },\n\t\t\t\t],\n\t\t\t\toriginTaskId: \"task-1\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tsourceToolName: \"bash\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions).toHaveLength(2);\n\t\t\t// 两份版本共享同一 usageRef\n\t\t\texpect(registered.versions[0]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\texpect(registered.versions[1]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\t// 各是一个版本行，不合并成一份\n\t\t\texpect(registered.versions[0]!.versionId).not.toBe(registered.versions[1]!.versionId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"同一 registrationKey 重放复用版本，不产生重复版本或重复 usageRef\", async () => {\n\t\tconst home = tempDir(\"pao-art-replay-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"out.txt\"), \"重放内容\");\n\n\t\t\tconst input = {\n\t\t\t\tname: \"重放成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"out.txt\", path: join(dir, \"out.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tregistrationKey: \"task-1:call-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t};\n\t\t\tconst first = await svc.registerArtifact(input);\n\t\t\texpect(first.ok && first.replayed).toBe(false);\n\t\t\tif (!first.ok) return;\n\n\t\t\t// 重放：迟到用量只补引用，版本行不新增。\n\t\t\tconst second = await svc.registerArtifact({ ...input, usageRefs: [\"req-1\", \"req-late\"] });\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.replayed).toBe(true);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.versions).toHaveLength(1);\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-late\"]);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"人工登记无工具调用时来源明确为人工（无 sourceToolCallId），不伪造调用\", async () => {\n\t\tconst home = tempDir(\"pao-art-manual-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-human\", \"e-human\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"hand.txt\"), \"人工登记内容\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"人工登记成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"hand.txt\", path: join(dir, \"hand.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceSessionId: \"sess-human\",\n\t\t\t\tsourceEntryId: \"e-human\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions[0]!.sourceToolCallId).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceToolName).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceSessionId).toBe(\"sess-human\");\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"未提交文件写受管副本；删除原临时源后仍读到相同内容\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-tmp-\");\n\t\t\tconst original = join(dir, \"scratch.txt\");\n\t\t\twriteFileSync(original, \"临时文件内容甲乙丙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"临时文件成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"scratch.txt\", path: original }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst version = registered.versions[0]!;\n\t\t\texpect(version.location.kind).toBe(\"managed\");\n\n\t\t\t// 原临时文件删除后，受管副本仍可读回相同字节。\n\t\t\trmSync(original);\n\t\t\texpect(existsSync(original)).toBe(false);\n\t\t\tconst resolved = await svc.resolveArtifactVersion({ versionId: version.versionId });\n\t\t\texpect(resolved.ok && resolved.available).toBe(true);\n\t\t\tif (resolved.ok && resolved.available) {\n\t\t\t\texpect(resolved.content.toString(\"utf8\")).toBe(\"临时文件内容甲乙丙\");\n\t\t\t}\n\t\t\tconst loc = version.location;\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\texpect(loc.dir.startsWith(memoryPaths(home).artifacts)).toBe(true);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"受管查重：相同内容再次登记复用 versionId，不重复保存\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dirA = tempDir(\"pao-art-src-a-\");\n\t\t\tconst dirB = tempDir(\"pao-art-src-b-\");\n\t\t\twriteFileSync(join(dirA, \"same.txt\"), \"相同内容\");\n\t\t\twriteFileSync(join(dirB, \"same.txt\"), \"相同内容\");\n\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirA, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tartifactId: first.artifactId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirB, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 两版本各读各的；分支名不能代替 commit\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本一内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v1\"], { cwd: repo });\n\t\t\tconst commit1 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本二内容已改变\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v2\"], { cwd: repo });\n\t\t\tconst commit2 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst worktreePath = join(repo, \"gen.txt\");\n\n\t\t\tconst v1 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit1, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v1.ok).toBe(true);\n\t\t\tif (!v1.ok) return;\n\t\t\tconst v2 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tartifactId: v1.artifactId,\n\t\t\t\tparentVersionId: v1.versions[0]!.versionId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit2, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v2.ok).toBe(true);\n\t\t\tif (!v2.ok) return;\n\t\t\texpect(v2.versions[0]!.parentVersionId).toBe(v1.versions[0]!.versionId);\n\n\t\t\t// 工作树当前内容是 v2，但 v1 版本读到的仍是 commit1 的确切内容。\n\t\t\tconst read1 = await svc.resolveArtifactVersion({ versionId: v1.versions[0]!.versionId });\n\t\t\texpect(read1.ok && read1.available).toBe(true);\n\t\t\tif (read1.ok && read1.available) {\n\t\t\t\texpect(read1.content.toString(\"utf8\")).toBe(\"版本一内容\");\n\t\t\t}\n\t\t\tconst read2 = await svc.resolveArtifactVersion({ versionId: v2.versions[0]!.versionId });\n\t\t\texpect(read2.ok && read2.available).toBe(true);\n\t\t\tif (read2.ok && read2.available) {\n\t\t\t\texpect(read2.content.toString(\"utf8\")).toBe(\"版本二内容已改变\");\n\t\t\t}\n\n\t\t\t// 分支名登记被拒绝——分支会移动，不能代替固定 commit。\n\t\t\tconst branchRef = await svc.registerArtifact({\n\t\t\t\tname: \"分支登记\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: \"HEAD\", path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(branchRef.ok).toBe(false);\n\t\t\tif (!branchRef.ok) {\n\t\t\t\texpect(branchRef.error.code).toBe(\"invalid_input\");\n\t\t\t\texpect(branchRef.error.message).toContain(\"完整 commit SHA\");\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"O14：登记事务内不发起 git 子进程（事务范围证据）\", async () => {\n\t\t// 验收口径要求「事务范围」具体改善证据：探针包住 store.transaction，\n\t\t// 事务体内任何 spawnSync(\"git\",…) 都被计数——改前 prepareFile 的\n\t\t// rev-parse/cat-file 全在事务内，改后事务内应为 0。\n\t\tconst home = tempDir(\"pao-art-tx-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"g.txt\"), \"git 内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"g.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\n\t\t\t// 包一层 transaction 探针的 store：registerArtifact 只经它开写事务。\n\t\t\tconst probeStore = {\n\t\t\t\tdb: store.db,\n\t\t\t\tmode: \"readwrite\" as const,\n\t\t\t\tclose: () => {},\n\t\t\t\ttransaction: <T>(fn: () => T): T => {\n\t\t\t\t\tprobe.inTx = true;\n\t\t\t\t\ttry {\n\t\t\t\t\t\treturn store.transaction(fn);\n\t\t\t\t\t} finally {\n\t\t\t\t\t\tprobe.inTx = false;\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t};\n\t\t\tconst { registerArtifact } = await import(\"../../src/pao/memory/artifacts.ts\");\n\t\t\tprobe.active = true;\n\t\t\tprobe.gitSpawnsInTx = [];\n\t\t\tprobe.gitSpawnsTotal = 0;\n\t\t\ttry {\n\t\t\t\tconst registered = registerArtifact(probeStore, home, {\n\t\t\t\t\tname: \"事务范围证据\",\n\t\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\t\tfiles: [{ name: \"g.txt\", path: join(repo, \"g.txt\"), git: { commit, path: \"g.txt\" } }],\n\t\t\t\t\tsourceIds: [src],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\texpect(registered.ok).toBe(true);\n\t\t\t} finally {\n\t\t\t\tprobe.active = false;\n\t\t\t}\n\t\t\t// 写事务体内 git 子进程数应为 0（rev-parse/cat-file 都在事务外解析）；\n\t\t\t// 同时确认登记确实起过 git 进程（>0），防止「根本没走到 Git 路径」的\n\t\t\t// 假通过。\n\t\t\texpect(probe.gitSpawnsTotal).toBeGreaterThan(0);\n\t\t\texpect(probe.gitSpawnsInTx).toEqual([]);\n\t\t\texpect(svc).toBeDefined();\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 查重：同一 repo+commit+path 再登记复用版本，不产生第二行\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"a.txt\"), \"git 查重内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"a.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst file = { name: \"a.txt\", path: join(repo, \"a.txt\"), git: { commit, path: \"a.txt\" } };\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果甲\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\t// 另一个成果引用同一 git 身份：复用 versionId，usageRefs 补登不重复。\n\t\t\t// F12：查重命中不另建孤儿 artifacts 行——返回 artifactId 与版本自身归属一致。\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果乙\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\toriginTaskId: \"task-dup-2\",\n\t\t\t\tusageRefs: [\"req-1\", \"req-2\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-2\"]);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.artifactId).toBe(second.versions[0]!.artifactId);\n\t\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions\").get() as { n: number };\n\t\t\texpect(rows.n).toBe(1);\n\t\t\t// F12：查重命中也补当前任务的 aref 'task' 引用（不只新建版本分支记）。\n\t\t\tconst taskRef = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'task' AND owner_id = ?\",\n\t\t\t\t)\n\t\t\t\t.get(first.versions[0]!.versionId, \"task-dup-2\") as { owner_id: string } | undefined;\n\t\t\texpect(taskRef?.owner_id).toBe(\"task-dup-2\");\n\t\t\t// 孤儿行防线：全部查重命中时 artifacts 表仍只有 1 行。\n\t\t\tconst artifactRows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifacts\").get() as { n: number };\n\t\t\texpect(artifactRows.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"recordArtifactUse 记录 taskId/versionId/action 与回执引用\", async () => {\n\t\tconst home = tempDir(\"pao-art-use-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"u.txt\"), \"使用归因内容\");\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"使用归因\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"u.txt\", path: join(dir, \"u.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst used = await svc.recordArtifactUse({\n\t\t\t\tversionId: registered.versions[0]!.versionId,\n\t\t\t\ttaskId: \"task-reuse-1\",\n\t\t\t\taction: \"reuse\",\n\t\t\t\treceiptRef: \"receipt-abc\",\n\t\t\t\tsessionId: \"sess-2\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(used.ok).toBe(true);\n\t\t\tif (!used.ok) return;\n\t\t\tconst row = store.db\n\t\t\t\t.prepare(\"SELECT task_id, action, receipt_ref FROM artifact_uses WHERE use_id = ?\")\n\t\t\t\t.get(used.useId) as { task_id: string; action: string; receipt_ref: string };\n\t\t\texpect(row).toEqual({ task_id: \"task-reuse-1\", action: \"reuse\", receipt_ref: \"receipt-abc\" });\n\t\t\t// use 引用行同步登记（删除预览按它判断共享保留）。\n\t\t\tconst ref = store.db\n\t\t\t\t.prepare(\"SELECT ref_kind, owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'use'\")\n\t\t\t\t.get(registered.versions[0]!.versionId) as { ref_kind: string; owner_id: string };\n\t\t\texpect(ref.owner_id).toBe(used.useId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable keptMemoryId is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"keptMemoryId"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"keptMemoryId"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * S7-09 定向测试：记忆数据库与归档的一致性备份/恢复（O07 修 F07/F08/F15）。\n *\t\tlet exclusiveSessionId = \"\";\n\t\tlet deletedMemoryId = \"\";\n\t\tlet keptMemoryId_keptMemoryId = \"\";\n\t\ttry {\n\t\t\t// 第二条独立会话来源：独占给将被删记忆。\t\t\t);\n\t\t\tif (!captured.sourceId) throw new Error(\"独占来源登记失败\");\n\t\t\texclusiveSourceId = captured.sourceId;\n\n\t\t\t// 存活记忆只引共享来源；被删记忆引共享+独占。\n\t\t\t= await createMemory(seeded.service, \"保留的决定\", [sharedSourceId]);\n\t\t\tdeletedMemoryId = await createMemory(seeded.service, \"被删的决定\", [sharedSourceId, exclusiveSourceId]);\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,108]}}},{"equalLines":{"line_count":466}},{"diffOp":{"equal":{"range":[108,173]}}},{"diffOp":{"delete":{"range":[173,185]}}},{"diffOp":{"insert":{"range":[185,198]}}},{"diffOp":{"equal":{"range":[198,199]}}},{"diffOp":{"equal":{"range":[199,276]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[276,395]}}},{"diffOp":{"equal":{"range":[395,471]}}},{"diffOp":{"delete":{"range":[173,185]}}},{"diffOp":{"insert":{"range":[185,198]}}},{"diffOp":{"equal":{"range":[198,199]}}},{"diffOp":{"equal":{"range":[471,659]}}},{"equalLines":{"line_count":162}},{"diffOp":{"equal":{"range":[659,668]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-backup.test.ts"},"span":[19174,19186],"sourceCode":"/**\n * S7-09 定向测试：记忆数据库与归档的一致性备份/恢复（O07 修 F07/F08/F15）。\n *\n * 覆盖：\n * - createMemoryBackup 用 VACUUM INTO 产生 manifest + 快照 + 段文件副本\n *   + 受管成果副本；备份目录非空拒绝覆盖；\n * - restoreMemoryBackup 恢复到新目录：段文件回位并重定位 archive_segments\n *   路径、来源可回读、受管成果副本回位并重写 location_json.dir、\n *   FTS/向量按库内 exclusion 清理；目标 memory/ 非空拒绝覆盖；\n * - 异地恢复（旧 home 不可读）后 readSourceEvents/resolveArtifactVersion\n *   仍从新 home 取到确切字节；\n * - 恢复时传 liveHome：备份后现场新产生的 source_exclusions 重放进\n *   恢复库，被排除记忆的正本/修订/来源行与派生索引一并清除，\n *   getMemory(includeHistory) 不再返回已删正文；\n * - 不传 liveHome 的独立旧备份：只有备份自带 exclusion，manifest.limitation\n *   如实声明无法推断备份后删除；\n * - archive jobKind 解析：parseArchiveJobScope 只认合法 backupDir。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-backup.test.ts --maxWorkers=2\n */\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { readSourceEvents } from \"../../src/pao/memory/archive.ts\";\nimport {\n\ttype BackupManifest,\n\tcreateMemoryBackup,\n\tparseArchiveJobScope,\n\trestoreMemoryBackup,\n} from \"../../src/pao/memory/backup.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { isSourceExcluded } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryService } from \"../../src/pao/memory/types.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-10T10:00:00.000Z\";\nconst PROJECT = \"pao-dev\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nfunction makePersistentSession(home: string, id: string) {\n\tconst sessionDir = join(home, \"agent\", \"sessions\");\n\tconst manager = SessionManager.create(home, sessionDir, { id });\n\tmanager.appendMessage(userMsg(\"备份测试的用户上下文\"));\n\tconst assistantId = manager.appendMessage(assistantMsg(\"备份测试的助手回复\"));\n\tconst file = manager.getSessionFile();\n\tif (!file || !existsSync(file)) throw new Error(\"真实会话文件未创建\");\n\treturn { manager, file, assistantId };\n}\n\nasync function createMemory(service: MemoryService, conclusion: string, sourceIds: string[]): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: \"decision\",\n\t\tscope: { projectId: PROJECT },\n\t\tconclusion,\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds,\n\t\tcreatedAt: AT,\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\n/** 造一份含一条真实来源、一条激活记忆的最小现场。 */\nasync function seedHome(home: string, conclusion: string) {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\tconst session = makePersistentSession(home, `sess-${Math.random().toString(36).slice(2, 8)}`);\n\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\tcapture.registerSession(session.manager.getSessionId(), session.file);\n\tconst captured = capture.captureCommittedEntry(\n\t\tsession.manager.getSessionId(),\n\t\tsession.manager.getEntry(session.assistantId) as never,\n\t\t\"user\",\n\t\tAT,\n\t);\n\tif (!captured.sourceId) throw new Error(\"来源登记失败\");\n\tconst memoryId = await createMemory(service, conclusion, [captured.sourceId]);\n\treturn { store, service, session, sourceId: captured.sourceId, memoryId };\n}\n\nfunction readManifest(backupDir: string): BackupManifest {\n\treturn JSON.parse(readFileSync(join(backupDir, \"manifest.json\"), \"utf8\")) as BackupManifest;\n}\n\ndescribe(\"S7-09 一致性备份/恢复\", () => {\n\tit(\"备份生成 manifest+快照+段副本；目录非空拒绝覆盖\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src-\");\n\t\tconst seeded = await seedHome(home, \"备份一致性验证结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out-\"), \"backup-1\");\n\t\ttry {\n\t\t\tconst result = createMemoryBackup(seeded.store, {\n\t\t\t\thome,\n\t\t\t\tbackupDir,\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(result.ok).toBe(true);\n\t\t\tif (!result.ok) return;\n\t\t\texpect(existsSync(result.snapshotPath)).toBe(true);\n\t\t\texpect(result.memoryCount).toBe(1);\n\t\t\texpect(result.copiedSegments).toBe(1);\n\t\t\texpect(result.missingSegments).toBe(0);\n\n\t\t\tconst manifest = readManifest(backupDir);\n\t\t\texpect(manifest.version).toBe(1);\n\t\t\texpect(manifest.memoryCount).toBe(1);\n\t\t\texpect(manifest.segments).toHaveLength(1);\n\t\t\texpect(manifest.segments[0]!.backupPath).toMatch(/^segments[/\\\\]/);\n\t\t\texpect(manifest.limitation).toContain(\"备份之后产生的删除排除记录不包含在内\");\n\n\t\t\t// 备份目录非空 → 拒绝覆盖。\n\t\t\tconst again = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(again.ok).toBe(false);\n\t\t\tif (!again.ok) expect(again.error.code).toBe(\"invalid_input\");\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t});\n\n\tit(\"恢复到新目录：段回位、来源可回读、exclusion 生效清派生索引\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src2-\");\n\t\tconst seeded = await seedHome(home, \"恢复后可读来源结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out2-\"), \"backup-2\");\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredSegments).toBe(1);\n\t\texpect(existsSync(restored.database)).toBe(true);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst row = store.db.prepare(`SELECT conclusion_ok FROM (SELECT 1 AS conclusion_ok)`).get() as {\n\t\t\t\tconclusion_ok: number;\n\t\t\t};\n\t\t\texpect(row.conclusion_ok).toBe(1);\n\t\t\tconst memory = store.db.prepare(`SELECT id FROM memories WHERE id = ?`).get(seeded.memoryId) as\n\t\t\t\t| { id: string }\n\t\t\t\t| undefined;\n\t\t\texpect(memory?.id).toBe(seeded.memoryId);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"传 liveHome：备份后新 exclusion 重放进恢复库并清派生索引\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src3-\");\n\t\tconst seeded = await seedHome(home, \"备份后删除的记忆结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out3-\"), \"backup-3\");\n\t\tconst memoryId = seeded.memoryId;\n\t\tconst sourceId = seeded.sourceId;\n\t\ttry {\n\t\t\t// 备份后删该记忆：source_exclusions 在库内出现。\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.exclusionCount).toBe(0); // 备份时还没有排除\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: seeded.session.manager.getSessionId() },\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t\texpect(isSourceExcluded(seeded.store.db, { sourceId })).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst3-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBeGreaterThan(0);\n\t\texpect(restored.exclusionCount).toBeGreaterThanOrEqual(restored.replayedExclusions);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\t// 恢复库里：正本记忆行还在（备份时刻存在），但 exclusion 已重放、派生索引已清。\n\t\t\texpect(isSourceExcluded(store.db, { sourceId })).toBe(true);\n\t\t\tconst ftsRows = store.db.prepare(`SELECT COUNT(*) AS n FROM memory_fts WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\tn: number;\n\t\t\t};\n\t\t\texpect(ftsRows.n).toBe(0);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"独立旧备份不传 liveHome：只留备份自带 exclusion，limitation 如实声明\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src4-\");\n\t\tconst seeded = await seedHome(home, \"独立备份的限制说明结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out4-\"), \"backup-4\");\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst4-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBe(0);\n\t\texpect(restored.exclusionCount).toBe(0);\n\t\texpect(restored.limitation).toContain(\"备份之后产生的删除排除记录不包含在内\");\n\t});\n\n\tit(\"目标 memory/ 非空拒绝覆盖；manifest/快照缺失如实失败\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src5-\");\n\t\tconst seeded = await seedHome(home, \"覆盖保护验证结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out5-\"), \"backup-5\");\n\t\ttry {\n\t\t\texpect(createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT }).ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\t// 目标已有 memory 数据 → 拒绝。\n\t\tconst occupiedHome = tempDir(\"pao-bak-occ-\");\n\t\tmkdirSync(join(occupiedHome, \"memory\"), { recursive: true });\n\t\twriteFileSync(join(occupiedHome, \"memory\", \"memory.sqlite\"), \"x\");\n\t\tconst occupied = restoreMemoryBackup({ backupDir, targetHome: occupiedHome, restoredAt: AT });\n\t\texpect(occupied.ok).toBe(false);\n\t\tif (!occupied.ok) expect(occupied.error.code).toBe(\"invalid_input\");\n\n\t\t// manifest 缺失 → invalid_input。\n\t\tconst empty = tempDir(\"pao-bak-empty-\");\n\t\tconst noManifest = restoreMemoryBackup({ backupDir: empty, targetHome: tempDir(\"pao-bak-t1-\"), restoredAt: AT });\n\t\texpect(noManifest.ok).toBe(false);\n\t\tif (!noManifest.ok) expect(noManifest.error.code).toBe(\"invalid_input\");\n\n\t\t// manifest 在但快照缺 → source_missing。\n\t\tconst broken = tempDir(\"pao-bak-broken-\");\n\t\twriteFileSync(\n\t\t\tjoin(broken, \"manifest.json\"),\n\t\t\tJSON.stringify({\n\t\t\t\tversion: 1,\n\t\t\t\tcreatedAt: AT,\n\t\t\t\tsourceHome: \"x\",\n\t\t\t\tsnapshotPath: \"memory.snapshot\",\n\t\t\t\texclusionCount: 0,\n\t\t\t\tmemoryCount: 0,\n\t\t\t\tsegments: [],\n\t\t\t\tlimitation: \"x\",\n\t\t\t}),\n\t\t);\n\t\tconst noSnapshot = restoreMemoryBackup({ backupDir: broken, targetHome: tempDir(\"pao-bak-t2-\"), restoredAt: AT });\n\t\texpect(noSnapshot.ok).toBe(false);\n\t\tif (!noSnapshot.ok) expect(noSnapshot.error.code).toBe(\"source_missing\");\n\t});\n\n\tit(\"parseArchiveJobScope 只认合法 backupDir\", () => {\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\",\"backupDir\":\"/tmp/x\"}')).toEqual({ backupDir: \"/tmp/x\" });\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope('{\"kind\":\"embed\",\"backupDir\":\"/tmp/x\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope('{\"kind\":\"archive\",\"backupDir\":\"\"}')).toBeUndefined();\n\t\texpect(parseArchiveJobScope(\"not-json\")).toBeUndefined();\n\t});\n\n\tit(\"异地恢复（旧 home 不可读）后 readSourceEvents 从新 home 回读段\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src6-\");\n\t\tconst seeded = await seedHome(home, \"异地恢复回读结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out6-\"), \"backup-6\");\n\t\ttry {\n\t\t\texpect(createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT }).ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t\t// 旧 home 不可读（移走），恢复后回读不能再依赖旧绝对路径。\n\t\trmSync(home, { recursive: true, force: true });\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst6-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst events = await readSourceEvents(store.db, targetHome, seeded.sourceId, { limit: 10 });\n\t\t\texpect(events.ok).toBe(true);\n\t\t\tif (!events.ok) return;\n\t\t\texpect(events.events.length).toBeGreaterThan(0);\n\t\t\texpect(JSON.stringify(events.events[0]!.content)).toContain(\"备份测试\");\n\t\t\t// 恢复库内段路径已重写到新 home。\n\t\t\tconst seg = store.db\n\t\t\t\t.prepare(`SELECT original_path, compressed_path FROM archive_segments`)\n\t\t\t\t.get() as { original_path: string | null; compressed_path: string | null };\n\t\t\tconst path = seg.compressed_path ?? seg.original_path;\n\t\t\texpect(path).not.toBeNull();\n\t\t\texpect(path!).toContain(memoryPaths(targetHome).archives);\n\t\t\texpect(path!).not.toContain(home);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"受管成果恢复后 resolveArtifactVersion 从新 home 读回确切字节\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src7-\");\n\t\tconst seeded = await seedHome(home, \"受管成果恢复结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out7-\"), \"backup-7\");\n\t\tlet versionId = \"\";\n\t\tlet artifactId = \"\";\n\t\tconst deliveredDir = tempDir(\"pao-bak-art-\");\n\t\ttry {\n\t\t\twriteFileSync(join(deliveredDir, \"deliver.txt\"), \"受管成果确切字节\");\n\t\t\tconst registered = await seeded.service.registerArtifact({\n\t\t\t\tname: \"恢复用成果\",\n\t\t\t\tpurpose: \"验证受管副本随备份\",\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tfiles: [{ name: \"deliver.txt\", path: join(deliveredDir, \"deliver.txt\") }],\n\t\t\t\tsourceIds: [seeded.sourceId],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tartifactId = registered.artifactId;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.copiedArtifacts).toBe(1);\n\t\t\texpect(backup.missingArtifacts).toBe(0);\n\t\t\tconst manifest = readManifest(backupDir);\n\t\t\texpect(manifest.artifacts).toHaveLength(1);\n\t\t\texpect(manifest.artifacts![0]!.versionId).toBe(versionId);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\t\t// 旧 home 与交付源都不可读。\n\t\trmSync(home, { recursive: true, force: true });\n\t\trmSync(deliveredDir, { recursive: true, force: true });\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst7-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredArtifacts).toBe(1);\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId });\n\t\t\texpect(resolved.ok).toBe(true);\n\t\t\tif (!resolved.ok) return;\n\t\t\texpect(resolved.available).toBe(true);\n\t\t\tif (!resolved.available) return;\n\t\t\texpect(resolved.content.toString(\"utf8\")).toBe(\"受管成果确切字节\");\n\t\t\texpect(resolved.version.artifactId).toBe(artifactId);\n\t\t\t// location.dir 已重写到新 home。\n\t\t\tconst loc = resolved.version.location;\n\t\t\texpect(loc.kind).toBe(\"managed\");\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\texpect(loc.dir).toContain(memoryPaths(targetHome).artifacts);\n\t\t\t\texpect(loc.dir).not.toContain(home);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\tit(\"带 liveHome 删除后恢复：getMemory(includeHistory) 不再返回已删正文\", async () => {\n\t\tconst home = tempDir(\"pao-bak-src8-\");\n\t\tconst seeded = await seedHome(home, \"备份后彻底删除的结论正文\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-out8-\"), \"backup-8\");\n\t\tconst memoryId = seeded.memoryId;\n\t\tconst sourceId = seeded.sourceId;\n\t\ttry {\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [memoryId],\n\t\t\t\trevisions: { [memoryId]: 1 },\n\t\t\t\tsource: { sessionId: seeded.session.manager.getSessionId() },\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-dst8-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.replayedExclusions).toBeGreaterThan(0);\n\t\texpect(restored.purgedMemories).toBe(1);\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\t// 已删记忆按 ID 查不存在。\n\t\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\t\texpect(got.ok).toBe(false);\n\t\t\tif (!got.ok) expect(got.error.code).toBe(\"invalid_input\");\n\n\t\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\t\ttry {\n\t\t\t\t// 正本/修订/来源行已清；派生索引也清。\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memories WHERE id = ?`).get(memoryId) as { n: number }).n,\n\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memory_revisions WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\tn: number;\n\t\t\t\t\t}).n,\n\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memory_fts WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\tn: number;\n\t\t\t\t\t}).n,\n\t\t\t\t).toBe(0);\n\t\t\t\t// 已删正文不再可回读：来源行已清 → 按 sourceId 回读 source_missing。\n\t\t\t\tconst events = await readSourceEvents(store.db, targetHome, sourceId, { limit: 10 });\n\t\t\t\texpect(events.ok).toBe(false);\n\t\t\t\tif (!events.ok) expect(events.error.code).toBe(\"source_missing\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\t// R2：共享保留来源的 source_fts 不随删除重放丢失（历史检索仍命中）。\n\tit(\"R2 删除重放：共享保留来源的 source_fts 保留、独占来源清除\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r2-\");\n\t\tconst seeded = await seedHome(home, \"共享保留来源的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r2o-\"), \"backup-r2\");\n\t\tconst sharedSourceId = seeded.sourceId;\n\t\tconst sharedSessionId = seeded.session.manager.getSessionId();\n\t\tlet exclusiveSourceId = \"\";\n\t\tlet exclusiveSessionId = \"\";\n\t\tlet deletedMemoryId = \"\";\n\t\tlet keptMemoryId = \"\";\n\t\ttry {\n\t\t\t// 第二条独立会话来源：独占给将被删记忆。\n\t\t\tconst second = makePersistentSession(home, `sess-${Math.random().toString(36).slice(2, 8)}`);\n\t\t\texclusiveSessionId = second.manager.getSessionId();\n\t\t\tconst capture = createCapture({ store: seeded.store, paoHome: home, now: () => AT });\n\t\t\tcapture.registerSession(exclusiveSessionId, second.file);\n\t\t\tconst captured = capture.captureCommittedEntry(\n\t\t\t\texclusiveSessionId,\n\t\t\t\tsecond.manager.getEntry(second.assistantId) as never,\n\t\t\t\t\"user\",\n\t\t\t\tAT,\n\t\t\t);\n\t\t\tif (!captured.sourceId) throw new Error(\"独占来源登记失败\");\n\t\t\texclusiveSourceId = captured.sourceId;\n\n\t\t\t// 存活记忆只引共享来源；被删记忆引共享+独占。\n\t\t\tkeptMemoryId = await createMemory(seeded.service, \"保留的决定\", [sharedSourceId]);\n\t\t\tdeletedMemoryId = await createMemory(seeded.service, \"被删的决定\", [sharedSourceId, exclusiveSourceId]);\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\n\t\t\tconst deleted = await seeded.service.deleteMemory({\n\t\t\t\tmemoryIds: [deletedMemoryId],\n\t\t\t\trevisions: { [deletedMemoryId]: 1 },\n\t\t\t\tsource: { sessionId: sharedSessionId },\n\t\t\t\tsharedSourcePolicy: \"retain\",\n\t\t\t});\n\t\t\texpect(deleted.ok).toBe(true);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r2d-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, liveHome: home, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.purgedMemories).toBe(1);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\t// 共享保留来源行与其 fts 索引都保留；独占来源行与索引清除。\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(sharedSourceId) as { n: number }).n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(sharedSourceId) as { n: number })\n\t\t\t\t\t.n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(exclusiveSourceId) as { n: number })\n\t\t\t\t\t.n,\n\t\t\t).toBe(0);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(exclusiveSourceId) as {\n\t\t\t\t\tn: number;\n\t\t\t\t}).n,\n\t\t\t).toBe(0);\n\n\t\t\t// 共享来源仍可按 ID 回读、history 原文检索仍命中。\n\t\t\tconst direct = await readSourceEvents(store.db, targetHome, sharedSourceId);\n\t\t\texpect(direct.ok).toBe(true);\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\t// seedHome 采集的是 assistant 条目（\"备份测试的助手回复\"）。\n\t\t\tconst history = await service.searchMemory({\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tquery: \"助手回复\",\n\t\t\t\tmode: \"history\",\n\t\t\t});\n\t\t\texpect(history.ok).toBe(true);\n\t\t\tif (history.ok) {\n\t\t\t\texpect(history.sourceHits?.some((hit) => hit.sourceId === sharedSourceId)).toBe(true);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n\n\t// R3：备份时副本缺失的段恢复后清旧 home 路径，不回读旧现场。\n\tit(\"R3 缺失段副本：恢复后清 original_path/compressed_path，不回读旧 home\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r3s-\");\n\t\tconst seeded = await seedHome(home, \"缺失段副本的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r3so-\"), \"backup-r3s\");\n\t\tconst sourceId = seeded.sourceId;\n\t\tlet heldPath = \"\";\n\t\ttry {\n\t\t\tconst row = seeded.store.db.prepare(`SELECT original_path FROM archive_segments`).get() as {\n\t\t\t\toriginal_path: string;\n\t\t\t};\n\t\t\theldPath = `${row.original_path}.held`;\n\t\t\trenameSync(row.original_path, heldPath);\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\trenameSync(heldPath, row.original_path);\n\t\t\texpect(backup.ok).toBe(true);\n\t\t\tif (!backup.ok) return;\n\t\t\texpect(backup.missingSegments).toBe(1);\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r3sd-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst seg = store.db\n\t\t\t\t.prepare(`SELECT original_path, compressed_path FROM archive_segments`)\n\t\t\t\t.get() as { original_path: string | null; compressed_path: string | null };\n\t\t\texpect(seg.original_path).toBeNull();\n\t\t\texpect(seg.compressed_path).toBeNull();\n\t\t\tconst read = await readSourceEvents(store.db, targetHome, sourceId);\n\t\t\texpect(read.ok).toBe(false);\n\t\t\tif (!read.ok) expect(read.error.code).toBe(\"source_missing\");\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\t// R3：旧版 manifest 无 artifacts 清单时，受管版本 location.dir 也重写到新 home。\n\tit(\"R3 旧版 manifest 无 artifacts：managed 版本 dir 重写、副本缺失如实 unavailable\", async () => {\n\t\tconst home = tempDir(\"pao-bak-r3a-\");\n\t\tconst seeded = await seedHome(home, \"旧版 manifest 无成果清单的结论\");\n\t\tconst backupDir = join(tempDir(\"pao-bak-r3ao-\"), \"backup-r3a\");\n\t\tlet versionId = \"\";\n\t\ttry {\n\t\t\tconst deliveredDir = tempDir(\"pao-bak-r3ad-\");\n\t\t\twriteFileSync(join(deliveredDir, \"deliver.txt\"), \"旧版成果字节\");\n\t\t\tconst registered = await seeded.service.registerArtifact({\n\t\t\t\tname: \"旧版成果\",\n\t\t\t\tscope: { projectId: PROJECT },\n\t\t\t\tfiles: [{ name: \"deliver.txt\", path: join(deliveredDir, \"deliver.txt\") }],\n\t\t\t\tsourceIds: [seeded.sourceId],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\tconst backup = createMemoryBackup(seeded.store, { home, backupDir, createdAt: AT });\n\t\t\texpect(backup.ok).toBe(true);\n\n\t\t\t// 模拟旧版 manifest：去掉 artifacts 字段。\n\t\t\tconst manifestPath = join(backupDir, \"manifest.json\");\n\t\t\tconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\")) as Record<string, unknown>;\n\t\t\tdelete manifest.artifacts;\n\t\t\twriteFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\\n`, \"utf8\");\n\t\t} finally {\n\t\t\tawait seeded.service.close();\n\t\t\tseeded.store.close();\n\t\t}\n\n\t\tconst targetHome = tempDir(\"pao-bak-r3adt-\");\n\t\tconst restored = restoreMemoryBackup({ backupDir, targetHome, restoredAt: AT });\n\t\texpect(restored.ok).toBe(true);\n\t\tif (!restored.ok) return;\n\t\texpect(restored.restoredArtifacts).toBe(0);\n\t\texpect(restored.limitation).toContain(\"受管成果副本缺失 1 个\");\n\n\t\tconst service = openMemoryService({ paoHome: targetHome, mode: \"readonly\" });\n\t\ttry {\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId });\n\t\t\texpect(resolved.ok).toBe(true);\n\t\t\tif (!resolved.ok) return;\n\t\t\texpect(resolved.available).toBe(false);\n\t\t\tconst loc = resolved.version.location;\n\t\t\texpect(loc.kind).toBe(\"managed\");\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\t// dir 已指向目标 home 预期位置，不是旧 home 绝对路径。\n\t\t\t\texpect(loc.dir).toContain(memoryPaths(targetHome).artifacts);\n\t\t\t\texpect(loc.dir).not.toContain(home);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait service.close();\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *import type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { archiveProjectOperationSource } from \"../../src/pao/memory/project-operation-source.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport {\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,82]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[82,303]}}},{"diffOp":{"delete":{"range":[303,401]}}},{"diffOp":{"equal":{"range":[401,479]}}},{"equalLines":{"line_count":1007}},{"diffOp":{"equal":{"range":[479,488]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-correction.test.ts"},"span":[1106,1139],"sourceCode":"/**\n * S2 批次 E 定向测试：纠正优先、并发感知与失败可续。\n *\n * 覆盖：延迟提炼不覆盖页面/对话纠正、停用/删除后旧候选不复活、\n * 关机取消与重启继续（不重复已提交事件）、双会话 scope 修订感知、\n * builtin 纠正走 service.correctMemory 单步。\n *\n * 模型一律假；真实 UI/事件挂接由 D 批实现，本文件测数据层正确性。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-correction.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { archiveProjectOperationSource } from \"../../src/pao/memory/project-operation-source.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport {\n\tBUILTIN_PROVIDER,\n\tbindBuiltinMemoryService,\n\tregisterMemoryCommand,\n\tsessionMemory,\n} from \"../../src/pao/memory/session.ts\";\nimport { registerBuiltinMemory } from \"../../src/pao/memory/tools.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { assistantMsg, userMsg } from \"../utilities.ts\";\nimport type {\n\tCommitSourceRef,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";\nimport type { ToolDefinition } from \"../../src/core/extensions/types.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-cor-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst AT3 = \"2026-11-08T10:02:00.000Z\";\nconst AT4 = \"2026-11-08T10:03:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-alpha\" };\n\nafterEach(async () => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nfunction seedSource(\n\tstore: MemoryStore,\n\tover: { sessionId?: string; entryId?: string; eventType?: string; capturedAt?: string } = {},\n) {\n\tconst sessionId = over.sessionId ?? \"sess-1\";\n\tconst entryId = over.entryId ?? `e-${Math.random().toString(36).slice(2, 8)}`;\n\tconst eventType = over.eventType ?? \"user\";\n\tconst sourceId = registerSource(store.db, { sessionId, entryId, eventType, capturedAt: over.capturedAt ?? AT });\n\treturn { sourceId, ref: { sourceId, sessionId, entryId, eventType } as CommitSourceRef };\n}\n\nfunction candidate(over: Partial<ValidatedCandidate> & { sourceId: string }): ValidatedCandidate {\n\tconst { sourceId, ...rest } = over;\n\treturn {\n\t\tkind: \"decision\",\n\t\tconclusion: \"旧结论：存储用 PostgreSQL\",\n\t\tconditions: \"原条件\",\n\t\trationale: \"旧理由\",\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [sourceId],\n\t\tquotedSpans: [{ sourceId, text: \"span\" }],\n\t\tspanLocations: [{ sourceId, match: \"exact\", offset: 0 }],\n\t\t...rest,\n\t};\n}\n\nasync function relatedSnapshot(service: MemoryService, memoryId: string): Promise<RelatedMemorySummary> {\n\tconst got = await service.getMemory({ id: memoryId });\n\tif (!got.ok) throw new Error(got.error.message);\n\treturn {\n\t\tmemoryId: got.memory.id,\n\t\tkind: got.memory.kind,\n\t\tcurrentRevision: got.memory.currentRevision,\n\t\tconclusion: got.memory.content.conclusion,\n\t\t...(got.memory.content.conditions === undefined ? {} : { conditions: got.memory.content.conditions }),\n\t\tconfirmation: got.memory.content.confirmation,\n\t\tusageState: got.memory.usageState,\n\t};\n}\n\n// ── S2-09 提交核对：延迟提炼不能撤销页面/对话纠正 ────────────────────────\n\ndescribe(\"提交核对（延迟提炼 vs 纠正）\", () => {\n\tit(\"页面 r1→r2 后旧候选提交：top3 保持唯一 active，旧 top5 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t});\n\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"页面召回返回 top3\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.usageState).toBe(\"active\");\n\t\t}\n\t\tconst activeTop3 = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top3\") as { count: number };\n\t\tconst top5Rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t\t   AND json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId, \"页面召回返回 top5\") as { count: number };\n\t\texpect(activeTop3.count).toBe(1);\n\t\texpect(top5Rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"自然措辞变化沿用旧来源时仍按 request 快照修订跳过\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst assistantSource = seedSource(store, { entryId: \"e-assistant\" });\n\t\tconst userSource = seedSource(store, { entryId: \"e-user\" });\n\t\tconst sourceIds = [assistantSource.sourceId, userSource.sourceId];\n\t\tconst r1Candidate = candidate({\n\t\t\tsourceId: assistantSource.sourceId,\n\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\tsourceIds,\n\t\t\tquotedSpans: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t],\n\t\t\tspanLocations: [\n\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t],\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [r1Candidate],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: {\n\t\t\t\tconclusion: \"自动召回每轮 top3\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t},\n\t\t\tsource: { sessionId: \"sess-1\", entryId: \"e-page-correction\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-natural-wording\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: assistantSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t\tsourceIds,\n\t\t\t\t\tquotedSpans: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, text: \"缺省 top3\" },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, text: \"改为 top5\" },\n\t\t\t\t\t],\n\t\t\t\t\tspanLocations: [\n\t\t\t\t\t\t{ sourceId: assistantSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t{ sourceId: userSource.sourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t],\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [assistantSource.ref, userSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t\tsnapshotRevision: 1,\n\t\t\tsourceIds,\n\t\t});\n\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.all(SCOPE.projectId) as Array<{ id: string; content_json: string }>;\n\t\texpect(activeRows).toHaveLength(1);\n\t\texpect(activeRows[0].id).toBe(memoryId);\n\t\texpect(JSON.parse(activeRows[0].content_json).conclusion).toBe(\"自动召回每轮 top3\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"停用后旧候选重放：跳过迟到候选，不新建 active 旧结论\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId: s.sourceId,\n\t\t\tconclusion: \"存储决定改为使用 SQLite。\",\n\t\t});\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst stopped = await service.setMemoryUsage({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(stopped.ok).toBe(true);\n\n\t\tconst stale = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"存储决定改使用 SQLite。\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(stale.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"stale_request_snapshot\",\n\t\t\tmemoryId,\n\t\t});\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) expect(got.memory.usageState).toBe(\"stopped\");\n\t\tconst activeRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS count\n\t\t\t\t FROM memories\n\t\t\t\t WHERE usage_state = 'active'\n\t\t\t\t   AND json_extract(scope_json, '$.projectId') = ?`,\n\t\t\t)\n\t\t\t.get(SCOPE.projectId) as { count: number };\n\t\texpect(activeRows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"删除后旧候选重放：沿用来源排除，不重建旧记忆\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sessionId = \"sess-delete-late\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst entryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"旧结论：页面召回返回 top5\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst captured = capture.captureCommittedEntry(sessionId, manager.getEntry(entryId)!, undefined, AT);\n\t\tconst s = {\n\t\t\tsourceId: captured.sourceId!,\n\t\t\tref: {\n\t\t\t\tsourceId: captured.sourceId!,\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: \"user\",\n\t\t\t} satisfies CommitSourceRef,\n\t\t};\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst deleted = await service.deleteMemory({\n\t\t\tmemoryIds: [memoryId],\n\t\t\trevisions: { [memoryId]: 1 },\n\t\t\tsource: { sessionId },\n\t\t});\n\t\texpect(deleted).toMatchObject({ ok: true, status: \"complete\" });\n\n\t\tconst late = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(late.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"source_excluded\" });\n\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories WHERE id = ?\").get(memoryId) as {\n\t\t\tcount: number;\n\t\t};\n\t\texpect(rows.count).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源的独立候选在旧修订失效时转新请求，不冒充独立提交\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" }),\n\t\t\t\tcandidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" }),\n\t\t\t],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"stale_request_snapshot\" });\n\t\texpect(result.submitted).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"同来源独立候选在相关修订未变化时正常落库\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"页面召回返回 top5\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j-independent-current\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"侧边栏宽度保持 320px\" })],\n\t\t\tsourceRefs: [s.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\texpect(result.submitted).toBe(1);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"新来源明确重申旧决定：不被旧请求快照误判为迟到结果\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst oldSource = seedSource(store, { entryId: \"e-old\" });\n\t\tconst r1 = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: oldSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [oldSource.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (r1.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst requestSnapshot = [await relatedSnapshot(service, memoryId)];\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: memoryId,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"页面召回返回 top3\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst newSource = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-reaffirm\", capturedAt: AT3 });\n\t\tconst result = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: newSource.sourceId,\n\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [newSource.ref],\n\t\t\trelatedMemories: requestSnapshot,\n\t\t\tnow: AT3,\n\t\t});\n\t\texpect(result.outcomes[0]).toMatchObject({ status: \"submitted\" });\n\t\tconst newMemoryId = (result.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst linked = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM memory_source_links\n\t\t\t\t WHERE memory_id = ? AND revision = 1`,\n\t\t\t)\n\t\t\t.all(newMemoryId) as Array<{ source_id: string }>;\n\t\texpect(linked.map((row) => row.source_id)).toEqual([newSource.sourceId]);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── S2-12 失败可续 + 关机/重启恢复 ───────────────────────────────────────\n\ndescribe(\"失败可续与重启恢复\", () => {\n\tit(\"job 失败后 recoverJobs 重取，已提交游标不重复处理\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { createJob, claimJob, advanceCursor, failJob, recoverJobs } = await import(\n\t\t\t\"../../src/pao/memory/extraction-jobs.ts\"\n\t\t);\n\t\t// 建 job + 领取 + 推进游标（已提交一半）+ 失败\n\t\tconst job = createJob(store, { sourceScope: \"{}\", scopeKey: \"s1\", createdAt: AT });\n\t\tconst claimed = claimJob(store, { jobId: job.jobId, ownerProcess: \"pid-99999\", claimedAt: AT });\n\t\texpect(claimed).toBeDefined();\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"e5\", advancedAt: AT2 });\n\t\tfailJob(store, { jobId: job.jobId, reason: \"模型超时\", failedAt: AT3 });\n\n\t\t// 持有者 pid-99999 已死（非本进程），recover 重取为 pending\n\t\tconst recovered = recoverJobs(store, AT4);\n\t\texpect(recovered.recovered.some((j) => j.jobId === job.jobId)).toBe(true);\n\t\tconst after = store.db.prepare(`SELECT status, cursor FROM extraction_jobs WHERE job_id = ?`).get(job.jobId) as {\n\t\t\tstatus: string;\n\t\t\tcursor: string | null;\n\t\t};\n\t\texpect(after.status).toBe(\"pending\");\n\t\texpect(after.cursor).toBe(\"e5\"); // 游标保留——重跑只处理 e5 之后\n\t\tstore.close();\n\t});\n});\n\n// ── S2-10 scope 修订感知：双会话一写一读一致 ─────────────────────────────\n\ndescribe(\"scope 修订感知\", () => {\n\tit(\"会话A写入后 scopeRevision 递增；会话B比对发现变化\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scopeId = SCOPE.projectId!;\n\n\t\t// 会话B 先读一次基线（无记录 → revision 0）\n\t\tconst base = await service.readScopeRevision({ scopeId });\n\t\tif (base.ok) expect(base.revision).toBe(0);\n\n\t\t// 会话A 写入一条决定 → scope_revisions 递增\n\t\tconst s = seedSource(store, { sessionId: \"sess-A\" });\n\t\tawait commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"jA\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s.sourceId, conclusion: \"A 会话的决定\" })],\n\t\t\trelatedMemories: [],\n\t\t\tsourceRefs: [s.ref],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst after = await service.readScopeRevision({ scopeId });\n\t\tif (after.ok) expect(after.revision).toBeGreaterThan(0);\n\n\t\t// 会话B 的 lastScopeRevisions 记的是 0 → 比对 after.revision !== 0 即发现变化\n\t\t//（SessionMemory.lastScopeRevisions 的比对逻辑由 D 批钩子实现，此处验证数据面）\n\t\tconst lastSeen = 0;\n\t\texpect(after.ok && after.revision !== lastSeen).toBe(true);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── builtin 纠正路由（S2-08）：correctMemory 单步而非两步写新忘旧 ────────\n\ndescribe(\"builtin 纠正数据面\", () => {\n\tit(\"correctMemory 单步修订：新结论为当前版本，旧结论进历史+supersedes\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store);\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: SCOPE,\n\t\t\tconclusion: \"旧：用 Mongo\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) return;\n\n\t\t// builtin 纠正 = correctMemory 单步（runBuiltinMemoryCommand 内部即此调用）\n\t\tconst corrected = await service.correctMemory({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\treplacement: { conclusion: \"新：用 SQLite\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\tsource: { sessionId: \"sess-1\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(corrected.ok).toBe(true);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新：用 SQLite\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t// 同一 memoryId 下修订前进，不是「写新记忆+忘旧记忆」两步——ID 不变\n\t\t\texpect(got.memory.id).toBe(created.id);\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：提交语义修订（F04 确认升级/语义冲突、F11 重议保来源）─────────────\n\ndescribe(\"O02 提交语义\", () => {\n\tit(\"F04 确认升级：tentative + 同结论同条件候选 confirmed → corrected 修订，来源并集\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\t// 既有记忆：tentative + 同归一结论 + 同条件/理由\n\t\tconst c1 = candidate({\n\t\t\tsourceId: s1.sourceId,\n\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\tconfirmation: \"tentative\",\n\t\t});\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [c1],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\t// 新来源的同结论同条件候选 confirmation=confirmed → 确认升级走 correctMemory\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-confirm\", capturedAt: AT2 });\n\t\tconst createSpy = vi.spyOn(service, \"createMemory\");\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [\n\t\t\t\tcandidate({\n\t\t\t\t\tsourceId: s2.sourceId,\n\t\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"corrected\", memoryId, revision: 2 });\n\t\texpect(second.corrected).toBe(1);\n\t\texpect(createSpy).not.toHaveBeenCalled();\n\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t// 旧来源 + 本次触发来源都在当前修订 sourceIds 内（O02 并集口径）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F04 理由变化：同结论同条件 rationale 不同 → skipped/semantic_conflict 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-rationale\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, rationale: \"换了个理由\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({\n\t\t\tstatus: \"skipped\",\n\t\t\treason: \"semantic_conflict\",\n\t\t\tmemoryId,\n\t\t});\n\t\texpect(second.skipped).toBe(1);\n\t\texpect(second.submitted).toBe(0);\n\t\t// 记忆本体未被改写（不替用户裁语义）\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t\texpect(got.memory.content.rationale).toBe(\"旧理由\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F11 重议保来源：同结论异条件 → flagged 新修订同时含旧来源与触发来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst first = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j1\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s1.sourceId })],\n\t\t\tsourceRefs: [s1.ref],\n\t\t\trelatedMemories: [],\n\t\t\tnow: AT,\n\t\t});\n\t\tconst memoryId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-new-cond\", capturedAt: AT2 });\n\t\tconst second = await commitExtractionCandidates(store, service, {\n\t\t\tjobId: \"j2\",\n\t\t\tscope: SCOPE,\n\t\t\tcandidates: [candidate({ sourceId: s2.sourceId, conditions: \"条件已变\" })],\n\t\t\tsourceRefs: [s2.ref],\n\t\t\trelatedMemories: [await relatedSnapshot(service, memoryId)],\n\t\t\tnow: AT2,\n\t\t});\n\t\texpect(second.outcomes[0]).toMatchObject({ status: \"flagged\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId, includeHistory: true });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBe(true);\n\t\t\t// 标记修订来源 = 本次触发来源 ∪ 旧修订来源（旧决定的原始依据不丢）\n\t\t\texpect(got.revisions?.[1]?.sourceIds).toEqual([s1.sourceId, s2.sourceId].sort());\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── O02：明确纠正进同一入口（F03 工具 correct_id、F09 CLI 保字段保来源）──\n\ndescribe(\"O02 纠正入口\", () => {\n\tit(\"F03 工具纠正：pao_memory_write 带 correct_id → 同一 ID 新修订，字段沿用\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"背景：旧决定带条件与理由。\"));\n\t\tconst assistant = assistantMsg(\"写入纠正\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"correct\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\ttry {\n\t\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\t\tconst created = await registration.service.createMemory({\n\t\t\t\tkind: \"decision\",\n\t\t\t\tscope: { projectId: \"proj-tool\", sessionId },\n\t\t\t\tconclusion: \"旧结论\",\n\t\t\t\tconditions: \"原条件\",\n\t\t\t\trationale: \"原理由\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tcreatedBy: \"user\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tif (!created.ok) throw new Error(created.error.message);\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\");\n\t\t\tconst corrected = await writeTool!.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"新结论\", correct_id: created.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst got = await registration.service.getMemory({ id: created.id, includeHistory: true });\n\t\t\tif (got.ok) {\n\t\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t\texpect(got.revisions).toHaveLength(2);\n\t\t\t\t// 新修订来源 = 工具调用来源 ∪ 旧来源\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds).toContain(s.sourceId);\n\t\t\t\texpect(got.revisions?.[1]?.sourceIds.length).toBe(2);\n\t\t\t}\n\t\t\t// 同一 ID 修订,未新建第二条记忆\n\t\t\tconst all = store.db.prepare(\"SELECT COUNT(*) AS count FROM memories\").get() as { count: number };\n\t\t\texpect(all.count).toBe(1);\n\t\t\tstore.close();\n\t\t} finally {\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 工具写入降级：pao_memory_write 无 correct_id → model_inference/tentative；带 correct_id → 同口径降级\", async () => {\n\t\tconst home = tempHome();\n\t\tconst tools = new Map<string, ToolDefinition>();\n\t\tconst pi = {\n\t\t\tregisterTool(tool: ToolDefinition) {\n\t\t\t\ttools.set(tool.name, tool);\n\t\t\t},\n\t\t\ton() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t\tregisterCommand() {\n\t\t\t\treturn () => undefined;\n\t\t\t},\n\t\t};\n\t\tconst sessionId = \"sess-tool-downgrade\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tmanager.appendMessage(userMsg(\"比较数据库方案，尚未定。\"));\n\t\tconst assistant = assistantMsg(\"我推测用 SQLite\");\n\t\t(assistant as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-new\", name: \"pao_memory_write\", arguments: { content: \"推测\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant);\n\t\tconst assistant2 = assistantMsg(\"纠正既有条目\");\n\t\t(assistant2 as Record<string, unknown>).content = [\n\t\t\t{ type: \"toolCall\", id: \"call-correct\", name: \"pao_memory_write\", arguments: { content: \"纠正\" } },\n\t\t];\n\t\tmanager.appendMessage(assistant2);\n\t\tconst ctx = { cwd: home, sessionManager: manager, modelRegistry: { find: () => undefined } };\n\t\tconst registration = registerBuiltinMemory(pi as never, { paoHome: home });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\ttry {\n\t\t\t// 无 correct_id：新建 → toolcall 来源不顶替用户确认。\n\t\t\tconst writeTool = tools.get(\"pao_memory_write\")!;\n\t\t\tconst written = await writeTool.execute(\n\t\t\t\t\"call-new\",\n\t\t\t\t{ content: \"我推测使用 SQLite 更适合\" } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(written.isError).not.toBe(true);\n\t\t\tconst createdRow = store.db\n\t\t\t\t.prepare(\"SELECT id FROM memories ORDER BY created_at DESC LIMIT 1\")\n\t\t\t\t.get() as { id: string } | undefined;\n\t\t\texpect(createdRow).toBeDefined();\n\t\t\tconst created = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(created.ok).toBe(true);\n\t\t\tif (created.ok) {\n\t\t\t\texpect(created.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(created.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\n\t\t\t// 带 correct_id：修订同一 ID，确认同样降级为 model_inference/tentative。\n\t\t\tconst corrected = await writeTool.execute(\n\t\t\t\t\"call-correct\",\n\t\t\t\t{ content: \"更正后的推测\", correct_id: createdRow!.id, expected_revision: 1 } as never,\n\t\t\t\tundefined,\n\t\t\t\tundefined,\n\t\t\t\tctx as never,\n\t\t\t);\n\t\t\texpect(corrected.isError).not.toBe(true);\n\t\t\tconst after = await registration.service.getMemory({ id: createdRow!.id });\n\t\t\texpect(after.ok).toBe(true);\n\t\t\tif (after.ok) {\n\t\t\t\texpect(after.memory.currentRevision).toBe(2);\n\t\t\t\texpect(after.memory.content.conclusion).toBe(\"更正后的推测\");\n\t\t\t\texpect(after.memory.content.evidenceKind).toBe(\"model_inference\");\n\t\t\t\texpect(after.memory.content.confirmation).toBe(\"tentative\");\n\t\t\t}\n\t\t} finally {\n\t\t\tstore.close();\n\t\t\tawait registration.close();\n\t\t}\n\t});\n\n\tit(\"I02 用户通道不受影响：/pao memory correct 仍落 confirmed/user_statement\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-confirm\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli-confirm\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record([{ 内容: \"旧结论\", 记忆ID: created.id, 修订号: 1, 来源: \"内置记忆库\" }], BUILTIN_PROVIDER);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.evidenceKind).toBe(\"user_statement\");\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F09 CLI 纠正：带条件/理由的条目经 /pao memory correct → 新修订保留字段,来源含操作归档+旧来源\", async () => {\n\t\tconst home = tempHome();\n\t\tconst sessionId = \"sess-cli-correct\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s = seedSource(store, { sessionId, entryId: \"e-origin\" });\n\t\tconst created = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: \"proj-cli\", sessionId },\n\t\t\tconclusion: \"旧结论\",\n\t\t\tconditions: \"原条件\",\n\t\t\trationale: \"原理由\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s.sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst pi = { appendEntry: vi.fn() } as unknown as ExtensionAPI;\n\t\tbindBuiltinMemoryService(pi, () => service);\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tconst state = sessionMemory(pi);\n\t\tstate.record(\n\t\t\t[\n\t\t\t\t{\n\t\t\t\t\t内容: \"旧结论\",\n\t\t\t\t\t记忆ID: created.id,\n\t\t\t\t\t修订号: 1,\n\t\t\t\t\t来源: \"内置记忆库\",\n\t\t\t\t},\n\t\t\t],\n\t\t\tBUILTIN_PROVIDER,\n\t\t);\n\t\tconst ctx = {\n\t\t\thasUI: true,\n\t\t\tcwd: home,\n\t\t\tsessionManager: manager,\n\t\t\tui: { confirm: vi.fn(async () => true), notify: vi.fn() },\n\t\t};\n\t\tawait listPaoSubcommands(pi)\n\t\t\t.find((item) => item.name === \"memory\")\n\t\t\t?.run(pi, \"correct 1 新结论\", ctx as never);\n\n\t\tconst got = await service.getMemory({ id: created.id, includeHistory: true });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.conclusion).toBe(\"新结论\");\n\t\t\t// 未编辑字段沿用旧值——纠正不清空条件/理由\n\t\t\texpect(got.memory.content.conditions).toBe(\"原条件\");\n\t\t\texpect(got.memory.content.rationale).toBe(\"原理由\");\n\t\t\t// 新修订来源 = 归档操作来源 ∪ 旧来源；归档来源可回读到 memoryCorrect 操作正文\n\t\t\tconst newSourceIds = got.revisions?.[1]?.sourceIds ?? [];\n\t\t\texpect(newSourceIds).toContain(s.sourceId);\n\t\t\texpect(newSourceIds.length).toBe(2);\n\t\t\tconst archivedId = newSourceIds.find((id) => id !== s.sourceId)!;\n\t\t\tconst archived = await service.readMemorySource({ sourceId: archivedId });\n\t\t\texpect(archived.ok).toBe(true);\n\t\t\tif (archived.ok) {\n\t\t\t\texpect(archived.content).toContain(\"memoryCorrect\");\n\t\t\t\texpect(archived.content).toContain(created.id);\n\t\t\t}\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\trecoverJobs,\n} from \"../../src/pao/memory/extraction-jobs.ts\";\nimport { readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { registerExtractionScheduler } from \"../../src/pao/memory/extraction-scheduler.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,114]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[114,205]}}},{"diffOp":{"delete":{"range":[205,217]}}},{"diffOp":{"equal":{"range":[217,419]}}},{"equalLines":{"line_count":950}},{"diffOp":{"equal":{"range":[419,428]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-extraction-scheduler.test.ts"},"span":[612,623],"sourceCode":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage } from \"@pao/ai\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { createCapture } from \"../../src/pao/memory/capture.ts\";\nimport {\n\tadvanceCursor,\n\tclaimJob,\n\tcreateJob,\n\tfailJob,\n\tMAX_ATTEMPTS,\n\trecoverJobs,\n} from \"../../src/pao/memory/extraction-jobs.ts\";\nimport { readSegmentLines, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { registerExtractionScheduler } from \"../../src/pao/memory/extraction-scheduler.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type {\n\tExtractModelInput,\n\tExtractModelOutput,\n\tMemoryScope,\n\tRelatedMemorySummary,\n} from \"../../src/pao/memory/types.ts\";\n\nconst requestState = vi.hoisted(() => ({\n\thandle: undefined as ((deps: unknown, input: ExtractModelInput) => Promise<ExtractModelOutput>) | undefined,\n}));\n\nvi.mock(\"../../src/pao/memory/extract-model.ts\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"../../src/pao/memory/extract-model.ts\")>();\n\treturn {\n\t\t...actual,\n\t\trequestExtraction: (deps: unknown, input: ExtractModelInput) => {\n\t\t\tif (requestState.handle === undefined) throw new Error(\"测试未安装提炼响应\");\n\t\t\treturn requestState.handle(deps, input);\n\t\t},\n\t};\n});\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-09T10:00:00.000Z\";\nconst AT2 = \"2026-11-09T10:01:00.000Z\";\nconst AT3 = \"2026-11-09T10:02:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-scheduler-stale\" };\n\nafterEach(() => {\n\trequestState.handle = undefined;\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite/WAL handles may still be closing on Windows.\n\t\t}\n\t}\n});\n\nasync function waitFor(check: () => boolean): Promise<void> {\n\tfor (let attempt = 0; attempt < 100; attempt++) {\n\t\tif (check()) return;\n\t\tawait new Promise((resolve) => setTimeout(resolve, 10));\n\t}\n\tthrow new Error(\"等待 scheduler 收尾超时\");\n}\n\ndescribe(\"extraction scheduler\", () => {\n\tit(\"stale 候选保留 failed 与 cursor，其他候选正常提交且 recovery 不自动重放\", async () => {\n\t\tconst home = mkdtempSync(join(tmpdir(), \"pao-mem-scheduler-\"));\n\t\ttempDirs.push(home);\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sessionId = \"sess-scheduler-stale\";\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst assistantEntryId = manager.appendMessage(\n\t\t\tfauxAssistantMessage(\"目前缺省 top3。\", { timestamp: Date.parse(AT) }),\n\t\t);\n\t\tconst userEntryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"改成 top5。\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst independentEntryId = manager.appendMessage({\n\t\t\trole: \"user\",\n\t\t\tcontent: \"侧边栏宽度固定为 320px。\",\n\t\t\ttimestamp: Date.parse(AT),\n\t\t});\n\t\tconst capture = createCapture({\n\t\t\tstore,\n\t\t\tpaoHome: home,\n\t\t\tnow: () => AT,\n\t\t\tresolveSessionProject: () => SCOPE.projectId,\n\t\t});\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst assistantSourceId = capture.captureCommittedEntry(\n\t\t\tsessionId,\n\t\t\tmanager.getEntry(assistantEntryId)!,\n\t\t\tundefined,\n\t\t\tAT,\n\t\t).sourceId!;\n\t\tconst userSourceId = capture.captureCommittedEntry(sessionId, manager.getEntry(userEntryId)!, undefined, AT)\n\t\t\t.sourceId!;\n\t\tconst independentSourceId = capture.captureCommittedEntry(\n\t\t\tsessionId,\n\t\t\tmanager.getEntry(independentEntryId)!,\n\t\t\tundefined,\n\t\t\tAT,\n\t\t).sourceId!;\n\t\tconst sourceIds = [assistantSourceId, userSourceId];\n\t\tconst old = await service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...SCOPE, sessionId },\n\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds,\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!old.ok) throw new Error(old.error.message);\n\t\tconst existingJob = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId, projectId: SCOPE.projectId }),\n\t\t\tscopeKey: `session:${sessionId}`,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tadvanceCursor(store, {\n\t\t\tjobId: existingJob.jobId,\n\t\t\tcursor: \"cursor-before-stale-batch\",\n\t\t\tadvancedAt: AT,\n\t\t});\n\n\t\tlet requestSnapshot: RelatedMemorySummary[] | undefined;\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\trequestCount += 1;\n\t\t\trequestSnapshot = input.relatedMemories;\n\t\t\tconst corrected = await service.correctMemory({\n\t\t\t\tid: old.id,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: \"自动召回每轮 top3\",\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t},\n\t\t\t\tsource: { sessionId },\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tif (!corrected.ok) throw new Error(corrected.error.message);\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"自动召回每轮取条数由缺省 top3 改为 top5。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds,\n\t\t\t\t\t\tquotedSpans: [\n\t\t\t\t\t\t\t{ sourceId: assistantSourceId, text: \"缺省 top3\" },\n\t\t\t\t\t\t\t{ sourceId: userSourceId, text: \"改成 top5\" },\n\t\t\t\t\t\t],\n\t\t\t\t\t\tspanLocations: [\n\t\t\t\t\t\t\t{ sourceId: assistantSourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t\t{ sourceId: userSourceId, match: \"exact\", offset: 0 },\n\t\t\t\t\t\t],\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"侧边栏宽度固定为 320px。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [independentSourceId],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: independentSourceId, text: \"320px\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: independentSourceId, match: \"exact\", offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-scheduler-stale\",\n\t\t\t};\n\t\t};\n\n\t\tconst handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();\n\t\tconst pi = {\n\t\t\ton(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {\n\t\t\t\thandlers.set(event, handler);\n\t\t\t\treturn () => handlers.delete(event);\n\t\t\t},\n\t\t} as unknown as ExtensionAPI;\n\t\tconst unmount = registerExtractionScheduler(pi, {\n\t\t\tstore,\n\t\t\tservice,\n\t\t\tpaoHome: home,\n\t\t\tledger: {\n\t\t\t\tappendUsage: vi.fn(),\n\t\t\t\tappendCustomEntry: vi.fn(),\n\t\t\t} as never,\n\t\t\tresolveScope: () => ({ ...SCOPE, sessionId }),\n\t\t\tnow: () => AT,\n\t\t});\n\t\tconst ctx = {\n\t\t\tsessionManager: manager,\n\t\t\tcwd: home,\n\t\t\tmodelRegistry: {},\n\t\t} as unknown as ExtensionContext;\n\n\t\ttry {\n\t\t\tawait handlers.get(\"turn_end\")?.({}, ctx);\n\t\t\tawait handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, ctx);\n\t\t\tawait waitFor(() => {\n\t\t\t\tconst row = store.db\n\t\t\t\t\t.prepare(\"SELECT status FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t\t.get(`session:${sessionId}`) as { status: string } | undefined;\n\t\t\t\treturn row?.status === \"failed\";\n\t\t\t});\n\n\t\t\texpect(requestSnapshot).toEqual([\n\t\t\t\texpect.objectContaining({\n\t\t\t\t\tmemoryId: old.id,\n\t\t\t\t\tcurrentRevision: 1,\n\t\t\t\t\tconclusion: \"自动召回每轮的取条数由缺省 top3 改为 top5。\",\n\t\t\t\t}),\n\t\t\t]);\n\t\t\tconst job = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT status, cursor, attempt_count, last_error\n\t\t\t\t\t FROM extraction_jobs WHERE scope_key = ?`,\n\t\t\t\t)\n\t\t\t\t.get(`session:${sessionId}`) as {\n\t\t\t\tstatus: string;\n\t\t\t\tcursor: string | null;\n\t\t\t\tattempt_count: number;\n\t\t\t\tlast_error: string | null;\n\t\t\t};\n\t\t\texpect(job).toMatchObject({\n\t\t\t\tstatus: \"failed\",\n\t\t\t\tcursor: \"cursor-before-stale-batch\",\n\t\t\t\tattempt_count: 1,\n\t\t\t});\n\t\t\texpect(job.last_error).toContain(\"stale_request_snapshot:\");\n\t\t\texpect(job.last_error).toContain(`${old.id}@rev1`);\n\t\t\texpect(job.last_error).toContain(\"已提交候选=1\");\n\n\t\t\tconst recovered = recoverJobs(store, AT2);\n\t\t\texpect(recovered.recovered).toEqual([]);\n\t\t\tconst stillFailed = store.db\n\t\t\t\t.prepare(\"SELECT status FROM extraction_jobs WHERE job_id = ?\")\n\t\t\t\t.get(existingJob.jobId) as { status: string };\n\t\t\texpect(stillFailed.status).toBe(\"failed\");\n\t\t\texpect(requestCount).toBe(1);\n\n\t\t\tconst activeRows = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.id, m.current_revision, r.content_json\n\t\t\t\t\t FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t\t WHERE m.usage_state = 'active'\n\t\t\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?`,\n\t\t\t\t)\n\t\t\t\t.all(SCOPE.projectId) as Array<{ id: string; current_revision: number; content_json: string }>;\n\t\t\texpect(activeRows).toHaveLength(2);\n\t\t\tconst corrected = activeRows.find((row) => row.id === old.id);\n\t\t\texpect(corrected!.current_revision).toBe(2);\n\t\t\texpect(JSON.parse(corrected!.content_json).conclusion).toBe(\"自动召回每轮 top3\");\n\t\t\texpect(\n\t\t\t\tactiveRows.filter((row) => JSON.parse(row.content_json).conclusion === \"侧边栏宽度固定为 320px。\"),\n\t\t\t).toHaveLength(1);\n\t\t} finally {\n\t\t\tunmount();\n\t\t\tawait service.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\t// ════════════════════════════════════════════════════════════════════\n\t// O03 定向用例：跨会话续作 / 重试预算 / 读失败游标 / 停用不复活 / 忙不新领\n\t// ════════════════════════════════════════════════════════════════════\n\n\tinterface SchedulerFixture {\n\t\thome: string;\n\t\tstore: ReturnType<typeof openMemoryStore>;\n\t\tservice: ReturnType<typeof openMemoryService>;\n\t\tmanager: SessionManager;\n\t\tcapture: ReturnType<typeof createCapture>;\n\t\thandlers: Map<string, (event: unknown, ctx: ExtensionContext) => unknown>;\n\t\tctx: ExtensionContext;\n\t\tunmount: () => void;\n\t\tsessionId: string;\n\t}\n\n\t/** 装配一个会话 + 调度器（ledger 用空实现；ctx 只带调度器用到的字段）。 */\n\tasync function schedulerFixture(\n\t\tsessionId: string,\n\t\tscope: MemoryScope,\n\t\topts: {\n\t\t\thome?: string;\n\t\t\tstore?: ReturnType<typeof openMemoryStore>;\n\t\t\tservice?: ReturnType<typeof openMemoryService>;\n\t\t\treadSegment?: (\n\t\t\t\tsegment: { segmentId: string },\n\t\t\t) => Promise<{ lines: string[]; archived: boolean } | undefined>;\n\t\t} = {},\n\t): Promise<SchedulerFixture> {\n\t\tconst home = opts.home ?? mkdtempSync(join(tmpdir(), \"pao-mem-scheduler-\"));\n\t\ttempDirs.push(home);\n\t\tconst store = opts.store ?? openMemoryStore(home, \"readwrite\");\n\t\tconst service = opts.service ?? openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst manager = SessionManager.create(home, join(home, \"agent\", \"sessions\"), { id: sessionId });\n\t\tconst capture = createCapture({\n\t\t\tstore,\n\t\t\tpaoHome: home,\n\t\t\tnow: () => AT,\n\t\t\tresolveSessionProject: () => scope.projectId,\n\t\t});\n\t\tcapture.registerSession(sessionId, manager.getSessionFile()!);\n\t\tconst handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();\n\t\tconst pi = {\n\t\t\ton(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {\n\t\t\t\thandlers.set(event, handler);\n\t\t\t\treturn () => handlers.delete(event);\n\t\t\t},\n\t\t} as unknown as ExtensionAPI;\n\t\tconst unmount = registerExtractionScheduler(pi, {\n\t\t\tstore,\n\t\t\tservice,\n\t\t\tpaoHome: home,\n\t\t\tledger: { appendUsage: vi.fn(), appendCustomEntry: vi.fn() } as never,\n\t\t\tresolveScope: () => scope,\n\t\t\t...(opts.readSegment === undefined ? {} : { readSegment: opts.readSegment }),\n\t\t\tnow: () => AT,\n\t\t});\n\t\tconst ctx = { sessionManager: manager, cwd: home, modelRegistry: {} } as unknown as ExtensionContext;\n\t\treturn { home, store, service, manager, capture, handlers, ctx, unmount, sessionId };\n\t}\n\n\tfunction appendUserSource(fx: SchedulerFixture, text: string, sessionId = fx.sessionId, at = AT): string {\n\t\tconst entryId = fx.manager.appendMessage({ role: \"user\", content: text, timestamp: Date.parse(at) });\n\t\tconst captured = fx.capture.captureCommittedEntry(sessionId, fx.manager.getEntry(entryId)!, undefined, at);\n\t\treturn captured.sourceId!;\n\t}\n\n\tfunction jobRow(store: ReturnType<typeof openMemoryStore>, scopeKey: string) {\n\t\treturn store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT job_id, status, cursor, attempt_count, consecutive_failures, last_error\n\t\t\t\t FROM extraction_jobs WHERE scope_key = ?`,\n\t\t\t)\n\t\t\t.get(scopeKey) as\n\t\t\t| { job_id: string; status: string; cursor: string | null; attempt_count: number; consecutive_failures: number; last_error: string | null }\n\t\t\t| undefined;\n\t}\n\n\tit(\"O03/F06：A 会话退出后，B 会话的调度器捞起库内 pending job 并按 A 的身份续作\", async () => {\n\t\t// 会话 A：建库留 1 条用户来源 + 1 个 pending job（A 随后「退出」=不再装配）。\n\t\tconst scopeA: MemoryScope = { projectId: \"proj-a\", sessionId: \"sess-a\" };\n\t\tconst fxA = await schedulerFixture(\"sess-a\", scopeA);\n\t\tconst sourceA = appendUserSource(fxA, \"构建命令固定为 pnpm build。\");\n\t\tcreateJob(fxA.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-a\", projectId: \"proj-a\" }),\n\t\t\tscopeKey: \"session:sess-a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// A 的调度器不触发任何 drain——模拟 A 直接退出（保留库内 pending）。\n\t\tfxA.unmount();\n\n\t\t// 会话 B：同一 PAO_HOME、不同 SessionManager/scope——B 不该拿自己的身份做 A 的 job。\n\t\tconst scopeB: MemoryScope = { projectId: \"proj-b\", sessionId: \"sess-b\" };\n\t\tconst fxB = await schedulerFixture(\"sess-b\", scopeB, {\n\t\t\thome: fxA.home,\n\t\t\tstore: fxA.store,\n\t\t\tservice: fxA.service,\n\t\t});\n\t\tlet requestCount = 0;\n\t\tlet requestSourceSession: string | undefined;\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\trequestCount += 1;\n\t\t\trequestSourceSession = input.sourceSessionId;\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [sourceA],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: sourceA, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: sourceA, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-continuation\",\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fxB.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fxB.ctx);\n\t\t\tawait waitFor(() => jobRow(fxB.store, \"session:sess-a\")?.status === \"done\");\n\n\t\t\texpect(requestCount).toBe(1);\n\t\t\t// 提炼请求的归属会话是 job 自带的 A，不是消费方 B。\n\t\t\texpect(requestSourceSession).toBe(\"sess-a\");\n\t\t\t// 记忆落 A 的 scope（projectId=proj-a、sessionId=sess-a），不借 B 的身份。\n\t\t\tconst memory = fxB.store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.scope_json FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t\t WHERE json_extract(r.content_json, '$.conclusion') = ?`,\n\t\t\t\t)\n\t\t\t\t.get(\"构建命令固定为 pnpm build。\") as { scope_json: string } | undefined;\n\t\t\texpect(memory).toBeDefined();\n\t\t\tconst scope = JSON.parse(memory!.scope_json) as { projectId: string; sessionId?: string };\n\t\t\texpect(scope.projectId).toBe(\"proj-a\");\n\t\t\texpect(scope.sessionId).toBe(\"sess-a\");\n\t\t} finally {\n\t\t\tfxB.unmount();\n\t\t\tawait fxB.service.close();\n\t\t\tfxB.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F07：连续失败按未提交批次计——成功批次清零 consecutive_failures，临时失败可恢复\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f07\", sessionId: \"sess-f07\" };\n\t\tconst fx = await schedulerFixture(\"sess-f07\", scope);\n\t\tconst store = fx.store;\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-f07\", projectId: \"proj-f07\" }),\n\t\t\tscopeKey: \"session:sess-f07\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 三次连续失败（未提交批次）：consecutive_failures 到上限 → 终态不恢复。\n\t\tfor (let i = 0; i < MAX_ATTEMPTS; i++) {\n\t\t\tclaimJob(store, { jobId: job.jobId, ownerProcess: `pid-${process.pid}`, claimedAt: AT });\n\t\t\tfailJob(store, { jobId: job.jobId, reason: `第${i + 1}次失败`, failedAt: AT });\n\t\t\tif (i < MAX_ATTEMPTS - 1) recoverJobs(store, AT);\n\t\t}\n\t\texpect(recoverJobs(store, AT2).recovered).toHaveLength(0);\n\t\tconst afterMax = jobRow(store, \"session:sess-f07\")!;\n\t\texpect(afterMax.status).toBe(\"failed\");\n\t\texpect(afterMax.consecutive_failures).toBe(MAX_ATTEMPTS);\n\n\t\t// 模拟「失败之间有成功批次」：advanceCursor（已提交批次边界）清零连续失败，\n\t\t// 此后一次临时失败不应触终态——这正是 attempt_count 口径会误杀的场景。\n\t\tstore.db\n\t\t\t.prepare(\"UPDATE extraction_jobs SET status='running', consecutive_failures=2 WHERE job_id=?\")\n\t\t\t.run(job.jobId);\n\t\tadvanceCursor(store, { jobId: job.jobId, cursor: \"src-batch-committed\", advancedAt: AT2 });\n\t\tconst reset = jobRow(store, \"session:sess-f07\")!;\n\t\texpect(reset.consecutive_failures).toBe(0);\n\t\tfailJob(store, { jobId: job.jobId, reason: \"临时失败\", failedAt: AT2 });\n\t\t// consecutive_failures=1 < 上限：recoverJobs 恢复为 pending。\n\t\tconst recovered = recoverJobs(store, AT3);\n\t\texpect(recovered.recovered.map((r) => r.jobId)).toContain(job.jobId);\n\t\tfx.unmount();\n\t\tawait fx.service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"O03/F13：批内中间来源读取失败 → 游标停在失败批前，恢复后不重跑已提交候选\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f13\", sessionId: \"sess-f13\" };\n\t\tconst fx = await schedulerFixture(\"sess-f13\", scope);\n\t\t// captured_at 递增保证来源顺序（同刻回退 source_id 排序不可控）。\n\t\tconst s1 = appendUserSource(fx, \"第一条：保留窗口一。\", fx.sessionId, AT);\n\t\tconst s2 = appendUserSource(fx, \"第二条：保留窗口二。\", fx.sessionId, AT2);\n\t\tconst s3 = appendUserSource(fx, \"第三条：保留窗口三。\", fx.sessionId, AT3);\n\t\t// 末尾再挂一条全排除批：task-c 的 s4 记进 source_exclusions——\n\t\t// 整批被排除时游标应照常推进（确定状态，不发请求）。\n\t\tconst s4 = appendUserSource(fx, \"第四条：已被删除排除。\", fx.sessionId, \"2026-11-09T10:03:00.000Z\");\n\t\tfx.store.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO source_exclusions (exclusion_id, source_id, session_id, entry_id, reason, created_at)\n\t\t\t\t VALUES (?, ?, ?, NULL, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"exc-f13\", s4, \"sess-f13\", \"memory 删除:mem-x\", AT3);\n\t\t// 把来源切成三批：s1 归 task-a，s2/s3 归 task-b，s4 归 task-c——\n\t\t// 批1提交后批2读失败；恢复后批2续跑、批3全排除只推游标。\n\t\tfx.store.db.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-a' WHERE source_id=?\").run(s1);\n\t\tfx.store.db\n\t\t\t.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-b' WHERE source_id IN (?, ?)\")\n\t\t\t.run(s2, s3);\n\t\tfx.store.db.prepare(\"UPDATE sources SET project_id='proj-f13', task_id='task-c' WHERE source_id=?\").run(s4);\n\n\t\t// 让 s2 回读失败：来源行的段引用指向不存在的段——readSourceEvents 如实\n\t\t// 返回 source_missing（同会话三个来源共用同一段文件，动文件会误伤 s1/s3）。\n\t\tconst s2Segment = (fx.store.db\n\t\t\t.prepare(\"SELECT segment_id FROM sources WHERE source_id=?\")\n\t\t\t.get(s2) as { segment_id: string }).segment_id;\n\t\tfx.store.db.prepare(\"UPDATE sources SET segment_id='seg-gone' WHERE source_id=?\").run(s2);\n\n\t\tconst seenBatches: string[][] = [];\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\tseenBatches.push(input.entries.map((e) => e.sourceId));\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"experience\",\n\t\t\t\t\t\tconclusion: `经验-${input.entries[0]!.sourceId}`,\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [input.entries[0]!.sourceId],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: input.entries[0]!.sourceId, text: input.entries[0]!.content.slice(0, 10) }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: input.entries[0]!.sourceId, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-${seenBatches.length}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\t// s1 先提交（批1）→ s2 读失败（批2）→ failJob，游标停在 s1（失败批前）。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f13\")?.status === \"failed\");\n\n\t\t\tconst failed = jobRow(fx.store, \"session:sess-f13\")!;\n\t\t\texpect(failed.cursor).toBe(s1);\n\t\t\texpect(failed.last_error).toContain(\"来源读取失败\");\n\t\t\texpect(failed.last_error).toContain(s2);\n\t\t\texpect(seenBatches).toEqual([[s1]]); // 只请求过批1\n\n\t\t\t// 恢复 s2 段引用 → 下轮从 s2 续，不重跑 s1（不重复提交）。\n\t\t\tfx.store.db.prepare(\"UPDATE sources SET segment_id=? WHERE source_id=?\").run(s2Segment, s2);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f13\")?.status === \"done\");\n\t\t\t// 批2 续跑 s2/s3；批3（s4）整批排除不发请求，游标仍推进到 s4 → job done。\n\t\t\texpect(seenBatches).toEqual([[s1], [s2, s3]]);\n\t\t\texpect(jobRow(fx.store, \"session:sess-f13\")!.cursor).toBe(s4);\n\t\t\tconst memoryCount = fx.store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS c FROM memories\")\n\t\t\t\t.get() as { c: number };\n\t\t\texpect(memoryCount.c).toBe(2); // s1 一条 + s2/s3 批一条，s1 未重复。\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F05：同来源候选不复活已停用记忆；全新来源同结论可正常新建\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-f05\", sessionId: \"sess-f05\" };\n\t\tconst fx = await schedulerFixture(\"sess-f05\", scope);\n\t\tconst s1 = appendUserSource(fx, \"构建命令固定为 pnpm build。\");\n\t\tconst created = await fx.service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...scope },\n\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\t// 用户明确停用该记忆（rev2 继承来源链接）。\n\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-f05\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\tif (!stopped.ok) throw new Error(stopped.error.message);\n\n\t\trequestState.handle = async (_deps, _input) => ({\n\t\t\tcandidates: [\n\t\t\t\t{\n\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\tsourceIds: [s1],\n\t\t\t\t\tquotedSpans: [{ sourceId: s1, text: \"pnpm build\" }],\n\t\t\t\t\tspanLocations: [{ sourceId: s1, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t},\n\t\t\t],\n\t\t\trejected: [],\n\t\t\trequestId: \"req-f05\",\n\t\t});\n\n\t\ttry {\n\t\t\t// 同来源重放：候选命中 stopped 记忆 → source_resting_stopped → 需重评，不新建。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f05\")?.status === \"failed\");\n\t\t\tconst failed = jobRow(fx.store, \"session:sess-f05\")!;\n\t\t\t// source_resting_stopped 与语义冲突同口径：记需重评前缀 + stopped=<memoryId>，\n\t\t\t// 游标不推进（last_error 前缀即「不自动重放」的 needs-reevaluation 标记）。\n\t\t\texpect(failed.last_error).toContain(\"stale_request_snapshot:\");\n\t\t\texpect(failed.last_error).toContain(`stopped=${created.id}`);\n\t\t\tconst activeCount = fx.store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS c FROM memories WHERE usage_state='active'\")\n\t\t\t\t.get() as { c: number };\n\t\t\texpect(activeCount.c).toBe(0); // 没有复活出 active 副本\n\n\t\t\t// 全新来源同结论：不在 stopped 记忆的 source_links 里 → 正常新建。\n\t\t\t// captured_at 用更晚的 AT3：来源表按 (captured_at, source_id) 排序——\n\t\t\t// 同刻时 sourceId 是 uuid 无序，晚到的「新来源」须排在尝试边界之后。\n\t\t\tconst s2 = appendUserSource(fx, \"再确认一次：构建命令固定为 pnpm build。\", fx.sessionId, AT3);\n\t\t\trequestState.handle = async (_deps, _input) => ({\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。（复核）\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [s2],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: s2, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: s2, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-f05b\",\n\t\t\t});\n\t\t\t// 真实事件链：turn_end 登记新来源 → settled → failed job 检出\n\t\t\t// 上次尝试边界之后的新来源 → reopenFailedJobForNewSources 重开续跑（O03/I01）。\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-f05\")?.status === \"done\");\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT m.usage_state FROM memories m\n\t\t\t\t\t JOIN memory_revisions r ON r.memory_id=m.id AND r.revision=m.current_revision\n\t\t\t\t\t WHERE json_extract(r.content_json,'$.conclusion') LIKE '%pnpm build%'`,\n\t\t\t\t)\n\t\t\t\t.all() as Array<{ usage_state: string }>;\n\t\t\texpect(rows.filter((r) => r.usage_state === \"active\")).toHaveLength(1);\n\t\t\texpect(rows.filter((r) => r.usage_state === \"stopped\")).toHaveLength(1);\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/F03：本进程前台忙（agent_start 未 settled）时 drain 不新领后台 job\", async () => {\n\t\t// 两个会话各留一个 pending job；处理第一个时在请求里触发 agent_start——\n\t\t// busy 置位后，drain 的 per-target 检查应让第二个 job 留在 pending。\n\t\tconst scope1: MemoryScope = { projectId: \"proj-busy\", sessionId: \"sess-busy-1\" };\n\t\tconst fx1 = await schedulerFixture(\"sess-busy-1\", scope1);\n\t\tappendUserSource(fx1, \"会话一的决定。\");\n\t\tcreateJob(fx1.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-busy-1\", projectId: \"proj-busy\" }),\n\t\t\tscopeKey: \"session:sess-busy-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\t// 会话二的 job 也由同一调度器捞起（跨会话 pending 扫描）。\n\t\tconst manager2 = SessionManager.create(fx1.home, join(fx1.home, \"agent\", \"sessions\"), { id: \"sess-busy-2\" });\n\t\tfx1.capture.registerSession(\"sess-busy-2\", manager2.getSessionFile()!);\n\t\tconst e2 = manager2.appendMessage({ role: \"user\", content: \"会话二的决定。\", timestamp: Date.parse(AT) });\n\t\tfx1.capture.captureCommittedEntry(\"sess-busy-2\", manager2.getEntry(e2)!, undefined, AT);\n\t\tcreateJob(fx1.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-busy-2\", projectId: \"proj-busy\" }),\n\t\t\tscopeKey: \"session:sess-busy-2\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tconst processed: string[] = [];\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\tprocessed.push(input.sourceSessionId);\n\t\t\t// 第一个 job 的请求进行中前台来活：agent_start 置 busy → 后续 target 不领。\n\t\t\tif (processed.length === 1) {\n\t\t\t\tawait fx1.handlers.get(\"agent_start\")?.({ type: \"agent_start\" }, fx1.ctx);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tcandidates: [],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-busy-${processed.length}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fx1.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx1.ctx);\n\t\t\tawait waitFor(() => jobRow(fx1.store, \"session:sess-busy-1\")?.status === \"done\");\n\t\t\t// 第二个 job 应仍是 pending——busy 期间 drain 提前返回，没有领取它。\n\t\t\texpect(jobRow(fx1.store, \"session:sess-busy-2\")?.status).toBe(\"pending\");\n\t\t\texpect(processed).toEqual([\"sess-busy-1\"]);\n\n\t\t\t// 下一轮 settled（busy 复位）才领第二个。\n\t\t\tawait fx1.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx1.ctx);\n\t\t\tawait waitFor(() => jobRow(fx1.store, \"session:sess-busy-2\")?.status === \"done\");\n\t\t\texpect(processed).toEqual([\"sess-busy-1\", \"sess-busy-2\"]);\n\t\t} finally {\n\t\t\tfx1.unmount();\n\t\t\tawait fx1.service.close();\n\t\t\tfx1.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/I01 反例：needs-reevaluation 后无新来源，settled 不反复重跑\", async () => {\n\t\t// 与 F05 同前置：stopped 拦截 → failed(stale 前缀)。此后没有新来源——\n\t\t// 已尝试未提交的游标后旧批不算新依据，普通 settled 保持 failed 不重跑。\n\t\tconst scope: MemoryScope = { projectId: \"proj-i01-neg\", sessionId: \"sess-i01-neg\" };\n\t\tconst fx = await schedulerFixture(\"sess-i01-neg\", scope);\n\t\tconst s1 = appendUserSource(fx, \"构建命令固定为 pnpm build。\");\n\t\tconst created = await fx.service.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { ...scope },\n\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\tid: created.id,\n\t\t\texpectedRevision: 1,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: \"sess-i01-neg\" },\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\tif (!stopped.ok) throw new Error(stopped.error.message);\n\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async () => {\n\t\t\trequestCount += 1;\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [s1],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: s1, text: \"pnpm build\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: s1, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: `req-i01-neg-${requestCount}`,\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fx.handlers.get(\"turn_end\")?.({}, fx.ctx);\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-i01-neg\")?.status === \"failed\");\n\t\t\texpect(requestCount).toBe(1);\n\t\t\texpect(jobRow(fx.store, \"session:sess-i01-neg\")!.last_error).toContain(\"stale_request_snapshot:\");\n\n\t\t\t// 无新来源的空闲事件：job 保持 failed，不再发模型请求（不自动重放）。\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\texpect(requestCount).toBe(1);\n\t\t\texpect(jobRow(fx.store, \"session:sess-i01-neg\")!.status).toBe(\"failed\");\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/I02：同 home 同进程两调度器共享前台忙——A 忙时 B 的 settled 不领\", async () => {\n\t\t// 同 home 同 store 装两个会话调度器（桌面 session-supervisor 同进程多会话）。\n\t\tconst scopeA: MemoryScope = { projectId: \"proj-i02\", sessionId: \"sess-i02-a\" };\n\t\tconst fxA = await schedulerFixture(\"sess-i02-a\", scopeA);\n\t\tconst sourceA = appendUserSource(fxA, \"会话一的持久任务。\");\n\t\tcreateJob(fxA.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-i02-a\", projectId: \"proj-i02\" }),\n\t\t\tscopeKey: \"session:sess-i02-a\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tconst scopeB: MemoryScope = { projectId: \"proj-i02\", sessionId: \"sess-i02-b\" };\n\t\tconst fxB = await schedulerFixture(\"sess-i02-b\", scopeB, {\n\t\t\thome: fxA.home,\n\t\t\tstore: fxA.store,\n\t\t\tservice: fxA.service,\n\t\t});\n\n\t\tlet requestCount = 0;\n\t\trequestState.handle = async () => {\n\t\t\trequestCount += 1;\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\tconclusion: \"会话一的持久任务。\",\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [sourceA],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: sourceA, text: \"持久任务\" }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: sourceA, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-i02\",\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\t// A 前台忙（agent_start 未 settled）；B 的 settled 不能把 A 的忙清掉。\n\t\t\tawait fxA.handlers.get(\"agent_start\")?.({ type: \"agent_start\" }, fxA.ctx);\n\t\t\tawait fxB.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fxB.ctx);\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\texpect(requestCount).toBe(0);\n\t\t\texpect(jobRow(fxB.store, \"session:sess-i02-a\")?.status).toBe(\"pending\");\n\n\t\t\t// A settled 后 B 的空闲轮可正常领取续作。\n\t\t\tawait fxA.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fxA.ctx);\n\t\t\tawait waitFor(() => jobRow(fxB.store, \"session:sess-i02-a\")?.status === \"done\");\n\t\t\texpect(requestCount).toBe(1);\n\t\t} finally {\n\t\t\tfxB.unmount();\n\t\t\tfxA.unmount();\n\t\t\tawait fxB.service.close();\n\t\t\tfxB.store.close();\n\t\t}\n\t});\n\n\tit(\"O03/I03：本侧 abort 释放为 pending 不耗重试额度，settled 后续跑成功；真失败仍计数\", async () => {\n\t\tconst scope: MemoryScope = { projectId: \"proj-i03\", sessionId: \"sess-i03\" };\n\t\tconst fx = await schedulerFixture(\"sess-i03\", scope);\n\t\tconst s1 = appendUserSource(fx, \"构建命令固定为 pnpm build。\");\n\t\tcreateJob(fx.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-i03\", projectId: \"proj-i03\" }),\n\t\t\tscopeKey: \"session:sess-i03\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tlet requestCount = 0;\n\t\t// 请求挂起直到 abort：模拟前台抢占取消在途提炼。\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\trequestCount += 1;\n\t\t\tconst signal = input.signal;\n\t\t\treturn new Promise<ExtractModelOutput>((resolve) => {\n\t\t\t\tconst release = () =>\n\t\t\t\t\tresolve({\n\t\t\t\t\t\tcandidates: [],\n\t\t\t\t\t\trejected: [],\n\t\t\t\t\t\trequestId: `req-i03-abort-${requestCount}`,\n\t\t\t\t\t\tfailure: { stage: \"request\" as const, message: \"请求被取消:前台任务优先\" },\n\t\t\t\t\t});\n\t\t\t\tif (signal?.aborted) return release();\n\t\t\t\tsignal?.addEventListener(\"abort\", release, { once: true });\n\t\t\t});\n\t\t};\n\n\t\ttry {\n\t\t\t// 抢占：settled 领取 → agent_start abort → releaseJob 回 pending 不计失败。\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => requestCount === 1);\n\t\t\tawait fx.handlers.get(\"agent_start\")?.({ type: \"agent_start\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-i03\")?.status === \"pending\");\n\t\t\tconst released = jobRow(fx.store, \"session:sess-i03\")!;\n\t\t\texpect(released.consecutive_failures).toBe(0);\n\t\t\texpect(released.last_error).toBeNull();\n\n\t\t\t// 抢占后空闲续跑成功（不耗额度才能继续）。\n\t\t\trequestState.handle = async () => {\n\t\t\t\trequestCount += 1;\n\t\t\t\treturn {\n\t\t\t\t\tcandidates: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tkind: \"decision\",\n\t\t\t\t\t\t\tconclusion: \"构建命令固定为 pnpm build。\",\n\t\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\t\tsourceIds: [s1],\n\t\t\t\t\t\t\tquotedSpans: [{ sourceId: s1, text: \"pnpm build\" }],\n\t\t\t\t\t\t\tspanLocations: [{ sourceId: s1, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t\t},\n\t\t\t\t\t],\n\t\t\t\t\trejected: [],\n\t\t\t\t\trequestId: \"req-i03-ok\",\n\t\t\t\t};\n\t\t\t};\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-i03\")?.status === \"done\");\n\t\t\texpect(requestCount).toBe(2);\n\t\t\texpect(jobRow(fx.store, \"session:sess-i03\")!.consecutive_failures).toBe(0);\n\n\t\t\t// 对照：非 abort 的请求失败仍按 consecutive_failures 计数。\n\t\t\tconst scope2: MemoryScope = { projectId: \"proj-i03-fail\", sessionId: \"sess-i03-fail\" };\n\t\t\tconst fx2 = await schedulerFixture(\"sess-i03-fail\", scope2, {\n\t\t\t\thome: fx.home,\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t});\n\t\t\tappendUserSource(fx2, \"另一条决定。\");\n\t\t\tcreateJob(fx2.store, {\n\t\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-i03-fail\", projectId: \"proj-i03-fail\" }),\n\t\t\t\tscopeKey: \"session:sess-i03-fail\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\trequestState.handle = async () => {\n\t\t\t\trequestCount += 1;\n\t\t\t\treturn {\n\t\t\t\t\tcandidates: [],\n\t\t\t\t\trejected: [],\n\t\t\t\t\trequestId: \"req-i03-fail\",\n\t\t\t\t\tfailure: { stage: \"request\" as const, message: \"请求失败:供应商 500\" },\n\t\t\t\t};\n\t\t\t};\n\t\t\tawait fx2.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx2.ctx);\n\t\t\tawait waitFor(() => jobRow(fx2.store, \"session:sess-i03-fail\")?.status === \"failed\");\n\t\t\texpect(jobRow(fx2.store, \"session:sess-i03-fail\")!.consecutive_failures).toBe(1);\n\t\t\texpect(jobRow(fx2.store, \"session:sess-i03-fail\")!.last_error).toContain(\"供应商 500\");\n\t\t\tfx2.unmount();\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n\n\tit(\"O14：同段多来源一批只读段文件一次（读盘次数探针）\", async () => {\n\t\t// 验收口径要求的改善证据：批内 3 个来源同属同一段（同会话采集进同一\n\t\t// 段文件），readSourceEventsBatch 按段分组后整批只读 1 次段文件；\n\t\t// 改前逐来源 readMemorySource 各读一次（本场景 3 次）。\n\t\tconst scope: MemoryScope = { projectId: \"proj-o14-seg\", sessionId: \"sess-o14-seg\" };\n\t\tlet segmentReads = 0;\n\t\tconst fx = await schedulerFixture(\"sess-o14-seg\", scope, {\n\t\t\treadSegment: async (segment) => {\n\t\t\t\tsegmentReads += 1;\n\t\t\t\treturn readSegmentLines(segment as Parameters<typeof readSegmentLines>[0]);\n\t\t\t},\n\t\t});\n\t\tconst s1 = appendUserSource(fx, \"第一条：窗口边界。\", fx.sessionId, AT);\n\t\tconst s2 = appendUserSource(fx, \"第二条：同段批量读。\", fx.sessionId, AT2);\n\t\tconst s3 = appendUserSource(fx, \"第三条：同段复用。\", fx.sessionId, AT3);\n\t\t// 三条来源确属同一段（同会话同采集段）。\n\t\tconst segmentIds = new Set(\n\t\t\t[s1, s2, s3].map(\n\t\t\t\t(sourceId) =>\n\t\t\t\t\t(\n\t\t\t\t\t\tfx.store.db\n\t\t\t\t\t\t\t.prepare(\"SELECT segment_id FROM sources WHERE source_id = ?\")\n\t\t\t\t\t\t\t.get(sourceId) as { segment_id: string }\n\t\t\t\t\t).segment_id,\n\t\t\t),\n\t\t);\n\t\texpect(segmentIds.size).toBe(1);\n\t\tcreateJob(fx.store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: \"sess-o14-seg\", projectId: scope.projectId }),\n\t\t\tscopeKey: \"session:sess-o14-seg\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\n\t\tconst seenBatches: string[][] = [];\n\t\trequestState.handle = async (_deps, input) => {\n\t\t\tseenBatches.push(input.entries.map((e) => e.sourceId));\n\t\t\treturn {\n\t\t\t\tcandidates: [\n\t\t\t\t\t{\n\t\t\t\t\t\tkind: \"experience\",\n\t\t\t\t\t\tconclusion: `经验-${input.entries[0]!.sourceId}`,\n\t\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t\t\tsourceIds: [input.entries[0]!.sourceId],\n\t\t\t\t\t\tquotedSpans: [{ sourceId: input.entries[0]!.sourceId, text: input.entries[0]!.content.slice(0, 10) }],\n\t\t\t\t\t\tspanLocations: [{ sourceId: input.entries[0]!.sourceId, match: \"exact\" as const, offset: 0 }],\n\t\t\t\t\t},\n\t\t\t\t],\n\t\t\t\trejected: [],\n\t\t\t\trequestId: \"req-o14-seg\",\n\t\t\t};\n\t\t};\n\n\t\ttry {\n\t\t\tawait fx.handlers.get(\"agent_settled\")?.({ type: \"agent_settled\" }, fx.ctx);\n\t\t\tawait waitFor(() => jobRow(fx.store, \"session:sess-o14-seg\")?.status === \"done\");\n\t\t\t// 3 个来源同批发出、段文件只读 1 次（改前 3 次）。\n\t\t\texpect(seenBatches).toEqual([[s1, s2, s3]]);\n\t\t\texpect(segmentReads).toBe(1);\n\t\t} finally {\n\t\t\tfx.unmount();\n\t\t\tawait fx.service.close();\n\t\t\tfx.store.close();\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелы * Файл для ревью O09, самодостаточен; использует общий test-harness.\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,280]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[280,436]}}},{"diffOp":{"delete":{"range":[436,450]}}},{"diffOp":{"equal":{"range":[450,535]}}},{"equalLines":{"line_count":391}},{"diffOp":{"equal":{"range":[535,544]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-f14-review.test.ts"},"span":[869,882],"sourceCode":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелы\n * в memory-project-session.test.ts:\n *  - смешанная таблица completed/cancelled → workpoint честно пересчитывает cancelled;\n *  - todo_write с пустой таблицей → НИЧЕГО не записывается (старый nextStep выживает);\n *  - карта с delivered статусом → saveSettledContinuation не пишет вообще (ранний return).\n *\n * Файл для ревью O09, самодостаточен; использует общий test-harness.\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport {\n\ttype Context,\n\tfauxAssistantMessage,\n\tfauxProvider,\n\tfauxToolCall,\n\tgetCurrentSystemPrompt,\n\tInMemoryModelsStore,\n} from \"@pao/ai\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { ModelRuntime } from \"../../src/core/model-runtime.ts\";\nimport { createAgentSession } from \"../../src/core/sdk.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { SettingsManager } from \"../../src/core/settings-manager.ts\";\nimport { bindExecutionContext } from \"../../src/pao/cards/execution-context.ts\";\nimport { changeCardStatus, createCard, loadCard } from \"../../src/pao/cards/index.ts\";\nimport { registerPaoCommand } from \"../../src/pao/command-router.ts\";\nimport { resolveMemoryProjectIdentity } from \"../../src/pao/memory/project-identity.ts\";\nimport { registerProjectSession } from \"../../src/pao/memory/project-session.ts\";\nimport { readTaskContinuation, taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\nimport { registerBuiltinMemory, scopeFromContext, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { registerTodo } from \"../../src/pao/todo/index.ts\";\nimport { createSingleRootWorktreeHost } from \"../../src/pao/worktrees/types.ts\";\nimport { createTestUiContext } from \"../suite/harness.ts\";\nimport { createTestExtensionsResult, createTestResourceLoader } from \"../utilities.ts\";\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawn: vi.fn(actual.spawn),\n\t\texecFile: vi.fn(actual.execFile),\n\t\texecFileSync: vi.fn(actual.execFileSync),\n\t};\n});\n\nconst roots: string[] = [];\nconst fixtures: SdkFixture[] = [];\n\ninterface SdkFixture {\n\troot: string;\n\thome: string;\n\tproject: string;\n\tprojectId: string;\n\tcardsDir: string;\n\tsessionManager: SessionManager;\n\tsession: Awaited<ReturnType<typeof createAgentSession>>[\"session\"];\n\tregistration: BuiltinMemoryRegistration;\n\tfaux: ReturnType<typeof fauxProvider>;\n\tprompts: string[];\n\tnotifications: Array<{ message: string; type: string }>;\n\tclose: () => Promise<void>;\n}\n\nfunction tempDir(prefix: string): string {\n\tconst path = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(path);\n\treturn path;\n}\n\nfunction fixturePaths(root = tempDir(\"pao-f14-\")) {\n\tconst home = join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\treturn {\n\t\troot,\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tprojectId: resolveMemoryProjectIdentity(project).projectId,\n\t};\n}\n\nasync function createFixture(): Promise<SdkFixture> {\n\tconst paths = fixturePaths();\n\tconst sessionManager = SessionManager.create(paths.project, paths.sessions, { id: \"f14-session\" });\n\tconst runtime = await ModelRuntime.create({\n\t\tcredentials: AuthStorage.inMemory(),\n\t\tmodelsStore: new InMemoryModelsStore(),\n\t\tmodelsPath: null,\n\t\tallowModelNetwork: false,\n\t});\n\tconst faux = fauxProvider({ tokensPerSecond: 1_000_000 });\n\truntime.registerNativeProvider(faux.provider);\n\tawait runtime.refresh({ allowNetwork: false });\n\n\tconst prompts: string[] = [];\n\tconst notifications: Array<{ message: string; type: string }> = [];\n\tlet registration!: BuiltinMemoryRegistration;\n\tconst extensionsResult = await createTestExtensionsResult(\n\t\t[\n\t\t\t(pi) => {\n\t\t\t\tregistration = registerBuiltinMemory(pi, {\n\t\t\t\t\tpaoHome: paths.home,\n\t\t\t\t\tembedding: { timeoutMs: 20 },\n\t\t\t\t});\n\t\t\t\tregisterTodo(pi);\n\t\t\t\tregisterFakeDispatch(pi);\n\t\t\t\tregisterProjectSession(pi, {\n\t\t\t\t\tresolvePaoHome: () => paths.home,\n\t\t\t\t\tresolveMemoryService: () => (registration?.service.opened ? registration.service : undefined),\n\t\t\t\t\tresolveCardsDir: () => paths.cardsDir,\n\t\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t\t});\n\t\t\t\tregisterPaoCommand(pi, () => undefined);\n\t\t\t},\n\t\t],\n\t\tpaths.project,\n\t);\n\tconst { session } = await createAgentSession({\n\t\tcwd: paths.project,\n\t\tagentDir: join(paths.root, \"agent\"),\n\t\tmodelRuntime: runtime,\n\t\tmodel: faux.getModel(),\n\t\tsessionManager,\n\t\tsettingsManager: SettingsManager.inMemory({\n\t\t\tcompaction: { enabled: false, reserveTokens: 0, keepRecentTokens: 1 },\n\t\t\tretry: { enabled: false },\n\t\t}),\n\t\tresourceLoader: createTestResourceLoader({ extensionsResult }),\n\t});\n\tawait session.bindExtensions({\n\t\tuiContext: createTestUiContext({\n\t\t\tnotify: (message, type) => notifications.push({ message, type: type ?? \"info\" }),\n\t\t}),\n\t});\n\n\tconst fixture: SdkFixture = {\n\t\troot: paths.root,\n\t\thome: paths.home,\n\t\tproject: paths.project,\n\t\tprojectId: paths.projectId,\n\t\tcardsDir: paths.cardsDir,\n\t\tsessionManager,\n\t\tsession,\n\t\tregistration,\n\t\tfaux,\n\t\tprompts,\n\t\tnotifications,\n\t\tclose: async () => {\n\t\t\tsession.dispose();\n\t\t\tawait registration.close();\n\t\t},\n\t};\n\tfixtures.push(fixture);\n\treturn fixture;\n}\n\nfunction registerFakeDispatch(pi: ExtensionAPI): void {\n\tpi.registerTool({\n\t\tname: \"pao_dispatch_card\",\n\t\tlabel: \"测试派卡\",\n\t\tdescription: \"测试用真实工具结果契约，不执行派发。\",\n\t\tparameters: {\n\t\t\ttype: \"object\",\n\t\t\tproperties: { cards_dir: { type: \"string\" }, card_no: { type: \"number\" } },\n\t\t},\n\t\tasync execute(_toolCallId, params) {\n\t\t\treturn {\n\t\t\t\tcontent: [{ type: \"text\" as const, text: `已派发 ${(params as { card_no: number }).card_no}` }],\n\t\t\t\tdetails: { dispatched: true, card_no: (params as { card_no: number }).card_no },\n\t\t\t};\n\t\t},\n\t} as Parameters<ExtensionAPI[\"registerTool\"]>[0]);\n}\n\nfunction capture(fixture: SdkFixture, response: () => ReturnType<typeof fauxAssistantMessage>) {\n\treturn (context: Context) => {\n\t\tfixture.prompts.push(getCurrentSystemPrompt(context.messages));\n\t\treturn response();\n\t};\n}\n\nfunction plain(fixture: SdkFixture, text: string) {\n\treturn capture(fixture, () => fauxAssistantMessage(text));\n}\n\nfunction toolThenFinal(\n\tfixture: SdkFixture,\n\ttoolName: string,\n\targs: Parameters<typeof fauxToolCall>[1],\n\ttoolCallId: string,\n\tfinalText: string,\n) {\n\tfixture.faux.setResponses([\n\t\tcapture(fixture, () => fauxAssistantMessage(fauxToolCall(toolName, args, { id: toolCallId }))),\n\t\tplain(fixture, finalText),\n\t]);\n}\n\nasync function createAttemptOneCard(fixture: SdkFixture) {\n\tconst card = await createCard(fixture.cardsDir, {\n\t\t目标: \"F14 卡任务\",\n\t\t部门: \"研发\",\n\t\t验收: \"delivered 不影响接续\",\n\t\t创建: \"2026-11-15 10:00\",\n\t});\n\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t操作者: \"owner\",\n\t\tto: \"in_progress\",\n\t\t时间: \"2026-11-15 10:01\",\n\t});\n\tconst worktree = await createSingleRootWorktreeHost(fixture.project).resolveForDispatch({\n\t\trequestId: \"f14-card\",\n\t\tprojectRoot: fixture.project,\n\t\ttarget: { kind: \"primary\" },\n\t});\n\tawait bindExecutionContext(\n\t\t{\n\t\t\tkey: { cardsDir: fixture.cardsDir, cardNo: card.card_no, attempt: 1 },\n\t\t\tprojectRoot: fixture.project,\n\t\t\trepositoryRoot: fixture.project,\n\t\t\texecutionRoot: fixture.project,\n\t\t\tworktree,\n\t\t\tsnapshotRef: \"pao-test://f14/card\",\n\t\t\tsnapshotDigest: `sha256:${\"c\".repeat(64)}`,\n\t\t},\n\t\t{ expectedCurrentAttempt: 1 },\n\t);\n\treturn loadCard(fixture.cardsDir, card.card_no);\n}\n\nafterEach(async () => {\n\tfor (const fixture of fixtures.splice(0).reverse()) await fixture.close();\n\tfor (const root of roots.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(root, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 40));\n\t\t\t}\n\t\t}\n\t}\n});\n\ndescribe(\"F14 独立复核：终态 todo 表的接续语义\", () => {\n\tit(\"смешанная таблица completed+cancelled: workpoint честно перечисляет cancelled, nextStep без旧待办\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\t// 有待办: A in_progress, B pending, C pending\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"in_progress\" },\n\t\t\t\t\t{ content: \"B\", status: \"pending\" },\n\t\t\t\t\t{ content: \"C\", status: \"pending\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-pending\",\n\t\t\t\"部分待办\",\n\t\t);\n\t\tawait fixture.session.prompt(\"начал\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：A\");\n\n\t\t// 终态: A completed, B cancelled, C cancelled → 1/3 完成 + 2 отменено\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"completed\" },\n\t\t\t\t\t{ content: \"B\", status: \"cancelled\" },\n\t\t\t\t\t{ content: \"C\", status: \"cancelled\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-done\",\n\t\t\t\"全部终态\",\n\t\t);\n\t\tawait fixture.session.prompt(\"завершил\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(after.ok && after.status).toBe(\"ready\");\n\t\tif (!after.ok) return;\n\t\t// workpoint: «完成 1/3，另有 2 项已取消；无剩余待办» — не врёт про cancelled\n\t\texpect(after.continuation.workpoint?.text).toContain(\"完成 1/3\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"2 项已取消\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"无剩余待办\");\n\t\texpect(after.nextStep?.text).toContain(\"已全部完成\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：B\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：C\");\n\t});\n\n\tit(\"пустая таблица todo_write: ранний return, старый nextStep не перезаписывается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"甲\", status: \"in_progress\" }] },\n\t\t\t\"pending-todo\",\n\t\t\t\"甲\",\n\t\t);\n\t\tawait fixture.session.prompt(\"开始甲\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：甲\");\n\n\t\t// Пустая таблица — сигнал «очистить», а не «всё сделано». Функция должна вернуть\n\t\t// undefined и не перезаписывать существующую запись.\n\t\ttoolThenFinal(fixture, \"todo_write\", { todos: [] }, \"empty-todo\", \"пустая таблица\");\n\t\tawait fixture.session.prompt(\"todo очищен\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\t// Старый nextStep сохранился — запись не обновилась «0/0»\n\t\texpect(after.ok && after.nextStep?.text).toContain(\"继续处理：甲\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"进行中：甲\");\n\t});\n\n\tit(\"delivered карта: ранний return saveSettledContinuation, запись карты не трогается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tconst card = await createAttemptOneCard(fixture);\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(`/pao task new`);\n\t\t// Переводим карту в delivered ДО settle — сработает ранний return\n\t\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t\t操作者: \"owner\",\n\t\t\tto: \"delivered\",\n\t\t\t时间: \"2026-11-15 10:30\",\n\t\t});\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"card work\", status: \"completed\" }] },\n\t\t\t\"card-todo\",\n\t\t\t\"card todo\",\n\t\t);\n\t\tawait fixture.session.prompt(\"card done\");\n\t\tconst cardTaskId = taskIdForCard(fixture.cardsDir, card.card_no);\n\t\tconst read = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: cardTaskId,\n\t\t});\n\t\t// delivered ранний return — запись карты либо отсутствует, либо не обновилась\n\t\t// ( не «готово/продолжай» по todo ).\n\t\tif (read.ok) {\n\t\t\texpect(read.nextStep?.text ?? \"\").not.toContain(\"继续处理：card work\");\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *import { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport { restoreMemoryBackup } from \"../../src/pao/memory/backup.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerMemoryCommand } from \"../../src/pao/memory/session.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[101,304]}}},{"diffOp":{"delete":{"range":[304,374]}}},{"diffOp":{"equal":{"range":[374,523]}}},{"equalLines":{"line_count":247}},{"diffOp":{"equal":{"range":[523,532]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-maintenance-command.test.ts"},"span":[1236,1259],"sourceCode":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *\n * 覆盖：\n * - /pao memory rebuild：走 registerMemoryCommand → openMemoryStore →\n *   rebuildMemoryIndex，FTS 行被重建且可通过 FTS 检索；范围过滤只清本范围。\n * - /pao memory backup：经 maintenance.enqueue 登记 archive 作业（不直接跑\n *   createMemoryBackup——归档由空闲 drain 执行）；enqueue 缺席时如实告警。\n * - /pao memory restore：restoreMemoryBackup 把备份目录恢复到独立目标 home，\n *   不动当前现场。\n * - rebuildMemoryIndex 范围清除（F06）：projectId/kind 筛选下只清范围内 FTS，\n *   范围外项目/类型的索引不动；已排除项不复活。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-maintenance-command.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport { restoreMemoryBackup } from \"../../src/pao/memory/backup.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerMemoryCommand } from \"../../src/pao/memory/session.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { createMemoryBackup } from \"../../src/pao/memory/backup.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst PROJECT_A = \"proj-a\";\nconst PROJECT_B = \"proj-b\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-cmd-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nfunction ftsCount(store: MemoryStore): number {\n\ttry {\n\t\treturn (store.db.prepare(\"SELECT COUNT(*) AS n FROM memory_fts\").get() as { n: number }).n;\n\t} catch {\n\t\treturn 0;\n\t}\n}\n\nfunction ftsIds(store: MemoryStore): string[] {\n\treturn (store.db.prepare(\"SELECT memory_id FROM memory_fts ORDER BY memory_id\").all() as Array<{ memory_id: string }>).map(\n\t\t(r) => r.memory_id,\n\t);\n}\n\nasync function seed(store: MemoryStore, home: string, over: { conclusion: string; kind?: \"decision\" | \"experience\"; projectId: string }) {\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\ttry {\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId: \"sess-cmd\",\n\t\t\tentryId: `e-${Math.random().toString(36).slice(2, 10)}`,\n\t\t\teventType: \"user\",\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst created = await service.createMemory({\n\t\t\tkind: over.kind ?? \"experience\",\n\t\t\tscope: { projectId: over.projectId },\n\t\t\tconclusion: over.conclusion,\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"tentative\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\treturn created.id;\n\t} finally {\n\t\tawait service.close();\n\t}\n}\n\nfunction commandCtx() {\n\treturn {\n\t\thasUI: true,\n\t\tcwd: process.cwd(),\n\t\tui: { notify: vi.fn(), confirm: vi.fn(async () => true) },\n\t} as never;\n}\n\nfunction runMemory(pi: ExtensionAPI, args: string, ctx: unknown) {\n\tconst sub = listPaoSubcommands(pi).find((item) => item.name === \"memory\");\n\tif (!sub) throw new Error(\"memory 子命令未注册\");\n\treturn sub.run(pi, args, ctx);\n}\n\n// ── J03：/pao memory 管理子命令入口 ─────────────────────────────────────\n\ndescribe(\"/pao memory 管理子命令（F05）\", () => {\n\tit(\"rebuild：命令入口触发 rebuildMemoryIndex，FTS 行重建可检索\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"可检索的重建结论\", projectId: PROJECT_A });\n\t\t// 先清空 FTS 模拟索引缺失。\n\t\tstore.db.exec(\"DELETE FROM memory_fts\");\n\t\texpect(ftsCount(store)).toBe(0);\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"rebuild\", ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\texpect(ftsIds(verify)).toEqual([id]);\n\t\tverify.close();\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"索引重建完成\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"rebuild --project：范围过滤只清本范围 FTS，范围外不动（F06 链验证）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"项目A结论\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"项目B结论\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `rebuild --project ${PROJECT_A}`, ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\tconst ids = ftsIds(verify);\n\t\texpect(ids.sort()).toEqual([idA, idB].sort());\n\t\tverify.close();\n\t});\n\n\tit(\"backup：登记 archive 作业（不直接跑备份），enqueue 收到归档参数\", async () => {\n\t\tconst home = tempHome();\n\t\tconst enqueue = vi.fn<(kind: \"archive\", scopeKey: string, sourceScope: string) => boolean>(() => true);\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home, { enqueue });\n\t\tawait runMemory(pi, \"backup D:\\\\backups\\\\mem-001\", ctx);\n\n\t\texpect(enqueue).toHaveBeenCalledTimes(1);\n\t\texpect(enqueue.mock.calls[0]![0]).toBe(\"archive\");\n\t\texpect(enqueue.mock.calls[0]![1]).toContain(\"archive:\");\n\t\tconst sourceScope = JSON.parse(enqueue.mock.calls[0]![2]) as { kind: string; backupDir: string };\n\t\texpect(sourceScope.kind).toBe(\"archive\");\n\t\texpect(sourceScope.backupDir).toBe(\"D:\\\\backups\\\\mem-001\");\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"已登记备份作业\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"backup：无维护 enqueue 时如实告警，不假装登记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"backup /tmp/whatever\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"维护队列未就绪\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n\n\tit(\"restore：备份目录恢复到独立目标 home，当前现场不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"待恢复的记忆\", projectId: PROJECT_A });\n\t\t// 先造一个真实备份（走 createMemoryBackup 产出备份目录）。\n\t\tconst backupDir = join(tempHome(), \"backup\");\n\t\tconst backup = createMemoryBackup(store, { home, backupDir, createdAt: AT });\n\t\tstore.close();\n\t\texpect(backup.ok).toBe(true);\n\n\t\t// 命令 restore 到独立 targetHome。\n\t\tconst targetHome = join(tempHome(), \"restored\");\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `restore ${backupDir} ${targetHome}`, ctx);\n\n\t\t// 目标 home 里能读到记忆。\n\t\tconst targetStore = openMemoryStore(targetHome, \"readonly\");\n\t\tconst row = targetStore.db.prepare(\"SELECT id FROM memories WHERE id = ?\").get(id);\n\t\texpect(row).toBeDefined();\n\t\ttargetStore.close();\n\t});\n\n\tit(\"restore 参数缺目标目录：用法告警，不调用恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"restore onlydir\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"用法\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n});\n\n// ── J04：rebuildMemoryIndex 范围清除（F06）─────────────────────────────\n\ndescribe(\"rebuildMemoryIndex 范围清除（F06）\", () => {\n\tit(\"projectId 筛选：只清范围内 FTS 行，范围外保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"A项目x\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"B项目y\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\n\t\t// 损坏范围 A 的 FTS（模拟索引漂移）。\n\t\tstore.db.prepare(\"DELETE FROM memory_fts WHERE memory_id = ?\").run(idA);\n\t\texpect(ftsIds(store)).toEqual([idB]);\n\n\t\t// 范围重建：A 的索引重建、B 的不动。\n\t\tconst result = rebuildMemoryIndex(store, { projectId: PROJECT_A, dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(0); // A 的 FTS 已手动清掉，无行可删\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"kind 筛选：只清该 kind 范围内 FTS，其他 kind 不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idExp = await seed(store, home, { conclusion: \"经验类\", kind: \"experience\", projectId: PROJECT_A });\n\t\tconst idDec = await seed(store, home, { conclusion: \"决定类\", kind: \"decision\", projectId: PROJECT_A });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\n\t\tconst result = rebuildMemoryIndex(store, { kind: \"experience\", dropExistingFts: true });\n\t\t// experience 的旧行被清掉再重建 → droppedFts=1；decision 行不动。\n\t\texpect(result.droppedFts).toBe(1);\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"无筛选 + dropExisting：全清后重建（既有行为保持）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"全清A\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"全清B\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsCount(store)).toBe(2);\n\n\t\tconst result = rebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(2);\n\t\texpect(result.rebuiltFts).toBe(2);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"warning","description":"This variable res is unused.","message":[{"elements":[],"content":"This variable "},{"elements":["Emphasis"],"content":"res"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables are often the result of an incomplete refactoring, typos, or other sources of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"res"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"// O06 独立复核反面场景（审核口径：验证业务结果，不只看能力存在）。\n// - F01：等待期删除一条候选记忆后，organize 整理不得复活/提交它；\n// - F06：重建 A 项目索引后，B 项目 FTS 完整保留、A 范围内仍可检索。\t\t// 已删记忆不应出现在「待整理变化」里\n\t\texpect(changed.items.some((m) => m.memoryId === b.id)).toBe(false);\n\t\tconst res_res = await runOrganizeMaintenance({\n\t\t\tstore,\n\t\t\tservice: svc,\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,281]}}},{"equalLines":{"line_count":73}},{"diffOp":{"equal":{"range":[281,416]}}},{"diffOp":{"delete":{"range":[416,419]}}},{"diffOp":{"insert":{"range":[419,423]}}},{"diffOp":{"equal":{"range":[423,424]}}},{"diffOp":{"equal":{"range":[424,483]}}},{"equalLines":{"line_count":54}},{"diffOp":{"equal":{"range":[483,492]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-o06-verify.test.ts"},"span":[2893,2896],"sourceCode":"// O06 独立复核反面场景（审核口径：验证业务结果，不只看能力存在）。\n// - F01：等待期删除一条候选记忆后，organize 整理不得复活/提交它；\n// - F06：重建 A 项目索引后，B 项目 FTS 完整保留、A 范围内仍可检索。\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { runOrganizeMaintenance, collectChangedMemories } from \"../../src/pao/memory/organize.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\n\nconst dirs: string[] = [];\nfunction tmp(): string {\n\tconst d = mkdtempSync(join(tmpdir(), \"o06v-\"));\n\tdirs.push(d);\n\treturn d;\n}\nafterEach(() => {\n\tfor (const d of dirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(d, { recursive: true, force: true });\n\t\t} catch {}\n\t}\n});\nconst AT = \"2026-11-14T08:00:00.000Z\";\nlet seq = 0;\nfunction seedSource(store: ReturnType<typeof openMemoryStore>, projectId?: string): string {\n\tseq += 1;\n\treturn registerSource(store.db, {\n\t\tsessionId: \"sess-o06v\",\n\t\tentryId: `e-${seq}`,\n\t\teventType: \"user\",\n\t\tcapturedAt: AT,\n\t\t...(projectId === undefined ? {} : { projectId }),\n\t});\n}\n\ndescribe(\"O06 独立反面场景\", () => {\n\tit(\"F01: 等待期删除一条候选记忆后，整理不复活不提交\", async () => {\n\t\tconst home = tmp();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scope = { projectId: \"proj-x\" };\n\t\tconst s1 = seedSource(store, \"proj-x\");\n\t\tconst s2 = seedSource(store, \"proj-x\");\n\t\t// 两条词法完全相同的 decision，会成 organize 词法重复候选\n\t\tconst a = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope,\n\t\t\tconclusion: \"采用 SQLite 作为本地存储\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\tconst b = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope,\n\t\t\tconclusion: \"采用 SQLite 作为本地存储\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s2],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\texpect(a.ok && b.ok).toBe(true);\n\t\tif (!a.ok || !b.ok) return;\n\t\t// 等待期彻底删除 b：用户已删，整理不得把它当候选复活/提交\n\t\tconst del = await svc.deleteMemory({\n\t\t\tmemoryIds: [b.id],\n\t\t\trevisions: { [b.id]: 1 },\n\t\t\tsource: { sessionId: \"sess-o06v\" },\n\t\t});\n\t\texpect(del.ok).toBe(true);\n\t\tconst changed = collectChangedMemories(store, scope, undefined);\n\t\t// 已删记忆不应出现在「待整理变化」里\n\t\texpect(changed.items.some((m) => m.memoryId === b.id)).toBe(false);\n\t\tconst res = await runOrganizeMaintenance({\n\t\t\tstore,\n\t\t\tservice: svc,\n\t\t\tpaoHome: home,\n\t\t\tsourceScope: JSON.stringify(scope),\n\t\t\tjobId: \"j1\",\n\t\t\tnow: () => AT,\n\t\t});\n\t\t// 即便 b 残留为候选，stale/excluded 复核也应拦截——a 不得 merged_into 到已删 b\n\t\tconst still = await svc.getMemory({ id: a.id });\n\t\texpect(still.ok).toBe(true);\n\t\tif (still.ok) expect(still.memory.mergedInto).toBeUndefined();\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F06: 重建A项目后B项目FTS完整保留，A范围内仍可检索\", async () => {\n\t\tconst home = tmp();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scopeA = { projectId: \"proj-A\" };\n\t\tconst scopeB = { projectId: \"proj-B\" };\n\t\tconst sa = seedSource(store, \"proj-A\");\n\t\tconst sb = seedSource(store, \"proj-B\");\n\t\tconst ma = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: scopeA,\n\t\t\tconclusion: \"A项目采用方案甲\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sa],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\tconst mb = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: scopeB,\n\t\t\tconclusion: \"B项目采用方案乙\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sb],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\texpect(ma.ok && mb.ok).toBe(true);\n\t\tif (!ma.ok || !mb.ok) return;\n\t\t// 重建前 B 可检索\n\t\tconst preB = await svc.searchMemory({ scope: scopeB, query: \"方案乙\", mode: \"current\" });\n\t\texpect(preB.ok && preB.hits.length > 0).toBe(true);\n\t\t// 只重建 A\n\t\trebuildMemoryIndex(store, { projectId: \"proj-A\", dropExistingFts: true });\n\t\t// B 的 FTS 应完整保留（proj-B 行不被清掉）\n\t\tconst postB = await svc.searchMemory({ scope: scopeB, query: \"方案乙\", mode: \"current\" });\n\t\texpect(postB.ok && postB.hits.some((h) => h.memoryId === mb.id)).toBe(true);\n\t\t// A 重建后仍可检索\n\t\tconst postA = await svc.searchMemory({ scope: scopeA, query: \"方案甲\", mode: \"current\" });\n\t\texpect(postA.ok && postA.hits.some((h) => h.memoryId === ma.id)).toBe(true);\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"warning","description":"Several of these imports are unused.","message":[{"elements":[],"content":"Several of these "},{"elements":["Emphasis"],"content":"imports"},{"elements":[],"content":" are unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: Remove the unused imports."}]]},{"diff":{"dictionary":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *import { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope, MemoryService } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,89]}}},{"equalLines":{"line_count":24}},{"diffOp":{"equal":{"range":[89,252]}}},{"diffOp":{"delete":{"range":[252,263]}}},{"diffOp":{"delete":{"range":[263,265]}}},{"diffOp":{"equal":{"range":[265,350]}}},{"equalLines":{"line_count":554}},{"diffOp":{"equal":{"range":[350,359]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-organize.test.ts"},"span":[1581,1592],"sourceCode":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *\n * 覆盖：\n * - collectChangedMemories 复合游标（updated_at|id）：首批、无变化、新增、\n *   旧记录修订、同时间戳超 200 条不漏；\n * - organize handler 全链：变化→分组→词法候选→复核→service.mergeMemories\n *   实际合并（merged_into 指向、修订推进）；\n * - 提交保护：双 confirmed 结论不同拒并；等待期停用/来源被排除的旧候选不提交；\n * - handler 经 registerMaintenanceScheduler 领取 organize job 分派执行。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-organize.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { registerMaintenanceScheduler, type MaintenanceSchedulerDeps } from \"../../src/pao/memory/maintenance.ts\";\nimport {\n\tcollectChangedMemories,\n\trunOrganizeMaintenance,\n\tserializeOrganizeCursor,\n\tstaleOrganizeMembers,\n} from \"../../src/pao/memory/organize.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope, MemoryService } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst PROJECT = \"proj-organize\";\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst AT2 = \"2026-11-14T10:01:00.000Z\";\nconst AT3 = \"2026-11-14T10:02:00.000Z\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-org-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\ninterface Fixture {\n\thome: string;\n\tstore: MemoryStore;\n\tservice: MemoryService;\n}\n\nfunction fixture(): Fixture {\n\tconst home = tempHome();\n\treturn { home, store: openMemoryStore(home, \"readwrite\"), service: openMemoryService({ paoHome: home, mode: \"readwrite\" }) };\n}\n\nasync function closeFixture(fx: Fixture): Promise<void> {\n\tawait fx.service.close();\n\tfx.store.close();\n}\n\nlet sourceSeq = 0;\nfunction seedSource(store: MemoryStore, capturedAt: string = AT): string {\n\tsourceSeq += 1;\n\treturn registerSource(store.db, {\n\t\tsessionId: \"sess-org\",\n\t\tentryId: `e-org-${sourceSeq}`,\n\t\teventType: \"user\",\n\t\tcapturedAt,\n\t});\n}\n\nasync function seedMemory(\n\tservice: MemoryService,\n\tover: {\n\t\tconclusion: string;\n\t\tkind?: \"decision\" | \"experience\";\n\t\tconfirmation?: \"confirmed\" | \"tentative\";\n\t\tconditions?: string;\n\t\ttaskId?: string;\n\t\tprojectId?: string;\n\t\tsourceIds: string[];\n\t\tcreatedAt?: string;\n\t},\n): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: over.kind ?? \"experience\",\n\t\tscope: {\n\t\t\tprojectId: over.projectId ?? PROJECT,\n\t\t\t...(over.taskId === undefined ? {} : { taskId: over.taskId }),\n\t\t},\n\t\tconclusion: over.conclusion,\n\t\t...(over.conditions === undefined ? {} : { conditions: over.conditions }),\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: over.confirmation ?? \"tentative\",\n\t\tsourceIds: over.sourceIds,\n\t\tcreatedBy: \"user\",\n\t\t...(over.createdAt === undefined ? {} : { createdAt: over.createdAt }),\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\n/** 直改 updated_at 造同时间戳批次（createdAt 控制不了 updated_at 列的独立值）。 */\nfunction setUpdatedAt(store: MemoryStore, memoryId: string, updatedAt: string): void {\n\tstore.db.prepare(\"UPDATE memories SET updated_at = ? WHERE id = ?\").run(updatedAt, memoryId);\n}\n\n// ── J02：复合游标 ────────────────────────────────────────────────────────\n\ndescribe(\"collectChangedMemories 复合游标（F02）\", () => {\n\tit(\"首批返回、无变化原样返回 cursor、新增/修订只回增量\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst id1 = await seedMemory(fx.service, { conclusion: \"结论一\", sourceIds: [s1], createdAt: AT });\n\t\t\tconst id2 = await seedMemory(fx.service, { conclusion: \"结论二\", sourceIds: [s2], createdAt: AT });\n\t\t\tsetUpdatedAt(fx.store, id1, AT);\n\t\t\tsetUpdatedAt(fx.store, id2, AT2);\n\n\t\t\tconst first = collectChangedMemories(fx.store, { projectId: PROJECT }, undefined);\n\t\t\texpect(first.items.map((m) => m.memoryId)).toEqual([id1, id2]);\n\t\t\texpect(first.nextCursor).toBe(serializeOrganizeCursor(AT2, id2));\n\t\t\texpect(first.scanned).toBe(2);\n\n\t\t\t// 无变化：同游标再查为空且 cursor 原样。\n\t\t\tconst none = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(none.items).toHaveLength(0);\n\t\t\texpect(none.nextCursor).toBe(first.nextCursor);\n\n\t\t\t// 新增一条（更晚 updated_at）只返回新条目。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst id3 = await seedMemory(fx.service, { conclusion: \"结论三\", sourceIds: [s3], createdAt: AT3 });\n\t\t\tsetUpdatedAt(fx.store, id3, AT3);\n\t\t\tconst added = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(added.items.map((m) => m.memoryId)).toEqual([id3]);\n\n\t\t\t// 旧记录修订：id1 再修订使 updated_at 前进，重扫应只返回 id1。\n\t\t\tconst corrected = await fx.service.correctMemory({\n\t\t\t\tid: id1,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: { conclusion: \"结论一（修订）\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(corrected.ok).toBe(true);\n\t\t\tsetUpdatedAt(fx.store, id1, \"2026-11-14T10:05:00.000Z\");\n\t\t\tconst revised = collectChangedMemories(fx.store, { projectId: PROJECT }, added.nextCursor);\n\t\t\texpect(revised.items.map((m) => m.memoryId)).toEqual([id1]);\n\t\t\texpect(revised.items[0]!.currentRevision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"同时间戳超过 200 条不漏：复合游标按 (updated_at,id) 推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst total = 250;\n\t\t\tconst ids: string[] = [];\n\t\t\tfor (let i = 0; i < total; i++) {\n\t\t\t\tconst sourceId = seedSource(fx.store);\n\t\t\t\tconst id = await seedMemory(fx.service, {\n\t\t\t\t\tconclusion: `同时间批次结论 ${i}`,\n\t\t\t\t\tsourceIds: [sourceId],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\tsetUpdatedAt(fx.store, id, AT);\n\t\t\t\tids.push(id);\n\t\t\t}\n\t\t\tconst seen = new Set<string>();\n\t\t\tlet cursor: string | undefined;\n\t\t\tfor (let round = 0; round < 5; round++) {\n\t\t\t\tconst batch = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\t\tfor (const item of batch.items) seen.add(item.memoryId);\n\t\t\t\tcursor = batch.nextCursor;\n\t\t\t\tif (batch.scanned < 200) break;\n\t\t\t}\n\t\t\texpect(seen.size).toBe(total);\n\t\t\tfor (const id of ids) expect(seen.has(id)).toBe(true);\n\t\t\t// 全部扫完后再查应为空。\n\t\t\tconst tail = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\texpect(tail.items).toHaveLength(0);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\n// ── J01：organize handler 全链 ───────────────────────────────────────────\n\ndescribe(\"runOrganizeMaintenance（F01）\", () => {\n\tit(\"词法重复候选经 mergeMemories 合并：merged_into 指向 keep、keep 修订推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 两条同结论 active 记忆（同 kind+同 taskId 组内）→ 词法候选。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-1\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\texpect(result.done).toBe(true);\n\n\t\t\t// keep/merge 方向由 sortByExpiry+memoryId 排序决定（UUID 随机），\n\t\t\t// 只断言一条 merged_into 指向另一条且 keep 修订推进。\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into, current_revision FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null; current_revision: number }>;\n\t\t\tconst mergedOne = rows.find((r) => r.merged_into !== null);\n\t\t\tconst keptOne = rows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedOne).toBeDefined();\n\t\t\texpect(keptOne).toBeDefined();\n\t\t\texpect(mergedOne!.merged_into).toBe(keptOne!.id);\n\t\t\texpect(keptOne!.current_revision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"双 confirmed 同结论可并；不同结论的服务层拒并保护仍在\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 双 confirmed 同结论 → organize 的候选合并不被「双 confirmed」误拦。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-2\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(keptPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\n\t\t\t// 服务层保护仍在：不同结论的双 confirmed 直接调 mergeMemories 被拒——\n\t\t\t// organize 走同一入口，语义/词法候选若命中这类对同样会被拒。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst s4 = seedSource(fx.store);\n\t\t\tconst conflictA = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"缓存层选 Redis\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s3],\n\t\t\t\tcreatedAt: AT3,\n\t\t\t});\n\t\t\tconst conflictB = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"缓存层选 Memcached\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s4],\n\t\t\t\tcreatedAt: AT3,\n\t\t\t});\n\t\t\tconst rejected = await fx.service.mergeMemories({\n\t\t\t\tkeepId: conflictA,\n\t\t\t\tkeepExpectedRevision: 1,\n\t\t\t\tmergeId: conflictB,\n\t\t\t\tmergeExpectedRevision: 1,\n\t\t\t\trationale: \"验证拒并保护\",\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(rejected.ok).toBe(false);\n\t\t\tif (!rejected.ok) expect(rejected.error.code).toBe(\"merge_conflict\");\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"等待期停用的成员不进规整收集；快照复核 staleOrganizeMembers 直接判 stale\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"相同结论被停用前\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"相同结论被停用前\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\t// 先 collect 拿到 active 快照（模拟调度器 enqueue 时的状态）。\n\t\t\tconst collected = collectChangedMemories(fx.store, { projectId: PROJECT }, undefined);\n\t\t\tconst snapshot = collected.items.find((m) => m.memoryId === mergeId);\n\t\t\texpect(snapshot).toBeDefined();\n\t\t\t// 等待期把 mergeId 停用——快照 revision 前进，staleOrganizeMembers 判 stale。\n\t\t\tconst stopped = await fx.service.setMemoryUsage({\n\t\t\t\tid: mergeId,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\ttarget: \"stopped\",\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(stopped.ok).toBe(true);\n\t\t\texpect(staleOrganizeMembers(fx.store.db, [snapshot!]).map((m) => m.memoryId)).toEqual([mergeId]);\n\t\t\t// 端到端：停用成员不再被 collect（usage_state 过滤），无组可成对。\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-3\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, usage_state, merged_into FROM memories\")\n\t\t\t\t.all() as Array<{ id: string; usage_state: string; merged_into: string | null }>;\n\t\t\tconst stoppedRow = rows.find((r) => r.id === mergeId)!;\n\t\t\texpect(stoppedRow.usage_state).toBe(\"stopped\");\n\t\t\texpect(stoppedRow.merged_into).toBeNull();\n\t\t\texpect(rows.find((r) => r.id === keepId)!.merged_into).toBeNull();\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"无变化零请求：done、merged=0、游标原样\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-empty\",\n\t\t\t});\n\t\t\texpect(result.done).toBe(true);\n\t\t\texpect(result.merged).toBe(0);\n\t\t\texpect(result.skipped).toBe(0);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\ndescribe(\"O06/R1：自动整理不改判正式决定\", () => {\n\tit(\"条件互斥（单机 vs 多机）的同结论 confirmed 决定不自动合并\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst a = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限单机部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst b = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限多机部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-cond\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\texpect(result.skipped).toBeGreaterThan(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(a, b) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.every((r) => r.merged_into === null)).toBe(true);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"confirmed 与 tentative 同结论不自动合并：正本保持 confirmed\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst tentative = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"tentative\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst confirmed = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-conf\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(0);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(tentative, confirmed) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.every((r) => r.merged_into === null)).toBe(true);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"条件归一等价的同状态决定可合并（条件空白合一/大小写差异不挡）\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst a = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限  单机   部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst b = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"采用 SQLite\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tconditions: \"仅限 单机 部署\",\n\t\t\t\tsourceIds: [seedSource(fx.store)],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-r1-equiv\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(a, b) as Array<{ id: string; merged_into: string | null }>;\n\t\t\texpect(rows.filter((r) => r.merged_into !== null)).toHaveLength(1);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\n// ── J01：经调度器分派 ───────────────────────────────────────────────────\n\ntype Handler = (event: never, ctx: unknown) => unknown;\nfunction capturePi(): { handlers: Map<string, Handler[]>; pi: ExtensionAPI } {\n\tconst handlers = new Map<string, Handler[]>();\n\tconst pi = {\n\t\ton(event: string, handler: Handler) {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\thandlers.set(event, list.filter((h) => h !== handler));\n\t\t\t};\n\t\t},\n\t} as unknown as ExtensionAPI;\n\treturn { handlers, pi };\n}\n\nfunction testCtx(sessionId = \"sess-org-sched\"): ExtensionContext {\n\treturn {\n\t\tcwd: process.cwd(),\n\t\tsessionManager: { getSessionId: () => sessionId },\n\t\tsignal: undefined,\n\t} as unknown as ExtensionContext;\n}\n\nasync function emit(captured: { handlers: Map<string, Handler[]> }, event: string, ctx: ExtensionContext) {\n\tfor (const handler of captured.handlers.get(event) ?? []) {\n\t\tawait handler({ type: event } as never, ctx);\n\t}\n}\n\nfunction flushMicrotasks(): Promise<void> {\n\treturn new Promise((resolve) => setTimeout(resolve, 0));\n}\n\ndescribe(\"organize 经维护调度器领取执行（F01）\", () => {\n\tit(\"enqueue organize → agent_settled → handler 跑完合并\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"调度链路合并结论\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst captured = capturePi();\n\t\t\tconst deps: MaintenanceSchedulerDeps = {\n\t\t\t\tstore: fx.store,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tservice: fx.service,\n\t\t\t\tresolveScope: () => resolveMemoryScope(process.cwd()),\n\t\t\t\thandlers: {\n\t\t\t\t\torganize: async (_ctx, job, d) => {\n\t\t\t\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\t\t\t\tstore: d.store,\n\t\t\t\t\t\t\tservice: d.service!,\n\t\t\t\t\t\t\tpaoHome: d.paoHome,\n\t\t\t\t\t\t\tsourceScope: job.sourceScope,\n\t\t\t\t\t\t\tjobId: job.jobId,\n\t\t\t\t\t\t\t...(job.cursor === undefined ? {} : { cursor: job.cursor }),\n\t\t\t\t\t\t});\n\t\t\t\t\t\treturn { done: result.done, ...(result.cursor === undefined ? {} : { cursor: result.cursor }) };\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tnow: () => AT3,\n\t\t\t};\n\t\t\tconst scheduler = registerMaintenanceScheduler(captured.pi, deps);\n\t\t\tscheduler.enqueue(\"organize\", `organize:${PROJECT}`, JSON.stringify({ kind: \"organize\", projectId: PROJECT }));\n\t\t\tawait emit(captured, \"agent_settled\", testCtx());\n\t\t\tawait flushMicrotasks();\n\n\t\t\tconst row = fx.store.db\n\t\t\t\t.prepare(\"SELECT status, job_kind FROM extraction_jobs WHERE scope_key = ?\")\n\t\t\t\t.get(`organize:${PROJECT}`) as { status: string; job_kind: string } | undefined;\n\t\t\texpect(row?.job_kind).toBe(\"organize\");\n\t\t\texpect(row?.status).toBe(\"done\");\n\t\t\t// 一条 merged_into 指向另一条（方向由组内排序决定，不假定）。\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\t\t\tscheduler.unmount();\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * pao 协作卡中转（卡0005）：协作卡星型中转的机械校验放行 ＋ /派 用户快捷建卡。\n *\t\t\t// 打回/升级人是同一次工具调用的两种落点——eventId 用调用 ID，\n\t\t\t// 同一调用重报同值幂等（O10/E02）。\n\t\t\tidentity === undefined \n\t\t\t\t? undefined: { ...identity, eventId: `${identity.toolCallId ?? identity.eventId ?? \"collab\"}:打回` },\n\t\t);\n\t\treturn {\t\t\t.join(\"；\")}`,\n\t\tcardsDir,\n\t\tidentity === undefined: { ...identity, eventId: `${identity.toolCallId ?? identity.eventId ?? \"collab\"}:升级人` },\n\t);\n\treturn { text: `${result.裁决摘要 ?? \"协作卡待主控裁决（未落队列）。\"}${scanNote}${审计告警}`, result };\t});\n}\n","ops":[{"diffOp":{"equal":{"range":[0,118]}}},{"equalLines":{"line_count":289}},{"diffOp":{"equal":{"range":[118,287]}}},{"diffOp":{"delete":{"range":[287,288]}}},{"diffOp":{"insert":{"range":[288,293]}}},{"diffOp":{"equal":{"range":[293,304]}}},{"diffOp":{"delete":{"range":[287,288]}}},{"diffOp":{"insert":{"range":[288,293]}}},{"diffOp":{"equal":{"range":[304,412]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[412,467]}}},{"diffOp":{"delete":{"range":[287,288]}}},{"diffOp":{"insert":{"range":[288,292]}}},{"diffOp":{"equal":{"range":[293,304]}}},{"diffOp":{"delete":{"range":[287,288]}}},{"diffOp":{"insert":{"range":[288,292]}}},{"diffOp":{"equal":{"range":[467,695]}}},{"equalLines":{"line_count":119}},{"diffOp":{"equal":{"range":[695,702]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\collab\\index.ts"},"span":null,"sourceCode":"/**\n * pao 协作卡中转（卡0005）：协作卡星型中转的机械校验放行 ＋ /派 用户快捷建卡。\n *\n * 导出两层：\n * - registerCollab(pi, options)：注册 pao_collab_relay 工具与 /派 命令（注册给主控会话；无 worker 再派发入口）；\n * - 纯库函数与类型：校验协作卡 / 落协作卡 / 审计追加。\n */\nimport { isAbsolute, join, resolve } from \"node:path\";\nimport { type Static, Type } from \"typebox\";\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport { loadCardBodyTemplate, resolveCardTemplatePath } from \"../cards/cardfile.ts\";\nimport { createCard, formatCardNumber, parseCardRef, scanCards } from \"../cards/index.ts\";\nimport type { ParsedCard } from \"../cards/types.ts\";\nimport { CARD_PRIORITIES, CARD_TIERS } from \"../cards/types.ts\";\nimport { addPaoSubcommand } from \"../command-router.ts\";\nimport { DEPT_DIR_NAME, type DeptRegistryRow, REGISTRY_FILE_NAME, readRegistry } from \"../dept/index.ts\";\nimport { type FrictionEventIdentity, recordFrictionDraft } from \"../friction/drafts.ts\";\nimport { resolveMemoryScope } from \"../memory/project-identity.ts\";\nimport { resolvePaoHome } from \"../routing/config.ts\";\nimport { withFileLock } from \"../shared/lock.ts\";\nimport { nowString } from \"../shared/time.ts\";\nimport { auditAppend, type CollabAuditRecord, USER_DIRECT_VERDICT } from \"./audit.ts\";\nimport { writeCollabCard } from \"./dispatch.ts\";\nimport {\n\ttype CollabCardDraft,\n\ttype CollabRejectionReason,\n\ttype CollabReviewResult,\n\tvalidateCollabCard,\n} from \"./review.ts\";\n\nexport * from \"./audit.ts\";\nexport * from \"./dispatch.ts\";\nexport * from \"./review.ts\";\n\n/** pao_collab_relay 工具的注册与路径解析配置；全部路径注入，不硬编码。 */\nexport interface CollabToolsOptions {\n\t/** 当前任务工作区卡目录（与 A 卡工具同款注入）；缺省时工具与 /pao collab 都给配置缺失提示 */\n\tresolveCardsDir?: () => string;\n\t/**\n\t * 目标部门卡目录解析；缺省＝与 resolveCardsDir 同一卡目录\n\t * （§2.1 平铺布局：卡/ 内部门以 frontmatter.部门 区分，/队列 按部门分组）。\n\t */\n\tresolveDeptCardsDir?: (dept: string) => string;\n\t/** 审计 JSONL 路径；缺省 <卡目录>/../协作审计.jsonl（任务工作区根） */\n\tresolveAuditPath?: () => string;\n\t/** 部门注册表路径；缺省 $PAO_HOME/部门/注册表.md */\n\tresolveRegistryPath?: () => string;\n\t/** PAO_HOME 解析（协作卡「模板」按名查 <PAO_HOME>/pao配置/卡模板/）；未注入时模板名不可用 */\n\tresolvePaoHome?: () => string;\n}\n\nfunction formatReasons(result: CollabReviewResult): string {\n\treturn result.原因.map((reason) => `- [${reason.类型}] ${reason.说明}`).join(\"\\n\");\n}\n\n// ============================================================================\n// pao_collab_relay\n// ============================================================================\n\nconst collabParams = Type.Object({\n\tgoal: Type.String({ description: \"一句话目标\" }),\n\tdept: Type.String({ description: \"目标部门名（须在部门注册表中）\" }),\n\tacceptance: Type.String({ description: \"可判验收条件，尽量机械化\" }),\n\tparent: Type.String({ description: \"归属父卡引用（卡#N）：发起方自己那张卡；协作卡必填\" }),\n\tinputs: Type.Optional(Type.Array(Type.String(), { description: \"指针列表：路径/卡#N/知识库条目，不装内容\" })),\n\tconstraints: Type.Optional(Type.String({ description: \"引用规则文件，不复述标准\" })),\n\tdepends_on: Type.Optional(Type.Array(Type.String(), { description: \"前置卡引用（卡#N），全部已交付才放行\" })),\n\ttemplate: Type.Optional(\n\t\tType.String({\n\t\t\tdescription:\n\t\t\t\t\"已批准模板名（M2-09 卡模板库，只收 PAO_HOME/pao配置/卡模板/ 库内名字，不收任意路径）：模板正文骨架（机械验收句式＋约束引用）带入卡正文——模板绑定既有授权范围，字段填齐不扩大授权\",\n\t\t}),\n\t),\n\ttier: Type.Optional(\n\t\tType.Union(\n\t\t\tCARD_TIERS.map((tier) => Type.Literal(tier)),\n\t\t\t{ description: \"模型档位：快/主力\" },\n\t\t),\n\t),\n\tbudget: Type.Optional(\n\t\tType.Object({\n\t\t\tturns: Type.Optional(Type.Number()),\n\t\t\ttoolCalls: Type.Optional(Type.Integer({ minimum: 0 })),\n\t\t\tcost: Type.Optional(Type.Number()),\n\t\t\tcollab_quota: Type.Optional(Type.Number()),\n\t\t}),\n\t),\n\tpriority: Type.Optional(\n\t\tType.Union(\n\t\t\tCARD_PRIORITIES.map((p) => Type.Literal(p)),\n\t\t\t{ description: \"高/中/低，缺省中\" },\n\t\t),\n\t),\n\tsource_dept: Type.Optional(Type.String({ description: \"起草部门（审计用）；主控代递交时填「主控」，缺省同\" })),\n\tjump_queue: Type.Optional(\n\t\tType.String({ description: \"裁决标记声明：请求插队及理由。声明后机械放行失效，转主控裁决\" }),\n\t),\n\tnew_permissions: Type.Optional(\n\t\tType.String({ description: \"裁决标记声明：所需新权限及说明。声明后机械放行失效，转主控裁决\" }),\n\t),\n\tbudget_override: Type.Optional(\n\t\tType.String({ description: \"裁决标记声明：超出父卡预算池的覆写请求。声明后机械放行失效，转主控裁决\" }),\n\t),\n\tacceptance_dispute: Type.Optional(\n\t\tType.String({ description: \"裁决标记声明：验收条件何处存疑。声明后机械放行失效，转主控裁决\" }),\n\t),\n\tcards_dir: Type.Optional(Type.String({ description: \"既有卡所在的任务工作区卡目录；已配置默认卡目录时可省略\" })),\n});\n\ntype CollabRelayParams = Static<typeof collabParams>;\n\nfunction toDraft(params: CollabRelayParams): CollabCardDraft {\n\treturn {\n\t\t目标: params.goal,\n\t\t部门: params.dept,\n\t\t验收: params.acceptance,\n\t\tparent: params.parent,\n\t\t输入: params.inputs,\n\t\t约束: params.constraints,\n\t\tdepends_on: params.depends_on,\n\t\t模板: params.template,\n\t\t档位: params.tier,\n\t\t预算: params.budget,\n\t\t优先级: params.priority,\n\t\t插队: params.jump_queue,\n\t\t新权限: params.new_permissions,\n\t\t超预算覆写: params.budget_override,\n\t\t验收存疑: params.acceptance_dispute,\n\t};\n}\n\n/**\n * 解析协作卡的「模板」为已批准模板正文（§8.2 机械条件「用已批准模板」，M2-02 绑定授权范围）。\n * 只收已批准模板库（<PAO_HOME>/pao配置/卡模板/）内的模板名；绝对路径一律拒——\n * 任意路径＝任意内容＝让「字段填齐」成为任意操作的通行证，与绑定既有授权范围相悖。\n * 返回 { 正文 } 或 { 拒绝原因 }；本函数只读文件，不落任何改动。\n */\nfunction resolveApprovedTemplateBody(\n\ttemplate: string,\n\tpaoHome?: string,\n): { 正文: string } | { 拒绝原因: CollabRejectionReason } {\n\tconst trimmed = template.trim();\n\tif (trimmed.length === 0) {\n\t\treturn { 拒绝原因: { 类型: \"模板未批准\", 字段: \"模板\", 说明: \"模板参数为空白\" } };\n\t}\n\tif (isAbsolute(trimmed)) {\n\t\treturn {\n\t\t\t拒绝原因: {\n\t\t\t\t类型: \"模板未批准\",\n\t\t\t\t字段: \"模板\",\n\t\t\t\t说明: `协作卡的模板只收已批准模板库内的模板名（PAO_HOME/pao配置/卡模板/），不收绝对路径「${trimmed}」——模板绑定既有授权范围，不接受来路不明的正文`,\n\t\t\t},\n\t\t};\n\t}\n\ttry {\n\t\tconst path = resolveCardTemplatePath(trimmed, paoHome);\n\t\t// 相对路径穿越防线：解析后的路径必须仍落在模板库目录内\n\t\t//（resolveCardTemplatePath 的 join 不拦 ../../，库外 .md 不得混进「已批准」出处）\n\t\tconst libDir = resolve((paoHome ?? \"\").trim(), \"pao配置\", \"卡模板\");\n\t\tconst normalize = (value: string): string[] => value.split(/[\\\\/]/).filter(Boolean);\n\t\tconst parsed = normalize(path).join(\"/\");\n\t\tconst libPrefix = normalize(libDir).join(\"/\");\n\t\tif (!parsed.startsWith(`${libPrefix}/`) || parsed.slice(libPrefix.length + 1).includes(\"..\")) {\n\t\t\treturn {\n\t\t\t\t拒绝原因: {\n\t\t\t\t\t类型: \"模板未批准\",\n\t\t\t\t\t字段: \"模板\",\n\t\t\t\t\t说明: `模板「${trimmed}」解析后越出已批准模板库（${libDir}），拒绝——协作卡模板只收库内名字`,\n\t\t\t\t},\n\t\t\t};\n\t\t}\n\t\tconst body = loadCardBodyTemplate(path);\n\t\tif (body.trim().length === 0) {\n\t\t\treturn {\n\t\t\t\t拒绝原因: {\n\t\t\t\t\t类型: \"模板未批准\",\n\t\t\t\t\t字段: \"模板\",\n\t\t\t\t\t说明: `模板「${trimmed}」没有正文骨架（只有 frontmatter 的文件不算已批准模板）`,\n\t\t\t\t},\n\t\t\t};\n\t\t}\n\t\treturn { 正文: body };\n\t} catch (error) {\n\t\treturn {\n\t\t\t拒绝原因: {\n\t\t\t\t类型: \"模板未批准\",\n\t\t\t\t字段: \"模板\",\n\t\t\t\t说明: `模板「${trimmed}」不是可用的已批准模板：${error instanceof Error ? error.message : String(error)}`,\n\t\t\t},\n\t\t};\n\t}\n}\n\nasync function executeCollabRelay(\n\tparams: CollabRelayParams,\n\toptions: CollabToolsOptions,\n\tidentity?: FrictionEventIdentity,\n): Promise<{ text: string; result: CollabReviewResult }> {\n\tconst cardsDir = params.cards_dir ?? options.resolveCardsDir?.();\n\tif (!cardsDir) {\n\t\tthrow new Error(\"[INVALID_CARD] 缺少 cards_dir 参数，且未配置默认卡目录（CollabToolsOptions.resolveCardsDir）\");\n\t}\n\tconst registryPath = options.resolveRegistryPath?.() ?? join(resolvePaoHome(), DEPT_DIR_NAME, REGISTRY_FILE_NAME);\n\tconst targetDir = options.resolveDeptCardsDir?.(params.dept) ?? cardsDir;\n\tconst registry: DeptRegistryRow[] = readRegistry(registryPath);\n\tconst now = nowString();\n\tconst auditPath = options.resolveAuditPath?.() ?? join(cardsDir, \"..\", \"协作审计.jsonl\");\n\n\t// 审查第 8 项：读卡查重、配额校验与落卡必须在同一个跨进程临界区内完成。旧实现先读卡校验、\n\t// 再异步建卡，两个主控会话可同时看到「尚未建卡」而各落一张子卡（配额形同虚设）。\n\t// 锁挂在主卡目录上、与发号器的卡号锁不是同一把，避免嵌套卡号锁死锁。\n\tconst 落卡 = await withFileLock(join(cardsDir, \"协作落卡.txt\"), async () => {\n\t\t// 既有卡状态：当前卡目录＋目标卡目录（分目录布局时合并；平铺布局两者相同）\n\t\tconst primaryScan = scanCards(cardsDir);\n\t\tconst targetScan = targetDir === cardsDir ? { cards: [], problems: [] } : scanCards(targetDir);\n\t\tconst existingCardStatus: ParsedCard[] = [...primaryScan.cards, ...targetScan.cards];\n\t\tconst scanProblems = [...primaryScan.problems, ...targetScan.problems];\n\t\t// 坏卡读不出来时查重结论必然不完整：显式披露，别让「放行」看着像查过全部卡（审查第 5 项）\n\t\tconst scanNote =\n\t\t\tscanProblems.length > 0\n\t\t\t\t? `\\n注意：有 ${scanProblems.length} 张卡读不出来，本次查重未包含它们：${scanProblems.map((p) => `${p.path}（${p.reason}）`).join(\"；\")}`\n\t\t\t\t: \"\";\n\t\tconst draft = toDraft(params);\n\t\tlet result = validateCollabCard(draft, registry, existingCardStatus);\n\t\t// 已批准模板（§8.2 机械条件之一）：文件系统校验在工具层做，拒绝并入机械校验结果同一结构\n\t\tlet templateBody: string | undefined;\n\t\tif (typeof params.template === \"string\") {\n\t\t\tconst parsed = resolveApprovedTemplateBody(params.template, options.resolvePaoHome?.());\n\t\t\tif (\"拒绝原因\" in parsed) {\n\t\t\t\tresult = { ...result, 裁决: \"拒绝\", 原因: [...result.原因, parsed.拒绝原因] };\n\t\t\t} else {\n\t\t\t\ttemplateBody = parsed.正文;\n\t\t\t}\n\t\t}\n\t\tif (result.裁决 !== \"放行\") return { result, scanNote, created: undefined as ParsedCard | undefined };\n\t\tconst created = await writeCollabCard(targetDir, draft, now, { 模板正文: templateBody });\n\t\treturn { result, scanNote, created };\n\t});\n\tconst { result, scanNote, created } = 落卡;\n\n\tif (created) {\n\t\tconst record: CollabAuditRecord = {\n\t\t\t时间: now,\n\t\t\t来源部门: params.source_dept?.trim() || \"主控\",\n\t\t\t目标部门: params.dept,\n\t\t\t卡号: created.card_no,\n\t\t\t校验结果: \"放行\",\n\t\t\t目标: params.goal,\n\t\t};\n\t\t// 审查第 15 项：卡已落盘、审计只是旁挂留痕。审计失败必须如实报「卡已创建＋审计失败」，\n\t\t// 不能只抛一个笼统失败——调用方重试会再落一张子卡（与 /派 用户直派分支同款处理）。\n\t\ttry {\n\t\t\tawait auditAppend(auditPath, record);\n\t\t} catch (error) {\n\t\t\tconst reason = error instanceof Error ? error.message : String(error);\n\t\t\treturn {\n\t\t\t\ttext: `机械校验通过，已落目标部门队列：${created.filename}（${targetDir}），状态 unclaimed，parent=${params.parent}。（审计写入失败：${reason}；卡号 ${formatCardNumber(created.card_no)} 已创建，不要重复派卡）${scanNote}`,\n\t\t\t\tresult,\n\t\t\t};\n\t\t}\n\t\treturn {\n\t\t\ttext: `机械校验通过，已落目标部门队列：${created.filename}（${targetDir}），状态 unclaimed，parent=${params.parent}。主控可经 /pao queue 查看。${scanNote}`,\n\t\t\tresult,\n\t\t};\n\t}\n\n\tconst record: CollabAuditRecord = {\n\t\t时间: now,\n\t\t来源部门: params.source_dept?.trim() || \"主控\",\n\t\t目标部门: params.dept,\n\t\t卡号: result.已有卡号 ?? null,\n\t\t校验结果: result.裁决,\n\t\t目标: params.goal,\n\t\t原因:\n\t\t\tresult.裁决 === \"拒绝\"\n\t\t\t\t? result.原因.map((r) => `[${r.类型}] ${r.说明}`)\n\t\t\t\t: Object.entries(result.裁决声明).map(([flag, description]) => `${flag}：${description}`),\n\t};\n\t// 未落卡的裁决也留审计；这里没有已创建的卡，审计失败只如实附注，不影响裁决本身的结论\n\tlet 审计告警 = \"\";\n\ttry {\n\t\tawait auditAppend(auditPath, record);\n\t} catch (error) {\n\t\t审计告警 = `\\n（审计写入失败：${error instanceof Error ? error.message : String(error)}）`;\n\t}\n\tif (result.裁决 === \"拒绝\") {\n\t\t// 打回（M0-08）：协作卡递交被机械校验拒绝＝审核打回的落定点；草稿失败不抛（recordFrictionDraft 内部已兜）\n\t\tawait recordFrictionDraft(\n\t\t\t\"打回\",\n\t\t\tresult.已有卡号 !== undefined ? formatCardNumber(result.已有卡号) : \"无\",\n\t\t\t`协作卡递交被机械校验拒绝：${result.原因.map((r) => `[${r.类型}] ${r.说明}`).join(\"；\")}`,\n\t\t\tcardsDir,\n\t\t\t// 打回/升级人是同一次工具调用的两种落点——eventId 用调用 ID，\n\t\t\t// 同一调用重报同值幂等（O10/E02）。\n\t\t\tidentity === undefined ? undefined : { ...identity, eventId: `${identity.toolCallId ?? identity.eventId ?? \"collab\"}:打回` },\n\t\t);\n\t\treturn {\n\t\t\ttext: `协作卡已拒绝（未落队列），原因：\\n${formatReasons(result)}\\n补齐/修正后可重新递交。${scanNote}${审计告警}`,\n\t\t\tresult,\n\t\t};\n\t}\n\t// 升级人（M0-08）：机械校验全过但带裁决标记、不落队列转主控裁决＝交人工处理的落定点\n\tawait recordFrictionDraft(\n\t\t\"升级人\",\n\t\tformatCardNumber(parseCardRef(params.parent)),\n\t\t`协作卡带裁决标记转主控裁决：${Object.entries(result.裁决声明)\n\t\t\t.map(([flag, description]) => `${flag}：${description}`)\n\t\t\t.join(\"；\")}`,\n\t\tcardsDir,\n\t\tidentity === undefined ? undefined : { ...identity, eventId: `${identity.toolCallId ?? identity.eventId ?? \"collab\"}:升级人` },\n\t);\n\treturn { text: `${result.裁决摘要 ?? \"协作卡待主控裁决（未落队列）。\"}${scanNote}${审计告警}`, result };\n}\n\n// ============================================================================\n// /派 命令\n// ============================================================================\n\nconst DISPATCH_USAGE = [\n\t\"用法：/pao collab 目标 | 部门 | 验收\",\n\t\"或：/pao collab 目标 | 部门 | 输入指针（多个用顿号分隔） | 验收\",\n\t\"例：/pao collab 修好登录超时 | 后端 | src/login.ts 第 40 行的超时设置 | 全部登录测试绿\",\n].join(\"\\n\");\n\n/**\n * /派 用户快捷建卡（架构 §3：直接落卡，主控零参与——用户＝最高授权，机械中转不拦用户）。\n * M2-02 补齐：落卡同样留审计（校验结果＝用户直派），审计线不缺用户直派的账；\n * 审计写入失败不回滚落卡，只在回执文本上如实标注（卡是任务真相，审计是旁挂留痕）。\n */\nasync function executeDispatch(\n\targs: string,\n\tcardsDir: string | undefined,\n\toptions: CollabToolsOptions,\n): Promise<string> {\n\tif (!cardsDir) {\n\t\treturn `未配置默认卡目录（CollabToolsOptions.resolveCardsDir），无法落卡。\\n${DISPATCH_USAGE}`;\n\t}\n\tconst parts = args.split(\"|\").map((part) => part.trim());\n\tif (\n\t\t(parts.length !== 3 && parts.length !== 4) ||\n\t\tparts[0] === \"\" ||\n\t\tparts[1] === \"\" ||\n\t\tparts[parts.length - 1] === \"\"\n\t) {\n\t\treturn `参数不全，未落卡（不落半残卡）。\\n${DISPATCH_USAGE}`;\n\t}\n\tconst [goal, dept, third, fourth] = parts;\n\tconst input =\n\t\tfourth === undefined\n\t\t\t? []\n\t\t\t: third\n\t\t\t\t\t.split(/[、,，;；]/)\n\t\t\t\t\t.map((s) => s.trim())\n\t\t\t\t\t.filter(Boolean);\n\tconst acceptance = fourth ?? third;\n\tconst card = await createCard(cardsDir, {\n\t\t目标: goal,\n\t\t部门: dept,\n\t\t验收: acceptance,\n\t\t输入: input,\n\t\t创建: nowString(),\n\t});\n\tconst record: CollabAuditRecord = {\n\t\t时间: nowString(),\n\t\t来源部门: \"用户\",\n\t\t目标部门: dept,\n\t\t卡号: card.card_no,\n\t\t校验结果: USER_DIRECT_VERDICT,\n\t\t目标: goal,\n\t};\n\ttry {\n\t\tawait auditAppend(options.resolveAuditPath?.() ?? join(cardsDir, \"..\", \"协作审计.jsonl\"), record);\n\t\treturn `已派卡：${card.filename}（${cardsDir}），状态 unclaimed，部门「${dept}」。`;\n\t} catch (error) {\n\t\tconst reason = error instanceof Error ? error.message : String(error);\n\t\treturn `已派卡：${card.filename}（${cardsDir}），状态 unclaimed，部门「${dept}」。（审计写入失败：${reason}）`;\n\t}\n}\n\n// ============================================================================\n// 注册入口\n// ============================================================================\n\n/**\n * 注册协作中转工具与 /派 命令（注册给主控会话；worker 装载清单不装本模块即无再派发入口）。\n * 工具：pao_collab_relay（协作卡机械校验 → 放行落队列 / 拒绝 / 待主控裁决，全程留审计）。\n * 命令：/派（用户快捷建卡，直接落当前任务工作区卡目录，主控零参与）。\n */\nexport function registerCollab(pi: ExtensionAPI, options: CollabToolsOptions = {}): void {\n\tpi.registerTool({\n\t\tname: \"pao_collab_relay\",\n\t\tlabel: \"协作中转\",\n\t\tdescription:\n\t\t\t\"协作卡星型中转正门：对部门起草的协作卡（带 parent）做机械校验——部门在注册表、信封字段齐全、协作配额未超（默认 2，父卡可覆写）、依赖全部已交付、同 parent 同目标无活卡（幂等）、协作卡不得再生协作卡；通过即落目标部门队列并留审计（JSONL）。带插队/新权限/超预算覆写/验收存疑任一裁决标记时不落队列，返回裁决摘要交主控判断。\",\n\t\tparameters: collabParams,\n\t\texecute: async (toolCallId, params, _signal, _onUpdate, ctx) => {\n\t\t\t// O10/E02：把真实会话身份沿调用链传给摩擦草稿——projectId 由\n\t\t\t// ctx.cwd + sessionId 推 scope（与记忆工具同口径），不猜全局；\n\t\t\t// ctx 缺省（测试/宿主注入）时身份从简，evidenceRef 仍能按场景+卡号去重。\n\t\t\tconst sessionId = ctx?.sessionManager?.getSessionId?.();\n\t\t\tconst scope =\n\t\t\t\tctx?.cwd === undefined\n\t\t\t\t\t? undefined\n\t\t\t\t\t: resolveMemoryScope(ctx.cwd, { ...(sessionId === undefined ? {} : { sessionId }) }, resolvePaoHome());\n\t\t\tconst { text, result } = await executeCollabRelay(params, options, {\n\t\t\t\t...(scope === undefined ? {} : { projectId: scope.projectId }),\n\t\t\t\t...(scope?.taskId === undefined ? {} : { taskId: scope.taskId }),\n\t\t\t\t...(sessionId === undefined ? {} : { sessionId }),\n\t\t\t\ttoolCallId,\n\t\t\t});\n\t\t\treturn { content: [{ type: \"text\", text }], details: result };\n\t\t},\n\t});\n\n\taddPaoSubcommand(pi, {\n\t\tname: \"collab\",\n\t\tlabel: \"协作建卡\",\n\t\tdescription: \"快捷建卡：直接落到当前任务工作区卡目录（不经主控裁决）\",\n\t\trun: async (pi, args) => {\n\t\t\tlet text: string;\n\t\t\ttry {\n\t\t\t\ttext = await executeDispatch(args, options.resolveCardsDir?.(), options);\n\t\t\t} catch (error) {\n\t\t\t\ttext = String(error);\n\t\t\t}\n\t\t\tpi.sendMessage({\n\t\t\t\tcustomType: \"pao-dispatch\",\n\t\t\t\tcontent: [{ type: \"text\", text }],\n\t\t\t\tdisplay: true,\n\t\t\t});\n\t\t},\n\t});\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 桌面侧任务绑定装配桥（S9-04/05 装配侧）。\n *import { openMemoryStore } from \"../memory/store.ts\";\nimport { switchTaskResourceAtSafePoint, type SwitchTaskResourceResult } from \"../evolution/binding.ts\";\nimport { \n\tensureTaskBindings,resolveTaskBoundResourcePaths,type TaskBoundResourcePaths,\n} from \"../evolution/host-mount.ts\";\nimport { recoverEvolutionState, type RecoveryReport } from \"../evolution/recovery.ts\";\n\nexport type {MissingTaskBinding,MountedTaskResource,SkippedTaskBinding,TaskBoundResourcePaths} from \"../evolution/host-mount.ts\";\nexport type { SwitchTaskResourceResult } from \"../evolution/binding.ts\";\n\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[67,233]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[236,255]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[255,285]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[285,312]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[312,314]}}},{"diffOp":{"equal":{"range":[314,452]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[452,471]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[471,491]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[491,510]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[234,236]}}},{"diffOp":{"equal":{"range":[510,532]}}},{"diffOp":{"delete":{"range":[233,234]}}},{"diffOp":{"insert":{"range":[312,314]}}},{"diffOp":{"equal":{"range":[532,642]}}},{"equalLines":{"line_count":87}},{"diffOp":{"equal":{"range":[642,647]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\desktop\\host-mount.ts"},"span":null,"sourceCode":"/**\n * 桌面侧任务绑定装配桥（S9-04/05 装配侧）。\n *\n * `resolveDesktopTaskBoundPaths`：会话装配前把该任务的 active 绑定解析成\n * 要挂进 resourceLoaderOptions 的版本目录清单。store 生命周期在本门面内\n * 开闭——与 `pao/desktop/memory.ts` 各读桥同口径（宿主不直接碰 store）。\n *\n * 语义同 `evolution/host-mount.ts`：\n * - `taskId = sessionId`；只接 skill-path/extension-path 两类，其余四类进\n *   `skipped`；版本目录缺失进 `missing`（宿主降级沿用资源根，不挂死路径）。\n * - 库未建（memory.sqlite 不存在）→ 返回全空清单：该现场还没做过进化\n *   登记，等同无绑定，不拿裸 SQLite 错当业务结果。\n */\nimport { existsSync } from \"node:fs\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport { memoryPaths } from \"../memory/paths.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport { switchTaskResourceAtSafePoint, type SwitchTaskResourceResult } from \"../evolution/binding.ts\";\nimport { ensureTaskBindings, resolveTaskBoundResourcePaths, type TaskBoundResourcePaths } from \"../evolution/host-mount.ts\";\nimport { recoverEvolutionState, type RecoveryReport } from \"../evolution/recovery.ts\";\n\nexport type { MissingTaskBinding, MountedTaskResource, SkippedTaskBinding, TaskBoundResourcePaths } from \"../evolution/host-mount.ts\";\nexport type { SwitchTaskResourceResult } from \"../evolution/binding.ts\";\n\n/**\n * 读任务的绑定版本目录清单（桌面会话装配用）。\n *\n * O13/E14：读写打开——装配前先 ensure 初始绑定（全量已生效资源口径），\n * 再解析成挂载清单；ensure 失败如实上抛（绑定读不出来时静默降级会让\n * 会话拿错版本无留痕）。\n */\nexport function resolveDesktopTaskBoundPaths(input: {\n\ttaskId: string;\n\tpaoHome: string;\n}): MemoryResult<TaskBoundResourcePaths> {\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn { ok: true, skillPaths: [], extensionPaths: [], mounted: [], skipped: [], missing: [] };\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readwrite\");\n\ttry {\n\t\treturn ensureTaskBindings(store, { taskId: input.taskId, paoHome: input.paoHome });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/** `switchDesktopTaskResourceAtSafePoint` 的输出。 */\nexport interface SwitchDesktopTaskResourceResult {\n\t/** 换版事务结果（fromVersion/toVersion/switchHistory）。 */\n\tswitch: SwitchTaskResourceResult;\n\t/** 换版后重新解析的全量挂载清单（调用方据此覆盖 priority paths）。 */\n\tpaths: TaskBoundResourcePaths;\n}\n\n/**\n * 桌面侧安全点换版（写侧）：`switchTaskResourceAtSafePoint` 落绑定换版历史后，\n * 同事务外重读全量挂载清单返回——宿主拿 `paths` 调\n * `loader.updateAdditionalPaths` + 空闲时 `reload` 完成新版本目录生效。\n *\n * 读写打开：本函数是绑定换版的唯一写入口（绑定只在这里改指向）。\n * 库未建 → `invalid_input`（无绑定可换，不开空库）。\n */\nexport function switchDesktopTaskResourceAtSafePoint(input: {\n\ttaskId: string;\n\tresourceId: string;\n\tnewVersionId: string;\n\treason: string;\n\tpaoHome: string;\n}): MemoryResult<SwitchDesktopTaskResourceResult> {\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"记忆库未建立，无绑定可换版\", refId: input.resourceId },\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readwrite\");\n\ttry {\n\t\tconst switched = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: input.taskId,\n\t\t\tresourceId: input.resourceId,\n\t\t\tnewVersionId: input.newVersionId,\n\t\t\treason: input.reason,\n\t\t});\n\t\tif (!switched.ok) return switched;\n\t\tconst paths = resolveTaskBoundResourcePaths(store, { taskId: input.taskId, paoHome: input.paoHome });\n\t\tif (!paths.ok) return paths;\n\t\treturn { ok: true, switch: switched, paths };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\nexport type { RecoveryReport } from \"../evolution/recovery.ts\";\n\n/**\n * S9-11：桌面侧启动恢复检查门面（pi-sdk-driver 经 loadPaoDesktopModule 调用）。\n *\n * 库未建 → 返回空报告（该现场还没做过进化登记，不拿裸 SQLite 错当业务结果）；\n * needsAttention / unfinishedActivations 如实列出由宿主呈现（Notification/日志），\n * 不自动激活、不主动改指向。\n */\nexport function recoverDesktopEvolutionState(input: { paoHome: string }): MemoryResult<RecoveryReport> {\n\tconst empty: RecoveryReport = { resources: [], unfinishedActivations: [], needsAttention: [] };\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn { ok: true, ...empty };\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readonly\");\n\ttry {\n\t\treturn recoverEvolutionState(store, { paoHome: input.paoHome });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports