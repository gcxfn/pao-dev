: data.path,\n\t\t\t\tcompressed: data.compressed,\n\t\t\t\ttargets: sourceTargetsFromMap(selectors, targetIds),\n\t\t\t\treason: `归档段在受管目录之外:${data.path}`,\n\t\t\t\tdone: false,\n\t\t\t});\n\t\t\tcontinue;\n\t\t}\n\t\tarchives.push({\n\t\t\tsegmentId,\n\t\t\tsessionId,\n\t\t\tpath: data.path,\n\t\t\tcompressed: data.compressed,\n\t\t\ttargets: sourceTargetsFromMap(selectors, targetIds),\n\t\t\t...(derivedScanReason === undefined ? {} : { reason: derivedScanReason }),\n\t\t\tdone: false,\n\t\t});\n\t}\n\n\tfor (const [segmentId, reason] of archiveScanReasons) {\n\t\tif (archiveTargets.has(segmentId)) continue;\n\t\tconst segment = segmentDbRow(db, segmentId);\n\t\tarchives.push({\n\t\t\tsegmentId,\n\t\t\tsessionId: segment?.session_id ?? \"\",\n\t\t\tcompressed: false,\n\t\t\t...(segment?.compressed_path\n\t\t\t\t? { path: segment.compressed_path, compressed: true }\n\t\t\t\t: segment?.original_path\n\t\t\t\t\t? { path: segment.original_path, compressed: false }\n\t\t\t\t\t: {}),\n\t\t\ttargets: [],\n\t\t\treason,\n\t\t\tdone: false,\n\t\t});\n\t}\n\n\tconst attachmentScan = findManagedAttachments(archivesRoot, archives);\n\tconst attachments: StoredAttachmentPlan[] = [\n\t\t...attachmentScan.paths.map((path) => ({ path, done: false })),\n\t\t...attachmentScan.unmanaged.map((item) => ({\n\t\t\tpath: item.path,\n\t\t\treason: `附件引用不在受管附件目录:${item.path}`,\n\t\t\tdone: false,\n\t\t})),\n\t];\n\tconst plan: StoredDeletionPlan = {\n\t\tversion: OPERATION_VERSION,\n\t\ttargets: targetRows.map((row) => ({\n\t\t\tmemoryId: row.id,\n\t\t\trevision: row.current_revision,\n\t\t\tprojectId: parseScope(row.scope_json).projectId,\n\t\t})),\n\t\tsources: sources.sort((left, right) => left.sourceId.localeCompare(right.sourceId)),\n\t\tsessions: sessions.sort((left, right) => left.sessionId.localeCompare(right.sessionId)),\n\t\tarchives: archives.sort((left, right) => left.segmentId.localeCompare(right.segmentId)),\n\t\tattachments,\n\t\tsourceRowsToDelete: [\n\t\t\t...new Set([\n\t\t\t\t...sources.filter((source) => source.action === \"redact\").map((source) => source.sourceId),\n\t\t\t\t...derivedSourceRowsToDelete,\n\t\t\t]),\n\t\t].sort(),\n\t\tdatabaseDone: false,\n\t};\n\treturn { plan, missingMemoryIds, referencedBy, unmanagedSources };\n}\n\nfunction planPendingObjects(plan: StoredDeletionPlan, includeDatabase = true): DeletionPendingObject[] {\n\tconst pending: DeletionPendingObject[] = [];\n\tif (includeDatabase && !plan.databaseDone) {\n\t\tpending.push({ kind: \"database\", reason: \"数据库清理尚未完成\" });\n\t}\n\tfor (const source of plan.sources) {\n\t\tif (source.resolution === \"unknown\") {\n\t\t\tpending.push({\n\t\t\t\tkind: \"session\",\n\t\t\t\tsessionId: source.sessionId || undefined,\n\t\t\t\tsourceId: source.sourceId,\n\t\t\t\tentryId: source.entryId || undefined,\n\t\t\t\treason: \"来源没有可确认的受管会话或归档身份\",\n\t\t\t});\n\t\t} else if (source.action === \"redact\" && source.resolution === \"archive-only\" && !source.segmentId) {\n\t\t\tpending.push({\n\t\t\t\tkind: \"archive\",\n\t\t\t\tsessionId: source.sessionId || undefined,\n\t\t\t\tsourceId: source.sourceId,\n\t\t\t\tentryId: source.entryId || undefined,\n\t\t\t\treason: \"归档专属来源没有受管归档段定位\",\n\t\t\t});\n\t\t} else if (source.derivedScanPending) {\n\t\t\tpending.push({\n\t\t\t\tkind: \"session\",\n\t\t\t\tsessionId: source.sessionId || undefined,\n\t\t\t\tsourceId: source.sourceId,\n\t\t\t\tentryId: source.entryId || undefined,\n\t\t\t\treason: source.derivedScanPending,\n\t\t\t});\n\t\t}\n\t}\n\tfor (const archive of plan.archives) {\n\t\tif (!archive.done) {\n\t\t\tpending.push({\n\t\t\t\tkind: \"archive\",\n\t\t\t\tsessionId: archive.sessionId,\n\t\t\t\tsegmentId: archive.segmentId,\n\t\t\t\treason: archive.reason ?? \"归档段尚未重写\",\n\t\t\t});\n\t\t}\n\t}\n\tfor (const session of plan.sessions) {\n\t\tif (!session.done) {\n\t\t\tpending.push({\n\t\t\t\tkind: \"session\",\n\t\t\t\tsessionId: session.sessionId,\n\t\t\t\treason: session.reason ?? \"真实会话条目尚未重写\",\n\t\t\t});\n\t\t}\n\t}\n\tfor (const attachment of plan.attachments) {\n\t\tif (!attachment.done) {\n\t\t\tpending.push({\n\t\t\t\tkind: \"attachment\",\n\t\t\t\treason: attachment.reason ?? `受管附件尚未清理:${attachment.path}`,\n\t\t\t});\n\t\t}\n\t}\n\treturn pending;\n}\n\nfunction sourcesForDto(plan: StoredDeletionPlan): DeletionSourceImpact[] {\n\treturn plan.sources.map((source) => ({\n\t\tsourceId: source.sourceId,\n\t\tsessionId: source.sessionId,\n\t\tentryId: source.entryId,\n\t\teventType: source.eventType,\n\t\tcapturedAt: source.capturedAt,\n\t\tresolution: source.resolution,\n\t\tsharedWithMemoryIds: source.sharedWithMemoryIds,\n\t\taction: source.action,\n\t}));\n}\n\nfunction sessionsForDto(plan: StoredDeletionPlan): DeletionSessionImpact[] {\n\treturn plan.sessions.map((session) => ({\n\t\tsessionId: session.sessionId,\n\t\t...(session.sessionFile === undefined ? {} : { sessionFile: session.sessionFile }),\n\t\tavailability: session.availability,\n\t\tsourceEntryIds: session.sourceEntryIds,\n\t\tderivedEntryIds: session.derivedEntryIds,\n\t\t...(session.reason === undefined ? {} : { reason: session.reason }),\n\t}));\n}\n\nfunction operationDto(\n\trow: Pick<OperationRow, \"operation_id\" | \"status\" | \"scope_json\" | \"pending_json\" | \"created_at\" | \"updated_at\">,\n): DeletionOperationDto {\n\tconst envelope = JSON.parse(row.scope_json) as StoredOperationEnvelope;\n\tconst pending = JSON.parse(row.pending_json ?? \"[]\") as DeletionPendingObject[];\n\treturn {\n\t\toperationId: row.operation_id,\n\t\tstatus: row.status,\n\t\ttargets: envelope.plan.targets.map((target) => ({\n\t\t\tmemoryId: target.memoryId,\n\t\t\trevision: target.revision,\n\t\t\tprojectId: target.projectId,\n\t\t})),\n\t\tprojectIds: [...new Set(envelope.plan.targets.map((target) => target.projectId).filter(Boolean))].sort(),\n\t\tsources: sourcesForDto(envelope.plan),\n\t\tsessions: sessionsForDto(envelope.plan),\n\t\tpendingObjects: pending,\n\t\t...(envelope.failureReason === undefined ? {} : { failureReason: envelope.failureReason }),\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction writeOperation(\n\tdb: DatabaseSync,\n\toperationId: string,\n\tstatus: DeletionStatus,\n\tplan: StoredDeletionPlan,\n\tpending: DeletionPendingObject[],\n\tfailureReason?: string,\n): void {\n\tconst at = nowIso();\n\tconst envelope: StoredOperationEnvelope = {\n\t\tversion: OPERATION_VERSION,\n\t\tplan,\n\t\t...(failureReason === undefined ? {} : { failureReason }),\n\t};\n\tdb.prepare(\n\t\t`INSERT INTO deletion_operations\n\t\t (operation_id, status, scope_json, pending_json, created_at, updated_at)\n\t\t VALUES (?, ?, ?, ?, ?, ?)\n\t\t ON CONFLICT (operation_id) DO UPDATE SET\n\t\t   status = excluded.status,\n\t\t   scope_json = excluded.scope_json,\n\t\t   pending_json = excluded.pending_json,\n\t\t   updated_at = excluded.updated_at`,\n\t).run(operationId, status, JSON.stringify(envelope), JSON.stringify(pending), at, at);\n}\n\nfunction readOperationRow(db: DatabaseSync, operationId: string): OperationRow | undefined {\n\tif (!tableExists(db, \"deletion_operations\")) return undefined;\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT operation_id, status, scope_json, pending_json, created_at, updated_at\n\t\t\t FROM deletion_operations WHERE operation_id = ?`,\n\t\t)\n\t\t.get(operationId) as OperationRow | undefined;\n}\n\nfunction readPlan(row: OperationRow): StoredDeletionPlan {\n\treturn (JSON.parse(row.scope_json) as StoredOperationEnvelope).plan;\n}\n\nfunction finishOperation(\n\tdb: DatabaseSync,\n\toperationId: string,\n\tplan: StoredDeletionPlan,\n\tfailureReason?: string,\n): MemoryResult<DeleteMemoryResult> {\n\tconst pending = planPendingObjects(plan);\n\tconst status: DeletionStatus =\n\t\tfailureReason !== undefined ? \"failed\" : pending.length === 0 ? \"complete\" : \"pending\";\n\twriteOperation(db, operationId, status, plan, pending, failureReason);\n\tconst row = readOperationRow(db, operationId);\n\tif (!row) return fail(\"unavailable\", `删除操作写入后不可读:${operationId}`, { refId: operationId });\n\treturn { ok: true, ...operationDto(row) };\n}\n\nfunction validateRevisionSnapshot(db: DatabaseSync, plan: StoredDeletionPlan): string | undefined {\n\tfor (const target of plan.targets) {\n\t\tconst row = memoryRow(db, target.memoryId);\n\t\tif (!row) return `目标记忆不存在或已删除:${target.memoryId}`;\n\t\tif (row.current_revision !== target.revision) {\n\t\t\treturn `修订号已变化:${target.memoryId} 预览 rev-${target.revision},当前 rev-${row.current_revision}，需重新 preview`;\n\t\t}\n\t}\n\treturn undefined;\n}\n\nfunction sourceGraphChanged(db: DatabaseSync, plan: StoredDeletionPlan): string | undefined {\n\tconst targetSet = new Set(plan.targets.map((target) => target.memoryId));\n\tfor (const source of plan.sources.filter((item) => item.action === \"redact\")) {\n\t\tconst external = sourceMemoryIds(db, source.sourceId).filter((memoryId) => !targetSet.has(memoryId));\n\t\tif (external.length > 0) {\n\t\t\treturn `来源 ${source.sourceId} 在预览后新增外部引用:${external.join(\"、\")}，需重新 preview`;\n\t\t}\n\t}\n\treturn undefined;\n}\n\nasync function validateSessionControl(\n\tdb: DatabaseSync,\n\tarchivesRoot: string,\n\tplan: StoredDeletionPlan,\n\tprepareBlocked: ReadonlySet<string>,\n): Promise<boolean> {\n\tconst paoHome = paoHomeFromArchives(archivesRoot);\n\tlet blocked = prepareBlocked.size > 0;\n\tfor (const session of plan.sessions) {\n\t\tif (session.done) continue;\n\t\tif (\n\t\t\tprepareBlocked.has(session.sessionId) ||\n\t\t\t!session.scanComplete ||\n\t\t\t!session.sessionFile ||\n\t\t\t!existsSync(session.sessionFile)\n\t\t)\n\t\t\tcontinue;\n\t\tlet control: Awaited<ReturnType<typeof acquireSessionControl>> | undefined;\n\t\ttry {\n\t\t\tcontrol = await acquireSessionControl({\n\t\t\t\tpaoHome,\n\t\t\t\tsessionId: session.sessionId,\n\t\t\t\tsurface: \"memory-deletion\",\n\t\t\t});\n\t\t\tcontrol.assertOwned();\n\t\t\tawait control.release();\n\t\t\tcontrol = undefined;\n\t\t} catch (error) {\n\t\t\tblocked = true;\n\t\t\tsession.reason = `会话仍由活动或外部 writer 占用，未进入删除执行:${error instanceof Error ? error.message : String(error)}`;\n\t\t\tif (control) {\n\t\t\t\ttry {\n\t\t\t\t\tawait control.release();\n\t\t\t\t} catch {\n\t\t\t\t\t// 保留占用或释放失败的原始原因。\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tif (!plan.databaseDone) {\n\t\tconst conclusions = conclusionsForTargets(\n\t\t\tdb,\n\t\t\tplan.targets.map((target) => target.memoryId),\n\t\t);\n\t\tfor (const session of plan.sessions) {\n\t\t\tif (!session.scanComplete || !session.sessionFile) continue;\n\t\t\ttry {\n\t\t\t\tsession.derivedEntryIds = [\n\t\t\t\t\t...new Set([\n\t\t\t\t\t\t...session.derivedEntryIds,\n\t\t\t\t\t\t...findDerivedMemoryEntryIds(\n\t\t\t\t\t\t\treadSessionEntries(session.sessionFile),\n\t\t\t\t\t\t\tsession.memoryIds,\n\t\t\t\t\t\t\tconclusions,\n\t\t\t\t\t\t\tsession.sourceEntryIds,\n\t\t\t\t\t\t\tsession.referenceEntryIds ?? session.sourceEntryIds,\n\t\t\t\t\t\t),\n\t\t\t\t\t]),\n\t\t\t\t];\n\t\t\t} catch (error) {\n\t\t\t\tsession.reason = `数据库清理前重新扫描会话失败:${error instanceof Error ? error.message : String(error)}`;\n\t\t\t\tblocked = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn blocked;\n}\n\n/**\n * 在控制权验证和数据库清理前停止真实宿主会话。只有成功执行 prepare 的会话\n * 才进入 finally 重载；close 失败时也先恢复宿主，再由调用方保持 pending。\n */\nasync function prepareHostSessions(\n\tplan: StoredDeletionPlan,\n\tcoordinator?: DeletionSessionCoordinator,\n): Promise<PreparedHostSessions> {\n\tconst prepared: PreparedHostSessions = { reload: [], blocked: new Set() };\n\tif (!coordinator) return prepared;\n\tfor (const session of plan.sessions) {\n\t\tif (session.done) continue;\n\t\tif (!session.scanComplete || !session.sessionFile || !existsSync(session.sessionFile)) continue;\n\t\ttry {\n\t\t\tawait coordinator.prepare(session);\n\t\t\tprepared.reload.push(session);\n\t\t\tawait coordinator.close(session);\n\t\t\tdelete session.reason;\n\t\t} catch (error) {\n\t\t\tprepared.blocked.add(session.sessionId);\n\t\t\tsession.reason = `宿主会话安全停止失败:${error instanceof Error ? error.message : String(error)}`;\n\t\t\tbreak;\n\t\t}\n\t}\n\treturn prepared;\n}\n\nasync function reloadHostSessions(\n\tprepared: PreparedHostSessions,\n\tcoordinator?: DeletionSessionCoordinator,\n): Promise<boolean> {\n\tif (!coordinator) return false;\n\tlet failed = false;\n\tfor (const session of prepared.reload.reverse()) {\n\t\ttry {\n\t\t\tawait coordinator.reload(session);\n\t\t} catch (error) {\n\t\t\tfailed = true;\n\t\t\tsession.done = false;\n\t\t\tsession.reason = `宿主会话重载失败:${error instanceof Error ? error.message : String(error)}`;\n\t\t}\n\t}\n\treturn failed;\n}\n\nfunction applyDatabasePlan(db: DatabaseSync, plan: StoredDeletionPlan, paoHome: string): void {\n\tconst targetIds = plan.targets.map((target) => target.memoryId);\n\tplan.targets.forEach((target) => {\n\t\tconst row = memoryRow(db, target.memoryId);\n\t\tif (!row) throw new Error(`目标记忆不存在:${target.memoryId}`);\n\t\tif (row.current_revision !== target.revision) {\n\t\t\tthrow new Error(\n\t\t\t\t`修订号已变化:${target.memoryId} 预览 rev-${target.revision},当前 rev-${row.current_revision}`,\n\t\t\t);\n\t\t}\n\t});\n\tconst changed = sourceGraphChanged(db, plan);\n\tif (changed) throw new Error(changed);\n\n\tconst at = nowIso();\n\tconst insertExclusion = db.prepare(\n\t\t`INSERT INTO source_exclusions\n\t\t (exclusion_id, memory_id, source_id, session_id, entry_id, reason, created_at)\n\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t);\n\tfor (const source of plan.sources) {\n\t\tfor (const memoryId of source.linkedMemoryIds.filter((id) => targetIds.includes(id))) {\n\t\t\tinsertExclusion.run(\n\t\t\t\t`exc-${randomUUID()}`,\n\t\t\t\tmemoryId,\n\t\t\t\tsource.sourceId || null,\n\t\t\t\tsource.sessionId || null,\n\t\t\t\tsource.entryId || null,\n\t\t\t\t`memory 删除:${memoryId}`,\n\t\t\t\tat,\n\t\t\t);\n\t\t}\n\t}\n\t// 接续正文与普通记忆共享来源生命周期。排除一落库就物理清空相关接续正文，\n\t// 不能等读取路径再靠过滤隐藏；sources 行稍后删除后，来源身份快照仍能命中排除。\n\tdb.prepare(\n\t\t`UPDATE task_continuations\n\t\t SET workpoint = '',\n\t\t     workpoint_evidence_refs_json = '[]',\n\t\t     blocker = NULL,\n\t\t     blocker_evidence_kind = NULL,\n\t\t     blocker_evidence_refs_json = NULL,\n\t\t     next_step = '',\n\t\t     next_step_evidence_refs_json = '[]',\n\t\t     content_available = 0,\n\t\t     unavailable_reason = '来源已删除或排除',\n\t\t     updated_at = ?\n\t\t WHERE EXISTS (\n\t\t   SELECT 1\n\t\t   FROM task_continuation_sources s\n\t\t   JOIN source_exclusions e\n\t\t     ON e.source_id = s.source_id\n\t\t     OR (e.session_id = s.session_id AND e.entry_id = s.entry_id)\n\t\t   WHERE s.project_id = task_continuations.project_id\n\t\t     AND s.task_id = task_continuations.task_id\n\t\t )`,\n\t).run(at);\n\t// S6-10：先解除这批记忆的成果引用（artifact_refs ref_kind='memory'）。\n\t// 引用行一删，仍被其他记忆/任务/使用记录引用的版本由删除预览继续保留；\n\t// artifact_uses 的使用归因不删——已发生的使用不因记忆删除而消失。\n\tunlinkArtifactRefsForMemories(db, targetIds);\n\tconst deleteById = (sql: string, memoryId: string) => db.prepare(sql).run(memoryId);\n\tfor (const memoryId of targetIds) {\n\t\tdeleteById(\"DELETE FROM memory_fts WHERE memory_id = ?\", memoryId);\n\t\tdeleteById(\"DELETE FROM memory_vectors WHERE memory_id = ?\", memoryId);\n\t\tdeleteById(\"DELETE FROM memory_usage WHERE memory_id = ?\", memoryId);\n\t\tdeleteById(\"DELETE FROM memory_source_links WHERE memory_id = ?\", memoryId);\n\t\tdb.prepare(\"DELETE FROM revision_links WHERE memory_id = ?\").run(memoryId);\n\t\tdb.prepare(\"DELETE FROM revision_links WHERE target_memory_id = ?\").run(memoryId);\n\t\tdeleteById(\"DELETE FROM memory_revisions WHERE memory_id = ?\", memoryId);\n\t\tdeleteById(\"DELETE FROM memories WHERE id = ?\", memoryId);\n\t}\n\tconst deleteSource = db.prepare(\n\t\t`DELETE FROM sources\n\t\t WHERE source_id = ?\n\t\t   AND NOT EXISTS (SELECT 1 FROM memory_source_links WHERE source_id = ?)`,\n\t);\n\t// O05/Q3：来源行删除的同事务清其词法索引行（先按 source_id 清）。\n\tconst dropSourceFtsById = db.prepare(\"DELETE FROM source_fts WHERE source_id = ?\");\n\tfor (const sourceId of plan.sourceRowsToDelete) {\n\t\tdropSourceFtsById.run(sourceId);\n\t\tdeleteSource.run(sourceId, sourceId);\n\t}\n\t// O12/E11：进化子系统的来源删除贯通——本删除计划触碰到的 source_id 集合\n\t// （被删 sources 行 + source_exclusions 关联的 source_id）沿\n\t// evolution_source_links 清受管正文与盘文件。与上面同一事务（store.transaction\n\t// 由 executeOperation 开好），用 db 级实现避免嵌套事务。\n\t{\n\t\tconst touchedSourceIds = new Set<string>();\n\t\tfor (const sourceId of plan.sourceRowsToDelete) touchedSourceIds.add(sourceId);\n\t\tfor (const source of plan.sources) {\n\t\t\tif (source.sourceId) touchedSourceIds.add(source.sourceId);\n\t\t}\n\t\tfor (const sourceId of touchedSourceIds) {\n\t\t\tdbCleanupSourceReferences(db, {\n\t\t\t\tsourceId,\n\t\t\t\tcreatedAt: at,\n\t\t\t\tkeepExclusionLocator: true,\n\t\t\t\tpaoHome,\n\t\t\t});\n\t\t}\n\t}\n\tfor (const projectId of [...new Set(plan.targets.map((target) => target.projectId))].filter(Boolean)) {\n\t\tnextScopeRevision(db, projectId, at);\n\t}\n}\n\nasync function advanceFileObjects(db: DatabaseSync, archivesRoot: string, plan: StoredDeletionPlan): Promise<void> {\n\t// O05/Q3：归档段重写移除条目时同步清 source_fts（entryId 粒度，\n\t// 覆盖同 entryId 多 eventType 来源；toolcall 参数清空后原索引文本已过时，同批清）。\n\tconst dropSourceFtsByEntry = db.prepare(\"DELETE FROM source_fts WHERE entry_id = ?\");\n\tfor (const archive of plan.archives) {\n\t\tif (archive.done || !archive.path) continue;\n\t\tif (archive.reason && !existsSync(archive.path)) continue;\n\t\tconst result = rewriteSegmentFile(archive.path, archive.targets, archive.compressed);\n\t\tif (result.ok) {\n\t\t\tif (result.removed > 0 || result.redacted > 0) {\n\t\t\t\tfor (const entryId of new Set(archive.targets.map((target) => target.entryId))) {\n\t\t\t\t\tdropSourceFtsByEntry.run(entryId);\n\t\t\t\t}\n\t\t\t}\n\t\t\tarchive.done = true;\n\t\t\tdelete archive.reason;\n\t\t} else {\n\t\t\tarchive.reason = result.reason;\n\t\t}\n\t}\n\tfor (const session of plan.sessions) {\n\t\tif (session.done) continue;\n\t\tif (!session.scanComplete) {\n\t\t\tsession.reason = \"预览时未能扫描真实会话，受管派生正文范围仍未知\";\n\t\t\tcontinue;\n\t\t}\n\t\tconst redaction: SessionRedactionPlan = {\n\t\t\tsessionId: session.sessionId,\n\t\t\t...(session.sessionFile === undefined ? {} : { sessionFile: session.sessionFile }),\n\t\t\tavailability: session.availability,\n\t\t\tsourceEntryIds: session.sourceEntryIds,\n\t\t\tderivedEntryIds: session.derivedEntryIds,\n\t\t\tsourceTargets: session.sourceTargets,\n\t\t\tmemoryIds: session.memoryIds,\n\t\t\t...(session.referenceEntryIds === undefined ? {} : { referenceEntryIds: session.referenceEntryIds }),\n\t\t\t...(session.reason === undefined ? {} : { reason: session.reason }),\n\t\t};\n\t\tconst result = await redactDeletedSession(paoHomeFromArchives(archivesRoot), redaction);\n\t\tif (result.status === \"complete\") {\n\t\t\tsession.done = true;\n\t\t\tdelete session.reason;\n\t\t} else {\n\t\t\tsession.reason = result.reason ?? \"真实会话重写未完成\";\n\t\t}\n\t}\n\tfor (const attachment of plan.attachments) {\n\t\tif (attachment.done) continue;\n\t\tif (attachment.reason) continue;\n\t\ttry {\n\t\t\tif (existsSync(attachment.path)) unlinkSync(attachment.path);\n\t\t\tattachment.done = true;\n\t\t} catch {\n\t\t\t// 保留 done=false，finishOperation 会生成准确 pending，后续可重试。\n\t\t}\n\t}\n}\n\nasync function executeOperation(\n\tstore: MemoryStore,\n\tarchivesRoot: string,\n\toperationId: string,\n\tcoordinator?: DeletionSessionCoordinator,\n): Promise<MemoryResult<DeleteMemoryResult>> {\n\tconst row = readOperationRow(store.db, operationId);\n\tif (!row) return invalidInput(`删除操作不存在:${operationId}`, operationId);\n\tif (row.status === \"complete\" || row.status === \"failed\") {\n\t\treturn { ok: true, ...operationDto(row) };\n\t}\n\tconst plan = readPlan(row);\n\tconst prepared = await prepareHostSessions(plan, coordinator);\n\tlet result: MemoryResult<DeleteMemoryResult> | undefined;\n\ttry {\n\t\tif (await validateSessionControl(store.db, archivesRoot, plan, prepared.blocked)) {\n\t\t\tresult = finishOperation(store.db, operationId, plan);\n\t\t} else if (!plan.databaseDone) {\n\t\t\tconst snapshotError = validateRevisionSnapshot(store.db, plan);\n\t\t\tconst graphError = snapshotError ? undefined : sourceGraphChanged(store.db, plan);\n\t\t\tconst validationError = snapshotError ?? graphError;\n\t\t\tif (validationError) {\n\t\t\t\tresult = finishOperation(store.db, operationId, plan, validationError);\n\t\t\t} else {\n\t\t\t\tconst previousDatabaseDone = plan.databaseDone;\n\t\t\t\ttry {\n\t\t\t\t\tstore.transaction(() => {\n\t\t\t\t\t\tapplyDatabasePlan(store.db, plan, paoHomeFromArchives(archivesRoot));\n\t\t\t\t\t\tplan.databaseDone = true;\n\t\t\t\t\t\twriteOperation(store.db, operationId, \"pending\", plan, planPendingObjects(plan));\n\t\t\t\t\t});\n\t\t\t\t} catch (error) {\n\t\t\t\t\tplan.databaseDone = previousDatabaseDone;\n\t\t\t\t\tresult = finishOperation(\n\t\t\t\t\t\tstore.db,\n\t\t\t\t\t\toperationId,\n\t\t\t\t\t\tplan,\n\t\t\t\t\t\t`数据库清理失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (!result) {\n\t\t\tawait advanceFileObjects(store.db, archivesRoot, plan);\n\t\t\tresult = finishOperation(store.db, operationId, plan);\n\t\t}\n\t} finally {\n\t\tconst reloadFailed = await reloadHostSessions(prepared, coordinator);\n\t\tif (reloadFailed && result?.ok && result.status !== \"failed\") {\n\t\t\tresult = finishOperation(store.db, operationId, plan);\n\t\t}\n\t}\n\tif (!result) throw new Error(`删除作业未生成结果:${operationId}`);\n\treturn result;\n}\n\nexport async function previewMemoryDeletion(\n\tstore: MemoryStore,\n\tarchivesRoot: string,\n\tinput: PreviewMemoryDeletionInput,\n): Promise<MemoryResult<PreviewMemoryDeletionResult>> {\n\tconst policyError = validatePolicy(input);\n\tif (policyError) return { ok: false, error: policyError };\n\tconst initial = initialTargetIds(store.db, input);\n\tif (initial.size === 0) {\n\t\treturn invalidInput(\"未指定可解析目标：memoryId 或来源范围（sourceId/sessionId/entryId）至少一项要命中\");\n\t}\n\tconst built = await buildDeletionPlan(\n\t\tstore.db,\n\t\tarchivesRoot,\n\t\t[...initial],\n\t\tnormalizePolicy(input.sharedSourcePolicy),\n\t);\n\tif (built.plan.targets.length === 0) {\n\t\treturn invalidInput(\"目标记忆不存在或已删除\", input.memoryId ?? [...initial][0]);\n\t}\n\tconst affectedEntries = new Map<string, Set<string>>();\n\tfor (const source of built.plan.sources) {\n\t\tif (!source.sessionId) continue;\n\t\tconst entries = affectedEntries.get(source.sessionId) ?? new Set<string>();\n\t\tif (source.entryId) entries.add(source.entryId);\n\t\taffectedEntries.set(source.sessionId, entries);\n\t}\n\tfor (const session of built.plan.sessions) {\n\t\tconst entries = affectedEntries.get(session.sessionId) ?? new Set<string>();\n\t\tfor (const entryId of [...session.sourceEntryIds, ...session.derivedEntryIds]) entries.add(entryId);\n\t\tif (entries.size > 0) affectedEntries.set(session.sessionId, entries);\n\t}\n\treturn {\n\t\tok: true,\n\t\ttargets: built.plan.targets.map((target) => {\n\t\t\tconst row = memoryRow(store.db, target.memoryId);\n\t\t\treturn {\n\t\t\t\tmemoryId: target.memoryId,\n\t\t\t\tkind: (row?.kind ?? \"experience\") as MemoryKind,\n\t\t\t\tcurrentRevision: target.revision,\n\t\t\t\tconclusion: conclusionFor(store.db, target.memoryId, target.revision),\n\t\t\t};\n\t\t}),\n\t\treferencedBy: built.referencedBy,\n\t\taffectedSessions: [...affectedEntries.entries()]\n\t\t\t.sort(([left], [right]) => left.localeCompare(right))\n\t\t\t.map(([sessionId, entries]) => ({ sessionId, messageCount: entries.size })),\n\t\tunmanagedSources: built.unmanagedSources,\n\t\tsources: sourcesForDto(built.plan),\n\t\tsessions: sessionsForDto(built.plan),\n\t\tpendingObjects: planPendingObjects(built.plan, false),\n\t};\n}\n\nexport async function deleteMemory(\n\tstore: MemoryStore,\n\tarchivesRoot: string,\n\tinput: DeleteMemoryInput,\n\tcoordinator?: DeletionSessionCoordinator,\n): Promise<MemoryResult<DeleteMemoryResult>> {\n\tif (store.mode !== \"readwrite\") {\n\t\tthrow new Error(\"记忆服务以 readonly 模式打开，写接口不可用\");\n\t}\n\tconst policyError = validatePolicy(input);\n\tif (policyError) return { ok: false, error: policyError };\n\tif (!Array.isArray(input.memoryIds) || input.memoryIds.length === 0) {\n\t\treturn invalidInput(\"memoryIds 不能为空\");\n\t}\n\tconst uniqueIds = [...new Set(input.memoryIds)];\n\tfor (const memoryId of uniqueIds) {\n\t\tif (typeof input.revisions?.[memoryId] !== \"number\") {\n\t\t\treturn invalidInput(`缺少 ${memoryId} 的预览修订号`, memoryId);\n\t\t}\n\t}\n\tconst built = await buildDeletionPlan(store.db, archivesRoot, uniqueIds, normalizePolicy(input.sharedSourcePolicy));\n\tconst operationId = `del-${randomUUID()}`;\n\tconst mismatch = built.plan.targets.find((target) => input.revisions[target.memoryId] !== target.revision);\n\tconst missing = built.missingMemoryIds[0];\n\tconst failureReason = missing\n\t\t? `目标记忆不存在或已删除:${missing}`\n\t\t: mismatch\n\t\t\t? `${mismatch.memoryId} 修订号已变化:预览 rev-${input.revisions[mismatch.memoryId]},当前 rev-${mismatch.revision}，需重新 preview`\n\t\t\t: undefined;\n\tif (failureReason) {\n\t\tconst pending: DeletionPendingObject[] = [{ kind: \"database\", reason: failureReason }];\n\t\twriteOperation(store.db, operationId, \"failed\", built.plan, pending, failureReason);\n\t\tconst row = readOperationRow(store.db, operationId);\n\t\tif (!row) return fail(\"unavailable\", `删除操作写入后不可读:${operationId}`, { refId: operationId });\n\t\treturn { ok: true, ...operationDto(row) };\n\t}\n\n\t// 首个破坏性 SQLite 写入前必须先持久化计划。\n\twriteOperation(store.db, operationId, \"pending\", built.plan, planPendingObjects(built.plan));\n\treturn executeOperation(store, archivesRoot, operationId, coordinator);\n}\n\nexport function readDeletionOperation(store: MemoryStore, operationId: string): MemoryResult<DeletionOperationDto> {\n\tconst row = readOperationRow(store.db, operationId);\n\tif (!row) return invalidInput(`删除操作不存在:${operationId}`, operationId);\n\treturn { ok: true, ...operationDto(row) };\n}\n\nexport async function resumeDeletion(\n\tstore: MemoryStore,\n\tarchivesRoot: string,\n\toperationId: string,\n\tcoordinator?: DeletionSessionCoordinator,\n): Promise<MemoryResult<DeleteMemoryResult>> {\n\treturn executeOperation(store, archivesRoot, operationId, coordinator);\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆向量读写与增量嵌入（S3）。\n *\tfilter?: ScopeFilter,\n): MemoryVectorRow[] {\n\tconst rows = (\n\t\tfilter === undefined\n\t\t? db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT memory_id, revision, model, dimension, vector\n\t\t\t\t\t\t FROM memory_vectors WHERE model = ? AND dimension = ?`,\n\t\t\t\t)\n\t\t\t\t.all(model, dimension)\n\t\t: db\n\t\t\t\t\t\t\t\t\t`SELECT v.memory_id, v.revision, v.model, v.dimension, v.vector\n\t\t\t\t\t\t FROM memory_vectors v\n\t\t\t\t\t\t JOIN memories m ON m.id = v.memory_id\n\t\t\t\t\t\t WHERE v.model = ? AND v.dimension = ? AND ${filter.where}`,\n\t\t\t\t)\n\t\t\t\t.all(model, dimension, ...filter.params)) as unknown as VectorDbRow[];\n\tconst out: MemoryVectorRow[] = [];\n\tfor (const row of rows) {\t\t\t\tdimension: batchEmbedded === 0 ? 0 : returnedDimension,\n\t\t\t});\n\t\t\tdeps.ledger?.appendUsage(\n\t\t\t\t\"memory_embedding\", \"embed\",model,embedZeroUsage(),embedUsageNote(deps, \"result\", batchRequestId),\n\t\t\t);\n\t\t\t// 嵌入端点不返回费用：按 unknown 结算（占额保留，不释放）。\n\t\t\tawait deps.settleForBatch?.(batchRequestId, undefined, \"嵌入端点未返回费用\");\t\t\t\taborted: deps.signal?.aborted === true,\n\t\t\t});\n\t\t\tdeps.ledger?.appendUsage(embedUsageNote(deps, \"failure\", batchRequestId));\n\t\t\tawait deps.settleForBatch?.(batchRequestId,undefined,`嵌入请求失败:${error instanceof Error ? error.message : String(error)}`);\n\t\t\tthrow error;\n\t\t}/** 余弦相似度（透传 knowledge/embed.cosine，供 search.ts 与测试复用同一实现）。 */\nexport { cosine };\n","ops":[{"diffOp":{"equal":{"range":[0,60]}}},{"equalLines":{"line_count":98}},{"diffOp":{"equal":{"range":[60,121]}}},{"diffOp":{"delete":{"range":[121,124]}}},{"diffOp":{"equal":{"range":[124,145]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[145,156]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[156,166]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[166,288]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[288,298]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[298,321]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[321,332]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[156,166]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[332,546]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[546,548]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[548,592]}}},{"diffOp":{"delete":{"range":[121,123]}}},{"diffOp":{"equal":{"range":[592,685]}}},{"equalLines":{"line_count":201}},{"diffOp":{"equal":{"range":[685,780]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[785,804]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[805,813]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[813,819]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[819,836]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[836,882]}}},{"diffOp":{"insert":{"range":[882,887]}}},{"diffOp":{"equal":{"range":[887,1067]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[1067,1146]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[785,804]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[805,813]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[813,819]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[819,836]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[1146,1193]}}},{"diffOp":{"insert":{"range":[882,887]}}},{"diffOp":{"equal":{"range":[1193,1227]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[1227,1242]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[1242,1252]}}},{"diffOp":{"delete":{"range":[804,805]}}},{"diffOp":{"insert":{"range":[780,785]}}},{"diffOp":{"equal":{"range":[1252,1330]}}},{"diffOp":{"insert":{"range":[882,887]}}},{"diffOp":{"equal":{"range":[1330,1352]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1352,1476]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\embeddings.ts"},"span":null,"sourceCode":"/**\n * 内置记忆向量读写与增量嵌入（S3）。\n *\n * 职责：\n * - memory_vectors 表的 BLOB 编解码（Float32Array ↔ Buffer）；\n * - 按 (memoryId, revision, model) 查已有向量、取待嵌入队列、批量嵌入落库；\n * - 外发许可由调用方先过 checkOutbound——本模块只负责「给了客户端才嵌、\n *   未给就不嵌」，不自己做许可判定；\n * - 记账：每批经 ledger.appendCustomEntry 记 attempt/result/failure；result/failure\n *   后各追加一条 `appendUsage(\"memory_embedding\",\"embed\",model,…)`——嵌入 API 未\n *   返回 token 用量，usage 全零 + note 带「用量未返回」，聚合侧按 unknown 口径计，\n *   不伪造已知用量；失败批同样落 usage entry（账本可见「有请求、无结果」）。\n *\n * 契约：\n * - 同 model 同 revision 不重复嵌入（先查已有向量）。\n * - 维度在写入时记录；读取方核对 dimension 一致才参与余弦（search.ts 负责）。\n * - 批量调用逐项核对返回数量与维度；数量不符/缺向量 → 抛错（底层故障），\n *   不部分写库伪装成功。\n * - 网络返回后在同一短事务内重新核对记忆仍存在、仍为当前 active 修订且来源\n *   未被排除，只提交仍有效项；失效响应不会复活已清理索引。\n * - 修订替换后既有旧向量可留库，但检索只读 current_revision 对应的行。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { Usage } from \"@pao/ai\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { cosine, type EmbedClient, type EmbedRequestOptions, embedTexts } from \"../knowledge/embed.ts\";\nimport { filterExcludedMemories, type ScopeFilter } from \"./scope.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// BLOB 编解码\n// ════════════════════════════════════════════════════════════════════════\n\n/** number[] → Float32 Buffer（写库）。 */\nexport function encodeVector(vector: number[]): Buffer {\n\treturn Buffer.from(new Float32Array(vector).buffer);\n}\n\n/** 库 BLOB → number[]（读库）。维度不符返回 undefined（调用方跳过不算）。 */\nexport function decodeVector(blob: unknown, dimension: number): number[] | undefined {\n\tif (!(blob instanceof Uint8Array)) return undefined;\n\tconst buf = blob instanceof Buffer ? blob : Buffer.from(blob.buffer, blob.byteOffset, blob.byteLength);\n\tif (buf.byteLength !== dimension * 4) return undefined;\n\tconst floats = new Float32Array(buf.buffer, buf.byteOffset, dimension);\n\treturn Array.from(floats);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 行映射与查询\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface MemoryVectorRow {\n\tmemoryId: string;\n\trevision: number;\n\tmodel: string;\n\tdimension: number;\n\tvector: number[];\n}\n\ninterface VectorDbRow {\n\tmemory_id: string;\n\trevision: number;\n\tmodel: string;\n\tdimension: number;\n\tvector: Uint8Array;\n}\n\n/** 读指定 model 下一条记忆某修订的向量；维度不符的行跳过（不返回）。 */\nexport function readMemoryVector(\n\tdb: DatabaseSync,\n\tmemoryId: string,\n\trevision: number,\n\tmodel: string,\n): MemoryVectorRow | undefined {\n\tconst row = db\n\t\t.prepare(\n\t\t\t`SELECT memory_id, revision, model, dimension, vector\n\t\t\t FROM memory_vectors WHERE memory_id = ? AND revision = ? AND model = ?`,\n\t\t)\n\t\t.get(memoryId, revision, model) as VectorDbRow | undefined;\n\tif (!row) return undefined;\n\tconst vector = decodeVector(row.vector, row.dimension);\n\tif (!vector) return undefined;\n\treturn {\n\t\tmemoryId: row.memory_id,\n\t\trevision: row.revision,\n\t\tmodel: row.model,\n\t\tdimension: row.dimension,\n\t\tvector,\n\t};\n}\n\n/**\n * 读某 model+dimension 下的有效向量；维度不同的行不返回（调用方不混算）。\n * 传入 filter（ScopeFilter，where 可引 m.* 与 v.*）时 JOIN memories 在 SQL 层\n * 按范围下推，不解码范围外向量；不传时维持全库读取（旧行为）。\n */\nexport function readMemoryVectors(\n\tdb: DatabaseSync,\n\tmodel: string,\n\tdimension: number,\n\tfilter?: ScopeFilter,\n): MemoryVectorRow[] {\n\tconst rows = (\n\t\tfilter === undefined\n\t\t\t? db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT memory_id, revision, model, dimension, vector\n\t\t\t\t\t\t FROM memory_vectors WHERE model = ? AND dimension = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.all(model, dimension)\n\t\t\t: db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT v.memory_id, v.revision, v.model, v.dimension, v.vector\n\t\t\t\t\t\t FROM memory_vectors v\n\t\t\t\t\t\t JOIN memories m ON m.id = v.memory_id\n\t\t\t\t\t\t WHERE v.model = ? AND v.dimension = ? AND ${filter.where}`,\n\t\t\t\t\t)\n\t\t\t\t\t.all(model, dimension, ...filter.params)\n\t) as unknown as VectorDbRow[];\n\tconst out: MemoryVectorRow[] = [];\n\tfor (const row of rows) {\n\t\tconst vector = decodeVector(row.vector, row.dimension);\n\t\tif (!vector) continue;\n\t\tout.push({\n\t\t\tmemoryId: row.memory_id,\n\t\t\trevision: row.revision,\n\t\t\tmodel: row.model,\n\t\t\tdimension: row.dimension,\n\t\t\tvector,\n\t\t});\n\t}\n\treturn out;\n}\n\n/** 是否已有 (memoryId,revision,model) 向量（存在即不重嵌）。 */\nexport function hasMemoryVector(db: DatabaseSync, memoryId: string, revision: number, model: string): boolean {\n\treturn (\n\t\tdb\n\t\t\t.prepare(\"SELECT 1 AS ok FROM memory_vectors WHERE memory_id = ? AND revision = ? AND model = ? LIMIT 1\")\n\t\t\t.get(memoryId, revision, model) !== undefined\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 增量嵌入\n// ════════════════════════════════════════════════════════════════════════\n\n/** 待嵌入队列项：一条记忆的一个修订的检索正文。 */\nexport interface EmbeddingQueueItem {\n\tmemoryId: string;\n\trevision: number;\n\t/** 检索正文（与 memory_fts 同口径：conclusion+conditions+rationale）。 */\n\tcontent: string;\n}\n\nexport interface EmbedMemoriesDeps {\n\t/** 嵌入客户端；调用方先过外发许可再传进来。 */\n\tclient: EmbedClient;\n\t/** 记账（可选；每次批次记 attempt/result 或 failure）。 */\n\tledger?: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** 每批嵌入的条数上限（缺省 32）。 */\n\tbatchSize?: number;\n\t/** 账本 requestId 关联（可选；批 ID 在其后追加 `:{offset}`——每批独立判据）。 */\n\trequestId?: string;\n\t/** 逐请求预算预留（可选；返回 false = 预算门拒绝，本批不发且中断后续批）。 */\n\treserveForBatch?: (batch: { offset: number; itemCount: number; requestId: string }) => Promise<boolean>;\n\t/** 逐请求结算；cost===undefined → unknown 占额（嵌入端点不返回费用，一律 unknown）。 */\n\tsettleForBatch?: (requestId: string, cost: number | undefined, note: string) => Promise<void>;\n\t/** 原任务/job/session 归属字段，原样写入 attempt/result/failure。 */\n\tattribution?: Record<string, string | undefined>;\n\t/** 取消信号（透传 embedTexts）。 */\n\tsignal?: AbortSignal;\n\t/** 单批超时（毫秒，透传 embedTexts）。 */\n\ttimeoutMs?: number;\n}\n\nexport interface EmbedMemoriesResult {\n\t/** 本次实际嵌入并写入的条数。 */\n\tembedded: number;\n\t/** 因已有向量而跳过的条数。 */\n\tskipped: number;\n\t/** 本次写入的向量维度（无嵌入时为 0）。 */\n\tdimension: number;\n}\n\n/**\n * 嵌入端点不返回 token 用量——result/failure 的 usage entry 用全零 Usage 占位，\n * 不伪造已知用量：聚合口径（usage-query / desktop）把 totalTokens=0 记 unknown。\n */\nfunction embedZeroUsage(): Usage {\n\treturn {\n\t\tinput: 0,\n\t\toutput: 0,\n\t\tcacheRead: 0,\n\t\tcacheWrite: 0,\n\t\ttotalTokens: 0,\n\t\tcost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },\n\t};\n}\n\n/** result/failure 的 usage entry note：沿用 attribution/requestId 并标「用量未返回」。 */\nfunction embedUsageNote(deps: EmbedMemoriesDeps, outcome: string, batchRequestId?: string): string {\n\tconst attrs = Object.entries(deps.attribution ?? {})\n\t\t.filter((pair): pair is [string, string] => typeof pair[1] === \"string\" && pair[1].length > 0)\n\t\t.map(([key, value]) => `${key}=${value}`)\n\t\t.join(\" \");\n\tconst requestId = batchRequestId ?? deps.requestId;\n\treturn `${attrs ? `${attrs} ` : \"\"}kind=embed${requestId ? ` requestId=${requestId}` : \"\"} ${outcome} 用量未返回`;\n}\n\n/**\n * 增量嵌入：items 中尚未有 (memoryId,revision,model) 向量的批量嵌入并落库。\n * - 已有向量先跳过（同 model 同 revision 不重复请求）。\n * - 分批调 embedTexts；逐项核对返回数量与维度一致才写库，否则抛错。\n * - 响应返回后重新核对每项仍是当前有效记忆，失效项不写且不计入 embedded。\n * - 写入在一个事务里逐批提交（每批一个 IMMEDIATE），断点恢复时本批前的不丢。\n */\nexport async function embedMemories(\n\tdb: DatabaseSync,\n\titems: EmbeddingQueueItem[],\n\tdeps: EmbedMemoriesDeps,\n): Promise<EmbedMemoriesResult> {\n\tconst model = deps.client.config.model;\n\tconst batchSize = deps.batchSize ?? 32;\n\n\t// 先查已有向量，只嵌缺的（同 model 同 revision 不重复请求）。\n\tconst pending = items.filter((item) => !hasMemoryVector(db, item.memoryId, item.revision, model));\n\tconst skipped = items.length - pending.length;\n\tif (pending.length === 0) {\n\t\treturn { embedded: 0, skipped, dimension: 0 };\n\t}\n\n\tlet embedded = 0;\n\tlet dimension = 0;\n\tconst insert = db.prepare(\n\t\t`INSERT INTO memory_vectors (memory_id, revision, model, dimension, vector)\n\t\t VALUES (?, ?, ?, ?, ?)\n\t\t ON CONFLICT (memory_id, revision, model) DO UPDATE\n\t\t\tSET dimension = excluded.dimension, vector = excluded.vector`,\n\t);\n\tconst stillCurrent = db.prepare(\n\t\t`SELECT 1 AS ok FROM memories\n\t\t WHERE id = ? AND current_revision = ? AND usage_state = 'active' AND merged_into IS NULL`,\n\t);\n\n\tfor (let offset = 0; offset < pending.length; offset += batchSize) {\n\t\tconst batch = pending.slice(offset, offset + batchSize);\n\t\t// 每次实际嵌入请求一条独立判据：随机段是本次请求的身份——同 jobId\n\t\t// 失败后重跑时不再拼回旧键；deps.requestId/offset 只作归属与批内序号，\n\t\t// 不承担唯一性（F06/G01）。格式 `{prefix}:{uuid}:{offset}`。\n\t\tconst batchRequestId =\n\t\t\tdeps.requestId === undefined ? `${randomUUID()}` : `${deps.requestId}:${randomUUID()}:${offset}`;\n\t\tconst batchRequest = {\n\t\t\t...(deps.attribution ?? {}),\n\t\t\tmodel,\n\t\t\trequestId: batchRequestId,\n\t\t\tbatchOffset: offset,\n\t\t\titemCount: batch.length,\n\t\t\tusage: \"unknown\",\n\t\t\tcost: \"unknown\",\n\t\t};\n\t\t// 逐请求预算门：在每次嵌入请求边界预留（未发不占额）；拒绝即中断，\n\t\t// 本批及后续批都不发（额度不足继续发只会多欠账）。\n\t\tif (deps.reserveForBatch !== undefined) {\n\t\t\tconst allowed = await deps.reserveForBatch({\n\t\t\t\toffset,\n\t\t\t\titemCount: batch.length,\n\t\t\t\trequestId: batchRequestId,\n\t\t\t});\n\t\t\tif (!allowed) {\n\t\t\t\tdeps.ledger?.appendCustomEntry(\"pao-memory-embedding-skip\", {\n\t\t\t\t\t...batchRequest,\n\t\t\t\t\treason: \"预算门拒绝\",\n\t\t\t\t});\n\t\t\t\treturn { embedded, skipped: skipped + (pending.length - offset), dimension };\n\t\t\t}\n\t\t}\n\t\tdeps.ledger?.appendCustomEntry(\"pao-memory-embedding-attempt\", batchRequest);\n\t\ttry {\n\t\t\tconst vectors = await embedTexts(\n\t\t\t\tdeps.client,\n\t\t\t\tbatch.map((item) => item.content),\n\t\t\t\t{ signal: deps.signal, timeoutMs: deps.timeoutMs } satisfies EmbedRequestOptions,\n\t\t\t);\n\t\t\tif (vectors.length !== batch.length) {\n\t\t\t\tthrow new Error(`嵌入端点返回数量不符:期望 ${batch.length},实得 ${vectors.length}`);\n\t\t\t}\n\t\t\tconst returnedDimension = vectors[0]?.length ?? 0;\n\t\t\tfor (let i = 0; i < batch.length; i++) {\n\t\t\t\tconst vector = vectors[i];\n\t\t\t\tif (!Array.isArray(vector) || vector.length === 0) {\n\t\t\t\t\tthrow new Error(`嵌入端点返回第 ${i} 项缺少向量`);\n\t\t\t\t}\n\t\t\t\tif (vector.length !== returnedDimension) {\n\t\t\t\t\tthrow new Error(`嵌入端点返回维度不一致:第 ${i} 项 ${vector.length},期望 ${returnedDimension}`);\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 逐批一个事务写库：本批要么全落要么全回滚，断点恢复只丢当前批。\n\t\t\tdb.exec(\"BEGIN IMMEDIATE\");\n\t\t\tlet batchEmbedded = 0;\n\t\t\ttry {\n\t\t\t\tconst excluded = filterExcludedMemories(db, batch);\n\t\t\t\tfor (let i = 0; i < batch.length; i++) {\n\t\t\t\t\tconst item = batch[i];\n\t\t\t\t\tif (!stillCurrent.get(item.memoryId, item.revision) || excluded.has(item.memoryId)) continue;\n\t\t\t\t\tinsert.run(item.memoryId, item.revision, model, returnedDimension, encodeVector(vectors[i]));\n\t\t\t\t\tbatchEmbedded += 1;\n\t\t\t\t}\n\t\t\t\tdb.exec(\"COMMIT\");\n\t\t\t} catch (error) {\n\t\t\t\ttry {\n\t\t\t\t\tdb.exec(\"ROLLBACK\");\n\t\t\t\t} catch {\n\t\t\t\t\t// 回滚失败不掩盖原错误\n\t\t\t\t}\n\t\t\t\tthrow error;\n\t\t\t}\n\t\t\tembedded += batchEmbedded;\n\t\t\tif (batchEmbedded > 0 && dimension === 0) dimension = returnedDimension;\n\t\t\tdeps.ledger?.appendCustomEntry(\"pao-memory-embedding-result\", {\n\t\t\t\t...batchRequest,\n\t\t\t\tembedded: batchEmbedded,\n\t\t\t\tdimension: batchEmbedded === 0 ? 0 : returnedDimension,\n\t\t\t});\n\t\t\tdeps.ledger?.appendUsage(\"memory_embedding\", \"embed\", model, embedZeroUsage(), embedUsageNote(deps, \"result\", batchRequestId));\n\t\t\t// 嵌入端点不返回费用：按 unknown 结算（占额保留，不释放）。\n\t\t\tawait deps.settleForBatch?.(batchRequestId, undefined, \"嵌入端点未返回费用\");\n\t\t} catch (error) {\n\t\t\tdeps.ledger?.appendCustomEntry(\"pao-memory-embedding-failure\", {\n\t\t\t\t...batchRequest,\n\t\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t\t\taborted: deps.signal?.aborted === true,\n\t\t\t});\n\t\t\tdeps.ledger?.appendUsage(\"memory_embedding\", \"embed\", model, embedZeroUsage(), embedUsageNote(deps, \"failure\", batchRequestId));\n\t\t\tawait deps.settleForBatch?.(batchRequestId, undefined, `嵌入请求失败:${error instanceof Error ? error.message : String(error)}`);\n\t\t\tthrow error;\n\t\t}\n\t}\n\n\treturn { embedded, skipped, dimension };\n}\n\n/** 余弦相似度（透传 knowledge/embed.cosine，供 search.ts 与测试复用同一实现）。 */\nexport { cosine };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆 S2-05/06/07/09/11/13：已校验候选的提交入口。\n * */\nfunction isEvidenceUpgrade(targetKind: EvidenceKind, candidateKind: EvidenceKind): boolean {\n\treturn (\n\t\ttargetKind === \"model_inference\" &&\n\t\t(candidateKind === \"user_statement\" || candidateKind === \"execution\")\n\t);\n}\n\t\tconst delta = semanticDelta(candidate, target.content);\n\t\tconst unchanged =\n\t\t\t!delta.confirmationChanged &&\n\t\t\t!delta.evidenceKindChanged &&!delta.rationaleChanged &&!delta.conditionsChanged;\n\t\tif (unchanged) {\n\t\t\t// 同结论同条件不新建：补链新来源、复用已有 ID。\t\t\t\tcounters.skipped += 1;\n\t\t\t\tif (first !== undefined) {\n\t\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\t\tmemoryId: target.memoryId,currentRevision: target.currentRevision,candidateIndex: first.candidateIndex,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t}\t\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\t\tdelta.confirmationChanged &&\n\t\t\t\t(!delta.evidenceKindChanged ||isEvidenceUpgrade(sourceHit.content.evidenceKind, candidate.evidenceKind)) &&\n\t\t\t\t!delta.conditionsChanged &&\n\t\t\t\t!delta.rationaleChanged;\t\t\t\t// 复用已有 ID 并把新来源补链进当前修订。\n\t\t\t\tconst linked = store.transaction(() =>\n\t\t\t\t\tlinkSourcesToRevision(db,sameConclusion.memoryId,sameConclusion.currentRevision,candidate.sourceIds),\n\t\t\t\t);\n\t\t\t\toutcomes.push({\t\t\t\t!delta.conditionsChanged &&\n\t\t\t\t!delta.rationaleChanged;\n\t\t\tif (upgradeOnly && (await dispatchSameConclusion(candidate, candidateIndex, sameConclusion, batchKey)))continue;\n\t\t\t// 其余实质差异：模型重述同结论但改了理由/降了状态/换了证据类别，\n\t\t\t// 或推断/tentative 带来的条件变化——没有足够依据替用户裁语义，\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,79]}}},{"equalLines":{"line_count":263}},{"diffOp":{"equal":{"range":[79,184]}}},{"diffOp":{"delete":{"range":[184,188]}}},{"diffOp":{"equal":{"range":[188,223]}}},{"diffOp":{"delete":{"range":[223,226]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[226,294]}}},{"diffOp":{"delete":{"range":[294,297]}}},{"diffOp":{"equal":{"range":[297,302]}}},{"equalLines":{"line_count":154}},{"diffOp":{"equal":{"range":[302,412]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[412,416]}}},{"diffOp":{"equal":{"range":[416,445]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[412,416]}}},{"diffOp":{"equal":{"range":[445,471]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[412,416]}}},{"diffOp":{"equal":{"range":[471,588]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[588,676]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[676,683]}}},{"diffOp":{"equal":{"range":[683,709]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[676,683]}}},{"diffOp":{"equal":{"range":[709,749]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[676,683]}}},{"diffOp":{"equal":{"range":[749,785]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[785,792]}}},{"diffOp":{"equal":{"range":[792,806]}}},{"equalLines":{"line_count":192}},{"diffOp":{"equal":{"range":[806,919]}}},{"diffOp":{"delete":{"range":[676,682]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[919,1057]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[1057,1190]}}},{"diffOp":{"delete":{"range":[676,683]}}},{"diffOp":{"equal":{"range":[1190,1193]}}},{"diffOp":{"delete":{"range":[676,683]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[1193,1217]}}},{"diffOp":{"delete":{"range":[676,683]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[1217,1248]}}},{"diffOp":{"delete":{"range":[676,683]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[1248,1267]}}},{"diffOp":{"delete":{"range":[785,792]}}},{"diffOp":{"equal":{"range":[1267,1296]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[1296,1463]}}},{"diffOp":{"delete":{"range":[79,80]}}},{"diffOp":{"insert":{"range":[676,681]}}},{"diffOp":{"equal":{"range":[1463,1664]}}},{"equalLines":{"line_count":50}},{"diffOp":{"equal":{"range":[1664,1670]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\extract-commit.ts"},"span":null,"sourceCode":"/**\n * 内置记忆 S2-05/06/07/09/11/13：已校验候选的提交入口。\n *\n * 契约：\n * - 入口 `commitExtractionCandidates(store, service, input)`：service 注入\n *   `createMemory`/`flagForReDiscussion`/`correctMemory`（D 批传真实\n *   MemoryService，E 批可传假实现）；直查（排除核对、来源级去重、同范围\n *   决定扫描、补链）用 `store.db`。\n * - 每候选一段处理，产出 `CommitCandidateOutcome`；候选级失败不 throw、不中断\n *   批次（S2-09 失效候选只丢本次提交）。\n * - 顺序：S2-09 排除核对 → 请求快照失效核对 → S2-13 批内命中 → S2-07\n *   来源级命中/同范围同结论先核实质差异（F04）：仅确认状态 tentative →\n *   confirmed 升级走 correctMemory 修订；conditions 不同标需重议（候选\n *   不新建，且重议必须有用户/执行实据——模型推断或 tentative 变化只走\n *   semantic_conflict 如实跳过）；其余语义冲突如实跳过；无差异复用已有 ID\n *   补链 → O03/F05 同来源停用核对（来源关联的 stopped 且未合并记忆 →\n *   skipped/source_resting_stopped，不另建 active 副本）→ 都没拦住 →\n *   createMemory 落库（kind=commitment 时\n *   commitmentStatus:\"open\"，S2-11 承诺不授权执行）。无关结论各自入库，\n *   不凭文本差异建语义关系（F12）。\n * - 批内命中与库内命中共用同一分派：批内第二条起对 batchSeen 记的本批\n *   已落库目标走同一套「无差异→duplicate 补链、仅 tentative→confirmed→\n *   升级、conditions→flagged、其余→semantic_conflict」，确认与条件变化\n *   不再被批内去重短路吞掉。\n * - 事务粒度：候选级而非全批单事务——注入的服务方法各自开 BEGIN IMMEDIATE，\n *   嵌套事务在 node:sqlite 会抛错；且每步 CAS 在提交点重查修订，满足 S2-09\n *   「延迟响应不覆盖页面纠正/停用/删除」（校验时的旧修订状态不回写）。\n * - 结论归一（normalizeConclusion）：trim + 大小写折叠 + 连续空白合一，\n *   供批内重复、来源级去重、同范围决定匹配共用同一口径。\n */\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { isSourceExcluded, revisionsForSource } from \"./sources.ts\";\nimport type { MemoryStore } from \"./store.ts\";\nimport type {\n\tCommitCandidateOutcome,\n\tCommitExtractionInput,\n\tCommitExtractionOutput,\n\tEvidenceKind,\n\tMemoryRevisionContent,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n\tValidatedCandidate,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 归一与行映射\n// ════════════════════════════════════════════════════════════════════════\n\n/** 结论归一：trim + 大小写折叠 + 连续空白合一（三处匹配共用同一口径）。 */\nfunction normalizeConclusion(text: string): string {\n\treturn text.trim().toLowerCase().replace(/\\s+/g, \" \");\n}\n\n/** 项目级候选共享到同项目所有任务；这里只去掉任务边界，其他范围字段保持原样。 */\nfunction projectSharedScope(scope: MemoryScope): MemoryScope {\n\tconst shared = { ...scope };\n\tdelete shared.taskId;\n\treturn shared;\n}\n\n/**\n * 某候选实际落库范围。\n *\n * 决定、经验和教训属于项目知识，固定不带 taskId；承诺只有其全部引用来源都\n * 独立证明同一项目、同一真实任务时才继承该任务，任何缺口或跨任务混合都退回\n * 项目级，绝不借用“提交时当前任务”猜测。\n */\nfunction scopeForCandidate(\n\tcandidate: ValidatedCandidate,\n\tscope: MemoryScope,\n\tsourceRefs: CommitExtractionInput[\"sourceRefs\"],\n): MemoryScope {\n\tconst shared = projectSharedScope(scope);\n\tif (candidate.kind !== \"commitment\") return shared;\n\tconst refsById = new Map(sourceRefs.map((ref) => [ref.sourceId, ref]));\n\tconst refs = candidate.sourceIds.map((sourceId) => refsById.get(sourceId));\n\tif (refs.length === 0 || refs.some((ref) => ref === undefined || !ref.projectId || !ref.taskId)) return shared;\n\tconst projectId = refs[0]!.projectId!;\n\tconst taskId = refs[0]!.taskId!;\n\tif (refs.some((ref) => ref!.projectId !== projectId || ref!.taskId !== taskId)) return shared;\n\treturn { ...shared, projectId, taskId };\n}\n\n/** 读取库内 scope，并确认它与候选需要复用的任务边界一致。 */\nfunction memoryMatchesScope(scopeJson: string, scope: MemoryScope): boolean {\n\tconst stored = JSON.parse(scopeJson) as Pick<MemoryScope, \"projectId\" | \"taskId\">;\n\treturn stored.projectId === scope.projectId && stored.taskId === scope.taskId;\n}\n\ninterface MemoryDbRow {\n\tid: string;\n\tkind: string;\n\tscope_json: string;\n\tcurrent_revision: number;\n\tusage_state: string;\n\tmerged_into: string | null;\n}\n\nfunction getMemoryRow(db: DatabaseSync, id: string): MemoryDbRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT id, kind, scope_json, current_revision, usage_state, merged_into\n\t\t\t FROM memories WHERE id = ?`,\n\t\t)\n\t\t.get(id) as MemoryDbRow | undefined;\n}\n\nfunction currentRevisionContent(\n\tdb: DatabaseSync,\n\tmemoryId: string,\n\trevision: number,\n): MemoryRevisionContent | undefined {\n\tconst row = db\n\t\t.prepare(`SELECT content_json FROM memory_revisions WHERE memory_id = ? AND revision = ?`)\n\t\t.get(memoryId, revision) as { content_json: string } | undefined;\n\treturn row === undefined ? undefined : (JSON.parse(row.content_json) as MemoryRevisionContent);\n}\n\ninterface StaleRequestSnapshot {\n\tmemoryId: string;\n\tsnapshotRevision: number;\n\tsourceIds: string[];\n}\n\n/**\n * 候选是否沿用请求快照中已失效的修订。\n *\n * 不靠结论文本判断归属：候选来源与该修订实际关联的来源相交，且提交时\n * 当前修订或使用状态已变化，就无法排除候选在重建旧事实。此时候选由调度\n * 标记为需重新评估，同来源可能附带的新事实也不由旧结果冒充提交。全新来源\n * 重申旧决定没有来源交集；相关修订未变化时，同来源的独立事实仍正常进入\n * 后续去重与提交。\n */\nfunction findStaleRequestSnapshot(\n\tdb: DatabaseSync,\n\tcandidate: ValidatedCandidate,\n\trelatedMemories: RelatedMemorySummary[],\n\tscope: MemoryScope,\n): StaleRequestSnapshot | undefined {\n\tconst candidateSourceIds = new Set(candidate.sourceIds);\n\tconst snapshotSources = db.prepare(\n\t\t`SELECT source_id FROM memory_source_links\n\t\t WHERE memory_id = ? AND revision = ?`,\n\t);\n\n\tfor (const related of relatedMemories) {\n\t\tconst sources = (\n\t\t\tsnapshotSources.all(related.memoryId, related.currentRevision) as unknown as Array<{\n\t\t\t\tsource_id: string;\n\t\t\t}>\n\t\t)\n\t\t\t.map((row) => row.source_id)\n\t\t\t.filter((sourceId) => candidateSourceIds.has(sourceId));\n\t\tif (sources.length === 0) continue;\n\n\t\tconst row = getMemoryRow(db, related.memoryId);\n\t\tif (\n\t\t\t!row ||\n\t\t\t!memoryMatchesScope(row.scope_json, scope) ||\n\t\t\trow.current_revision !== related.currentRevision ||\n\t\t\trow.usage_state !== \"active\" ||\n\t\t\trow.merged_into !== null\n\t\t) {\n\t\t\treturn {\n\t\t\t\tmemoryId: related.memoryId,\n\t\t\t\tsnapshotRevision: related.currentRevision,\n\t\t\t\tsourceIds: sources,\n\t\t\t};\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 各步核对\n// ════════════════════════════════════════════════════════════════════════\n\n/** S2-09：候选任一来源命中 source_exclusions → 返回命中列表（含 sessionId+entryId 形式）。 */\nfunction excludedSources(\n\tdb: DatabaseSync,\n\tcandidate: ValidatedCandidate,\n\tsourceRefs: CommitExtractionInput[\"sourceRefs\"],\n): string[] {\n\tconst refBySourceId = new Map(sourceRefs.map((ref) => [ref.sourceId, ref]));\n\tconst excluded = new Set<string>();\n\tfor (const sourceId of candidate.sourceIds) {\n\t\tif (isSourceExcluded(db, { sourceId })) {\n\t\t\texcluded.add(sourceId);\n\t\t\tcontinue;\n\t\t}\n\t\t// 删除按 sessionId+entryId 记的排除未必带 sourceId——两个形式都查。\n\t\tconst ref = refBySourceId.get(sourceId);\n\t\tif (ref !== undefined && isSourceExcluded(db, { sessionId: ref.sessionId, entryId: ref.entryId })) {\n\t\t\texcluded.add(sourceId);\n\t\t}\n\t}\n\treturn [...excluded];\n}\n\n/**\n * S2-07 来源级命中：候选任一来源已被某记忆引用过，且该记忆同 kind +\n * 当前修订结论归一相同 → 返回 memoryId 与当前修订内容（调用方先核实质\n * 差异再决定补链/升级/转后续分支——同来源重复结果不新建，但确认状态、\n * 证据类别、理由或条件的变化不能被去重吞掉）。\n */\nfunction findSourceLevelDuplicate(\n\tdb: DatabaseSync,\n\tcandidate: ValidatedCandidate,\n\tnormalizedConclusion: string,\n\tscope: MemoryScope,\n): { memoryId: string; currentRevision: number; content: MemoryRevisionContent } | undefined {\n\tconst seen = new Set<string>();\n\tfor (const sourceId of candidate.sourceIds) {\n\t\tfor (const { memoryId } of revisionsForSource(db, sourceId)) {\n\t\t\tif (seen.has(memoryId)) continue;\n\t\t\tseen.add(memoryId);\n\t\t\tconst row = getMemoryRow(db, memoryId);\n\t\t\t// 已合并走/已停用的记忆不作为复用目标（S2-09：停用/删除后旧候选\n\t\t\t// 不能悄悄复用旧 ID；canonical 另有其主）。\n\t\t\tif (\n\t\t\t\t!row ||\n\t\t\t\t!memoryMatchesScope(row.scope_json, scope) ||\n\t\t\t\trow.merged_into !== null ||\n\t\t\t\trow.usage_state !== \"active\" ||\n\t\t\t\trow.kind !== candidate.kind\n\t\t\t) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tconst content = currentRevisionContent(db, memoryId, row.current_revision);\n\t\t\tif (content === undefined) continue;\n\t\t\tif (normalizeConclusion(content.conclusion) === normalizedConclusion) {\n\t\t\t\treturn { memoryId, currentRevision: row.current_revision, content };\n\t\t\t}\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * 候选与既有当前修订相比是否有实质差异：任何一项不同即不能按纯重复处理。\n * 供来源级命中与同范围同结论两个分支共用同一口径。\n */\nfunction semanticDelta(\n\tcandidate: ValidatedCandidate,\n\tcontent: MemoryRevisionContent,\n): {\n\tconfirmationChanged: boolean;\n\tevidenceKindChanged: boolean;\n\trationaleChanged: boolean;\n\tconditionsChanged: boolean;\n} {\n\treturn {\n\t\tconfirmationChanged: content.confirmation !== candidate.confirmation,\n\t\tevidenceKindChanged: content.evidenceKind !== candidate.evidenceKind,\n\t\trationaleChanged: (content.rationale ?? \"\") !== (candidate.rationale ?? \"\"),\n\t\tconditionsChanged: (content.conditions ?? \"\") !== (candidate.conditions ?? \"\"),\n\t};\n}\n\n/**\n * 证据类别是否属「纯升级」：目标 model_inference（推断），候选 user_statement\n * 或 execution（经校验的真实用户/执行依据）——依据从助手推断升级为实据时\n * 允许随确认升级一并转正。降级方向（user_statement/execution →\n * model_inference）与其余类别互转不算升级，仍走 semantic_conflict，\n * 不静默改写依据身份。\n */\nfunction isEvidenceUpgrade(targetKind: EvidenceKind, candidateKind: EvidenceKind): boolean {\n\treturn (\n\t\ttargetKind === \"model_inference\" &&\n\t\t(candidateKind === \"user_statement\" || candidateKind === \"execution\")\n\t);\n}\n\n/**\n * 把候选的来源补链进既有记忆的当前修订；返回本次新链入的来源数。\n * 已有 (memory_id, revision, source_id) 行由 INSERT OR IGNORE 跳过不算新。\n */\nfunction linkSourcesToRevision(db: DatabaseSync, memoryId: string, revision: number, sourceIds: string[]): number {\n\tlet linked = 0;\n\tfor (const sourceId of sourceIds) {\n\t\tconst existing = db\n\t\t\t.prepare(`SELECT 1 AS ok FROM memory_source_links WHERE memory_id = ? AND revision = ? AND source_id = ?`)\n\t\t\t.get(memoryId, revision, sourceId);\n\t\tif (existing !== undefined) continue;\n\t\t// 来源行缺失时不补链（sources 外键会拒绝）；调用方来源均经 S2-04 校验，\n\t\t// 缺失只可能是校验后被删——跳过比整批失败更符合 S2-09「丢本次提交」。\n\t\tconst sourceExists = db.prepare(`SELECT 1 AS ok FROM sources WHERE source_id = ?`).get(sourceId);\n\t\tif (sourceExists === undefined) continue;\n\t\tdb.prepare(`INSERT OR IGNORE INTO memory_source_links (memory_id, revision, source_id) VALUES (?, ?, ?)`).run(\n\t\t\tmemoryId,\n\t\t\trevision,\n\t\t\tsourceId,\n\t\t);\n\t\tlinked += 1;\n\t}\n\treturn linked;\n}\n\n/**\n * S2-06 同范围决定扫描：找同 projectId + 同 kind + 结论归一相同的其他激活记忆，\n * 返回第一个命中（含其当前修订内容，调用方再比 conditions）。\n * merged_into 非空的副本与已停用记忆不参与（S2-09：复用/标记只打在激活的 canonical 上）。\n * 无 projectId 的 scope 不匹配任何项目记忆（提交范围由调度保证有 projectId）。\n */\nfunction findSameConclusionMemory(\n\tdb: DatabaseSync,\n\tscope: MemoryScope,\n\tcandidate: ValidatedCandidate,\n\tnormalizedConclusion: string,\n\texcludeMemoryId?: string,\n): { memoryId: string; currentRevision: number; content: MemoryRevisionContent } | undefined {\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT id, current_revision FROM memories\n\t\t\t WHERE kind = ? AND merged_into IS NULL AND usage_state = 'active'\n\t\t\t   AND json_extract(scope_json, '$.projectId') = ?\n\t\t\t   AND ${\n\t\t\t\t\tscope.taskId === undefined\n\t\t\t\t\t\t? \"json_extract(scope_json, '$.taskId') IS NULL\"\n\t\t\t\t\t\t: \"json_extract(scope_json, '$.taskId') = ?\"\n\t\t\t\t}`,\n\t\t)\n\t\t.all(candidate.kind, scope.projectId, ...(scope.taskId === undefined ? [] : [scope.taskId])) as unknown as Array<{\n\t\tid: string;\n\t\tcurrent_revision: number;\n\t}>;\n\tfor (const row of rows) {\n\t\tif (excludeMemoryId !== undefined && row.id === excludeMemoryId) continue;\n\t\tconst content = currentRevisionContent(db, row.id, row.current_revision);\n\t\tif (content === undefined) continue;\n\t\tif (normalizeConclusion(content.conclusion) === normalizedConclusion) {\n\t\t\treturn { memoryId: row.id, currentRevision: row.current_revision, content };\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/**\n * O03/F05：候选任一来源已关联某条「已停用且未合并、同 kind 同 scope」的记忆。\n *\n * 复用 revisionsForSource 反查来源命中的记忆——stopped 是用户明确停用，\n * 同来源重放不能绕过它走 createMemory 另建 active 副本；返回第一个命中的\n * memoryId。全新来源（不在任何 stopped 记忆的 memory_source_links 里）查不到，\n * 不拦截——这是「同 ID/同来源不复活、新表达可新建」的边界。\n */\nfunction findStoppedSourceMemory(\n\tdb: DatabaseSync,\n\tcandidate: ValidatedCandidate,\n\tscope: MemoryScope,\n): { memoryId: string } | undefined {\n\tconst seen = new Set<string>();\n\tfor (const sourceId of candidate.sourceIds) {\n\t\tfor (const { memoryId } of revisionsForSource(db, sourceId)) {\n\t\t\tif (seen.has(memoryId)) continue;\n\t\t\tseen.add(memoryId);\n\t\t\tconst row = getMemoryRow(db, memoryId);\n\t\t\tif (\n\t\t\t\trow !== undefined &&\n\t\t\t\trow.usage_state === \"stopped\" &&\n\t\t\t\trow.merged_into === null &&\n\t\t\t\trow.kind === candidate.kind &&\n\t\t\t\tmemoryMatchesScope(row.scope_json, scope)\n\t\t\t) {\n\t\t\t\treturn { memoryId };\n\t\t\t}\n\t\t}\n\t}\n\treturn undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 入口\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 提交一批已校验候选（异步：注入的服务方法返回 Promise，逐候选顺序处理）。\n *\n * service 只取 `createMemory`/`flagForReDiscussion`/`correctMemory` 三个\n * 方法——提交、标记与确认升级的 CAS/事务/校验在服务内闭环，本模块不复制\n * 业务规则（同一规则只实现一次）。\n *\n * 每个候选依次过六道关（详见文件头注释顺序）；事务粒度为候选级而非全批\n * 单事务——嵌套 BEGIN IMMEDIATE 在 node:sqlite 会抛错，且候选级 CAS 正好\n * 满足 S2-09「失效候选丢本次提交，不牵连同批其他候选」。\n */\nexport async function commitExtractionCandidates(\n\tstore: MemoryStore,\n\tservice: Pick<MemoryService, \"createMemory\" | \"flagForReDiscussion\" | \"correctMemory\">,\n\tinput: CommitExtractionInput,\n): Promise<CommitExtractionOutput> {\n\tconst db = store.db;\n\tconst createdBy = input.createdBy ?? \"model\";\n\tconst relatedMemories = input.relatedMemories ?? [];\n\tconst outcomes: CommitCandidateOutcome[] = [];\n\t// S2-13 批内记录：「kind + 归一结论」→ 该结论在本批最近一次成功落库的目标\n\t// （memoryId + 当前修订号 + 首个候选 index）。第二条起对同一结论的候选\n\t// 对批内落库目标走与库内命中一致的实质差异分派——确认升级、条件重议与\n\t// 语义冲突不再被批内去重短路吞掉；candidateIndex 保留作 duplicateOf 展示。\n\tconst batchSeen = new Map<string, { memoryId: string; currentRevision: number; candidateIndex: number }>();\n\tconst counters = { submitted: 0, duplicates: 0, flagged: 0, skipped: 0, corrected: 0, rejected: 0 };\n\n\t/** 触发来源取候选第一条来源的会话信息（缺 ref 时退回空 sessionId 兜底）。 */\n\tconst triggerRefFor = (candidate: ValidatedCandidate) =>\n\t\tinput.sourceRefs.find((ref) => ref.sourceId === candidate.sourceIds[0]);\n\n\t/**\n\t * 候选与既有当前修订同归一结论时的统一分派（F04/I01）：\n\t * - 无实质差异 → 复用已有 ID，把新来源补链进当前修订。\n\t *   batchKey 给出时本出口属批内命中，返回 `duplicate_in_batch` 语义\n\t *   （只有无差异才落到这——实质差异走下面的明确出口）。\n\t * - 仅 confirmation tentative → confirmed（同条件/理由，证据类别\n\t *   不变或为 model_inference → user_statement/execution 的升级）→\n\t *   走 correctMemory 确认升级修订，新修订来源 = 候选来源 ∪ 旧修订来源。\n\t * - conditions 不同且候选有用户/执行实据且已定案（user_statement 或\n\t *   execution + confirmed）→ flagForReDiscussion 重议；推断或未定案的\n\t *   条件变化不修订已确认决定的重议状态，落到下一档如实跳过。\n\t * - 其余实质差异（理由/确认反向/证据降级或互转、推断的条件变化）→\n\t *   skipped/semantic_conflict，留给下一轮重评估。\n\t * 返回 true 表示本分派已闭合（含服务拒绝的 rejected）；false 让调用方\n\t * 继续后续流程（如批内命中时转同范围扫描）。\n\t */\n\tconst dispatchSameConclusion = async (\n\t\tcandidate: ValidatedCandidate,\n\t\tcandidateIndex: number,\n\t\ttarget: { memoryId: string; currentRevision: number; content: MemoryRevisionContent },\n\t\tbatchKey?: string,\n\t): Promise<boolean> => {\n\t\tconst delta = semanticDelta(candidate, target.content);\n\t\tconst unchanged =\n\t\t\t!delta.confirmationChanged && !delta.evidenceKindChanged && !delta.rationaleChanged && !delta.conditionsChanged;\n\t\tif (unchanged) {\n\t\t\t// 同结论同条件不新建：补链新来源、复用已有 ID。\n\t\t\tconst linked = store.transaction(() =>\n\t\t\t\tlinkSourcesToRevision(db, target.memoryId, target.currentRevision, candidate.sourceIds),\n\t\t\t);\n\t\t\tif (batchKey === undefined) {\n\t\t\t\toutcomes.push({ status: \"duplicate\", candidateIndex, memoryId: target.memoryId, linkedSources: linked });\n\t\t\t\tcounters.duplicates += 1;\n\t\t\t} else {\n\t\t\t\tconst first = batchSeen.get(batchKey);\n\t\t\t\toutcomes.push({\n\t\t\t\t\tstatus: \"skipped\",\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t\treason: \"duplicate_in_batch\",\n\t\t\t\t\tduplicateOf: first?.candidateIndex ?? candidateIndex,\n\t\t\t\t});\n\t\t\t\tcounters.skipped += 1;\n\t\t\t\tif (first !== undefined) {\n\t\t\t\t\tbatchSeen.set(batchKey, { memoryId: target.memoryId, currentRevision: target.currentRevision, candidateIndex: first.candidateIndex });\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn true;\n\t\t}\n\t\tconst upgradeOnly =\n\t\t\ttarget.content.confirmation === \"tentative\" &&\n\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\tdelta.confirmationChanged &&\n\t\t\t(!delta.evidenceKindChanged || isEvidenceUpgrade(target.content.evidenceKind, candidate.evidenceKind)) &&\n\t\t\t!delta.conditionsChanged &&\n\t\t\t!delta.rationaleChanged;\n\t\tif (upgradeOnly) {\n\t\t\tconst triggerRef = triggerRefFor(candidate);\n\t\t\tconst corrected = await service.correctMemory({\n\t\t\t\tid: target.memoryId,\n\t\t\t\texpectedRevision: target.currentRevision,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: candidate.conclusion,\n\t\t\t\t\t...(candidate.conditions === undefined ? {} : { conditions: candidate.conditions }),\n\t\t\t\t\t...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n\t\t\t\t\tevidenceKind: candidate.evidenceKind,\n\t\t\t\t\tconfirmation: candidate.confirmation,\n\t\t\t\t},\n\t\t\t\tsource: {\n\t\t\t\t\tsessionId: triggerRef?.sessionId ?? \"\",\n\t\t\t\t\t...(triggerRef === undefined ? {} : { entryId: triggerRef.entryId }),\n\t\t\t\t},\n\t\t\t\tsourceIds: candidate.sourceIds,\n\t\t\t\tcreatedAt: input.now,\n\t\t\t});\n\t\t\tif (!corrected.ok) {\n\t\t\t\toutcomes.push({ status: \"rejected\", candidateIndex, error: corrected.error });\n\t\t\t\tcounters.rejected += 1;\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\toutcomes.push({\n\t\t\t\tstatus: \"corrected\",\n\t\t\t\tcandidateIndex,\n\t\t\t\tmemoryId: target.memoryId,\n\t\t\t\trevision: corrected.revision,\n\t\t\t});\n\t\t\tcounters.corrected += 1;\n\t\t\tif (batchKey !== undefined) {\n\t\t\t\tconst first = batchSeen.get(batchKey);\n\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\tmemoryId: target.memoryId,\n\t\t\t\t\tcurrentRevision: corrected.revision,\n\t\t\t\t\tcandidateIndex: first?.candidateIndex ?? candidateIndex,\n\t\t\t\t});\n\t\t\t}\n\t\t\treturn true;\n\t\t}\n\t\tif (delta.conditionsChanged) {\n\t\t\t// 重议必须有用户/执行实据：confirmed 的 user_statement 或 execution\n\t\t\t// 条件变化才触发 flagForReDiscussion——模型推断或未定案的条件变化\n\t\t\t// 不能替用户改条件、不修订已确认决定的重议状态，如实跳过走\n\t\t\t// semantic_conflict 留给下一轮重评估（I03）。\n\t\t\tconst hasTriggerEvidence =\n\t\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\t\t(candidate.evidenceKind === \"user_statement\" || candidate.evidenceKind === \"execution\");\n\t\t\tif (hasTriggerEvidence) {\n\t\t\t\tconst triggerRef = triggerRefFor(candidate);\n\t\t\t\tconst flagged = await service.flagForReDiscussion({\n\t\t\t\t\tid: target.memoryId,\n\t\t\t\t\texpectedRevision: target.currentRevision,\n\t\t\t\t\tnote: `条件变化触发重议：候选条件「${candidate.conditions ?? \"（无）\"}」与已有条件「${target.content.conditions ?? \"（无）\"}」不同（jobId=${input.jobId}）`,\n\t\t\t\t\tsource: {\n\t\t\t\t\t\tsessionId: triggerRef?.sessionId ?? \"\",\n\t\t\t\t\t\t...(triggerRef === undefined ? {} : { entryId: triggerRef.entryId }),\n\t\t\t\t\t},\n\t\t\t\t\tsourceIds: candidate.sourceIds,\n\t\t\t\t\tcreatedAt: input.now,\n\t\t\t\t});\n\t\t\t\tif (!flagged.ok) {\n\t\t\t\t\toutcomes.push({ status: \"rejected\", candidateIndex, error: flagged.error });\n\t\t\t\t\tcounters.rejected += 1;\n\t\t\t\t\treturn true;\n\t\t\t\t}\n\t\t\t\toutcomes.push({\n\t\t\t\t\tstatus: \"flagged\",\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t\tmemoryId: target.memoryId,\n\t\t\t\t\trevision: flagged.revision,\n\t\t\t\t});\n\t\t\t\tcounters.flagged += 1;\n\t\t\t\tif (batchKey !== undefined) {\n\t\t\t\t\tconst first = batchSeen.get(batchKey);\n\t\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\t\tmemoryId: target.memoryId,\n\t\t\t\t\t\tcurrentRevision: flagged.revision,\n\t\t\t\t\t\tcandidateIndex: first?.candidateIndex ?? candidateIndex,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t\toutcomes.push({\n\t\t\tstatus: \"skipped\",\n\t\t\tcandidateIndex,\n\t\t\treason: \"semantic_conflict\",\n\t\t\tmemoryId: target.memoryId,\n\t\t\tdelta: { ...delta },\n\t\t});\n\t\tcounters.skipped += 1;\n\t\treturn true;\n\t};\n\n\tfor (const [candidateIndex, candidate] of input.candidates.entries()) {\n\t\tconst normalized = normalizeConclusion(candidate.conclusion);\n\t\tconst commitScope = scopeForCandidate(candidate, input.scope, input.sourceRefs);\n\n\t\t// ── 1. S2-09 排除核对 ────────────────────────────────────────────\n\t\tconst excluded = excludedSources(db, candidate, input.sourceRefs);\n\t\tif (excluded.length > 0) {\n\t\t\toutcomes.push({ status: \"skipped\", candidateIndex, reason: \"source_excluded\", excludedSourceIds: excluded });\n\t\t\tcounters.skipped += 1;\n\t\t\tcontinue;\n\t\t}\n\n\t\t// ── 2. 请求前快照失效核对 ────────────────────────────────────────\n\t\tconst staleSnapshot = findStaleRequestSnapshot(db, candidate, relatedMemories, commitScope);\n\t\tif (staleSnapshot !== undefined) {\n\t\t\toutcomes.push({\n\t\t\t\tstatus: \"skipped\",\n\t\t\t\tcandidateIndex,\n\t\t\t\treason: \"stale_request_snapshot\",\n\t\t\t\t...staleSnapshot,\n\t\t\t});\n\t\t\tcounters.skipped += 1;\n\t\t\tcontinue;\n\t\t}\n\n\t\t// ── 3. S2-13 批内命中：对本批已落库目标走与库内一致的分派 ─────\n\t\tconst batchKey = `${candidate.kind}|${commitScope.projectId}|${commitScope.taskId ?? \"\"}|${normalized}`;\n\t\tconst batchHit = batchSeen.get(batchKey);\n\t\tif (batchHit !== undefined) {\n\t\t\t// batchSeen 记的就是库内当前修订（每次落库后同步前进）——第二条起\n\t\t\t// 与它走同一 dispatchSameConclusion 分派，实质差异不再被吞。\n\t\t\tconst batchTarget = currentRevisionContent(db, batchHit.memoryId, batchHit.currentRevision);\n\t\t\tif (batchTarget !== undefined) {\n\t\t\t\tconst dispatched = await dispatchSameConclusion(\n\t\t\t\t\tcandidate,\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t\t{ memoryId: batchHit.memoryId, currentRevision: batchHit.currentRevision, content: batchTarget },\n\t\t\t\t\tbatchKey,\n\t\t\t\t);\n\t\t\t\tif (dispatched) continue;\n\t\t\t}\n\t\t\t// 批内记录但库内读不到修订（异常路径）→ 按批内重复如实跳过，\n\t\t\t// 不静默新建第二条同结论记忆。\n\t\t\toutcomes.push({\n\t\t\t\tstatus: \"skipped\",\n\t\t\t\tcandidateIndex,\n\t\t\t\treason: \"duplicate_in_batch\",\n\t\t\t\tduplicateOf: batchHit.candidateIndex,\n\t\t\t});\n\t\t\tcounters.skipped += 1;\n\t\t\tcontinue;\n\t\t}\n\n\t\t// ── 4. S2-07 来源级命中：先核实质差异再决定补链/升级/转后续 ─────\n\t\tconst sourceHit = findSourceLevelDuplicate(db, candidate, normalized, commitScope);\n\t\tif (sourceHit !== undefined) {\n\t\t\tconst delta = semanticDelta(candidate, sourceHit.content);\n\t\t\tconst unchanged =\n\t\t\t\t!delta.confirmationChanged &&\n\t\t\t\t!delta.evidenceKindChanged &&\n\t\t\t\t!delta.rationaleChanged &&\n\t\t\t\t!delta.conditionsChanged;\n\t\t\tif (unchanged) {\n\t\t\t\t// 同来源重复结果不新建：补链新来源、复用已有 ID（口径不变）。\n\t\t\t\tconst linked = store.transaction(() =>\n\t\t\t\t\tlinkSourcesToRevision(db, sourceHit.memoryId, sourceHit.currentRevision, candidate.sourceIds),\n\t\t\t\t);\n\t\t\t\toutcomes.push({\n\t\t\t\t\tstatus: \"duplicate\",\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t\tmemoryId: sourceHit.memoryId,\n\t\t\t\t\tlinkedSources: linked,\n\t\t\t\t});\n\t\t\t\tcounters.duplicates += 1;\n\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\tmemoryId: sourceHit.memoryId,\n\t\t\t\t\tcurrentRevision: sourceHit.currentRevision,\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t});\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 仅 tentative → confirmed 的确认升级（含 model_inference →\n\t\t\t// user_statement/execution 的证据升级）走 correctMemory 修订；\n\t\t\t// 其余实质差异（条件/理由变化、确认反向、证据降级或互转）不静默\n\t\t\t// 处理——转第 5 关按同一分派口径统一处理。\n\t\t\tconst upgraded =\n\t\t\t\tsourceHit.content.confirmation === \"tentative\" &&\n\t\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\t\tdelta.confirmationChanged &&\n\t\t\t\t(!delta.evidenceKindChanged ||\n\t\t\t\t\tisEvidenceUpgrade(sourceHit.content.evidenceKind, candidate.evidenceKind)) &&\n\t\t\t\t!delta.conditionsChanged &&\n\t\t\t\t!delta.rationaleChanged;\n\t\t\tif (upgraded && (await dispatchSameConclusion(candidate, candidateIndex, sourceHit, batchKey))) continue;\n\t\t}\n\n\t\t// ── 4.5 O03/F05 同来源停用核对：来源关联的既有记忆 stopped 且未合并、\n\t\t//    同 kind 同 scope → 不新建 active 副本，如实跳过留 job 重评。\n\t\t//    全新来源（旧 stopped 记忆的 memory_source_links 查不到）不命中本关。\n\t\tconst stoppedSource = findStoppedSourceMemory(db, candidate, commitScope);\n\t\tif (stoppedSource !== undefined) {\n\t\t\toutcomes.push({\n\t\t\t\tstatus: \"skipped\",\n\t\t\t\tcandidateIndex,\n\t\t\t\treason: \"source_resting_stopped\",\n\t\t\t\tmemoryId: stoppedSource.memoryId,\n\t\t\t});\n\t\t\tcounters.skipped += 1;\n\t\t\tcontinue;\n\t\t}\n\n\t\t// ── 5. S2-06 同范围决定核对 + 实质差异分派 ──────────────────────\n\t\t//    同 kind + 结论归一相同：无差异 → 补链 duplicate；\n\t\t//    conditions 不同且有用户/执行实据 → 标需重议（业务上明确的重议\n\t\t//    信号，差异并存时条件优先）；仅 tentative → confirmed → 确认升级\n\t\t//    修订；其余组合如实跳过 semantic_conflict（不替用户裁纠正还是新\n\t\t//    决定）。批内命中第 3 关已先走一步——走到这的批内候选只可能在\n\t\t//    batchSeen 记录与库内状态脱节时重新落到本关，分派结果一致。\n\t\tconst sameConclusion = sourceHit ?? findSameConclusionMemory(db, commitScope, candidate, normalized);\n\t\tif (sameConclusion !== undefined) {\n\t\t\tconst delta = semanticDelta(candidate, sameConclusion.content);\n\t\t\tif (delta.conditionsChanged) {\n\t\t\t\t// 触发来源取候选第一条来源的会话信息（source 仅在未给 sourceIds\n\t\t\t\t// 时用于登记事件来源——此处显式传 sourceIds，source 只作兜底标识）。\n\t\t\t\t// 重议必须有用户/执行实据：confirmed 的 user_statement/execution\n\t\t\t\t// 条件变化才触发；推断或 tentative 变化不修订已确认决定的重议\n\t\t\t\t// 状态，落到 semantic_conflict 如实跳过（I03）。\n\t\t\t\tconst hasTriggerEvidence =\n\t\t\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\t\t\t(candidate.evidenceKind === \"user_statement\" || candidate.evidenceKind === \"execution\");\n\t\t\t\tif (hasTriggerEvidence) {\n\t\t\t\t\tconst triggerRef = triggerRefFor(candidate);\n\t\t\t\t\tconst flagged = await service.flagForReDiscussion({\n\t\t\t\t\t\tid: sameConclusion.memoryId,\n\t\t\t\t\t\texpectedRevision: sameConclusion.currentRevision,\n\t\t\t\t\t\tnote: `条件变化触发重议：候选条件「${candidate.conditions ?? \"（无）\"}」与已有条件「${sameConclusion.content.conditions ?? \"（无）\"}」不同（jobId=${input.jobId}）`,\n\t\t\t\t\t\tsource: {\n\t\t\t\t\t\t\tsessionId: triggerRef?.sessionId ?? \"\",\n\t\t\t\t\t\t\t...(triggerRef === undefined ? {} : { entryId: triggerRef.entryId }),\n\t\t\t\t\t\t},\n\t\t\t\t\t\tsourceIds: candidate.sourceIds,\n\t\t\t\t\t\tcreatedAt: input.now,\n\t\t\t\t\t});\n\t\t\t\t\tif (!flagged.ok) {\n\t\t\t\t\t\toutcomes.push({ status: \"rejected\", candidateIndex, error: flagged.error });\n\t\t\t\t\t\tcounters.rejected += 1;\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\t}\n\t\t\t\t\toutcomes.push({\n\t\t\t\t\t\tstatus: \"flagged\",\n\t\t\t\t\t\tcandidateIndex,\n\t\t\t\t\t\tmemoryId: sameConclusion.memoryId,\n\t\t\t\t\t\trevision: flagged.revision,\n\t\t\t\t\t});\n\t\t\t\t\tcounters.flagged += 1;\n\t\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\t\tmemoryId: sameConclusion.memoryId,\n\t\t\t\t\t\tcurrentRevision: flagged.revision,\n\t\t\t\t\t\tcandidateIndex,\n\t\t\t\t\t});\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\t// 推断/tentative 的条件变化落下面 semantic_conflict 统一出口。\n\t\t\t}\n\t\t\tconst unchanged =\n\t\t\t\t!delta.confirmationChanged &&\n\t\t\t\t!delta.evidenceKindChanged &&\n\t\t\t\t!delta.rationaleChanged &&\n\t\t\t\t!delta.conditionsChanged;\n\t\t\tif (unchanged) {\n\t\t\t\t// 同结论同条件但来源级未命中（来源全新）：落 duplicate 语义，\n\t\t\t\t// 复用已有 ID 并把新来源补链进当前修订。\n\t\t\t\tconst linked = store.transaction(() =>\n\t\t\t\t\tlinkSourcesToRevision(\n\t\t\t\t\t\tdb,\n\t\t\t\t\t\tsameConclusion.memoryId,\n\t\t\t\t\t\tsameConclusion.currentRevision,\n\t\t\t\t\t\tcandidate.sourceIds,\n\t\t\t\t\t),\n\t\t\t\t);\n\t\t\t\toutcomes.push({\n\t\t\t\t\tstatus: \"duplicate\",\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t\tmemoryId: sameConclusion.memoryId,\n\t\t\t\t\tlinkedSources: linked,\n\t\t\t\t});\n\t\t\t\tcounters.duplicates += 1;\n\t\t\t\tbatchSeen.set(batchKey, {\n\t\t\t\t\tmemoryId: sameConclusion.memoryId,\n\t\t\t\t\tcurrentRevision: sameConclusion.currentRevision,\n\t\t\t\t\tcandidateIndex,\n\t\t\t\t});\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 仅 tentative → confirmed（含 model_inference → user_statement/\n\t\t\t// execution 的证据升级）：与来源级一致的确认升级出口。\n\t\t\tconst upgradeOnly =\n\t\t\t\tsameConclusion.content.confirmation === \"tentative\" &&\n\t\t\t\tcandidate.confirmation === \"confirmed\" &&\n\t\t\t\tdelta.confirmationChanged &&\n\t\t\t\t(!delta.evidenceKindChanged ||\n\t\t\t\t\tisEvidenceUpgrade(sameConclusion.content.evidenceKind, candidate.evidenceKind)) &&\n\t\t\t\t!delta.conditionsChanged &&\n\t\t\t\t!delta.rationaleChanged;\n\t\t\tif (upgradeOnly && (await dispatchSameConclusion(candidate, candidateIndex, sameConclusion, batchKey))) continue;\n\t\t\t// 其余实质差异：模型重述同结论但改了理由/降了状态/换了证据类别，\n\t\t\t// 或推断/tentative 带来的条件变化——没有足够依据替用户裁语义，\n\t\t\t// 如实跳过留给下一轮重评估。\n\t\t\toutcomes.push({\n\t\t\t\tstatus: \"skipped\",\n\t\t\t\tcandidateIndex,\n\t\t\t\treason: \"semantic_conflict\",\n\t\t\t\tmemoryId: sameConclusion.memoryId,\n\t\t\t\tdelta: { ...delta },\n\t\t\t});\n\t\t\tcounters.skipped += 1;\n\t\t\tcontinue;\n\t\t}\n\t\t// F12：无关结论各自入库，不凭文本差异自动建 related 语义关系。\n\n\t\t// ── 6. S2-05/S2-11 提交 ─────────────────────────────────────────\n\t\tconst created = await service.createMemory({\n\t\t\tkind: candidate.kind,\n\t\t\tscope: commitScope,\n\t\t\tconclusion: candidate.conclusion,\n\t\t\t...(candidate.conditions === undefined ? {} : { conditions: candidate.conditions }),\n\t\t\t...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n\t\t\tevidenceKind: candidate.evidenceKind,\n\t\t\tconfirmation: candidate.confirmation,\n\t\t\tsourceIds: candidate.sourceIds,\n\t\t\tcreatedBy,\n\t\t\tcreatedAt: input.now,\n\t\t\t// S2-11：承诺入库一律 open（只保存，不授权执行）；其他 kind 不传该字段。\n\t\t\t...(candidate.kind === \"commitment\" ? { commitmentStatus: \"open\" as const } : {}),\n\t\t});\n\t\tif (!created.ok) {\n\t\t\toutcomes.push({ status: \"rejected\", candidateIndex, error: created.error });\n\t\t\tcounters.rejected += 1;\n\t\t\tcontinue;\n\t\t}\n\t\toutcomes.push({ status: \"submitted\", candidateIndex, memoryId: created.id, revision: created.revision });\n\t\tcounters.submitted += 1;\n\t\tbatchSeen.set(batchKey, {\n\t\t\tmemoryId: created.id,\n\t\t\tcurrentRevision: created.revision,\n\t\t\tcandidateIndex,\n\t\t});\n\t}\n\n\treturn {\n\t\toutcomes,\n\t\tsubmitted: counters.submitted,\n\t\tduplicates: counters.duplicates,\n\t\tflagged: counters.flagged,\n\t\tskipped: counters.skipped,\n\t\tcorrected: counters.corrected,\n\t\trejected: counters.rejected,\n\t};\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆 S2-03/S2-04：经现有模型路由请求结构化候选 + 候选来源与状态校验。\n *\t// 请求各结各的费）。未传 budgetScopeKey 时跳过预算门与结算。\n\tconst budgetGateEnabled = deps.budgetScopeKey !== undefined && deps.paoHome !== undefined;\n\tconst budgetAttemptKey =\n\t\t deps.budgetAttemptKey === undefined ? requestId : `${deps.budgetAttemptKey}:${requestId}`;\n\tconst budgetNow = () => new Date().toISOString();\n\t// unlimited 直通不落预留 → 结算侧只对已预留判据 settle，不对账本空气结算。\treturn { ok: true, requestId, candidates, rejected, usage };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,112]}}},{"equalLines":{"line_count":451}},{"diffOp":{"equal":{"range":[112,313]}}},{"diffOp":{"delete":{"range":[313,316]}}},{"diffOp":{"insert":{"range":[316,317]}}},{"diffOp":{"equal":{"range":[317,563]}}},{"equalLines":{"line_count":122}},{"diffOp":{"equal":{"range":[563,627]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\extract-model.ts"},"span":null,"sourceCode":"/**\n * 内置记忆 S2-03/S2-04：经现有模型路由请求结构化候选 + 候选来源与状态校验。\n *\n * 契约：\n * - 不建第二套模型运行时：`tierNameToModel` 解析配置档位 → `modelRegistry.find` →\n *   `streamSimple(...).result()`，沿现有认证；chat 路径没有 JSON-schema 请求通道，\n *   结构化输出靠提示词约束 + 严格解析校验（不用 classify，问题形不匹配）。\n * - 记账（沿 cache-warmer/precompaction 先例）：调用方注入 `ledger`\n *   （`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`——后台记账会话或\n *   重开的原账本，由 D 批调度按 requestId 归属决定）；每次调用先记 attempt\n *   （custom entry 带 jobId+requestId），成功后 `appendUsage(\"memory_extraction\", …)`，\n *   note 带 `jobId`+`sourceSessionId`+requestId；API 未返回 usage 标未知，不伪造。\n * - 本批只到「请求 + 校验」：不提交入库（C 批），不挂事件（D 批）。\n * - 外发与预算（deps 给身份时启用）：输入形状校验后先过 `checkOutbound`\n *   （禁外发直接返回 failure，不占预算），再过 `checkMemoryJobBudget`\n *   （jobKind=\"extract\"，attemptKey 传了走批级判据）；请求异常/返回后按\n *   usage.cost.total 结算（缺省 → unknown 占额保留），异常同时补\n *   `pao-memory-extraction-failure` 失败回执。\n * - 解析：容忍模型在 JSON 外包裹少量文字，但候选本体必须是可解析 JSON 数组；\n *   解析失败返回结构化失败结果，不二次请求补全，不伪造空成功。\n * - 校验（S2-04）：sourceIds 全部在本次输入内；每段 quotedSpan 在对应来源已保存\n *   文本中可定位（子串匹配）；evidenceKind/confirmation 组合合法（confirmed 必须有\n *   user_statement 或 execution 证据）；缺 rationale 标未知而非补造。\n *   失败候选进 rejected 带原因，不提交。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { Api, AssistantMessage, Context, Model, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget } from \"./budget.ts\";\nimport {\n\tCONFIRMATION_STATES,\n\ttype ConfirmationState,\n\tEVIDENCE_KINDS,\n\ttype EvidenceKind,\n\ttype ExtractionCandidate,\n\ttype ExtractionSourceEntry,\n\ttype ExtractModelFailure,\n\ttype ExtractModelInput,\n\ttype ExtractModelOutput,\n\tMEMORY_KINDS,\n\ttype MemoryKind,\n\ttype MemoryResult,\n\ttype QuotedSpan,\n\ttype RejectedCandidate,\n\ttype SpanLocation,\n\ttype ValidatedCandidate,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * requestExtraction 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（precompaction 先例的迟到归属由注入方保证；同 jobId 的迟到\n *   结果仍归同一账本）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"，经 resolveTier 别名归一命中\n *   中文档名「快」）；`tierConfig` 也可直接注入跳过文件读取（测试用）。\n */\nexport interface RequestExtractionDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 提炼用档位名；缺省 \"fast\"（轻量档；别名归一后命中内置「快」档）。 */\n\ttierName?: string;\n\t/** 输出 token 上限（候选 JSON 比对话长，给足但防失控）；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 本批实际来源的项目名（外发许可判定用；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(paoHome)）。 */\n\toutbound?: OutboundConfig;\n\t/** 本次请求所属 job 的预算 scopeKey（extraction-jobs 的 scopeKey 同值）。 */\n\tbudgetScopeKey?: string;\n\t/**\n\t * 预算判据归属前缀（缺省判据即本次 requestId）。传入时拼为\n\t * `${budgetAttemptKey}:${requestId}`——判据主体仍是一调用一发的 requestId，\n\t * 显式注入同一值的多次实际请求各占独立预留，不会互相覆盖结算。\n\t */\n\tbudgetAttemptKey?: string;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词（常量，中文说明 + 严格 JSON 输出要求）\n// ════════════════════════════════════════════════════════════════════════\n\nconst EXTRACTION_PROMPT = `你是记忆提炼器。从给定的会话条目（已脱敏）中提炼值得长期记住的候选事实。\n\n# 候选类型（kind）\n- decision：正式决定——已确认的方案选择、架构取舍、用户契约。\n- experience：经验——可复用的做法、踩坑记录、验证结论。\n- lesson：教训——失败原因、反模式、已知边界。\n- commitment：承诺/待办——明确承诺但未完成的任务（只记录，不产生执行）。\n- 同一批输入中，同一承诺的用户原文与 assistant 确认/复述合成一个 commitment 候选，优先准确引用用户来源；纯确认或回声不另建独立承诺。同义承诺在本批内合并，不同任务或实质新承诺仍分别提炼。\n\n# 证据类别（evidenceKind）与确认状态（confirmation）的区分\n- 用户明确选定 X（例如「就用 X」「决定是 X」）→ evidenceKind=user_statement、confirmation=confirmed（confirmed 必须有 user_statement 或 execution 证据）。\n- 用户明确否决 Y（例如「不要 Y」）→ evidenceKind=user_statement、confirmation=rejected，conclusion 记被否决的方案，rationale 记实际否决理由。\n- 同一取舍中的采用 X 与拒绝 Y 必须拆成独立候选，分别记 confirmed 与 rejected，不能合并为一条 confirmed；否决项保留实际否决理由。\n- 取舍按用户作出该次决定当时已经提出的候选集合判断：若当时只有互斥「A 或 B」，用户排除 A 且没有明确留待定，B 就是该次取舍，记为 evidenceKind=user_statement、confirmation=confirmed，不要求用户再说「就选 B」；后续 assistant 单方面补充、建议、自评或重开 C、D 不撤销、不降级也不抹去该选择，也不能覆盖用户证据。原候选、用户否决和后续 assistant 建议须分别准确引用各自的 sourceId 与原文；后续 assistant 的建议或自评只能记为 evidenceKind=model_inference、confirmation=tentative，不能挂到用户来源或冒充 user_statement、用户确认。用户作出该次决定时若多候选未排完、明确表示未定或只是提议重议，仍为 tentative；对「先不定」「暂时这样」的简单附和、继续、记住或保留请求，只确认接收或保存暂定状态，不能把尚未定案的业务规则或「已确认的暂缓决定」提升 confirmed；真正明确的最终规则仍可 confirmed，不因「先」字一律降级。后续用户明确重新讨论或受新条件重议时，另记 tentative 并保留先前决定的理由，新条件不会自动使旧理由失效。\n- 用户说「可以考虑 X」「也许用 Y」「X 可能更好」→ confirmation=tentative。\n- 工具执行/测试结果证明某事实 → evidenceKind=execution；执行失败不产生 confirmed。\n- 你从上下文推断但未经用户确认 → evidenceKind=model_inference、confirmation=tentative。\n- 记忆召回、纠正、停用、恢复、删除及其回执属于管理操作。只执行或复述管理操作时，不生成新候选，也不把所管理的正文或管理过程复制成新的决定、经验、教训或承诺；若同段还有独立、明确、可长期复用的新决定或知识，只提炼该独立内容。\n- 未展示或未命中只说明当前缺少来源，不证明事实不存在、已删除或从未决定，也不能据此认定摘要虚构。assistant 仅据局部不可见作出的这类无来源断言不提炼为长期事实，即使写成经验或教训也不提炼。\n\n# 输出要求\n只输出一个 JSON 数组（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。数组每个元素：\n{\n  \"kind\": \"decision|experience|lesson|commitment\",\n  \"conclusion\": \"结论正文，一句话\",\n  \"conditions\": \"适用条件（可选）\",\n  \"rationale\": \"理由（可选；原文没说理由就省略，不要编造）\",\n  \"evidenceKind\": \"user_statement|execution|model_inference\",\n  \"confirmation\": \"confirmed|tentative|rejected\",\n  \"sourceIds\": [\"引用来源的 sourceId，必须来自下方条目列表\"],\n  \"quotedSpans\": [{\"sourceId\": \"来源ID\", \"text\": \"该来源正文中的原文子串，照抄不改写\"}]\n}\n没有可提炼内容时输出空数组 []。sourceIds 和 quotedSpans 至少一条，且只能引用下方列出的 sourceId。\n每条 quotedSpans 的 sourceId 必须是该段原文实际所在的条目，不能把 assistant 的话挂到 user 来源。结论、理由或条件来自不同条目时，sourceIds 要列全，并让各段原文使用各自条目的 sourceId。\nconfirmed 的 user_statement 至少引用一条 user 条目；execution 至少引用一条 toolResult 条目；quotedSpan 的 sourceId 必须全部出现在本条 sourceIds 里。`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 请求构造\n// ════════════════════════════════════════════════════════════════════════\n\nfunction buildUserContent(input: ExtractModelInput): string {\n\tconst entryLines = input.entries.map((entry) => {\n\t\treturn [\n\t\t\t`--- 条目 sourceId=${entry.sourceId} entryId=${entry.entryId} eventType=${entry.eventType} ---`,\n\t\t\tentry.content,\n\t\t].join(\"\\n\");\n\t});\n\tconst related = input.relatedMemories?.length\n\t\t? [\n\t\t\t\t\"# 同范围已有决定（供关联/重议判断，不是新证据）\",\n\t\t\t\t...input.relatedMemories.map(\n\t\t\t\t\t(memory) =>\n\t\t\t\t\t\t`- [${memory.kind}/${memory.confirmation}/${memory.usageState} rev${memory.currentRevision}] ${memory.conclusion}${\n\t\t\t\t\t\t\tmemory.conditions ? `（条件：${memory.conditions}）` : \"\"\n\t\t\t\t\t\t}`,\n\t\t\t\t),\n\t\t\t].join(\"\\n\")\n\t\t: \"\";\n\treturn [\n\t\t\"# 增量条目（本次提炼范围）\",\n\t\t...entryLines,\n\t\t...(related ? [\"\", related] : []),\n\t\t\"\",\n\t\t\"请输出候选 JSON 数组。\",\n\t].join(\"\\n\");\n}\n\n/** 从 AssistantMessage 提取全部文本块（忽略 thinking/toolCall）。 */\nfunction messageText(message: AssistantMessage): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 解析：容忍 JSON 外包裹的少量文字，候选本体必须是可解析 JSON 数组\n// ════════════════════════════════════════════════════════════════════════\n\n/** 取响应文本中的 JSON 数组本体：优先 ```json 代码块，否则首尾方括号区间。 */\nfunction extractJsonArray(text: string): unknown[] | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"[\");\n\t\tconst end = candidate.lastIndexOf(\"]\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (Array.isArray(parsed)) return parsed as unknown[];\n\t\t} catch {\n\t\t\t// 本段不是合法 JSON 数组——继续尝试下一段（不二次请求补全）。\n\t\t}\n\t}\n\treturn undefined;\n}\n\nfunction isString(value: unknown): value is string {\n\treturn typeof value === \"string\";\n}\n\n/** 把解析出的单元素收窄为 ExtractionCandidate 形状；不合法返回原因列表。 */\nfunction narrowCandidate(raw: unknown): { candidate?: ExtractionCandidate; problems: string[] } {\n\tconst problems: string[] = [];\n\tif (typeof raw !== \"object\" || raw === null || Array.isArray(raw)) {\n\t\treturn { problems: [\"候选不是 JSON 对象\"] };\n\t}\n\tconst obj = raw as Record<string, unknown>;\n\tconst kind =\n\t\tisString(obj.kind) && (MEMORY_KINDS as readonly string[]).includes(obj.kind)\n\t\t\t? (obj.kind as MemoryKind)\n\t\t\t: undefined;\n\tif (!kind) problems.push(`kind 非法:${JSON.stringify(obj.kind)}`);\n\tconst conclusion = isString(obj.conclusion) && obj.conclusion.trim() ? obj.conclusion.trim() : undefined;\n\tif (!conclusion) problems.push(\"conclusion 缺失或为空\");\n\tconst evidenceKind =\n\t\tisString(obj.evidenceKind) && (EVIDENCE_KINDS as readonly string[]).includes(obj.evidenceKind)\n\t\t\t? (obj.evidenceKind as EvidenceKind)\n\t\t\t: undefined;\n\tif (!evidenceKind) problems.push(`evidenceKind 非法:${JSON.stringify(obj.evidenceKind)}`);\n\tconst confirmation =\n\t\tisString(obj.confirmation) && (CONFIRMATION_STATES as readonly string[]).includes(obj.confirmation)\n\t\t\t? (obj.confirmation as ConfirmationState)\n\t\t\t: undefined;\n\tif (!confirmation) problems.push(`confirmation 非法:${JSON.stringify(obj.confirmation)}`);\n\n\tconst sourceIds = Array.isArray(obj.sourceIds) ? obj.sourceIds.filter(isString) : [];\n\tif (\n\t\t!Array.isArray(obj.sourceIds) ||\n\t\tsourceIds.length === 0 ||\n\t\tsourceIds.length !== (obj.sourceIds as unknown[]).length\n\t) {\n\t\tproblems.push(\"sourceIds 缺失、为空或含非字符串元素\");\n\t}\n\n\tconst quotedSpans: QuotedSpan[] = [];\n\tif (!Array.isArray(obj.quotedSpans) || obj.quotedSpans.length === 0) {\n\t\tproblems.push(\"quotedSpans 缺失或为空\");\n\t} else {\n\t\tfor (const [index, span] of (obj.quotedSpans as unknown[]).entries()) {\n\t\t\tif (\n\t\t\t\ttypeof span === \"object\" &&\n\t\t\t\tspan !== null &&\n\t\t\t\tisString((span as Record<string, unknown>).sourceId) &&\n\t\t\t\tisString((span as Record<string, unknown>).text) &&\n\t\t\t\t((span as Record<string, unknown>).text as string).length > 0\n\t\t\t) {\n\t\t\t\tquotedSpans.push({\n\t\t\t\t\tsourceId: (span as Record<string, unknown>).sourceId as string,\n\t\t\t\t\ttext: (span as Record<string, unknown>).text as string,\n\t\t\t\t});\n\t\t\t} else {\n\t\t\t\tproblems.push(`quotedSpans[${index}] 形状非法（需 {sourceId, text 非空}）`);\n\t\t\t}\n\t\t}\n\t}\n\n\tif (problems.length > 0 || !kind || !conclusion || !evidenceKind || !confirmation) {\n\t\treturn { problems };\n\t}\n\treturn {\n\t\tcandidate: {\n\t\t\tkind,\n\t\t\tconclusion,\n\t\t\t...(isString(obj.conditions) && obj.conditions.trim() ? { conditions: obj.conditions.trim() } : {}),\n\t\t\t// rationale 缺省即缺省——标未知（undefined），不补造。\n\t\t\t...(isString(obj.rationale) && obj.rationale.trim() ? { rationale: obj.rationale.trim() } : {}),\n\t\t\tevidenceKind,\n\t\t\tconfirmation,\n\t\t\tsourceIds,\n\t\t\tquotedSpans,\n\t\t},\n\t\tproblems: [],\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 校验（S2-04）：来源边界 + 引用可定位 + 证据/确认组合合法\n// ════════════════════════════════════════════════════════════════════════\n\nfunction locateSpan(span: QuotedSpan, textBySourceId: Map<string, string>): SpanLocation | undefined {\n\tconst text = textBySourceId.get(span.sourceId);\n\tif (text === undefined) return undefined;\n\tconst offset = text.indexOf(span.text);\n\tif (offset === -1) return undefined;\n\treturn { sourceId: span.sourceId, match: \"exact\", offset };\n}\n\nfunction validateCandidate(\n\tcandidate: ExtractionCandidate,\n\tentries: ExtractionSourceEntry[],\n): { validated?: ValidatedCandidate; reasons: string[] } {\n\tconst reasons: string[] = [];\n\tconst inputSourceIds = new Set(entries.map((entry) => entry.sourceId));\n\tconst textBySourceId = new Map(entries.map((entry) => [entry.sourceId, entry.content]));\n\n\t// 1) sourceIds 必须全部在本次输入内（越界引用＝虚构来源，拒）。\n\tconst outOfScope = candidate.sourceIds.filter((id) => !inputSourceIds.has(id));\n\tif (outOfScope.length > 0) {\n\t\treasons.push(`sourceIds 超出本次输入范围:${outOfScope.join(\"、\")}`);\n\t}\n\n\t// 2) 每段 quotedSpan 必须能在对应来源已保存文本中定位（记录定位结果）。\n\tconst spanLocations: SpanLocation[] = [];\n\tfor (const span of candidate.quotedSpans) {\n\t\tif (!inputSourceIds.has(span.sourceId)) {\n\t\t\treasons.push(`quotedSpan 引用输入外来源:${span.sourceId}`);\n\t\t\tcontinue;\n\t\t}\n\t\tconst located = locateSpan(span, textBySourceId);\n\t\tif (!located) {\n\t\t\treasons.push(\n\t\t\t\t`quotedSpan 在来源 ${span.sourceId} 已保存文本中无法定位:${JSON.stringify(span.text.slice(0, 80))}`,\n\t\t\t);\n\t\t} else {\n\t\t\tspanLocations.push(located);\n\t\t}\n\t}\n\n\t// 3) confirmed 必须有与 evidenceKind 同身份类别的实据：\n\t//    - user_statement：至少一条来源 eventType === \"user\"，且该来源在\n\t//      candidate.sourceIds 内；\n\t//    - execution：至少一条来源 eventType === \"toolResult\"；\n\t//    - model_inference：前面已拒，不重复。\n\t//    引用闭合：quotedSpan 的 sourceId 必须包含在 candidate.sourceIds 内\n\t//    （引用了未声明来源 = 虚构依据）。\n\tconst spanSourceIds = new Set(candidate.quotedSpans.map((span) => span.sourceId));\n\tconst unclosed = [...spanSourceIds].filter((id) => !candidate.sourceIds.includes(id));\n\tif (unclosed.length > 0) {\n\t\treasons.push(`quotedSpan 引用了未列入 sourceIds 的来源:${unclosed.join(\"、\")}`);\n\t}\n\n\tif (candidate.confirmation === \"confirmed\") {\n\t\tif (candidate.evidenceKind === \"model_inference\") {\n\t\t\treasons.push(\"confirmed 候选不允许 evidenceKind=model_inference（推断不能自证为定案）\");\n\t\t} else {\n\t\t\tconst byId = new Map(entries.map((entry) => [entry.sourceId, entry.eventType]));\n\t\t\tconst required = candidate.evidenceKind === \"user_statement\" ? \"user\" : \"toolResult\";\n\t\t\tconst hasEvidence = candidate.sourceIds.some((id) => byId.get(id) === required);\n\t\t\tif (!hasEvidence) {\n\t\t\t\treasons.push(\n\t\t\t\t\t`confirmed/${candidate.evidenceKind} 候选的来源中没有 eventType=${required} 的实据条目（${\n\t\t\t\t\t\trequired === \"user\" ? \"缺用户明确选择\" : \"缺执行回执\"\n\t\t\t\t\t}）`,\n\t\t\t\t);\n\t\t\t} else {\n\t\t\t\t// 引用层面同样闭合：声明 user_statement/execution 证据时，至少一段\n\t\t\t\t// quotedSpan 必须真落在对应类别的条目上——只在 sourceIds 里凑数、\n\t\t\t\t// 引文全挂别的类别，等于把别人（或自己）的话冒充成实据。\n\t\t\t\tconst hasQuotedEvidence = candidate.quotedSpans.some((span) => byId.get(span.sourceId) === required);\n\t\t\t\tif (!hasQuotedEvidence) {\n\t\t\t\t\treasons.push(\n\t\t\t\t\t\t`confirmed/${candidate.evidenceKind} 候选的 quotedSpans 未引用 eventType=${required} 的条目（${\n\t\t\t\t\t\t\trequired === \"user\" ? \"用户实据未引用用户原话\" : \"执行实据未引用执行回执原文\"\n\t\t\t\t\t\t}）`,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tif (reasons.length > 0) return { reasons };\n\treturn {\n\t\tvalidated: {\n\t\t\t...candidate,\n\t\t\tspanLocations,\n\t\t},\n\t\treasons: [],\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 入口：requestExtraction\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 发起一次提炼请求：档位解析 → find/streamSimple → 严格解析 → S2-04 校验。\n * 返回 `MemoryResult<ExtractModelOutput>`：\n * - 业务失败（档位缺失、模型找不到、响应不可解析、请求错误/取消）→\n *   `ok:true` + `failure`（阶段与原因保留），或 `ok:false` + MemoryError（配置类\n *   问题用 invalid_input/unavailable——候选不可提交但任务可重试的不算业务拒绝）。\n * - 解析失败按 `failure.stage=\"parse\"` 返回，不二次请求补全、不伪造空成功。\n */\nexport async function requestExtraction(\n\tdeps: RequestExtractionDeps,\n\tinput: ExtractModelInput,\n): Promise<MemoryResult<ExtractModelOutput>> {\n\tconst requestId = `${input.jobId}:extract:${randomUUID()}`;\n\t// 每次调用先记 attempt（含 jobId+requestId）——迟到结果仍归同一账本由注入方保证。\n\tdeps.ledger.appendCustomEntry(\"pao-memory-extraction-attempt\", {\n\t\trequestId,\n\t\tjobId: input.jobId,\n\t\tsourceSessionId: input.sourceSessionId,\n\t\tentryCount: input.entries.length,\n\t});\n\n\tif (input.entries.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"提炼输入为空：entries 至少一条\", refId: input.jobId },\n\t\t};\n\t}\n\n\t// 档位解析：tierConfig 注入优先，否则从 $PAO_HOME/pao配置/档位.json 读取；\n\t// 两者都缺 → invalid_input（调用方装配问题，非模型故障）。\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: \"缺档位来源：tierConfig 或 paoHome 至少给一个\",\n\t\t\t\t\trefId: input.jobId,\n\t\t\t\t},\n\t\t\t};\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\tconst failure: ExtractModelFailure = {\n\t\t\tstage: \"request\",\n\t\t\tmessage: `档位解析失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t\treturn { ok: true, requestId, candidates: [], rejected: [], failure };\n\t}\n\t// 按第一个斜杠切 provider/modelId——modelId 自身可能带斜杠（如 openrouter 的 org/model），\n\t// split(\"/\",2) 会截断误配。\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model: Model<Api> | undefined = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\tconst failure: ExtractModelFailure = {\n\t\t\tstage: \"request\",\n\t\t\tmessage: `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`,\n\t\t};\n\t\treturn { ok: true, requestId, candidates: [], rejected: [], failure };\n\t}\n\n\t// 外发许可门（档位解析之后、预算预留之前）：禁外发不发请求也不占预算。\n\tconst outboundProjects = deps.outboundProjects;\n\tif (outboundProjects !== undefined) {\n\t\tconst outbound = deps.outbound ?? (deps.paoHome ? loadOutboundConfig(deps.paoHome) : { projects: {} });\n\t\tconst permission = checkOutbound(outboundProjects, outbound);\n\t\tif (!permission.allowed) {\n\t\t\tconst failure: ExtractModelFailure = {\n\t\t\t\tstage: \"request\",\n\t\t\t\tmessage: `禁外发：项目 ${permission.blocked.join(\"、\")} 未获有效许可`,\n\t\t\t};\n\t\t\treturn { ok: true, requestId, candidates: [], rejected: [], failure };\n\t\t}\n\t}\n\n\t// 预算门：deps 传入 budgetScopeKey 时启用；attemptKey 绑本次实际请求身份\n\t// （requestId 每次调用独立生成——同批重试各持独立预留，不覆盖已发生费用）。\n\t// deps 显式注入 budgetAttemptKey 时作归属前缀拼进判据，判据主体仍是一次\n\t// 一发的 requestId——显式注入不能复用同一预留（F01：注入同键的两次实际\n\t// 请求各结各的费）。未传 budgetScopeKey 时跳过预算门与结算。\n\tconst budgetGateEnabled = deps.budgetScopeKey !== undefined && deps.paoHome !== undefined;\n\tconst budgetAttemptKey =\n\t\tdeps.budgetAttemptKey === undefined ? requestId : `${deps.budgetAttemptKey}:${requestId}`;\n\tconst budgetNow = () => new Date().toISOString();\n\t// unlimited 直通不落预留 → 结算侧只对已预留判据 settle，不对账本空气结算。\n\tlet budgetReserved = false;\n\tif (budgetGateEnabled) {\n\t\tconst verdict = await checkMemoryJobBudget({\n\t\t\tpaoHome: deps.paoHome!,\n\t\t\tjobId: input.jobId,\n\t\t\tjobKind: \"extract\",\n\t\t\tscopeKey: deps.budgetScopeKey ?? input.jobId,\n\t\t\tattemptKey: budgetAttemptKey,\n\t\t\t现在: budgetNow(),\n\t\t});\n\t\tif (!verdict.ok) {\n\t\t\tconst failure: ExtractModelFailure = {\n\t\t\t\tstage: \"request\",\n\t\t\t\tmessage: `预算门拒绝:${verdict.reason}`,\n\t\t\t};\n\t\t\treturn { ok: true, requestId, candidates: [], rejected: [], failure };\n\t\t}\n\t\tbudgetReserved = verdict.unlimited !== true;\n\t}\n\n\tconst context: Context = {\n\t\tsystemPrompt: EXTRACTION_PROMPT,\n\t\tmessages: [{ role: \"user\", content: buildUserContent(input), timestamp: Date.now() }],\n\t};\n\n\tlet message: AssistantMessage;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t// 档位 \"off\" = 关思考，不传 reasoning（ThinkingLevel 不含 off）；其余档直传。\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\t// 请求未返回：费用未知 → 占额保留（unknown），并补失败回执（F09）。\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tdeps.paoHome!,\n\t\t\t\tinput.jobId,\n\t\t\t\t\"extract\",\n\t\t\t\tundefined,\n\t\t\t\tbudgetNow(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tbudgetAttemptKey,\n\t\t\t);\n\t\t}\n\t\tdeps.ledger.appendCustomEntry(\"pao-memory-extraction-failure\", {\n\t\t\trequestId,\n\t\t\tjobId: input.jobId,\n\t\t\tsourceSessionId: input.sourceSessionId,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\tconst failure: ExtractModelFailure = {\n\t\t\tstage: \"request\",\n\t\t\tmessage: `请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t\treturn { ok: true, requestId, candidates: [], rejected: [], failure };\n\t}\n\n\t// 记账：已报告用量照常计入（含 error/aborted——零用量不能证明供应商未计费）。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"memory_extraction\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=extract jobId=${input.jobId} sourceSessionId=${input.sourceSessionId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\t// 结算：与记账同一「费用已知」口径——totalTokens=0 的默认零 usage 不证明免费，\n\t// 按 unknown 占额保留（F03）；cost 字段缺失同样 unknown，不释放。\n\tconst 实际费用 = message.usage.totalTokens > 0 ? message.usage.cost?.total : undefined;\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tdeps.paoHome!,\n\t\t\tinput.jobId,\n\t\t\t\"extract\",\n\t\t\t实际费用,\n\t\t\tbudgetNow(),\n\t\t\t`请求完成:${message.stopReason}`,\n\t\t\tbudgetAttemptKey,\n\t\t);\n\t}\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tconst failure: ExtractModelFailure = {\n\t\t\tstage: \"request\",\n\t\t\tmessage: `请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t};\n\t\treturn { ok: true, requestId, candidates: [], rejected: [], usage, failure };\n\t}\n\n\t// 解析：候选本体必须是可解析 JSON 数组；失败返回结构化失败结果。\n\tconst parsed = extractJsonArray(messageText(message));\n\tif (parsed === undefined) {\n\t\tconst failure: ExtractModelFailure = {\n\t\t\tstage: \"parse\",\n\t\t\tmessage: \"响应不是可解析的 JSON 候选数组（未做二次请求补全）\",\n\t\t};\n\t\treturn { ok: true, requestId, candidates: [], rejected: [], usage, failure };\n\t}\n\n\t// 逐候选：形状收窄 → S2-04 校验；失败候选进 rejected 带原因，不提交。\n\tconst candidates: ValidatedCandidate[] = [];\n\tconst rejected: RejectedCandidate[] = [];\n\tfor (const raw of parsed) {\n\t\tconst { candidate, problems } = narrowCandidate(raw);\n\t\tif (!candidate) {\n\t\t\trejected.push({ candidate: raw, reasons: problems });\n\t\t\tcontinue;\n\t\t}\n\t\tconst { validated, reasons } = validateCandidate(candidate, input.entries);\n\t\tif (!validated) {\n\t\t\trejected.push({ candidate, reasons });\n\t\t\tcontinue;\n\t\t}\n\t\tcandidates.push(validated);\n\t}\n\n\treturn { ok: true, requestId, candidates, rejected, usage };\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 提炼与维护任务（extraction_jobs）的持久化与生命周期管理（S2-01、S2-12、S7-01/03）。\n *\t\t// 1. 保存本批游标（若有）：提交成功的批次边界清 consecutive_failures。\n\t\tif (input.cursor !== undefined) {\n\t\t\tdb.prepare(\n\t\t\t\t`UPDATE extraction_jobs SET cursor = ?, consecutive_failures = 0, updated_at = ? WHERE job_id = ?`).run(,\t\t\tinput.cursor, input.finishedAt,input.jobId,\n\t\t\t);\n\t\t}\n\t\t// 2. 同事务消费共享续跑标志。\n\t\tconst rerun = Number(Number(db.prepare(`DELETE FROM maintenance_pending_rerun WHERE scope_key = ?`).run(input.scopeKey).changes) >0;\n\t\t// 3. 据标志决定终态：有续跑→pending（清 owner 让下轮认领）；\n\t\t//    无→done（保留 owner_process/owner_token 作完成归属审计）。\t});\n}\n","ops":[{"diffOp":{"equal":{"range":[0,118]}}},{"equalLines":{"line_count":307}},{"diffOp":{"equal":{"range":[118,264]}}},{"diffOp":{"insert":{"range":[264,269]}}},{"diffOp":{"equal":{"range":[269,367]}}},{"diffOp":{"delete":{"range":[367,373]}}},{"diffOp":{"insert":{"range":[373,374]}}},{"diffOp":{"equal":{"range":[264,265]}}},{"diffOp":{"delete":{"range":[118,119]}}},{"diffOp":{"equal":{"range":[374,377]}}},{"diffOp":{"insert":{"range":[367,373]}}},{"diffOp":{"equal":{"range":[377,390]}}},{"diffOp":{"delete":{"range":[264,269]}}},{"diffOp":{"insert":{"range":[390,391]}}},{"diffOp":{"equal":{"range":[391,408]}}},{"diffOp":{"delete":{"range":[264,269]}}},{"diffOp":{"insert":{"range":[390,391]}}},{"diffOp":{"equal":{"range":[408,419]}}},{"diffOp":{"delete":{"range":[419,424]}}},{"diffOp":{"equal":{"range":[424,491]}}},{"diffOp":{"delete":{"range":[491,499]}}},{"diffOp":{"equal":{"range":[264,268]}}},{"diffOp":{"insert":{"range":[499,506]}}},{"diffOp":{"equal":{"range":[506,605]}}},{"diffOp":{"delete":{"range":[419,423]}}},{"diffOp":{"equal":{"range":[605,608]}}},{"diffOp":{"delete":{"range":[491,492]}}},{"diffOp":{"insert":{"range":[264,268]}}},{"diffOp":{"equal":{"range":[608,778]}}},{"equalLines":{"line_count":158}},{"diffOp":{"equal":{"range":[778,785]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\extraction-jobs.ts"},"span":null,"sourceCode":"/**\n * 提炼与维护任务（extraction_jobs）的持久化与生命周期管理（S2-01、S2-12、S7-01/03）。\n *\n * 契约：\n * - 同一 scopeKey 幂等：重复创建返回已有 job，不重复入库。\n * - jobKind：extract=提炼（S2 原值）；embed/organize/archive 为 S7 维护类。\n *   同队列表多类型共用 pending/running/done/failed 生命周期与游标恢复。\n * - claimJob：pending→running，记 owner_process + owner_token 与 attempt_id；\n *   已被 running 且持有者存活的不抢（返回 undefined）。\n * - advanceCursor：推进已提交游标，重跑只处理未提交范围；\n *   同时清 consecutive_failures=0（提交成功的批次边界，O03/F07）。\n * - completeJob/failJob：done/failed；失败保留 reason、已知用量、未提交范围。\n *   failJob 递增 consecutive_failures（未提交批次的连续失败数）；\n *   普通失败在 MAX_ATTEMPTS 内可自动恢复；stale_request_snapshot 失败明确\n *   保留为需重新评估，不自动恢复。\n * - recoverJobs：重启恢复——running 但持有者进程已不存在的任务、\n *   以及普通 failed 且 consecutive_failures 未超限的任务重取为 pending；\n *   不重复处理已提交事件（游标在 advanceCursor 已推进）。\n * - 全部写路径走 store.transaction（BEGIN IMMEDIATE 短事务）；\n *   模型输入读取在事务外，不占数据库锁。\n */\nimport { randomUUID } from \"node:crypto\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { MemoryStore } from \"./store.ts\";\nimport type {\n\tAdvanceExtractionCursorInput,\n\tClaimExtractionJobInput,\n\tClaimExtractionJobResult,\n\tCompleteExtractionJobInput,\n\tCreateExtractionJobInput,\n\tExtractionJob,\n\tExtractionJobStatus,\n\tFailExtractionJobInput,\n\tMaintenanceJobKind,\n\tRecoverExtractionJobsResult,\n} from \"./types.ts\";\n\n/** 重试上限：失败超过此次数后转 failed 终态，不再自动恢复。 */\nexport const MAX_ATTEMPTS = 3;\n\n/** 需重新评估的失败原因前缀；不新增状态，复用 failed + last_error 留痕。 */\nexport const NEEDS_REEVALUATION_PREFIX = \"stale_request_snapshot:\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 行映射\n// ════════════════════════════════════════════════════════════════════════\n\ninterface JobDbRow {\n\tjob_id: string;\n\tjob_kind: string;\n\tsource_scope: string;\n\tscope_key: string;\n\tstatus: string;\n\tcursor: string | null;\n\tattempt_count: number;\n\tconsecutive_failures: number;\n\tlast_error: string | null;\n\tlast_usage: string | null;\n\towner_process: string | null;\n\towner_token: string | null;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\nfunction mapJobRow(row: JobDbRow): ExtractionJob {\n\treturn {\n\t\tjobId: row.job_id,\n\t\tjobKind: row.job_kind as MaintenanceJobKind,\n\t\tsourceScope: row.source_scope,\n\t\tscopeKey: row.scope_key,\n\t\tstatus: row.status as ExtractionJobStatus,\n\t\t...(row.cursor === null ? {} : { cursor: row.cursor }),\n\t\tattemptCount: row.attempt_count,\n\t\tconsecutiveFailures: row.consecutive_failures,\n\t\t...(row.last_error === null ? {} : { lastError: row.last_error }),\n\t\t...(row.last_usage === null ? {} : { lastUsage: row.last_usage }),\n\t\t...(row.owner_process === null ? {} : { ownerProcess: row.owner_process }),\n\t\t...(row.owner_token === null ? {} : { ownerToken: row.owner_token }),\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction getJobRow(db: DatabaseSync, jobId: string): JobDbRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\tconsecutive_failures, last_error, last_usage, owner_process, owner_token, created_at, updated_at\n\t\t\t FROM extraction_jobs WHERE job_id = ?`,\n\t\t)\n\t\t.get(jobId) as JobDbRow | undefined;\n}\n\nfunction getJobRowByScopeKey(db: DatabaseSync, scopeKey: string): JobDbRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\tconsecutive_failures, last_error, last_usage, owner_process, owner_token, created_at, updated_at\n\t\t\t FROM extraction_jobs WHERE scope_key = ?`,\n\t\t)\n\t\t.get(scopeKey) as JobDbRow | undefined;\n}\n\n/** 检查进程是否存活（ESRCH = 不存在）。 */\nfunction isProcessAlive(pid: number): boolean {\n\ttry {\n\t\tprocess.kill(pid, 0);\n\t\treturn true;\n\t} catch (error) {\n\t\tif ((error as NodeJS.ErrnoException).code === \"ESRCH\") return false;\n\t\tthrow error;\n\t}\n}\n\n/** 从 owner_process 字符串解析 PID；格式 \"pid-{pid}\" 或自定义标识。 */\nfunction parseOwnerPid(ownerProcess: string): number | undefined {\n\tconst match = /^pid-(\\d+)$/.exec(ownerProcess);\n\treturn match ? Number(match[1]) : undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 任务操作\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 创建提炼任务（同 scopeKey 幂等复用）。\n *\n * 同一来源范围重复创建返回已有 job；不同范围新建 pending。\n * 并发下若撞 UNIQUE 冲突（另一写入者先创建同一 scopeKey），回读既有行返回。\n */\nexport function createJob(store: MemoryStore, input: CreateExtractionJobInput): ExtractionJob {\n\tconst db = store.db;\n\tconst existing = getJobRowByScopeKey(db, input.scopeKey);\n\tif (existing) return mapJobRow(existing);\n\n\tconst jobId = `job-${randomUUID()}`;\n\tconst jobKind = input.jobKind ?? \"extract\";\n\ttry {\n\t\tdb.prepare(\n\t\t\t`INSERT INTO extraction_jobs\n\t\t\t (job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t  consecutive_failures, last_error, last_usage, owner_process, owner_token, created_at, updated_at)\n\t\t\t VALUES (?, ?, ?, ?, 'pending', NULL, 0, 0, NULL, NULL, NULL, NULL, ?, ?)`,\n\t\t).run(jobId, jobKind, input.sourceScope, input.scopeKey, input.createdAt, input.createdAt);\n\t} catch (error) {\n\t\t// UNIQUE(scope_key) 冲突：另一写入者抢先创建同一范围。回读既有 job 返回。\n\t\tconst raced = getJobRowByScopeKey(db, input.scopeKey);\n\t\tif (raced) return mapJobRow(raced);\n\t\tthrow error;\n\t}\n\tconst row = getJobRow(db, jobId);\n\tif (!row) throw new Error(`创建后回读失败：${jobId}`);\n\treturn mapJobRow(row);\n}\n\n/**\n * 领取任务：pending→running，记 owner_process 与 attempt_id。\n *\n * 已被 running 且持有者存活的不抢（返回 undefined）；\n * 已被 running 但持有者已死的由 recoverJobs 重取为 pending 后才能领取。\n * done/failed 终态不可领取。\n */\nexport function claimJob(store: MemoryStore, input: ClaimExtractionJobInput): ClaimExtractionJobResult | undefined {\n\tconst db = store.db;\n\treturn store.transaction<ClaimExtractionJobResult | undefined>(() => {\n\t\tconst row = getJobRow(db, input.jobId);\n\t\tif (!row) return undefined;\n\t\tif (row.status === \"done\" || row.status === \"failed\") return undefined;\n\t\tif (row.status === \"running\") {\n\t\t\t// 持有者存活则不抢；持有者已死由 recoverJobs 先重取为 pending。\n\t\t\tconst pid = row.owner_process ? parseOwnerPid(row.owner_process) : undefined;\n\t\t\tif (pid !== undefined && isProcessAlive(pid)) return undefined;\n\t\t\t// 持有者已死但未被 recover：仍不抢（recoverJobs 是恢复入口）。\n\t\t\treturn undefined;\n\t\t}\n\t\t// pending → running；写 ownerProcess + ownerToken（S7-03 跨进程认领核对）。\n\t\tconst attemptId = `att-${randomUUID()}`;\n\t\tconst ownerToken = input.ownerToken ?? `tok-${randomUUID()}`;\n\t\tdb.prepare(\n\t\t\t`UPDATE extraction_jobs\n\t\t\t SET status = 'running', owner_process = ?, owner_token = ?, attempt_count = attempt_count + 1,\n\t\t\t     updated_at = ?\n\t\t\t WHERE job_id = ?`,\n\t\t).run(input.ownerProcess, ownerToken, input.claimedAt, input.jobId);\n\t\tconst updated = getJobRow(db, input.jobId);\n\t\tif (!updated) throw new Error(`领取后回读失败：${input.jobId}`);\n\t\treturn { job: mapJobRow(updated), attemptId };\n\t});\n}\n\n/**\n * 推进已提交游标：部分成功后重跑只处理未提交范围。\n *\n * 游标值由调用方定义（如最后一个已处理 entryId），\n * 本函数只负责持久化，不解释游标语义。\n * 同时清 consecutive_failures=0——提交成功的批次边界重置未提交批次的\n * 连续失败计数（O03/F07：重试额度按未提交批次计，不按 job 终身累计）。\n */\nexport function advanceCursor(store: MemoryStore, input: AdvanceExtractionCursorInput): void {\n\tconst db = store.db;\n\tstore.transaction(() => {\n\t\tdb.prepare(\n\t\t\t`UPDATE extraction_jobs SET cursor = ?, consecutive_failures = 0, updated_at = ? WHERE job_id = ?`,\n\t\t).run(input.cursor, input.advancedAt, input.jobId);\n\t});\n}\n\n/** 标记任务完成。 */\nexport function completeJob(store: MemoryStore, input: CompleteExtractionJobInput): void {\n\tconst db = store.db;\n\tstore.transaction(() => {\n\t\tdb.prepare(`UPDATE extraction_jobs SET status = 'done', updated_at = ? WHERE job_id = ?`).run(\n\t\t\tinput.completedAt,\n\t\t\tinput.jobId,\n\t\t);\n\t});\n}\n\n/**\n * 已完成任务出现游标后新来源时重开。\n *\n * 只改变 done→pending，保留原游标、尝试次数和账本记录；failed 仍只能走既有\n * recoverJobs 规则，避免把需重新评估的失败悄悄自动重放。\n */\nexport function reopenDoneJob(\n\tstore: MemoryStore,\n\tinput: { jobId: string; reopenedAt: string },\n): ExtractionJob | undefined {\n\tconst db = store.db;\n\treturn store.transaction<ExtractionJob | undefined>(() => {\n\t\tconst result = db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE extraction_jobs\n\t\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL, updated_at = ?\n\t\t\t\t WHERE job_id = ? AND status = 'done'`,\n\t\t\t)\n\t\t\t.run(input.reopenedAt, input.jobId);\n\t\tif (result.changes === 0) return undefined;\n\t\tconst updated = getJobRow(db, input.jobId);\n\t\tif (!updated) throw new Error(`重开后回读失败：${input.jobId}`);\n\t\treturn mapJobRow(updated);\n\t});\n}\n\n/**\n * needs-reevaluation 的 failed job 在出现上次尝试边界之后的新来源时重开（O03/I01）。\n *\n * 只放行 `stale_request_snapshot:` 前缀的 failed——普通 failed（真失败）仍只能走\n * recoverJobs 的 consecutive_failures 判据，保留「真失败不偷跑」契约。\n * 新来源即重评依据：status 回 pending、清 owner/last_error/consecutive_failures\n * （新批次的开始；旧游标仍在，新批从未提交边界算），attempt_count 与账本保留。\n * 是否有新来源由调用方判定（job.lastError 里记录的 attempted_through 边界）。\n */\nexport function reopenFailedJobForNewSources(\n\tstore: MemoryStore,\n\tinput: { jobId: string; reopenedAt: string },\n): ExtractionJob | undefined {\n\tconst db = store.db;\n\treturn store.transaction<ExtractionJob | undefined>(() => {\n\t\tconst result = db\n\t\t\t.prepare(\n\t\t\t\t`UPDATE extraction_jobs\n\t\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL,\n\t\t\t\t     last_error = NULL, consecutive_failures = 0, updated_at = ?\n\t\t\t\t WHERE job_id = ? AND status = 'failed'\n\t\t\t\t   AND COALESCE(last_error, '') GLOB ?`,\n\t\t\t)\n\t\t\t.run(input.reopenedAt, input.jobId, `${NEEDS_REEVALUATION_PREFIX}*`);\n\t\tif (result.changes === 0) return undefined;\n\t\tconst updated = getJobRow(db, input.jobId);\n\t\tif (!updated) throw new Error(`重开后回读失败：${input.jobId}`);\n\t\treturn mapJobRow(updated);\n\t});\n}\n\n/**\n * 主动让出：running→pending，清 owner。\n *\n * 处理函数未完成返回（中断/分批让出）时由持有者调用：本进程还活着，\n * recoverJobs 不会回收 live-owner 的 running job，必须由持有者自己放回\n * 队列，下一轮 drain（本进程或其他进程）才能再领取续作。\n * 已提交的游标保留，重跑只处理未提交范围。\n */\nexport function releaseJob(store: MemoryStore, input: { jobId: string; releasedAt: string }): void {\n\tconst db = store.db;\n\tstore.transaction(() => {\n\t\tdb.prepare(\n\t\t\t`UPDATE extraction_jobs\n\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL, updated_at = ?\n\t\t\t WHERE job_id = ? AND status = 'running'`,\n\t\t).run(input.releasedAt, input.jobId);\n\t});\n}\n\n/**\n * O06/R5-D9：维护 job 批末状态决定——单事务原子完成。\n *\n * 把「保存本批游标 + 消费共享续跑标志 + 决定 pending/done」收进同一事务，\n * 消除跨进程在 consume→complete 两步之间登记导致「标志留下但作业已 done」\n * 的丢失窗口（D9）。同事务内读删标志并据其写终态：\n *   - 标志命中 → 放回 pending（running→pending，保 cursor，可被下轮领取）；\n *   - 无标志   → 置 done。\n * 返回最终写入的状态，供调用方/测试核对。\n */\nexport function finishMaintenanceBatch(\n\tstore: MemoryStore,\n\tinput: { jobId: string; scopeKey: string; cursor?: string; finishedAt: string },\n): \"done\" | \"pending\" {\n\tconst db = store.db;\n\treturn store.transaction<\"done\" | \"pending\">(() => {\n\t\t// 1. 保存本批游标（若有）：提交成功的批次边界清 consecutive_failures。\n\t\tif (input.cursor !== undefined) {\n\t\t\tdb.prepare(`UPDATE extraction_jobs SET cursor = ?, consecutive_failures = 0, updated_at = ? WHERE job_id = ?`).run(\n\t\t\t\tinput.cursor,\n\t\t\t\tinput.finishedAt,\n\t\t\t\tinput.jobId,\n\t\t\t);\n\t\t}\n\t\t// 2. 同事务消费共享续跑标志。\n\t\tconst rerun = Number(\n\t\t\tdb.prepare(`DELETE FROM maintenance_pending_rerun WHERE scope_key = ?`).run(input.scopeKey).changes,\n\t\t) > 0;\n\t\t// 3. 据标志决定终态：有续跑→pending（清 owner 让下轮认领）；\n\t\t//    无→done（保留 owner_process/owner_token 作完成归属审计）。\n\t\tif (rerun) {\n\t\t\tdb.prepare(\n\t\t\t\t`UPDATE extraction_jobs\n\t\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL, updated_at = ?\n\t\t\t\t WHERE job_id = ?`,\n\t\t\t).run(input.finishedAt, input.jobId);\n\t\t} else {\n\t\t\tdb.prepare(`UPDATE extraction_jobs SET status = 'done', updated_at = ? WHERE job_id = ?`).run(\n\t\t\t\tinput.finishedAt,\n\t\t\t\tinput.jobId,\n\t\t\t);\n\t\t}\n\t\treturn rerun ? \"pending\" : \"done\";\n\t});\n}\n\n/**\n * O06/R5-D9：维护 job 登记——单事务原子完成「建/读状态 + 按状态写」。\n *\n * 原来 createJob（一个事务建/读）→ reopen/mark（另一个事务写）分两步，\n * 中间 job 状态可能已被对端改变，导致按旧 running 快照写标志、或该复活\n * 的终态漏复活（D9）。这里在同一事务内：\n *   1. 确保 job 行存在（scopeKey 幂等，无则建 pending）；\n *   2. 读当前真实状态；\n *   3. done/failed → 复活为 pending（清 owner/last_error/consecutive_failures，\n *      保 cursor/attempt_count，仅限 job_kind != 'extract'）；\n *      running → 写共享续跑标志（持有者批末消费放回 pending）；\n *      pending → 不动（已被下轮待领）。\n * 返回登记后 job 行的最新状态，供调用方判断/测试核对。\n */\nexport function enqueueMaintenanceJob(\n\tstore: MemoryStore,\n\tinput: { jobKind: MaintenanceJobKind; sourceScope: string; scopeKey: string; now: string },\n): ExtractionJob {\n\tconst db = store.db;\n\treturn store.transaction<ExtractionJob>(() => {\n\t\t// 1. 确保 job 行存在（同事务内建/读，不按事务外快照）。\n\t\tlet row = getJobRowByScopeKey(db, input.scopeKey);\n\t\tif (!row) {\n\t\t\tconst jobId = `job-${randomUUID()}`;\n\t\t\ttry {\n\t\t\t\tdb.prepare(\n\t\t\t\t\t`INSERT INTO extraction_jobs\n\t\t\t\t\t (job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\t\t  consecutive_failures, last_error, last_usage, owner_process, owner_token, created_at, updated_at)\n\t\t\t\t\t VALUES (?, ?, ?, ?, 'pending', NULL, 0, 0, NULL, NULL, NULL, NULL, ?, ?)`,\n\t\t\t\t).run(jobId, input.jobKind, input.sourceScope, input.scopeKey, input.now, input.now);\n\t\t\t} catch {\n\t\t\t\t// UNIQUE 冲突：对端抢先建同 scopeKey——回读继续按真实状态处理。\n\t\t\t}\n\t\t\trow = getJobRowByScopeKey(db, input.scopeKey);\n\t\t}\n\t\tif (!row) throw new Error(`登记后回读失败：${input.scopeKey}`);\n\n\t\t// 2-3. 同事务内按真实状态写：终态复活 / running 写标志。\n\t\tif (row.status === \"done\" || row.status === \"failed\") {\n\t\t\tdb.prepare(\n\t\t\t\t`UPDATE extraction_jobs\n\t\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL,\n\t\t\t\t     last_error = NULL, consecutive_failures = 0, updated_at = ?\n\t\t\t\t WHERE job_id = ? AND status IN ('done','failed') AND job_kind != 'extract'`,\n\t\t\t).run(input.now, row.job_id);\n\t\t} else if (row.status === \"running\") {\n\t\t\tdb.prepare(\n\t\t\t\t`INSERT INTO maintenance_pending_rerun (scope_key, marked_at)\n\t\t\t\t VALUES (?, ?)\n\t\t\t\t ON CONFLICT (scope_key) DO UPDATE SET marked_at = excluded.marked_at`,\n\t\t\t).run(input.scopeKey, input.now);\n\t\t}\n\t\tconst finalRow = getJobRow(db, row.job_id);\n\t\tif (!finalRow) throw new Error(`登记后回读失败：${row.job_id}`);\n\t\treturn mapJobRow(finalRow);\n\t});\n}\n\n/**\n * 标记任务失败：保留原因、已知用量、未提交范围。\n *\n * consecutive_failures += 1（未提交批次的连续失败数）；attempt_count 只作\n * 历史尝试总次数，不再兼任重试判据。consecutive_failures 达 MAX_ATTEMPTS 的\n * 普通失败转 failed 终态后 recoverJobs 不再重取；未达上限时可被重取为\n * pending 重试。\n */\nexport function failJob(store: MemoryStore, input: FailExtractionJobInput): ExtractionJob {\n\tconst db = store.db;\n\treturn store.transaction<ExtractionJob>(() => {\n\t\tconst row = getJobRow(db, input.jobId);\n\t\tif (!row) throw new Error(`任务不存在：${input.jobId}`);\n\t\tdb.prepare(\n\t\t\t`UPDATE extraction_jobs\n\t\t\t SET status = 'failed', last_error = ?, last_usage = ?,\n\t\t\t     consecutive_failures = consecutive_failures + 1, updated_at = ?\n\t\t\t WHERE job_id = ?`,\n\t\t).run(input.reason, input.lastUsage ?? null, input.failedAt, input.jobId);\n\t\tconst updated = getJobRow(db, input.jobId);\n\t\tif (!updated) throw new Error(`失败后回读失败：${input.jobId}`);\n\t\treturn mapJobRow(updated);\n\t});\n}\n\n/**\n * 标记任务需基于最新记忆重新评估。\n *\n * 状态仍为 failed，保留未提交游标、真实原因和本次已知用量；不增加\n * attempt_count，也不自动发起新模型请求。recoverJobs 会识别原因前缀并跳过。\n */\nexport function markJobNeedsReevaluation(store: MemoryStore, input: FailExtractionJobInput): ExtractionJob {\n\treturn failJob(store, {\n\t\t...input,\n\t\treason: `${NEEDS_REEVALUATION_PREFIX}${input.reason}`,\n\t});\n}\n\n/**\n * 重启恢复：两类任务重取为 pending——\n *\n * 1. running 但持有者进程已不存在的任务（崩溃恢复）；\n * 2. 非 stale_request_snapshot 的 failed 且 consecutive_failures < MAX_ATTEMPTS\n *    的任务（普通失败未超限可重试；O03/F07 按未提交批次计，不按终身累计）。\n *\n * 超限任务保持 failed 终态不恢复。\n * 不重复处理已提交事件：cursor 已在 advanceCursor 推进，\n * 恢复后调用方按 cursor 继续处理未提交范围即可。\n */\nexport function recoverJobs(store: MemoryStore, now: string): RecoverExtractionJobsResult {\n\tconst db = store.db;\n\treturn store.transaction<RecoverExtractionJobsResult>(() => {\n\t\t// running 死进程任务 + 普通 failed 未超限任务（重试判据 = consecutive_failures）。\n\t\tconst candidates = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\t\tconsecutive_failures, last_error, last_usage, owner_process, owner_token, created_at, updated_at\n\t\t\t\t FROM extraction_jobs\n\t\t\t\t WHERE consecutive_failures < ?\n\t\t\t\t   AND (\n\t\t\t\t     status = 'running'\n\t\t\t\t     OR (status = 'failed' AND COALESCE(last_error, '') NOT GLOB ?)\n\t\t\t\t   )`,\n\t\t\t)\n\t\t\t.all(MAX_ATTEMPTS, `${NEEDS_REEVALUATION_PREFIX}*`) as unknown as JobDbRow[];\n\t\tconst recovered: ExtractionJob[] = [];\n\t\tfor (const row of candidates) {\n\t\t\tif (row.status === \"running\") {\n\t\t\t\t// running 任务：持有者已死才恢复\n\t\t\t\tconst pid = row.owner_process ? parseOwnerPid(row.owner_process) : undefined;\n\t\t\t\tconst alive = pid !== undefined && isProcessAlive(pid);\n\t\t\t\tif (alive) continue;\n\t\t\t}\n\t\t\t// running 死进程 或普通 failed 未超限：重取为 pending，清 owner\n\t\t\tdb.prepare(\n\t\t\t\t`UPDATE extraction_jobs\n\t\t\t\t SET status = 'pending', owner_process = NULL, owner_token = NULL, updated_at = ?\n\t\t\t\t WHERE job_id = ?`,\n\t\t\t).run(now, row.job_id);\n\t\t\tconst updated = getJobRow(db, row.job_id);\n\t\t\tif (updated) recovered.push(mapJobRow(updated));\n\t\t}\n\t\treturn { recovered };\n\t});\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆 S2-02：事件触发的自动提炼调度。\n *\t\treturn { entries, excludedCount, failedSources };\n\t}\n\tconst reads = await readSourceEventsBatch(\n\t\tdb, deps.paoHome,included.map((source) => source.sourceId),{\n\t\t// 与逐条 readMemorySource({limit:1}) 同口径：正文只取锚定事件自身一行，\n\t\t// 不取邻近上下文窗口——提炼输入语义保持原样。\n\t\trange: { limit: 1 },\n\t\t...(deps.readSegment === undefined ? {} : { readSegment: deps.readSegment }),\n\t},\n\t);\n\tfor (const source of included) {\n\t\t// 与 readMemorySource 同口径的整体排除判定：全局排除当读取失败处理\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":188}},{"diffOp":{"equal":{"range":[67,165]}}},{"diffOp":{"insert":{"range":[165,168]}}},{"diffOp":{"equal":{"range":[168,171]}}},{"diffOp":{"delete":{"range":[171,172]}}},{"diffOp":{"insert":{"range":[165,168]}}},{"diffOp":{"equal":{"range":[172,185]}}},{"diffOp":{"delete":{"range":[171,172]}}},{"diffOp":{"insert":{"range":[165,168]}}},{"diffOp":{"equal":{"range":[185,227]}}},{"diffOp":{"delete":{"range":[171,172]}}},{"diffOp":{"insert":{"range":[165,168]}}},{"diffOp":{"equal":{"range":[227,231]}}},{"diffOp":{"insert":{"range":[67,68]}}},{"diffOp":{"equal":{"range":[231,326]}}},{"diffOp":{"insert":{"range":[67,68]}}},{"diffOp":{"equal":{"range":[326,398]}}},{"diffOp":{"insert":{"range":[67,68]}}},{"diffOp":{"equal":{"range":[398,421]}}},{"diffOp":{"insert":{"range":[67,68]}}},{"diffOp":{"equal":{"range":[421,500]}}},{"diffOp":{"insert":{"range":[67,68]}}},{"diffOp":{"equal":{"range":[500,501]}}},{"diffOp":{"insert":{"range":[501,504]}}},{"diffOp":{"equal":{"range":[504,633]}}},{"equalLines":{"line_count":588}},{"diffOp":{"equal":{"range":[633,639]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\extraction-scheduler.ts"},"span":null,"sourceCode":"/**\n * 内置记忆 S2-02：事件触发的自动提炼调度。\n *\n * 契约：\n * - `turn_end`（与 capture.ts 的采集钩子并列，本模块不再采集）只登记「本会话有新\n *   来源」进内存待提炼集合——一串工具回合合并成一个批次，不每轮都发模型请求。\n * - `agent_settled`（自动重试/压缩/续跑全结束的唯一信号）唤醒一轮队列：\n *   `recoverJobs` 先恢复上次未完成任务 → 除内存 pendingSessions 外再扫\n *   `extraction_jobs` 全库 `status='pending' AND job_kind='extract'` 的\n *   scopeKey 一并消费（O03/F06/D6：持久 pending 由全 home 扫描兜底，A 退出\n *   后开 B 续作 A）→ 逐 job 领取 → 事务外组装 ExtractModelInput\n *   （来源正文经 readMemorySource 回读已保存脱敏正文）→ `requestExtraction` →\n *   `commitExtractionCandidates` → `advanceCursor`/`completeJob`，或普通失败\n *   保 pending 待下次 settled 重试。若候选命中 stale_request_snapshot，则不\n *   推进游标，复用 failed + last_error 标记需重新评估且不自动重放——\n *   但同 scope 出现上次尝试边界之后的新来源时重开（新来源 = 重评依据，\n *   边界以 last_error 内 attempted_through 为准；已尝试未提交的游标后\n *   旧批不算新依据，普通 settled 不反复重跑，O03/I01）。\n *   单个 job 失败不阻塞后续 job；不递归开新提炼任务（S2-12）。\n * - `agent_start` 取消进行中的模型调用（AbortController.abort）：普通任务优先。\n *   本侧调度取消是前台优先动作不是故障——请求返回时 signal.aborted 走\n *   releaseJob 交回 pending、保游标、不占 consecutive_failures 额度\n *   （O03/I03），下一轮空闲 drain 重新领取续作；已发生用量照实留痕。\n * - 每个 job 收尾复用本轮外发许可嵌入当前修订缺失向量；终态 job 仍会处理新纠正\n *   产生的缺向量，不另建嵌入队列。\n * - `session_shutdown` 停止领取新 job、取消在途请求；已提交的候选随各事务已落库，\n *   running job 由下次启动 recover（onConfirmedShutdown 跑状态复位，不新开付费请求）。\n * - 装配启动先跑一次 recoverJobs（服务启动先恢复上次未完成任务）。\n * - 提炼范围以「本进程本会话」为限（S2-02 口径），不跨会话偷读；\n *   job 的 scopeKey = `session:{sessionId}`（同会话幂等复用，游标推进后只处理新增条目）。\n * - job 自带身份：续作别的会话 job 时 scope/sessionId/projectId 全部从\n *   `job.sourceScope` 重建，不借当前消费会话的身份（O03）；budgetScopeKey\n *   保持 scopeKey，外发主体仍按本 home 当前执行环境判定。\n * - 读失败与已排除分开（O03/F13）：`readMemorySource` 失败不越过游标，\n *   该来源记 failJob 并停本 job 后续批；已排除来源属确定状态可推进游标。\n * - 前台忙不新领（O03/F03/I02）：`agent_start` 把本会话加进按 home 归属的\n *   进程内共享 busy 集合（foreground-busy.ts），drain 的 per-target 前\n *   集合非空即 return，本 home 任一会话前台忙时不新领；busy 是本进程内\n *   本 home 的口径，不是跨进程锁——进程间靠 claimJob owner 存活检查防双领。\n * - 重试额度按未提交批次（O03/F07）：`consecutive_failures` 递增于 failJob、\n *   清零于提交成功的批次边界；`attempt_count` 只作历史总次数。\n */\nimport type { ExtensionAPI, ExtensionContext } from \"../../core/extensions/types.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport type { TierConfig } from \"../routing/config.ts\";\nimport { readSourceEventsBatch, type ArchiveSegmentRow } from \"./archive.ts\";\nimport { commitExtractionCandidates } from \"./extract-commit.ts\";\nimport { requestExtraction } from \"./extract-model.ts\";\nimport {\n\tadvanceCursor,\n\tclaimJob,\n\tcompleteJob,\n\tcreateJob,\n\tfailJob,\n\tmarkJobNeedsReevaluation,\n\trecoverJobs,\n\treleaseJob,\n\treopenDoneJob,\n\treopenFailedJobForNewSources,\n} from \"./extraction-jobs.ts\";\nimport { foregroundBusyAdd, foregroundBusyDelete, foregroundBusySize } from \"./foreground-busy.ts\";\nimport { embedCurrentMemories, openPersistentMemoryLedger, resolveMemoryOutboundContext } from \"./runtime-embedding.ts\";\nimport { isSourceExcluded, isSourceGloballyExcluded, type SourceRow } from \"./sources.ts\";\nimport type { MemoryStore } from \"./store.ts\";\nimport type {\n\tExtractionJob,\n\tExtractionSourceEntry,\n\tExtractModelOutput,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/** registerExtractionScheduler 的依赖。 */\nexport interface ExtractionSchedulerDeps {\n\t/** 批次 A 的存储句柄（job 状态与直查用同一连接）。 */\n\tstore: MemoryStore;\n\t/** 完整服务（createMemory/flagForReDiscussion/readMemorySource 等）。 */\n\tservice: MemoryService;\n\t/** PAO_HOME 根（档位解析 + 记账会话 cwd + 归档读取）。 */\n\tpaoHome: string;\n\t/**\n\t * 记账会话。缺省时使用 PAO_HOME 下可重开的专用持久后台会话；迟到结果仍归\n\t * 同一 jobId，不写入切换后的用户会话。\n\t */\n\tledger?: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** settled 收尾嵌入的参数；生产缺省按 32 条一批、15 秒单批超时。 */\n\tembedding?: {\n\t\tbatchSize?: number;\n\t\ttimeoutMs?: number;\n\t};\n\t/** 提炼档位名（缺省走 extract-model 的 \"fast\"）。 */\n\ttierName?: string;\n\t/** 已加载档位配置（测试注入跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/**\n\t * 从宿主上下文推导可信 scope（tools.ts 的 Git common-dir 项目身份与当前\n\t * executionRoot）。拿不到 projectId 时给 \"unknown\" 占位——空 projectId 会被\n\t * createMemory 判 invalid_input，如实失败不伪造成功。\n\t */\n\tresolveScope: (ctx: ExtensionContext) => MemoryScope;\n\t/**\n\t * 提炼 job 收尾后的 organize 登记回调（O06/J01）：\n\t * 每个 extract job 跑完（成功/失败/部分提交路径统一在 finally 触发）后\n\t * 按 projectId 登记一次增量规整作业；装配方接到维护调度器 enqueue。\n\t * 同 scopeKey 幂等——无变化时 organize handler 空扫即 done，不发模型请求。\n\t */\n\tonOrganizeCandidate?: (projectId: string) => void;\n\t/**\n\t * 段读取实现探针（测试核对 O14 按段复用的读盘次数；生产缺省走\n\t * readSegmentLines，调用方不应传）。\n\t */\n\treadSegment?: (segment: ArchiveSegmentRow) => Promise<{ lines: string[]; archived: boolean } | undefined>;\n\t/** 时间源（夹具注入；缺省 UTC 当前时间）。 */\n\tnow?: () => string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 来源读取与输入组装（事务外）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 列出该会话已登记的非边界来源行（boundary 是占位行不是内容），按采集时间排序。 */\nfunction listSessionSources(store: MemoryStore, sessionId: string): SourceRow[] {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT source_id, session_id, entry_id, event_type, project_id, task_id,\n\t\t\t        location, segment_id, captured_at\n\t\t\t FROM sources WHERE session_id = ? AND event_type != 'boundary'\n\t\t\t ORDER BY captured_at, source_id`,\n\t\t)\n\t\t.all(sessionId) as unknown as Array<{\n\t\tsource_id: string;\n\t\tsession_id: string;\n\t\tentry_id: string;\n\t\tevent_type: string;\n\t\tproject_id: string | null;\n\t\ttask_id: string | null;\n\t\tlocation: string | null;\n\t\tsegment_id: string | null;\n\t\tcaptured_at: string;\n\t}>;\n\treturn rows.map((row) => ({\n\t\tsourceId: row.source_id,\n\t\tsessionId: row.session_id,\n\t\tentryId: row.entry_id,\n\t\teventType: row.event_type,\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t...(row.location === null ? {} : { location: row.location }),\n\t\t...(row.segment_id === null ? {} : { segmentId: row.segment_id }),\n\t\tcapturedAt: row.captured_at,\n\t}));\n}\n\n/**\n * 把一批来源行回读成 ExtractModelInput.entries：正文取已保存的脱敏正文\n * （ArchivedEvent 的 JSONL 行序列化）。\n * 区分两类未入选：已排除（isSourceExcluded，确定状态可推进游标）与\n * 读取失败（source_missing 等，不是「没内容」，不能越过游标）——\n * 提炼输入只含能如实定位的正文，不拿会话投影替代。\n *\n * O14 按段复用：本批来源经 readSourceEventsBatch 一次按段分组读取——\n * 同段 n 个来源只解压/解析段文件一次（原来逐来源 readMemorySource 重复\n * 读同段 n 次）。失败与排除口径与逐条 readMemorySource 一致：排除用同一\n * isSourceGloballyExcluded 判定（全局排除的来源仍进段读取失败列，与\n * 原 readMemorySource 先查排除再读的行为同样落到 failedSources）。\n */\nasync function entriesFromSources(\n\tdeps: ExtractionSchedulerDeps,\n\tsources: SourceRow[],\n): Promise<{ entries: ExtractionSourceEntry[]; excludedCount: number; failedSources: SourceRow[] }> {\n\tconst db = deps.store.db;\n\tconst entries: ExtractionSourceEntry[] = [];\n\tlet excludedCount = 0;\n\tconst included: SourceRow[] = [];\n\tfor (const source of sources) {\n\t\t// 提交级排除核对（与逐条 readMemorySource 第一道口一致）；\n\t\t// isSourceGloballyExcluded 在下方段回读前再核一次，保证共享保留/整删\n\t\t// 口径不走样。\n\t\tif (isSourceExcluded(db, { sourceId: source.sourceId })) {\n\t\t\texcludedCount += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tincluded.push(source);\n\t}\n\tconst failedSources: SourceRow[] = [];\n\tif (included.length === 0) {\n\t\treturn { entries, excludedCount, failedSources };\n\t}\n\tconst reads = await readSourceEventsBatch(db, deps.paoHome, included.map((source) => source.sourceId), {\n\t\t// 与逐条 readMemorySource({limit:1}) 同口径：正文只取锚定事件自身一行，\n\t\t// 不取邻近上下文窗口——提炼输入语义保持原样。\n\t\trange: { limit: 1 },\n\t\t...(deps.readSegment === undefined ? {} : { readSegment: deps.readSegment }),\n\t});\n\tfor (const source of included) {\n\t\t// 与 readMemorySource 同口径的整体排除判定：全局排除当读取失败处理\n\t\t// （原实现先查 isSourceGloballyExcluded 返回 source_missing——落到\n\t\t// failedSources 而不是 excludedCount，保持一致不越过游标）。\n\t\tif (isSourceGloballyExcluded(db, { sourceId: source.sourceId })) {\n\t\t\tfailedSources.push(source);\n\t\t\tcontinue;\n\t\t}\n\t\tconst read = reads.get(source.sourceId);\n\t\tif (read === undefined || !read.ok) {\n\t\t\tfailedSources.push(source);\n\t\t\tcontinue;\n\t\t}\n\t\tentries.push({\n\t\t\tsourceId: source.sourceId,\n\t\t\tentryId: source.entryId,\n\t\t\teventType: source.eventType,\n\t\t\tcontent: read.events.map((event) => JSON.stringify(event)).join(\"\\n\"),\n\t\t});\n\t}\n\treturn { entries, excludedCount, failedSources };\n}\n\n/**\n * 同范围已有决定摘要（给模型判断关联/重议用；不含正文全文）。\n * 直查 memories 当前修订：同 projectId、active、未合并走。\n */\nfunction relatedMemoriesForScope(store: MemoryStore, scope: MemoryScope): RelatedMemorySummary[] {\n\tconst taskClause =\n\t\tscope.taskId === undefined\n\t\t\t? \"json_extract(m.scope_json, '$.taskId') IS NULL\"\n\t\t\t: \"(json_extract(m.scope_json, '$.taskId') IS NULL OR json_extract(m.scope_json, '$.taskId') = ?)\";\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT m.id, m.kind, m.current_revision, m.usage_state, r.content_json\n\t\t\t FROM memories m\n\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t WHERE m.merged_into IS NULL AND m.usage_state = 'active'\n\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t   AND ${taskClause}\n\t\t\t ORDER BY m.updated_at DESC\n\t\t\t LIMIT 50`,\n\t\t)\n\t\t.all(scope.projectId, ...(scope.taskId === undefined ? [] : [scope.taskId])) as unknown as Array<{\n\t\tid: string;\n\t\tkind: string;\n\t\tcurrent_revision: number;\n\t\tusage_state: string;\n\t\tcontent_json: string;\n\t}>;\n\treturn rows.map((row) => {\n\t\tconst content = JSON.parse(row.content_json) as {\n\t\t\tconclusion?: string;\n\t\t\tconditions?: string;\n\t\t\tconfirmation?: RelatedMemorySummary[\"confirmation\"];\n\t\t};\n\t\treturn {\n\t\t\tmemoryId: row.id,\n\t\t\tkind: row.kind as RelatedMemorySummary[\"kind\"],\n\t\t\tcurrentRevision: row.current_revision,\n\t\t\tconclusion: content.conclusion ?? \"\",\n\t\t\t...(content.conditions === undefined ? {} : { conditions: content.conditions }),\n\t\t\tconfirmation: content.confirmation ?? \"tentative\",\n\t\t\tusageState: row.usage_state as RelatedMemorySummary[\"usageState\"],\n\t\t};\n\t});\n}\n\ninterface SourceBatch {\n\tscope: MemoryScope;\n\tsources: SourceRow[];\n}\n\n/** 来源自身证明任务时使用该任务；否则明确去掉当前 scope 的 taskId，绝不回填。 */\nfunction scopeForSource(base: MemoryScope, source: SourceRow): MemoryScope {\n\tconst scope = { ...base };\n\tif (source.projectId !== undefined) scope.projectId = source.projectId;\n\tif (source.projectId !== undefined && source.taskId !== undefined) scope.taskId = source.taskId;\n\telse delete scope.taskId;\n\treturn scope;\n}\n\n/** 按连续来源的任务身份切批，使同一模型请求和同一游标段只覆盖一个任务。 */\nfunction groupSourcesByScope(base: MemoryScope, sources: SourceRow[]): SourceBatch[] {\n\tconst groups: SourceBatch[] = [];\n\tfor (const source of sources) {\n\t\tconst scope = scopeForSource(base, source);\n\t\tconst key = `${scope.projectId}\\u0000${scope.taskId ?? \"\"}`;\n\t\tconst current = groups[groups.length - 1];\n\t\tconst currentKey =\n\t\t\tcurrent === undefined ? undefined : `${current.scope.projectId}\\u0000${current.scope.taskId ?? \"\"}`;\n\t\tif (current === undefined || currentKey !== key) {\n\t\t\tgroups.push({ scope, sources: [source] });\n\t\t} else {\n\t\t\tcurrent.sources.push(source);\n\t\t}\n\t}\n\treturn groups;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 调度本体\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 挂 turn_end / agent_settled / agent_start / session_shutdown 四个事件，\n * 驱动「采集 → 持久任务 → 模型提炼 → 候选提交」全链。返回 unmount。\n */\nexport function registerExtractionScheduler(pi: ExtensionAPI, deps: ExtractionSchedulerDeps): () => void {\n\tconst store = deps.store;\n\tconst now = deps.now ?? (() => new Date().toISOString());\n\tconst ownerProcess = `pid-${process.pid}`;\n\tconst ledgerForJob = (jobId: string) => deps.ledger ?? openPersistentMemoryLedger(deps.paoHome, jobId);\n\n\t/** 本会话有新来源待提炼的 sessionId 集合（turn_end 登记，settled 消费）。 */\n\tconst pendingSessions = new Set<string>();\n\t/** 进行中的提炼请求（agent_start/shutdown 取消）。 */\n\tconst active = new Map<string, AbortController>();\n\t/** settled 后跑一轮的串行锁：同一时刻只跑一个 drain，防重入。 */\n\tlet draining: Promise<void> | undefined;\n\tlet accepting = true;\n\t/**\n\t * 本注册实例最近见到的事件会话 ID（busy 集合增删与 unmount 清理用）。\n\t * 一个调度器实例只收自己会话的事件。\n\t */\n\tlet boundSessionId: string | undefined;\n\n\t// ── turn_end：只登记待提炼会话（不重复采集——capture.ts 已把条目落库）──\n\tconst offTurnEnd = pi.on(\"turn_end\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tpendingSessions.add(boundSessionId);\n\t});\n\n\t// ── agent_start：本会话进前台忙集合并取消在途后台模型调用，普通任务优先 ──\n\tconst offAgentStart = pi.on(\"agent_start\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyAdd(deps.paoHome, boundSessionId);\n\t\tfor (const controller of active.values()) controller.abort();\n\t});\n\n\t// ── agent_settled：本会话退出前台忙，唤醒队列跑一轮 ────────────────────\n\tconst offSettled = pi.on(\"agent_settled\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyDelete(deps.paoHome, boundSessionId);\n\t\t// settled 的补扫已把本会话新条目落库（capture.ts 先挂）——登记待提炼。\n\t\tif (ctx.sessionManager.getBranch().length > 0) {\n\t\t\tpendingSessions.add(boundSessionId);\n\t\t}\n\t\tif (draining !== undefined) return;\n\t\tdraining = drainQueue(ctx).finally(() => {\n\t\t\tdraining = undefined;\n\t\t});\n\t});\n\n\t// ── session_shutdown：停止领取、取消请求；已提交部分随事务已落库 ──────\n\tconst offShutdown = pi.on(\"session_shutdown\", (event, ctx) => {\n\t\taccepting = false;\n\t\t// 本会话退出忙集合——它不再占前台，且 accepting=false 已停领。\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyDelete(deps.paoHome, boundSessionId);\n\t\tfor (const controller of active.values()) controller.abort();\n\t\tconst cleanup = () => {\n\t\t\tpendingSessions.clear();\n\t\t\tactive.clear();\n\t\t};\n\t\t// 确认关机后再复位状态（与其他关闭者并发时状态不被提前清掉）。\n\t\tif (event.onConfirmedShutdown) event.onConfirmedShutdown(cleanup);\n\t\telse cleanup();\n\t});\n\n\t// 装配启动先恢复上次未完成任务（running 死进程/普通 failed 未超限 → pending）。\n\trecoverJobs(store, now());\n\n\t/**\n\t * 一轮队列：内存 pendingSessions ∪ 库内 pending extract 的 scopeKey 逐个领取。\n\t * 库内 pending 兜底（O03/F06）：A 会话建的 job 在 A 退出后，由装配同一 home\n\t * 的另一会话调度器扫描捞起续作；内存集合只是唤醒提示，不是待办清单。\n\t * 中途新 turn_end 登记的会话留给下一次 settled（本循环只拍一次快照）。\n\t * per-target 前忙集合非空即 return：本 home 任一会话前台忙时不新领（O03/F03/I02）。\n\t */\n\tasync function drainQueue(ctx: ExtensionContext): Promise<void> {\n\t\t// 先恢复（running 死进程/普通 failed 未超限 → pending）再跑——\n\t\t// 本进程被 agent_start 取消的 running job 也在同一轮被重取。\n\t\trecoverJobs(store, now());\n\t\t// 全 home 持久 pending 兜底：除内存集合外扫库内 pending extract scopeKey，\n\t\t// 没有该会话内存登记的消费方也能捞起（跨会话续作）。\n\t\tconst pendingRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT scope_key FROM extraction_jobs\n\t\t\t\t WHERE status = 'pending' AND job_kind = 'extract'`,\n\t\t\t)\n\t\t\t.all() as unknown as Array<{ scope_key: string }>;\n\t\tconst targets = new Set<string>([\n\t\t\t...pendingRows.map((row) => row.scope_key),\n\t\t\t...[...pendingSessions].map((sessionId) => `session:${sessionId}`),\n\t\t]);\n\t\tpendingSessions.clear();\n\t\tfor (const scopeKey of targets) {\n\t\t\tif (!accepting) return;\n\t\t\t// 本 home 本进程任一会话前台忙时不新领；库内 pending 留待空闲进程/下轮。\n\t\t\tif (foregroundBusySize(deps.paoHome) > 0) return;\n\t\t\ttry {\n\t\t\t\tawait runSessionJob(ctx, scopeKey);\n\t\t\t} catch (error) {\n\t\t\t\t// 单 job 失败不阻塞后续 job；失败原因已尽力落进 job.last_error。\n\t\t\t\tconsole.error(\n\t\t\t\t\t`[pao-memory] 提炼范围 ${scopeKey} 失败:`,\n\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\tasync function embedForSession(\n\t\tctx: ExtensionContext,\n\t\tscope: MemoryScope,\n\t\tsessionId: string,\n\t\tjobId: string,\n\t\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">,\n\t\tsignal: AbortSignal,\n\t): Promise<void> {\n\t\ttry {\n\t\t\tawait embedCurrentMemories({\n\t\t\t\thome: deps.paoHome,\n\t\t\t\tdb: store.db,\n\t\t\t\tprojectId: scope.projectId,\n\t\t\t\texecutionPath: ctx.cwd,\n\t\t\t\tledger,\n\t\t\t\tjobId,\n\t\t\t\trequestId: `embed:${jobId}:${now()}`,\n\t\t\t\tattribution: {\n\t\t\t\t\tkind: \"embed\",\n\t\t\t\t\tjobId,\n\t\t\t\t\tsourceSessionId: sessionId,\n\t\t\t\t\tprojectId: scope.projectId,\n\t\t\t\t\t...(scope.taskId === undefined ? {} : { taskId: scope.taskId }),\n\t\t\t\t},\n\t\t\t\tsignal,\n\t\t\t\t...(deps.embedding?.batchSize === undefined ? {} : { batchSize: deps.embedding.batchSize }),\n\t\t\t\t...(deps.embedding?.timeoutMs === undefined ? {} : { timeoutMs: deps.embedding.timeoutMs }),\n\t\t\t});\n\t\t} catch (error) {\n\t\t\tif (!signal.aborted) {\n\t\t\t\tconsole.error(\n\t\t\t\t\t`[pao-memory] 会话 ${sessionId} 向量嵌入失败:`,\n\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\t/**\n\t * 单个提炼范围的一次提炼：建/取 job → 领取 → 事务外组装 → 请求 → 提交 → 游标。\n\t * scopeKey 形如 `session:{sessionId}`；job 自带身份——续作别的会话 job 时\n\t * scope/sessionId/projectId 从 job.sourceScope 重建，不借当前消费会话身份（O03）。\n\t */\n\tasync function runSessionJob(ctx: ExtensionContext, scopeKey: string): Promise<void> {\n\t\t// job 身份：scopeKey 拆出 jobSessionId；scope 的 projectId 从 job.sourceScope 取。\n\t\tconst jobSessionId = scopeKey.startsWith(\"session:\") ? scopeKey.slice(\"session:\".length) : scopeKey;\n\t\tconst existingRow = store.db\n\t\t\t.prepare(`SELECT source_scope, status FROM extraction_jobs WHERE scope_key = ?`)\n\t\t\t.get(scopeKey) as { source_scope: string; status: string } | undefined;\n\t\tconst storedScope =\n\t\t\texistingRow === undefined\n\t\t\t\t? undefined\n\t\t\t\t: (JSON.parse(existingRow.source_scope) as { sessionId?: string; projectId?: string });\n\t\t// projectId 优先取 job.sourceScope 里的持久身份；本进程新登记的 job（尚无持久行）\n\t\t// 退回当前 ctx 的 resolveScope——这是唯一用「当前会话身份」的入口（建新 job 时）。\n\t\tconst jobScope: MemoryScope =\n\t\t\tstoredScope?.projectId !== undefined\n\t\t\t\t? { projectId: storedScope.projectId, sessionId: jobSessionId }\n\t\t\t\t: deps.resolveScope(ctx);\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: jobSessionId, projectId: jobScope.projectId }),\n\t\t\tscopeKey,\n\t\t\tcreatedAt: now(),\n\t\t});\n\t\tlet runnableJob = job;\n\t\tif (job.status === \"failed\") {\n\t\t\t// needs-reevaluation 不自动重放，但出现「上次尝试边界之后」的新来源时重开——\n\t\t\t// 新来源即重评依据（O03/I01）。游标只记已提交边界，已尝试未提交的游标后\n\t\t\t// 旧批不算新依据：判据用 last_error 里记录的 attempted_through 边界。\n\t\t\tconst attemptedThrough = attemptedThroughOf(job.lastError);\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tconst reopened =\n\t\t\t\tattemptedThrough !== undefined && afterCursorSources(sources, attemptedThrough).length > 0\n\t\t\t\t\t? reopenFailedJobForNewSources(store, { jobId: job.jobId, reopenedAt: now() })\n\t\t\t\t\t: undefined;\n\t\t\tif (reopened === undefined) {\n\t\t\t\tconst ledger = ledgerForJob(job.jobId);\n\t\t\t\tconst controller = new AbortController();\n\t\t\t\tactive.set(job.jobId, controller);\n\t\t\t\ttry {\n\t\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, job.jobId, ledger, controller.signal);\n\t\t\t\t} finally {\n\t\t\t\t\tactive.delete(job.jobId);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\trunnableJob = reopened;\n\t\t}\n\t\tif (job.status === \"done\") {\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tif (afterCursorSources(sources, job.cursor).length === 0) {\n\t\t\t\tconst ledger = ledgerForJob(job.jobId);\n\t\t\t\tconst controller = new AbortController();\n\t\t\t\tactive.set(job.jobId, controller);\n\t\t\t\ttry {\n\t\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, job.jobId, ledger, controller.signal);\n\t\t\t\t} finally {\n\t\t\t\t\tactive.delete(job.jobId);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst reopened = reopenDoneJob(store, { jobId: job.jobId, reopenedAt: now() });\n\t\t\tif (!reopened) return;\n\t\t\trunnableJob = reopened;\n\t\t}\n\t\tconst claimed = claimJob(store, {\n\t\t\tjobId: runnableJob.jobId,\n\t\t\townerProcess,\n\t\t\tclaimedAt: now(),\n\t\t});\n\t\tif (!claimed) return; // 其他存活进程持有，不抢。\n\t\tconst ledger = ledgerForJob(runnableJob.jobId);\n\n\t\tconst controller = new AbortController();\n\t\tactive.set(runnableJob.jobId, controller);\n\t\ttry {\n\t\t\t// 本次范围：游标之后的未提交来源（cursor 存最后处理的 sourceId；按序取其后）。\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tconst afterCursor = afterCursorSources(sources, claimed.job.cursor);\n\t\t\tif (afterCursor.length === 0) {\n\t\t\t\tcompleteJob(store, { jobId: runnableJob.jobId, completedAt: now() });\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t// 每段只覆盖一个来源任务；切任务后旧来源仍按它采集时记录的身份提炼。\n\t\t\tconst batches = groupSourcesByScope(jobScope, afterCursor);\n\t\t\t// 本轮组批时整个来源快照的末尾：重开判据以它区分「快照后真新增」\n\t\t\t// 与「失败批后已存在的其他任务批次」（O03/J01）。\n\t\t\tconst snapshotEnd = afterCursor[afterCursor.length - 1]!.sourceId;\n\t\t\tfor (const batch of batches) {\n\t\t\t\tconst { entries, excludedCount, failedSources } = await entriesFromSources(deps, batch.sources);\n\t\t\t\tconst last = batch.sources[batch.sources.length - 1]!;\n\t\t\t\tif (failedSources.length > 0) {\n\t\t\t\t\t// 读失败不是「没内容」：不越过这些来源的游标——记 failJob 含原因，\n\t\t\t\t\t// 停本 job 后续批；恢复后同一批重试，不重复已提交候选。\n\t\t\t\t\tfailJob(store, {\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\treason: `来源读取失败:${failedSources\n\t\t\t\t\t\t\t.map((source) => source.sourceId)\n\t\t\t\t\t\t\t.join(\",\")}（source_missing/段文件不可读，游标停在本批前）`,\n\t\t\t\t\t\tfailedAt: now(),\n\t\t\t\t\t});\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (entries.length === 0) {\n\t\t\t\t\t// 本段全部被排除（或理论空批）：排除是确定状态，推进游标避免空转。\n\t\t\t\t\tvoid excludedCount;\n\t\t\t\t\tadvanceCursor(store, {\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\tcursor: last.sourceId,\n\t\t\t\t\t\tadvancedAt: now(),\n\t\t\t\t\t});\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tconst related = relatedMemoriesForScope(store, batch.scope);\n\t\t\t\tconst output = await requestExtraction(\n\t\t\t\t\t{\n\t\t\t\t\t\t// 模型运行入口从 ctx 现取：装配期拿不到 modelRegistry（register 签名无\n\t\t\t\t\t\t// ctx），而每个事件回调的 ctx 自带注册表——比装配注入少一层绕路。\n\t\t\t\t\t\tmodelRegistry: ctx.modelRegistry,\n\t\t\t\t\t\tledger,\n\t\t\t\t\t\tpaoHome: deps.paoHome,\n\t\t\t\t\t\t...(deps.tierConfig === undefined ? {} : { tierConfig: deps.tierConfig }),\n\t\t\t\t\t\t...(deps.tierName === undefined ? {} : { tierName: deps.tierName }),\n\t\t\t\t\t\t// 外发许可：项目名只由可信执行路径决定（resolveMemoryOutboundContext）；\n\t\t\t\t\t\t// 续作别的会话 job 时这仍是「本 home 当前执行环境」的外发主体，语义不变。\n\t\t\t\t\t\toutboundProjects: [resolveMemoryOutboundContext(deps.paoHome, ctx.cwd).project],\n\t\t\t\t\t\t// 预算：scopeKey 与 extraction-jobs 同值；attemptKey 由\n\t\t\t\t\t\t// extract-model 按本次 requestId 派生——每次实际请求独立判据，\n\t\t\t\t\t\t// 同批重试不再复用上一条预留覆盖已发生费用。\n\t\t\t\t\t\tbudgetScopeKey: scopeKey,\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\tsourceSessionId: jobSessionId,\n\t\t\t\t\t\tentries,\n\t\t\t\t\t\trelatedMemories: related,\n\t\t\t\t\t\tsignal: controller.signal,\n\t\t\t\t\t},\n\t\t\t\t);\n\t\t\t\tconst shouldContinue = await finishJob(\n\t\t\t\t\trunnableJob,\n\t\t\t\t\tjobSessionId,\n\t\t\t\t\tbatch.scope,\n\t\t\t\t\tbatch.sources,\n\t\t\t\t\trelated,\n\t\t\t\t\toutput,\n\t\t\t\t\tcontroller.signal,\n\t\t\t\t\tsnapshotEnd,\n\t\t\t\t);\n\t\t\t\tif (!shouldContinue) return;\n\t\t\t}\n\t\t\tif (afterCursor.length > 0) {\n\t\t\t\tcompleteJob(store, { jobId: runnableJob.jobId, completedAt: now() });\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tif (accepting) {\n\t\t\t\tfailJob(store, {\n\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\treason: error instanceof Error ? error.message : String(error),\n\t\t\t\t\tfailedAt: now(),\n\t\t\t\t});\n\t\t\t}\n\t\t\t// shutdown 期间的异常不另记失败——保持 running 由下次启动 recover。\n\t\t\tthrow error;\n\t\t} finally {\n\t\t\tif (accepting && !controller.signal.aborted) {\n\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, runnableJob.jobId, ledger, controller.signal);\n\t\t\t\t// O06/J01：提炼 job 收尾登记本项目 organize 作业（embed 挂点同惯例）。\n\t\t\t\t// 登记失败不阻塞收尾——规整是空闲增量能力，不掩盖已提交结果。\n\t\t\t\ttry {\n\t\t\t\t\tdeps.onOrganizeCandidate?.(jobScope.projectId);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tconsole.error(\n\t\t\t\t\t\t`[pao-memory] 规整作业登记失败 ${jobScope.projectId}:`,\n\t\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\t\t\tactive.delete(runnableJob.jobId);\n\t\t}\n\t}\n\n\t/**\n\t * 请求返回后的收尾：成功提交后推进游标；普通请求失败按既有上限恢复；\n\t * 候选命中请求前快照失效时保留未提交范围，标记需重新评估且不自动重放。\n\t * 返回 false 表示当前 job 不再处理后续任务段，避免越过未决来源。\n\t */\n\tasync function finishJob(\n\t\tjob: ExtractionJob,\n\t\t_sessionId: string,\n\t\tscope: MemoryScope,\n\t\tbatchSources: SourceRow[],\n\t\trelatedMemories: RelatedMemorySummary[],\n\t\toutput: ExtractModelOutput | { ok: false; error: { message: string } },\n\t\tsignal: AbortSignal,\n\t\tsnapshotEnd: string,\n\t): Promise<boolean> {\n\t\tif (\"error\" in output && output.ok === false) {\n\t\t\t// 契约级失败（invalid_input 等）：记失败但游标推进跳过本批——\n\t\t\t// 输入装配问题重试同样输入只会再失败，不占重试额度。\n\t\t\tfailJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `提炼输入被拒:${output.error.message}`,\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\tadvanceCursor(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\tcursor: batchSources[batchSources.length - 1].sourceId,\n\t\t\t\tadvancedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tconst result = output as ExtractModelOutput;\n\t\tconst last = batchSources[batchSources.length - 1];\n\t\tif (result.failure !== undefined) {\n\t\t\tif (signal.aborted) {\n\t\t\t\t// 本侧调度取消（agent_start/session_shutdown 前台优先）不是故障：\n\t\t\t\t// 交回 pending、保游标、不占 consecutive_failures 额度（O03/I03），\n\t\t\t\t// 下一轮空闲 drain 重新领取续跑未提交范围；已发生用量照实留痕\n\t\t\t\t// （releaseJob 不动 last_usage，另补一笔）。\n\t\t\t\treleaseJob(store, { jobId: job.jobId, releasedAt: now() });\n\t\t\t\tif (result.usage !== undefined) {\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(`UPDATE extraction_jobs SET last_usage = ? WHERE job_id = ?`)\n\t\t\t\t\t\t.run(JSON.stringify(result.usage), job.jobId);\n\t\t\t\t}\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\t// 请求/解析级失败：保留原因与已知用量，游标不推进（未提交范围重跑）。\n\t\t\tfailJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `${result.failure.stage}:${result.failure.message}`,\n\t\t\t\t...(result.usage === undefined ? {} : { lastUsage: JSON.stringify(result.usage) }),\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tconst committed = await commitExtractionCandidates(store, deps.service, {\n\t\t\tjobId: job.jobId,\n\t\t\tscope,\n\t\t\tcandidates: result.candidates,\n\t\t\trelatedMemories,\n\t\t\tsourceRefs: batchSources.map((source) => ({\n\t\t\t\tsourceId: source.sourceId,\n\t\t\t\tsessionId: source.sessionId,\n\t\t\t\tentryId: source.entryId,\n\t\t\t\teventType: source.eventType,\n\t\t\t\t...(source.projectId === undefined ? {} : { projectId: source.projectId }),\n\t\t\t\t...(source.taskId === undefined ? {} : { taskId: source.taskId }),\n\t\t\t})),\n\t\t\tnow: now(),\n\t\t});\n\t\tconst stale = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"stale_request_snapshot\",\n\t\t);\n\t\t// 语义冲突同口径不推进：候选与既有记忆同结论但理由/状态/类别不一致，\n\t\t// 需基于最新 related 重新评估，推进游标会丢未决差异。\n\t\tconst conflicts = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"semantic_conflict\",\n\t\t);\n\t\t// 停用来源命中同口径不推进（O03/F05）：stopped 是用户明确停用，同来源\n\t\t// 重放不能绕过另建 active 副本；该候选如实跳过留 job 由新一轮重评。\n\t\tconst restingStopped = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"source_resting_stopped\",\n\t\t);\n\t\tif (stale.length > 0 || conflicts.length > 0 || restingStopped.length > 0) {\n\t\t\tconst parts: string[] = [];\n\t\t\tif (stale.length > 0) {\n\t\t\t\tconst memories = [...new Set(stale.map((outcome) => `${outcome.memoryId}@rev${outcome.snapshotRevision}`))];\n\t\t\t\tconst sourceIds = [...new Set(stale.flatMap((outcome) => outcome.sourceIds))];\n\t\t\t\tparts.push(\n\t\t\t\t\t`请求前记忆快照已变化，需基于最新 related 重新评估；memory=${memories.join(\",\")}；sources=${sourceIds.join(\",\")}`,\n\t\t\t\t);\n\t\t\t}\n\t\t\tif (conflicts.length > 0) {\n\t\t\t\tconst details = conflicts.map((outcome) => {\n\t\t\t\t\tif (outcome.status !== \"skipped\" || outcome.reason !== \"semantic_conflict\") return \"\";\n\t\t\t\t\tconst changed = Object.entries(outcome.delta)\n\t\t\t\t\t\t.filter(([, changed]) => changed)\n\t\t\t\t\t\t.map(([field]) => field)\n\t\t\t\t\t\t.join(\"/\");\n\t\t\t\t\treturn `候选#${outcome.candidateIndex}↔${outcome.memoryId}(${changed})`;\n\t\t\t\t});\n\t\t\t\tparts.push(`语义冲突候选需重新评估；conflict=${details.join(\",\")}`);\n\t\t\t}\n\t\t\tif (restingStopped.length > 0) {\n\t\t\t\tconst memories = [...new Set(restingStopped.map((outcome) => outcome.memoryId))];\n\t\t\t\tparts.push(`同来源已停用记忆不复活，需重新评估；stopped=${memories.join(\",\")}`);\n\t\t\t}\n\t\t\t// attempted_through 记录本轮组批时整个来源快照的末尾（非失败批末尾）：\n\t\t\t// 重开判据靠它区分「快照后真新增」与「失败批后已存在的其他任务批次」（O03/J01）。\n\t\t\tparts.push(`attempted_through=${snapshotEnd}`);\n\t\t\tmarkJobNeedsReevaluation(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `${parts.join(\"；\")}；已提交候选=${committed.submitted}`,\n\t\t\t\t...(result.usage === undefined ? {} : { lastUsage: JSON.stringify(result.usage) }),\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tadvanceCursor(store, {\n\t\t\tjobId: job.jobId,\n\t\t\tcursor: last.sourceId,\n\t\t\tadvancedAt: now(),\n\t\t});\n\t\treturn true;\n\t}\n\n\t/**\n\t * 从 needs-reevaluation 的 last_error 里取上次尝试到的来源边界\n\t * （finishJob 写入的 `attempted_through=<sourceId>`）。没有该标记的\n\t * failed job 返回 undefined——无法区分新来源与已尝试旧批，保守不重开。\n\t */\n\tfunction attemptedThroughOf(lastError: string | undefined): string | undefined {\n\t\tif (lastError === undefined) return undefined;\n\t\tconst match = /(?:^|；)attempted_through=([^；\\s]+)/.exec(lastError);\n\t\treturn match?.[1];\n\t}\n\n\t/** 取游标之后的来源（cursor 是最后处理的 sourceId；按序取其后）。 */\n\tfunction afterCursorSources(sources: SourceRow[], cursor: string | undefined): SourceRow[] {\n\t\tif (cursor === undefined) return sources;\n\t\tconst index = sources.findIndex((source) => source.sourceId === cursor);\n\t\treturn index === -1 ? sources : sources.slice(index + 1);\n\t}\n\n\treturn () => {\n\t\taccepting = false;\n\t\toffTurnEnd();\n\t\toffSettled();\n\t\toffAgentStart();\n\t\toffShutdown();\n\t\tfor (const controller of active.values()) controller.abort();\n\t\tactive.clear();\n\t\tpendingSessions.clear();\n\t\t// 本实例卸载时退出前台忙集合——不留陈旧占用挡住同 home 其他会话。\n\t\tif (boundSessionId !== undefined) foregroundBusyDelete(deps.paoHome, boundSessionId);\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 内置记忆 S2-02：事件触发的自动提炼调度。\n *import type { ExtensionAPI, ExtensionContext } from \"../../core/extensions/types.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport type { TierConfig } from \"../routing/config.ts\";\nimport { readSourceEventsBatch, type ArchiveSegmentRow, readSourceEventsBatch } from \"./archive.ts\";\nimport { commitExtractionCandidates } from \"./extract-commit.ts\";\nimport { requestExtraction } from \"./extract-model.ts\";\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":39}},{"diffOp":{"equal":{"range":[67,277]}}},{"diffOp":{"equal":{"range":[277,287]}}},{"diffOp":{"delete":{"range":[287,310]}}},{"diffOp":{"equal":{"range":[310,332]}}},{"diffOp":{"insert":{"range":[332,355]}}},{"diffOp":{"equal":{"range":[355,378]}}},{"diffOp":{"equal":{"range":[378,500]}}},{"equalLines":{"line_count":741}},{"diffOp":{"equal":{"range":[500,506]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\extraction-scheduler.ts"},"span":[3533,3618],"sourceCode":"/**\n * 内置记忆 S2-02：事件触发的自动提炼调度。\n *\n * 契约：\n * - `turn_end`（与 capture.ts 的采集钩子并列，本模块不再采集）只登记「本会话有新\n *   来源」进内存待提炼集合——一串工具回合合并成一个批次，不每轮都发模型请求。\n * - `agent_settled`（自动重试/压缩/续跑全结束的唯一信号）唤醒一轮队列：\n *   `recoverJobs` 先恢复上次未完成任务 → 除内存 pendingSessions 外再扫\n *   `extraction_jobs` 全库 `status='pending' AND job_kind='extract'` 的\n *   scopeKey 一并消费（O03/F06/D6：持久 pending 由全 home 扫描兜底，A 退出\n *   后开 B 续作 A）→ 逐 job 领取 → 事务外组装 ExtractModelInput\n *   （来源正文经 readMemorySource 回读已保存脱敏正文）→ `requestExtraction` →\n *   `commitExtractionCandidates` → `advanceCursor`/`completeJob`，或普通失败\n *   保 pending 待下次 settled 重试。若候选命中 stale_request_snapshot，则不\n *   推进游标，复用 failed + last_error 标记需重新评估且不自动重放——\n *   但同 scope 出现上次尝试边界之后的新来源时重开（新来源 = 重评依据，\n *   边界以 last_error 内 attempted_through 为准；已尝试未提交的游标后\n *   旧批不算新依据，普通 settled 不反复重跑，O03/I01）。\n *   单个 job 失败不阻塞后续 job；不递归开新提炼任务（S2-12）。\n * - `agent_start` 取消进行中的模型调用（AbortController.abort）：普通任务优先。\n *   本侧调度取消是前台优先动作不是故障——请求返回时 signal.aborted 走\n *   releaseJob 交回 pending、保游标、不占 consecutive_failures 额度\n *   （O03/I03），下一轮空闲 drain 重新领取续作；已发生用量照实留痕。\n * - 每个 job 收尾复用本轮外发许可嵌入当前修订缺失向量；终态 job 仍会处理新纠正\n *   产生的缺向量，不另建嵌入队列。\n * - `session_shutdown` 停止领取新 job、取消在途请求；已提交的候选随各事务已落库，\n *   running job 由下次启动 recover（onConfirmedShutdown 跑状态复位，不新开付费请求）。\n * - 装配启动先跑一次 recoverJobs（服务启动先恢复上次未完成任务）。\n * - 提炼范围以「本进程本会话」为限（S2-02 口径），不跨会话偷读；\n *   job 的 scopeKey = `session:{sessionId}`（同会话幂等复用，游标推进后只处理新增条目）。\n * - job 自带身份：续作别的会话 job 时 scope/sessionId/projectId 全部从\n *   `job.sourceScope` 重建，不借当前消费会话的身份（O03）；budgetScopeKey\n *   保持 scopeKey，外发主体仍按本 home 当前执行环境判定。\n * - 读失败与已排除分开（O03/F13）：`readMemorySource` 失败不越过游标，\n *   该来源记 failJob 并停本 job 后续批；已排除来源属确定状态可推进游标。\n * - 前台忙不新领（O03/F03/I02）：`agent_start` 把本会话加进按 home 归属的\n *   进程内共享 busy 集合（foreground-busy.ts），drain 的 per-target 前\n *   集合非空即 return，本 home 任一会话前台忙时不新领；busy 是本进程内\n *   本 home 的口径，不是跨进程锁——进程间靠 claimJob owner 存活检查防双领。\n * - 重试额度按未提交批次（O03/F07）：`consecutive_failures` 递增于 failJob、\n *   清零于提交成功的批次边界；`attempt_count` 只作历史总次数。\n */\nimport type { ExtensionAPI, ExtensionContext } from \"../../core/extensions/types.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport type { TierConfig } from \"../routing/config.ts\";\nimport { readSourceEventsBatch, type ArchiveSegmentRow } from \"./archive.ts\";\nimport { commitExtractionCandidates } from \"./extract-commit.ts\";\nimport { requestExtraction } from \"./extract-model.ts\";\nimport {\n\tadvanceCursor,\n\tclaimJob,\n\tcompleteJob,\n\tcreateJob,\n\tfailJob,\n\tmarkJobNeedsReevaluation,\n\trecoverJobs,\n\treleaseJob,\n\treopenDoneJob,\n\treopenFailedJobForNewSources,\n} from \"./extraction-jobs.ts\";\nimport { foregroundBusyAdd, foregroundBusyDelete, foregroundBusySize } from \"./foreground-busy.ts\";\nimport { embedCurrentMemories, openPersistentMemoryLedger, resolveMemoryOutboundContext } from \"./runtime-embedding.ts\";\nimport { isSourceExcluded, isSourceGloballyExcluded, type SourceRow } from \"./sources.ts\";\nimport type { MemoryStore } from \"./store.ts\";\nimport type {\n\tExtractionJob,\n\tExtractionSourceEntry,\n\tExtractModelOutput,\n\tMemoryScope,\n\tMemoryService,\n\tRelatedMemorySummary,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/** registerExtractionScheduler 的依赖。 */\nexport interface ExtractionSchedulerDeps {\n\t/** 批次 A 的存储句柄（job 状态与直查用同一连接）。 */\n\tstore: MemoryStore;\n\t/** 完整服务（createMemory/flagForReDiscussion/readMemorySource 等）。 */\n\tservice: MemoryService;\n\t/** PAO_HOME 根（档位解析 + 记账会话 cwd + 归档读取）。 */\n\tpaoHome: string;\n\t/**\n\t * 记账会话。缺省时使用 PAO_HOME 下可重开的专用持久后台会话；迟到结果仍归\n\t * 同一 jobId，不写入切换后的用户会话。\n\t */\n\tledger?: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** settled 收尾嵌入的参数；生产缺省按 32 条一批、15 秒单批超时。 */\n\tembedding?: {\n\t\tbatchSize?: number;\n\t\ttimeoutMs?: number;\n\t};\n\t/** 提炼档位名（缺省走 extract-model 的 \"fast\"）。 */\n\ttierName?: string;\n\t/** 已加载档位配置（测试注入跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/**\n\t * 从宿主上下文推导可信 scope（tools.ts 的 Git common-dir 项目身份与当前\n\t * executionRoot）。拿不到 projectId 时给 \"unknown\" 占位——空 projectId 会被\n\t * createMemory 判 invalid_input，如实失败不伪造成功。\n\t */\n\tresolveScope: (ctx: ExtensionContext) => MemoryScope;\n\t/**\n\t * 提炼 job 收尾后的 organize 登记回调（O06/J01）：\n\t * 每个 extract job 跑完（成功/失败/部分提交路径统一在 finally 触发）后\n\t * 按 projectId 登记一次增量规整作业；装配方接到维护调度器 enqueue。\n\t * 同 scopeKey 幂等——无变化时 organize handler 空扫即 done，不发模型请求。\n\t */\n\tonOrganizeCandidate?: (projectId: string) => void;\n\t/**\n\t * 段读取实现探针（测试核对 O14 按段复用的读盘次数；生产缺省走\n\t * readSegmentLines，调用方不应传）。\n\t */\n\treadSegment?: (segment: ArchiveSegmentRow) => Promise<{ lines: string[]; archived: boolean } | undefined>;\n\t/** 时间源（夹具注入；缺省 UTC 当前时间）。 */\n\tnow?: () => string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 来源读取与输入组装（事务外）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 列出该会话已登记的非边界来源行（boundary 是占位行不是内容），按采集时间排序。 */\nfunction listSessionSources(store: MemoryStore, sessionId: string): SourceRow[] {\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT source_id, session_id, entry_id, event_type, project_id, task_id,\n\t\t\t        location, segment_id, captured_at\n\t\t\t FROM sources WHERE session_id = ? AND event_type != 'boundary'\n\t\t\t ORDER BY captured_at, source_id`,\n\t\t)\n\t\t.all(sessionId) as unknown as Array<{\n\t\tsource_id: string;\n\t\tsession_id: string;\n\t\tentry_id: string;\n\t\tevent_type: string;\n\t\tproject_id: string | null;\n\t\ttask_id: string | null;\n\t\tlocation: string | null;\n\t\tsegment_id: string | null;\n\t\tcaptured_at: string;\n\t}>;\n\treturn rows.map((row) => ({\n\t\tsourceId: row.source_id,\n\t\tsessionId: row.session_id,\n\t\tentryId: row.entry_id,\n\t\teventType: row.event_type,\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t...(row.location === null ? {} : { location: row.location }),\n\t\t...(row.segment_id === null ? {} : { segmentId: row.segment_id }),\n\t\tcapturedAt: row.captured_at,\n\t}));\n}\n\n/**\n * 把一批来源行回读成 ExtractModelInput.entries：正文取已保存的脱敏正文\n * （ArchivedEvent 的 JSONL 行序列化）。\n * 区分两类未入选：已排除（isSourceExcluded，确定状态可推进游标）与\n * 读取失败（source_missing 等，不是「没内容」，不能越过游标）——\n * 提炼输入只含能如实定位的正文，不拿会话投影替代。\n *\n * O14 按段复用：本批来源经 readSourceEventsBatch 一次按段分组读取——\n * 同段 n 个来源只解压/解析段文件一次（原来逐来源 readMemorySource 重复\n * 读同段 n 次）。失败与排除口径与逐条 readMemorySource 一致：排除用同一\n * isSourceGloballyExcluded 判定（全局排除的来源仍进段读取失败列，与\n * 原 readMemorySource 先查排除再读的行为同样落到 failedSources）。\n */\nasync function entriesFromSources(\n\tdeps: ExtractionSchedulerDeps,\n\tsources: SourceRow[],\n): Promise<{ entries: ExtractionSourceEntry[]; excludedCount: number; failedSources: SourceRow[] }> {\n\tconst db = deps.store.db;\n\tconst entries: ExtractionSourceEntry[] = [];\n\tlet excludedCount = 0;\n\tconst included: SourceRow[] = [];\n\tfor (const source of sources) {\n\t\t// 提交级排除核对（与逐条 readMemorySource 第一道口一致）；\n\t\t// isSourceGloballyExcluded 在下方段回读前再核一次，保证共享保留/整删\n\t\t// 口径不走样。\n\t\tif (isSourceExcluded(db, { sourceId: source.sourceId })) {\n\t\t\texcludedCount += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tincluded.push(source);\n\t}\n\tconst failedSources: SourceRow[] = [];\n\tif (included.length === 0) {\n\t\treturn { entries, excludedCount, failedSources };\n\t}\n\tconst reads = await readSourceEventsBatch(db, deps.paoHome, included.map((source) => source.sourceId), {\n\t\t// 与逐条 readMemorySource({limit:1}) 同口径：正文只取锚定事件自身一行，\n\t\t// 不取邻近上下文窗口——提炼输入语义保持原样。\n\t\trange: { limit: 1 },\n\t\t...(deps.readSegment === undefined ? {} : { readSegment: deps.readSegment }),\n\t});\n\tfor (const source of included) {\n\t\t// 与 readMemorySource 同口径的整体排除判定：全局排除当读取失败处理\n\t\t// （原实现先查 isSourceGloballyExcluded 返回 source_missing——落到\n\t\t// failedSources 而不是 excludedCount，保持一致不越过游标）。\n\t\tif (isSourceGloballyExcluded(db, { sourceId: source.sourceId })) {\n\t\t\tfailedSources.push(source);\n\t\t\tcontinue;\n\t\t}\n\t\tconst read = reads.get(source.sourceId);\n\t\tif (read === undefined || !read.ok) {\n\t\t\tfailedSources.push(source);\n\t\t\tcontinue;\n\t\t}\n\t\tentries.push({\n\t\t\tsourceId: source.sourceId,\n\t\t\tentryId: source.entryId,\n\t\t\teventType: source.eventType,\n\t\t\tcontent: read.events.map((event) => JSON.stringify(event)).join(\"\\n\"),\n\t\t});\n\t}\n\treturn { entries, excludedCount, failedSources };\n}\n\n/**\n * 同范围已有决定摘要（给模型判断关联/重议用；不含正文全文）。\n * 直查 memories 当前修订：同 projectId、active、未合并走。\n */\nfunction relatedMemoriesForScope(store: MemoryStore, scope: MemoryScope): RelatedMemorySummary[] {\n\tconst taskClause =\n\t\tscope.taskId === undefined\n\t\t\t? \"json_extract(m.scope_json, '$.taskId') IS NULL\"\n\t\t\t: \"(json_extract(m.scope_json, '$.taskId') IS NULL OR json_extract(m.scope_json, '$.taskId') = ?)\";\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT m.id, m.kind, m.current_revision, m.usage_state, r.content_json\n\t\t\t FROM memories m\n\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t WHERE m.merged_into IS NULL AND m.usage_state = 'active'\n\t\t\t   AND json_extract(m.scope_json, '$.projectId') = ?\n\t\t\t   AND ${taskClause}\n\t\t\t ORDER BY m.updated_at DESC\n\t\t\t LIMIT 50`,\n\t\t)\n\t\t.all(scope.projectId, ...(scope.taskId === undefined ? [] : [scope.taskId])) as unknown as Array<{\n\t\tid: string;\n\t\tkind: string;\n\t\tcurrent_revision: number;\n\t\tusage_state: string;\n\t\tcontent_json: string;\n\t}>;\n\treturn rows.map((row) => {\n\t\tconst content = JSON.parse(row.content_json) as {\n\t\t\tconclusion?: string;\n\t\t\tconditions?: string;\n\t\t\tconfirmation?: RelatedMemorySummary[\"confirmation\"];\n\t\t};\n\t\treturn {\n\t\t\tmemoryId: row.id,\n\t\t\tkind: row.kind as RelatedMemorySummary[\"kind\"],\n\t\t\tcurrentRevision: row.current_revision,\n\t\t\tconclusion: content.conclusion ?? \"\",\n\t\t\t...(content.conditions === undefined ? {} : { conditions: content.conditions }),\n\t\t\tconfirmation: content.confirmation ?? \"tentative\",\n\t\t\tusageState: row.usage_state as RelatedMemorySummary[\"usageState\"],\n\t\t};\n\t});\n}\n\ninterface SourceBatch {\n\tscope: MemoryScope;\n\tsources: SourceRow[];\n}\n\n/** 来源自身证明任务时使用该任务；否则明确去掉当前 scope 的 taskId，绝不回填。 */\nfunction scopeForSource(base: MemoryScope, source: SourceRow): MemoryScope {\n\tconst scope = { ...base };\n\tif (source.projectId !== undefined) scope.projectId = source.projectId;\n\tif (source.projectId !== undefined && source.taskId !== undefined) scope.taskId = source.taskId;\n\telse delete scope.taskId;\n\treturn scope;\n}\n\n/** 按连续来源的任务身份切批，使同一模型请求和同一游标段只覆盖一个任务。 */\nfunction groupSourcesByScope(base: MemoryScope, sources: SourceRow[]): SourceBatch[] {\n\tconst groups: SourceBatch[] = [];\n\tfor (const source of sources) {\n\t\tconst scope = scopeForSource(base, source);\n\t\tconst key = `${scope.projectId}\\u0000${scope.taskId ?? \"\"}`;\n\t\tconst current = groups[groups.length - 1];\n\t\tconst currentKey =\n\t\t\tcurrent === undefined ? undefined : `${current.scope.projectId}\\u0000${current.scope.taskId ?? \"\"}`;\n\t\tif (current === undefined || currentKey !== key) {\n\t\t\tgroups.push({ scope, sources: [source] });\n\t\t} else {\n\t\t\tcurrent.sources.push(source);\n\t\t}\n\t}\n\treturn groups;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 调度本体\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 挂 turn_end / agent_settled / agent_start / session_shutdown 四个事件，\n * 驱动「采集 → 持久任务 → 模型提炼 → 候选提交」全链。返回 unmount。\n */\nexport function registerExtractionScheduler(pi: ExtensionAPI, deps: ExtractionSchedulerDeps): () => void {\n\tconst store = deps.store;\n\tconst now = deps.now ?? (() => new Date().toISOString());\n\tconst ownerProcess = `pid-${process.pid}`;\n\tconst ledgerForJob = (jobId: string) => deps.ledger ?? openPersistentMemoryLedger(deps.paoHome, jobId);\n\n\t/** 本会话有新来源待提炼的 sessionId 集合（turn_end 登记，settled 消费）。 */\n\tconst pendingSessions = new Set<string>();\n\t/** 进行中的提炼请求（agent_start/shutdown 取消）。 */\n\tconst active = new Map<string, AbortController>();\n\t/** settled 后跑一轮的串行锁：同一时刻只跑一个 drain，防重入。 */\n\tlet draining: Promise<void> | undefined;\n\tlet accepting = true;\n\t/**\n\t * 本注册实例最近见到的事件会话 ID（busy 集合增删与 unmount 清理用）。\n\t * 一个调度器实例只收自己会话的事件。\n\t */\n\tlet boundSessionId: string | undefined;\n\n\t// ── turn_end：只登记待提炼会话（不重复采集——capture.ts 已把条目落库）──\n\tconst offTurnEnd = pi.on(\"turn_end\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tpendingSessions.add(boundSessionId);\n\t});\n\n\t// ── agent_start：本会话进前台忙集合并取消在途后台模型调用，普通任务优先 ──\n\tconst offAgentStart = pi.on(\"agent_start\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyAdd(deps.paoHome, boundSessionId);\n\t\tfor (const controller of active.values()) controller.abort();\n\t});\n\n\t// ── agent_settled：本会话退出前台忙，唤醒队列跑一轮 ────────────────────\n\tconst offSettled = pi.on(\"agent_settled\", (_event, ctx) => {\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyDelete(deps.paoHome, boundSessionId);\n\t\t// settled 的补扫已把本会话新条目落库（capture.ts 先挂）——登记待提炼。\n\t\tif (ctx.sessionManager.getBranch().length > 0) {\n\t\t\tpendingSessions.add(boundSessionId);\n\t\t}\n\t\tif (draining !== undefined) return;\n\t\tdraining = drainQueue(ctx).finally(() => {\n\t\t\tdraining = undefined;\n\t\t});\n\t});\n\n\t// ── session_shutdown：停止领取、取消请求；已提交部分随事务已落库 ──────\n\tconst offShutdown = pi.on(\"session_shutdown\", (event, ctx) => {\n\t\taccepting = false;\n\t\t// 本会话退出忙集合——它不再占前台，且 accepting=false 已停领。\n\t\tboundSessionId = ctx.sessionManager.getSessionId();\n\t\tforegroundBusyDelete(deps.paoHome, boundSessionId);\n\t\tfor (const controller of active.values()) controller.abort();\n\t\tconst cleanup = () => {\n\t\t\tpendingSessions.clear();\n\t\t\tactive.clear();\n\t\t};\n\t\t// 确认关机后再复位状态（与其他关闭者并发时状态不被提前清掉）。\n\t\tif (event.onConfirmedShutdown) event.onConfirmedShutdown(cleanup);\n\t\telse cleanup();\n\t});\n\n\t// 装配启动先恢复上次未完成任务（running 死进程/普通 failed 未超限 → pending）。\n\trecoverJobs(store, now());\n\n\t/**\n\t * 一轮队列：内存 pendingSessions ∪ 库内 pending extract 的 scopeKey 逐个领取。\n\t * 库内 pending 兜底（O03/F06）：A 会话建的 job 在 A 退出后，由装配同一 home\n\t * 的另一会话调度器扫描捞起续作；内存集合只是唤醒提示，不是待办清单。\n\t * 中途新 turn_end 登记的会话留给下一次 settled（本循环只拍一次快照）。\n\t * per-target 前忙集合非空即 return：本 home 任一会话前台忙时不新领（O03/F03/I02）。\n\t */\n\tasync function drainQueue(ctx: ExtensionContext): Promise<void> {\n\t\t// 先恢复（running 死进程/普通 failed 未超限 → pending）再跑——\n\t\t// 本进程被 agent_start 取消的 running job 也在同一轮被重取。\n\t\trecoverJobs(store, now());\n\t\t// 全 home 持久 pending 兜底：除内存集合外扫库内 pending extract scopeKey，\n\t\t// 没有该会话内存登记的消费方也能捞起（跨会话续作）。\n\t\tconst pendingRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT scope_key FROM extraction_jobs\n\t\t\t\t WHERE status = 'pending' AND job_kind = 'extract'`,\n\t\t\t)\n\t\t\t.all() as unknown as Array<{ scope_key: string }>;\n\t\tconst targets = new Set<string>([\n\t\t\t...pendingRows.map((row) => row.scope_key),\n\t\t\t...[...pendingSessions].map((sessionId) => `session:${sessionId}`),\n\t\t]);\n\t\tpendingSessions.clear();\n\t\tfor (const scopeKey of targets) {\n\t\t\tif (!accepting) return;\n\t\t\t// 本 home 本进程任一会话前台忙时不新领；库内 pending 留待空闲进程/下轮。\n\t\t\tif (foregroundBusySize(deps.paoHome) > 0) return;\n\t\t\ttry {\n\t\t\t\tawait runSessionJob(ctx, scopeKey);\n\t\t\t} catch (error) {\n\t\t\t\t// 单 job 失败不阻塞后续 job；失败原因已尽力落进 job.last_error。\n\t\t\t\tconsole.error(\n\t\t\t\t\t`[pao-memory] 提炼范围 ${scopeKey} 失败:`,\n\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\tasync function embedForSession(\n\t\tctx: ExtensionContext,\n\t\tscope: MemoryScope,\n\t\tsessionId: string,\n\t\tjobId: string,\n\t\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">,\n\t\tsignal: AbortSignal,\n\t): Promise<void> {\n\t\ttry {\n\t\t\tawait embedCurrentMemories({\n\t\t\t\thome: deps.paoHome,\n\t\t\t\tdb: store.db,\n\t\t\t\tprojectId: scope.projectId,\n\t\t\t\texecutionPath: ctx.cwd,\n\t\t\t\tledger,\n\t\t\t\tjobId,\n\t\t\t\trequestId: `embed:${jobId}:${now()}`,\n\t\t\t\tattribution: {\n\t\t\t\t\tkind: \"embed\",\n\t\t\t\t\tjobId,\n\t\t\t\t\tsourceSessionId: sessionId,\n\t\t\t\t\tprojectId: scope.projectId,\n\t\t\t\t\t...(scope.taskId === undefined ? {} : { taskId: scope.taskId }),\n\t\t\t\t},\n\t\t\t\tsignal,\n\t\t\t\t...(deps.embedding?.batchSize === undefined ? {} : { batchSize: deps.embedding.batchSize }),\n\t\t\t\t...(deps.embedding?.timeoutMs === undefined ? {} : { timeoutMs: deps.embedding.timeoutMs }),\n\t\t\t});\n\t\t} catch (error) {\n\t\t\tif (!signal.aborted) {\n\t\t\t\tconsole.error(\n\t\t\t\t\t`[pao-memory] 会话 ${sessionId} 向量嵌入失败:`,\n\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t}\n\n\t/**\n\t * 单个提炼范围的一次提炼：建/取 job → 领取 → 事务外组装 → 请求 → 提交 → 游标。\n\t * scopeKey 形如 `session:{sessionId}`；job 自带身份——续作别的会话 job 时\n\t * scope/sessionId/projectId 从 job.sourceScope 重建，不借当前消费会话身份（O03）。\n\t */\n\tasync function runSessionJob(ctx: ExtensionContext, scopeKey: string): Promise<void> {\n\t\t// job 身份：scopeKey 拆出 jobSessionId；scope 的 projectId 从 job.sourceScope 取。\n\t\tconst jobSessionId = scopeKey.startsWith(\"session:\") ? scopeKey.slice(\"session:\".length) : scopeKey;\n\t\tconst existingRow = store.db\n\t\t\t.prepare(`SELECT source_scope, status FROM extraction_jobs WHERE scope_key = ?`)\n\t\t\t.get(scopeKey) as { source_scope: string; status: string } | undefined;\n\t\tconst storedScope =\n\t\t\texistingRow === undefined\n\t\t\t\t? undefined\n\t\t\t\t: (JSON.parse(existingRow.source_scope) as { sessionId?: string; projectId?: string });\n\t\t// projectId 优先取 job.sourceScope 里的持久身份；本进程新登记的 job（尚无持久行）\n\t\t// 退回当前 ctx 的 resolveScope——这是唯一用「当前会话身份」的入口（建新 job 时）。\n\t\tconst jobScope: MemoryScope =\n\t\t\tstoredScope?.projectId !== undefined\n\t\t\t\t? { projectId: storedScope.projectId, sessionId: jobSessionId }\n\t\t\t\t: deps.resolveScope(ctx);\n\t\tconst job = createJob(store, {\n\t\t\tsourceScope: JSON.stringify({ sessionId: jobSessionId, projectId: jobScope.projectId }),\n\t\t\tscopeKey,\n\t\t\tcreatedAt: now(),\n\t\t});\n\t\tlet runnableJob = job;\n\t\tif (job.status === \"failed\") {\n\t\t\t// needs-reevaluation 不自动重放，但出现「上次尝试边界之后」的新来源时重开——\n\t\t\t// 新来源即重评依据（O03/I01）。游标只记已提交边界，已尝试未提交的游标后\n\t\t\t// 旧批不算新依据：判据用 last_error 里记录的 attempted_through 边界。\n\t\t\tconst attemptedThrough = attemptedThroughOf(job.lastError);\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tconst reopened =\n\t\t\t\tattemptedThrough !== undefined && afterCursorSources(sources, attemptedThrough).length > 0\n\t\t\t\t\t? reopenFailedJobForNewSources(store, { jobId: job.jobId, reopenedAt: now() })\n\t\t\t\t\t: undefined;\n\t\t\tif (reopened === undefined) {\n\t\t\t\tconst ledger = ledgerForJob(job.jobId);\n\t\t\t\tconst controller = new AbortController();\n\t\t\t\tactive.set(job.jobId, controller);\n\t\t\t\ttry {\n\t\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, job.jobId, ledger, controller.signal);\n\t\t\t\t} finally {\n\t\t\t\t\tactive.delete(job.jobId);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\trunnableJob = reopened;\n\t\t}\n\t\tif (job.status === \"done\") {\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tif (afterCursorSources(sources, job.cursor).length === 0) {\n\t\t\t\tconst ledger = ledgerForJob(job.jobId);\n\t\t\t\tconst controller = new AbortController();\n\t\t\t\tactive.set(job.jobId, controller);\n\t\t\t\ttry {\n\t\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, job.jobId, ledger, controller.signal);\n\t\t\t\t} finally {\n\t\t\t\t\tactive.delete(job.jobId);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst reopened = reopenDoneJob(store, { jobId: job.jobId, reopenedAt: now() });\n\t\t\tif (!reopened) return;\n\t\t\trunnableJob = reopened;\n\t\t}\n\t\tconst claimed = claimJob(store, {\n\t\t\tjobId: runnableJob.jobId,\n\t\t\townerProcess,\n\t\t\tclaimedAt: now(),\n\t\t});\n\t\tif (!claimed) return; // 其他存活进程持有，不抢。\n\t\tconst ledger = ledgerForJob(runnableJob.jobId);\n\n\t\tconst controller = new AbortController();\n\t\tactive.set(runnableJob.jobId, controller);\n\t\ttry {\n\t\t\t// 本次范围：游标之后的未提交来源（cursor 存最后处理的 sourceId；按序取其后）。\n\t\t\tconst sources = listSessionSources(store, jobSessionId);\n\t\t\tconst afterCursor = afterCursorSources(sources, claimed.job.cursor);\n\t\t\tif (afterCursor.length === 0) {\n\t\t\t\tcompleteJob(store, { jobId: runnableJob.jobId, completedAt: now() });\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t// 每段只覆盖一个来源任务；切任务后旧来源仍按它采集时记录的身份提炼。\n\t\t\tconst batches = groupSourcesByScope(jobScope, afterCursor);\n\t\t\t// 本轮组批时整个来源快照的末尾：重开判据以它区分「快照后真新增」\n\t\t\t// 与「失败批后已存在的其他任务批次」（O03/J01）。\n\t\t\tconst snapshotEnd = afterCursor[afterCursor.length - 1]!.sourceId;\n\t\t\tfor (const batch of batches) {\n\t\t\t\tconst { entries, excludedCount, failedSources } = await entriesFromSources(deps, batch.sources);\n\t\t\t\tconst last = batch.sources[batch.sources.length - 1]!;\n\t\t\t\tif (failedSources.length > 0) {\n\t\t\t\t\t// 读失败不是「没内容」：不越过这些来源的游标——记 failJob 含原因，\n\t\t\t\t\t// 停本 job 后续批；恢复后同一批重试，不重复已提交候选。\n\t\t\t\t\tfailJob(store, {\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\treason: `来源读取失败:${failedSources\n\t\t\t\t\t\t\t.map((source) => source.sourceId)\n\t\t\t\t\t\t\t.join(\",\")}（source_missing/段文件不可读，游标停在本批前）`,\n\t\t\t\t\t\tfailedAt: now(),\n\t\t\t\t\t});\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (entries.length === 0) {\n\t\t\t\t\t// 本段全部被排除（或理论空批）：排除是确定状态，推进游标避免空转。\n\t\t\t\t\tvoid excludedCount;\n\t\t\t\t\tadvanceCursor(store, {\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\tcursor: last.sourceId,\n\t\t\t\t\t\tadvancedAt: now(),\n\t\t\t\t\t});\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tconst related = relatedMemoriesForScope(store, batch.scope);\n\t\t\t\tconst output = await requestExtraction(\n\t\t\t\t\t{\n\t\t\t\t\t\t// 模型运行入口从 ctx 现取：装配期拿不到 modelRegistry（register 签名无\n\t\t\t\t\t\t// ctx），而每个事件回调的 ctx 自带注册表——比装配注入少一层绕路。\n\t\t\t\t\t\tmodelRegistry: ctx.modelRegistry,\n\t\t\t\t\t\tledger,\n\t\t\t\t\t\tpaoHome: deps.paoHome,\n\t\t\t\t\t\t...(deps.tierConfig === undefined ? {} : { tierConfig: deps.tierConfig }),\n\t\t\t\t\t\t...(deps.tierName === undefined ? {} : { tierName: deps.tierName }),\n\t\t\t\t\t\t// 外发许可：项目名只由可信执行路径决定（resolveMemoryOutboundContext）；\n\t\t\t\t\t\t// 续作别的会话 job 时这仍是「本 home 当前执行环境」的外发主体，语义不变。\n\t\t\t\t\t\toutboundProjects: [resolveMemoryOutboundContext(deps.paoHome, ctx.cwd).project],\n\t\t\t\t\t\t// 预算：scopeKey 与 extraction-jobs 同值；attemptKey 由\n\t\t\t\t\t\t// extract-model 按本次 requestId 派生——每次实际请求独立判据，\n\t\t\t\t\t\t// 同批重试不再复用上一条预留覆盖已发生费用。\n\t\t\t\t\t\tbudgetScopeKey: scopeKey,\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\t\tsourceSessionId: jobSessionId,\n\t\t\t\t\t\tentries,\n\t\t\t\t\t\trelatedMemories: related,\n\t\t\t\t\t\tsignal: controller.signal,\n\t\t\t\t\t},\n\t\t\t\t);\n\t\t\t\tconst shouldContinue = await finishJob(\n\t\t\t\t\trunnableJob,\n\t\t\t\t\tjobSessionId,\n\t\t\t\t\tbatch.scope,\n\t\t\t\t\tbatch.sources,\n\t\t\t\t\trelated,\n\t\t\t\t\toutput,\n\t\t\t\t\tcontroller.signal,\n\t\t\t\t\tsnapshotEnd,\n\t\t\t\t);\n\t\t\t\tif (!shouldContinue) return;\n\t\t\t}\n\t\t\tif (afterCursor.length > 0) {\n\t\t\t\tcompleteJob(store, { jobId: runnableJob.jobId, completedAt: now() });\n\t\t\t}\n\t\t} catch (error) {\n\t\t\tif (accepting) {\n\t\t\t\tfailJob(store, {\n\t\t\t\t\tjobId: runnableJob.jobId,\n\t\t\t\t\treason: error instanceof Error ? error.message : String(error),\n\t\t\t\t\tfailedAt: now(),\n\t\t\t\t});\n\t\t\t}\n\t\t\t// shutdown 期间的异常不另记失败——保持 running 由下次启动 recover。\n\t\t\tthrow error;\n\t\t} finally {\n\t\t\tif (accepting && !controller.signal.aborted) {\n\t\t\t\tawait embedForSession(ctx, jobScope, jobSessionId, runnableJob.jobId, ledger, controller.signal);\n\t\t\t\t// O06/J01：提炼 job 收尾登记本项目 organize 作业（embed 挂点同惯例）。\n\t\t\t\t// 登记失败不阻塞收尾——规整是空闲增量能力，不掩盖已提交结果。\n\t\t\t\ttry {\n\t\t\t\t\tdeps.onOrganizeCandidate?.(jobScope.projectId);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tconsole.error(\n\t\t\t\t\t\t`[pao-memory] 规整作业登记失败 ${jobScope.projectId}:`,\n\t\t\t\t\t\terror instanceof Error ? error.message : String(error),\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\t\t\tactive.delete(runnableJob.jobId);\n\t\t}\n\t}\n\n\t/**\n\t * 请求返回后的收尾：成功提交后推进游标；普通请求失败按既有上限恢复；\n\t * 候选命中请求前快照失效时保留未提交范围，标记需重新评估且不自动重放。\n\t * 返回 false 表示当前 job 不再处理后续任务段，避免越过未决来源。\n\t */\n\tasync function finishJob(\n\t\tjob: ExtractionJob,\n\t\t_sessionId: string,\n\t\tscope: MemoryScope,\n\t\tbatchSources: SourceRow[],\n\t\trelatedMemories: RelatedMemorySummary[],\n\t\toutput: ExtractModelOutput | { ok: false; error: { message: string } },\n\t\tsignal: AbortSignal,\n\t\tsnapshotEnd: string,\n\t): Promise<boolean> {\n\t\tif (\"error\" in output && output.ok === false) {\n\t\t\t// 契约级失败（invalid_input 等）：记失败但游标推进跳过本批——\n\t\t\t// 输入装配问题重试同样输入只会再失败，不占重试额度。\n\t\t\tfailJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `提炼输入被拒:${output.error.message}`,\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\tadvanceCursor(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\tcursor: batchSources[batchSources.length - 1].sourceId,\n\t\t\t\tadvancedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tconst result = output as ExtractModelOutput;\n\t\tconst last = batchSources[batchSources.length - 1];\n\t\tif (result.failure !== undefined) {\n\t\t\tif (signal.aborted) {\n\t\t\t\t// 本侧调度取消（agent_start/session_shutdown 前台优先）不是故障：\n\t\t\t\t// 交回 pending、保游标、不占 consecutive_failures 额度（O03/I03），\n\t\t\t\t// 下一轮空闲 drain 重新领取续跑未提交范围；已发生用量照实留痕\n\t\t\t\t// （releaseJob 不动 last_usage，另补一笔）。\n\t\t\t\treleaseJob(store, { jobId: job.jobId, releasedAt: now() });\n\t\t\t\tif (result.usage !== undefined) {\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(`UPDATE extraction_jobs SET last_usage = ? WHERE job_id = ?`)\n\t\t\t\t\t\t.run(JSON.stringify(result.usage), job.jobId);\n\t\t\t\t}\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\t// 请求/解析级失败：保留原因与已知用量，游标不推进（未提交范围重跑）。\n\t\t\tfailJob(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `${result.failure.stage}:${result.failure.message}`,\n\t\t\t\t...(result.usage === undefined ? {} : { lastUsage: JSON.stringify(result.usage) }),\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tconst committed = await commitExtractionCandidates(store, deps.service, {\n\t\t\tjobId: job.jobId,\n\t\t\tscope,\n\t\t\tcandidates: result.candidates,\n\t\t\trelatedMemories,\n\t\t\tsourceRefs: batchSources.map((source) => ({\n\t\t\t\tsourceId: source.sourceId,\n\t\t\t\tsessionId: source.sessionId,\n\t\t\t\tentryId: source.entryId,\n\t\t\t\teventType: source.eventType,\n\t\t\t\t...(source.projectId === undefined ? {} : { projectId: source.projectId }),\n\t\t\t\t...(source.taskId === undefined ? {} : { taskId: source.taskId }),\n\t\t\t})),\n\t\t\tnow: now(),\n\t\t});\n\t\tconst stale = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"stale_request_snapshot\",\n\t\t);\n\t\t// 语义冲突同口径不推进：候选与既有记忆同结论但理由/状态/类别不一致，\n\t\t// 需基于最新 related 重新评估，推进游标会丢未决差异。\n\t\tconst conflicts = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"semantic_conflict\",\n\t\t);\n\t\t// 停用来源命中同口径不推进（O03/F05）：stopped 是用户明确停用，同来源\n\t\t// 重放不能绕过另建 active 副本；该候选如实跳过留 job 由新一轮重评。\n\t\tconst restingStopped = committed.outcomes.filter(\n\t\t\t(outcome) => outcome.status === \"skipped\" && outcome.reason === \"source_resting_stopped\",\n\t\t);\n\t\tif (stale.length > 0 || conflicts.length > 0 || restingStopped.length > 0) {\n\t\t\tconst parts: string[] = [];\n\t\t\tif (stale.length > 0) {\n\t\t\t\tconst memories = [...new Set(stale.map((outcome) => `${outcome.memoryId}@rev${outcome.snapshotRevision}`))];\n\t\t\t\tconst sourceIds = [...new Set(stale.flatMap((outcome) => outcome.sourceIds))];\n\t\t\t\tparts.push(\n\t\t\t\t\t`请求前记忆快照已变化，需基于最新 related 重新评估；memory=${memories.join(\",\")}；sources=${sourceIds.join(\",\")}`,\n\t\t\t\t);\n\t\t\t}\n\t\t\tif (conflicts.length > 0) {\n\t\t\t\tconst details = conflicts.map((outcome) => {\n\t\t\t\t\tif (outcome.status !== \"skipped\" || outcome.reason !== \"semantic_conflict\") return \"\";\n\t\t\t\t\tconst changed = Object.entries(outcome.delta)\n\t\t\t\t\t\t.filter(([, changed]) => changed)\n\t\t\t\t\t\t.map(([field]) => field)\n\t\t\t\t\t\t.join(\"/\");\n\t\t\t\t\treturn `候选#${outcome.candidateIndex}↔${outcome.memoryId}(${changed})`;\n\t\t\t\t});\n\t\t\t\tparts.push(`语义冲突候选需重新评估；conflict=${details.join(\",\")}`);\n\t\t\t}\n\t\t\tif (restingStopped.length > 0) {\n\t\t\t\tconst memories = [...new Set(restingStopped.map((outcome) => outcome.memoryId))];\n\t\t\t\tparts.push(`同来源已停用记忆不复活，需重新评估；stopped=${memories.join(\",\")}`);\n\t\t\t}\n\t\t\t// attempted_through 记录本轮组批时整个来源快照的末尾（非失败批末尾）：\n\t\t\t// 重开判据靠它区分「快照后真新增」与「失败批后已存在的其他任务批次」（O03/J01）。\n\t\t\tparts.push(`attempted_through=${snapshotEnd}`);\n\t\t\tmarkJobNeedsReevaluation(store, {\n\t\t\t\tjobId: job.jobId,\n\t\t\t\treason: `${parts.join(\"；\")}；已提交候选=${committed.submitted}`,\n\t\t\t\t...(result.usage === undefined ? {} : { lastUsage: JSON.stringify(result.usage) }),\n\t\t\t\tfailedAt: now(),\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\tadvanceCursor(store, {\n\t\t\tjobId: job.jobId,\n\t\t\tcursor: last.sourceId,\n\t\t\tadvancedAt: now(),\n\t\t});\n\t\treturn true;\n\t}\n\n\t/**\n\t * 从 needs-reevaluation 的 last_error 里取上次尝试到的来源边界\n\t * （finishJob 写入的 `attempted_through=<sourceId>`）。没有该标记的\n\t * failed job 返回 undefined——无法区分新来源与已尝试旧批，保守不重开。\n\t */\n\tfunction attemptedThroughOf(lastError: string | undefined): string | undefined {\n\t\tif (lastError === undefined) return undefined;\n\t\tconst match = /(?:^|；)attempted_through=([^；\\s]+)/.exec(lastError);\n\t\treturn match?.[1];\n\t}\n\n\t/** 取游标之后的来源（cursor 是最后处理的 sourceId；按序取其后）。 */\n\tfunction afterCursorSources(sources: SourceRow[], cursor: string | undefined): SourceRow[] {\n\t\tif (cursor === undefined) return sources;\n\t\tconst index = sources.findIndex((source) => source.sourceId === cursor);\n\t\treturn index === -1 ? sources : sources.slice(index + 1);\n\t}\n\n\treturn () => {\n\t\taccepting = false;\n\t\toffTurnEnd();\n\t\toffSettled();\n\t\toffAgentStart();\n\t\toffShutdown();\n\t\tfor (const controller of active.values()) controller.abort();\n\t\tactive.clear();\n\t\tpendingSessions.clear();\n\t\t// 本实例卸载时退出前台忙集合——不留陈旧占用挡住同 home 其他会话。\n\t\tif (boundSessionId !== undefined) foregroundBusyDelete(deps.paoHome, boundSessionId);\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * pao 记忆模块桶（M2-05,架构 §18.5；S1-14 内置记忆接线）。\n *\tsearchArtifacts,\n\tunlinkArtifactRefsForMemories,\n} from \"./artifacts.ts\";\nexport {\n\ttype CheckMemoryJobBudgetInputArchiveBackupJobScope,\n\tcheckMemoryJobBudgettype BackupManifestcommittedMemoryBudgettype BackupSegmentEntryMEMORY_BUDGET_CONFIGtype CreateMemoryBackupInput,\n\ttype MemoryBudgetConfigCreateMemoryBackupResulttype MemoryJobBudgetVerdictcreateMemoryBackupreadMemoryBudgetConfigparseArchiveJobScopereleaseMemoryJobBudgettype RestoreMemoryBackupInputremainingMemoryBudgettype RestoreMemoryBackupResultsettleMemoryJobBudgetrestoreMemoryBackup,\n} from \"./budget.tsbackup.ts\";CaptureDepsCheckMemoryJobBudgetInput,\n\tcheckMemoryJobBudget,\n\tcommittedMemoryBudget,\n\tMEMORY_BUDGET_CONFIGCaptureEntryResultCaptureHandleMemoryJobBudgetVerdict,\n\treadMemoryBudgetConfig,\n\treleaseMemoryJobBudgetcreateCaptureregisterCapturecapture.tsCancelCommitmentInput,\n\ttype