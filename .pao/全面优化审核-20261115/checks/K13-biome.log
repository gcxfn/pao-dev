},{"diffOp":{"equal":{"range":[2073,2097]}}},{"diffOp":{"insert":{"range":[391,395]}}},{"diffOp":{"equal":{"range":[2097,2111]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,395]}}},{"diffOp":{"equal":{"range":[2111,2237]}}},{"diffOp":{"insert":{"range":[973,977]}}},{"diffOp":{"equal":{"range":[789,795]}}},{"equalLines":{"line_count":49}},{"diffOp":{"equal":{"range":[2237,2263]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2263,2272]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2272,2291]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2291,2405]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[2405,2411]}}},{"diffOp":{"equal":{"range":[2411,2422]}}},{"equalLines":{"line_count":113}},{"diffOp":{"equal":{"range":[2422,2485]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2485,2525]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2525,2537]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2537,2552]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2552,2567]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2567,2581]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[2581,2584]}}},{"diffOp":{"insert":{"range":[2405,2411]}}},{"diffOp":{"equal":{"range":[2584,2630]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[2630,2682]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"equal":{"range":[2682,2736]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[2736,2742]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\candidates.ts"},"span":null,"sourceCode":"/**\n * 受控自进化局部候选生成（S8-07）。\n *\n * 职责：把已登记 baseVersion 复制到 `evolution/candidates/<candidateId>/`，\n * 经 deps 注入的模型路由请求修改，按文件逐项应用并比较实际正文，未改动返回 `no_change`。\n *\n * 契约（S8 任务书 §5）：\n * - 输入 problemId、resourceId、baseVersion、允许修改文件清单、开发样例与具体失败、\n *   任务预算、AbortSignal。\n * - 目录用 `resourceId.replace(/:/g,\"_\")` 与 candidateId。\n * - 经 deps 注入 `{modelRegistry, ledger, tierConfig/paoHome, tierName 缺省 \"fast\"}`，\n *   照 extract-model.ts 模式调 `modelRegistry.find`+`streamSimple`。\n * - 先记 attempt custom entry 再 `appendUsage`；预算门 `checkMemoryJobBudget`\n *   （判据 `memory-job:{jobId}:{kind}:cand-{已存候选数}`——每次生成独立预留，\n *   预留/结算/释放复用 usage/budget-ledger）。\n * - 模型只输出允许文件的编辑操作（文件清单内）；返回按文件逐项应用并比较实际正文；\n *   未改动返回 `no_change`。\n * - 输出 `changed`（candidateId、文件差异、理由、usageRefs）或 `no_change`；\n *   相同差异不重复付费验证。\n * - 绑定 problemId/resourceId/baseVersion/testPlanId，存 evolution_candidates\n *   （status='proposed'）。\n * - 每问题最多自动生成 3 个不同候选；开发样例失败可驱动后续局部修改，\n *   保留组失败结束本轮且答案不回灌生成器；范围核对走 `assertCandidateWithinScope`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudget, settleMemoryJobBudget, releaseMemoryJobBudget } from \"../memory/budget.ts\";\nimport { checkOutbound, loadOutboundConfig, type OutboundConfig } from \"../knowledge/outbound.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport { loadTierConfig, resolveTierConfigPath, type TierConfig, tierNameToModel } from \"../routing/config.ts\";\nimport { assertCandidateWithinScope } from \"./policy.ts\";\nimport { getResource } from \"./resources.ts\";\nimport { readResourceVersion } from \"./versions.ts\";\nimport type {\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n} from \"./types.ts\";\nimport type { MemoryError } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 依赖注入面\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `proposeCandidate` 的依赖。\n * - `modelRegistry`：现有模型运行入口（注入 `Pick<ModelRegistry,\"find\"|\"streamSimple\">`，\n *   测试可换假模型，不读全局）。\n * - `ledger`：记账会话（`Pick<SessionManager,\"appendUsage\"|\"appendCustomEntry\">`）。\n * - `paoHome` + `tierName`：档位解析（缺省 \"fast\"）；`tierConfig` 也可直接注入跳过文件读取。\n * - `budgetPaoHome`：预算门检查的 PAO_HOME（缺省与 paoHome 相同；测试可分开）。\n */\nexport interface ProposeCandidateDeps {\n\tmodelRegistry: Pick<ModelRegistry, \"find\" | \"streamSimple\">;\n\tledger: Pick<SessionManager, \"appendUsage\" | \"appendCustomEntry\">;\n\t/** PAO_HOME（解析 $PAO_HOME/pao配置/档位.json）；与 tierConfig 二选一。 */\n\tpaoHome?: string;\n\t/** 已加载的档位配置（测试注入，跳过文件读取）。 */\n\ttierConfig?: TierConfig;\n\t/** 候选生成用档位名；缺省 \"fast\"。 */\n\ttierName?: string;\n\t/** 预算门检查的 PAO_HOME（缺省与 paoHome 相同）。 */\n\tbudgetPaoHome?: string;\n\t/** 输出 token 上限；缺省 4096。 */\n\tmaxTokens?: number;\n\t/** 单次候选生成的预留金额（美元）；缺省 0.05。 */\n\tbudgetAmount?: number;\n\t/** 任务预算（调用方传入；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 本次提示涉及资料的项目名（外发许可判定用；由编排传可信值，不由模型自报；缺省不发请求）。 */\n\toutboundProjects?: string[];\n\t/** 外发许可配置（测试注入；缺省 loadOutboundConfig(budgetPaoHome)）。 */\n\toutbound?: OutboundConfig;\n}\n\nconst DEFAULT_TIER = \"fast\";\nconst DEFAULT_MAX_TOKENS = 4096;\nconst DEFAULT_BUDGET_AMOUNT = 0.05;\nconst MAX_CANDIDATES_PER_PROBLEM = 3;\n/** O10/E10：每问题付费生成尝试上限（no_change/duplicate/解析失败也计）。 */\nconst MAX_PAID_ATTEMPTS_PER_PROBLEM = 3;\n\n// ════════════════════════════════════════════════════════════════════════\n// 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `proposeCandidate` 的输入。 */\nexport interface ProposeCandidateInput {\n\t/** 已分类的问题 ID。 */\n\tproblemId: string;\n\t/** 目标资源。 */\n\tresourceId: string;\n\t/** 基础版本（必须与 problem.baseVersion 一致）。 */\n\tbaseVersion: string;\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 允许修改的文件清单（相对资源根；空数组 = 允许全部资源内文件）。 */\n\tallowedFiles: string[];\n\t/** 开发样例与具体失败（喂给模型的上下文；不含保留组）。 */\n\tdevCases: Array<{\n\t\t/** 样例描述/输入。 */\n\t\tinput: string;\n\t\t/** 具体失败（实际行为/错误信息）。 */\n\t\tfailure: string;\n\t\t/** 期望行为。 */\n\t\texpected?: string;\n\t}>;\n\t/** 任务预算（可选；缺省走 checkMemoryJobBudget）。 */\n\tbudget?: { jobId: string; kind: string };\n\t/** 取消信号。 */\n\tsignal?: AbortSignal;\n\t/** 候选生成时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\n/** `proposeCandidate` 的输出。 */\nexport type ProposeCandidateResult =\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"changed\";\n\t\t\t/** 新候选 ID。 */\n\t\t\tcandidateId: string;\n\t\t\t/** 实际文件差异。 */\n\t\t\tdiffs: EvolutionFileDiff[];\n\t\t\t/** 改动理由（模型给出）。 */\n\t\t\trationale: string;\n\t\t\t/** 本次生成关联的账本/请求引用。 */\n\t\t\tusageRefs: string[];\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"no_change\";\n\t\t\t/** 无改动原因。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"rejected\";\n\t\t\t/** 拒绝原因（范围越界/预算不足等）。 */\n\t\t\treason: string;\n\t  }\n\t| {\n\t\t\tok: true;\n\t\t\tstatus: \"duplicate\";\n\t\t\t/** 与已有候选差异相同。 */\n\t\t\tcandidateId: string;\n\t\t\treason: string;\n\t  };\n\n// ════════════════════════════════════════════════════════════════════════\n// 提示词\n// ════════════════════════════════════════════════════════════════════════\n\nconst CANDIDATE_PROMPT = `你是受控资源改进器。根据给定的问题描述和开发样例，对指定资源文件提出局部修改。\n\n# 输出要求\n只输出一个 JSON 对象（可以包在 \\`\\`\\`json 代码块里），不要输出其他解释文字。对象格式：\n{\n  \"rationale\": \"改动理由（为什么这样改）\",\n  \"edits\": [\n    {\n      \"path\": \"资源根内相对路径（POSIX 分隔符）\",\n      \"action\": \"edit|create|delete\",\n      \"content\": \"新文件完整正文（create 时必填；edit 时给出修改后的完整正文）\",\n      \"diff\": \"unified diff 正文（edit/delete 时可选）\"\n    }\n  ]\n}\n- path 必须在允许修改的文件清单内。\n- 只输出允许文件的编辑操作；不要改清单外的文件。\n- 没有可改进内容时输出 {\"rationale\": \"无需改动\", \"edits\": []}。\n\n# 允许修改的文件清单\n{ALLOWED_FILES}\n\n# 基础资源正文（baseVersion 当前内容；在其上提局部修改）\n{BASE_FILES}\n\n# 问题描述\n{PROBLEM}\n\n# 开发样例与具体失败\n{DEV_CASES}`;\n\n// ════════════════════════════════════════════════════════════════════════\n// 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/** 递归列出目录内全部文件（候选目录只做遍历核对；统一收拢见 versions.ts listResourceFiles）。 */\nfunction listFilesRecursive(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 复制资源根到候选目录。\n * O12/E12：源可以是目录或单个文件（文件型资源根 `工作流/{name}.md` 的快照\n * 版本目录里是 `<versionId>/<basename>` 单文件，但 baseVersion 源本身亦可能\n * 直接是单文件路径）——statSync 分派，文件形态复制为 `<dest>/<basename>`。\n */\nfunction copyDir(src: string, dest: string): void {\n\tmkdirSync(dest, { recursive: true });\n\tconst stat = statSync(src);\n\tif (stat.isFile()) {\n\t\tcopyFileSync(src, join(dest, basename(src)));\n\t\treturn;\n\t}\n\tfor (const entry of readdirSync(src, { withFileTypes: true })) {\n\t\tconst srcPath = join(src, entry.name);\n\t\tconst destPath = join(dest, entry.name);\n\t\tif (entry.isDirectory()) {\n\t\t\tcopyDir(srcPath, destPath);\n\t\t} else if (entry.isFile()) {\n\t\t\tcopyFileSync(srcPath, destPath);\n\t\t}\n\t}\n}\n\n/** 从 AssistantMessage 提取全部文本块。 */\nfunction messageText(message: { content: Array<{ type: string; text?: string }> }): string {\n\treturn message.content\n\t\t.filter((block): block is { type: \"text\"; text: string } => block.type === \"text\")\n\t\t.map((block) => block.text)\n\t\t.join(\"\");\n}\n\n/** 取响应文本中的 JSON 对象本体。 */\nfunction extractJsonObject(text: string): Record<string, unknown> | undefined {\n\tconst fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n\tconst candidates = fenced ? [fenced[1]] : [text];\n\tfor (const candidate of candidates) {\n\t\tconst start = candidate.indexOf(\"{\");\n\t\tconst end = candidate.lastIndexOf(\"}\");\n\t\tif (start === -1 || end <= start) continue;\n\t\ttry {\n\t\t\tconst parsed: unknown = JSON.parse(candidate.slice(start, end + 1));\n\t\t\tif (typeof parsed === \"object\" && parsed !== null && !Array.isArray(parsed)) {\n\t\t\t\treturn parsed as Record<string, unknown>;\n\t\t\t}\n\t\t} catch {\n\t\t\t// 继续尝试下一段。\n\t\t}\n\t}\n\treturn undefined;\n}\n\n/** 应用文件差异到候选目录，返回实际差异清单（diff.path 含资源根前缀，供 assertCandidateWithinScope 核对）。 */\nfunction applyEdits(\n\tcandidateDir: string,\n\tbaseDir: string,\n\tedits: Array<{ path: string; action: string; content?: string; diff?: string }>,\n\tallowedFiles: string[],\n\tresource: EvolutionResource,\n): { diffs: EvolutionFileDiff[]; changed: boolean } {\n\tconst diffs: EvolutionFileDiff[] = [];\n\tlet changed = false;\n\tfor (const edit of edits) {\n\t\t// diff.path 存「资源根内相对路径」（EvolutionFileDiff 契约）。\n\t\tconst normalizedPath = edit.path.replace(/\\\\/g, \"/\");\n\t\t// 路径逃逸硬拦截：含 `..` 段或绝对路径的 edit.path 不能 join 出候选目录外。\n\t\t// （白名单核对在 allowedFiles 非空时做，但 allowedFiles 可空——此处兜底。）\n\t\tif (normalizedPath.split(\"/\").includes(\"..\") || normalizedPath.startsWith(\"/\")) {\n\t\t\tcontinue;\n\t\t}\n\t\tconst targetPath = join(candidateDir, normalizedPath);\n\t\tconst basePath = join(baseDir, normalizedPath);\n\t\tif (edit.action === \"create\") {\n\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\twriteFileSync(targetPath, edit.content ?? \"\", \"utf8\");\n\t\t\tdiffs.push({ path: normalizedPath, kind: \"create\", newContent: edit.content });\n\t\t\tchanged = true;\n\t\t} else if (edit.action === \"edit\") {\n\t\t\tif (!existsSync(basePath)) continue; // 基线无此文件，跳过\n\t\t\tconst oldContent = readFileSync(basePath, \"utf8\");\n\t\t\tconst newContent = edit.content ?? oldContent;\n\t\t\tif (newContent !== oldContent) {\n\t\t\t\tmkdirSync(dirname(targetPath), { recursive: true });\n\t\t\t\twriteFileSync(targetPath, newContent, \"utf8\");\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"edit\", diff: edit.diff, newContent });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t} else if (edit.action === \"delete\") {\n\t\t\tif (existsSync(targetPath)) {\n\t\t\t\trmSync(targetPath, { recursive: true, force: true });\n\t\t\t\tdiffs.push({ path: normalizedPath, kind: \"delete\" });\n\t\t\t\tchanged = true;\n\t\t\t}\n\t\t}\n\t}\n\treturn { diffs, changed };\n}\n\n/**\n * 比较两个候选的差异是否相同：逐字段精确比较（path/kind/newContent），\n * 排序后逐对相等即同差异。O14：diffs 已在内存，不再为相等判断另算哈希\n * （versionId 的 sha256 是公开契约，与本函数无关）。\n */\nfunction diffsEqual(a: EvolutionFileDiff[], b: EvolutionFileDiff[]): boolean {\n\tconst key = (diffs: EvolutionFileDiff[]) =>\n\t\tdiffs\n\t\t\t.map((d) => ({ path: d.path, kind: d.kind, newContent: d.newContent ?? \"\" }))\n\t\t\t.sort((x, y) => x.path.localeCompare(y.path) || x.kind.localeCompare(y.kind));\n\tconst ka = key(a);\n\tconst kb = key(b);\n\tif (ka.length !== kb.length) return false;\n\treturn ka.every(\n\t\t(item, index) =>\n\t\t\titem.path === kb[index]!.path && item.kind === kb[index]!.kind && item.newContent === kb[index]!.newContent,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// proposeCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 生成局部候选：复制 baseVersion → 模型路由请求修改 → 应用差异 → 存 evolution_candidates。\n *\n * 每问题最多自动生成 3 个不同候选；相同差异不重复付费验证。\n * 开发样例失败可驱动后续局部修改；保留组失败结束本轮且答案不回灌生成器。\n */\nexport async function proposeCandidate(\n\tstore: MemoryStore,\n\tdeps: ProposeCandidateDeps,\n\tinput: ProposeCandidateInput,\n): Promise<MemoryResult<ProposeCandidateResult>> {\n\t// 1. 校验 problem：必须 classified，且 resourceId/baseVersion 一致。\n\t// O10/E05：SELECT 扩列——提示词要放真实问题摘要/原因/预期/实际/类别/证据，\n\t// 不再只放 ID。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, kind, action, summary, reason, expected_behavior, actual_behavior,\n\t\t\t        evidence_refs_json, resource_id, base_version, paid_attempts\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| {\n\t\t\t\tproblem_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tkind: string;\n\t\t\t\taction: string | null;\n\t\t\t\tsummary: string;\n\t\t\t\treason: string | null;\n\t\t\t\texpected_behavior: string;\n\t\t\t\tactual_behavior: string;\n\t\t\t\tevidence_refs_json: string;\n\t\t\t\tresource_id: string | null;\n\t\t\t\tbase_version: string | null;\n\t\t\t\tpaid_attempts: number;\n\t\t  }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\t// problem 允许 classified（首次）或 candidate（已有候选，继续生成至 3 个上限）。\n\tif (problemRow.status !== \"classified\" && problemRow.status !== \"candidate\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 或 candidate 才能生成候选`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的资源与输入不一致`, input.resourceId);\n\t}\n\tif (problemRow.base_version !== input.baseVersion) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 登记的 baseVersion 与输入不一致`, input.problemId);\n\t}\n\n\t// 2. 校验资源已登记，且未超出每问题 3 候选上限。\n\tconst resource = getResource(store, input.resourceId);\n\tif (!resource.ok) return resource;\n\tconst existingCount = store.db\n\t\t.prepare(`SELECT COUNT(*) AS n FROM evolution_candidates WHERE problem_id = ?`)\n\t\t.get(input.problemId) as { n: number };\n\tif (existingCount.n >= MAX_CANDIDATES_PER_PROBLEM) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 已达候选上限 ${MAX_CANDIDATES_PER_PROBLEM}，不再自动生成`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\n\t// 2b. O10/E10 生成前停止条件（不发模型请求、不占预算的业务拒绝）：\n\t// - 资源已停用自动进化 → 拒绝，不新领候选；\n\t// - 该 problem 任一已有验证的保留组有 failed/incomplete 判定 → 本轮终止，\n\t//   不再生成（保留组失败结束本轮，答案不回灌生成器）；\n\t// - 本轮已取消（编排传 signal 中止）→ 拒绝。\n\tif (!resource.autoEvolutionEnabled) {\n\t\treturn { ok: true, status: \"rejected\", reason: `资源 ${input.resourceId} 已停用自动进化` };\n\t}\n\t{\n\t\tconst validationRows = store.db\n\t\t\t.prepare(`SELECT case_results_json FROM evolution_validations WHERE problem_id = ?`)\n\t\t\t.all(input.problemId) as Array<{ case_results_json: string }>;\n\t\tfor (const row of validationRows) {\n\t\t\tlet cases: Array<{ caseId?: string; verdict?: string }>;\n\t\t\ttry {\n\t\t\t\tcases = JSON.parse(row.case_results_json) as Array<{ caseId?: string; verdict?: string }>;\n\t\t\t} catch {\n\t\t\t\tcontinue; // 历史行解析失败不挡路；真实失败行按 JSON 判。\n\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (typeof c.caseId === \"string\" && c.caseId.startsWith(\"holdout\") && c.verdict !== undefined && c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\tstatus: \"rejected\",\n\t\t\t\t\t\treason: `问题 ${input.problemId} 已有验证的保留组判定 ${c.verdict}（${c.caseId}），本轮终止，不再生成`,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn { ok: true, status: \"rejected\", reason: `本轮已取消:${String(input.signal.reason ?? \"aborted\")}` };\n\t}\n\t// O10/E10：付费尝试上限——no_change/duplicate/解析失败也消耗一次真实\n\t// 请求预留。与 evolution_candidates 行数硬上限（3）分开计数：候选行只\n\t// 记「产出了候选」的成功生成，付费尝试记「预留成功的真实模型请求」。\n\tif (problemRow.paid_attempts >= MAX_PAID_ATTEMPTS_PER_PROBLEM) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"rejected\",\n\t\t\treason: `问题 ${input.problemId} 付费生成尝试已达上限 ${MAX_PAID_ATTEMPTS_PER_PROBLEM}（已消耗 ${problemRow.paid_attempts} 次），不再发请求`,\n\t\t};\n\t}\n\n\t// 3. 档位解析 + 模型路由（提前到预算门之前：模型找不到/未授权外发的\n\t// 请求不产生预留，不对空气结算）。\n\tconst budgetJobId = input.budget?.jobId ?? `evo-${input.problemId}`;\n\tconst budgetKind = input.budget?.kind ?? \"candidate\";\n\t// requestId 一次生成、attempt 记账与预算判据两处共用：每次实际请求独立\n\t// 判据——no_change/解析失败不产生新候选，但费用照结各自一条（F01/R2）。\n\tconst requestId = `${budgetJobId}:candidate:${randomUUID()}`;\n\tconst attemptKey = requestId;\n\tconst budgetPaoHome = deps.budgetPaoHome ?? deps.paoHome;\n\tif (!budgetPaoHome) {\n\t\treturn fail(\"invalid_input\", \"缺预算门 PAO_HOME：deps.budgetPaoHome 或 deps.paoHome 至少给一个\");\n\t}\n\tlet resolved: { model: string; thinkingLevel: ModelThinkingLevel };\n\ttry {\n\t\tif (!deps.tierConfig && !deps.paoHome) {\n\t\t\treturn fail(\"invalid_input\", \"缺档位来源：tierConfig 或 paoHome 至少给一个\");\n\t\t}\n\t\tconst config = deps.tierConfig ?? loadTierConfig(resolveTierConfigPath(deps.paoHome!));\n\t\tresolved = tierNameToModel(config, deps.tierName ?? DEFAULT_TIER);\n\t} catch (error) {\n\t\treturn fail(\"invalid_input\", `档位解析失败:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\tconst slash = resolved.model.indexOf(\"/\");\n\tconst provider = slash === -1 ? resolved.model : resolved.model.slice(0, slash);\n\tconst modelId = slash === -1 ? \"\" : resolved.model.slice(slash + 1);\n\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\", `档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`);\n\t}\n\n\t// 4. 外发许可门（预算门之前）：提示含开发样例输入与失败描述，项目名由\n\t// 编排传可信值（deps.outboundProjects），不授权不发请求也不占预算。\n\t// 编排未声明项目时按「未知」处理：checkOutbound 对外发许可文件里的\n\t// 「未知」条目同样判定——有显式授权放行，无授权（含缺文件）拒绝。\n\t{\n\t\tconst outbound = deps.outbound ?? loadOutboundConfig(budgetPaoHome);\n\t\tconst permission = checkOutbound(deps.outboundProjects ?? [], outbound);\n\t\tif (!permission.allowed) {\n\t\t\treturn { ok: true, status: \"rejected\", reason: `禁外发:项目 ${permission.blocked.join(\"、\")} 未获有效许可` };\n\t\t}\n\t}\n\n\t// 5. 预算门：checkMemoryJobBudget。attemptKey = 本次 requestId（每次实际\n\t// 请求一条独立预留/结算）。unlimited 直通不落预留 → 结算/释放只对实际\n\t// 预留执行（budgetReserved），不对空气结算（F08/R7）。\n\tconst budgetVerdict = await checkMemoryJobBudget({\n\t\tpaoHome: budgetPaoHome,\n\t\tjobId: budgetJobId,\n\t\tjobKind: budgetKind,\n\t\tscopeKey: `${input.resourceId}:${input.baseVersion}`,\n\t\tattemptKey,\n\t\t金额: deps.budgetAmount ?? DEFAULT_BUDGET_AMOUNT,\n\t\t现在: input.createdAt ?? new Date().toISOString(),\n\t});\n\tif (!budgetVerdict.ok) {\n\t\treturn { ok: true, status: \"rejected\", reason: `预算门拒绝:${budgetVerdict.reason}` };\n\t}\n\tconst budgetReserved = budgetVerdict.unlimited !== true;\n\t// O10/E10：预留成功 = 一次真实付费尝试——递增 paid_attempts（同步事务，\n\t// 与请求成败无关；后续 no_change/duplicate/解析失败都保留这笔计数）。\n\tstore.db\n\t\t.prepare(`UPDATE evolution_problems SET paid_attempts = paid_attempts + 1, updated_at = ? WHERE problem_id = ?`)\n\t\t.run(input.createdAt ?? new Date().toISOString(), input.problemId);\n\n\t// 6. 读 baseVersion 正文（O10/E05：模型可见原正文）+ 复制到候选目录。\n\t// readResourceVersion 对缺失版本返回 source_missing，替掉原裸 existsSync；\n\t// 版本目录不完整（无 publish 凭据）仍可读——available=false 不挡生成。\n\tconst baseContent = readResourceVersion(store, {\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.baseVersion,\n\t\tpaoHome: budgetPaoHome,\n\t});\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome, budgetJobId, budgetKind, new Date().toISOString(), baseContent.error.message, attemptKey);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\n\t\t// source_missing（可区别于请求级 unavailable），不把定位码压成泛化。\n\t\treturn fail(baseContent.error.code, `基线版本读取失败:${baseContent.error.message}`, input.baseVersion);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst candidateId = `cand-${randomUUID().slice(0, 8)}`;\n\tconst candidateDir = join(evolutionPaths(budgetPaoHome).candidates, dirSafeResourceId, candidateId);\n\tconst baseDir = join(evolutionPaths(budgetPaoHome).versions, dirSafeResourceId, input.baseVersion);\n\tcopyDir(baseDir, candidateDir);\n\n\tdeps.ledger.appendCustomEntry(\"pao-evolution-candidate-attempt\", {\n\t\trequestId,\n\t\tjobId: budgetJobId,\n\t\tproblemId: input.problemId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: input.baseVersion,\n\t\tcandidateId,\n\t});\n\n\t// 6. 构造提示词（开发样例可给模型，保留组不给）。\n\t// O10/E05：{BASE_FILES} 段放 baseVersion 文件正文——allowedFiles 非空时\n\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0\n\t\t? input.allowedFiles.join(\"\\n\")\n\t\t: \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\n\t\tbaseContent.files.length === 0\n\t\t\t? \"（baseVersion 目录为空）\"\n\t\t\t: baseContent.files\n\t\t\t\t\t.filter((file) => input.allowedFiles.length === 0 || allowedSet.has(file.path))\n\t\t\t\t\t.map((file) => `--- ${file.path} ---\\n${file.content}`)\n\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) => `--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\n\tconst problemDesc = [\n\t\t`问题 ID:${input.problemId}`,\n\t\t`类别:${problemRow.kind}`,\n\t\t`摘要:${problemRow.summary}`,\n\t\t...(problemRow.reason !== null ? [`原因:${problemRow.reason}`] : []),\n\t\t`预期行为:${problemRow.expected_behavior}`,\n\t\t`实际行为:${problemRow.actual_behavior}`,\n\t\t`证据引用:${problemEvidence}`,\n\t\t`资源:${input.resourceId}`,\n\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\n\t\t.replace(\"{DEV_CASES}\", devCasesText);\n\n\tconst context: Context = {\n\t\tsystemPrompt: prompt,\n\t\tmessages: [{ role: \"user\", content: \"请输出候选修改 JSON。\", timestamp: Date.now() }],\n\t};\n\n\t// 7. 发起模型请求。\n\tlet message;\n\ttry {\n\t\tmessage = await deps.modelRegistry\n\t\t\t.streamSimple(model, context, {\n\t\t\t\tmaxTokens: deps.maxTokens ?? DEFAULT_MAX_TOKENS,\n\t\t\t\t...(resolved.thinkingLevel !== \"off\" ? { reasoning: resolved.thinkingLevel } : {}),\n\t\t\t\t...(input.signal ? { signal: input.signal } : {}),\n\t\t\t})\n\t\t\t.result();\n\t} catch (error) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tundefined,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求异常:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求异常:${error instanceof Error ? error.message : String(error)}`);\n\t}\n\n\t// 记账。\n\tconst usage: Usage | undefined = message.usage.totalTokens > 0 ? message.usage : undefined;\n\tdeps.ledger.appendUsage(\n\t\t\"evolution_candidate\",\n\t\tmessage.provider,\n\t\tmessage.responseModel ?? message.model,\n\t\tmessage.usage,\n\t\t`kind=candidate jobId=${budgetJobId} problemId=${input.problemId} requestId=${requestId}${\n\t\t\tusage === undefined ? \" 用量未返回\" : \"\"\n\t\t}`,\n\t);\n\n\tif (message.stopReason === \"error\" || message.stopReason === \"aborted\") {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", `候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`);\n\t}\n\n\t// 8. 解析模型输出。\n\tconst parsed = extractJsonObject(messageText(message));\n\tif (parsed === undefined) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"响应不是可解析的 JSON 对象\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\", \"候选生成响应不是可解析的 JSON 对象\");\n\t}\n\tconst rationale = typeof parsed.rationale === \"string\" ? parsed.rationale : \"无改动理由\";\n\tconst edits = Array.isArray(parsed.edits) ? parsed.edits : [];\n\tif (edits.length === 0) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"模型返回空编辑列表\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"模型返回空编辑列表\" };\n\t}\n\n\t// 白名单核对：模型给的 edit.path 必须在 allowedFiles 内（资源根内相对路径）。\n\t// 越界先拒，不进入 applyEdits。\n\tif (input.allowedFiles.length > 0) {\n\t\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\t\tfor (const edit of edits) {\n\t\t\tconst normalized = (edit.path ?? \"\").replace(/\\\\/g, \"/\");\n\t\t\tif (!allowedSet.has(normalized)) {\n\t\t\t\tif (budgetReserved) {\n\t\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\t\tbudgetJobId,\n\t\t\t\t\t\tbudgetKind,\n\t\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t\t`edit.path ${normalized} 不在允许清单`,\n\t\t\t\t\t\tattemptKey,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn { ok: true, status: \"rejected\", reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）` };\n\t\t\t}\n\t\t}\n\t}\n\n\t// 9. 应用编辑并核对范围。\n\tconst { diffs, changed } = applyEdits(candidateDir, baseDir, edits, input.allowedFiles, resource);\n\tif (!changed) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\"应用后无实际改动\",\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"no_change\", reason: \"应用后无实际改动\" };\n\t}\n\n\t// 范围核对：assertCandidateWithinScope 需要「相对 PAO_HOME」的路径；\n\t// 给 diff.path 临时加资源根前缀供核对，不改对外返回的契约（资源根内相对路径）。\n\tconst scopeDiffs = diffs.map((d) => ({\n\t\t...d,\n\t\tpath: `${resource.relativeRoot}/${d.path}`.replace(/\\/+/g, \"/\"),\n\t}));\n\tconst scopeCheck = assertCandidateWithinScope({\n\t\tresource,\n\t\tdiffs: scopeDiffs,\n\t\t...(input.allowedFiles.length > 0 ? {} : {}),\n\t});\n\tif (!scopeCheck.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait settleMemoryJobBudget(\n\t\t\t\tbudgetPaoHome,\n\t\t\t\tbudgetJobId,\n\t\t\t\tbudgetKind,\n\t\t\t\tusage?.cost?.total,\n\t\t\t\tnew Date().toISOString(),\n\t\t\t\t`范围核对失败:${scopeCheck.error.message}`,\n\t\t\t\tattemptKey,\n\t\t\t);\n\t\t}\n\t\treturn { ok: true, status: \"rejected\", reason: `范围核对失败:${scopeCheck.error.message}` };\n\t}\n\n\t// 10. 相同差异不重复付费验证。\n\tconst existingCandidates = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, diffs_json FROM evolution_candidates\n\t\t\t WHERE problem_id = ? AND resource_id = ? AND base_version = ? AND status != 'cancelled'`,\n\t\t)\n\t\t.all(input.problemId, input.resourceId, input.baseVersion) as Array<{ candidate_id: string; diffs_json: string }>;\n\tfor (const existing of existingCandidates) {\n\t\tconst existingDiffs = JSON.parse(existing.diffs_json) as EvolutionFileDiff[];\n\t\tif (diffsEqual(diffs, existingDiffs)) {\n\t\t\tif (budgetReserved) {\n\t\t\t\tawait settleMemoryJobBudget(\n\t\t\t\t\tbudgetPaoHome,\n\t\t\t\t\tbudgetJobId,\n\t\t\t\t\tbudgetKind,\n\t\t\t\t\tusage?.cost?.total,\n\t\t\t\t\tnew Date().toISOString(),\n\t\t\t\t\t`与候选 ${existing.candidate_id} 差异相同`,\n\t\t\t\t\tattemptKey,\n\t\t\t\t);\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"duplicate\",\n\t\t\t\tcandidateId: existing.candidate_id,\n\t\t\t\treason: `与候选 ${existing.candidate_id} 差异相同，不重复付费验证`,\n\t\t\t};\n\t\t}\n\t}\n\n\t// 11. 存 evolution_candidates（status='proposed'）+ O12/E11 来源继承：\n\t//     把 problem 已登记的 source links 重写为 owner_kind='candidate' 行——\n\t//     候选的来源依据默认继承上游，不依赖编排层重复传 sourceRefs。\n\tconst now = input.createdAt ?? new Date().toISOString();\n\tstore.transaction(() => {\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tinput.problemId,\n\t\t\t\tinput.resourceId,\n\t\t\t\tinput.baseVersion,\n\t\t\t\tinput.testPlanId,\n\t\t\t\tJSON.stringify(diffs),\n\t\t\t\trationale,\n\t\t\t\tJSON.stringify([requestId]),\n\t\t\t\t\"proposed\",\n\t\t\t\tnow,\n\t\t\t\tnow,\n\t\t\t);\n\t\t// 继承 problem 的 source links（INSERT OR IGNORE：UNIQUE(owner_kind,owner_id,source_id)\n\t\t// 同 source 重复继承幂等跳过；memory_id/revision 随 problem 行原样带过来）。\n\t\tconst problemLinks = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\tfor (const link of problemLinks) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`, candidateId, link.source_id, link.memory_id, link.revision, now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_problems SET status = 'candidate', updated_at = ? WHERE problem_id = ?`)\n\t\t\t.run(now, input.problemId);\n\t});\n\n\t// 结算预算（按实际费用）；unlimited 无预留可结算。\n\tif (budgetReserved) {\n\t\tawait settleMemoryJobBudget(\n\t\t\tbudgetPaoHome,\n\t\t\tbudgetJobId,\n\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date(). toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\n\t\t);\n\t}\n\n\treturn {\n\t\tok: true,\n\t\tstatus: \"changed\",\n\t\tcandidateId,\n\t\tdiffs,\n\t\trationale,\n\t\tusageRefs: [requestId],\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n *import type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\nimport type { ModelRegistry } from \"../../core/model-registry.ts\";\nimport type { SessionManager } from \"../../core/session-manager.ts\";\nimport { checkMemoryJobBudgetcheckOutbound, settleMemoryJobBudgetloadOutboundConfigreleaseMemoryJobBudgettype OutboundConfig } from \"../memoryknowledgebudget.tsoutbound.ts\";OutboundConfig } from \"../\nimport { evolutionPaths } from \"../memory/paths.ts\";{ loadTierConfig, resolveTierConfigPath, TierConfig,tierNameToModelMemoryStoreroutingconfig.tsstore.tsassertCandidateWithinScopeMemoryError./memorypolicy.tstypes.tsgetResourceloadTierConfig, resolveTierConfigPath, type TierConfig,tierNameToModel ./routingresources.tsreadResourceVersion } from \"./versions.ts\n\tEvolutionCandidate,\n\tEvolutionFileDiff,\n\tEvolutionProblem,\n\tEvolutionResource,\n\tEvolutionSampleGroup,\n\tMemoryResult,\n\tValidationPlan,\n getResource } from \"./\nimport type { MemoryError /memory/types.ts\";memory/store.ts\n\n// ════════════════════════════════════════════════════════════════════════\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":24}},{"diffOp":{"equal":{"range":[57,259]}}},{"diffOp":{"equal":{"range":[259,269]}}},{"diffOp":{"delete":{"range":[269,289]}}},{"diffOp":{"insert":{"range":[289,302]}}},{"diffOp":{"equal":{"range":[302,304]}}},{"diffOp":{"delete":{"range":[304,325]}}},{"diffOp":{"insert":{"range":[325,343]}}},{"diffOp":{"equal":{"range":[302,304]}}},{"diffOp":{"delete":{"range":[343,365]}}},{"diffOp":{"insert":{"range":[365,384]}}},{"diffOp":{"equal":{"range":[384,396]}}},{"diffOp":{"delete":{"range":[396,402]}}},{"diffOp":{"insert":{"range":[402,411]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[411,420]}}},{"diffOp":{"insert":{"range":[420,431]}}},{"diffOp":{"equal":{"range":[431,433]}}},{"diffOp":{"equal":{"range":[259,269]}}},{"diffOp":{"delete":{"range":[289,302]}}},{"diffOp":{"insert":{"range":[269,289]}}},{"diffOp":{"equal":{"range":[302,304]}}},{"diffOp":{"delete":{"range":[325,343]}}},{"diffOp":{"insert":{"range":[343,365]}}},{"diffOp":{"equal":{"range":[302,304]}}},{"diffOp":{"delete":{"range":[365,369]}}},{"diffOp":{"insert":{"range":[304,325]}}},{"diffOp":{"equal":{"range":[384,385]}}},{"diffOp":{"delete":{"range":[433,448]}}},{"diffOp":{"equal":{"range":[448,459]}}},{"diffOp":{"delete":{"range":[402,411]}}},{"diffOp":{"insert":{"range":[396,402]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[420,431]}}},{"diffOp":{"insert":{"range":[411,420]}}},{"diffOp