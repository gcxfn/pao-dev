标资源。 */\n\tresourceId: string;\n\t/** 冻结时的基础版本。 */\n\tbaseVersion: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 原问题复现样例（至少一条）。 */\n\treproduction: FreezeCaseInput[];\n\t/** 受影响正常用法样例。 */\n\tnormal: FreezeCaseInput[];\n\t/** 独立保留样例（生成器不可见）。 */\n\tholdout: FreezeCaseInput[];\n\t/** 冻结时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n\t/** 来源引用（写入 evolution_source_links）。 */\n\tsourceRefs?: Array<{ sourceId: string; memoryId?: string; revision?: number }>;\n}\n\n/** `freezeValidationPlan` 的成功输出。 */\nexport interface FreezeValidationPlanResult {\n\t/** 冻结验收计划 ID。 */\n\ttestPlanId: string;\n\t/** 完整计划（含三组样例）。 */\n\tplan: ValidationPlan;\n\t/** 落盘的 plan.json 路径。 */\n\tplanPath: string;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 生成 testPlanId：`tp-{resourceId}-{baseVersion}-{hash}`，保证同 resource+base 幂等。 */\nfunction makeTestPlanId(resourceId: string, baseVersion: string, cases: ValidationCase[]): string {\n\tconst fingerprint = testPlanCaseFingerprint(cases);\n\treturn `tp-${resourceId.replace(/:/g, \"_\")}-${baseVersion}-${fingerprint}`;\n}\n\n/**\n * 用例集合指纹（O11/E08 共用）：plan.json 内容被篡改时重算值与\n * testPlanId 尾段对不上——publish 门据此做实质篡改核对（快照自比只\n * 能证明「此刻可读」）。\n */\nexport function testPlanCaseFingerprint(cases: ValidationCase[]): string {\n\treturn createHash(\"sha256\")\n\t\t.update(\n\t\t\tJSON.stringify(\n\t\t\t\tcases.map((c) => [c.group, c.input, c.initialFiles, c.allowedTools, c.acceptance, c.modelConfig]),\n\t\t\t),\n\t\t)\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n}\n\n/** 把 FreezeCaseInput 展开为带 caseId 的 ValidationCase。 */\nfunction expandCases(group: EvolutionSampleGroup, inputs: FreezeCaseInput[]): ValidationCase[] {\n\treturn inputs.map((input, index) => ({\n\t\tcaseId: `${group}-${index}`,\n\t\tgroup,\n\t\tinput: input.input,\n\t\tinitialFiles: input.initialFiles,\n\t\tallowedTools: input.allowedTools,\n\t\tacceptance: input.acceptance,\n\t\t...(input.modelConfig !== undefined ? { modelConfig: input.modelConfig } : {}),\n\t}));\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. freezeValidationPlan\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 冻结验收计划：三组样例一次冻结，testPlanId 绑定 baseVersion。\n *\n * 验收依据存核心管理位置：\n * - evolution_validations 行（verdict 先占位 \"incomplete\"）。\n * - `<home>/evolution/validations/<testPlanId>/plan.json`。\n * 不在候选可写目录（candidates/ 下无写入口）。\n *\n * reproduction 组至少一条；旧版必须先真失败（由调用方在 freeze 前跑 baseline 验证，\n * 复现不了回问题分类，不继续制造改进）。\n */\nexport function freezeValidationPlan(\n\tstore: MemoryStore,\n\tinput: FreezeValidationPlanInput,\n): MemoryResult<FreezeValidationPlanResult> {\n\t// 校验：problem 必须已分类（classified），目标资源已登记。\n\tconst problemRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT problem_id, status, resource_id, base_version\n\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t)\n\t\t.get(input.problemId) as\n\t\t| { problem_id: string; status: string; resource_id: string | null; base_version: string | null }\n\t\t| undefined;\n\tif (!problemRow) {\n\t\treturn fail(\"invalid_input\", `问题未登记:${input.problemId}`, input.problemId);\n\t}\n\tif (problemRow.status !== \"classified\") {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 当前状态 ${problemRow.status}，须为 classified 才能冻结验收`,\n\t\t\tinput.problemId,\n\t\t);\n\t}\n\tif (problemRow.resource_id !== input.resourceId) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`问题 ${input.problemId} 登记的资源 ${problemRow.resource_id ?? \"无\"} 与输入 ${input.resourceId} 不一致`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst resolvedBase = input.baseVersion ?? problemRow.base_version;\n\tif (!resolvedBase) {\n\t\treturn fail(\"invalid_input\", `问题 ${input.problemId} 未绑定 baseVersion，无法冻结验收`, input.problemId);\n\t}\n\n\t// 三组样例展开。\n\tconst reproduction = expandCases(\"reproduction\", input.reproduction);\n\tconst normal = expandCases(\"normal\", input.normal);\n\tconst holdout = expandCases(\"holdout\", input.holdout);\n\tif (reproduction.length === 0) {\n\t\treturn fail(\"invalid_input\", \"原问题复现样例至少一条\", input.problemId);\n\t}\n\tconst allCases = [...reproduction, ...normal, ...holdout];\n\tconst testPlanId = makeTestPlanId(input.resourceId, resolvedBase, allCases);\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\tconst plan: ValidationPlan = {\n\t\ttestPlanId,\n\t\tresourceId: input.resourceId,\n\t\tbaseVersion: resolvedBase,\n\t\treproduction,\n\t\tnormal,\n\t\tholdout,\n\t\tcreatedAt: now,\n\t};\n\n\t// 验收依据落盘：核心管理位置，不在候选可写目录。\n\tconst planDir = join(evolutionPaths(input.paoHome).validations, testPlanId);\n\tmkdirSync(planDir, { recursive: true });\n\tconst planPath = join(planDir, \"plan.json\");\n\twriteFileSync(planPath, JSON.stringify(plan, null, 2), \"utf8\");\n\n\t// 验收依据存核心管理位置：\n\t// - plan.json 落盘（<home>/evolution/validations/<testPlanId>/）。\n\t// - evolution_validations 行由 evaluateCandidate 在运行时创建（外键约束要求\n\t//   candidate_id 已存在，freeze 阶段尚无候选，故不在此写行）。\n\t// - evolution_source_links 以 owner_kind=\"validation\"、owner_id=testPlanId 写入，\n\t//   供来源删除时沿关联清理。\n\t// O12/E11：sourceRefs 未传时自动继承 problem 已登记的 links（内核内部默认\n\t// 继承，不依赖编排层重复传参）；显式传入时以传入为准。\n\tconst sourceRefs =\n\t\tinput.sourceRefs ??\n\t\t(store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(input.problemId) as Array<{\n\t\t\tsource_id: string;\n\t\t\tmemory_id: string | null;\n\t\t\trevision: number | null;\n\t\t}>).map((link) => ({\n\t\t\tsourceId: link.source_id,\n\t\t\t...(link.memory_id === null ? {} : { memoryId: link.memory_id }),\n\t\t\t...(link.revision === null ? {} : { revision: link.revision }),\n\t\t}));\n\tstore.transaction(() => {\n\t\tfor (const ref of sourceRefs) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (\n\t\t\t\t\t\tlink_id, owner_kind, owner_id, source_id, memory_id, revision, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\t`link-${testPlanId}-${ref.sourceId}`,\n\t\t\t\t\t\"validation\",\n\t\t\t\t\ttestPlanId,\n\t\t\t\t\tref.sourceId,\n\t\t\t\t\tref.memoryId ?? null,\n\t\t\t\t\tref.revision ?? null,\n\t\t\t\t\tnow,\n\t\t\t\t);\n\t\t}\n\t});\n\n\treturn { ok: true, testPlanId, plan, planPath };\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化固定版本存储（S9-01）。\n *import { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\nimport {\n\tauditCandidateForPublish,\tsnapshotManagedFile,\n} from \"./boundary.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";testPlanCaseFingerprintEvolutionFileDiff, ValidationPlan } from \"./validation.ts EvolutionFileDiff,ValidationPlan\n\n// ════════════════════════════════════════════════════════════════════════\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[57,281]}}},{"diffOp":{"equal":{"range":[281,289]}}},{"diffOp":{"delete":{"range":[289,294]}}},{"diffOp":{"equal":{"range":[294,295]}}},{"diffOp":{"delete":{"range":[295,308]}}},{"diffOp":{"equal":{"range":[295,296]}}},{"diffOp":{"delete":{"range":[308,320]}}},{"diffOp":{"insert":{"range":[320,334]}}},{"diffOp":{"equal":{"range":[334,353]}}},{"diffOp":{"delete":{"range":[353,361]}}},{"diffOp":{"insert":{"range":[361,369]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[371,426]}}},{"diffOp":{"equal":{"range":[371,379]}}},{"diffOp":{"insert":{"range":[289,294]}}},{"diffOp":{"equal":{"range":[426,428]}}},{"diffOp":{"delete":{"range":[320,334]}}},{"diffOp":{"insert":{"range":[428,453]}}},{"diffOp":{"equal":{"range":[334,353]}}},{"diffOp":{"delete":{"range":[361,369]}}},{"diffOp":{"insert":{"range":[353,361]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[453,489]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[489,594]}}},{"diffOp":{"equal":{"range":[453,461]}}},{"diffOp":{"insert":{"range":[289,294]}}},{"diffOp":{"equal":{"range":[426,428]}}},{"diffOp":{"delete":{"range":[594,617]}}},{"diffOp":{"insert":{"range":[617,650]}}},{"diffOp":{"equal":{"range":[650,661]}}},{"diffOp":{"delete":{"range":[661,674]}}},{"diffOp":{"insert":{"range":[353,361]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[453,461]}}},{"diffOp":{"delete":{"range":[289,294]}}},{"diffOp":{"equal":{"range":[426,427]}}},{"diffOp":{"delete":{"range":[674,693]}}},{"diffOp":{"equal":{"range":[650,651]}}},{"diffOp":{"delete":{"range":[693,707]}}},{"diffOp":{"insert":{"range":[594,617]}}},{"diffOp":{"equal":{"range":[650,661]}}},{"diffOp":{"delete":{"range":[353,361]}}},{"diffOp":{"insert":{"range":[661,674]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[707,928]}}},{"equalLines":{"line_count":648}},{"diffOp":{"equal":{"range":[928,934]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\versions.ts"},"span":[1283,1336],"sourceCode":"/**\n * 受控自进化固定版本存储（S9-01）。\n *\n * 职责：把 passed 候选的文件副本从 `evolution/candidates/<dirSafeResourceId>/<candidateId>/`\n * 固化进不可原位修改的 `evolution/versions/<dirSafeResourceId>/<versionId>/`，\n * 并提供版本历史（list）与版本正文（read）只读入口。\n *\n * 契约（S9 任务书 §3/§5）：\n * - 候选须 `status='passed'` 且其最新一条 evolution_validations `verdict='passed'`，\n *   否则返回 `not_ready`（业务拒绝，不是系统错误）。\n * - versionId 沿用 `v-{sha12(内容清单)}` 约定（与 snapshotResourceFiles 同指纹口径）：\n *   同内容同 versionId，重复发布幂等。\n * - 全部文件复制成功后才写版本可用凭据（`evolution_activations` kind='publish' 行）；\n *   复制中途失败清理半成品目录，不改任何指向——部分目录永远不构成可加载版本。\n * - `passed` 是候选终态无出边：发布走 activation 记录旁路，不改状态机，\n *   不动 `effective_version`（生效切换归 S9-02 activation 事务）。\n * - 已验证版本文件不被后续候选原位修改；旧版始终可读。\n *\n * 版本可用性判定 = 目录完整 + 有 activation 记录：两条件缺一即不可用。\n */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tauditCandidateForPublish,\n\tauditResourceCapabilityCoverage,\n\tsnapshotManagedFile,\n} from \"./boundary.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { testPlanCaseFingerprint } from \"./validation.ts\";\nimport type { EvolutionFileDiff, ValidationPlan } from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `publishCandidate` 的输入。 */\nexport interface PublishCandidateInput {\n\t/** 已验证通过的候选 ID。 */\n\tcandidateId: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 发布时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `publishCandidate` 的成功输出。 */\nexport interface PublishCandidateResult {\n\t/** 固化的版本 ID（`v-{hash前12位}`；同内容幂等）。 */\n\tversionId: string;\n\t/** 版本目录绝对路径。 */\n\tversionDir: string;\n\t/** 实际发布的文件数。 */\n\tfilesPublished: number;\n\t/** 本次是否新建（false = 同内容版本已发布过，幂等返回）。 */\n\tpublished: boolean;\n}\n\n/** `publishCandidate` 的未就绪输出（业务拒绝）。 */\nexport interface PublishNotReady {\n\t/** 未就绪原因（候选状态非 passed / 最新验证非 passed / 候选目录缺失）。 */\n\treason: string;\n}\n\n/** `listResourceVersions` 返回的一行版本历史。 */\nexport interface ResourceVersionEntry {\n\t/** 版本 ID。 */\n\tversionId: string;\n\t/** 版本目录绝对路径。 */\n\tversionDir: string;\n\t/** 目录内文件清单（相对路径，POSIX）。 */\n\tfiles: string[];\n\t/** 目录是否完整可读（缺目录或不可读时 false）。 */\n\tcomplete: boolean;\n\t/** 关联的 activation 记录（无记录时版本虽在盘上但不可用）。 */\n\tactivation?: {\n\t\tactivationId: string;\n\t\tkind: \"publish\" | \"restore\" | \"rollback\";\n\t\tfromVersion?: string;\n\t\treason?: string;\n\t\tcreatedAt: string;\n\t};\n\t/** 版本可用：目录完整 + 有 activation 记录。 */\n\tavailable: boolean;\n}\n\n/** `readResourceVersion` 的输入。 */\nexport interface ReadResourceVersionInput {\n\tresourceId: string;\n\tversionId: string;\n\tpaoHome: string;\n}\n\n/** `readResourceVersion` 返回的一份文件正文。 */\nexport interface ResourceVersionFile {\n\t/** 资源根内相对路径（POSIX）。 */\n\tpath: string;\n\t/** 字节数。 */\n\tsizeBytes: number;\n\t/** 内容 SHA-256 哈希。 */\n\thash: string;\n\t/** 文件正文（utf8）。 */\n\tcontent: string;\n}\n\n/** `readResourceVersion` 的输出。 */\nexport interface ResourceVersionContent {\n\tresourceId: string;\n\tversionId: string;\n\tversionDir: string;\n\t/** 目录完整 + 有 activation 记录时才 true；否则文件仍可读但版本不可加载。 */\n\tavailable: boolean;\n\tfiles: ResourceVersionFile[];\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`，与 candidates.ts/resources.ts 同规则）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/**\n * 递归列出根内全部文件（相对路径 POSIX，按路径排序）。\n * 根可以是目录或单个文件（文件型资源根如 `工作流/{name}.md`）：\n * 文件形态返回一项（relativePath = basename）；不存在返回空数组。\n * O12/E12：三处私有重复收拢为版本模块的共享实现。\n */\nexport function listResourceFiles(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst stat = statSync(root);\n\tif (stat.isFile()) {\n\t\treturn [{ absolutePath: root, relativePath: basename(root) }];\n\t}\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 目录/文件指纹 = `v-{sha256(文件清单[路径,sha256])前12位}`，与 snapshotResourceFiles\n * 同口径：只重算哈希比对，不复制文件（核对不是快照）。\n * O12/E12：activation/control/resources 三处私有重复收拢共享本实现；\n * 文件型资源根（单文件）由 listResourceFiles 统一分派。\n */\nexport function fingerprintResourceRoot(root: string): { versionId: string; fileCount: number } {\n\tconst files = listResourceFiles(root).map((file) => ({\n\t\tpath: file.relativePath,\n\t\thash: createHash(\"sha256\").update(readFileSync(file.absolutePath)).digest(\"hex\"),\n\t}));\n\tconst fingerprint = createHash(\"sha256\")\n\t\t.update(JSON.stringify(files.map((s) => [s.path, s.hash])))\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n\treturn { versionId: `v-${fingerprint}`, fileCount: files.length };\n}\n\n/** 校验 versionId 不能逃出 versions 目录（防 `..`/绝对路径注入）。 */\nfunction isVersionIdSafe(versionId: string): boolean {\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) || /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(versionId);\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tcreated_at: string;\n}\n\n/** 查该资源指定 to_version 的 activation 行（取最新一条）。 */\nfunction getActivationForVersion(store: MemoryStore, resourceId: string, versionId: string): ActivationRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ?\n\t\t\t ORDER BY created_at DESC, activation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(resourceId, versionId) as ActivationRow | undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. publishCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 发布一个 passed 候选为固定版本。\n *\n * 流程：\n * 1. 读候选行；status 须 'passed'，且最新一条 validation verdict 须 'passed'，\n *    否则返回 `{ ok:true, status:\"not_ready\", reason }`。\n * 2. **内部审计门（O11/E08，不可绕过——passed 是终态无出边，审计必须在\n *    publish 内）**：\n *    a. `auditResourceCapabilityCoverage`：extension/command → publishable=false 拒发；\n *    b. `checkOwnerSourceLinksIntact`：problem→candidate→testPlan→validation\n *       四级来源关联仍有效；\n *    c. `auditCandidateForPublish`：范围核对（补传 problem.action 与\n *       CATEGORY_PROFILES policyRefs 经由断言内部查表）+ plan.json 受管输入未改\n *       + run fileChanges 未越区；\n *    d. **已验内容绑定**：重算候选目录当前指纹 vs 验证时记录的指纹（validation\n *       最新行的 case_results 不带指纹——以「发布时候选目录指纹 =\n *       versionId」为界，结合 baseline 版本目录完整性比对防版本目录被换；\n *       验证后改动候选文件 → 指纹变化 → 拒绝发布）。\n * 3. versionId = `v-{sha12(内容清单)}`（幂等）；幂等命中直接返回。\n * 4. 候选目录文件完整复制进 versions 目录；中途 throw → 清理半成品目录后上抛。\n * 5. 全部文件落盘后写 `evolution_activations`（kind='publish'）——版本可用凭据。\n *\n * 不改 effective_version（生效切换是 S9-02 的前置核对 + 单事务）。\n */\nexport async function publishCandidate(\n\tstore: MemoryStore,\n\tinput: PublishCandidateInput,\n): Promise<MemoryResult<PublishCandidateResult | { status: \"not_ready\"; reason: string }>> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\t// 1. 读候选行。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, diffs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tdiffs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.status !== \"passed\") {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `候选 ${input.candidateId} 状态 ${candidateRow.status}，须为 passed 才能发布`,\n\t\t};\n\t}\n\n\t// 2. 最新一条该候选的 validation 必须 verdict='passed'。\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id, verdict, case_results_json FROM evolution_validations\n\t\t\t WHERE candidate_id = ?\n\t\t\t ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(input.candidateId) as { validation_id: string; verdict: string; case_results_json: string } | undefined;\n\tif (!latestValidation || latestValidation.verdict !== \"passed\") {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: latestValidation\n\t\t\t\t? `候选 ${input.candidateId} 最新验证判定 ${latestValidation.verdict}，须为 passed 才能发布`\n\t\t\t\t: `候选 ${input.candidateId} 无验证记录，须先完成验证`,\n\t\t};\n\t}\n\n\t// 3. 候选目录必须存在且非空。\n\tconst dirSafeResourceId = dirSafeId(candidateRow.resource_id);\n\tconst candidateDir = join(evolutionPaths(input.paoHome).candidates, dirSafeResourceId, input.candidateId);\n\tconst candidateFiles = listResourceFiles(candidateDir);\n\tif (candidateFiles.length === 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `候选目录不存在或无文件:${candidateDir}`,\n\t\t};\n\t}\n\n\t// ════════════════════════════════════════════════════════════════════\n\t// 4. O11/E08 内部审计门（在 publish 内，不可绕过）\n\t// ════════════════════════════════════════════════════════════════════\n\n\t// 4a. 资源行 + 能力覆盖：extension/command → publishable=false 拒发。\n\tconst resourceRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t)\n\t\t.get(candidateRow.resource_id) as\n\t\t| {\n\t\t\t\tresource_id: string;\n\t\t\t\tkind: string;\n\t\t\t\trelative_root: string;\n\t\t\t\tallowed_ops_json: string;\n\t\t\t\tcapability_scope_json: string;\n\t\t\t\tload_method: string;\n\t\t\t\teffective_version: string | null;\n\t\t\t\tauto_evolution_enabled: number;\n\t\t\t\tregistered_at: string;\n\t\t\t\tupdated_at: string;\n\t\t  }\n\t\t| undefined;\n\tif (!resourceRow) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${candidateRow.resource_id}`, candidateRow.resource_id);\n\t}\n\tconst resource = {\n\t\tresourceId: resourceRow.resource_id,\n\t\tkind: resourceRow.kind as import(\"./types.ts\").EvolutionResourceKind,\n\t\trelativeRoot: resourceRow.relative_root,\n\t\tallowedOps: JSON.parse(resourceRow.allowed_ops_json) as import(\"./types.ts\").EvolutionResourceOp[],\n\t\tcapabilityScope: JSON.parse(resourceRow.capability_scope_json) as string[],\n\t\tloadMethod: resourceRow.load_method as import(\"./types.ts\").EvolutionLoadMethod,\n\t\t...(resourceRow.effective_version === null ? {} : { effectiveVersion: resourceRow.effective_version }),\n\t\tautoEvolutionEnabled: resourceRow.auto_evolution_enabled === 1,\n\t\tregisteredAt: resourceRow.registered_at,\n\t\tupdatedAt: resourceRow.updated_at,\n\t};\n\tconst coverage = auditResourceCapabilityCoverage(resource);\n\tif (!coverage.publishable) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason:\n\t\t\t\t`资源 ${resource.resourceId}（kind=${resource.kind}）能力未覆盖，不可自动发布：` +\n\t\t\t\tcoverage.gaps.map((g) => `${g.capability}（${g.reason}）`).join(\"；\"),\n\t\t};\n\t}\n\n\t// 4b. 来源依据仍有效：problem→candidate→testPlan→validation 四级 owner。\n\tconst sourceViolation = checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: candidateRow.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: input.candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: candidateRow.test_plan_id, label: \"冻结计划\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: latestValidation.validation_id, label: \"验证\" },\n\t\t],\n\t});\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t};\n\t}\n\n\t// 4c. 候选边界核对：scope（含 problem.action + CATEGORY_PROFILES policyRefs\n\t//     由断言按 kind 内部查表）+ plan.json 未改 + run fileChanges 未越区。\n\tconst problemRow = store.db\n\t\t.prepare(`SELECT action FROM evolution_problems WHERE problem_id = ?`)\n\t\t.get(candidateRow.problem_id) as { action: string | null } | undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, candidateRow.test_plan_id, \"plan.json\");\n\t// plan.json 实质篡改核对（O11/E08）：testPlanId 尾段本就是 freeze 时对\n\t// 全部用例的 sha12 指纹——从盘上 plan.json 重算指纹与 testPlanId 比对；\n\t// 快照自比（snapshotManagedFile 对同一文件抓两次）只能证明「此刻可读」，\n\t// 不能证明未改。文件缺失/不可解析/指纹不符一律拒发。\n\tconst planSnapshotBefore = snapshotManagedFile(planPath);\n\tif (planSnapshotBefore.hash === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `受管输入 plan.json 缺失:${planPath}（冻结验收依据不存在，不能发布）`,\n\t\t};\n\t}\n\ttry {\n\t\tconst planJson = JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t\tconst allCases = [...planJson.reproduction, ...planJson.normal, ...planJson.holdout];\n\t\tconst expectedSuffix = candidateRow.test_plan_id.split(\"-\").at(-1);\n\t\tif (expectedSuffix === undefined || testPlanCaseFingerprint(allCases) !== expectedSuffix) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"not_ready\",\n\t\t\t\treason:\n\t\t\t\t\t`受管输入 plan.json 内容与 testPlanId ${candidateRow.test_plan_id} 指纹不符` +\n\t\t\t\t\t`（冻结验收依据被篡改，发布内容与已验证收依据不符）`,\n\t\t\t};\n\t\t}\n\t} catch {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `受管输入 plan.json 不可解析:${planPath}（冻结验收依据损坏，不能发布）`,\n\t\t};\n\t}\n\t// runFileChanges：最新验证 case_results 里双侧 fileChanges 汇总。\n\tconst runFileChanges: Record<string, string>[] = [];\n\ttry {\n\t\tconst caseResults = JSON.parse(latestValidation.case_results_json) as Array<{\n\t\t\tbaseline?: { fileChanges?: Record<string, string> };\n\t\t\tcandidate?: { fileChanges?: Record<string, string> };\n\t\t}>;\n\t\tfor (const cr of caseResults) {\n\t\t\tif (cr.baseline?.fileChanges) runFileChanges.push(cr.baseline.fileChanges);\n\t\t\tif (cr.candidate?.fileChanges) runFileChanges.push(cr.candidate.fileChanges);\n\t\t}\n\t} catch {\n\t\t// case_results 非 JSON → 跳过 fileChanges 核对（不写死，不落隐性失败）。\n\t}\n\tconst diffs = JSON.parse(candidateRow.diffs_json) as EvolutionFileDiff[];\n\tconst candidate = {\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\ttestPlanId: candidateRow.test_plan_id,\n\t\tdiffs,\n\t\trationale: \"\",\n\t\tusageRefs: [],\n\t\tstatus: \"passed\" as const,\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\tconst audit = auditCandidateForPublish(store, {\n\t\tcandidate,\n\t\tpaoHome: input.paoHome,\n\t\tplanSnapshotBefore,\n\t\trunFileChanges,\n\t\t...(problemRow?.action !== null && problemRow?.action !== undefined\n\t\t\t? { action: problemRow.action as \"modify\" | \"delete\" | \"merge\" }\n\t\t\t: {}),\n\t});\n\tif (!audit.ok) return audit;\n\tif (!audit.eligible) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `发布前边界核对未过:${audit.violations.join(\"；\")}`,\n\t\t};\n\t}\n\n\t// 4d. 已验内容绑定：\n\t// - baseline 版本目录完整性（`versions/<baseVersion>/` 指纹 === baseVersion\n\t//   值本身——versionId 即清单哈希；版本目录被换 → 指纹对不上 → 拒绝）。\n\tconst baselineVersionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeResourceId,\n\t\tcandidateRow.base_version,\n\t);\n\tif (existsSync(baselineVersionDir)) {\n\t\tconst baselineNow = fingerprintResourceRoot(baselineVersionDir);\n\t\tif (/^v-[0-9a-f]{12}$/.test(candidateRow.base_version) && baselineNow.versionId !== candidateRow.base_version) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"not_ready\",\n\t\t\t\treason:\n\t\t\t\t\t`baseline 版本目录指纹不匹配:${baselineVersionDir}（期望 ${candidateRow.base_version}，` +\n\t\t\t\t\t`实际 ${baselineNow.versionId}——验证所依据的旧版正文被换，发布内容不可信）`,\n\t\t\t};\n\t\t}\n\t}\n\t// - 候选目录指纹 vs 验证时回执记录的指纹（runner 在每次 run 对副本源目录\n\t//   算 `v-{sha12}` 写进 receipt.resourceFingerprint）：不一致 → 验证后\n\t//   候选正文被改 → 拒绝发布。无指纹回执（旧回执/未跑验证）时退回\n\t//   「发布时指纹即 versionId」的固有绑定（天然成立，不新增校验文件）。\n\tconst candidateFingerprint = fingerprintResourceRoot(candidateDir);\n\tconst runsDir = join(evolutionPaths(input.paoHome).validations, candidateRow.test_plan_id, \"runs\");\n\tconst verifiedFingerprints = new Set<string>();\n\tif (existsSync(runsDir)) {\n\t\tfor (const file of readdirSync(runsDir)) {\n\t\t\tif (!file.endsWith(\".json\")) continue;\n\t\t\ttry {\n\t\t\t\tconst receipt = JSON.parse(\n\t\t\t\t\treadFileSync(join(runsDir, file), \"utf8\"),\n\t\t\t\t) as { side?: string; resourceFingerprint?: string };\n\t\t\t\tif (receipt.side === \"candidate\" && typeof receipt.resourceFingerprint === \"string\") {\n\t\t\t\t\tverifiedFingerprints.add(receipt.resourceFingerprint);\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 非 JSON 回执跳过。\n\t\t\t}\n\t\t}\n\t}\n\tif (verifiedFingerprints.size > 0 && !verifiedFingerprints.has(candidateFingerprint.versionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason:\n\t\t\t\t`候选目录当前指纹 ${candidateFingerprint.versionId} 与验证时回执指纹 ` +\n\t\t\t\t`${[...verifiedFingerprints].join(\"、\")} 不一致——验证后候选正文被改动，发布内容与已验内容不符`,\n\t\t};\n\t}\n\n\t// 5. versionId = 内容清单哈希短前缀（同 snapshotResourceFiles 口径，幂等）。\n\tconst versionId = candidateFingerprint.versionId;\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, versionId);\n\n\t// 5. 幂等：同 (resourceId, versionId) 已发布且目录完整 → 直接返回。\n\tconst existing = getActivationForVersion(store, candidateRow.resource_id, versionId);\n\tconst existingFiles = listResourceFiles(versionDir);\n\tif (existing && existing.kind === \"publish\" && existingFiles.length === candidateFiles.length) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tversionId,\n\t\t\tversionDir,\n\t\t\tfilesPublished: existingFiles.length,\n\t\t\tpublished: false,\n\t\t};\n\t}\n\n\t// 6. 复制候选目录 → 版本目录。复制中途失败：清理半成品目录，原样上抛，\n\t//    不写任何 activation（部分目录不构成可加载版本）。\n\ttry {\n\t\tmkdirSync(versionDir, { recursive: true });\n\t\tfor (const file of candidateFiles) {\n\t\t\tconst dest = join(versionDir, file.relativePath);\n\t\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\t\tcopyFileSync(file.absolutePath, dest);\n\t\t}\n\t} catch (error) {\n\t\ttry {\n\t\t\trmSync(versionDir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 清理失败不掩盖原始复制错误。\n\t\t}\n\t\tthrow error;\n\t}\n\n\t// 7. 全部文件落盘后写版本可用凭据（publish activation；from_version 记候选的 baseVersion）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`act-${randomUUID()}`,\n\t\t\tcandidateRow.resource_id,\n\t\t\tcandidateRow.base_version,\n\t\t\tversionId,\n\t\t\t`发布候选 ${input.candidateId}（验证 ${latestValidation.validation_id}）`,\n\t\t\tJSON.stringify({ candidateId: input.candidateId, validationId: latestValidation.validation_id }),\n\t\t\tnow,\n\t\t);\n\n\treturn {\n\t\tok: true,\n\t\tversionId,\n\t\tversionDir,\n\t\tfilesPublished: candidateFiles.length,\n\t\tpublished: true,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listResourceVersions\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 列出一个资源的版本时间线：盘上 `versions/<dirSafeResourceId>/<versionId>/`\n * 目录 ∪ `evolution_activations` 记录，按 activation 时间排序（无 activation 的\n * 目录排尾，available=false）。\n */\nexport function listResourceVersions(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tpaoHome: string,\n): MemoryResult<{ items: ResourceVersionEntry[] }> {\n\tconst dirSafeResourceId = dirSafeId(resourceId);\n\tconst resourceVersionsDir = join(evolutionPaths(paoHome).versions, dirSafeResourceId);\n\n\t// 盘上版本目录。\n\tconst onDisk = new Map<string, { versionDir: string; files: string[]; complete: boolean }>();\n\tif (existsSync(resourceVersionsDir)) {\n\t\tfor (const entry of readdirSync(resourceVersionsDir, { withFileTypes: true })) {\n\t\t\tif (!entry.isDirectory()) continue;\n\t\t\tconst versionDir = join(resourceVersionsDir, entry.name);\n\t\t\tconst files = listResourceFiles(versionDir).map((f) => f.relativePath);\n\t\t\tonDisk.set(entry.name, { versionDir, files, complete: files.length > 0 });\n\t\t}\n\t}\n\n\t// activation 记录（按 to_version 归并）。\n\tconst activationRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as ActivationRow[];\n\tconst activationByVersion = new Map<string, ActivationRow>();\n\tfor (const row of activationRows) {\n\t\t// 同版本多条取最新（后写覆盖）。\n\t\tactivationByVersion.set(row.to_version, row);\n\t}\n\n\tconst versionIds = new Set<string>([...onDisk.keys(), ...activationByVersion.keys()]);\n\tconst items: ResourceVersionEntry[] = [...versionIds].map((versionId) => {\n\t\tconst disk = onDisk.get(versionId);\n\t\tconst act = activationByVersion.get(versionId);\n\t\tconst complete = disk?.complete ?? false;\n\t\treturn {\n\t\t\tversionId,\n\t\t\tversionDir: disk?.versionDir ?? join(resourceVersionsDir, versionId),\n\t\t\tfiles: disk?.files ?? [],\n\t\t\tcomplete,\n\t\t\t...(act\n\t\t\t\t? {\n\t\t\t\t\t\tactivation: {\n\t\t\t\t\t\t\tactivationId: act.activation_id,\n\t\t\t\t\t\t\tkind: act.kind as \"publish\" | \"restore\" | \"rollback\",\n\t\t\t\t\t\t\t...(act.from_version === null ? {} : { fromVersion: act.from_version }),\n\t\t\t\t\t\t\t...(act.reason === null ? {} : { reason: act.reason }),\n\t\t\t\t\t\t\tcreatedAt: act.created_at,\n\t\t\t\t\t\t},\n\t\t\t\t\t}\n\t\t\t\t: {}),\n\t\t\tavailable: complete && act !== undefined,\n\t\t};\n\t});\n\n\t// 有 activation 的按 activation 时间排；无 activation 的排尾（按 versionId 字典序）。\n\titems.sort((a, b) => {\n\t\tif (a.activation && b.activation) {\n\t\t\treturn a.activation.createdAt.localeCompare(b.activation.createdAt);\n\t\t}\n\t\tif (a.activation) return -1;\n\t\tif (b.activation) return 1;\n\t\treturn a.versionId.localeCompare(b.versionId);\n\t});\n\n\treturn { ok: true, items };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. readResourceVersion\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 读指定版本目录的文件清单与正文（utf8）。\n * 目录不存在 → `source_missing`；目录存在但无 activation 或为空 → 文件仍返回，\n * `available=false`（调用方据此不把该版本当可加载版本）。\n */\nexport function readResourceVersion(\n\tstore: MemoryStore,\n\tinput: ReadResourceVersionInput,\n): MemoryResult<ResourceVersionContent> {\n\tif (!isVersionIdSafe(input.versionId)) {\n\t\treturn fail(\"invalid_input\", `非法 versionId:${input.versionId}`, input.versionId);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, input.versionId);\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) {\n\t\treturn fail(\"source_missing\", `版本目录不存在:${versionDir}`, input.versionId);\n\t}\n\n\tconst diskFiles = listResourceFiles(versionDir);\n\tconst files: ResourceVersionFile[] = diskFiles.map((file) => {\n\t\tconst content = readFileSync(file.absolutePath);\n\t\treturn {\n\t\t\tpath: file.relativePath,\n\t\t\tsizeBytes: content.length,\n\t\t\thash: createHash(\"sha256\").update(content).digest(\"hex\"),\n\t\t\tcontent: content.toString(\"utf8\"),\n\t\t};\n\t});\n\n\tconst act = getActivationForVersion(store, input.resourceId, input.versionId);\n\treturn {\n\t\tok: true,\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.versionId,\n\t\tversionDir,\n\t\tavailable: files.length > 0 && act !== undefined,\n\t\tfiles,\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化固定版本存储（S9-01）。\n *import type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\t auditCandidateForPublish,auditResourceCapabilityCoverage,snapshotManagedFile,\n} from \"./boundary.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { testPlanCaseFingerprint } from \"./validation.ts\";\t\t\tif (!file.endsWith(\".json\")) continue;\n\t\t\ttry {\n\t\t\t\tconst receipt = JSON.parse(\n\t\t\t\t\treadFileSync(join(runsDir, file), \"utf8\"),\n\t\t\t\t) as {side?: string;resourceFingerprint?: string;\n\t\t\t\t};\n\t\t\t\tif (receipt.side === \"candidate\" && typeof receipt.resourceFingerprint === \"string\") {\n\t\t\t\t\tverifiedFingerprints.add(receipt.resourceFingerprint);\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[57,173]}}},{"diffOp":{"delete":{"range":[173,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[176,201]}}},{"diffOp":{"delete":{"range":[173,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[201,233]}}},{"diffOp":{"delete":{"range":[173,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[233,252]}}},{"diffOp":{"delete":{"range":[252,254]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[254,396]}}},{"equalLines":{"line_count":446}},{"diffOp":{"equal":{"range":[396,478]}}},{"diffOp":{"delete":{"range":[478,484]}}},{"diffOp":{"equal":{"range":[484,525]}}},{"diffOp":{"delete":{"range":[525,531]}}},{"diffOp":{"equal":{"range":[531,537]}}},{"diffOp":{"delete":{"range":[175,176]}}},{"diffOp":{"insert":{"range":[478,484]}}},{"diffOp":{"equal":{"range":[537,551]}}},{"diffOp":{"delete":{"range":[175,176]}}},{"diffOp":{"insert":{"range":[478,484]}}},{"diffOp":{"equal":{"range":[551,579]}}},{"diffOp":{"delete":{"range":[175,176]}}},{"diffOp":{"insert":{"range":[579,585]}}},{"diffOp":{"equal":{"range":[585,738]}}},{"equalLines":{"line_count":198}},{"diffOp":{"equal":{"range":[738,744]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\versions.ts"},"span":null,"sourceCode":"/**\n * 受控自进化固定版本存储（S9-01）。\n *\n * 职责：把 passed 候选的文件副本从 `evolution/candidates/<dirSafeResourceId>/<candidateId>/`\n * 固化进不可原位修改的 `evolution/versions/<dirSafeResourceId>/<versionId>/`，\n * 并提供版本历史（list）与版本正文（read）只读入口。\n *\n * 契约（S9 任务书 §3/§5）：\n * - 候选须 `status='passed'` 且其最新一条 evolution_validations `verdict='passed'`，\n *   否则返回 `not_ready`（业务拒绝，不是系统错误）。\n * - versionId 沿用 `v-{sha12(内容清单)}` 约定（与 snapshotResourceFiles 同指纹口径）：\n *   同内容同 versionId，重复发布幂等。\n * - 全部文件复制成功后才写版本可用凭据（`evolution_activations` kind='publish' 行）；\n *   复制中途失败清理半成品目录，不改任何指向——部分目录永远不构成可加载版本。\n * - `passed` 是候选终态无出边：发布走 activation 记录旁路，不改状态机，\n *   不动 `effective_version`（生效切换归 S9-02 activation 事务）。\n * - 已验证版本文件不被后续候选原位修改；旧版始终可读。\n *\n * 版本可用性判定 = 目录完整 + 有 activation 记录：两条件缺一即不可用。\n */\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\nimport {\n\tauditCandidateForPublish,\n\tauditResourceCapabilityCoverage,\n\tsnapshotManagedFile,\n} from \"./boundary.ts\";\nimport { checkOwnerSourceLinksIntact } from \"./observe.ts\";\nimport { testPlanCaseFingerprint } from \"./validation.ts\";\nimport type { EvolutionFileDiff, ValidationPlan } from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 输入输出契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** `publishCandidate` 的输入。 */\nexport interface PublishCandidateInput {\n\t/** 已验证通过的候选 ID。 */\n\tcandidateId: string;\n\t/** PAO_HOME 根。 */\n\tpaoHome: string;\n\t/** 发布时间（夹具注入；缺省取当前）。 */\n\tcreatedAt?: string;\n}\n\n/** `publishCandidate` 的成功输出。 */\nexport interface PublishCandidateResult {\n\t/** 固化的版本 ID（`v-{hash前12位}`；同内容幂等）。 */\n\tversionId: string;\n\t/** 版本目录绝对路径。 */\n\tversionDir: string;\n\t/** 实际发布的文件数。 */\n\tfilesPublished: number;\n\t/** 本次是否新建（false = 同内容版本已发布过，幂等返回）。 */\n\tpublished: boolean;\n}\n\n/** `publishCandidate` 的未就绪输出（业务拒绝）。 */\nexport interface PublishNotReady {\n\t/** 未就绪原因（候选状态非 passed / 最新验证非 passed / 候选目录缺失）。 */\n\treason: string;\n}\n\n/** `listResourceVersions` 返回的一行版本历史。 */\nexport interface ResourceVersionEntry {\n\t/** 版本 ID。 */\n\tversionId: string;\n\t/** 版本目录绝对路径。 */\n\tversionDir: string;\n\t/** 目录内文件清单（相对路径，POSIX）。 */\n\tfiles: string[];\n\t/** 目录是否完整可读（缺目录或不可读时 false）。 */\n\tcomplete: boolean;\n\t/** 关联的 activation 记录（无记录时版本虽在盘上但不可用）。 */\n\tactivation?: {\n\t\tactivationId: string;\n\t\tkind: \"publish\" | \"restore\" | \"rollback\";\n\t\tfromVersion?: string;\n\t\treason?: string;\n\t\tcreatedAt: string;\n\t};\n\t/** 版本可用：目录完整 + 有 activation 记录。 */\n\tavailable: boolean;\n}\n\n/** `readResourceVersion` 的输入。 */\nexport interface ReadResourceVersionInput {\n\tresourceId: string;\n\tversionId: string;\n\tpaoHome: string;\n}\n\n/** `readResourceVersion` 返回的一份文件正文。 */\nexport interface ResourceVersionFile {\n\t/** 资源根内相对路径（POSIX）。 */\n\tpath: string;\n\t/** 字节数。 */\n\tsizeBytes: number;\n\t/** 内容 SHA-256 哈希。 */\n\thash: string;\n\t/** 文件正文（utf8）。 */\n\tcontent: string;\n}\n\n/** `readResourceVersion` 的输出。 */\nexport interface ResourceVersionContent {\n\tresourceId: string;\n\tversionId: string;\n\tversionDir: string;\n\t/** 目录完整 + 有 activation 记录时才 true；否则文件仍可读但版本不可加载。 */\n\tavailable: boolean;\n\tfiles: ResourceVersionFile[];\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 辅助\n// ════════════════════════════════════════════════════════════════════════\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 把 resourceId 转为目录安全名（`:` → `_`，与 candidates.ts/resources.ts 同规则）。 */\nfunction dirSafeId(resourceId: string): string {\n\treturn resourceId.replace(/:/g, \"_\");\n}\n\n/**\n * 递归列出根内全部文件（相对路径 POSIX，按路径排序）。\n * 根可以是目录或单个文件（文件型资源根如 `工作流/{name}.md`）：\n * 文件形态返回一项（relativePath = basename）；不存在返回空数组。\n * O12/E12：三处私有重复收拢为版本模块的共享实现。\n */\nexport function listResourceFiles(root: string): Array<{ absolutePath: string; relativePath: string }> {\n\tif (!existsSync(root)) return [];\n\tconst stat = statSync(root);\n\tif (stat.isFile()) {\n\t\treturn [{ absolutePath: root, relativePath: basename(root) }];\n\t}\n\tconst out: Array<{ absolutePath: string; relativePath: string }> = [];\n\tconst walk = (dir: string) => {\n\t\tfor (const entry of readdirSync(dir, { withFileTypes: true })) {\n\t\t\tconst full = join(dir, entry.name);\n\t\t\tif (entry.isDirectory()) {\n\t\t\t\twalk(full);\n\t\t\t} else if (entry.isFile()) {\n\t\t\t\tout.push({\n\t\t\t\t\tabsolutePath: full,\n\t\t\t\t\trelativePath: relative(root, full).replace(/\\\\/g, \"/\"),\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t};\n\twalk(root);\n\treturn out.sort((a, b) => a.relativePath.localeCompare(b.relativePath));\n}\n\n/**\n * 目录/文件指纹 = `v-{sha256(文件清单[路径,sha256])前12位}`，与 snapshotResourceFiles\n * 同口径：只重算哈希比对，不复制文件（核对不是快照）。\n * O12/E12：activation/control/resources 三处私有重复收拢共享本实现；\n * 文件型资源根（单文件）由 listResourceFiles 统一分派。\n */\nexport function fingerprintResourceRoot(root: string): { versionId: string; fileCount: number } {\n\tconst files = listResourceFiles(root).map((file) => ({\n\t\tpath: file.relativePath,\n\t\thash: createHash(\"sha256\").update(readFileSync(file.absolutePath)).digest(\"hex\"),\n\t}));\n\tconst fingerprint = createHash(\"sha256\")\n\t\t.update(JSON.stringify(files.map((s) => [s.path, s.hash])))\n\t\t.digest(\"hex\")\n\t\t.slice(0, 12);\n\treturn { versionId: `v-${fingerprint}`, fileCount: files.length };\n}\n\n/** 校验 versionId 不能逃出 versions 目录（防 `..`/绝对路径注入）。 */\nfunction isVersionIdSafe(versionId: string): boolean {\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) || /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(versionId);\n}\n\ninterface ActivationRow {\n\tactivation_id: string;\n\tresource_id: string;\n\tfrom_version: string | null;\n\tto_version: string;\n\tkind: string;\n\treason: string | null;\n\tcreated_at: string;\n}\n\n/** 查该资源指定 to_version 的 activation 行（取最新一条）。 */\nfunction getActivationForVersion(store: MemoryStore, resourceId: string, versionId: string): ActivationRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, created_at\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND to_version = ?\n\t\t\t ORDER BY created_at DESC, activation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(resourceId, versionId) as ActivationRow | undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. publishCandidate\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 发布一个 passed 候选为固定版本。\n *\n * 流程：\n * 1. 读候选行；status 须 'passed'，且最新一条 validation verdict 须 'passed'，\n *    否则返回 `{ ok:true, status:\"not_ready\", reason }`。\n * 2. **内部审计门（O11/E08，不可绕过——passed 是终态无出边，审计必须在\n *    publish 内）**：\n *    a. `auditResourceCapabilityCoverage`：extension/command → publishable=false 拒发；\n *    b. `checkOwnerSourceLinksIntact`：problem→candidate→testPlan→validation\n *       四级来源关联仍有效；\n *    c. `auditCandidateForPublish`：范围核对（补传 problem.action 与\n *       CATEGORY_PROFILES policyRefs 经由断言内部查表）+ plan.json 受管输入未改\n *       + run fileChanges 未越区；\n *    d. **已验内容绑定**：重算候选目录当前指纹 vs 验证时记录的指纹（validation\n *       最新行的 case_results 不带指纹——以「发布时候选目录指纹 =\n *       versionId」为界，结合 baseline 版本目录完整性比对防版本目录被换；\n *       验证后改动候选文件 → 指纹变化 → 拒绝发布）。\n * 3. versionId = `v-{sha12(内容清单)}`（幂等）；幂等命中直接返回。\n * 4. 候选目录文件完整复制进 versions 目录；中途 throw → 清理半成品目录后上抛。\n * 5. 全部文件落盘后写 `evolution_activations`（kind='publish'）——版本可用凭据。\n *\n * 不改 effective_version（生效切换是 S9-02 的前置核对 + 单事务）。\n */\nexport async function publishCandidate(\n\tstore: MemoryStore,\n\tinput: PublishCandidateInput,\n): Promise<MemoryResult<PublishCandidateResult | { status: \"not_ready\"; reason: string }>> {\n\tconst now = input.createdAt ?? new Date().toISOString();\n\n\t// 1. 读候选行。\n\tconst candidateRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status, diffs_json\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\n\t\t)\n\t\t.get(input.candidateId) as\n\t\t| {\n\t\t\t\tcandidate_id: string;\n\t\t\t\tproblem_id: string;\n\t\t\t\tresource_id: string;\n\t\t\t\tbase_version: string;\n\t\t\t\ttest_plan_id: string;\n\t\t\t\tstatus: string;\n\t\t\t\tdiffs_json: string;\n\t\t  }\n\t\t| undefined;\n\tif (!candidateRow) {\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\n\t}\n\tif (candidateRow.status !== \"passed\") {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `候选 ${input.candidateId} 状态 ${candidateRow.status}，须为 passed 才能发布`,\n\t\t};\n\t}\n\n\t// 2. 最新一条该候选的 validation 必须 verdict='passed'。\n\tconst latestValidation = store.db\n\t\t.prepare(\n\t\t\t`SELECT validation_id, verdict, case_results_json FROM evolution_validations\n\t\t\t WHERE candidate_id = ?\n\t\t\t ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\n\t\t)\n\t\t.get(input.candidateId) as { validation_id: string; verdict: string; case_results_json: string } | undefined;\n\tif (!latestValidation || latestValidation.verdict !== \"passed\") {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: latestValidation\n\t\t\t\t? `候选 ${input.candidateId} 最新验证判定 ${latestValidation.verdict}，须为 passed 才能发布`\n\t\t\t\t: `候选 ${input.candidateId} 无验证记录，须先完成验证`,\n\t\t};\n\t}\n\n\t// 3. 候选目录必须存在且非空。\n\tconst dirSafeResourceId = dirSafeId(candidateRow.resource_id);\n\tconst candidateDir = join(evolutionPaths(input.paoHome).candidates, dirSafeResourceId, input.candidateId);\n\tconst candidateFiles = listResourceFiles(candidateDir);\n\tif (candidateFiles.length === 0) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `候选目录不存在或无文件:${candidateDir}`,\n\t\t};\n\t}\n\n\t// ════════════════════════════════════════════════════════════════════\n\t// 4. O11/E08 内部审计门（在 publish 内，不可绕过）\n\t// ════════════════════════════════════════════════════════════════════\n\n\t// 4a. 资源行 + 能力覆盖：extension/command → publishable=false 拒发。\n\tconst resourceRow = store.db\n\t\t.prepare(\n\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t\tload_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t)\n\t\t.get(candidateRow.resource_id) as\n\t\t| {\n\t\t\t\tresource_id: string;\n\t\t\t\tkind: string;\n\t\t\t\trelative_root: string;\n\t\t\t\tallowed_ops_json: string;\n\t\t\t\tcapability_scope_json: string;\n\t\t\t\tload_method: string;\n\t\t\t\teffective_version: string | null;\n\t\t\t\tauto_evolution_enabled: number;\n\t\t\t\tregistered_at: string;\n\t\t\t\tupdated_at: string;\n\t\t  }\n\t\t| undefined;\n\tif (!resourceRow) {\n\t\treturn fail(\"invalid_input\", `资源未登记:${candidateRow.resource_id}`, candidateRow.resource_id);\n\t}\n\tconst resource = {\n\t\tresourceId: resourceRow.resource_id,\n\t\tkind: resourceRow.kind as import(\"./types.ts\").EvolutionResourceKind,\n\t\trelativeRoot: resourceRow.relative_root,\n\t\tallowedOps: JSON.parse(resourceRow.allowed_ops_json) as import(\"./types.ts\").EvolutionResourceOp[],\n\t\tcapabilityScope: JSON.parse(resourceRow.capability_scope_json) as string[],\n\t\tloadMethod: resourceRow.load_method as import(\"./types.ts\").EvolutionLoadMethod,\n\t\t...(resourceRow.effective_version === null ? {} : { effectiveVersion: resourceRow.effective_version }),\n\t\tautoEvolutionEnabled: resourceRow.auto_evolution_enabled === 1,\n\t\tregisteredAt: resourceRow.registered_at,\n\t\tupdatedAt: resourceRow.updated_at,\n\t};\n\tconst coverage = auditResourceCapabilityCoverage(resource);\n\tif (!coverage.publishable) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason:\n\t\t\t\t`资源 ${resource.resourceId}（kind=${resource.kind}）能力未覆盖，不可自动发布：` +\n\t\t\t\tcoverage.gaps.map((g) => `${g.capability}（${g.reason}）`).join(\"；\"),\n\t\t};\n\t}\n\n\t// 4b. 来源依据仍有效：problem→candidate→testPlan→validation 四级 owner。\n\tconst sourceViolation = checkOwnerSourceLinksIntact(store.db, {\n\t\towners: [\n\t\t\t{ ownerKind: \"problem\", ownerId: candidateRow.problem_id, label: \"问题\" },\n\t\t\t{ ownerKind: \"candidate\", ownerId: input.candidateId, label: \"候选\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: candidateRow.test_plan_id, label: \"冻结计划\" },\n\t\t\t{ ownerKind: \"validation\", ownerId: latestValidation.validation_id, label: \"验证\" },\n\t\t],\n\t});\n\tif (sourceViolation !== undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `来源依据失效：${sourceViolation}`,\n\t\t};\n\t}\n\n\t// 4c. 候选边界核对：scope（含 problem.action + CATEGORY_PROFILES policyRefs\n\t//     由断言按 kind 内部查表）+ plan.json 未改 + run fileChanges 未越区。\n\tconst problemRow = store.db\n\t\t.prepare(`SELECT action FROM evolution_problems WHERE problem_id = ?`)\n\t\t.get(candidateRow.problem_id) as { action: string | null } | undefined;\n\tconst planPath = join(evolutionPaths(input.paoHome).validations, candidateRow.test_plan_id, \"plan.json\");\n\t// plan.json 实质篡改核对（O11/E08）：testPlanId 尾段本就是 freeze 时对\n\t// 全部用例的 sha12 指纹——从盘上 plan.json 重算指纹与 testPlanId 比对；\n\t// 快照自比（snapshotManagedFile 对同一文件抓两次）只能证明「此刻可读」，\n\t// 不能证明未改。文件缺失/不可解析/指纹不符一律拒发。\n\tconst planSnapshotBefore = snapshotManagedFile(planPath);\n\tif (planSnapshotBefore.hash === undefined) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `受管输入 plan.json 缺失:${planPath}（冻结验收依据不存在，不能发布）`,\n\t\t};\n\t}\n\ttry {\n\t\tconst planJson = JSON.parse(readFileSync(planPath, \"utf8\")) as ValidationPlan;\n\t\tconst allCases = [...planJson.reproduction, ...planJson.normal, ...planJson.holdout];\n\t\tconst expectedSuffix = candidateRow.test_plan_id.split(\"-\").at(-1);\n\t\tif (expectedSuffix === undefined || testPlanCaseFingerprint(allCases) !== expectedSuffix) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"not_ready\",\n\t\t\t\treason:\n\t\t\t\t\t`受管输入 plan.json 内容与 testPlanId ${candidateRow.test_plan_id} 指纹不符` +\n\t\t\t\t\t`（冻结验收依据被篡改，发布内容与已验证收依据不符）`,\n\t\t\t};\n\t\t}\n\t} catch {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `受管输入 plan.json 不可解析:${planPath}（冻结验收依据损坏，不能发布）`,\n\t\t};\n\t}\n\t// runFileChanges：最新验证 case_results 里双侧 fileChanges 汇总。\n\tconst runFileChanges: Record<string, string>[] = [];\n\ttry {\n\t\tconst caseResults = JSON.parse(latestValidation.case_results_json) as Array<{\n\t\t\tbaseline?: { fileChanges?: Record<string, string> };\n\t\t\tcandidate?: { fileChanges?: Record<string, string> };\n\t\t}>;\n\t\tfor (const cr of caseResults) {\n\t\t\tif (cr.baseline?.fileChanges) runFileChanges.push(cr.baseline.fileChanges);\n\t\t\tif (cr.candidate?.fileChanges) runFileChanges.push(cr.candidate.fileChanges);\n\t\t}\n\t} catch {\n\t\t// case_results 非 JSON → 跳过 fileChanges 核对（不写死，不落隐性失败）。\n\t}\n\tconst diffs = JSON.parse(candidateRow.diffs_json) as EvolutionFileDiff[];\n\tconst candidate = {\n\t\tcandidateId: input.candidateId,\n\t\tproblemId: candidateRow.problem_id,\n\t\tresourceId: candidateRow.resource_id,\n\t\tbaseVersion: candidateRow.base_version,\n\t\ttestPlanId: candidateRow.test_plan_id,\n\t\tdiffs,\n\t\trationale: \"\",\n\t\tusageRefs: [],\n\t\tstatus: \"passed\" as const,\n\t\tcreatedAt: now,\n\t\tupdatedAt: now,\n\t};\n\tconst audit = auditCandidateForPublish(store, {\n\t\tcandidate,\n\t\tpaoHome: input.paoHome,\n\t\tplanSnapshotBefore,\n\t\trunFileChanges,\n\t\t...(problemRow?.action !== null && problemRow?.action !== undefined\n\t\t\t? { action: problemRow.action as \"modify\" | \"delete\" | \"merge\" }\n\t\t\t: {}),\n\t});\n\tif (!audit.ok) return audit;\n\tif (!audit.eligible) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason: `发布前边界核对未过:${audit.violations.join(\"；\")}`,\n\t\t};\n\t}\n\n\t// 4d. 已验内容绑定：\n\t// - baseline 版本目录完整性（`versions/<baseVersion>/` 指纹 === baseVersion\n\t//   值本身——versionId 即清单哈希；版本目录被换 → 指纹对不上 → 拒绝）。\n\tconst baselineVersionDir = join(\n\t\tevolutionPaths(input.paoHome).versions,\n\t\tdirSafeResourceId,\n\t\tcandidateRow.base_version,\n\t);\n\tif (existsSync(baselineVersionDir)) {\n\t\tconst baselineNow = fingerprintResourceRoot(baselineVersionDir);\n\t\tif (/^v-[0-9a-f]{12}$/.test(candidateRow.base_version) && baselineNow.versionId !== candidateRow.base_version) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tstatus: \"not_ready\",\n\t\t\t\treason:\n\t\t\t\t\t`baseline 版本目录指纹不匹配:${baselineVersionDir}（期望 ${candidateRow.base_version}，` +\n\t\t\t\t\t`实际 ${baselineNow.versionId}——验证所依据的旧版正文被换，发布内容不可信）`,\n\t\t\t};\n\t\t}\n\t}\n\t// - 候选目录指纹 vs 验证时回执记录的指纹（runner 在每次 run 对副本源目录\n\t//   算 `v-{sha12}` 写进 receipt.resourceFingerprint）：不一致 → 验证后\n\t//   候选正文被改 → 拒绝发布。无指纹回执（旧回执/未跑验证）时退回\n\t//   「发布时指纹即 versionId」的固有绑定（天然成立，不新增校验文件）。\n\tconst candidateFingerprint = fingerprintResourceRoot(candidateDir);\n\tconst runsDir = join(evolutionPaths(input.paoHome).validations, candidateRow.test_plan_id, \"runs\");\n\tconst verifiedFingerprints = new Set<string>();\n\tif (existsSync(runsDir)) {\n\t\tfor (const file of readdirSync(runsDir)) {\n\t\t\tif (!file.endsWith(\".json\")) continue;\n\t\t\ttry {\n\t\t\t\tconst receipt = JSON.parse(\n\t\t\t\t\treadFileSync(join(runsDir, file), \"utf8\"),\n\t\t\t\t) as { side?: string; resourceFingerprint?: string };\n\t\t\t\tif (receipt.side === \"candidate\" && typeof receipt.resourceFingerprint === \"string\") {\n\t\t\t\t\tverifiedFingerprints.add(receipt.resourceFingerprint);\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 非 JSON 回执跳过。\n\t\t\t}\n\t\t}\n\t}\n\tif (verifiedFingerprints.size > 0 && !verifiedFingerprints.has(candidateFingerprint.versionId)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tstatus: \"not_ready\",\n\t\t\treason:\n\t\t\t\t`候选目录当前指纹 ${candidateFingerprint.versionId} 与验证时回执指纹 ` +\n\t\t\t\t`${[...verifiedFingerprints].join(\"、\")} 不一致——验证后候选正文被改动，发布内容与已验内容不符`,\n\t\t};\n\t}\n\n\t// 5. versionId = 内容清单哈希短前缀（同 snapshotResourceFiles 口径，幂等）。\n\tconst versionId = candidateFingerprint.versionId;\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, versionId);\n\n\t// 5. 幂等：同 (resourceId, versionId) 已发布且目录完整 → 直接返回。\n\tconst existing = getActivationForVersion(store, candidateRow.resource_id, versionId);\n\tconst existingFiles = listResourceFiles(versionDir);\n\tif (existing && existing.kind === \"publish\" && existingFiles.length === candidateFiles.length) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tversionId,\n\t\t\tversionDir,\n\t\t\tfilesPublished: existingFiles.length,\n\t\t\tpublished: false,\n\t\t};\n\t}\n\n\t// 6. 复制候选目录 → 版本目录。复制中途失败：清理半成品目录，原样上抛，\n\t//    不写任何 activation（部分目录不构成可加载版本）。\n\ttry {\n\t\tmkdirSync(versionDir, { recursive: true });\n\t\tfor (const file of candidateFiles) {\n\t\t\tconst dest = join(versionDir, file.relativePath);\n\t\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\t\tcopyFileSync(file.absolutePath, dest);\n\t\t}\n\t} catch (error) {\n\t\ttry {\n\t\t\trmSync(versionDir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 清理失败不掩盖原始复制错误。\n\t\t}\n\t\tthrow error;\n\t}\n\n\t// 7. 全部文件落盘后写版本可用凭据（publish activation；from_version 记候选的 baseVersion）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`act-${randomUUID()}`,\n\t\t\tcandidateRow.resource_id,\n\t\t\tcandidateRow.base_version,\n\t\t\tversionId,\n\t\t\t`发布候选 ${input.candidateId}（验证 ${latestValidation.validation_id}）`,\n\t\t\tJSON.stringify({ candidateId: input.candidateId, validationId: latestValidation.validation_id }),\n\t\t\tnow,\n\t\t);\n\n\treturn {\n\t\tok: true,\n\t\tversionId,\n\t\tversionDir,\n\t\tfilesPublished: candidateFiles.length,\n\t\tpublished: true,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. listResourceVersions\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 列出一个资源的版本时间线：盘上 `versions/<dirSafeResourceId>/<versionId>/`\n * 目录 ∪ `evolution_activations` 记录，按 activation 时间排序（无 activation 的\n * 目录排尾，available=false）。\n */\nexport function listResourceVersions(\n\tstore: MemoryStore,\n\tresourceId: string,\n\tpaoHome: string,\n): MemoryResult<{ items: ResourceVersionEntry[] }> {\n\tconst dirSafeResourceId = dirSafeId(resourceId);\n\tconst resourceVersionsDir = join(evolutionPaths(paoHome).versions, dirSafeResourceId);\n\n\t// 盘上版本目录。\n\tconst onDisk = new Map<string, { versionDir: string; files: string[]; complete: boolean }>();\n\tif (existsSync(resourceVersionsDir)) {\n\t\tfor (const entry of readdirSync(resourceVersionsDir, { withFileTypes: true })) {\n\t\t\tif (!entry.isDirectory()) continue;\n\t\t\tconst versionDir = join(resourceVersionsDir, entry.name);\n\t\t\tconst files = listResourceFiles(versionDir).map((f) => f.relativePath);\n\t\t\tonDisk.set(entry.name, { versionDir, files, complete: files.length > 0 });\n\t\t}\n\t}\n\n\t// activation 记录（按 to_version 归并）。\n\tconst activationRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT activation_id, resource_id, from_version, to_version, kind, reason, created_at\n\t\t\t FROM evolution_activations WHERE resource_id = ?\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\n\t\t)\n\t\t.all(resourceId) as unknown as ActivationRow[];\n\tconst activationByVersion = new Map<string, ActivationRow>();\n\tfor (const row of activationRows) {\n\t\t// 同版本多条取最新（后写覆盖）。\n\t\tactivationByVersion.set(row.to_version, row);\n\t}\n\n\tconst versionIds = new Set<string>([...onDisk.keys(), ...activationByVersion.keys()]);\n\tconst items: ResourceVersionEntry[] = [...versionIds].map((versionId) => {\n\t\tconst disk = onDisk.get(versionId);\n\t\tconst act = activationByVersion.get(versionId);\n\t\tconst complete = disk?.complete ?? false;\n\t\treturn {\n\t\t\tversionId,\n\t\t\tversionDir: disk?.versionDir ?? join(resourceVersionsDir, versionId),\n\t\t\tfiles: disk?.files ?? [],\n\t\t\tcomplete,\n\t\t\t...(act\n\t\t\t\t? {\n\t\t\t\t\t\tactivation: {\n\t\t\t\t\t\t\tactivationId: act.activation_id,\n\t\t\t\t\t\t\tkind: act.kind as \"publish\" | \"restore\" | \"rollback\",\n\t\t\t\t\t\t\t...(act.from_version === null ? {} : { fromVersion: act.from_version }),\n\t\t\t\t\t\t\t...(act.reason === null ? {} : { reason: act.reason }),\n\t\t\t\t\t\t\tcreatedAt: act.created_at,\n\t\t\t\t\t\t},\n\t\t\t\t\t}\n\t\t\t\t: {}),\n\t\t\tavailable: complete && act !== undefined,\n\t\t};\n\t});\n\n\t// 有 activation 的按 activation 时间排；无 activation 的排尾（按 versionId 字典序）。\n\titems.sort((a, b) => {\n\t\tif (a.activation && b.activation) {\n\t\t\treturn a.activation.createdAt.localeCompare(b.activation.createdAt);\n\t\t}\n\t\tif (a.activation) return -1;\n\t\tif (b.activation) return 1;\n\t\treturn a.versionId.localeCompare(b.versionId);\n\t});\n\n\treturn { ok: true, items };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. readResourceVersion\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 读指定版本目录的文件清单与正文（utf8）。\n * 目录不存在 → `source_missing`；目录存在但无 activation 或为空 → 文件仍返回，\n * `available=false`（调用方据此不把该版本当可加载版本）。\n */\nexport function readResourceVersion(\n\tstore: MemoryStore,\n\tinput: ReadResourceVersionInput,\n): MemoryResult<ResourceVersionContent> {\n\tif (!isVersionIdSafe(input.versionId)) {\n\t\treturn fail(\"invalid_input\", `非法 versionId:${input.versionId}`, input.versionId);\n\t}\n\tconst dirSafeResourceId = dirSafeId(input.resourceId);\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafeResourceId, input.versionId);\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) {\n\t\treturn fail(\"source_missing\", `版本目录不存在:${versionDir}`, input.versionId);\n\t}\n\n\tconst diskFiles = listResourceFiles(versionDir);\n\tconst files: ResourceVersionFile[] = diskFiles.map((file) => {\n\t\tconst content = readFileSync(file.absolutePath);\n\t\treturn {\n\t\t\tpath: file.relativePath,\n\t\t\tsizeBytes: content.length,\n\t\t\thash: createHash(\"sha256\").update(content).digest(\"hex\"),\n\t\t\tcontent: content.toString(\"utf8\"),\n\t\t};\n\t});\n\n\tconst act = getActivationForVersion(store, input.resourceId, input.versionId);\n\treturn {\n\t\tok: true,\n\t\tresourceId: input.resourceId,\n\t\tversionId: input.versionId,\n\t\tversionDir,\n\t\tavailable: files.length > 0 && act !== undefined,\n\t\tfiles,\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 扇出执行(卡0007):把一批卡并行派给一次性 worker。\n * - 拉起全部经 WorkerRunner.run(进程全部进登记册),本模块零自建进程管理代码; *   cancel/stopAll 全部复用 runner,本模块不杀进程。\n */\n\nimport { type BoundaryWriteCheck, checkBoundaryWriterandomUUID } from \"../cards/baseline.tsnode:crypto\";\nimport {\n\tchangeCardStatus,\n\tdiffAgainstBaseline,\n\ttypeFailureRouting,\n\tParsedCardBoundaryWriteCheck,\n\ttypeReceiptOutcome,\n\treadCard,\n\trouteFailure,\ncheckBoundaryWrite } from \"../cards/index.tsbaseline.tsFailureRouting,\n\ttypeParsedCard,\n\ttype ReceiptOutcome,\n\treadCard,\n\trouteFailure,\n../cards/index.ts\nimport { type FrictionEventIdentity, recordFrictionDraft } from \"../friction/drafts.ts\";\nimport { resolveMemoryScope } from \"../memory/project-identity.ts\";\treturn lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,174]}}},{"equalLines":{"line_count":7}},{"diffOp":{"equal":{"range":[174,243]}}},{"diffOp":{"insert":{"range":[243,244]}}},{"diffOp":{"equal":{"range":[244,253]}}},{"diffOp":{"delete":{"range":[253,296]}}},{"diffOp":{"insert":{"range":[296,306]}}},{"diffOp":{"equal":{"range":[306,315]}}},{"diffOp":{"delete":{"range":[315,335]}}},{"diffOp":{"insert":{"range":[335,346]}}},{"diffOp":{"equal":{"range":[346,348]}}},{"diffOp":{"equal":{"range":[348,357]}}},{"diffOp":{"delete":{"range":[357,404]}}},{"diffOp":{"equal":{"range":[306,307]}}},{"diffOp":{"delete":{"range":[404,421]}}},{"diffOp":{"equal":{"range":[253,258]}}},{"diffOp":{"delete":{"range":[421,431]}}},{"diffOp":{"insert":{"range":[431,449]}}},{"diffOp":{"equal":{"range":[449,450]}}},{"diffOp":{"delete":{"range":[450,456]}}},{"diffOp":{"equal":{"range":[306,307]}}},{"diffOp":{"delete":{"range":[456,498]}}},{"diffOp":{"insert":{"range":[498,517]}}},{"diffOp":{"equal":{"range":[517,534]}}},{"diffOp":{"delete":{"range":[534,542]}}},{"diffOp":{"insert":{"range":[542,553]}}},{"diffOp":{"equal":{"range":[346,348]}}},{"diffOp":{"equal":{"range":[348,357]}}},{"diffOp":{"insert":{"range":[357,404]}}},{"diffOp":{"equal":{"range":[306,307]}}},{"diffOp":{"delete":{"range":[296,306]}}},{"diffOp":{"insert":{"range":[553,574]}}},{"diffOp":{"equal":{"range":[306,307]}}},{"diffOp":{"insert":{"range":[574,634]}}},{"diffOp":{"equal":{"range":[517,525]}}},{"diffOp":{"delete":{"range":[335,346]}}},{"diffOp":{"insert":{"range":[634,651]}}},{"diffOp":{"equal":{"range":[346,348]}}},{"diffOp":{"equal":{"range":[651,808]}}},{"equalLines":{"line_count":485}},{"diffOp":{"equal":{"range":[808,836]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\fanout\\execute.ts"},"span":[1039,1122],"sourceCode":"/**\n * 扇出执行(卡0007):把一批卡并行派给一次性 worker。\n * - 拉起全部经 WorkerRunner.run(进程全部进登记册),本模块零自建进程管理代码;\n * - 回执逐卡经 appendReceipt 落卡(卡号+尝试号,不混批);\n * - 认领(R14/架构 §14)与工具层 pao_change_status 走同一快照入口 snapshotClaimBaseline,交回执比对有基线;\n *   单卡链路(校验→认领＋基线快照→构建 runOptions→拉起→登记)已提取为 worker 模块\n *   dispatch-core 共享核心,本模块与 pao_dispatch_card 同源调用(依赖方向 fanout→worker 单向);\n * - 交回执时 §14 越界核查:git 真值(当前 status 减认领基线)比对回执声明产物,虚报/越界结构化亮出;\n * - 并发上限约束调度名额；同一执行根仍由长锁互斥，独立执行根可并行；超限排队不丢弃;\n * - 停止契约 R05:先阻新调用(补位车道停拉)→ cancel 在跑进程并等真退出 → 才返回;\n *   cancel/stopAll 全部复用 runner,本模块不杀进程。\n */\nimport { type BoundaryWriteCheck, checkBoundaryWrite } from \"../cards/baseline.ts\";\nimport {\n\tchangeCardStatus,\n\tdiffAgainstBaseline,\n\ttype FailureRouting,\n\ttype ParsedCard,\n\ttype ReceiptOutcome,\n\treadCard,\n\trouteFailure,\n} from \"../cards/index.ts\";\nimport { randomUUID } from \"node:crypto\";\nimport { type FrictionEventIdentity, recordFrictionDraft } from \"../friction/drafts.ts\";\nimport { resolveMemoryScope } from \"../memory/project-identity.ts\";\nimport { logWarn } from \"../shared/log.ts\";\nimport { nowString } from \"../shared/time.ts\";\nimport type { WorkerWorkflowPort } from \"../shared/workflow-port.ts\";\nimport { buildDispatchBudgetGate } from \"../usage/dispatch-gate.ts\";\nimport {\n\tappendDispatchReceipt,\n\tclassifyWorkerFailure,\n\ttype DispatchBaseline,\n\texecuteDispatch,\n\tFANOUT_OPERATOR,\n\tlocateDispatchCard,\n\tprojectRootForCards,\n\ttaskStateRoutingLine,\n} from \"../worker/dispatch-core.ts\";\nimport { PaoWorkerError } from \"../worker/errors.ts\";\nimport {\n\tdefaultWorkerRunner,\n\ttype WorkerReceipt,\n\ttype WorkerRunner,\n\ttype WorkerRunOptions,\n\ttype WorkerStatus,\n} from \"../worker/index.ts\";\nimport { resolveLocalWorkerSupervisionRoute } from \"../worker/supervision.ts\";\nimport { createSingleRootWorktreeHost, type PaoWorktreeHost, type WorktreeTarget } from \"../worktrees/types.ts\";\nimport { type FanoutBatchPlan, planFanout } from \"./plan.ts\";\n\n/** 扇出以主控身份做 owner 侧动作(认领/重开);共享核心 claimCardForDispatch 的操作者 */\nconst OPERATOR = FANOUT_OPERATOR;\n\n/** 单卡终态:runner 四态映射 + 未拉起(卡状态不允许或定位失败,进程从未启动) */\nexport type FanoutFinalState = \"成功\" | \"失败\" | \"结果未知\" | \"取消\" | \"未拉起\";\n\nconst FINAL_STATE_BY_STATUS: Record<WorkerStatus, FanoutFinalState> = {\n\tsuccess: \"成功\",\n\tfailed: \"失败\",\n\tunknown: \"结果未知\",\n\tcanceled: \"取消\",\n};\n\nexport interface FanoutCardResult {\n\t卡号: string;\n\t终态: FanoutFinalState;\n\t/** 落卡回执的尝试号(= 认领后的卡面尝试);未拉起时缺省 */\n\tattempt?: number;\n\t/** worker 回执摘要(≤3 行) */\n\t摘要?: string;\n\t失败类型?: ReturnType<typeof classifyWorkerFailure>;\n\t/** 失败按四型的路由建议(与 cards 的 routeFailure 同口径);非失败缺省 */\n\t路由建议?: FailureRouting;\n\t证据路径?: string;\n\t/** 回执落卡结果(appendReceipt 的 kind;自拟回执回调时为 \"已记录\") */\n\t回执落卡?: ReceiptOutcome[\"kind\"] | \"未落卡\";\n\t落卡说明?: string;\n\t未拉起原因?: string;\n\t/** runner.run 抛错时的原因(只发生在卡/运行器已被取消时) */\n\t错误?: string;\n\t持续毫秒?: number;\n\t/**\n\t * 认领基线快照结果(R14/架构 §14):扇出认领与工具层 pao_change_status 走同一快照入口\n\t * snapshotClaimBaseline(经 worker 模块 dispatch-core 共享核心),交回执比对\n\t * (diffAgainstBaseline)与交卷清点以此为基线——用户既有脏改动不算 worker 的账。\n\t * 可用:false 时原因如实标注(非 git 工作区等),不静默;非认领(未拉起/终态卡)缺省。\n\t */\n\t认领基线?: DispatchBaseline;\n\t/**\n\t * §14 越界核查:git 真值(当前 status 减认领基线)比对回执声明的产物清单,\n\t * 虚报/越界/干净结构化亮出(文件级精度)。有认领快照且回执在手时才查;\n\t * 手动会话主控看标记自行判断,工作流模式自动插人工门待 §11 工作流引擎(挂点在调用侧)。\n\t */\n\t越界核查?: BoundaryWriteCheck;\n\t/** S5 包2 派发告警(工具表外名截严/仓内技能未经本地确认被忽略);无告警缺省 */\n\t派发告警?: string[];\n\t/** S5 包4 任务态自报(completed/completed_with_deviations/blocked/checkpoint);旧链路缺省。\n\t *  标签路由行由 formatFanoutSummary 现算（单源 dispatch-core taskStateRoutingLine），不另存副本。 */\n\t任务态?: WorkerReceipt[\"任务态\"];\n}\n\nexport interface FanoutSummary {\n\tplan: FanoutBatchPlan;\n\t/** 批量派单理由(工具层必填;executor 直调可缺省)——随摘要输出,供上级审查 */\n\t理由?: string;\n\t/** 每卡终态,按拉起顺序排列 */\n\t结果: FanoutCardResult[];\n\tcount: { 成功: number; 失败: number; 结果未知: number; 取消: number; 未拉起: number };\n\t/** 是否因取消信号中途停止(在跑进程已树杀确认,排队卡不再拉起) */\n\t已停止: boolean;\n\t/** 每张卡都有终态记录(无遗漏) */\n\t全部完成: boolean;\n}\n\nexport interface FanoutDispatchInput {\n\t/** 卡引用列表(卡0017 / 卡#17 / 17),去重保序 */\n\t卡号列表: readonly string[];\n\t/** 并发上限,默认 2，硬上限 8 */\n\t并发上限?: number;\n\t/** 任务工作区卡目录 */\n\tcardsDir: string;\n\t/**\n\t * 批量派单理由(pao_fanout 工具必填并留痕):随每条登记表记录(派单理由)与聚合摘要带出,\n\t * 供上级审查。executor 直调可缺省(既有测试/宿主注入路径不强制)。\n\t */\n\t理由?: string;\n\t/**\n\t * 调用方会话 id（pao_fanout 工具层取 pi 工具上下文 sessionManager.getSessionId）:\n\t * 注入 workflowCheck 做实例 owner 重核——T03 收口,单卡/扇出/自动链三入口准入一致;\n\t * 缺省（直调无会话上下文,既有测试/宿主注入路径）不核 owner,行为不变。\n\t */\n\towner?: string;\n}\n\nexport interface FanoutDispatchOptions {\n\t/** 本次派发使用的权威工作树宿主及目标；正式入口必填。 */\n\tworktreeHost?: PaoWorktreeHost;\n\tworktreeTarget?: WorktreeTarget;\n\texpectedInputVersion?: string;\n\t/** 运行器;缺省 = worker 模块 defaultWorkerRunner(进程进同一登记册,pao_stop_background能全停) */\n\t运行器?: WorkerRunner;\n\t/**\n\t * 回执落卡回调;缺省 = 重读卡 → appendReceipt(尝试号 = 卡面当前尝试,失败带缺省分型)。\n\t * 注入可覆盖(测试/宿主);无论哪种,逐卡调用,不混批。\n\t */\n\t交回执?: (card: ParsedCard, receipt: WorkerReceipt) => ReceiptOutcome | Promise<ReceiptOutcome>;\n\t/** 当前回执实际落卡后由宿主投递直接上级；不代替回执、验收或状态机。 */\n\tonReceipt?: (card: ParsedCard, receipt: WorkerReceipt) => void | Promise<void>;\n\t/** 透传给每次 WorkerRunner.run 的公共参数(cwd/超时/环境变量/工具白名单/证据目录等) */\n\t公共参数?: Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">>;\n\t/** 按卡追加运行参数(测试按卡注入环境变量/ sleep 时长等);与公共参数浅合并,每卡参数优先 */\n\t每卡参数?: (card: ParsedCard) => Partial<Omit<WorkerRunOptions, \"卡号\" | \"提示词\">>;\n\t/** 批次取消信号:中止 = 先阻新卡(车道停拉)→ cancel 在跑进程(树杀+确认) */\n\t信号?: AbortSignal;\n\t/** 时间源(测试注入);缺省 new Date() */\n\t时间?: () => Date;\n\tpaoHome?: string;\n\t/** 工作流解释端口（派前校验+监督路由）;由装配入口注入,fanout 不直接依赖 workflow。 */\n\tworkflow: WorkerWorkflowPort;\n}\n\nfunction errorMessage(error: unknown): string {\n\treturn error instanceof Error ? error.message : String(error);\n}\n\n/** 与自动链同口径：changes 一旦出现（包括 []）就优先，只有缺省时才回落 artifact_path。 */\nfunction receiptDeclarations(receipt: WorkerReceipt): string[] {\n\treturn receipt.changes?.map((change) => change.路径) ?? receipt.artifact_path ?? [];\n}\n\nfunction summarize(\n\tplan: FanoutBatchPlan,\n\tinput: FanoutDispatchInput,\n\tresults: Map<string, FanoutCardResult>,\n\tstopped: boolean,\n): FanoutSummary {\n\tconst count = { 成功: 0, 失败: 0, 结果未知: 0, 取消: 0, 未拉起: 0 };\n\tlet fallbackNote = 0;\n\tconst ordered: FanoutCardResult[] = plan.拉起顺序.map((cardNo) => {\n\t\tconst known = results.get(cardNo);\n\t\tif (known) return known;\n\t\tfallbackNote++;\n\t\t// 补位车道因停止提前收工,排队卡从未拉起:取消(停止语义),不算结果未知\n\t\treturn stopped\n\t\t\t? { 卡号: cardNo, 终态: \"取消\", 未拉起原因: \"扇出已停止,该卡仍在排队,未拉起\" }\n\t\t\t: { 卡号: cardNo, 终态: \"结果未知\", 错误: \"无执行记录(内部异常)\" };\n\t});\n\tfor (const result of ordered) count[result.终态]++;\n\treturn {\n\t\t...(input.理由 ? { 理由: input.理由 } : {}),\n\t\tplan: plan,\n\t\t结果: ordered,\n\t\tcount: count,\n\t\t已停止: stopped,\n\t\t全部完成: fallbackNote === 0 || stopped,\n\t};\n}\n\n/**\n * 执行一次扇出:定位卡 → 逐卡认领(或记录不拉起原因)→ 补位式并发执行 → 逐卡落回执 → 聚合摘要。\n * 全部卡有了终态才返回(前台等待完成;进程树归属主会话,关闭即停,无常驻)。\n */\nexport async function executeFanout(\n\tinput: FanoutDispatchInput,\n\toptions: FanoutDispatchOptions,\n): Promise<FanoutSummary> {\n\tconst projectRoot = projectRootForCards(input.cardsDir);\n\tconst worktreeHost = options.worktreeHost ?? createSingleRootWorktreeHost(projectRoot);\n\tconst worktreeTarget = options.worktreeTarget ?? { kind: \"primary\" as const };\n\tconst runner = options.运行器 ?? defaultWorkerRunner;\n\tconst now = options.时间 ?? (() => new Date());\n\t// O10/E02：本次扇出的稳定身份——一次 executeFanout 一个 runId，逐卡事件\n\t// 追加卡号形成「同一次停止波及的不同卡」各自的唯一 eventId；会话身份\n\t// 取 input.owner（工具层注入的调用方 sessionId），projectId 经\n\t// resolveMemoryScope 推导，不在本模块猜全局。\n\tconst runId = randomUUID();\n\tconst frictionScope = resolveMemoryScope(\n\t\tprojectRoot,\n\t\t{ ...(input.owner === undefined ? {} : { sessionId: input.owner }) },\n\t\toptions.paoHome ?? process.env.PAO_HOME?.trim(),\n\t);\n\tconst frictionIdentity = (cardNo: string, eventId: string): FrictionEventIdentity => ({\n\t\teventId: `fanout:${runId}:${cardNo}:${eventId}`,\n\t\tprojectId: frictionScope.projectId,\n\t\t...(frictionScope.taskId === undefined ? {} : { taskId: frictionScope.taskId }),\n\t\t...(input.owner === undefined ? {} : { sessionId: input.owner }),\n\t});\n\tconst plan = planFanout(input.卡号列表, input.并发上限);\n\tconst results = new Map<string, FanoutCardResult>();\n\n\t// 拉起前准备(串行):定位卡 + 认领 + 认领基线快照(共享核心 dispatch-core);失败/不满足的卡记 未拉起,不进执行队列\n\tconst runnable: { cardNo: string; card: ParsedCard }[] = [];\n\tfor (const cardNo of plan.拉起顺序) {\n\t\ttry {\n\t\t\trunnable.push({ cardNo: cardNo, card: locateDispatchCard(input.cardsDir, cardNo) });\n\t\t} catch (error) {\n\t\t\tresults.set(cardNo, { 卡号: cardNo, 终态: \"未拉起\", 未拉起原因: errorMessage(error) });\n\t\t}\n\t}\n\n\t// ── 补位式执行:并发上限个车道,一个完成立刻从队列补位拉下一张,不按波次等待 ──\n\tconst stopped = { value: options.信号?.aborted ?? false };\n\tconst claimedCards = new Set<string>();\n\tconst markStopped = (): void => {\n\t\tstopped.value = true;\n\t};\n\toptions.信号?.addEventListener(\"abort\", markStopped, { once: true });\n\tlet next = 0;\n\n\tconst runOne = async (item: (typeof runnable)[number]): Promise<FanoutCardResult> => {\n\t\tconst { cardNo } = item;\n\t\tconst startedAt = Date.now();\n\t\ttry {\n\t\t\tlet receiptDelivery: { card: ParsedCard; receipt: WorkerReceipt } | undefined;\n\t\t\tconst dispatched = await executeDispatch<FanoutCardResult>(\n\t\t\t\t{\n\t\t\t\t\tcardsDir: input.cardsDir,\n\t\t\t\t\tcard_no: cardNo,\n\t\t\t\t\toperator: OPERATOR,\n\t\t\t\t\ttime: nowString(now()),\n\t\t\t\t\tdispatch_reason: input.理由,\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t运行器: runner,\n\t\t\t\t\tpaoHome: options.paoHome ?? process.env.PAO_HOME?.trim(),\n\t\t\t\t\tworktreeHost,\n\t\t\t\t\tworktreeTarget,\n\t\t\t\t\t...(options.expectedInputVersion !== undefined\n\t\t\t\t\t\t? { expectedInputVersion: options.expectedInputVersion }\n\t\t\t\t\t\t: {}),\n\t\t\t\t\t// 工作流派发校验（T02 装配注入,T03 owner 收口）:扇出派工作流卡同样过\n\t\t\t\t\t// 实例/轮次/owner/暂停/冻结版本校验,与单卡/自动链同判,不绕行。\n\t\t\t\t\tworkflowCheck: (card) =>\n\t\t\t\t\t\toptions.workflow.resolveDispatch(card, {\n\t\t\t\t\t\t\tcardsDir: input.cardsDir,\n\t\t\t\t\t\t\tpaoHome: options.paoHome ?? process.env.PAO_HOME?.trim(),\n\t\t\t\t\t\t\towner: input.owner,\n\t\t\t\t\t\t}),\n\t\t\t\t\t解析监督路由: (card) => {\n\t\t\t\t\t\tconst routeInput = {\n\t\t\t\t\t\t\tcardNo: String(card.card_no),\n\t\t\t\t\t\t\tcardsDir: input.cardsDir,\n\t\t\t\t\t\t\toperator: OPERATOR,\n\t\t\t\t\t\t\townerSession: input.owner,\n\t\t\t\t\t\t\tgoal: card.frontmatter.goal ?? \"\",\n\t\t\t\t\t\t};\n\t\t\t\t\t\treturn (\n\t\t\t\t\t\t\toptions.workflow.resolveSupervisionRoute(card, routeInput) ??\n\t\t\t\t\t\t\tresolveLocalWorkerSupervisionRoute(card, routeInput) ??\n\t\t\t\t\t\t\tnull\n\t\t\t\t\t\t);\n\t\t\t\t\t},\n\t\t\t\t\t// 总预算门禁（H0）:与单卡/自动链共用同一个工厂（usage/dispatch-gate 的\n\t\t\t\t\t// buildDispatchBudgetGate），判据与拒绝文案不可能分叉。没授权总预算时返回\n\t\t\t\t\t// undefined＝这条路行为与接线前逐字一致。扇出是最可能大额花钱的入口，\n\t\t\t\t\t// 不接这一处等于「并发不重复授额」在外派上是空的。\n\t\t\t\t\t预算门禁: buildDispatchBudgetGate({ paoHome: options.paoHome ?? process.env.PAO_HOME?.trim() }),\n\t\t\t\t\t并发上限: plan.并发上限,\n\t\t\t\t\t等待名额: true,\n\t\t\t\t\t公共参数: options.公共参数,\n\t\t\t\t\t每卡参数: options.每卡参数,\n\t\t\t\t\t信号: options.信号,\n\t\t\t\t\t认领: (claim) => {\n\t\t\t\t\t\tclaimedCards.add(claim.card.path);\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tasync (claimed, receipt): Promise<FanoutCardResult> => {\n\t\t\t\t\tconst { card, 尝试号: attempt, claimBaseline } = claimed;\n\t\t\t\t\tlet writeCard: FanoutCardResult[\"回执落卡\"];\n\t\t\t\t\tlet writeCardNote: string | undefined;\n\t\t\t\t\ttry {\n\t\t\t\t\t\tconst outcome = options.交回执\n\t\t\t\t\t\t\t? await options.交回执(card, receipt)\n\t\t\t\t\t\t\t: await appendDispatchReceipt(card, receipt, now);\n\t\t\t\t\t\twriteCard = outcome.kind;\n\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\twriteCard = \"未落卡\";\n\t\t\t\t\t\twriteCardNote = `回执落卡失败:${errorMessage(error)}(证据仍在 ${receipt.evidence_path})`;\n\t\t\t\t\t}\n\t\t\t\t\tif (writeCard === \"已记录\" && options.onReceipt && !runner.isStopped()) {\n\t\t\t\t\t\treceiptDelivery = { card, receipt };\n\t\t\t\t\t}\n\t\t\t\t\tconst failureType = writeCard === \"未落卡\" ? \"unknown_outcome\" : classifyWorkerFailure(receipt);\n\t\t\t\t\t// §14 越界核查:git 真值(当前 status 减认领基线)比对回执声明的产物清单,虚报/越界\n\t\t\t\t\t// 结构化亮出(差异表随结果呈现,主控自行判断)。工作流模式「有差异自动插人工门(停流等\n\t\t\t\t\t// 点头)」的挂点在此:结论 !== \"干净\" 时分流进 §11 工作流引擎——引擎尚未实现,不硬做。\n\t\t\t\t\tlet boundaryAudit: BoundaryWriteCheck | undefined;\n\t\t\t\t\tconst snapshotPath = claimBaseline?.available ? claimBaseline.snapshotPath : undefined;\n\t\t\t\t\tif (snapshotPath) {\n\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\tboundaryAudit = checkBoundaryWrite(\n\t\t\t\t\t\t\t\tawait diffAgainstBaseline(snapshotPath),\n\t\t\t\t\t\t\t\treceiptDeclarations(receipt),\n\t\t\t\t\t\t\t);\n\t\t\t\t\t\t} catch (error) {\n\t\t\t\t\t\t\tconst reason = errorMessage(error);\n\t\t\t\t\t\t\tboundaryAudit = {\n\t\t\t\t\t\t\t\t结论: \"无法核对\",\n\t\t\t\t\t\t\t\t虚报: [],\n\t\t\t\t\t\t\t\t越界: [],\n\t\t\t\t\t\t\t\t相符: [],\n\t\t\t\t\t\t\t\t不可核验: [],\n\t\t\t\t\t\t\t\t汇总: `越界核查执行失败:${reason}`,\n\t\t\t\t\t\t\t\t原因: reason,\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\treturn {\n\t\t\t\t\t\t卡号: cardNo,\n\t\t\t\t\t\t终态: writeCard === \"未落卡\" ? \"失败\" : FINAL_STATE_BY_STATUS[receipt.status],\n\t\t\t\t\t\tattempt,\n\t\t\t\t\t\t摘要: receipt.summary,\n\t\t\t\t\t\t失败类型: writeCard === \"未落卡\" ? \"unknown_outcome\" : failureType,\n\t\t\t\t\t\t路由建议:\n\t\t\t\t\t\t\twriteCard === \"未落卡\"\n\t\t\t\t\t\t\t\t? routeFailure(\"unknown_outcome\")\n\t\t\t\t\t\t\t\t: failureType\n\t\t\t\t\t\t\t\t\t? routeFailure(failureType)\n\t\t\t\t\t\t\t\t\t: undefined,\n\t\t\t\t\t\t证据路径: receipt.evidence_path,\n\t\t\t\t\t\t回执落卡: writeCard,\n\t\t\t\t\t\t落卡说明: writeCardNote,\n\t\t\t\t\t\t持续毫秒: Date.now() - startedAt,\n\t\t\t\t\t\t认领基线: claimBaseline,\n\t\t\t\t\t\t越界核查: boundaryAudit,\n\t\t\t\t\t\t派发告警: receipt.派发告警,\n\t\t\t\t\t\t// S5 包4 四写法②：任务态自报随结果带出(路由行由摘要现算,单源不存副本)\n\t\t\t\t\t\t任务态: receipt.任务态,\n\t\t\t\t\t};\n\t\t\t\t},\n\t\t\t);\n\t\t\tconst result = dispatched.可派\n\t\t\t\t? dispatched.result\n\t\t\t\t: { 卡号: cardNo, 终态: \"未拉起\" as const, 未拉起原因: dispatched.原因 };\n\t\t\t// 直接上级投递依赖宿主 RPC，不能占用 executeDispatch 的任务根共享锁；\n\t\t\t// 回执落卡已完成，投递失败只补可回取的说明并告警，不改派发/回执终态。\n\t\t\tif (\n\t\t\t\tdispatched.可派 &&\n\t\t\t\tresult.回执落卡 === \"已记录\" &&\n\t\t\t\treceiptDelivery &&\n\t\t\t\toptions.onReceipt &&\n\t\t\t\t!runner.isStopped()\n\t\t\t) {\n\t\t\t\ttry {\n\t\t\t\t\tawait options.onReceipt(receiptDelivery.card, receiptDelivery.receipt);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tresult.落卡说明 = `回执已落卡，但直接上级投递失败:${errorMessage(error)}`;\n\t\t\t\t\tlogWarn(`[pao] 卡${cardNo}${result.落卡说明}`);\n\t\t\t\t}\n\t\t\t\tresult.持续毫秒 = Date.now() - startedAt;\n\t\t\t}\n\t\t\treturn result;\n\t\t} catch (error) {\n\t\t\tif (error instanceof PaoWorkerError && error.code === \"停止失败\") throw error;\n\t\t\tconst started = error instanceof PaoWorkerError && error.dispatchFailurePhase === \"started\";\n\t\t\t// 等执行锁或名额时 AbortSignal 会抛原始取消原因，尚未进入 runner，不能\n\t\t\t// 误记成普通“未拉起”而跳过取消落卡；其他真实异常仍保留原失败分类。\n\t\t\tconst cancelled =\n\t\t\t\t(error instanceof PaoWorkerError && error.code === \"已取消\") ||\n\t\t\t\t(!started &&\n\t\t\t\t\toptions.信号?.aborted === true &&\n\t\t\t\t\t(error === options.信号.reason || (error instanceof Error && error.name === \"AbortError\")));\n\t\t\tif (cancelled && runner.isStopped()) stopped.value = true;\n\t\t\treturn {\n\t\t\t\t卡号: cardNo,\n\t\t\t\t终态: cancelled ? \"取消\" : started ? \"失败\" : \"未拉起\",\n\t\t\t\t错误: errorMessage(error),\n\t\t\t\t未拉起原因: cancelled || started ? undefined : errorMessage(error),\n\t\t\t\t持续毫秒: Date.now() - startedAt,\n\t\t\t};\n\t\t}\n\t};\n\n\tconst laneCount = Math.min(plan.并发上限, runnable.length);\n\tconst lanes = Array.from({ length: laneCount }, async () => {\n\t\twhile (!stopped.value && !runner.isStopped()) {\n\t\t\tconst index = next++;\n\t\t\tif (index >= runnable.length) return;\n\t\t\tconst item = runnable[index];\n\t\t\tresults.set(item.cardNo, await runOne(item));\n\t\t}\n\t});\n\tconst laneResults = await Promise.allSettled(lanes);\n\toptions.信号?.removeEventListener(\"abort\", markStopped);\n\tconst failedLane = laneResults.find((result) => result.status === \"rejected\");\n\tif (failedLane?.status === \"rejected\") throw failedLane.reason;\n\tif (runner.isStopped()) stopped.value = true;\n\n\t// ── 停止收尾:被本批认领(已改「进行中」)但扇出终态为取消的卡,owner 侧补落「取消」终态 ──\n\t// 不收尾的话卡文件停在「进行中」,下次扇出被 prepareCard「在先前尝试手中」拒派,只能人工收场。\n\t// 在跑被杀的卡可能已落「结果:取消」的 worker 回执(runner 对取消是正常 resolve,不走 catch),\n\t// 但回执不改状态——两类(在跑被杀/从未拉起)都要 owner 侧落终态;\n\t// 正常完成(成功/失败)并落了回执的卡不动——按既有语义留在「进行中」等 owner 审。\n\tif (stopped.value) {\n\t\tfor (const item of runnable) {\n\t\t\tconst known = results.get(item.cardNo);\n\t\t\tconst pendingWrapUp = known === undefined || known.终态 === \"取消\";\n\t\t\tif (!pendingWrapUp) continue;\n\t\t\t// 扇出取消（M0-08）：被中途停止波及的卡逐张记摩擦草稿；recordFrictionDraft 自兜失败，不影响收尾\n\t\t\tawait recordFrictionDraft(\n\t\t\t\t\"扇出取消\",\n\t\t\t\t`卡${item.cardNo}`,\n\t\t\t\t\"扇出被中途停止(在跑进程已树杀确认,排队卡未拉起),该卡未跑完\",\n\t\t\t\tinput.cardsDir,\n\t\t\t\tfrictionIdentity(item.cardNo, \"扇出取消\"),\n\t\t\t);\n\t\t\ttry {\n\t\t\t\tconst current = readCard(item.card.path);\n\t\t\t\tif (current.frontmatter.status === \"in_progress\" && !claimedCards.has(current.path)) continue;\n\t\t\t\tif (current.frontmatter.status !== \"in_progress\" && current.frontmatter.status !== \"unclaimed\") continue;\n\t\t\t\tchangeCardStatus(current, {\n\t\t\t\t\t操作者: current.frontmatter.owner === OPERATOR ? OPERATOR : \"用户\",\n\t\t\t\t\tto: \"canceled\",\n\t\t\t\t\t依据: \"扇出被中途停止(在跑进程已树杀确认,排队卡未拉起)\",\n\t\t\t\t\t时间: nowString(now()),\n\t\t\t\t});\n\t\t\t} catch (error) {\n\t\t\t\t// 中止路径不能再失败:收尾失败只记说明,不抛\n\t\t\t\tconst writeCardNote = `停止收尾失败(卡文件仍停在原状态):${errorMessage(error)}`;\n\t\t\t\tresults.set(item.cardNo, {\n\t\t\t\t\t...(known ?? { 卡号: item.cardNo, 终态: \"取消\" as const, 未拉起原因: \"扇出已停止,该卡仍在排队,未拉起\" }),\n\t\t\t\t\t落卡说明: writeCardNote,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t}\n\n\treturn summarize(plan, input, results, stopped.value);\n}\n\n/** 聚合摘要 → 用户可见文本(先总后分,失败卡带路由建议;批量理由随摘要留痕) */\nexport function formatFanoutSummary(summary: FanoutSummary): string {\n\tconst { count, plan } = summary;\n\tconst head =\n\t\t`扇出完成:${summary.结果.length} 张卡(并发上限 ${plan.并发上限})——` +\n\t\t`成功 ${count.成功},失败 ${count.失败},结果未知 ${count.结果未知},取消 ${count.取消},未拉起 ${count.未拉起}` +\n\t\t(summary.已停止 ? \";本次扇出被中途停止(在跑进程已树杀并确认退出,排队卡不再拉起)\" : \"\");\n\tconst lines = [head];\n\tif (summary.理由) lines.push(`派单理由:${summary.理由}`);\n\tif (plan.重复剔除.length > 0) {\n\t\tlines.push(`重复卡号已剔除(只跑一次):${plan.重复剔除.map((n) => `卡${n}`).join(\"、\")}`);\n\t}\n\tfor (const r of summary.结果) {\n\t\tlet line = `- 卡${r.卡号}〔${r.终态}〕`;\n\t\tif (r.attempt !== undefined) line += ` 尝试${r.attempt}`;\n\t\tif (r.摘要) line += `:${r.摘要.split(\"\\n\")[0]}`;\n\t\tif (r.未拉起原因) line += `:${r.未拉起原因}`;\n\t\tif (r.错误) line += `(${r.错误})`;\n\t\tif (r.落卡说明) line += `;${r.落卡说明}`;\n\t\tlines.push(line);\n\t\tif (r.认领基线) {\n\t\t\tlines.push(\n\t\t\t\tr.认领基线.available\n\t\t\t\t\t? `  认领基线:快照已落 ${r.认领基线.snapshotPath}(既有 ${r.认领基线.existingEntryCount} 条不计 worker 的账,交回执比对以此为基线)`\n\t\t\t\t\t: `  认领基线:不可用——${r.认领基线.reason ?? \"原因未记\"}(越界比对无基线,边界如实标注)`,\n\t\t\t);\n\t\t}\n\t\tif (r.越界核查) {\n\t\t\tlines.push(`  越界核查:${r.越界核查.汇总}`);\n\t\t}\n\t\tif (r.派发告警?.length) {\n\t\t\tlines.push(`  派发告警:${r.派发告警.join(\";\")}`);\n\t\t}\n\t\tif (r.路由建议) {\n\t\t\tlines.push(`  路由建议:${r.路由建议.类型} → ${r.路由建议.建议动作}(${r.路由建议.说明})`);\n\t\t}\n\t\t// S5 包4 四写法②：任务态标签路由行(标签→处理动作,办完即停)\n\t\tif (r.任务态) lines.push(`  ${taskStateRoutingLine(r.任务态)}`);\n\t}\n\treturn lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 摩擦日志自动草稿（M0-08）：打回／重试到顶／升级人／扇出取消四事件发生时，\n * 机械往 $PAO_HOME/.pao/摩擦草稿.md 追加事实；正式摩擦日志由开发项目维护。 */\nimport { existsSync, mkdirSync, readFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\nimport { writeFileAtomicdeclareImprovementIntent } from \"../sharedevolutionatomic.tsproblems.ts\";\nimport { withFileLockenqueueEvolveJobmemorylock.tsmaintenance.tslogWarnopenMemoryStorelog.tsstore.tspathKey } from \"../shared/path-key.ts\n\n/** 四类摩擦场景（与 M0-08 定案一一对应） */\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,216]}}},{"equalLines":{"line_count":16}},{"diffOp":{"equal":{"range":[216,334]}}},{"diffOp":{"equal":{"range":[334,335]}}},{"diffOp":{"delete":{"range":[334,335]}}},{"diffOp":{"equal":{"range":[335,344]}}},{"diffOp":{"delete":{"range":[344,359]}}},{"diffOp":{"