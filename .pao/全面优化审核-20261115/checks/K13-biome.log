al":{"range":[204,212]}}},{"diffOp":{"delete":{"range":[634,636]}}},{"diffOp":{"equal":{"range":[318,323]}}},{"diffOp":{"delete":{"range":[636,647]}}},{"diffOp":{"insert":{"range":[647,665]}}},{"diffOp":{"equal":{"range":[665,666]}}},{"diffOp":{"delete":{"range":[666,683]}}},{"diffOp":{"insert":{"range":[683,759]}}},{"diffOp":{"equal":{"range":[453,482]}}},{"diffOp":{"delete":{"range":[626,634]}}},{"diffOp":{"insert":{"range":[759,767]}}},{"diffOp":{"equal":{"range":[316,318]}}},{"diffOp":{"equal":{"range":[767,781]}}},{"diffOp":{"delete":{"range":[781,875]}}},{"diffOp":{"insert":{"range":[875,887]}}},{"diffOp":{"equal":{"range":[453,475]}}},{"diffOp":{"delete":{"range":[561,567]}}},{"diffOp":{"insert":{"range":[887,894]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[759,767]}}},{"diffOp":{"insert":{"range":[894,903]}}},{"diffOp":{"equal":{"range":[316,318]}}},{"diffOp":{"equal":{"range":[204,212]}}},{"diffOp":{"delete":{"range":[318,323]}}},{"diffOp":{"equal":{"range":[634,636]}}},{"diffOp":{"delete":{"range":[903,913]}}},{"diffOp":{"insert":{"range":[913,947]}}},{"diffOp":{"equal":{"range":[363,386]}}},{"diffOp":{"delete":{"range":[887,894]}}},{"diffOp":{"insert":{"range":[556,561]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[894,903]}}},{"diffOp":{"insert":{"range":[567,583]}}},{"diffOp":{"equal":{"range":[316,318]}}},{"diffOp":{"equal":{"range":[947,1158]}}},{"equalLines":{"line_count":1128}},{"diffOp":{"equal":{"range":[1158,1167]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-extraction.test.ts"},"span":[588,660],"sourceCode":"/**\n * S2 批次 E 定向测试：自动提炼主链与数据规则。\n *\n * 覆盖：全链假模型采集→提炼→入库、S2-04 校验拒绝、S2-05 分类入库、\n * S2-07 重放去重、S2-06 条件变化标需重议、相反结论 related、S2-11 承诺不执行、\n * S2-12 失败可续、S2-09 来源排除、O01 外发许可与预算门/日累计。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-extraction.test.ts --maxWorkers=2\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { type RequestExtractionDeps, requestExtraction } from \"../../src/pao/memory/extract-model.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { checkMemoryJobBudget } from \"../../src/pao/memory/budget.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type {\n\tCommitSourceRef,\n\tExtractionSourceEntry,\n\tMemoryScope,\n\tMemoryService,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-ext-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-alpha\" };\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n/** 在 sources 表登记一条来源并返回 sourceId 与 CommitSourceRef。 */\nfunction seedSource(\n\tstore: MemoryStore,\n\tover: { sessionId?: string; entryId?: string; eventType?: string; capturedAt?: string; content?: string } = {},\n): { sourceId: string; ref: CommitSourceRef; entry: ExtractionSourceEntry } {\n\tconst sessionId = over.sessionId ?? \"sess-1\";\n\tconst entryId = over.entryId ?? `e-${Math.random().toString(36).slice(2, 8)}`;\n\tconst eventType = over.eventType ?? \"user\";\n\tconst content = over.content ?? \"用户拍板：内置记忆存储就用 SQLite，不要常驻服务。\";\n\tconst sourceId = registerSource(store.db, {\n\t\tsessionId,\n\t\tentryId,\n\t\teventType,\n\t\tcapturedAt: over.capturedAt ?? AT,\n\t});\n\treturn {\n\t\tsourceId,\n\t\tref: { sourceId, sessionId, entryId, eventType },\n\t\tentry: { sourceId, entryId, eventType, content },\n\t};\n}\n\n/** 造一条合法候选（quotedSpans 用来源 content 的真实子串才能过 S2-04 定位）。 */\nfunction candidate(over: Partial<ValidatedCandidate> & { sourceId: string; spanText: string }): ValidatedCandidate {\n\tconst { sourceId, spanText, ...rest } = over;\n\treturn {\n\t\tkind: \"decision\",\n\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\tconditions: \"不要常驻服务\",\n\t\trationale: \"单机维护成本低\",\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [sourceId],\n\t\tquotedSpans: [{ sourceId, text: spanText }],\n\t\tspanLocations: [{ sourceId, match: \"exact\", offset: 0 }],\n\t\t...rest,\n\t};\n}\n\nasync function commit(\n\tstore: MemoryStore,\n\tservice: MemoryService,\n\tcandidates: ValidatedCandidate[],\n\tsourceRefs: CommitSourceRef[],\n\tscope: MemoryScope = SCOPE,\n\tjobId = \"job-1\",\n\tnow = AT,\n) {\n\treturn commitExtractionCandidates(store, service, {\n\t\tjobId,\n\t\tscope,\n\t\tcandidates,\n\t\trelatedMemories: [],\n\t\tsourceRefs,\n\t\tnow,\n\t});\n}\n\n// ── S2-05 分类入库 + S2-07 去重 + S2-06 重议 + S2-11 承诺 + S2-09 排除 ──\n\ndescribe(\"commitExtractionCandidates\", () => {\n\tit(\"S2-05：confirmed 决定落库，字段/来源/修订号正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref, entry } = seedSource(store);\n\t\tconst c = candidate({ sourceId, spanText: \"用户拍板\" });\n\t\t// 修正 span 为 content 真实子串\n\t\tc.quotedSpans = [{ sourceId, text: \"内置记忆存储就用 SQLite\" }];\n\t\tc.spanLocations = [{ sourceId, match: \"exact\", offset: entry.content.indexOf(\"内置记忆存储就用 SQLite\") }];\n\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\");\n\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\texpect(got.memory.content.evidenceKind).toBe(\"user_statement\");\n\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-05：「可以考虑」落 tentative 不变成 confirmed\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconclusion: \"也许可以先用 SQLite\",\n\t\t\tconfirmation: \"tentative\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t});\n\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\tc.spanLocations = [{ sourceId, match: \"exact\", offset: 0 }];\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) expect(got.memory.content.confirmation).toBe(\"tentative\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-07：同来源同结论重放 → duplicate 复用已有 ID 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst mk = () => {\n\t\t\tconst c = candidate({ sourceId, spanText: \"SQLite\" });\n\t\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\t\treturn c;\n\t\t};\n\t\tconst first = await commit(store, service, [mk()], [ref]);\n\t\tconst firstId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\t\t// 重放同 scopeKey 同候选：来源已被引用且结论相同 → duplicate\n\t\tconst second = await commit(store, service, [mk()], [ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"duplicate\");\n\t\texpect((second.outcomes[0] as { memoryId: string }).memoryId).toBe(firstId);\n\t\texpect(second.submitted).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-06：同结论异条件 → 旧记忆标 needsReDiscussion 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\t// 旧决定：条件「不要常驻服务」\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst first = await commit(store, service, [c1], [s1.ref]);\n\t\tconst oldId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\t// 新候选：同 kind+同归一结论+异 conditions（条件变了）\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-new\", capturedAt: AT2 });\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"现在允许多机部署\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst second = await commit(store, service, [c2], [s2.ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"flagged\");\n\t\texpect((second.outcomes[0] as { memoryId: string }).memoryId).toBe(oldId);\n\t\texpect(second.submitted).toBe(0);\n\n\t\tconst got = await service.getMemory({ id: oldId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBe(true);\n\t\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\"); // 内容不被替换\n\t\t\texpect(got.memory.content.rationale).toContain(\"重议\");\n\t\t\texpect(got.memory.currentRevision).toBe(2); // 修订前进\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F12：无关结论各入库，不自动建 related 关系\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", conclusion: \"采用 SQLite 方案\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tawait commit(store, service, [c1], [s1.ref]);\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-2\", capturedAt: AT2 });\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconclusion: \"放弃 SQLite 改用别的\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst second = await commit(store, service, [c2], [s2.ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"submitted\");\n\t\tconst newId = (second.outcomes[0] as { memoryId: string }).memoryId;\n\t\t// O02/F12：无关结论各自入库——不再凭「同 kind 且结论不同」自动建 related。\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT relation, target_memory_id FROM revision_links WHERE memory_id = ? AND relation = 'related'`)\n\t\t\t.all(newId) as Array<{ relation: string; target_memory_id: string }>;\n\t\texpect(links.length).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-11：commitment 候选落 commitmentStatus=open，不产生执行\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tkind: \"commitment\",\n\t\t\tconclusion: \"明天把 SQLite 备份脚本写完\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t});\n\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.kind).toBe(\"commitment\");\n\t\t\texpect(got.memory.content.commitmentStatus).toBe(\"open\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-13：批内同 kind+同归一结论无差异 → duplicate_in_batch\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-a\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-b\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", conclusion: \"内置记忆存储使用 SQLite\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\texpect(out.outcomes[1].status).toBe(\"skipped\");\n\t\texpect((out.outcomes[1] as { reason: string }).reason).toBe(\"duplicate_in_batch\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\t// ── I01：批内命中不再短路实质差异（与跨批同一分派）──────────────────\n\n\tit(\"I1 批内确认升级：第一条 tentative、第二条 confirmed 同结论同条件 → corrected 且最终 confirmed\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-tentative\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-confirm\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", confirmation: \"tentative\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", confirmation: \"confirmed\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"corrected\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I1 链式：批内 tentative→confirmed→第三条同条件 confirmed → 第三条 duplicate_in_batch\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-2\", capturedAt: AT2 });\n\t\tconst s3 = seedSource(store, { entryId: \"e-3\", capturedAt: AT });\n\t\tconst mk = (sourceId: string, confirmation: ValidatedCandidate[\"confirmation\"]) => {\n\t\t\tconst c = candidate({ sourceId, spanText: \"SQLite\", confirmation });\n\t\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\t\treturn c;\n\t\t};\n\t\tconst out = await commit(store, service, [mk(s1.sourceId, \"tentative\"), mk(s2.sourceId, \"confirmed\"), mk(s3.sourceId, \"confirmed\")], [s1.ref, s2.ref, s3.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1].status).toBe(\"corrected\");\n\t\t// 第三条与 rev2（confirmed）无差异 → 真重复，仍走 duplicate_in_batch。\n\t\texpect(out.outcomes[2].status).toBe(\"skipped\");\n\t\texpect((out.outcomes[2] as { reason: string }).reason).toBe(\"duplicate_in_batch\");\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I2 批内条件重议：第一条 confirmed、第二条同结论异条件 user_statement → flagged needsReDiscussion\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-original\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-newcond\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", conditions: \"多机部署\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"flagged\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) expect(got.memory.content.needsReDiscussion).toBe(true);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I2 反向：第二条 confirmed 异条件 model_inference → semantic_conflict 不 flagged\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-original\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-infer\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\t// 推断来源的「条件变化」不能替用户改条件——重议必须有用户/执行实据。\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"多机部署\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"semantic_conflict\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I03 推断不触发重议：已 confirmed + 第二条 tentative/model_inference 异条件 → semantic_conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-confirmed\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-guess\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", confirmation: \"confirmed\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"多机部署\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t\tconfirmation: \"tentative\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"semantic_conflict\" });\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── S2-03/04 模型请求与校验（假模型，不发真实请求）─────────────────────\n\ndescribe(\"requestExtraction\", () => {\n\t// TierConfig 用中文字段：provider + 档位数组（每项 名/provider/model/thinkingLevel）。\n\t// \"fast\" 别名归一命中「快」档，解析出 provider/modelId 供 modelRegistry.find。\n\tconst TIER: TierConfig = {\n\t\tprovider: \"pao\",\n\t\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n\t} as TierConfig;\n\tfunction fakeRegistry(\n\t\treply: string,\n\t\tonRequest?: (context: Context) => void,\n\t): RequestExtractionDeps[\"modelRegistry\"] {\n\t\treturn {\n\t\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\t\tstreamSimple: (_model, context) => {\n\t\t\t\tonRequest?.(context);\n\t\t\t\treturn {\n\t\t\t\t\tresult: () =>\n\t\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t\t}),\n\t\t\t\t} as never;\n\t\t\t},\n\t\t};\n\t}\n\tfunction fakeLedger() {\n\t\tconst calls: string[] = [];\n\t\treturn {\n\t\t\tcalls,\n\t\t\tappendUsage: (_k: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\t\tcalls.push(note ?? \"\");\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t\tappendCustomEntry: () => ({}) as never,\n\t\t};\n\t}\n\n\tit(\"合法候选经校验通过，附带 spanLocations\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { sourceId, entry } = seedSource(store);\n\t\tconst entries = [{ ...entry }];\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tconditions: \"不要常驻服务\",\n\t\t\t\trationale: \"单机维护成本低\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [sourceId],\n\t\t\t\tquotedSpans: [{ sourceId, text: \"内置记忆存储就用 SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst ledger = fakeLedger();\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: ledger as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure).toBeUndefined();\n\t\texpect(out.candidates).toHaveLength(1);\n\t\texpect(out.candidates[0].spanLocations[0].match).toBe(\"exact\");\n\t\texpect(ledger.calls[0]).toContain(\"jobId=j1\");\n\t\tstore.close();\n\t});\n\n\tit(\"提炼请求覆盖来源归属、互斥候选、重议与管理操作边界\", async () => {\n\t\tconst requests: Context[] = [];\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-candidate\",\n\t\t\t\tentryId: \"entry-candidate\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"候选方案：本地计算或外部服务。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-user\",\n\t\t\t\tentryId: \"entry-user\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"不要外部服务，太重。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-self-review\",\n\t\t\t\tentryId: \"entry-self-review\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"剩余本地计算未确认；没有看到其他原文，所以摘要是虚构的。\",\n\t\t\t},\n\t\t];\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", (context) => requests.push(context)),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-prompt\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"用户明确选定 X\");\n\t\texpect(prompt).toContain(\"用户明确否决 Y\");\n\t\texpect(prompt).toContain(\"采用 X 与拒绝 Y 必须拆成独立候选，分别记 confirmed 与 rejected\");\n\t\texpect(prompt).toContain(\"不能合并为一条 confirmed\");\n\t\texpect(prompt).toContain(\"取舍按用户作出该次决定当时已经提出的候选集合判断\");\n\t\texpect(prompt).toContain(\"若当时只有互斥「A 或 B」，用户排除 A 且没有明确留待定\");\n\t\texpect(prompt).toContain(\"B 就是该次取舍，记为 evidenceKind=user_statement、confirmation=confirmed\");\n\t\texpect(prompt).toContain(\"不要求用户再说「就选 B」\");\n\t\texpect(prompt).toContain(\n\t\t\t\"后续 assistant 单方面补充、建议、自评或重开 C、D 不撤销、不降级也不抹去该选择，也不能覆盖用户证据\",\n\t\t);\n\t\texpect(prompt).toContain(\"原候选、用户否决和后续 assistant 建议须分别准确引用各自的 sourceId 与原文\");\n\t\texpect(prompt).toContain(\n\t\t\t\"后续 assistant 的建议或自评只能记为 evidenceKind=model_inference、confirmation=tentative\",\n\t\t);\n\t\texpect(prompt).toContain(\"不能挂到用户来源或冒充 user_statement、用户确认\");\n\t\texpect(prompt).toContain(\"用户作出该次决定时若多候选未排完、明确表示未定或只是提议重议，仍为 tentative\");\n\t\texpect(prompt).toContain(\"对「先不定」「暂时这样」的简单附和、继续、记住或保留请求，只确认接收或保存暂定状态\");\n\t\texpect(prompt).toContain(\"不能把尚未定案的业务规则或「已确认的暂缓决定」提升 confirmed\");\n\t\texpect(prompt).toContain(\"真正明确的最终规则仍可 confirmed，不因「先」字一律降级\");\n\t\texpect(prompt).toContain(\"后续用户明确重新讨论或受新条件重议时，另记 tentative 并保留先前决定的理由\");\n\t\texpect(prompt).toContain(\"未展示或未命中只说明当前缺少来源\");\n\t\texpect(prompt).toContain(\"无来源断言不提炼为长期事实，即使写成经验或教训也不提炼\");\n\t\texpect(prompt).toContain(\"新条件不会自动使旧理由失效\");\n\t\texpect(prompt).toContain(\"只执行或复述管理操作时，不生成新候选\");\n\t\texpect(prompt).toContain(\"只提炼该独立内容\");\n\t\texpect(prompt).toContain(\n\t\t\t\"每条 quotedSpans 的 sourceId 必须是该段原文实际所在的条目，不能把 assistant 的话挂到 user 来源\",\n\t\t);\n\t\texpect(prompt).not.toContain(\"用户明确说「就用 X」「不要 Y」「决定是 Z」\");\n\t\texpect(prompt).not.toContain(\"没有明确留待定或其他候选\");\n\t\tconst userContent = requests[0]!.messages[0]?.content;\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-candidate\");\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-user\");\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-self-review\");\n\t\tfor (const entry of entries) expect(userContent).toContain(entry.content);\n\t});\n\n\tit(\"提炼请求要求同批承诺合并确认回声并保留实质新承诺\", async () => {\n\t\tconst requests: Context[] = [];\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-promise\",\n\t\t\t\tentryId: \"entry-promise\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"我会在周五前补齐部署说明。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-echo\",\n\t\t\t\tentryId: \"entry-echo\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"收到，你会在周五前补齐部署说明。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-new-promise\",\n\t\t\t\tentryId: \"entry-new-promise\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"另外我会核对回滚步骤。\",\n\t\t\t},\n\t\t];\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", (context) => requests.push(context)),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-promise\", sourceSessionId: \"sess-promise\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\texpect(requests).toHaveLength(1);\n\t\texpect(requests[0]!.systemPrompt).toContain(\n\t\t\t\"同一承诺的用户原文与 assistant 确认/复述合成一个 commitment 候选，优先准确引用用户来源\",\n\t\t);\n\t\texpect(requests[0]!.systemPrompt).toContain(\"纯确认或回声不另建独立承诺\");\n\t\texpect(requests[0]!.systemPrompt).toContain(\"同义承诺在本批内合并，不同任务或实质新承诺仍分别提炼\");\n\t\tconst content = requests[0]!.messages[0]?.content;\n\t\tfor (const entry of entries) {\n\t\t\texpect(content).toContain(`sourceId=${entry.sourceId} entryId=${entry.entryId} eventType=${entry.eventType}`);\n\t\t\texpect(content).toContain(entry.content);\n\t\t}\n\t});\n\n\tit(\"S2-04：quotedSpan 挂到错误来源时仍严格拒绝\", async () => {\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-assistant\",\n\t\t\t\tentryId: \"entry-assistant\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"候选方案：本地计算或外部服务。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-user\",\n\t\t\t\tentryId: \"entry-user\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"不要外部服务，太重。\",\n\t\t\t},\n\t\t];\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"采用本地方案\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [\"src-user\"],\n\t\t\t\tquotedSpans: [{ sourceId: \"src-user\", text: \"候选方案：本地计算\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-wrong-owner\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toEqual([]);\n\t\texpect(out.rejected[0]?.reasons.join()).toContain(\"quotedSpan 在来源 src-user\");\n\t});\n\n\tit(\"互斥二选一旦明确排除到唯一项，所选项与否决项经提炼提交各保留原状态\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst candidates = seedSource(store, {\n\t\t\tsessionId: \"sess-choice\",\n\t\t\tentryId: \"entry-candidates\",\n\t\t\teventType: \"assistant\",\n\t\t\tcontent: \"方案甲：本地计算或方案乙：外部服务。\",\n\t\t});\n\t\tconst decision = seedSource(store, {\n\t\t\tsessionId: \"sess-choice\",\n\t\t\tentryId: \"entry-decision\",\n\t\t\teventType: \"user\",\n\t\t\tcontent: \"不要方案乙，外部服务太重。\",\n\t\t});\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"采用本地方案\",\n\t\t\t\tconditions: \"排除外部服务\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [candidates.sourceId, decision.sourceId],\n\t\t\t\tquotedSpans: [\n\t\t\t\t\t{ sourceId: candidates.sourceId, text: \"方案甲：本地计算\" },\n\t\t\t\t\t{ sourceId: decision.sourceId, text: \"不要方案乙\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"外部服务方案被否决\",\n\t\t\t\trationale: \"太重\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"rejected\",\n\t\t\t\tsourceIds: [candidates.sourceId, decision.sourceId],\n\t\t\t\tquotedSpans: [\n\t\t\t\t\t{ sourceId: candidates.sourceId, text: \"方案乙：外部服务\" },\n\t\t\t\t\t{ sourceId: decision.sourceId, text: \"太重\" },\n\t\t\t\t],\n\t\t\t},\n\t\t]);\n\t\tconst extracted = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-choice\",\n\t\t\t\tsourceSessionId: \"sess-choice\",\n\t\t\t\tentries: [candidates.entry, decision.entry],\n\t\t\t},\n\t\t);\n\t\texpect(extracted.ok).toBe(true);\n\t\tif (!extracted.ok) return;\n\t\texpect(extracted.rejected).toEqual([]);\n\t\texpect(extracted.candidates).toHaveLength(2);\n\n\t\tconst committed = await commit(\n\t\t\tstore,\n\t\t\tservice,\n\t\t\textracted.candidates,\n\t\t\t[candidates.ref, decision.ref],\n\t\t\tSCOPE,\n\t\t\t\"j-choice\",\n\t\t);\n\t\texpect(committed.submitted).toBe(2);\n\t\tconst ids = committed.outcomes.flatMap((outcome) => (\"memoryId\" in outcome ? [outcome.memoryId] : []));\n\t\tconst stored = await Promise.all(ids.map((id) => service.getMemory({ id })));\n\t\texpect(stored.map((result) => (result.ok ? result.memory.content.conclusion : \"\"))).toEqual([\n\t\t\t\"采用本地方案\",\n\t\t\t\"外部服务方案被否决\",\n\t\t]);\n\t\texpect(stored.map((result) => (result.ok ? result.memory.content.confirmation : \"\"))).toEqual([\n\t\t\t\"confirmed\",\n\t\t\t\"rejected\",\n\t\t]);\n\t\tfor (const result of stored) {\n\t\t\tif (result.ok) {\n\t\t\t\texpect(result.sourceSummaries.map((source) => source.sourceId).sort()).toEqual(\n\t\t\t\t\t[candidates.sourceId, decision.sourceId].sort(),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-04：虚构 sourceId 的候选进 rejected 不提交\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { entry } = seedSource(store);\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"x\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"tentative\",\n\t\t\t\tsourceIds: [\"src-fake-999\"],\n\t\t\t\tquotedSpans: [{ sourceId: \"src-fake-999\", text: \"y\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"sourceIds\");\n\t\tstore.close();\n\t});\n\n\tit(\"S2-04：confirmed + model_inference 被拒\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { sourceId, entry } = seedSource(store);\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"模型擅自定案\",\n\t\t\t\tevidenceKind: \"model_inference\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [sourceId],\n\t\t\t\tquotedSpans: [{ sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/user_statement 只挂 toolResult 来源 → 拒（缺用户实据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"toolResult\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"用户拍板用 SQLite\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"eventType=user\");\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/execution 挂 toolResult 来源 → 通过校验\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"toolResult\", content: \"迁移脚本执行成功：SQLite 表已建\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"experience\",\n\t\t\t\tconclusion: \"SQLite 迁移脚本可建表\",\n\t\t\t\tevidenceKind: \"execution\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite 表已建\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.rejected).toEqual([]);\n\t\texpect(out.candidates).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/user_statement 至少一条 user 来源 → 通过校验\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"user\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tconditions: \"不要常驻服务\",\n\t\t\t\trationale: \"单机维护成本低\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"内置记忆存储就用 SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.rejected).toEqual([]);\n\t\texpect(out.candidates).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/execution 挂 user 来源 → 拒（缺 toolResult 实据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"user\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"experience\",\n\t\t\t\tconclusion: \"测试证明 SQLite 可用\",\n\t\t\t\tevidenceKind: \"execution\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"eventType=toolResult\");\n\t\tstore.close();\n\t});\n\n\tit(\"F08：quotedSpan 指向 sourceIds 未声明的来源 → 拒（引用不闭合）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\", eventType: \"user\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-2\", eventType: \"user\", content: \"另一段用户原文\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s1.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s2.sourceId, text: \"另一段用户原文\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s1.entry, s2.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"未列入 sourceIds\");\n\t\tstore.close();\n\t});\n\n\tit(\"解析失败返回 stage=parse 不二次请求\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { entry } = seedSource(store);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(\"这不是 JSON\"), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure?.stage).toBe(\"parse\");\n\t\tstore.close();\n\t});\n\n\t// ── O01：外发许可门 + 预算门 + 失败回执 + 日累计 ──────────────────────\n\n\tfunction writeBudgetFixtures(\n\t\thome: string,\n\t\tconfig: Record<string, unknown> | undefined,\n\t\tgrant = 10.0,\n\t): void {\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\tif (config !== undefined) {\n\t\t\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify(config));\n\t\t}\n\t\twriteFileSync(\n\t\t\tjoin(home, \"总预算账.json\"),\n\t\t\tJSON.stringify({\n\t\t\t\tversion: 1,\n\t\t\t\tgrants: [{ version: 1, 总预算: grant, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\t\t\treservations: [],\n\t\t\t}),\n\t\t);\n\t}\n\n\tfunction writeOutboundPermit(home: string, project: string, allowed: boolean): void {\n\t\tmkdirSync(join(home, \"知识库配置\"), { recursive: true });\n\t\twriteFileSync(\n\t\t\tjoin(home, \"知识库配置\", \"外发许可.json\"),\n\t\t\tJSON.stringify({ projects: { [project]: { allowed, asOf: \"2099-12-31\" } } }),\n\t\t\t\"utf8\",\n\t\t);\n\t}\n\n\tfunction fakeLedgerVerbose() {\n\t\tconst calls = { custom: [] as Array<{ type: string; data: unknown }>, usage: [] as string[] };\n\t\treturn {\n\t\t\tcalls,\n\t\t\tappendUsage: (_k: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\t\tcalls.usage.push(note ?? \"\");\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\t\tcalls.custom.push({ type, data });\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t};\n\t}\n\n\tit(\"O01：缺预算配置 → 0 次请求，failure 含预算门原因\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\t// 只给总预算授权，不写 记忆后台预算.json。\n\t\twriteBudgetFixtures(home, undefined);\n\t\tlet requests = 0;\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: fakeLedgerVerbose() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-budget-missing\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(0);\n\t\texpect(out.failure?.stage).toBe(\"request\");\n\t\texpect(out.failure?.message).toContain(\"预算门拒绝\");\n\t\texpect(out.failure?.message).toContain(\"未配置\");\n\t});\n\n\tit(\"O01：外发未授权 → 0 次请求且不占预算\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", false);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tlet requests = 0;\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: fakeLedgerVerbose() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-outbound\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(0);\n\t\texpect(out.failure?.message).toContain(\"禁外发\");\n\t\texpect(out.failure?.message).toContain(\"proj-x\");\n\t\t// 未发请求不产生预留。\n\t\tconst ledgerFile = readBudgetLedger(budgetLedgerPath(home));\n\t\texpect(ledgerFile.reservations).toHaveLength(0);\n\t});\n\n\tit(\"O01：授权+预算齐 → 请求 1 次、预留/结算判据含 attemptKey\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tlet requests = 0;\n\t\tconst ledger = fakeLedgerVerbose();\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: ledger as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-7\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-ok\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(1);\n\t\texpect(out.failure).toBeUndefined();\n\t\t// 预留判据 = memory-job:j-ok:extract:batch-7:<requestId>（注入值作归属前缀，\n\t\t// 判据主体是一次一发的 requestId），且已结算（假 usage 无 cost 字段 → unknown）。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst reservation = file.reservations.find((r) =>\n\t\t\tr.idempotencyKey.startsWith(\"memory-job:j-ok:extract:batch-7:\"),\n\t\t);\n\t\texpect(reservation).toBeDefined();\n\t\t// 假模型 usage 没有 cost.total → 结算记 unknown（预留额占着不释放）。\n\t\texpect(reservation?.status).toBe(\"unknown\");\n\t\texpect(ledger.calls.custom.some((c) => c.type === \"pao-memory-extraction-attempt\")).toBe(true);\n\t});\n\n\tit(\"O01：streamSimple 抛异常 → failure custom entry + settle unknown\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tconst throwingRegistry = {\n\t\t\tfind: (_p: string, _m: string) => ({}) as never,\n\t\t\tstreamSimple: () => ({ result: () => Promise.reject(new Error(\"网络断\")) }) as never,\n\t\t};\n\t\tconst ledger = fakeLedgerVerbose();\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: throwingRegistry as never,\n\t\t\t\tledger: ledger as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"b-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-throw\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure?.stage).toBe(\"request\");\n\t\texpect(out.failure?.message).toContain(\"网络断\");\n\t\texpect(\n\t\t\tledger.calls.custom.some(\n\t\t\t\t(c) =>\n\t\t\t\t\tc.type === \"pao-memory-extraction-failure\" &&\n\t\t\t\t\tJSON.stringify(c.data).includes(\"j-throw\"),\n\t\t\t),\n\t\t).toBe(true);\n\t\tconst reservation = readBudgetLedger(budgetLedgerPath(home)).reservations.find(\n\t\t\t(r) => r.idempotencyKey.startsWith(\"memory-job:j-throw:extract:b-1:\"),\n\t\t);\n\t\texpect(reservation?.status).toBe(\"unknown\");\n\t});\n\n\tit(\"O01：日累计 每日上限=0.06 两次 0.05 → 第二次额度不足\", async () => {\n\t\tconst home = tempHome();\n\t\twriteBudgetFixtures(home, { 每日上限: 0.06 });\n\t\tconst first = await checkMemoryJobBudget({\n\t\t\tpaoHome: home,\n\t\t\tjobId: \"job-a\",\n\t\t\tjobKind: \"extract\",\n\t\t\tscopeKey: \"s\",\n\t\t\t金额: 0.05,\n\t\t\t现在: AT,\n\t\t});\n\t\texpect(first.ok).toBe(true);\n\t\tconst second = await checkMemoryJobBudget({\n\t\t\tpaoHome: home,\n\t\t\tjobId: \"job-b\",\n\t\t\tjobKind: \"extract\",\n\t\t\tscopeKey: \"s\",\n\t\t\t金额: 0.05,\n\t\t\t现在: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(false);\n\t\tif (second.ok) return;\n\t\texpect(second.kind).toBe(\"额度不足\");\n\t\texpect(second.reason).toContain(\"当日累计\");\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S2 批次 E 定向测试：自动提炼主链与数据规则。\n *\t\t\treturn c;\n\t\t};\n\t\tconst out = await commit(\n\t\t\tstore, service,[mk(s1.sourceId, \"tentative\"), mk(s2.sourceId, \"confirmed\"), mk(s3.sourceId, \"confirmed\")],[s1.ref, s2.ref, s3.ref],\n\t\t);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\t// ── O01：外发许可门 + 预算门 + 失败回执 + 日累计 ──────────────────────\n\n\tfunction writeBudgetFixtures(home: string,config: Record<string, unknown> | undefined,grant = 10.0): void {\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\tif (config !== undefined) {\t\t\tJSON.stringify({\n\t\t\t\tversion: 1,\n\t\t\t\tgrants: [\n\t\t\t\t\t{ version: 1, 总预算: grant, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" },\n\t\t\t\t],\n\t\t\t\treservations: [],\n\t\t\t}),\t\texpect(\n\t\t\tledger.calls.custom.some(\n\t\t\t\t(c) =>c.type === \"pao-memory-extraction-failure\" &&JSON.stringify(c.data).includes(\"j-throw\"),\n\t\t\t),\n\t\t).toBe(true);\n\t\tconst reservation = readBudgetLedger(budgetLedgerPath(home)).reservations.find((r) =>r.idempotencyKey.startsWith(\"memory-job:j-throw:extract:b-1:\"),\n\t\t);\n\t\texpect(reservation?.status).toBe(\"unknown\");\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":330}},{"diffOp":{"equal":{"range":[73,118]}}},{"diffOp":{"insert":{"range":[118,122]}}},{"diffOp":{"equal":{"range":[122,128]}}},{"diffOp":{"delete":{"range":[128,129]}}},{"diffOp":{"insert":{"range":[118,122]}}},{"diffOp":{"equal":{"range":[129,137]}}},{"diffOp":{"delete":{"range":[128,129]}}},{"diffOp":{"insert":{"range":[118,122]}}},{"diffOp":{"equal":{"range":[137,228]}}},{"diffOp":{"delete":{"range":[128,129]}}},{"diffOp":{"insert":{"range":[118,122]}}},{"diffOp":{"equal":{"range":[228,252]}}},{"diffOp":{"insert":{"range":[252,256]}}},{"diffOp":{"equal":{"range":[256,381]}}},{"equalLines":{"line_count":606}},{"diffOp":{"equal":{"range":[381,551]}}},{"diffOp":{"delete":{"range":[118,121]}}},{"diffOp":{"equal":{"range":[551,564]}}},{"diffOp":{"delete":{"range":[118,121]}}},{"diffOp":{"insert":{"range":[128,129]}}},{"diffOp":{"equal":{"range":[564,608]}}},{"diffOp":{"delete":{"range":[118,121]}}},{"diffOp":{"insert":{"range":[128,129]}}},{"diffOp":{"equal":{"range":[608,620]}}},{"diffOp":{"delete":{"range":[252,255]}}},{"diffOp":{"equal":{"range":[620,718]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[718,767]}}},{"diffOp":{"insert":{"range":[767,773]}}},{"diffOp":{"equal":{"range":[773,894]}}},{"diffOp":{"insert":{"range":[894,900]}}},{"diffOp":{"equal":{"range":[900,931]}}},{"equalLines":{"line_count":161}},{"diffOp":{"equal":{"range":[931,980]}}},{"diffOp":{"delete":{"range":[767,773]}}},{"diffOp":{"insert":{"range":[128,129]}}},{"diffOp":{"equal":{"range":[980,1025]}}},{"diffOp":{"delete":{"range":[767,773]}}},{"diffOp":{"insert":{"range":[128,129]}}},{"diffOp":{"equal":{"range":[1025,1172]}}},{"diffOp":{"delete":{"range":[767,771]}}},{"diffOp":{"equal":{"range":[1172,1178]}}},{"diffOp":{"delete":{"range":[128,129]}}},{"diffOp":{"insert":{"range":[767,771]}}},{"diffOp":{"equal":{"range":[1178,1293]}}},{"equalLines":{"line_count":26}},{"diffOp":{"equal":{"range":[1293,1302]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-extraction.test.ts"},"span":null,"sourceCode":"/**\n * S2 批次 E 定向测试：自动提炼主链与数据规则。\n *\n * 覆盖：全链假模型采集→提炼→入库、S2-04 校验拒绝、S2-05 分类入库、\n * S2-07 重放去重、S2-06 条件变化标需重议、相反结论 related、S2-11 承诺不执行、\n * S2-12 失败可续、S2-09 来源排除、O01 外发许可与预算门/日累计。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-extraction.test.ts --maxWorkers=2\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { commitExtractionCandidates } from \"../../src/pao/memory/extract-commit.ts\";\nimport { type RequestExtractionDeps, requestExtraction } from \"../../src/pao/memory/extract-model.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { checkMemoryJobBudget } from \"../../src/pao/memory/budget.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type {\n\tCommitSourceRef,\n\tExtractionSourceEntry,\n\tMemoryScope,\n\tMemoryService,\n\tValidatedCandidate,\n} from \"../../src/pao/memory/types.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-mem-ext-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst AT2 = \"2026-11-08T10:01:00.000Z\";\nconst SCOPE: MemoryScope = { projectId: \"proj-alpha\" };\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n/** 在 sources 表登记一条来源并返回 sourceId 与 CommitSourceRef。 */\nfunction seedSource(\n\tstore: MemoryStore,\n\tover: { sessionId?: string; entryId?: string; eventType?: string; capturedAt?: string; content?: string } = {},\n): { sourceId: string; ref: CommitSourceRef; entry: ExtractionSourceEntry } {\n\tconst sessionId = over.sessionId ?? \"sess-1\";\n\tconst entryId = over.entryId ?? `e-${Math.random().toString(36).slice(2, 8)}`;\n\tconst eventType = over.eventType ?? \"user\";\n\tconst content = over.content ?? \"用户拍板：内置记忆存储就用 SQLite，不要常驻服务。\";\n\tconst sourceId = registerSource(store.db, {\n\t\tsessionId,\n\t\tentryId,\n\t\teventType,\n\t\tcapturedAt: over.capturedAt ?? AT,\n\t});\n\treturn {\n\t\tsourceId,\n\t\tref: { sourceId, sessionId, entryId, eventType },\n\t\tentry: { sourceId, entryId, eventType, content },\n\t};\n}\n\n/** 造一条合法候选（quotedSpans 用来源 content 的真实子串才能过 S2-04 定位）。 */\nfunction candidate(over: Partial<ValidatedCandidate> & { sourceId: string; spanText: string }): ValidatedCandidate {\n\tconst { sourceId, spanText, ...rest } = over;\n\treturn {\n\t\tkind: \"decision\",\n\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\tconditions: \"不要常驻服务\",\n\t\trationale: \"单机维护成本低\",\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: \"confirmed\",\n\t\tsourceIds: [sourceId],\n\t\tquotedSpans: [{ sourceId, text: spanText }],\n\t\tspanLocations: [{ sourceId, match: \"exact\", offset: 0 }],\n\t\t...rest,\n\t};\n}\n\nasync function commit(\n\tstore: MemoryStore,\n\tservice: MemoryService,\n\tcandidates: ValidatedCandidate[],\n\tsourceRefs: CommitSourceRef[],\n\tscope: MemoryScope = SCOPE,\n\tjobId = \"job-1\",\n\tnow = AT,\n) {\n\treturn commitExtractionCandidates(store, service, {\n\t\tjobId,\n\t\tscope,\n\t\tcandidates,\n\t\trelatedMemories: [],\n\t\tsourceRefs,\n\t\tnow,\n\t});\n}\n\n// ── S2-05 分类入库 + S2-07 去重 + S2-06 重议 + S2-11 承诺 + S2-09 排除 ──\n\ndescribe(\"commitExtractionCandidates\", () => {\n\tit(\"S2-05：confirmed 决定落库，字段/来源/修订号正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref, entry } = seedSource(store);\n\t\tconst c = candidate({ sourceId, spanText: \"用户拍板\" });\n\t\t// 修正 span 为 content 真实子串\n\t\tc.quotedSpans = [{ sourceId, text: \"内置记忆存储就用 SQLite\" }];\n\t\tc.spanLocations = [{ sourceId, match: \"exact\", offset: entry.content.indexOf(\"内置记忆存储就用 SQLite\") }];\n\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (!got.ok) return;\n\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\");\n\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\texpect(got.memory.content.evidenceKind).toBe(\"user_statement\");\n\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-05：「可以考虑」落 tentative 不变成 confirmed\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconclusion: \"也许可以先用 SQLite\",\n\t\t\tconfirmation: \"tentative\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t});\n\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\tc.spanLocations = [{ sourceId, match: \"exact\", offset: 0 }];\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) expect(got.memory.content.confirmation).toBe(\"tentative\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-07：同来源同结论重放 → duplicate 复用已有 ID 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst mk = () => {\n\t\t\tconst c = candidate({ sourceId, spanText: \"SQLite\" });\n\t\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\t\treturn c;\n\t\t};\n\t\tconst first = await commit(store, service, [mk()], [ref]);\n\t\tconst firstId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\t\t// 重放同 scopeKey 同候选：来源已被引用且结论相同 → duplicate\n\t\tconst second = await commit(store, service, [mk()], [ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"duplicate\");\n\t\texpect((second.outcomes[0] as { memoryId: string }).memoryId).toBe(firstId);\n\t\texpect(second.submitted).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-06：同结论异条件 → 旧记忆标 needsReDiscussion 不新建\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\t// 旧决定：条件「不要常驻服务」\n\t\tconst s1 = seedSource(store, { entryId: \"e-old\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst first = await commit(store, service, [c1], [s1.ref]);\n\t\tconst oldId = (first.outcomes[0] as { memoryId: string }).memoryId;\n\n\t\t// 新候选：同 kind+同归一结论+异 conditions（条件变了）\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-new\", capturedAt: AT2 });\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"现在允许多机部署\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst second = await commit(store, service, [c2], [s2.ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"flagged\");\n\t\texpect((second.outcomes[0] as { memoryId: string }).memoryId).toBe(oldId);\n\t\texpect(second.submitted).toBe(0);\n\n\t\tconst got = await service.getMemory({ id: oldId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBe(true);\n\t\t\texpect(got.memory.content.conclusion).toBe(\"内置记忆存储使用 SQLite\"); // 内容不被替换\n\t\t\texpect(got.memory.content.rationale).toContain(\"重议\");\n\t\t\texpect(got.memory.currentRevision).toBe(2); // 修订前进\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F12：无关结论各入库，不自动建 related 关系\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", conclusion: \"采用 SQLite 方案\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tawait commit(store, service, [c1], [s1.ref]);\n\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-2\", capturedAt: AT2 });\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconclusion: \"放弃 SQLite 改用别的\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst second = await commit(store, service, [c2], [s2.ref], SCOPE, \"job-2\", AT2);\n\t\texpect(second.outcomes[0].status).toBe(\"submitted\");\n\t\tconst newId = (second.outcomes[0] as { memoryId: string }).memoryId;\n\t\t// O02/F12：无关结论各自入库——不再凭「同 kind 且结论不同」自动建 related。\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT relation, target_memory_id FROM revision_links WHERE memory_id = ? AND relation = 'related'`)\n\t\t\t.all(newId) as Array<{ relation: string; target_memory_id: string }>;\n\t\texpect(links.length).toBe(0);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-11：commitment 候选落 commitmentStatus=open，不产生执行\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst { sourceId, ref } = seedSource(store);\n\t\tconst c = candidate({\n\t\t\tsourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tkind: \"commitment\",\n\t\t\tconclusion: \"明天把 SQLite 备份脚本写完\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t});\n\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c], [ref]);\n\t\texpect(out.submitted).toBe(1);\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.kind).toBe(\"commitment\");\n\t\t\texpect(got.memory.content.commitmentStatus).toBe(\"open\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-13：批内同 kind+同归一结论无差异 → duplicate_in_batch\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-a\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-b\" });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", conclusion: \"内置记忆存储使用 SQLite\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\texpect(out.outcomes[1].status).toBe(\"skipped\");\n\t\texpect((out.outcomes[1] as { reason: string }).reason).toBe(\"duplicate_in_batch\");\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\t// ── I01：批内命中不再短路实质差异（与跨批同一分派）──────────────────\n\n\tit(\"I1 批内确认升级：第一条 tentative、第二条 confirmed 同结论同条件 → corrected 且最终 confirmed\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-tentative\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-confirm\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", confirmation: \"tentative\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", confirmation: \"confirmed\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"corrected\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I1 链式：批内 tentative→confirmed→第三条同条件 confirmed → 第三条 duplicate_in_batch\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-2\", capturedAt: AT2 });\n\t\tconst s3 = seedSource(store, { entryId: \"e-3\", capturedAt: AT });\n\t\tconst mk = (sourceId: string, confirmation: ValidatedCandidate[\"confirmation\"]) => {\n\t\t\tconst c = candidate({ sourceId, spanText: \"SQLite\", confirmation });\n\t\t\tc.quotedSpans = [{ sourceId, text: \"SQLite\" }];\n\t\t\treturn c;\n\t\t};\n\t\tconst out = await commit(store, service, [mk(s1.sourceId, \"tentative\"), mk(s2.sourceId, \"confirmed\"), mk(s3.sourceId, \"confirmed\")], [s1.ref, s2.ref, s3.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1].status).toBe(\"corrected\");\n\t\t// 第三条与 rev2（confirmed）无差异 → 真重复，仍走 duplicate_in_batch。\n\t\texpect(out.outcomes[2].status).toBe(\"skipped\");\n\t\texpect((out.outcomes[2] as { reason: string }).reason).toBe(\"duplicate_in_batch\");\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.currentRevision).toBe(2);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I2 批内条件重议：第一条 confirmed、第二条同结论异条件 user_statement → flagged needsReDiscussion\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-original\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-newcond\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({ sourceId: s2.sourceId, spanText: \"SQLite\", conditions: \"多机部署\" });\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"flagged\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\texpect(got.ok).toBe(true);\n\t\tif (got.ok) expect(got.memory.content.needsReDiscussion).toBe(true);\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I2 反向：第二条 confirmed 异条件 model_inference → semantic_conflict 不 flagged\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-original\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-infer\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\t// 推断来源的「条件变化」不能替用户改条件——重议必须有用户/执行实据。\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"多机部署\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[0].status).toBe(\"submitted\");\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"semantic_conflict\", memoryId });\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"I03 推断不触发重议：已 confirmed + 第二条 tentative/model_inference 异条件 → semantic_conflict\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst s1 = seedSource(store, { entryId: \"e-confirmed\" });\n\t\tconst s2 = seedSource(store, { sessionId: \"sess-2\", entryId: \"e-guess\", capturedAt: AT2 });\n\t\tconst c1 = candidate({ sourceId: s1.sourceId, spanText: \"SQLite\", confirmation: \"confirmed\" });\n\t\tc1.quotedSpans = [{ sourceId: s1.sourceId, text: \"SQLite\" }];\n\t\tconst c2 = candidate({\n\t\t\tsourceId: s2.sourceId,\n\t\t\tspanText: \"SQLite\",\n\t\t\tconditions: \"多机部署\",\n\t\t\tevidenceKind: \"model_inference\",\n\t\t\tconfirmation: \"tentative\",\n\t\t});\n\t\tc2.quotedSpans = [{ sourceId: s2.sourceId, text: \"SQLite\" }];\n\t\tconst out = await commit(store, service, [c1, c2], [s1.ref, s2.ref]);\n\t\texpect(out.outcomes[1]).toMatchObject({ status: \"skipped\", reason: \"semantic_conflict\" });\n\t\tconst memoryId = (out.outcomes[0] as { memoryId: string }).memoryId;\n\t\tconst got = await service.getMemory({ id: memoryId });\n\t\tif (got.ok) {\n\t\t\texpect(got.memory.content.needsReDiscussion).toBeUndefined();\n\t\t\texpect(got.memory.currentRevision).toBe(1);\n\t\t\texpect(got.memory.content.confirmation).toBe(\"confirmed\");\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n});\n\n// ── S2-03/04 模型请求与校验（假模型，不发真实请求）─────────────────────\n\ndescribe(\"requestExtraction\", () => {\n\t// TierConfig 用中文字段：provider + 档位数组（每项 名/provider/model/thinkingLevel）。\n\t// \"fast\" 别名归一命中「快」档，解析出 provider/modelId 供 modelRegistry.find。\n\tconst TIER: TierConfig = {\n\t\tprovider: \"pao\",\n\t\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n\t} as TierConfig;\n\tfunction fakeRegistry(\n\t\treply: string,\n\t\tonRequest?: (context: Context) => void,\n\t): RequestExtractionDeps[\"modelRegistry\"] {\n\t\treturn {\n\t\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\t\tstreamSimple: (_model, context) => {\n\t\t\t\tonRequest?.(context);\n\t\t\t\treturn {\n\t\t\t\t\tresult: () =>\n\t\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t\t}),\n\t\t\t\t} as never;\n\t\t\t},\n\t\t};\n\t}\n\tfunction fakeLedger() {\n\t\tconst calls: string[] = [];\n\t\treturn {\n\t\t\tcalls,\n\t\t\tappendUsage: (_k: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\t\tcalls.push(note ?? \"\");\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t\tappendCustomEntry: () => ({}) as never,\n\t\t};\n\t}\n\n\tit(\"合法候选经校验通过，附带 spanLocations\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { sourceId, entry } = seedSource(store);\n\t\tconst entries = [{ ...entry }];\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tconditions: \"不要常驻服务\",\n\t\t\t\trationale: \"单机维护成本低\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [sourceId],\n\t\t\t\tquotedSpans: [{ sourceId, text: \"内置记忆存储就用 SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst ledger = fakeLedger();\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: ledger as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure).toBeUndefined();\n\t\texpect(out.candidates).toHaveLength(1);\n\t\texpect(out.candidates[0].spanLocations[0].match).toBe(\"exact\");\n\t\texpect(ledger.calls[0]).toContain(\"jobId=j1\");\n\t\tstore.close();\n\t});\n\n\tit(\"提炼请求覆盖来源归属、互斥候选、重议与管理操作边界\", async () => {\n\t\tconst requests: Context[] = [];\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-candidate\",\n\t\t\t\tentryId: \"entry-candidate\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"候选方案：本地计算或外部服务。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-user\",\n\t\t\t\tentryId: \"entry-user\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"不要外部服务，太重。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-self-review\",\n\t\t\t\tentryId: \"entry-self-review\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"剩余本地计算未确认；没有看到其他原文，所以摘要是虚构的。\",\n\t\t\t},\n\t\t];\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", (context) => requests.push(context)),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-prompt\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"用户明确选定 X\");\n\t\texpect(prompt).toContain(\"用户明确否决 Y\");\n\t\texpect(prompt).toContain(\"采用 X 与拒绝 Y 必须拆成独立候选，分别记 confirmed 与 rejected\");\n\t\texpect(prompt).toContain(\"不能合并为一条 confirmed\");\n\t\texpect(prompt).toContain(\"取舍按用户作出该次决定当时已经提出的候选集合判断\");\n\t\texpect(prompt).toContain(\"若当时只有互斥「A 或 B」，用户排除 A 且没有明确留待定\");\n\t\texpect(prompt).toContain(\"B 就是该次取舍，记为 evidenceKind=user_statement、confirmation=confirmed\");\n\t\texpect(prompt).toContain(\"不要求用户再说「就选 B」\");\n\t\texpect(prompt).toContain(\n\t\t\t\"后续 assistant 单方面补充、建议、自评或重开 C、D 不撤销、不降级也不抹去该选择，也不能覆盖用户证据\",\n\t\t);\n\t\texpect(prompt).toContain(\"原候选、用户否决和后续 assistant 建议须分别准确引用各自的 sourceId 与原文\");\n\t\texpect(prompt).toContain(\n\t\t\t\"后续 assistant 的建议或自评只能记为 evidenceKind=model_inference、confirmation=tentative\",\n\t\t);\n\t\texpect(prompt).toContain(\"不能挂到用户来源或冒充 user_statement、用户确认\");\n\t\texpect(prompt).toContain(\"用户作出该次决定时若多候选未排完、明确表示未定或只是提议重议，仍为 tentative\");\n\t\texpect(prompt).toContain(\"对「先不定」「暂时这样」的简单附和、继续、记住或保留请求，只确认接收或保存暂定状态\");\n\t\texpect(prompt).toContain(\"不能把尚未定案的业务规则或「已确认的暂缓决定」提升 confirmed\");\n\t\texpect(prompt).toContain(\"真正明确的最终规则仍可 confirmed，不因「先」字一律降级\");\n\t\texpect(prompt).toContain(\"后续用户明确重新讨论或受新条件重议时，另记 tentative 并保留先前决定的理由\");\n\t\texpect(prompt).toContain(\"未展示或未命中只说明当前缺少来源\");\n\t\texpect(prompt).toContain(\"无来源断言不提炼为长期事实，即使写成经验或教训也不提炼\");\n\t\texpect(prompt).toContain(\"新条件不会自动使旧理由失效\");\n\t\texpect(prompt).toContain(\"只执行或复述管理操作时，不生成新候选\");\n\t\texpect(prompt).toContain(\"只提炼该独立内容\");\n\t\texpect(prompt).toContain(\n\t\t\t\"每条 quotedSpans 的 sourceId 必须是该段原文实际所在的条目，不能把 assistant 的话挂到 user 来源\",\n\t\t);\n\t\texpect(prompt).not.toContain(\"用户明确说「就用 X」「不要 Y」「决定是 Z」\");\n\t\texpect(prompt).not.toContain(\"没有明确留待定或其他候选\");\n\t\tconst userContent = requests[0]!.messages[0]?.content;\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-candidate\");\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-user\");\n\t\texpect(typeof userContent === \"string\" ? userContent : \"\").toContain(\"条目 sourceId=src-self-review\");\n\t\tfor (const entry of entries) expect(userContent).toContain(entry.content);\n\t});\n\n\tit(\"提炼请求要求同批承诺合并确认回声并保留实质新承诺\", async () => {\n\t\tconst requests: Context[] = [];\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-promise\",\n\t\t\t\tentryId: \"entry-promise\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"我会在周五前补齐部署说明。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-echo\",\n\t\t\t\tentryId: \"entry-echo\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"收到，你会在周五前补齐部署说明。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-new-promise\",\n\t\t\t\tentryId: \"entry-new-promise\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"另外我会核对回滚步骤。\",\n\t\t\t},\n\t\t];\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", (context) => requests.push(context)),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-promise\", sourceSessionId: \"sess-promise\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\texpect(requests).toHaveLength(1);\n\t\texpect(requests[0]!.systemPrompt).toContain(\n\t\t\t\"同一承诺的用户原文与 assistant 确认/复述合成一个 commitment 候选，优先准确引用用户来源\",\n\t\t);\n\t\texpect(requests[0]!.systemPrompt).toContain(\"纯确认或回声不另建独立承诺\");\n\t\texpect(requests[0]!.systemPrompt).toContain(\"同义承诺在本批内合并，不同任务或实质新承诺仍分别提炼\");\n\t\tconst content = requests[0]!.messages[0]?.content;\n\t\tfor (const entry of entries) {\n\t\t\texpect(content).toContain(`sourceId=${entry.sourceId} entryId=${entry.entryId} eventType=${entry.eventType}`);\n\t\t\texpect(content).toContain(entry.content);\n\t\t}\n\t});\n\n\tit(\"S2-04：quotedSpan 挂到错误来源时仍严格拒绝\", async () => {\n\t\tconst entries: ExtractionSourceEntry[] = [\n\t\t\t{\n\t\t\t\tsourceId: \"src-assistant\",\n\t\t\t\tentryId: \"entry-assistant\",\n\t\t\t\teventType: \"assistant\",\n\t\t\t\tcontent: \"候选方案：本地计算或外部服务。\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tsourceId: \"src-user\",\n\t\t\t\tentryId: \"entry-user\",\n\t\t\t\teventType: \"user\",\n\t\t\t\tcontent: \"不要外部服务，太重。\",\n\t\t\t},\n\t\t];\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"采用本地方案\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [\"src-user\"],\n\t\t\t\tquotedSpans: [{ sourceId: \"src-user\", text: \"候选方案：本地计算\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{ jobId: \"j-wrong-owner\", sourceSessionId: \"sess-1\", entries },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toEqual([]);\n\t\texpect(out.rejected[0]?.reasons.join()).toContain(\"quotedSpan 在来源 src-user\");\n\t});\n\n\tit(\"互斥二选一旦明确排除到唯一项，所选项与否决项经提炼提交各保留原状态\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst candidates = seedSource(store, {\n\t\t\tsessionId: \"sess-choice\",\n\t\t\tentryId: \"entry-candidates\",\n\t\t\teventType: \"assistant\",\n\t\t\tcontent: \"方案甲：本地计算或方案乙：外部服务。\",\n\t\t});\n\t\tconst decision = seedSource(store, {\n\t\t\tsessionId: \"sess-choice\",\n\t\t\tentryId: \"entry-decision\",\n\t\t\teventType: \"user\",\n\t\t\tcontent: \"不要方案乙，外部服务太重。\",\n\t\t});\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"采用本地方案\",\n\t\t\t\tconditions: \"排除外部服务\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [candidates.sourceId, decision.sourceId],\n\t\t\t\tquotedSpans: [\n\t\t\t\t\t{ sourceId: candidates.sourceId, text: \"方案甲：本地计算\" },\n\t\t\t\t\t{ sourceId: decision.sourceId, text: \"不要方案乙\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"外部服务方案被否决\",\n\t\t\t\trationale: \"太重\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"rejected\",\n\t\t\t\tsourceIds: [candidates.sourceId, decision.sourceId],\n\t\t\t\tquotedSpans: [\n\t\t\t\t\t{ sourceId: candidates.sourceId, text: \"方案乙：外部服务\" },\n\t\t\t\t\t{ sourceId: decision.sourceId, text: \"太重\" },\n\t\t\t\t],\n\t\t\t},\n\t\t]);\n\t\tconst extracted = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-choice\",\n\t\t\t\tsourceSessionId: \"sess-choice\",\n\t\t\t\tentries: [candidates.entry, decision.entry],\n\t\t\t},\n\t\t);\n\t\texpect(extracted.ok).toBe(true);\n\t\tif (!extracted.ok) return;\n\t\texpect(extracted.rejected).toEqual([]);\n\t\texpect(extracted.candidates).toHaveLength(2);\n\n\t\tconst committed = await commit(\n\t\t\tstore,\n\t\t\tservice,\n\t\t\textracted.candidates,\n\t\t\t[candidates.ref, decision.ref],\n\t\t\tSCOPE,\n\t\t\t\"j-choice\",\n\t\t);\n\t\texpect(committed.submitted).toBe(2);\n\t\tconst ids = committed.outcomes.flatMap((outcome) => (\"memoryId\" in outcome ? [outcome.memoryId] : []));\n\t\tconst stored = await Promise.all(ids.map((id) => service.getMemory({ id })));\n\t\texpect(stored.map((result) => (result.ok ? result.memory.content.conclusion : \"\"))).toEqual([\n\t\t\t\"采用本地方案\",\n\t\t\t\"外部服务方案被否决\",\n\t\t]);\n\t\texpect(stored.map((result) => (result.ok ? result.memory.content.confirmation : \"\"))).toEqual([\n\t\t\t\"confirmed\",\n\t\t\t\"rejected\",\n\t\t]);\n\t\tfor (const result of stored) {\n\t\t\tif (result.ok) {\n\t\t\t\texpect(result.sourceSummaries.map((source) => source.sourceId).sort()).toEqual(\n\t\t\t\t\t[candidates.sourceId, decision.sourceId].sort(),\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t\tawait service.close();\n\t\tstore.close();\n\t});\n\n\tit(\"S2-04：虚构 sourceId 的候选进 rejected 不提交\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { entry } = seedSource(store);\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"x\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"tentative\",\n\t\t\t\tsourceIds: [\"src-fake-999\"],\n\t\t\t\tquotedSpans: [{ sourceId: \"src-fake-999\", text: \"y\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"sourceIds\");\n\t\tstore.close();\n\t});\n\n\tit(\"S2-04：confirmed + model_inference 被拒\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { sourceId, entry } = seedSource(store);\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"模型擅自定案\",\n\t\t\t\tevidenceKind: \"model_inference\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [sourceId],\n\t\t\t\tquotedSpans: [{ sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/user_statement 只挂 toolResult 来源 → 拒（缺用户实据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"toolResult\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"用户拍板用 SQLite\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"eventType=user\");\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/execution 挂 toolResult 来源 → 通过校验\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"toolResult\", content: \"迁移脚本执行成功：SQLite 表已建\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"experience\",\n\t\t\t\tconclusion: \"SQLite 迁移脚本可建表\",\n\t\t\t\tevidenceKind: \"execution\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite 表已建\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.rejected).toEqual([]);\n\t\texpect(out.candidates).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/user_statement 至少一条 user 来源 → 通过校验\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"user\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tconditions: \"不要常驻服务\",\n\t\t\t\trationale: \"单机维护成本低\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"内置记忆存储就用 SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.rejected).toEqual([]);\n\t\texpect(out.candidates).toHaveLength(1);\n\t\tstore.close();\n\t});\n\n\tit(\"F08：confirmed/execution 挂 user 来源 → 拒（缺 toolResult 实据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s = seedSource(store, { eventType: \"user\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"experience\",\n\t\t\t\tconclusion: \"测试证明 SQLite 可用\",\n\t\t\t\tevidenceKind: \"execution\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s.sourceId, text: \"SQLite\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"eventType=toolResult\");\n\t\tstore.close();\n\t});\n\n\tit(\"F08：quotedSpan 指向 sourceIds 未声明的来源 → 拒（引用不闭合）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst s1 = seedSource(store, { entryId: \"e-1\", eventType: \"user\" });\n\t\tconst s2 = seedSource(store, { entryId: \"e-2\", eventType: \"user\", content: \"另一段用户原文\" });\n\t\tconst reply = JSON.stringify([\n\t\t\t{\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconclusion: \"内置记忆存储使用 SQLite\",\n\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s1.sourceId],\n\t\t\t\tquotedSpans: [{ sourceId: s2.sourceId, text: \"另一段用户原文\" }],\n\t\t\t},\n\t\t]);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(reply), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [s1.entry, s2.entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.candidates).toHaveLength(0);\n\t\texpect(out.rejected).toHaveLength(1);\n\t\texpect(out.rejected[0].reasons.join()).toContain(\"未列入 sourceIds\");\n\t\tstore.close();\n\t});\n\n\tit(\"解析失败返回 stage=parse 不二次请求\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst { entry } = seedSource(store);\n\t\tconst out = await requestExtraction(\n\t\t\t{ modelRegistry: fakeRegistry(\"这不是 JSON\"), ledger: fakeLedger() as never, tierConfig: TIER, paoHome: home },\n\t\t\t{ jobId: \"j1\", sourceSessionId: \"sess-1\", entries: [entry] },\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure?.stage).toBe(\"parse\");\n\t\tstore.close();\n\t});\n\n\t// ── O01：外发许可门 + 预算门 + 失败回执 + 日累计 ──────────────────────\n\n\tfunction writeBudgetFixtures(\n\t\thome: string,\n\t\tconfig: Record<string, unknown> | undefined,\n\t\tgrant = 10.0,\n\t): void {\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\tif (config !== undefined) {\n\t\t\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify(config));\n\t\t}\n\t\twriteFileSync(\n\t\t\tjoin(home, \"总预算账.json\"),\n\t\t\tJSON.stringify({\n\t\t\t\tversion: 1,\n\t\t\t\tgrants: [{ version: 1, 总预算: grant, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\t\t\treservations: [],\n\t\t\t}),\n\t\t);\n\t}\n\n\tfunction writeOutboundPermit(home: string, project: string, allowed: boolean): void {\n\t\tmkdirSync(join(home, \"知识库配置\"), { recursive: true });\n\t\twriteFileSync(\n\t\t\tjoin(home, \"知识库配置\", \"外发许可.json\"),\n\t\t\tJSON.stringify({ projects: { [project]: { allowed, asOf: \"2099-12-31\" } } }),\n\t\t\t\"utf8\",\n\t\t);\n\t}\n\n\tfunction fakeLedgerVerbose() {\n\t\tconst calls = { custom: [] as Array<{ type: string; data: unknown }>, usage: [] as string[] };\n\t\treturn {\n\t\t\tcalls,\n\t\t\tappendUsage: (_k: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\t\tcalls.usage.push(note ?? \"\");\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\t\tcalls.custom.push({ type, data });\n\t\t\t\treturn {} as never;\n\t\t\t},\n\t\t};\n\t}\n\n\tit(\"O01：缺预算配置 → 0 次请求，failure 含预算门原因\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\t// 只给总预算授权，不写 记忆后台预算.json。\n\t\twriteBudgetFixtures(home, undefined);\n\t\tlet requests = 0;\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: fakeLedgerVerbose() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-budget-missing\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(0);\n\t\texpect(out.failure?.stage).toBe(\"request\");\n\t\texpect(out.failure?.message).toContain(\"预算门拒绝\");\n\t\texpect(out.failure?.message).toContain(\"未配置\");\n\t});\n\n\tit(\"O01：外发未授权 → 0 次请求且不占预算\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", false);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tlet requests = 0;\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: fakeLedgerVerbose() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-outbound\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(0);\n\t\texpect(out.failure?.message).toContain(\"禁外发\");\n\t\texpect(out.failure?.message).toContain(\"proj-x\");\n\t\t// 未发请求不产生预留。\n\t\tconst ledgerFile = readBudgetLedger(budgetLedgerPath(home));\n\t\texpect(ledgerFile.reservations).toHaveLength(0);\n\t});\n\n\tit(\"O01：授权+预算齐 → 请求 1 次、预留/结算判据含 attemptKey\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tlet requests = 0;\n\t\tconst ledger = fakeLedgerVerbose();\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: fakeRegistry(\"[]\", () => {\n\t\t\t\t\trequests += 1;\n\t\t\t\t}),\n\t\t\t\tledger: ledger as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"batch-7\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-ok\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(requests).toBe(1);\n\t\texpect(out.failure).toBeUndefined();\n\t\t// 预留判据 = memory-job:j-ok:extract:batch-7:<requestId>（注入值作归属前缀，\n\t\t// 判据主体是一次一发的 requestId），且已结算（假 usage 无 cost 字段 → unknown）。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst reservation = file.reservations.find((r) =>\n\t\t\tr.idempotencyKey.startsWith(\"memory-job:j-ok:extract:batch-7:\"),\n\t\t);\n\t\texpect(reservation).toBeDefined();\n\t\t// 假模型 usage 没有 cost.total → 结算记 unknown（预留额占着不释放）。\n\t\texpect(reservation?.status).toBe(\"unknown\");\n\t\texpect(ledger.calls.custom.some((c) => c.type === \"pao-memory-extraction-attempt\")).toBe(true);\n\t});\n\n\tit(\"O01：streamSimple 抛异常 → failure custom entry + settle unknown\", async () => {\n\t\tconst home = tempHome();\n\t\twriteOutboundPermit(home, \"proj-x\", true);\n\t\twriteBudgetFixtures(home, { 每日上限: 1.0 });\n\t\tconst throwingRegistry = {\n\t\t\tfind: (_p: string, _m: string) => ({}) as never,\n\t\t\tstreamSimple: () => ({ result: () => Promise.reject(new Error(\"网络断\")) }) as never,\n\t\t};\n\t\tconst ledger = fakeLedgerVerbose();\n\t\tconst out = await requestExtraction(\n\t\t\t{\n\t\t\t\tmodelRegistry: throwingRegistry as never,\n\t\t\t\tledger: ledger as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\toutboundProjects: [\"proj-x\"],\n\t\t\t\tbudgetScopeKey: \"session:sess-1\",\n\t\t\t\tbudgetAttemptKey: \"b-1\",\n\t\t\t},\n\t\t\t{\n\t\t\t\tjobId: \"j-throw\",\n\t\t\t\tsourceSessionId: \"sess-1\",\n\t\t\t\tentries: [{ sourceId: \"s1\", entryId: \"e1\", eventType: \"user\", content: \"内容\" }],\n\t\t\t},\n\t\t);\n\t\texpect(out.ok).toBe(true);\n\t\tif (!out.ok) return;\n\t\texpect(out.failure?.stage).toBe(\"request\");\n\t\texpect(out.failure?.message).toContain(\"网络断\");\n\t\texpect(\n\t\t\tledger.calls.custom.some(\n\t\t\t\t(c) =>\n\t\t\t\t\tc.type === \"pao-memory-extraction-failure\" &&\n\t\t\t\t\tJSON.stringify(c.data).includes(\"j-throw\"),\n\t\t\t),\n\t\t).toBe(true);\n\t\tconst reservation = readBudgetLedger(budgetLedgerPath(home)).reservations.find(\n\t\t\t(r) => r.idempotencyKey.startsWith(\"memory-job:j-throw:extract:b-1:\"),\n\t\t);\n\t\texpect(reservation?.status).toBe(\"unknown\");\n\t});\n\n\tit(\"O01：日累计 每日上限=0.06 两次 0.05 → 第二次额度不足\", async () => {\n\t\tconst home = tempHome();\n\t\twriteBudgetFixtures(home, { 每日上限: 0.06 });\n\t\tconst first = await checkMemoryJobBudget({\n\t\t\tpaoHome: home,\n\t\t\tjobId: \"job-a\",\n\t\t\tjobKind: \"extract\",\n\t\t\tscopeKey: \"s\",\n\t\t\t金额: 0.05,\n\t\t\t现在: AT,\n\t\t});\n\t\texpect(first.ok).toBe(true);\n\t\tconst second = await checkMemoryJobBudget({\n\t\t\tpaoHome: home,\n\t\t\tjobId: \"job-b\",\n\t\t\tjobKind: \"extract\",\n\t\t\tscopeKey: \"s\",\n\t\t\t金额: 0.05,\n\t\t\t现在: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(false);\n\t\tif (second.ok) return;\n\t\texpect(second.kind).toBe(\"额度不足\");\n\t\texpect(second.reason).toContain(\"当日累计\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелыimport { resolveMemoryProjectIdentity } from \"../../src/pao/memory/project-identity.ts\";\nimport { registerProjectSession } from \"../../src/pao/memory/project-session.ts\";\nimport { readTaskContinuation, taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\nimport { type BuiltinMemoryRegistration, registerBuiltinMemory, scopeFromContext, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { registerTodo } from \"../../src/pao/todo/index.ts\";\nimport { createSingleRootWorktreeHost } from \"../../src/pao/worktrees/types.ts\";\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,280]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[280,547]}}},{"diffOp":{"equal":{"range":[547,557]}}},{"diffOp":{"insert":{"range":[557,589]}}},{"diffOp":{"equal":{"range":[589,628]}}},{"diffOp":{"delete":{"range":[628,660]}}},{"diffOp":{"equal":{"range":[660,700]}}},{"diffOp":{"equal":{"range":[700,841]}}},{"equalLines":{"line_count":367}},{"diffOp":{"equal":{"range":[841,850]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-f14-review.test.ts"},"span":[828,900],"sourceCode":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелы\n * в memory-project-session.test.ts:\n *  - смешанная таблица completed/cancelled → workpoint честно пересчитывает cancelled;\n *  - todo_write с пустой таблицей → НИЧЕГО не записывается (старый nextStep выживает);\n *  - карта с delivered статусом → saveSettledContinuation не пишет вообще (ранний return).\n *\n * Файл для ревью O09, самодостаточен; использует общий test-harness.\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport {\n\ttype Context,\n\tfauxAssistantMessage,\n\tfauxProvider,\n\tfauxToolCall,\n\tgetCurrentSystemPrompt,\n\tInMemoryModelsStore,\n} from \"@pao/ai\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { ModelRuntime } from \"../../src/core/model-runtime.ts\";\nimport { createAgentSession } from \"../../src/core/sdk.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { SettingsManager } from \"../../src/core/settings-manager.ts\";\nimport { bindExecutionContext } from \"../../src/pao/cards/execution-context.ts\";\nimport { changeCardStatus, createCard, loadCard } from \"../../src/pao/cards/index.ts\";\nimport { registerPaoCommand } from \"../../src/pao/command-router.ts\";\nimport { resolveMemoryProjectIdentity } from \"../../src/pao/memory/project-identity.ts\";\nimport { registerProjectSession } from \"../../src/pao/memory/project-session.ts\";\nimport { readTaskContinuation, taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\nimport { registerBuiltinMemory, scopeFromContext, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { registerTodo } from \"../../src/pao/todo/index.ts\";\nimport { createSingleRootWorktreeHost } from \"../../src/pao/worktrees/types.ts\";\nimport { createTestUiContext } from \"../suite/harness.ts\";\nimport { createTestExtensionsResult, createTestResourceLoader } from \"../utilities.ts\";\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawn: vi.fn(actual.spawn),\n\t\texecFile: vi.fn(actual.execFile),\n\t\texecFileSync: vi.fn(actual.execFileSync),\n\t};\n});\n\nconst roots: string[] = [];\nconst fixtures: SdkFixture[] = [];\n\ninterface SdkFixture {\n\troot: string;\n\thome: string;\n\tproject: string;\n\tprojectId: string;\n\tcardsDir: string;\n\tsessionManager: SessionManager;\n\tsession: Awaited<ReturnType<typeof createAgentSession>>[\"session\"];\n\tregistration: BuiltinMemoryRegistration;\n\tfaux: ReturnType<typeof fauxProvider>;\n\tprompts: string[];\n\tnotifications: Array<{ message: string; type: string }>;\n\tclose: () => Promise<void>;\n}\n\nfunction tempDir(prefix: string): string {\n\tconst path = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(path);\n\treturn path;\n}\n\nfunction fixturePaths(root = tempDir(\"pao-f14-\")) {\n\tconst home = join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\treturn {\n\t\troot,\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tprojectId: resolveMemoryProjectIdentity(project).projectId,\n\t};\n}\n\nasync function createFixture(): Promise<SdkFixture> {\n\tconst paths = fixturePaths();\n\tconst sessionManager = SessionManager.create(paths.project, paths.sessions, { id: \"f14-session\" });\n\tconst runtime = await ModelRuntime.create({\n\t\tcredentials: AuthStorage.inMemory(),\n\t\tmodelsStore: new InMemoryModelsStore(),\n\t\tmodelsPath: null,\n\t\tallowModelNetwork: false,\n\t});\n\tconst faux = fauxProvider({ tokensPerSecond: 1_000_000 });\n\truntime.registerNativeProvider(faux.provider);\n\tawait runtime.refresh({ allowNetwork: false });\n\n\tconst prompts: string[] = [];\n\tconst notifications: Array<{ message: string; type: string }> = [];\n\tlet registration!: BuiltinMemoryRegistration;\n\tconst extensionsResult = await createTestExtensionsResult(\n\t\t[\n\t\t\t(pi) => {\n\t\t\t\tregistration = registerBuiltinMemory(pi, {\n\t\t\t\t\tpaoHome: paths.home,\n\t\t\t\t\tembedding: { timeoutMs: 20 },\n\t\t\t\t});\n\t\t\t\tregisterTodo(pi);\n\t\t\t\tregisterFakeDispatch(pi);\n\t\t\t\tregisterProjectSession(pi, {\n\t\t\t\t\tresolvePaoHome: () => paths.home,\n\t\t\t\t\tresolveMemoryService: () => (registration?.service.opened ? registration.service : undefined),\n\t\t\t\t\tresolveCardsDir: () => paths.cardsDir,\n\t\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t\t});\n\t\t\t\tregisterPaoCommand(pi, () => undefined);\n\t\t\t},\n\t\t],\n\t\tpaths.project,\n\t);\n\tconst { session } = await createAgentSession({\n\t\tcwd: paths.project,\n\t\tagentDir: join(paths.root, \"agent\"),\n\t\tmodelRuntime: runtime,\n\t\tmodel: faux.getModel(),\n\t\tsessionManager,\n\t\tsettingsManager: SettingsManager.inMemory({\n\t\t\tcompaction: { enabled: false, reserveTokens: 0, keepRecentTokens: 1 },\n\t\t\tretry: { enabled: false },\n\t\t}),\n\t\tresourceLoader: createTestResourceLoader({ extensionsResult }),\n\t});\n\tawait session.bindExtensions({\n\t\tuiContext: createTestUiContext({\n\t\t\tnotify: (message, type) => notifications.push({ message, type: type ?? \"info\" }),\n\t\t}),\n\t});\n\n\tconst fixture: SdkFixture = {\n\t\troot: paths.root,\n\t\thome: paths.home,\n\t\tproject: paths.project,\n\t\tprojectId: paths.projectId,\n\t\tcardsDir: paths.cardsDir,\n\t\tsessionManager,\n\t\tsession,\n\t\tregistration,\n\t\tfaux,\n\t\tprompts,\n\t\tnotifications,\n\t\tclose: async () => {\n\t\t\tsession.dispose();\n\t\t\tawait registration.close();\n\t\t},\n\t};\n\tfixtures.push(fixture);\n\treturn fixture;\n}\n\nfunction registerFakeDispatch(pi: ExtensionAPI): void {\n\tpi.registerTool({\n\t\tname: \"pao_dispatch_card\",\n\t\tlabel: \"测试派卡\",\n\t\tdescription: \"测试用真实工具结果契约，不执行派发。\",\n\t\tparameters: {\n\t\t\ttype: \"object\",\n\t\t\tproperties: { cards_dir: { type: \"string\" }, card_no: { type: \"number\" } },\n\t\t},\n\t\tasync execute(_toolCallId, params) {\n\t\t\treturn {\n\t\t\t\tcontent: [{ type: \"text\" as const, text: `已派发 ${(params as { card_no: number }).card_no}` }],\n\t\t\t\tdetails: { dispatched: true, card_no: (params as { card_no: number }).card_no },\n\t\t\t};\n\t\t},\n\t} as Parameters<ExtensionAPI[\"registerTool\"]>[0]);\n}\n\nfunction capture(fixture: SdkFixture, response: () => ReturnType<typeof fauxAssistantMessage>) {\n\treturn (context: Context) => {\n\t\tfixture.prompts.push(getCurrentSystemPrompt(context.messages));\n\t\treturn response();\n\t};\n}\n\nfunction plain(fixture: SdkFixture, text: string) {\n\treturn capture(fixture, () => fauxAssistantMessage(text));\n}\n\nfunction toolThenFinal(\n\tfixture: SdkFixture,\n\ttoolName: string,\n\targs: Parameters<typeof fauxToolCall>[1],\n\ttoolCallId: string,\n\tfinalText: string,\n) {\n\tfixture.faux.setResponses([\n\t\tcapture(fixture, () => fauxAssistantMessage(fauxToolCall(toolName, args, { id: toolCallId }))),\n\t\tplain(fixture, finalText),\n\t]);\n}\n\nasync function createAttemptOneCard(fixture: SdkFixture) {\n\tconst card = await createCard(fixture.cardsDir, {\n\t\t目标: \"F14 卡任务\",\n\t\t部门: \"研发\",\n\t\t验收: \"delivered 不影响接续\",\n\t\t创建: \"2026-11-15 10:00\",\n\t});\n\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t操作者: \"owner\",\n\t\tto: \"in_progress\",\n\t\t时间: \"2026-11-15 10:01\",\n\t});\n\tconst worktree = await createSingleRootWorktreeHost(fixture.project).resolveForDispatch({\n\t\trequestId: \"f14-card\",\n\t\tprojectRoot: fixture.project,\n\t\ttarget: { kind: \"primary\" },\n\t});\n\tawait bindExecutionContext(\n\t\t{\n\t\t\tkey: { cardsDir: fixture.cardsDir, cardNo: card.card_no, attempt: 1 },\n\t\t\tprojectRoot: fixture.project,\n\t\t\trepositoryRoot: fixture.project,\n\t\t\texecutionRoot: fixture.project,\n\t\t\tworktree,\n\t\t\tsnapshotRef: \"pao-test://f14/card\",\n\t\t\tsnapshotDigest: `sha256:${\"c\".repeat(64)}`,\n\t\t},\n\t\t{ expectedCurrentAttempt: 1 },\n\t);\n\treturn loadCard(fixture.cardsDir, card.card_no);\n}\n\nafterEach(async () => {\n\tfor (const fixture of fixtures.splice(0).reverse()) await fixture.close();\n\tfor (const root of roots.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(root, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 40));\n\t\t\t}\n\t\t}\n\t}\n});\n\ndescribe(\"F14 独立复核：终态 todo 表的接续语义\", () => {\n\tit(\"смешанная таблица completed+cancelled: workpoint честно перечисляет cancelled, nextStep без旧待办\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\t// 有待办: A in_progress, B pending, C pending\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"in_progress\" },\n\t\t\t\t\t{ content: \"B\", status: \"pending\" },\n\t\t\t\t\t{ content: \"C\", status: \"pending\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-pending\",\n\t\t\t\"部分待办\",\n\t\t);\n\t\tawait fixture.session.prompt(\"начал\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：A\");\n\n\t\t// 终态: A completed, B cancelled, C cancelled → 1/3 完成 + 2 отменено\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"completed\" },\n\t\t\t\t\t{ content: \"B\", status: \"cancelled\" },\n\t\t\t\t\t{ content: \"C\", status: \"cancelled\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-done\",\n\t\t\t\"全部终态\",\n\t\t);\n\t\tawait fixture.session.prompt(\"завершил\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(after.ok && after.status).toBe(\"ready\");\n\t\tif (!after.ok) return;\n\t\t// workpoint: «完成 1/3，另有 2 项已取消；无剩余待办» — не врёт про cancelled\n\t\texpect(after.continuation.workpoint?.text).toContain(\"完成 1/3\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"2 项已取消\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"无剩余待办\");\n\t\texpect(after.nextStep?.text).toContain(\"已全部完成\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：B\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：C\");\n\t});\n\n\tit(\"пустая таблица todo_write: ранний return, старый nextStep не перезаписывается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"甲\", status: \"in_progress\" }] },\n\t\t\t\"pending-todo\",\n\t\t\t\"甲\",\n\t\t);\n\t\tawait fixture.session.prompt(\"开始甲\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：甲\");\n\n\t\t// Пустая таблица — сигнал «очистить», а не «всё сделано». Функция должна вернуть\n\t\t// undefined и не перезаписывать существующую запись.\n\t\ttoolThenFinal(fixture, \"todo_write\", { todos: [] }, \"empty-todo\", \"пустая таблица\");\n\t\tawait fixture.session.prompt(\"todo очищен\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\t// Старый nextStep сохранился — запись не обновилась «0/0»\n\t\texpect(after.ok && after.nextStep?.text).toContain(\"继续处理：甲\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"进行中：甲\");\n\t});\n\n\tit(\"delivered карта: ранний return saveSettledContinuation, запись карты не трогается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tconst card = await createAttemptOneCard(fixture);\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(`/pao task new`);\n\t\t// Переводим карту в delivered ДО settle — сработает ранний return\n\t\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t\t操作者: \"owner\",\n\t\t\tto: \"delivered\",\n\t\t\t时间: \"2026-11-15 10:30\",\n\t\t});\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"card work\", status: \"completed\" }] },\n\t\t\t\"card-todo\",\n\t\t\t\"card todo\",\n\t\t);\n\t\tawait fixture.session.prompt(\"card done\");\n\t\tconst cardTaskId = taskIdForCard(fixture.cardsDir, card.card_no);\n\t\tconst read = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: cardTaskId,\n\t\t});\n\t\t// delivered ранний return — запись карты либо отсутствует, либо не обновилась\n\t\t// ( не «готово/продолжай» по todo ).\n\t\tif (read.ok) {\n\t\t\texpect(read.nextStep?.text ?? \"\").not.toContain(\"继续处理：card work\");\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелы\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\t e.type === \"custom\" &&(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\ttoolThenFinal(fixture,\"todo_write\",{ todos: [{ content: \"甲\", status: \"in_progress\" }] },\"pending-todo\",\"甲\",\n\t\t);\n\t\tawait fixture.session.prompt(\"开始甲\");\n\t\tconst before = await readTaskContinuation({\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,280]}}},{"equalLines":{"line_count":259}},{"diffOp":{"equal":{"range":[280,318]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[325,347]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[347,492]}}},{"equalLines":{"line_count":63}},{"diffOp":{"equal":{"range":[280,318]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[325,347]}}},{"diffOp":{"delete":{"range":[318,324]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[492,668]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"equal":{"range":[668,676]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[676,689]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[689,744]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[744,759]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[324,325]}}},{"diffOp":{"equal":{"range":[759,764]}}},{"diffOp":{"delete":{"range":[764,768]}}},{"diffOp":{"equal":{"range":[768,861]}}},{"equalLines":{"line_count":54}},{"diffOp":{"equal":{"range":[861,870]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-f14-review.test.ts"},"span":null,"sourceCode":"/**\n * Независимые отрицательные сценарии F14 (O09): терминальная таблица todo  должна\n * перезаписывать старый nextStep завершённой семантикой. Покрываются пробелы\n * в memory-project-session.test.ts:\n *  - смешанная таблица completed/cancelled → workpoint честно пересчитывает cancelled;\n *  - todo_write с пустой таблицей → НИЧЕГО не записывается (старый nextStep выживает);\n *  - карта с delivered статусом → saveSettledContinuation не пишет вообще (ранний return).\n *\n * Файл для ревью O09, самодостаточен; использует общий test-harness.\n */\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport {\n\ttype Context,\n\tfauxAssistantMessage,\n\tfauxProvider,\n\tfauxToolCall,\n\tgetCurrentSystemPrompt,\n\tInMemoryModelsStore,\n} from \"@pao/ai\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { ModelRuntime } from \"../../src/core/model-runtime.ts\";\nimport { createAgentSession } from \"../../src/core/sdk.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { SettingsManager } from \"../../src/core/settings-manager.ts\";\nimport { bindExecutionContext } from \"../../src/pao/cards/execution-context.ts\";\nimport { changeCardStatus, createCard, loadCard } from \"../../src/pao/cards/index.ts\";\nimport { registerPaoCommand } from \"../../src/pao/command-router.ts\";\nimport { resolveMemoryProjectIdentity } from \"../../src/pao/memory/project-identity.ts\";\nimport { registerProjectSession } from \"../../src/pao/memory/project-session.ts\";\nimport { readTaskContinuation, taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\nimport { registerBuiltinMemory, scopeFromContext, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { registerTodo } from \"../../src/pao/todo/index.ts\";\nimport { createSingleRootWorktreeHost } from \"../../src/pao/worktrees/types.ts\";\nimport { createTestUiContext } from \"../suite/harness.ts\";\nimport { createTestExtensionsResult, createTestResourceLoader } from \"../utilities.ts\";\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawn: vi.fn(actual.spawn),\n\t\texecFile: vi.fn(actual.execFile),\n\t\texecFileSync: vi.fn(actual.execFileSync),\n\t};\n});\n\nconst roots: string[] = [];\nconst fixtures: SdkFixture[] = [];\n\ninterface SdkFixture {\n\troot: string;\n\thome: string;\n\tproject: string;\n\tprojectId: string;\n\tcardsDir: string;\n\tsessionManager: SessionManager;\n\tsession: Awaited<ReturnType<typeof createAgentSession>>[\"session\"];\n\tregistration: BuiltinMemoryRegistration;\n\tfaux: ReturnType<typeof fauxProvider>;\n\tprompts: string[];\n\tnotifications: Array<{ message: string; type: string }>;\n\tclose: () => Promise<void>;\n}\n\nfunction tempDir(prefix: string): string {\n\tconst path = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(path);\n\treturn path;\n}\n\nfunction fixturePaths(root = tempDir(\"pao-f14-\")) {\n\tconst home = join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\treturn {\n\t\troot,\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tprojectId: resolveMemoryProjectIdentity(project).projectId,\n\t};\n}\n\nasync function createFixture(): Promise<SdkFixture> {\n\tconst paths = fixturePaths();\n\tconst sessionManager = SessionManager.create(paths.project, paths.sessions, { id: \"f14-session\" });\n\tconst runtime = await ModelRuntime.create({\n\t\tcredentials: AuthStorage.inMemory(),\n\t\tmodelsStore: new InMemoryModelsStore(),\n\t\tmodelsPath: null,\n\t\tallowModelNetwork: false,\n\t});\n\tconst faux = fauxProvider({ tokensPerSecond: 1_000_000 });\n\truntime.registerNativeProvider(faux.provider);\n\tawait runtime.refresh({ allowNetwork: false });\n\n\tconst prompts: string[] = [];\n\tconst notifications: Array<{ message: string; type: string }> = [];\n\tlet registration!: BuiltinMemoryRegistration;\n\tconst extensionsResult = await createTestExtensionsResult(\n\t\t[\n\t\t\t(pi) => {\n\t\t\t\tregistration = registerBuiltinMemory(pi, {\n\t\t\t\t\tpaoHome: paths.home,\n\t\t\t\t\tembedding: { timeoutMs: 20 },\n\t\t\t\t});\n\t\t\t\tregisterTodo(pi);\n\t\t\t\tregisterFakeDispatch(pi);\n\t\t\t\tregisterProjectSession(pi, {\n\t\t\t\t\tresolvePaoHome: () => paths.home,\n\t\t\t\t\tresolveMemoryService: () => (registration?.service.opened ? registration.service : undefined),\n\t\t\t\t\tresolveCardsDir: () => paths.cardsDir,\n\t\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t\t});\n\t\t\t\tregisterPaoCommand(pi, () => undefined);\n\t\t\t},\n\t\t],\n\t\tpaths.project,\n\t);\n\tconst { session } = await createAgentSession({\n\t\tcwd: paths.project,\n\t\tagentDir: join(paths.root, \"agent\"),\n\t\tmodelRuntime: runtime,\n\t\tmodel: faux.getModel(),\n\t\tsessionManager,\n\t\tsettingsManager: SettingsManager.inMemory({\n\t\t\tcompaction: { enabled: false, reserveTokens: 0, keepRecentTokens: 1 },\n\t\t\tretry: { enabled: false },\n\t\t}),\n\t\tresourceLoader: createTestResourceLoader({ extensionsResult }),\n\t});\n\tawait session.bindExtensions({\n\t\tuiContext: createTestUiContext({\n\t\t\tnotify: (message, type) => notifications.push({ message, type: type ?? \"info\" }),\n\t\t}),\n\t});\n\n\tconst fixture: SdkFixture = {\n\t\troot: paths.root,\n\t\thome: paths.home,\n\t\tproject: paths.project,\n\t\tprojectId: paths.projectId,\n\t\tcardsDir: paths.cardsDir,\n\t\tsessionManager,\n\t\tsession,\n\t\tregistration,\n\t\tfaux,\n\t\tprompts,\n\t\tnotifications,\n\t\tclose: async () => {\n\t\t\tsession.dispose();\n\t\t\tawait registration.close();\n\t\t},\n\t};\n\tfixtures.push(fixture);\n\treturn fixture;\n}\n\nfunction registerFakeDispatch(pi: ExtensionAPI): void {\n\tpi.registerTool({\n\t\tname: \"pao_dispatch_card\",\n\t\tlabel: \"测试派卡\",\n\t\tdescription: \"测试用真实工具结果契约，不执行派发。\",\n\t\tparameters: {\n\t\t\ttype: \"object\",\n\t\t\tproperties: { cards_dir: { type: \"string\" }, card_no: { type: \"number\" } },\n\t\t},\n\t\tasync execute(_toolCallId, params) {\n\t\t\treturn {\n\t\t\t\tcontent: [{ type: \"text\" as const, text: `已派发 ${(params as { card_no: number }).card_no}` }],\n\t\t\t\tdetails: { dispatched: true, card_no: (params as { card_no: number }).card_no },\n\t\t\t};\n\t\t},\n\t} as Parameters<ExtensionAPI[\"registerTool\"]>[0]);\n}\n\nfunction capture(fixture: SdkFixture, response: () => ReturnType<typeof fauxAssistantMessage>) {\n\treturn (context: Context) => {\n\t\tfixture.prompts.push(getCurrentSystemPrompt(context.messages));\n\t\treturn response();\n\t};\n}\n\nfunction plain(fixture: SdkFixture, text: string) {\n\treturn capture(fixture, () => fauxAssistantMessage(text));\n}\n\nfunction toolThenFinal(\n\tfixture: SdkFixture,\n\ttoolName: string,\n\targs: Parameters<typeof fauxToolCall>[1],\n\ttoolCallId: string,\n\tfinalText: string,\n) {\n\tfixture.faux.setResponses([\n\t\tcapture(fixture, () => fauxAssistantMessage(fauxToolCall(toolName, args, { id: toolCallId }))),\n\t\tplain(fixture, finalText),\n\t]);\n}\n\nasync function createAttemptOneCard(fixture: SdkFixture) {\n\tconst card = await createCard(fixture.cardsDir, {\n\t\t目标: \"F14 卡任务\",\n\t\t部门: \"研发\",\n\t\t验收: \"delivered 不影响接续\",\n\t\t创建: \"2026-11-15 10:00\",\n\t});\n\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t操作者: \"owner\",\n\t\tto: \"in_progress\",\n\t\t时间: \"2026-11-15 10:01\",\n\t});\n\tconst worktree = await createSingleRootWorktreeHost(fixture.project).resolveForDispatch({\n\t\trequestId: \"f14-card\",\n\t\tprojectRoot: fixture.project,\n\t\ttarget: { kind: \"primary\" },\n\t});\n\tawait bindExecutionContext(\n\t\t{\n\t\t\tkey: { cardsDir: fixture.cardsDir, cardNo: card.card_no, attempt: 1 },\n\t\t\tprojectRoot: fixture.project,\n\t\t\trepositoryRoot: fixture.project,\n\t\t\texecutionRoot: fixture.project,\n\t\t\tworktree,\n\t\t\tsnapshotRef: \"pao-test://f14/card\",\n\t\t\tsnapshotDigest: `sha256:${\"c\".repeat(64)}`,\n\t\t},\n\t\t{ expectedCurrentAttempt: 1 },\n\t);\n\treturn loadCard(fixture.cardsDir, card.card_no);\n}\n\nafterEach(async () => {\n\tfor (const fixture of fixtures.splice(0).reverse()) await fixture.close();\n\tfor (const root of roots.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(root, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 40));\n\t\t\t}\n\t\t}\n\t}\n});\n\ndescribe(\"F14 独立复核：终态 todo 表的接续语义\", () => {\n\tit(\"смешанная таблица completed+cancelled: workpoint честно перечисляет cancelled, nextStep без旧待办\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\t// 有待办: A in_progress, B pending, C pending\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"in_progress\" },\n\t\t\t\t\t{ content: \"B\", status: \"pending\" },\n\t\t\t\t\t{ content: \"C\", status: \"pending\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-pending\",\n\t\t\t\"部分待办\",\n\t\t);\n\t\tawait fixture.session.prompt(\"начал\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：A\");\n\n\t\t// 终态: A completed, B cancelled, C cancelled → 1/3 完成 + 2 отменено\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{\n\t\t\t\ttodos: [\n\t\t\t\t\t{ content: \"A\", status: \"completed\" },\n\t\t\t\t\t{ content: \"B\", status: \"cancelled\" },\n\t\t\t\t\t{ content: \"C\", status: \"cancelled\" },\n\t\t\t\t],\n\t\t\t},\n\t\t\t\"mixed-done\",\n\t\t\t\"全部终态\",\n\t\t);\n\t\tawait fixture.session.prompt(\"завершил\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(after.ok && after.status).toBe(\"ready\");\n\t\tif (!after.ok) return;\n\t\t// workpoint: «完成 1/3，另有 2 项已取消；无剩余待办» — не врёт про cancelled\n\t\texpect(after.continuation.workpoint?.text).toContain(\"完成 1/3\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"2 项已取消\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"无剩余待办\");\n\t\texpect(after.nextStep?.text).toContain(\"已全部完成\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：B\");\n\t\texpect(after.nextStep?.text).not.toContain(\"继续处理：C\");\n\t});\n\n\tit(\"пустая таблица todo_write: ранний return, старый nextStep не перезаписывается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(\"/pao task new\");\n\t\tconst taskId = fixture.sessionManager\n\t\t\t.getBranch()\n\t\t\t.filter(\n\t\t\t\t(e) =>\n\t\t\t\t\te.type === \"custom\" &&\n\t\t\t\t\t(e as { customType?: string }).customType === \"pao-project-session-binding\",\n\t\t\t)\n\t\t\t.map((e) => (e as { data: { taskId: string } }).data.taskId)\n\t\t\t.at(-1)!;\n\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"甲\", status: \"in_progress\" }] },\n\t\t\t\"pending-todo\",\n\t\t\t\"甲\",\n\t\t);\n\t\tawait fixture.session.prompt(\"开始甲\");\n\t\tconst before = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\texpect(before.ok && before.nextStep?.text).toContain(\"继续处理：甲\");\n\n\t\t// Пустая таблица — сигнал «очистить», а не «всё сделано». Функция должна вернуть\n\t\t// undefined и не перезаписывать существующую запись.\n\t\ttoolThenFinal(fixture, \"todo_write\", { todos: [] }, \"empty-todo\", \"пустая таблица\");\n\t\tawait fixture.session.prompt(\"todo очищен\");\n\n\t\tconst after = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId,\n\t\t});\n\t\t// Старый nextStep сохранился — запись не обновилась «0/0»\n\t\texpect(after.ok && after.nextStep?.text).toContain(\"继续处理：甲\");\n\t\texpect(after.continuation.workpoint?.text).toContain(\"进行中：甲\");\n\t});\n\n\tit(\"delivered карта: ранний return saveSettledContinuation, запись карты не трогается\", async () => {\n\t\tconst fixture = await createFixture();\n\t\tconst card = await createAttemptOneCard(fixture);\n\t\tfixture.faux.setResponses([]);\n\t\tawait fixture.session.prompt(`/pao task new`);\n\t\t// Переводим карту в delivered ДО settle — сработает ранний return\n\t\tchangeCardStatus(loadCard(fixture.cardsDir, card.card_no), {\n\t\t\t操作者: \"owner\",\n\t\t\tto: \"delivered\",\n\t\t\t时间: \"2026-11-15 10:30\",\n\t\t});\n\t\ttoolThenFinal(\n\t\t\tfixture,\n\t\t\t\"todo_write\",\n\t\t\t{ todos: [{ content: \"card work\", status: \"completed\" }] },\n\t\t\t\"card-todo\",\n\t\t\t\"card todo\",\n\t\t);\n\t\tawait fixture.session.prompt(\"card done\");\n\t\tconst cardTaskId = taskIdForCard(fixture.cardsDir, card.card_no);\n\t\tconst read = await readTaskContinuation({\n\t\t\tpaoHome: fixture.home,\n\t\t\tmemoryService: fixture.registration.service,\n\t\t\tprojectId: fixture.projectId,\n\t\t\ttaskId: cardTaskId,\n\t\t});\n\t\t// delivered ранний return — запись карты либо отсутствует, либо не обновилась\n\t\t// ( не «готово/продолжай» по todo ).\n\t\tif (read.ok) {\n\t\t\texpect(read.nextStep?.text ?? \"\").not.toContain(\"继续处理：card work\");\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *\nfunction ftsIds(store: MemoryStore): string[] {\n\treturn (\n\t\tstore.db.prepare(\"SELECT memory_id FROM memory_fts ORDER BY memory_id\").all() as Array<{ memory_id: string }>).map((r) => r.memory_id,\n\t);\n}\n\nasync function seed(store: MemoryStore, home: string,over: { conclusion: string; kind?: \"decision\" | \"experience\"; projectId: string }) {\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\ttry {\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(\n\t\t\tpi,() => undefined,() => home,\n\t\t);\n\t\tawait runMemory(pi, \"rebuild\", ctx);\n);\n\t\tawait runMemory(pi, `rebuild --project ${PROJECT_A}`, ctx);\n() => home,{ enqueue });\n\t\tawait runMemory(pi, \"backup D:\\\\backups\\\\mem-001\", ctx);\n);\n\t\tawait runMemory(pi, \"backup /tmp/whatever\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith();\n\t\tawait runMemory(pi, `restore ${backupDir} ${targetHome}`, ctx);\n);\n\t\tawait runMemory(pi, \"restore onlydir\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":54}},{"diffOp":{"equal":{"range":[101,159]}}},{"diffOp":{"insert":{"range":[159,162]}}},{"diffOp":{"equal":{"range":[162,271]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[271,277]}}},{"diffOp":{"delete":{"range":[159,162]}}},{"diffOp":{"equal":{"range":[277,295]}}},{"diffOp":{"delete":{"range":[295,298]}}},{"diffOp":{"equal":{"range":[298,324]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[324,343]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[344,357]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[357,438]}}},{"diffOp":{"insert":{"range":[295,297]}}},{"diffOp":{"equal":{"range":[438,522]}}},{"equalLines":{"line_count":49}},{"diffOp":{"equal":{"range":[522,618]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[622,625]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[625,641]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp"