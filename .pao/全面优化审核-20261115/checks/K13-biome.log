"path":{"file":"packages\\coding-agent\\test\\pao\\memory-artifact-card-hooks.test.ts"},"span":[979,1029],"sourceCode":"/**\n * F11（O08）挂点真实链路测试：卡回执边界登记成果 + resolve 归因；交卷 Git 定位登记。\n *\n * 与 registerArtifact 纯库测试不同——这里经 pao_submit_receipt / pao_deliver_card\n * 工具壳走完一遍，来源捕获走真 SessionManager 落盘会话（toolcall:<id> 事件源）。\n *\n * 覆盖：\n * - submit_receipt 声明 artifact_path → 成果版本落库（managed），originTaskId=card:NNNN:dir；\n * - resolve→submit_receipt → artifact_uses 记 action=reuse 带回执引用（浏览不记执行；\n *   归因挂在回执边界，不在 write/edit 粒度）；\n * - 登记失败只留痕不阻断回执落定（来源捕获失败路径如实跳过）；\n * - deliver_card 交卷成功后 暂存文件 按交付 commit 登记 Git 定位版本（短哈希→全 SHA）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifact-card-hooks.test.ts --maxWorkers=1\n */\nimport { execFileSync } from \"node:child_process\";\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage, fauxToolCall } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\n\nimport type { ExtensionAPI, ExtensionToolContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { createCard, loadCard } from \"../../src/pao/cards/index.ts\";\nimport { registerCardTools, type ReceiptArtifactRegistrationInput } from \"../../src/pao/cards/tools.ts\";\nimport { registerDeliveryTools, type DeliveryArtifactRegistrationInput } from \"../../src/pao/cards/delivery.ts\";\nimport { registerVerifierTools } from \"../../src/pao/cards/verifier.ts\";\nimport {\n\tmakeRegisterDeliveryArtifacts,\n\tmakeRegisterReceiptArtifacts,\n\ttype ArtifactRegistrationDeps,\n} from \"../../src/pao/memory/artifact-registration.ts\";\nimport { registerBuiltinMemory, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\n\nconst roots: string[] = [];\nconst AT = \"2026-11-15T10:00:00.000Z\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of roots.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows SQLite 句柄释放比 close 晚几毫秒。\n\t\t}\n\t}\n});\n\ninterface RegisteredTool {\n\tname: string;\n\texecute: (\n\t\tid: string,\n\t\tparams: Record<string, unknown>,\n\t\tsignal?: AbortSignal,\n\t\tonUpdate?: unknown,\n\t\tctx?: ExtensionToolContext,\n\t) => Promise<{ content: { type: string; text: string }[]; isError?: boolean }>;\n}\n\ninterface Fixture {\n\thome: string;\n\tproject: string;\n\tcardsDir: string;\n\tsessions: string;\n\tpi: ExtensionAPI;\n\ttools: Map<string, RegisteredTool>;\n\tregistration: BuiltinMemoryRegistration;\n\tsessionManager: SessionManager;\n\tctx: ExtensionToolContext;\n\treceiptInputs: ReceiptArtifactRegistrationInput[];\n\tdeliveryInputs: DeliveryArtifactRegistrationInput[];\n\tclose: () => Promise<void>;\n}\n\nfunction makeFixture(sharedHome?: string, sessionId = \"f11-session\"): Fixture {\n\tconst root = tempDir(\"pao-f11-\");\n\tconst home = sharedHome ?? join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\n\tconst tools = new Map<string, RegisteredTool>();\n\tconst pi = {\n\t\tregisterTool: (tool: RegisteredTool) => tools.set(tool.name, tool),\n\t\tregisterCommand: () => undefined,\n\t\tsendMessage: () => undefined,\n\t\tappendEntry: () => undefined,\n\t\ton: () => () => undefined,\n\t\tgetAllTools: () => [...tools.values()],\n\t} as unknown as ExtensionAPI;\n\n\tconst registration = registerBuiltinMemory(pi, { paoHome: home });\n\tconst deps: ArtifactRegistrationDeps = {\n\t\tregistration: () => registration,\n\t\tpi,\n\t\tpaoHome: () => home,\n\t};\n\tconst receiptInputs: ReceiptArtifactRegistrationInput[] = [];\n\tconst deliveryInputs: DeliveryArtifactRegistrationInput[] = [];\n\tconst registerReceipt = makeRegisterReceiptArtifacts(deps);\n\tconst registerDelivery = makeRegisterDeliveryArtifacts(deps);\n\tregisterCardTools(pi, {\n\t\tresolveCardsDir: () => cardsDir,\n\t\tregisterReceiptArtifacts: (input) => {\n\t\t\treceiptInputs.push(input);\n\t\t\treturn registerReceipt(input);\n\t\t},\n\t});\n\tregisterDeliveryTools(pi, {\n\t\tresolveCardsDir: () => cardsDir,\n\t\tregisterDeliveryArtifacts: (input) => {\n\t\t\tdeliveryInputs.push(input);\n\t\t\treturn registerDelivery(input);\n\t\t},\n\t});\n\tregisterVerifierTools(pi, { resolveCardsDir: () => cardsDir });\n\n\tconst sessionManager = SessionManager.create(project, sessions, { id: sessionId });\n\tconst ctx = { cwd: project, sessionManager } as unknown as ExtensionToolContext;\n\treturn {\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tpi,\n\t\ttools,\n\t\tregistration,\n\t\tsessionManager,\n\t\tctx,\n\t\treceiptInputs,\n\t\tdeliveryInputs,\n\t\tclose: async () => {\n\t\t\tawait registration.close();\n\t\t},\n\t};\n}\n\ndescribe(\"成果登记任务身份\", () => {\n\tit.each([\"receipt\", \"delivery\"] as const)(\"%s：跨项目登记隔离，同卡同尝试重放幂等\", async (boundary) => {\n\t\tconst home = join(tempDir(\"pao-f11-shared-\"), \"home\");\n\t\tconst fixtures = [makeFixture(home, \"project-alpha\"), makeFixture(home, \"project-beta\")];\n\t\ttry {\n\t\t\tfor (const [index, fx] of fixtures.entries()) {\n\t\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: fx.project });\n\t\t\t\twriteFileSync(join(fx.project, \"baseline.txt\"), `project-${index}\\n`);\n\t\t\t\texecFileSync(\"git\", [\"add\", \"-A\"], { cwd: fx.project });\n\t\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"基线\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t});\n\t\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t\t目标: \"独立成果\",\n\t\t\t\t\t部门: \"核心机制\",\n\t\t\t\t\t验收: \"存在: out.txt\",\n\t\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t\t});\n\t\t\t\tawait runTool(fx, \"pao_change_status\", { card_ref: 1, operator: \"部长A\", new_status: \"in_progress\" });\n\t\t\t\twriteFileSync(join(fx.project, \"out.txt\"), `artifact-${index}\\n`);\n\t\t\t\texpect(\n\t\t\t\t\tawait runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\t\t\tcard_ref: 1,\n\t\t\t\t\t\tattempt: 1,\n\t\t\t\t\t\tresult: \"完成\",\n\t\t\t\t\t\tsummary: \"产物已写\",\n\t\t\t\t\t\tartifact_path: [\"out.txt\"],\n\t\t\t\t\t}),\n\t\t\t\t).toContain(\"成果已登记\");\n\t\t\t\tif (boundary === \"delivery\") {\n\t\t\t\t\texpect(await runTool(fx, \"pao_verify_card\", { card_ref: 1, operator: \"部长A\" })).toContain(\"全过自动交付\");\n\t\t\t\t\texpect(await runTool(fx, \"pao_deliver_card\", { card_ref: 1 })).toContain(\"交卷成果已登记\");\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst store = openMemoryStore(home, \"readonly\");\n\t\t\ttry {\n\t\t\t\tconst sourceTool = boundary === \"receipt\" ? \"pao_submit_receipt\" : \"pao_deliver_card\";\n\t\t\t\tconst versions = () =>\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT version_id, artifact_id, origin_task_id, registration_key FROM artifact_versions\n\t\t\t\t\t\t\t WHERE source_tool_name = ? ORDER BY origin_task_id`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.all(sourceTool) as Array<{\n\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\tartifact_id: string;\n\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t\tregistration_key: string;\n\t\t\t\t\t}>;\n\t\t\t\tconst before = versions();\n\t\t\t\texpect(before).toHaveLength(2);\n\t\t\t\texpect(new Set(before.map((v) => v.artifact_id)).size).toBe(2);\n\t\t\t\tfor (const [index, fx] of fixtures.entries()) {\n\t\t\t\t\tconst taskId = taskIdForCard(fx.cardsDir, 1);\n\t\t\t\t\tconst version = before.find((v) => v.origin_task_id === taskId)!;\n\t\t\t\t\texpect(version).toBeDefined();\n\t\t\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: fx.project, encoding: \"utf8\" }).trim();\n\t\t\t\t\texpect(version.registration_key).toBe(boundary === \"receipt\" ? `${taskId}:1` : `${taskId}:deliver:${commit}`);\n\t\t\t\t\tconst resolved = await fx.registration.service.resolveArtifactVersion({ versionId: version.version_id });\n\t\t\t\t\texpect(resolved.ok && resolved.available && resolved.content.toString(\"utf8\")).toBe(`artifact-${index}\\n`);\n\t\t\t\t\tconst deps = { pi: fx.pi, registration: () => fx.registration, paoHome: () => home };\n\t\t\t\t\tconst note =\n\t\t\t\t\t\tboundary === \"receipt\"\n\t\t\t\t\t\t\t? await makeRegisterReceiptArtifacts(deps)(fx.receiptInputs[0]!)\n\t\t\t\t\t\t\t: await makeRegisterDeliveryArtifacts(deps)(fx.deliveryInputs[0]!);\n\t\t\t\t\texpect(note).toContain(version.version_id);\n\t\t\t\t}\n\t\t\t\texpect(versions()).toEqual(before);\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tfor (const fx of fixtures) await fx.close();\n\t\t}\n\t});\n});\n\n/** 提交一条带指定 toolCallId 的助手消息，让 captureToolCallSource 抓到 toolcall 来源。 */\nfunction commitToolCallEntry(fx: Fixture, toolName: string, toolCallId: string, args: Record<string, unknown>): void {\n\tfx.sessionManager.appendMessage(\n\t\t// ToolCall[\"arguments\"] 是 JsonObject；测试参数经 vitest 断言路径已是 JSON 安全值。\n\t\tfauxAssistantMessage([fauxToolCall(toolName, args as never, { id: toolCallId })], {\n\t\t\ttimestamp: Date.now(),\n\t\t}),\n\t);\n}\n\nasync function runTool(\n\tfx: Fixture,\n\tname: string,\n\tparams: Record<string, unknown>,\n\ttoolCallId = `call-${name}-1`,\n): Promise<string> {\n\tcommitToolCallEntry(fx, name, toolCallId, params);\n\tconst tool = fx.tools.get(name);\n\tif (!tool) throw new Error(`工具未注册:${name}`);\n\tconst result = await tool.execute(toolCallId, params, undefined, undefined, fx.ctx);\n\treturn result.content.map((part) => part.text).join(\"\\n\");\n}\n\ndescribe(\"F11 挂点 A：pao_submit_receipt 成果登记 + resolve 归因\", () => {\n\tit(\"声明 artifact_path 的回执落库：managed 版本 + originTaskId + 回执引用前缀\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"造产物\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"产物落盘\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\t// 认领推进尝试号到 1（非 Git 目录认领基线如实记不可用，不阻断）。\n\t\t\tconst claimText = await runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\texpect(claimText).toContain(\"in_progress\");\n\t\t\tconst artifactPath = join(fx.project, \"交付.txt\");\n\t\t\twriteFileSync(artifactPath, \"真实产物内容\");\n\n\t\t\tconst text = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"产物已落盘\",\n\t\t\t\tartifact_path: [artifactPath],\n\t\t\t});\n\t\t\texpect(text).toContain(\"回执已追加\");\n\t\t\texpect(text).toContain(\"成果已登记\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst version = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT version_id, artifact_id, location_json, origin_task_id, receipt_ref, source_tool_name\n\t\t\t\t\t\t FROM artifact_versions`,\n\t\t\t\t\t)\n\t\t\t\t\t.get() as\n\t\t\t\t\t| {\n\t\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\t\tartifact_id: string;\n\t\t\t\t\t\t\tlocation_json: string;\n\t\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t\t\treceipt_ref: string;\n\t\t\t\t\t\t\tsource_tool_name: string;\n\t\t\t\t\t  }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(version).toBeDefined();\n\t\t\t\texpect(version!.source_tool_name).toBe(\"pao_submit_receipt\");\n\t\t\t\texpect(version!.origin_task_id).toMatch(/^card:卡0001:/);\n\t\t\t\texpect(version!.receipt_ref).toMatch(/^pending_review:回执:/);\n\t\t\t\tconst location = JSON.parse(version!.location_json) as { kind: string };\n\t\t\t\texpect(location.kind).toBe(\"managed\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n\n\tit(\"resolve→submit_receipt：本会话 resolve 过的版本在回执边界记 reuse 归因\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\t// 先造一份成果供 resolve（直接经服务登记，模拟前序任务留下的可复用成果）。\n\t\t\tconst dir = tempDir(\"pao-f11-reuse-src-\");\n\t\t\tconst srcPath = join(dir, \"可复用.txt\");\n\t\t\twriteFileSync(srcPath, \"前序成果内容\");\n\t\t\t// 登记来源：种子来源行走 registerSource 等价的最小合法行（resolveSources 要查存在）。\n\t\t\tconst seedStore = openMemoryStore(fx.home, \"readwrite\");\n\t\t\tlet versionId: string;\n\t\t\ttry {\n\t\t\t\tseedStore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t\t\t VALUES ('src-seed', 'sess-seed', 'e-seed', 'user', ?)`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(AT);\n\t\t\t} finally {\n\t\t\t\tseedStore.close();\n\t\t\t}\n\t\t\tconst registered = await fx.registration.service.registerArtifact({\n\t\t\t\tname: \"可复用成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"可复用.txt\", path: srcPath }],\n\t\t\t\tsourceIds: [\"src-seed\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\t// worker 经 resolve 工具回读该版本（真实工具壳：读成功才记到会话态）。\n\t\t\tconst resolveText = await runTool(fx, \"pao_memory_resolve_artifact\", { version_id: versionId });\n\t\t\texpect(resolveText).toContain(\"成果:\");\n\t\t\texpect(resolveText).not.toContain(\"不可读\");\n\n\t\t\t// 交回执 → 回执边界把本会话 resolve 归因记成 reuse。先认领推进尝试号。\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"复用成果干活\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"完成\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\tawait runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\tconst text = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"复用前序成果完成\",\n\t\t\t});\n\t\t\texpect(text).toContain(\"回执已追加\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst use = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT task_id, action, receipt_ref, session_id FROM artifact_uses WHERE version_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(versionId) as\n\t\t\t\t\t| { task_id: string; action: string; receipt_ref: string; session_id: string }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(use).toBeDefined();\n\t\t\t\texpect(use!.action).toBe(\"reuse\");\n\t\t\t\texpect(use!.task_id).toMatch(/^card:卡0001:/);\n\t\t\t\texpect(use!.receipt_ref).toMatch(/^pending_review:回执:/);\n\t\t\t\texpect(use!.session_id).toBe(\"f11-session\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n});\n\ndescribe(\"F11 挂点 B：pao_deliver_card Git 定位登记\", () => {\n\tit(\"交卷按完整 commit 登记；同任务不同提交分别登记，同提交重放幂等\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\t// 项目目录必须是 Git 仓：认领基线快照、交卷 commit、Git 定位都靠它。\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: fx.project });\n\t\t\twriteFileSync(join(fx.project, \"已跟踪.txt\"), \"v1\\n\");\n\t\t\texecFileSync(\"git\", [\"add\", \"-A\"], { cwd: fx.project });\n\t\t\texecFileSync(\n\t\t\t\t\"git\",\n\t\t\t\t[\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"开工基线\"],\n\t\t\t\t{ cwd: fx.project },\n\t\t\t);\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"Git 交卷\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"存在: out.txt\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\t// 真实工具链：认领（落认领基线快照）→ worker 写产物 → 交回执 → 机械验收 → 交卷。\n\t\t\tconst claimText = await runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\texpect(claimText).toContain(\"in_progress\");\n\t\t\twriteFileSync(join(fx.project, \"out.txt\"), \"交卷产物内容\");\n\t\t\tconst receiptText = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"out.txt 已写\",\n\t\t\t\tartifact_path: [\"out.txt\"],\n\t\t\t});\n\t\t\texpect(receiptText).toContain(\"回执已追加\");\n\t\t\tconst verifyText = await runTool(fx, \"pao_verify_card\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t});\n\t\t\texpect(verifyText).toContain(\"全过自动交付\");\n\t\t\t// 机械全过应已把卡落 delivered；确认状态再交卷。\n\t\t\texpect(loadCard(fx.cardsDir, 1).frontmatter.status).toBe(\"delivered\");\n\n\t\t\tconst deliverText = await runTool(fx, \"pao_deliver_card\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t});\n\t\t\texpect(deliverText).toContain(\"已交卷\");\n\t\t\texpect(deliverText).toContain(\"交卷成果已登记\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst version = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT version_id, location_json, receipt_ref, source_tool_name, origin_task_id\n\t\t\t\t\t\t FROM artifact_versions WHERE source_tool_name = 'pao_deliver_card'`,\n\t\t\t\t\t)\n\t\t\t\t\t.get() as\n\t\t\t\t\t| {\n\t\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\t\tlocation_json: string;\n\t\t\t\t\t\t\treceipt_ref: string;\n\t\t\t\t\t\t\tsource_tool_name: string;\n\t\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t  }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(version).toBeDefined();\n\t\t\t\tconst location = JSON.parse(version!.location_json) as {\n\t\t\t\t\tkind: string;\n\t\t\t\t\trepoRoot: string;\n\t\t\t\t\tcommit: string;\n\t\t\t\t\tpath: string;\n\t\t\t\t};\n\t\t\t\texpect(location.kind).toBe(\"git\");\n\t\t\t\texpect(location.commit).toMatch(/^[0-9a-f]{40}$/i);\n\t\t\t\texpect(location.path).toBe(\"out.txt\");\n\t\t\t\texpect(version!.receipt_ref).toMatch(/^pass:交卷:/);\n\t\t\t\texpect(version!.origin_task_id).toMatch(/^card:卡0001:/);\n\t\t\t\tconst deps = { pi: fx.pi, registration: () => fx.registration, paoHome: () => fx.home };\n\t\t\t\tconst registerDelivery = makeRegisterDeliveryArtifacts(deps);\n\t\t\t\tconst firstInput = fx.deliveryInputs[0]!;\n\t\t\t\tconst versions = () =>\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT version_id, registration_key FROM artifact_versions\n\t\t\t\t\t\t\t WHERE source_tool_name = 'pao_deliver_card' ORDER BY version_id`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.all() as Array<{ version_id: string; registration_key: string }>;\n\t\t\t\tconst first = versions();\n\t\t\t\texpect(first).toHaveLength(1);\n\t\t\t\texpect(await registerDelivery(firstInput)).toContain(version!.version_id);\n\t\t\t\texpect(versions()).toEqual(first);\n\n\t\t\t\twriteFileSync(join(fx.project, \"out.txt\"), \"第二次提交的产物内容\");\n\t\t\t\texecFileSync(\"git\", [\"add\", \"--\", \"out.txt\"], { cwd: fx.project });\n\t\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"交付补充\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t});\n\t\t\t\tconst secondSha = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t\tencoding: \"utf8\",\n\t\t\t\t}).trim();\n\t\t\t\texpect(secondSha).not.toBe(location.commit);\n\t\t\t\texpect(loadCard(fx.cardsDir, 1).frontmatter.attempt).toBe(1);\n\t\t\t\tconst secondInput = {\n\t\t\t\t\t...firstInput,\n\t\t\t\t\ttoolCallId: \"call-delivery-second\",\n\t\t\t\t\tresult: { ...firstInput.result, 提交哈希: secondSha.slice(0, 12) },\n\t\t\t\t};\n\t\t\t\tcommitToolCallEntry(fx, \"pao_deliver_card\", secondInput.toolCallId, { card_ref: 1 });\n\t\t\t\tawait registerDelivery(secondInput);\n\t\t\t\tconst both = versions();\n\t\t\t\texpect(both).toHaveLength(2);\n\t\t\t\texpect(both.map((v) => v.registration_key).sort()).toEqual(\n\t\t\t\t\t[location.commit, secondSha].map((sha) => `${taskIdForCard(fx.cardsDir, 1)}:deliver:${sha}`).sort(),\n\t\t\t\t);\n\t\t\t\tconst second = both.find((v) => v.version_id !== version!.version_id)!;\n\t\t\t\tconst resolved = await fx.registration.service.resolveArtifactVersion({ versionId: second.version_id });\n\t\t\t\texpect(resolved.ok && resolved.available && resolved.content.toString(\"utf8\")).toBe(\"第二次提交的产物内容\");\n\t\t\t\texpect(await registerDelivery(secondInput)).toContain(second.version_id);\n\t\t\t\texpect(await registerDelivery(firstInput)).toContain(version!.version_id);\n\t\t\t\texpect(versions()).toEqual(both);\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * F11（O08）挂点真实链路测试：卡回执边界登记成果 + resolve 归因；交卷 Git 定位登记。\n *\t\t\t\t).toContain(\"成果已登记\");\n\t\t\t\tif (boundary === \"delivery\") {\n\t\t\t\t\texpect(await runTool(fx, \"pao_verify_card\", { card_ref: 1, operator: \"部长A\" })).toContain(\n\t\t\t\t\t\t\"全过自动交付\",\n\t\t\t\t\t);\n\t\t\t\t\texpect(await runTool(fx, \"pao_deliver_card\", { card_ref: 1 })).toContain(\"交卷成果已登记\");\n\t\t\t\t}\t\t\t\t\texpect(version).toBeDefined();\n\t\t\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: fx.project, encoding: \"utf8\" }).trim();\n\t\t\t\t\texpect(version.registration_key).toBe(boundary === \"receipt\" ? `${taskId}:1` : `${taskId}:deliver:${commit}`);\n\t\t\t\t\tconst resolved = await fx.registration.service.resolveArtifactVersion({ versionId: version.version_id });\n\t\t\t\t\texpect(resolved.ok && resolved.available && resolved.content.toString(\"utf8\")).toBe(`artifact-${index}\\n`);\n\t\t\t\t\tconst deps = { pi: fx.pi, registration: () => fx.registration, paoHome: () => home };\n\t\t\t\t\tconst note =\t\t\ttry {\n\t\t\t\tconst use = store.db\n\t\t\t\t\t.prepare(`SELECT task_id, action, receipt_ref, session_id FROM artifact_uses WHERE version_id = ?`)\n\t\t\t\t\t.get(versionId) as\n\t\t\t\t\t| { task_id: string; action: string; receipt_ref: string; session_id: string }\t\t\twriteFileSync(join(fx.project, \"已跟踪.txt\"), \"v1\\n\");\n\t\t\texecFileSync(\"git\", [\"add\", \"-A\"], { cwd: fx.project });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"开工基线\"], {{ cwd: fx.project }});\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"Git 交卷\",\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,122]}}},{"equalLines":{"line_count":173}},{"diffOp":{"equal":{"range":[122,291]}}},{"diffOp":{"insert":{"range":[291,298]}}},{"diffOp":{"equal":{"range":[298,318]}}},{"diffOp":{"insert":{"range":[318,325]}}},{"diffOp":{"equal":{"range":[325,437]}}},{"equalLines":{"line_count":22}},{"diffOp":{"equal":{"range":[437,626]}}},{"diffOp":{"insert":{"range":[291,298]}}},{"diffOp":{"equal":{"range":[626,696]}}},{"diffOp":{"insert":{"range":[318,325]}}},{"diffOp":{"equal":{"range":[696,899]}}},{"diffOp":{"insert":{"range":[291,298]}}},{"diffOp":{"equal":{"range":[899,920]}}},{"diffOp":{"insert":{"range":[318,325]}}},{"diffOp":{"equal":{"range":[920,1031]}}},{"equalLines":{"line_count":160}},{"diffOp":{"equal":{"range":[1031,1079]}}},{"diffOp":{"delete":{"range":[291,298]}}},{"diffOp":{"equal":{"range":[1079,1168]}}},{"diffOp":{"delete":{"range":[318,325]}}},{"diffOp":{"equal":{"range":[1168,1277]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[1277,1414]}}},{"diffOp":{"delete":{"range":[291,296]}}},{"diffOp":{"equal":{"range":[1414,1420]}}},{"diffOp":{"delete":{"range":[291,296]}}},{"diffOp":{"insert":{"range":[1420,1421]}}},{"diffOp":{"equal":{"range":[1421,1500]}}},{"diffOp":{"insert":{"range":[1500,1502]}}},{"diffOp":{"equal":{"range":[291,296]}}},{"diffOp":{"delete":{"range":[1502,1504]}}},{"diffOp":{"equal":{"range":[1504,1519]}}},{"diffOp":{"delete":{"range":[1519,1521]}}},{"diffOp":{"equal":{"range":[318,323]}}},{"diffOp":{"insert":{"range":[1521,1522]}}},{"diffOp":{"equal":{"range":[1522,1585]}}},{"equalLines":{"line_count":116}},{"diffOp":{"equal":{"range":[1585,1594]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-artifact-card-hooks.test.ts"},"span":null,"sourceCode":"/**\n * F11（O08）挂点真实链路测试：卡回执边界登记成果 + resolve 归因；交卷 Git 定位登记。\n *\n * 与 registerArtifact 纯库测试不同——这里经 pao_submit_receipt / pao_deliver_card\n * 工具壳走完一遍，来源捕获走真 SessionManager 落盘会话（toolcall:<id> 事件源）。\n *\n * 覆盖：\n * - submit_receipt 声明 artifact_path → 成果版本落库（managed），originTaskId=card:NNNN:dir；\n * - resolve→submit_receipt → artifact_uses 记 action=reuse 带回执引用（浏览不记执行；\n *   归因挂在回执边界，不在 write/edit 粒度）；\n * - 登记失败只留痕不阻断回执落定（来源捕获失败路径如实跳过）；\n * - deliver_card 交卷成功后 暂存文件 按交付 commit 登记 Git 定位版本（短哈希→全 SHA）。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifact-card-hooks.test.ts --maxWorkers=1\n */\nimport { execFileSync } from \"node:child_process\";\nimport { mkdirSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage, fauxToolCall } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\n\nimport type { ExtensionAPI, ExtensionToolContext } from \"../../src/core/extensions/types.ts\";\nimport { SessionManager } from \"../../src/core/session-manager.ts\";\nimport { createCard, loadCard } from \"../../src/pao/cards/index.ts\";\nimport { registerCardTools, type ReceiptArtifactRegistrationInput } from \"../../src/pao/cards/tools.ts\";\nimport { registerDeliveryTools, type DeliveryArtifactRegistrationInput } from \"../../src/pao/cards/delivery.ts\";\nimport { registerVerifierTools } from \"../../src/pao/cards/verifier.ts\";\nimport {\n\tmakeRegisterDeliveryArtifacts,\n\tmakeRegisterReceiptArtifacts,\n\ttype ArtifactRegistrationDeps,\n} from \"../../src/pao/memory/artifact-registration.ts\";\nimport { registerBuiltinMemory, type BuiltinMemoryRegistration } from \"../../src/pao/memory/tools.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { taskIdForCard } from \"../../src/pao/memory/task-continuation.ts\";\n\nconst roots: string[] = [];\nconst AT = \"2026-11-15T10:00:00.000Z\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\troots.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of roots.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows SQLite 句柄释放比 close 晚几毫秒。\n\t\t}\n\t}\n});\n\ninterface RegisteredTool {\n\tname: string;\n\texecute: (\n\t\tid: string,\n\t\tparams: Record<string, unknown>,\n\t\tsignal?: AbortSignal,\n\t\tonUpdate?: unknown,\n\t\tctx?: ExtensionToolContext,\n\t) => Promise<{ content: { type: string; text: string }[]; isError?: boolean }>;\n}\n\ninterface Fixture {\n\thome: string;\n\tproject: string;\n\tcardsDir: string;\n\tsessions: string;\n\tpi: ExtensionAPI;\n\ttools: Map<string, RegisteredTool>;\n\tregistration: BuiltinMemoryRegistration;\n\tsessionManager: SessionManager;\n\tctx: ExtensionToolContext;\n\treceiptInputs: ReceiptArtifactRegistrationInput[];\n\tdeliveryInputs: DeliveryArtifactRegistrationInput[];\n\tclose: () => Promise<void>;\n}\n\nfunction makeFixture(sharedHome?: string, sessionId = \"f11-session\"): Fixture {\n\tconst root = tempDir(\"pao-f11-\");\n\tconst home = sharedHome ?? join(root, \"home\");\n\tconst project = join(root, \"project\");\n\tconst cardsDir = join(project, \".pao\", \"卡\");\n\tconst sessions = join(root, \"sessions\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\tmkdirSync(cardsDir, { recursive: true });\n\tmkdirSync(sessions, { recursive: true });\n\n\tconst tools = new Map<string, RegisteredTool>();\n\tconst pi = {\n\t\tregisterTool: (tool: RegisteredTool) => tools.set(tool.name, tool),\n\t\tregisterCommand: () => undefined,\n\t\tsendMessage: () => undefined,\n\t\tappendEntry: () => undefined,\n\t\ton: () => () => undefined,\n\t\tgetAllTools: () => [...tools.values()],\n\t} as unknown as ExtensionAPI;\n\n\tconst registration = registerBuiltinMemory(pi, { paoHome: home });\n\tconst deps: ArtifactRegistrationDeps = {\n\t\tregistration: () => registration,\n\t\tpi,\n\t\tpaoHome: () => home,\n\t};\n\tconst receiptInputs: ReceiptArtifactRegistrationInput[] = [];\n\tconst deliveryInputs: DeliveryArtifactRegistrationInput[] = [];\n\tconst registerReceipt = makeRegisterReceiptArtifacts(deps);\n\tconst registerDelivery = makeRegisterDeliveryArtifacts(deps);\n\tregisterCardTools(pi, {\n\t\tresolveCardsDir: () => cardsDir,\n\t\tregisterReceiptArtifacts: (input) => {\n\t\t\treceiptInputs.push(input);\n\t\t\treturn registerReceipt(input);\n\t\t},\n\t});\n\tregisterDeliveryTools(pi, {\n\t\tresolveCardsDir: () => cardsDir,\n\t\tregisterDeliveryArtifacts: (input) => {\n\t\t\tdeliveryInputs.push(input);\n\t\t\treturn registerDelivery(input);\n\t\t},\n\t});\n\tregisterVerifierTools(pi, { resolveCardsDir: () => cardsDir });\n\n\tconst sessionManager = SessionManager.create(project, sessions, { id: sessionId });\n\tconst ctx = { cwd: project, sessionManager } as unknown as ExtensionToolContext;\n\treturn {\n\t\thome,\n\t\tproject,\n\t\tcardsDir,\n\t\tsessions,\n\t\tpi,\n\t\ttools,\n\t\tregistration,\n\t\tsessionManager,\n\t\tctx,\n\t\treceiptInputs,\n\t\tdeliveryInputs,\n\t\tclose: async () => {\n\t\t\tawait registration.close();\n\t\t},\n\t};\n}\n\ndescribe(\"成果登记任务身份\", () => {\n\tit.each([\"receipt\", \"delivery\"] as const)(\"%s：跨项目登记隔离，同卡同尝试重放幂等\", async (boundary) => {\n\t\tconst home = join(tempDir(\"pao-f11-shared-\"), \"home\");\n\t\tconst fixtures = [makeFixture(home, \"project-alpha\"), makeFixture(home, \"project-beta\")];\n\t\ttry {\n\t\t\tfor (const [index, fx] of fixtures.entries()) {\n\t\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: fx.project });\n\t\t\t\twriteFileSync(join(fx.project, \"baseline.txt\"), `project-${index}\\n`);\n\t\t\t\texecFileSync(\"git\", [\"add\", \"-A\"], { cwd: fx.project });\n\t\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"基线\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t});\n\t\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t\t目标: \"独立成果\",\n\t\t\t\t\t部门: \"核心机制\",\n\t\t\t\t\t验收: \"存在: out.txt\",\n\t\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t\t});\n\t\t\t\tawait runTool(fx, \"pao_change_status\", { card_ref: 1, operator: \"部长A\", new_status: \"in_progress\" });\n\t\t\t\twriteFileSync(join(fx.project, \"out.txt\"), `artifact-${index}\\n`);\n\t\t\t\texpect(\n\t\t\t\t\tawait runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\t\t\tcard_ref: 1,\n\t\t\t\t\t\tattempt: 1,\n\t\t\t\t\t\tresult: \"完成\",\n\t\t\t\t\t\tsummary: \"产物已写\",\n\t\t\t\t\t\tartifact_path: [\"out.txt\"],\n\t\t\t\t\t}),\n\t\t\t\t).toContain(\"成果已登记\");\n\t\t\t\tif (boundary === \"delivery\") {\n\t\t\t\t\texpect(await runTool(fx, \"pao_verify_card\", { card_ref: 1, operator: \"部长A\" })).toContain(\"全过自动交付\");\n\t\t\t\t\texpect(await runTool(fx, \"pao_deliver_card\", { card_ref: 1 })).toContain(\"交卷成果已登记\");\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst store = openMemoryStore(home, \"readonly\");\n\t\t\ttry {\n\t\t\t\tconst sourceTool = boundary === \"receipt\" ? \"pao_submit_receipt\" : \"pao_deliver_card\";\n\t\t\t\tconst versions = () =>\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT version_id, artifact_id, origin_task_id, registration_key FROM artifact_versions\n\t\t\t\t\t\t\t WHERE source_tool_name = ? ORDER BY origin_task_id`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.all(sourceTool) as Array<{\n\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\tartifact_id: string;\n\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t\tregistration_key: string;\n\t\t\t\t\t}>;\n\t\t\t\tconst before = versions();\n\t\t\t\texpect(before).toHaveLength(2);\n\t\t\t\texpect(new Set(before.map((v) => v.artifact_id)).size).toBe(2);\n\t\t\t\tfor (const [index, fx] of fixtures.entries()) {\n\t\t\t\t\tconst taskId = taskIdForCard(fx.cardsDir, 1);\n\t\t\t\t\tconst version = before.find((v) => v.origin_task_id === taskId)!;\n\t\t\t\t\texpect(version).toBeDefined();\n\t\t\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: fx.project, encoding: \"utf8\" }).trim();\n\t\t\t\t\texpect(version.registration_key).toBe(boundary === \"receipt\" ? `${taskId}:1` : `${taskId}:deliver:${commit}`);\n\t\t\t\t\tconst resolved = await fx.registration.service.resolveArtifactVersion({ versionId: version.version_id });\n\t\t\t\t\texpect(resolved.ok && resolved.available && resolved.content.toString(\"utf8\")).toBe(`artifact-${index}\\n`);\n\t\t\t\t\tconst deps = { pi: fx.pi, registration: () => fx.registration, paoHome: () => home };\n\t\t\t\t\tconst note =\n\t\t\t\t\t\tboundary === \"receipt\"\n\t\t\t\t\t\t\t? await makeRegisterReceiptArtifacts(deps)(fx.receiptInputs[0]!)\n\t\t\t\t\t\t\t: await makeRegisterDeliveryArtifacts(deps)(fx.deliveryInputs[0]!);\n\t\t\t\t\texpect(note).toContain(version.version_id);\n\t\t\t\t}\n\t\t\t\texpect(versions()).toEqual(before);\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tfor (const fx of fixtures) await fx.close();\n\t\t}\n\t});\n});\n\n/** 提交一条带指定 toolCallId 的助手消息，让 captureToolCallSource 抓到 toolcall 来源。 */\nfunction commitToolCallEntry(fx: Fixture, toolName: string, toolCallId: string, args: Record<string, unknown>): void {\n\tfx.sessionManager.appendMessage(\n\t\t// ToolCall[\"arguments\"] 是 JsonObject；测试参数经 vitest 断言路径已是 JSON 安全值。\n\t\tfauxAssistantMessage([fauxToolCall(toolName, args as never, { id: toolCallId })], {\n\t\t\ttimestamp: Date.now(),\n\t\t}),\n\t);\n}\n\nasync function runTool(\n\tfx: Fixture,\n\tname: string,\n\tparams: Record<string, unknown>,\n\ttoolCallId = `call-${name}-1`,\n): Promise<string> {\n\tcommitToolCallEntry(fx, name, toolCallId, params);\n\tconst tool = fx.tools.get(name);\n\tif (!tool) throw new Error(`工具未注册:${name}`);\n\tconst result = await tool.execute(toolCallId, params, undefined, undefined, fx.ctx);\n\treturn result.content.map((part) => part.text).join(\"\\n\");\n}\n\ndescribe(\"F11 挂点 A：pao_submit_receipt 成果登记 + resolve 归因\", () => {\n\tit(\"声明 artifact_path 的回执落库：managed 版本 + originTaskId + 回执引用前缀\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"造产物\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"产物落盘\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\t// 认领推进尝试号到 1（非 Git 目录认领基线如实记不可用，不阻断）。\n\t\t\tconst claimText = await runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\texpect(claimText).toContain(\"in_progress\");\n\t\t\tconst artifactPath = join(fx.project, \"交付.txt\");\n\t\t\twriteFileSync(artifactPath, \"真实产物内容\");\n\n\t\t\tconst text = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"产物已落盘\",\n\t\t\t\tartifact_path: [artifactPath],\n\t\t\t});\n\t\t\texpect(text).toContain(\"回执已追加\");\n\t\t\texpect(text).toContain(\"成果已登记\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst version = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT version_id, artifact_id, location_json, origin_task_id, receipt_ref, source_tool_name\n\t\t\t\t\t\t FROM artifact_versions`,\n\t\t\t\t\t)\n\t\t\t\t\t.get() as\n\t\t\t\t\t| {\n\t\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\t\tartifact_id: string;\n\t\t\t\t\t\t\tlocation_json: string;\n\t\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t\t\treceipt_ref: string;\n\t\t\t\t\t\t\tsource_tool_name: string;\n\t\t\t\t\t  }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(version).toBeDefined();\n\t\t\t\texpect(version!.source_tool_name).toBe(\"pao_submit_receipt\");\n\t\t\t\texpect(version!.origin_task_id).toMatch(/^card:卡0001:/);\n\t\t\t\texpect(version!.receipt_ref).toMatch(/^pending_review:回执:/);\n\t\t\t\tconst location = JSON.parse(version!.location_json) as { kind: string };\n\t\t\t\texpect(location.kind).toBe(\"managed\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n\n\tit(\"resolve→submit_receipt：本会话 resolve 过的版本在回执边界记 reuse 归因\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\t// 先造一份成果供 resolve（直接经服务登记，模拟前序任务留下的可复用成果）。\n\t\t\tconst dir = tempDir(\"pao-f11-reuse-src-\");\n\t\t\tconst srcPath = join(dir, \"可复用.txt\");\n\t\t\twriteFileSync(srcPath, \"前序成果内容\");\n\t\t\t// 登记来源：种子来源行走 registerSource 等价的最小合法行（resolveSources 要查存在）。\n\t\t\tconst seedStore = openMemoryStore(fx.home, \"readwrite\");\n\t\t\tlet versionId: string;\n\t\t\ttry {\n\t\t\t\tseedStore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t\t\t VALUES ('src-seed', 'sess-seed', 'e-seed', 'user', ?)`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(AT);\n\t\t\t} finally {\n\t\t\t\tseedStore.close();\n\t\t\t}\n\t\t\tconst registered = await fx.registration.service.registerArtifact({\n\t\t\t\tname: \"可复用成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"可复用.txt\", path: srcPath }],\n\t\t\t\tsourceIds: [\"src-seed\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tversionId = registered.versions[0]!.versionId;\n\n\t\t\t// worker 经 resolve 工具回读该版本（真实工具壳：读成功才记到会话态）。\n\t\t\tconst resolveText = await runTool(fx, \"pao_memory_resolve_artifact\", { version_id: versionId });\n\t\t\texpect(resolveText).toContain(\"成果:\");\n\t\t\texpect(resolveText).not.toContain(\"不可读\");\n\n\t\t\t// 交回执 → 回执边界把本会话 resolve 归因记成 reuse。先认领推进尝试号。\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"复用成果干活\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"完成\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\tawait runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\tconst text = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"复用前序成果完成\",\n\t\t\t});\n\t\t\texpect(text).toContain(\"回执已追加\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst use = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT task_id, action, receipt_ref, session_id FROM artifact_uses WHERE version_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(versionId) as\n\t\t\t\t\t| { task_id: string; action: string; receipt_ref: string; session_id: string }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(use).toBeDefined();\n\t\t\t\texpect(use!.action).toBe(\"reuse\");\n\t\t\t\texpect(use!.task_id).toMatch(/^card:卡0001:/);\n\t\t\t\texpect(use!.receipt_ref).toMatch(/^pending_review:回执:/);\n\t\t\t\texpect(use!.session_id).toBe(\"f11-session\");\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n});\n\ndescribe(\"F11 挂点 B：pao_deliver_card Git 定位登记\", () => {\n\tit(\"交卷按完整 commit 登记；同任务不同提交分别登记，同提交重放幂等\", async () => {\n\t\tconst fx = makeFixture();\n\t\ttry {\n\t\t\t// 项目目录必须是 Git 仓：认领基线快照、交卷 commit、Git 定位都靠它。\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: fx.project });\n\t\t\twriteFileSync(join(fx.project, \"已跟踪.txt\"), \"v1\\n\");\n\t\t\texecFileSync(\"git\", [\"add\", \"-A\"], { cwd: fx.project });\n\t\t\texecFileSync(\n\t\t\t\t\"git\",\n\t\t\t\t[\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"开工基线\"],\n\t\t\t\t{ cwd: fx.project },\n\t\t\t);\n\t\t\tawait createCard(fx.cardsDir, {\n\t\t\t\t目标: \"Git 交卷\",\n\t\t\t\t部门: \"核心机制\",\n\t\t\t\t验收: \"存在: out.txt\",\n\t\t\t\t创建: \"2026-11-15 10:00\",\n\t\t\t});\n\t\t\t// 真实工具链：认领（落认领基线快照）→ worker 写产物 → 交回执 → 机械验收 → 交卷。\n\t\t\tconst claimText = await runTool(fx, \"pao_change_status\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t\tnew_status: \"in_progress\",\n\t\t\t});\n\t\t\texpect(claimText).toContain(\"in_progress\");\n\t\t\twriteFileSync(join(fx.project, \"out.txt\"), \"交卷产物内容\");\n\t\t\tconst receiptText = await runTool(fx, \"pao_submit_receipt\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\tattempt: 1,\n\t\t\t\tresult: \"完成\",\n\t\t\t\tsummary: \"out.txt 已写\",\n\t\t\t\tartifact_path: [\"out.txt\"],\n\t\t\t});\n\t\t\texpect(receiptText).toContain(\"回执已追加\");\n\t\t\tconst verifyText = await runTool(fx, \"pao_verify_card\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t\toperator: \"部长A\",\n\t\t\t});\n\t\t\texpect(verifyText).toContain(\"全过自动交付\");\n\t\t\t// 机械全过应已把卡落 delivered；确认状态再交卷。\n\t\t\texpect(loadCard(fx.cardsDir, 1).frontmatter.status).toBe(\"delivered\");\n\n\t\t\tconst deliverText = await runTool(fx, \"pao_deliver_card\", {\n\t\t\t\tcards_dir: fx.cardsDir,\n\t\t\t\tcard_ref: 1,\n\t\t\t});\n\t\t\texpect(deliverText).toContain(\"已交卷\");\n\t\t\texpect(deliverText).toContain(\"交卷成果已登记\");\n\n\t\t\tconst store = openMemoryStore(fx.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst version = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT version_id, location_json, receipt_ref, source_tool_name, origin_task_id\n\t\t\t\t\t\t FROM artifact_versions WHERE source_tool_name = 'pao_deliver_card'`,\n\t\t\t\t\t)\n\t\t\t\t\t.get() as\n\t\t\t\t\t| {\n\t\t\t\t\t\t\tversion_id: string;\n\t\t\t\t\t\t\tlocation_json: string;\n\t\t\t\t\t\t\treceipt_ref: string;\n\t\t\t\t\t\t\tsource_tool_name: string;\n\t\t\t\t\t\t\torigin_task_id: string;\n\t\t\t\t\t  }\n\t\t\t\t\t| undefined;\n\t\t\t\texpect(version).toBeDefined();\n\t\t\t\tconst location = JSON.parse(version!.location_json) as {\n\t\t\t\t\tkind: string;\n\t\t\t\t\trepoRoot: string;\n\t\t\t\t\tcommit: string;\n\t\t\t\t\tpath: string;\n\t\t\t\t};\n\t\t\t\texpect(location.kind).toBe(\"git\");\n\t\t\t\texpect(location.commit).toMatch(/^[0-9a-f]{40}$/i);\n\t\t\t\texpect(location.path).toBe(\"out.txt\");\n\t\t\t\texpect(version!.receipt_ref).toMatch(/^pass:交卷:/);\n\t\t\t\texpect(version!.origin_task_id).toMatch(/^card:卡0001:/);\n\t\t\t\tconst deps = { pi: fx.pi, registration: () => fx.registration, paoHome: () => fx.home };\n\t\t\t\tconst registerDelivery = makeRegisterDeliveryArtifacts(deps);\n\t\t\t\tconst firstInput = fx.deliveryInputs[0]!;\n\t\t\t\tconst versions = () =>\n\t\t\t\t\tstore.db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT version_id, registration_key FROM artifact_versions\n\t\t\t\t\t\t\t WHERE source_tool_name = 'pao_deliver_card' ORDER BY version_id`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.all() as Array<{ version_id: string; registration_key: string }>;\n\t\t\t\tconst first = versions();\n\t\t\t\texpect(first).toHaveLength(1);\n\t\t\t\texpect(await registerDelivery(firstInput)).toContain(version!.version_id);\n\t\t\t\texpect(versions()).toEqual(first);\n\n\t\t\t\twriteFileSync(join(fx.project, \"out.txt\"), \"第二次提交的产物内容\");\n\t\t\t\texecFileSync(\"git\", [\"add\", \"--\", \"out.txt\"], { cwd: fx.project });\n\t\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"交付补充\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t});\n\t\t\t\tconst secondSha = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], {\n\t\t\t\t\tcwd: fx.project,\n\t\t\t\t\tencoding: \"utf8\",\n\t\t\t\t}).trim();\n\t\t\t\texpect(secondSha).not.toBe(location.commit);\n\t\t\t\texpect(loadCard(fx.cardsDir, 1).frontmatter.attempt).toBe(1);\n\t\t\t\tconst secondInput = {\n\t\t\t\t\t...firstInput,\n\t\t\t\t\ttoolCallId: \"call-delivery-second\",\n\t\t\t\t\tresult: { ...firstInput.result, 提交哈希: secondSha.slice(0, 12) },\n\t\t\t\t};\n\t\t\t\tcommitToolCallEntry(fx, \"pao_deliver_card\", secondInput.toolCallId, { card_ref: 1 });\n\t\t\t\tawait registerDelivery(secondInput);\n\t\t\t\tconst both = versions();\n\t\t\t\texpect(both).toHaveLength(2);\n\t\t\t\texpect(both.map((v) => v.registration_key).sort()).toEqual(\n\t\t\t\t\t[location.commit, secondSha].map((sha) => `${taskIdForCard(fx.cardsDir, 1)}:deliver:${sha}`).sort(),\n\t\t\t\t);\n\t\t\t\tconst second = both.find((v) => v.version_id !== version!.version_id)!;\n\t\t\t\tconst resolved = await fx.registration.service.resolveArtifactVersion({ versionId: second.version_id });\n\t\t\t\texpect(resolved.ok && resolved.available && resolved.content.toString(\"utf8\")).toBe(\"第二次提交的产物内容\");\n\t\t\t\texpect(await registerDelivery(secondInput)).toContain(second.version_id);\n\t\t\t\texpect(await registerDelivery(firstInput)).toContain(version!.version_id);\n\t\t\t\texpect(versions()).toEqual(both);\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t} finally {\n\t\t\tawait fx.close();\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S6-01—05 定向测试：成果登记、确切版本回读与使用归因。\n *\t\t\t// F12：查重命中也补当前任务的 aref 'task' 引用（不只新建版本分支记）。\n\t\t\tconst taskRef = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'task' AND owner_id = ?\",\n\t\t\t\t)\n\t\t\t\t.get(first.versions[0]!.versionId, \"task-dup-2\") as { owner_id: string } | undefined;\n\t\t\texpect(taskRef?.owner_id).toBe(\"task-dup-2\");\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,87]}}},{"equalLines":{"line_count":430}},{"diffOp":{"equal":{"range":[87,229]}}},{"diffOp":{"delete":{"range":[229,235]}}},{"diffOp":{"equal":{"range":[235,331]}}},{"diffOp":{"delete":{"range":[331,337]}}},{"diffOp":{"equal":{"range":[337,477]}}},{"equalLines":{"line_count":48}},{"diffOp":{"equal":{"range":[477,486]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-artifacts.test.ts"},"span":null,"sourceCode":"/**\n * S6-01—05 定向测试：成果登记、确切版本回读与使用归因。\n *\n * 覆盖：一次调用产生两份成果共享 usageRef、登记重放不重复版本/引用、\n * 迟到用量只补引用、人工登记无工具调用时来源为人工、Git 两版本各读各的、\n * 分支名不能代替 commit、临时源删除后仍读受管副本、受管查重复用 versionId。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-artifacts.test.ts --maxWorkers=2\n */\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { existsSync, mkdtempSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport { memoryPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryService } from \"../../src/pao/memory/types.ts\";\n\n/** O14 探针状态：统计「写事务执行期间」的 git 子进程调用。 */\nconst probe = vi.hoisted(() => ({\n\tgitSpawnsInTx: [] as string[][],\n\tgitSpawnsTotal: 0,\n\tinTx: false,\n\tactive: false,\n}));\n\nvi.mock(\"node:child_process\", async (importOriginal) => {\n\tconst actual = await importOriginal<typeof import(\"node:child_process\")>();\n\treturn {\n\t\t...actual,\n\t\tspawnSync: (...args: Parameters<typeof spawnSync>) => {\n\t\t\tif (probe.active && args[0] === \"git\") {\n\t\t\t\tprobe.gitSpawnsTotal += 1;\n\t\t\t\tif (probe.inTx) probe.gitSpawnsInTx.push(args[1] as string[]);\n\t\t\t}\n\t\t\treturn (actual.spawnSync as typeof spawnSync)(...args);\n\t\t},\n\t};\n});\n\nconst tempDirs: string[] = [];\nconst AT = \"2026-11-10T10:00:00.000Z\";\n\nfunction tempDir(prefix: string): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// SQLite 句柄释放可能比 close 晚几毫秒（Windows）。\n\t\t}\n\t}\n});\n\nfunction openBoth(home: string): { svc: MemoryService; store: ReturnType<typeof openMemoryStore> } {\n\treturn { svc: openMemoryService({ paoHome: home, mode: \"readwrite\" }), store: openMemoryStore(home, \"readwrite\") };\n}\n\nfunction source(home: string, sessionId: string, entryId: string): string {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\ttry {\n\t\treturn registerSource(store.db, { sessionId, entryId, eventType: \"user\", capturedAt: AT });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\ndescribe(\"registerArtifact / resolveArtifactVersion\", () => {\n\tit(\"一次调用产生两份成果共享同一 usageRef，不重复计费\", async () => {\n\t\tconst home = tempDir(\"pao-art-shared-usage-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"a.txt\"), \"交付文件甲\");\n\t\t\twriteFileSync(join(dir, \"b.txt\"), \"交付文件乙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"一次调用两份交付\",\n\t\t\t\tpurpose: \"验证共享用量\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [\n\t\t\t\t\t{ name: \"a.txt\", path: join(dir, \"a.txt\") },\n\t\t\t\t\t{ name: \"b.txt\", path: join(dir, \"b.txt\") },\n\t\t\t\t],\n\t\t\t\toriginTaskId: \"task-1\",\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tsourceToolName: \"bash\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions).toHaveLength(2);\n\t\t\t// 两份版本共享同一 usageRef\n\t\t\texpect(registered.versions[0]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\texpect(registered.versions[1]!.usageRefs).toEqual([\"req-1\"]);\n\t\t\t// 各是一个版本行，不合并成一份\n\t\t\texpect(registered.versions[0]!.versionId).not.toBe(registered.versions[1]!.versionId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"同一 registrationKey 重放复用版本，不产生重复版本或重复 usageRef\", async () => {\n\t\tconst home = tempDir(\"pao-art-replay-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"out.txt\"), \"重放内容\");\n\n\t\t\tconst input = {\n\t\t\t\tname: \"重放成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"out.txt\", path: join(dir, \"out.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceToolCallId: \"call-1\",\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tregistrationKey: \"task-1:call-1\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t};\n\t\t\tconst first = await svc.registerArtifact(input);\n\t\t\texpect(first.ok && first.replayed).toBe(false);\n\t\t\tif (!first.ok) return;\n\n\t\t\t// 重放：迟到用量只补引用，版本行不新增。\n\t\t\tconst second = await svc.registerArtifact({ ...input, usageRefs: [\"req-1\", \"req-late\"] });\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.replayed).toBe(true);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.versions).toHaveLength(1);\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-late\"]);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"人工登记无工具调用时来源明确为人工（无 sourceToolCallId），不伪造调用\", async () => {\n\t\tconst home = tempDir(\"pao-art-manual-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-human\", \"e-human\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"hand.txt\"), \"人工登记内容\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"人工登记成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"hand.txt\", path: join(dir, \"hand.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tsourceSessionId: \"sess-human\",\n\t\t\t\tsourceEntryId: \"e-human\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\texpect(registered.versions[0]!.sourceToolCallId).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceToolName).toBeUndefined();\n\t\t\texpect(registered.versions[0]!.sourceSessionId).toBe(\"sess-human\");\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"未提交文件写受管副本；删除原临时源后仍读到相同内容\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-tmp-\");\n\t\t\tconst original = join(dir, \"scratch.txt\");\n\t\t\twriteFileSync(original, \"临时文件内容甲乙丙\");\n\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"临时文件成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"scratch.txt\", path: original }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst version = registered.versions[0]!;\n\t\t\texpect(version.location.kind).toBe(\"managed\");\n\n\t\t\t// 原临时文件删除后，受管副本仍可读回相同字节。\n\t\t\trmSync(original);\n\t\t\texpect(existsSync(original)).toBe(false);\n\t\t\tconst resolved = await svc.resolveArtifactVersion({ versionId: version.versionId });\n\t\t\texpect(resolved.ok && resolved.available).toBe(true);\n\t\t\tif (resolved.ok && resolved.available) {\n\t\t\t\texpect(resolved.content.toString(\"utf8\")).toBe(\"临时文件内容甲乙丙\");\n\t\t\t}\n\t\t\tconst loc = version.location;\n\t\t\tif (loc.kind === \"managed\") {\n\t\t\t\texpect(loc.dir.startsWith(memoryPaths(home).artifacts)).toBe(true);\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"受管查重：相同内容再次登记复用 versionId，不重复保存\", async () => {\n\t\tconst home = tempDir(\"pao-art-managed-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dirA = tempDir(\"pao-art-src-a-\");\n\t\t\tconst dirB = tempDir(\"pao-art-src-b-\");\n\t\t\twriteFileSync(join(dirA, \"same.txt\"), \"相同内容\");\n\t\t\twriteFileSync(join(dirB, \"same.txt\"), \"相同内容\");\n\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirA, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"查重成果\",\n\t\t\t\tartifactId: first.artifactId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"same.txt\", path: join(dirB, \"same.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\n\t\t\tconst count = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions WHERE artifact_id = ?\")\n\t\t\t\t.get(first.artifactId) as { n: number };\n\t\t\texpect(count.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 两版本各读各的；分支名不能代替 commit\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本一内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v1\"], { cwd: repo });\n\t\t\tconst commit1 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\twriteFileSync(join(repo, \"gen.txt\"), \"版本二内容已改变\");\n\t\t\texecFileSync(\"git\", [\"add\", \"gen.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"v2\"], { cwd: repo });\n\t\t\tconst commit2 = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst worktreePath = join(repo, \"gen.txt\");\n\n\t\t\tconst v1 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit1, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v1.ok).toBe(true);\n\t\t\tif (!v1.ok) return;\n\t\t\tconst v2 = await svc.registerArtifact({\n\t\t\t\tname: \"生成器\",\n\t\t\t\tartifactId: v1.artifactId,\n\t\t\t\tparentVersionId: v1.versions[0]!.versionId,\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: commit2, path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(v2.ok).toBe(true);\n\t\t\tif (!v2.ok) return;\n\t\t\texpect(v2.versions[0]!.parentVersionId).toBe(v1.versions[0]!.versionId);\n\n\t\t\t// 工作树当前内容是 v2，但 v1 版本读到的仍是 commit1 的确切内容。\n\t\t\tconst read1 = await svc.resolveArtifactVersion({ versionId: v1.versions[0]!.versionId });\n\t\t\texpect(read1.ok && read1.available).toBe(true);\n\t\t\tif (read1.ok && read1.available) {\n\t\t\t\texpect(read1.content.toString(\"utf8\")).toBe(\"版本一内容\");\n\t\t\t}\n\t\t\tconst read2 = await svc.resolveArtifactVersion({ versionId: v2.versions[0]!.versionId });\n\t\t\texpect(read2.ok && read2.available).toBe(true);\n\t\t\tif (read2.ok && read2.available) {\n\t\t\t\texpect(read2.content.toString(\"utf8\")).toBe(\"版本二内容已改变\");\n\t\t\t}\n\n\t\t\t// 分支名登记被拒绝——分支会移动，不能代替固定 commit。\n\t\t\tconst branchRef = await svc.registerArtifact({\n\t\t\t\tname: \"分支登记\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"gen.txt\", path: worktreePath, git: { commit: \"HEAD\", path: \"gen.txt\" } }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(branchRef.ok).toBe(false);\n\t\t\tif (!branchRef.ok) {\n\t\t\t\texpect(branchRef.error.code).toBe(\"invalid_input\");\n\t\t\t\texpect(branchRef.error.message).toContain(\"完整 commit SHA\");\n\t\t\t}\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"O14：登记事务内不发起 git 子进程（事务范围证据）\", async () => {\n\t\t// 验收口径要求「事务范围」具体改善证据：探针包住 store.transaction，\n\t\t// 事务体内任何 spawnSync(\"git\",…) 都被计数——改前 prepareFile 的\n\t\t// rev-parse/cat-file 全在事务内，改后事务内应为 0。\n\t\tconst home = tempDir(\"pao-art-tx-git-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"g.txt\"), \"git 内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"g.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\n\t\t\t// 包一层 transaction 探针的 store：registerArtifact 只经它开写事务。\n\t\t\tconst probeStore = {\n\t\t\t\tdb: store.db,\n\t\t\t\tmode: \"readwrite\" as const,\n\t\t\t\tclose: () => {},\n\t\t\t\ttransaction: <T>(fn: () => T): T => {\n\t\t\t\t\tprobe.inTx = true;\n\t\t\t\t\ttry {\n\t\t\t\t\t\treturn store.transaction(fn);\n\t\t\t\t\t} finally {\n\t\t\t\t\t\tprobe.inTx = false;\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t};\n\t\t\tconst { registerArtifact } = await import(\"../../src/pao/memory/artifacts.ts\");\n\t\t\tprobe.active = true;\n\t\t\tprobe.gitSpawnsInTx = [];\n\t\t\tprobe.gitSpawnsTotal = 0;\n\t\t\ttry {\n\t\t\t\tconst registered = registerArtifact(probeStore, home, {\n\t\t\t\t\tname: \"事务范围证据\",\n\t\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\t\tfiles: [{ name: \"g.txt\", path: join(repo, \"g.txt\"), git: { commit, path: \"g.txt\" } }],\n\t\t\t\t\tsourceIds: [src],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\texpect(registered.ok).toBe(true);\n\t\t\t} finally {\n\t\t\t\tprobe.active = false;\n\t\t\t}\n\t\t\t// 写事务体内 git 子进程数应为 0（rev-parse/cat-file 都在事务外解析）；\n\t\t\t// 同时确认登记确实起过 git 进程（>0），防止「根本没走到 Git 路径」的\n\t\t\t// 假通过。\n\t\t\texpect(probe.gitSpawnsTotal).toBeGreaterThan(0);\n\t\t\texpect(probe.gitSpawnsInTx).toEqual([]);\n\t\t\texpect(svc).toBeDefined();\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"Git 查重：同一 repo+commit+path 再登记复用版本，不产生第二行\", async () => {\n\t\tconst home = tempDir(\"pao-art-git-dedup-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst repo = tempDir(\"pao-art-repo-\");\n\t\t\texecFileSync(\"git\", [\"init\", \"--quiet\"], { cwd: repo });\n\t\t\twriteFileSync(join(repo, \"a.txt\"), \"git 查重内容\");\n\t\t\texecFileSync(\"git\", [\"add\", \"a.txt\"], { cwd: repo });\n\t\t\texecFileSync(\"git\", [\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-qm\", \"c1\"], { cwd: repo });\n\t\t\tconst commit = execFileSync(\"git\", [\"rev-parse\", \"HEAD\"], { cwd: repo, encoding: \"utf8\" }).trim();\n\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst file = { name: \"a.txt\", path: join(repo, \"a.txt\"), git: { commit, path: \"a.txt\" } };\n\t\t\tconst first = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果甲\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tusageRefs: [\"req-1\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(first.ok).toBe(true);\n\t\t\tif (!first.ok) return;\n\t\t\t// 另一个成果引用同一 git 身份：复用 versionId，usageRefs 补登不重复。\n\t\t\t// F12：查重命中不另建孤儿 artifacts 行——返回 artifactId 与版本自身归属一致。\n\t\t\tconst second = await svc.registerArtifact({\n\t\t\t\tname: \"git 成果乙\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [file],\n\t\t\t\tsourceIds: [src],\n\t\t\t\toriginTaskId: \"task-dup-2\",\n\t\t\t\tusageRefs: [\"req-1\", \"req-2\"],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(second.ok).toBe(true);\n\t\t\tif (!second.ok) return;\n\t\t\texpect(second.versions[0]!.versionId).toBe(first.versions[0]!.versionId);\n\t\t\texpect(second.versions[0]!.usageRefs).toEqual([\"req-1\", \"req-2\"]);\n\t\t\texpect(second.artifactId).toBe(first.artifactId);\n\t\t\texpect(second.artifactId).toBe(second.versions[0]!.artifactId);\n\t\t\tconst rows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifact_versions\").get() as { n: number };\n\t\t\texpect(rows.n).toBe(1);\n\t\t\t// F12：查重命中也补当前任务的 aref 'task' 引用（不只新建版本分支记）。\n\t\t\tconst taskRef = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t\"SELECT owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'task' AND owner_id = ?\",\n\t\t\t\t)\n\t\t\t\t.get(first.versions[0]!.versionId, \"task-dup-2\") as { owner_id: string } | undefined;\n\t\t\texpect(taskRef?.owner_id).toBe(\"task-dup-2\");\n\t\t\t// 孤儿行防线：全部查重命中时 artifacts 表仍只有 1 行。\n\t\t\tconst artifactRows = store.db.prepare(\"SELECT COUNT(*) AS n FROM artifacts\").get() as { n: number };\n\t\t\texpect(artifactRows.n).toBe(1);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"recordArtifactUse 记录 taskId/versionId/action 与回执引用\", async () => {\n\t\tconst home = tempDir(\"pao-art-use-\");\n\t\tconst { svc, store } = openBoth(home);\n\t\ttry {\n\t\t\tconst src = source(home, \"sess-1\", \"e-1\");\n\t\t\tconst dir = tempDir(\"pao-art-src-\");\n\t\t\twriteFileSync(join(dir, \"u.txt\"), \"使用归因内容\");\n\t\t\tconst registered = await svc.registerArtifact({\n\t\t\t\tname: \"使用归因\",\n\t\t\t\tscope: { projectId: \"p1\" },\n\t\t\t\tfiles: [{ name: \"u.txt\", path: join(dir, \"u.txt\") }],\n\t\t\t\tsourceIds: [src],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(registered.ok).toBe(true);\n\t\t\tif (!registered.ok) return;\n\t\t\tconst used = await svc.recordArtifactUse({\n\t\t\t\tversionId: registered.versions[0]!.versionId,\n\t\t\t\ttaskId: \"task-reuse-1\",\n\t\t\t\taction: \"reuse\",\n\t\t\t\treceiptRef: \"receipt-abc\",\n\t\t\t\tsessionId: \"sess-2\",\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\texpect(used.ok).toBe(true);\n\t\t\tif (!used.ok) return;\n\t\t\tconst row = store.db\n\t\t\t\t.prepare(\"SELECT task_id, action, receipt_ref FROM artifact_uses WHERE use_id = ?\")\n\t\t\t\t.get(used.useId) as { task_id: string; action: string; receipt_ref: string };\n\t\t\texpect(row).toEqual({ task_id: \"task-reuse-1\", action: \"reuse\", receipt_ref: \"receipt-abc\" });\n\t\t\t// use 引用行同步登记（删除预览按它判断共享保留）。\n\t\t\tconst ref = store.db\n\t\t\t\t.prepare(\"SELECT ref_kind, owner_id FROM artifact_refs WHERE version_id = ? AND ref_kind = 'use'\")\n\t\t\t\t.get(registered.versions[0]!.versionId) as { ref_kind: string; owner_id: string };\n\t\t\texpect(ref.owner_id).toBe(used.useId);\n\t\t} finally {\n\t\t\tawait svc.close();\n\t\t\tstore.close();\n\t\t}\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S7-09 定向测试：记忆数据库与归档的一致性备份/恢复（O07 修 F07/F08/F15）。\n *\t\t\texpect(JSON.stringify(events.events[0]!.content)).toContain(\"备份测试\");\n\t\t\t// 恢复库内段路径已重写到新 home。\n\t\t\tconst seg = store.db\n\t\t\t\t.preparestore.db.prepare(`SELECT original_path, compressed_path FROM archive_segments`)\n\t\t\t\t.get() as { original_path: string | null;compressed_path: string | null;\n\t\t\t};\n\t\t\tconst path = seg.compressed_path ?? seg.original_path;\n\t\t\texpect(path).not.toBeNull();\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(\n\t\t\t\t\t\tstore.db.prepare(`SELECT COUNT(*) AS n FROM memory_revisions WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\tn: number;\n\t\t\t\t\t).n,\n\t\t\t\t).toBe(0);\n\t\t\t\texpect(\n\t\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM memory_fts WHERE memory_id = ?`).get(memoryId) as {\n\t\t\t\t\t\t).n,\n\t\t\t\t).toBe(0);\n\t\t\t\t// 已删正文不再可回读：来源行已清 → 按 sourceId 回读 source_missing。\t\t\t// 共享保留来源行与其 fts 索引都保留；独占来源行与索引清除。\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(sharedSourceId) as {;\n\t\t\t\t\t).n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(sharedSourceId) as { })}\n\t\t\t\t).n,\n\t\t\t).toBe(1);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM sources WHERE source_id = ?`).get(exclusiveSourceId) as {.n,\n\t\t\t).toBe(0);\n\t\t\texpect(\n\t\t\t\t(store.db.prepare(`SELECT COUNT(*) AS n FROM source_fts WHERE source_id = ?`).get(exclusiveSourceId) as {\n\t\t\t\t\t).n,\n\t\t\t).toBe(0);\n\t\tconst store = openMemoryStore(targetHome, \"readonly\");\n\t\ttry {\n\t\t\tconst seg = };\n\t\t\texpect(seg.original_path).toBeNull();\n\t\t\texpect(seg.compressed_path).toBeNull();\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,108]}}},{"equalLines":{"line_count":315}},{"diffOp":{"equal":{"range":[108,254]}}},{"diffOp":{"delete":{"range":[254,275]}}},{"diffOp":{"insert":{"range":[275,291]}}},{"diffOp":{"equal":{"range":[291,354]}}},{"diffOp":{"delete":{"range":[354,359]}}},{"diffOp":{"equal":{"range":[359,370]}}},{"diffOp":{"delete":{"range":[370,3