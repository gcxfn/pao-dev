:{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[762,772]}}},{"diffOp":{"insert":{"range":[651,655]}}},{"diffOp":{"equal":{"range":[996,1065]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[522,618]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[622,625]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[625,641]}}},{"diffOp":{"delete":{"range":[343,344]}}},{"diffOp":{"insert":{"range":[618,622]}}},{"diffOp":{"equal":{"range":[762,772]}}},{"diffOp":{"insert":{"range":[651,655]}}},{"diffOp":{"equal":{"range":[1065,1210]}}},{"equalLines":{"line_count":58}},{"diffOp":{"equal":{"range":[1210,1219]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-maintenance-command.test.ts"},"span":null,"sourceCode":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *\n * 覆盖：\n * - /pao memory rebuild：走 registerMemoryCommand → openMemoryStore →\n *   rebuildMemoryIndex，FTS 行被重建且可通过 FTS 检索；范围过滤只清本范围。\n * - /pao memory backup：经 maintenance.enqueue 登记 archive 作业（不直接跑\n *   createMemoryBackup——归档由空闲 drain 执行）；enqueue 缺席时如实告警。\n * - /pao memory restore：restoreMemoryBackup 把备份目录恢复到独立目标 home，\n *   不动当前现场。\n * - rebuildMemoryIndex 范围清除（F06）：projectId/kind 筛选下只清范围内 FTS，\n *   范围外项目/类型的索引不动；已排除项不复活。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-maintenance-command.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport { restoreMemoryBackup } from \"../../src/pao/memory/backup.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerMemoryCommand } from \"../../src/pao/memory/session.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { createMemoryBackup } from \"../../src/pao/memory/backup.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst PROJECT_A = \"proj-a\";\nconst PROJECT_B = \"proj-b\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-cmd-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nfunction ftsCount(store: MemoryStore): number {\n\ttry {\n\t\treturn (store.db.prepare(\"SELECT COUNT(*) AS n FROM memory_fts\").get() as { n: number }).n;\n\t} catch {\n\t\treturn 0;\n\t}\n}\n\nfunction ftsIds(store: MemoryStore): string[] {\n\treturn (store.db.prepare(\"SELECT memory_id FROM memory_fts ORDER BY memory_id\").all() as Array<{ memory_id: string }>).map(\n\t\t(r) => r.memory_id,\n\t);\n}\n\nasync function seed(store: MemoryStore, home: string, over: { conclusion: string; kind?: \"decision\" | \"experience\"; projectId: string }) {\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\ttry {\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId: \"sess-cmd\",\n\t\t\tentryId: `e-${Math.random().toString(36).slice(2, 10)}`,\n\t\t\teventType: \"user\",\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst created = await service.createMemory({\n\t\t\tkind: over.kind ?? \"experience\",\n\t\t\tscope: { projectId: over.projectId },\n\t\t\tconclusion: over.conclusion,\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"tentative\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\treturn created.id;\n\t} finally {\n\t\tawait service.close();\n\t}\n}\n\nfunction commandCtx() {\n\treturn {\n\t\thasUI: true,\n\t\tcwd: process.cwd(),\n\t\tui: { notify: vi.fn(), confirm: vi.fn(async () => true) },\n\t} as never;\n}\n\nfunction runMemory(pi: ExtensionAPI, args: string, ctx: unknown) {\n\tconst sub = listPaoSubcommands(pi).find((item) => item.name === \"memory\");\n\tif (!sub) throw new Error(\"memory 子命令未注册\");\n\treturn sub.run(pi, args, ctx);\n}\n\n// ── J03：/pao memory 管理子命令入口 ─────────────────────────────────────\n\ndescribe(\"/pao memory 管理子命令（F05）\", () => {\n\tit(\"rebuild：命令入口触发 rebuildMemoryIndex，FTS 行重建可检索\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"可检索的重建结论\", projectId: PROJECT_A });\n\t\t// 先清空 FTS 模拟索引缺失。\n\t\tstore.db.exec(\"DELETE FROM memory_fts\");\n\t\texpect(ftsCount(store)).toBe(0);\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"rebuild\", ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\texpect(ftsIds(verify)).toEqual([id]);\n\t\tverify.close();\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"索引重建完成\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"rebuild --project：范围过滤只清本范围 FTS，范围外不动（F06 链验证）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"项目A结论\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"项目B结论\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `rebuild --project ${PROJECT_A}`, ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\tconst ids = ftsIds(verify);\n\t\texpect(ids.sort()).toEqual([idA, idB].sort());\n\t\tverify.close();\n\t});\n\n\tit(\"backup：登记 archive 作业（不直接跑备份），enqueue 收到归档参数\", async () => {\n\t\tconst home = tempHome();\n\t\tconst enqueue = vi.fn<(kind: \"archive\", scopeKey: string, sourceScope: string) => boolean>(() => true);\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home, { enqueue });\n\t\tawait runMemory(pi, \"backup D:\\\\backups\\\\mem-001\", ctx);\n\n\t\texpect(enqueue).toHaveBeenCalledTimes(1);\n\t\texpect(enqueue.mock.calls[0]![0]).toBe(\"archive\");\n\t\texpect(enqueue.mock.calls[0]![1]).toContain(\"archive:\");\n\t\tconst sourceScope = JSON.parse(enqueue.mock.calls[0]![2]) as { kind: string; backupDir: string };\n\t\texpect(sourceScope.kind).toBe(\"archive\");\n\t\texpect(sourceScope.backupDir).toBe(\"D:\\\\backups\\\\mem-001\");\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"已登记备份作业\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"backup：无维护 enqueue 时如实告警，不假装登记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"backup /tmp/whatever\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"维护队列未就绪\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n\n\tit(\"restore：备份目录恢复到独立目标 home，当前现场不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"待恢复的记忆\", projectId: PROJECT_A });\n\t\t// 先造一个真实备份（走 createMemoryBackup 产出备份目录）。\n\t\tconst backupDir = join(tempHome(), \"backup\");\n\t\tconst backup = createMemoryBackup(store, { home, backupDir, createdAt: AT });\n\t\tstore.close();\n\t\texpect(backup.ok).toBe(true);\n\n\t\t// 命令 restore 到独立 targetHome。\n\t\tconst targetHome = join(tempHome(), \"restored\");\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `restore ${backupDir} ${targetHome}`, ctx);\n\n\t\t// 目标 home 里能读到记忆。\n\t\tconst targetStore = openMemoryStore(targetHome, \"readonly\");\n\t\tconst row = targetStore.db.prepare(\"SELECT id FROM memories WHERE id = ?\").get(id);\n\t\texpect(row).toBeDefined();\n\t\ttargetStore.close();\n\t});\n\n\tit(\"restore 参数缺目标目录：用法告警，不调用恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"restore onlydir\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"用法\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n});\n\n// ── J04：rebuildMemoryIndex 范围清除（F06）─────────────────────────────\n\ndescribe(\"rebuildMemoryIndex 范围清除（F06）\", () => {\n\tit(\"projectId 筛选：只清范围内 FTS 行，范围外保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"A项目x\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"B项目y\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\n\t\t// 损坏范围 A 的 FTS（模拟索引漂移）。\n\t\tstore.db.prepare(\"DELETE FROM memory_fts WHERE memory_id = ?\").run(idA);\n\t\texpect(ftsIds(store)).toEqual([idB]);\n\n\t\t// 范围重建：A 的索引重建、B 的不动。\n\t\tconst result = rebuildMemoryIndex(store, { projectId: PROJECT_A, dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(0); // A 的 FTS 已手动清掉，无行可删\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"kind 筛选：只清该 kind 范围内 FTS，其他 kind 不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idExp = await seed(store, home, { conclusion: \"经验类\", kind: \"experience\", projectId: PROJECT_A });\n\t\tconst idDec = await seed(store, home, { conclusion: \"决定类\", kind: \"decision\", projectId: PROJECT_A });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\n\t\tconst result = rebuildMemoryIndex(store, { kind: \"experience\", dropExistingFts: true });\n\t\t// experience 的旧行被清掉再重建 → droppedFts=1；decision 行不动。\n\t\texpect(result.droppedFts).toBe(1);\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"无筛选 + dropExisting：全清后重建（既有行为保持）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"全清A\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"全清B\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsCount(store)).toBe(2);\n\n\t\tconst result = rebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(2);\n\t\texpect(result.rebuiltFts).toBe(2);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *import { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport { createMemoryBackup, restoreMemoryBackup } from \"../../src/pao/memory/backup.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";registerMemoryCommandrebuildMemoryIndex } from \"../../src/pao/memory/session.tsrebuild-index.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";registerSourcesources.tstype MemoryStore, openMemoryStorestore.tsbackup.ts\n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[101,304]}}},{"diffOp":{"equal":{"range":[304,314]}}},{"diffOp":{"insert":{"range":[314,334]}}},{"diffOp":{"equal":{"range":[334,394]}}},{"diffOp":{"delete":{"range":[394,470]}}},{"diffOp":{"equal":{"range":[394,404]}}},{"diffOp":{"delete":{"range":[470,491]}}},{"diffOp":{"insert":{"range":[491,509]}}},{"diffOp":{"equal":{"range":[509,539]}}},{"diffOp":{"delete":{"range":[539,549]}}},{"diffOp":{"insert":{"range":[549,565]}}},{"diffOp":{"equal":{"range":[565,567]}}},{"diffOp":{"equal":{"range":[567,636]}}},{"diffOp":{"equal":{"range":[394,404]}}},{"diffOp":{"delete":{"range":[636,650]}}},{"diffOp":{"insert":{"range":[470,491]}}},{"diffOp":{"equal":{"range":[509,539]}}},{"diffOp":{"delete":{"range":[650,660]}}},{"diffOp":{"insert":{"range":[539,549]}}},{"diffOp":{"equal":{"range":[565,567]}}},{"diffOp":{"equal":{"range":[394,404]}}},{"diffOp":{"delete":{"range":[660,693]}}},{"diffOp":{"insert":{"range":[636,650]}}},{"diffOp":{"equal":{"range":[509,539]}}},{"diffOp":{"delete":{"range":[693,701]}}},{"diffOp":{"insert":{"range":[650,660]}}},{"diffOp":{"equal":{"range":[565,567]}}},{"diffOp":{"equal":{"range":[394,404]}}},{"diffOp":{"delete":{"range":[314,332]}}},{"diffOp":{"insert":{"range":[660,693]}}},{"diffOp":{"equal":{"range":[509,539]}}},{"diffOp":{"delete":{"range":[701,710]}}},{"diffOp":{"insert":{"range":[693,701]}}},{"diffOp":{"equal":{"range":[565,567]}}},{"diffOp":{"equal":{"range":[710,742]}}},{"equalLines":{"line_count":241}},{"diffOp":{"equal":{"range":[742,751]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-maintenance-command.test.ts"},"span":[910,956],"sourceCode":"/**\n * O06/J03(F05)+J04(F06) 定向测试：/pao memory 管理子命令与 rebuild 范围清除。\n *\n * 覆盖：\n * - /pao memory rebuild：走 registerMemoryCommand → openMemoryStore →\n *   rebuildMemoryIndex，FTS 行被重建且可通过 FTS 检索；范围过滤只清本范围。\n * - /pao memory backup：经 maintenance.enqueue 登记 archive 作业（不直接跑\n *   createMemoryBackup——归档由空闲 drain 执行）；enqueue 缺席时如实告警。\n * - /pao memory restore：restoreMemoryBackup 把备份目录恢复到独立目标 home，\n *   不动当前现场。\n * - rebuildMemoryIndex 范围清除（F06）：projectId/kind 筛选下只清范围内 FTS，\n *   范围外项目/类型的索引不动；已排除项不复活。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-maintenance-command.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it, vi } from \"vitest\";\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { listPaoSubcommands } from \"../../src/pao/command-router.ts\";\nimport { restoreMemoryBackup } from \"../../src/pao/memory/backup.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerMemoryCommand } from \"../../src/pao/memory/session.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { createMemoryBackup } from \"../../src/pao/memory/backup.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst PROJECT_A = \"proj-a\";\nconst PROJECT_B = \"proj-b\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-cmd-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nfunction ftsCount(store: MemoryStore): number {\n\ttry {\n\t\treturn (store.db.prepare(\"SELECT COUNT(*) AS n FROM memory_fts\").get() as { n: number }).n;\n\t} catch {\n\t\treturn 0;\n\t}\n}\n\nfunction ftsIds(store: MemoryStore): string[] {\n\treturn (store.db.prepare(\"SELECT memory_id FROM memory_fts ORDER BY memory_id\").all() as Array<{ memory_id: string }>).map(\n\t\t(r) => r.memory_id,\n\t);\n}\n\nasync function seed(store: MemoryStore, home: string, over: { conclusion: string; kind?: \"decision\" | \"experience\"; projectId: string }) {\n\tconst service = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\ttry {\n\t\tconst sourceId = registerSource(store.db, {\n\t\t\tsessionId: \"sess-cmd\",\n\t\t\tentryId: `e-${Math.random().toString(36).slice(2, 10)}`,\n\t\t\teventType: \"user\",\n\t\t\tcapturedAt: AT,\n\t\t});\n\t\tconst created = await service.createMemory({\n\t\t\tkind: over.kind ?? \"experience\",\n\t\t\tscope: { projectId: over.projectId },\n\t\t\tconclusion: over.conclusion,\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"tentative\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedBy: \"user\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\t\treturn created.id;\n\t} finally {\n\t\tawait service.close();\n\t}\n}\n\nfunction commandCtx() {\n\treturn {\n\t\thasUI: true,\n\t\tcwd: process.cwd(),\n\t\tui: { notify: vi.fn(), confirm: vi.fn(async () => true) },\n\t} as never;\n}\n\nfunction runMemory(pi: ExtensionAPI, args: string, ctx: unknown) {\n\tconst sub = listPaoSubcommands(pi).find((item) => item.name === \"memory\");\n\tif (!sub) throw new Error(\"memory 子命令未注册\");\n\treturn sub.run(pi, args, ctx);\n}\n\n// ── J03：/pao memory 管理子命令入口 ─────────────────────────────────────\n\ndescribe(\"/pao memory 管理子命令（F05）\", () => {\n\tit(\"rebuild：命令入口触发 rebuildMemoryIndex，FTS 行重建可检索\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"可检索的重建结论\", projectId: PROJECT_A });\n\t\t// 先清空 FTS 模拟索引缺失。\n\t\tstore.db.exec(\"DELETE FROM memory_fts\");\n\t\texpect(ftsCount(store)).toBe(0);\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"rebuild\", ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\texpect(ftsIds(verify)).toEqual([id]);\n\t\tverify.close();\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"索引重建完成\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"rebuild --project：范围过滤只清本范围 FTS，范围外不动（F06 链验证）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"项目A结论\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"项目B结论\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `rebuild --project ${PROJECT_A}`, ctx);\n\n\t\tconst verify = openMemoryStore(home, \"readonly\");\n\t\tconst ids = ftsIds(verify);\n\t\texpect(ids.sort()).toEqual([idA, idB].sort());\n\t\tverify.close();\n\t});\n\n\tit(\"backup：登记 archive 作业（不直接跑备份），enqueue 收到归档参数\", async () => {\n\t\tconst home = tempHome();\n\t\tconst enqueue = vi.fn<(kind: \"archive\", scopeKey: string, sourceScope: string) => boolean>(() => true);\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home, { enqueue });\n\t\tawait runMemory(pi, \"backup D:\\\\backups\\\\mem-001\", ctx);\n\n\t\texpect(enqueue).toHaveBeenCalledTimes(1);\n\t\texpect(enqueue.mock.calls[0]![0]).toBe(\"archive\");\n\t\texpect(enqueue.mock.calls[0]![1]).toContain(\"archive:\");\n\t\tconst sourceScope = JSON.parse(enqueue.mock.calls[0]![2]) as { kind: string; backupDir: string };\n\t\texpect(sourceScope.kind).toBe(\"archive\");\n\t\texpect(sourceScope.backupDir).toBe(\"D:\\\\backups\\\\mem-001\");\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"已登记备份作业\"),\n\t\t\t\"info\",\n\t\t);\n\t});\n\n\tit(\"backup：无维护 enqueue 时如实告警，不假装登记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"backup /tmp/whatever\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"维护队列未就绪\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n\n\tit(\"restore：备份目录恢复到独立目标 home，当前现场不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst id = await seed(store, home, { conclusion: \"待恢复的记忆\", projectId: PROJECT_A });\n\t\t// 先造一个真实备份（走 createMemoryBackup 产出备份目录）。\n\t\tconst backupDir = join(tempHome(), \"backup\");\n\t\tconst backup = createMemoryBackup(store, { home, backupDir, createdAt: AT });\n\t\tstore.close();\n\t\texpect(backup.ok).toBe(true);\n\n\t\t// 命令 restore 到独立 targetHome。\n\t\tconst targetHome = join(tempHome(), \"restored\");\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, `restore ${backupDir} ${targetHome}`, ctx);\n\n\t\t// 目标 home 里能读到记忆。\n\t\tconst targetStore = openMemoryStore(targetHome, \"readonly\");\n\t\tconst row = targetStore.db.prepare(\"SELECT id FROM memories WHERE id = ?\").get(id);\n\t\texpect(row).toBeDefined();\n\t\ttargetStore.close();\n\t});\n\n\tit(\"restore 参数缺目标目录：用法告警，不调用恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst pi = {} as unknown as ExtensionAPI;\n\t\tconst ctx = commandCtx();\n\t\tregisterMemoryCommand(pi, () => undefined, () => home);\n\t\tawait runMemory(pi, \"restore onlydir\", ctx);\n\t\texpect((ctx as { ui: { notify: ReturnType<typeof vi.fn> } }).ui.notify).toHaveBeenCalledWith(\n\t\t\texpect.stringContaining(\"用法\"),\n\t\t\t\"warning\",\n\t\t);\n\t});\n});\n\n// ── J04：rebuildMemoryIndex 范围清除（F06）─────────────────────────────\n\ndescribe(\"rebuildMemoryIndex 范围清除（F06）\", () => {\n\tit(\"projectId 筛选：只清范围内 FTS 行，范围外保留\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"A项目x\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"B项目y\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\n\t\t// 损坏范围 A 的 FTS（模拟索引漂移）。\n\t\tstore.db.prepare(\"DELETE FROM memory_fts WHERE memory_id = ?\").run(idA);\n\t\texpect(ftsIds(store)).toEqual([idB]);\n\n\t\t// 范围重建：A 的索引重建、B 的不动。\n\t\tconst result = rebuildMemoryIndex(store, { projectId: PROJECT_A, dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(0); // A 的 FTS 已手动清掉，无行可删\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"kind 筛选：只清该 kind 范围内 FTS，其他 kind 不动\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idExp = await seed(store, home, { conclusion: \"经验类\", kind: \"experience\", projectId: PROJECT_A });\n\t\tconst idDec = await seed(store, home, { conclusion: \"决定类\", kind: \"decision\", projectId: PROJECT_A });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\n\t\tconst result = rebuildMemoryIndex(store, { kind: \"experience\", dropExistingFts: true });\n\t\t// experience 的旧行被清掉再重建 → droppedFts=1；decision 行不动。\n\t\texpect(result.droppedFts).toBe(1);\n\t\texpect(result.rebuiltFts).toBe(1);\n\t\texpect(ftsIds(store).sort()).toEqual([idExp, idDec].sort());\n\t\tstore.close();\n\t});\n\n\tit(\"无筛选 + dropExisting：全清后重建（既有行为保持）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst idA = await seed(store, home, { conclusion: \"全清A\", projectId: PROJECT_A });\n\t\tconst idB = await seed(store, home, { conclusion: \"全清B\", projectId: PROJECT_B });\n\t\trebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(ftsCount(store)).toBe(2);\n\n\t\tconst result = rebuildMemoryIndex(store, { dropExistingFts: true });\n\t\texpect(result.droppedFts).toBe(2);\n\t\texpect(result.rebuiltFts).toBe(2);\n\t\texpect(ftsIds(store).sort()).toEqual([idA, idB].sort());\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * O05 定向测试：来源原文词法索引(Q3)、pao_memory_read 工具(Q4)、\n * 完整渲染预算(Q6)、事件段 settled 封存(F10)。import { findOpenSegment, getSegment, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture, registerCapture } from \"../../src/pao/memory/capture.ts\";\nimport type { MemoryScope, SourceSearchHit } from \"../../src/pao/memory/index.ts\";\nimport { rebuildSourceFtsresolveMemoryScope } from \"../../src/pao/memory/project-index.tsidentity.ts\";registerResidentMemoryresident.tsrebuild-index.tsopenMemoryServiceservice.tsbindBuiltinMemoryService, sessionMemorysession.tsopenMemoryStoresessionMemory } from \"../../src/pao/memory/store.tsregisterBuiltinMemorytools.tsproject-identity.ts\n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,147]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[147,403]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[413,429]}}},{"diffOp":{"insert":{"range":[429,447]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[413,420]}}},{"diffOp":{"insert":{"range":[477,484]}}},{"diffOp":{"equal":{"range":[484,485]}}},{"diffOp":{"delete":{"range":[485,493]}}},{"diffOp":{"insert":{"range":[493,504]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[506,528]}}},{"diffOp":{"insert":{"range":[413,429]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[528,539]}}},{"diffOp":{"insert":{"range":[539,555]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[555,572]}}},{"diffOp":{"insert":{"range":[506,528]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[572,582]}}},{"diffOp":{"insert":{"range":[528,539]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[582,621]}}},{"diffOp":{"insert":{"range":[555,572]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[621,631]}}},{"diffOp":{"insert":{"range":[572,582]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[631,646]}}},{"diffOp":{"insert":{"range":[582,607]}}},{"diffOp":{"equal":{"range":[447,448]}}},{"diffOp":{"insert":{"range":[646,660]}}},{"diffOp":{"equal":{"range":[660,689]}}},{"diffOp":{"delete":{"range":[689,697]}}},{"diffOp":{"insert":{"range":[621,631]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[697,718]}}},{"diffOp":{"insert":{"range":[631,646]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[718,726]}}},{"diffOp":{"insert":{"range":[689,697]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[403,413]}}},{"diffOp":{"delete":{"range":[429,447]}}},{"diffOp":{"insert":{"range":[697,718]}}},{"diffOp":{"equal":{"range":[447,477]}}},{"diffOp":{"delete":{"range":[726,745]}}},{"diffOp":{"insert":{"range":[718,726]}}},{"diffOp":{"equal":{"range":[504,506]}}},{"diffOp":{"equal":{"range":[745,777]}}},{"equalLines":{"line_count":597}},{"diffOp":{"equal":{"range":[777,786]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-o05.test.ts"},"span":[950,1022],"sourceCode":"/**\n * O05 定向测试：来源原文词法索引(Q3)、pao_memory_read 工具(Q4)、\n * 完整渲染预算(Q6)、事件段 settled 封存(F10)。\n *\n * 覆盖：\n * - Q3：capture 采集的未提炼事件 history 命中 sourceHits（含封存段回读路径）；\n *   current 模式不返 sourceHits；删除来源后不再命中；rebuildSourceFts 重建一致。\n * - Q4：pao_memory_read 三用法（memory_id 详情 / source_id 分页 / 归属核对展开）、\n *   invalid_input / source_missing 如实透传、expand 记账只带 memory_id 时落 memory_usage。\n * - Q6：渲染预算整项省略（长 conditions+多来源）、候选 8 预算够注入 >3、\n *   上下文余量收紧时注入减少。\n * - F10：agent_settled 后 archive_segments.status='sealed'/'uncompressed'，原文仍可读。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-o05.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync, writeFileSync, mkdirSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\n\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { findOpenSegment, getSegment, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture, registerCapture } from \"../../src/pao/memory/capture.ts\";\nimport type { MemoryScope, SourceSearchHit } from \"../../src/pao/memory/index.ts\";\nimport { rebuildSourceFts } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerResidentMemory } from \"../../src/pao/memory/resident.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { bindBuiltinMemoryService, sessionMemory } from \"../../src/pao/memory/session.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerBuiltinMemory } from \"../../src/pao/memory/tools.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(prefix = \"pao-o05-\"): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst SCOPE: MemoryScope = resolveMemoryScope(process.cwd());\n\nlet seq = 0;\nfunction entry(partial: Record<string, unknown>) {\n\tseq += 1;\n\treturn { id: `e-${seq}`, parentId: seq > 1 ? `e-${seq - 1}` : null, timestamp: AT, ...partial };\n}\nconst msgUser = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({ type: \"message\", message: { role: \"user\", content, timestamp: 1, ...extra } });\nconst msgAssistant = (blocks: unknown[]) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: { role: \"assistant\", content: blocks, provider: \"p\", model: \"m\", usage: {}, stopReason: \"stop\" },\n\t});\n\n// ─── capturePi 夹具（与 memory-recall-inject.test.ts 同款） ────────────────────\n\ntype AnyHandler = (event: never, ctx: unknown) => unknown;\ninterface CapturedTool {\n\texecute(\n\t\ttoolCallId: string,\n\t\tparams: Record<string, unknown>,\n\t\tsignal: AbortSignal | undefined,\n\t\tonUpdate: unknown,\n\t\tctx: TestCtx,\n\t): Promise<{\n\t\tcontent: Array<{ type: string; text: string }>;\n\t\tdetails?: Record<string, unknown>;\n\t\tisError?: true;\n\t}>;\n}\n\nfunction capturePi() {\n\tconst handlers = new Map<string, AnyHandler[]>();\n\tconst tools = new Map<string, CapturedTool>();\n\tconst pi = {\n\t\ton: (event: string, handler: AnyHandler) => {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\tconst current = handlers.get(event);\n\t\t\t\tif (!current) return;\n\t\t\t\tconst index = current.indexOf(handler);\n\t\t\t\tif (index >= 0) current.splice(index, 1);\n\t\t\t};\n\t\t},\n\t\tregisterTool: (tool: { name: string }) => {\n\t\t\ttools.set(tool.name, tool as unknown as CapturedTool);\n\t\t},\n\t\tregisterCommand: () => {},\n\t\tsendMessage: () => {},\n\t};\n\treturn { handlers, tools, pi: pi as unknown as ExtensionAPI };\n}\n\ninterface TestCtx {\n\tcwd: string;\n\tsignal?: AbortSignal;\n\tsessionManager: {\n\t\tgetSessionId(): string;\n\t\tgetBranch(): unknown[];\n\t\tgetEntries(): unknown[];\n\t\tgetSessionFile(): string | undefined;\n\t\tgetEntry(): undefined;\n\t\tbuildSessionProjection(): { messages: unknown[]; thinkingLevel: string; model: null };\n\t};\n\tmodel?: { contextWindow?: number };\n}\n\nfunction testCtx(\n\tmessages: unknown[] = [],\n\toptions: { signal?: AbortSignal; sessionId?: string; entries?: unknown[]; contextWindow?: number } = {},\n): TestCtx {\n\tconst sessionId = options.sessionId ?? \"sess-inject\";\n\tconst entries = options.entries ?? [];\n\tconst contextWindow = options.contextWindow;\n\treturn {\n\t\tcwd: process.cwd(),\n\t\t...(options.signal === undefined ? {} : { signal: options.signal }),\n\t\tsessionManager: {\n\t\t\tgetSessionId: () => sessionId,\n\t\t\tgetBranch: () => entries as never[],\n\t\t\tgetEntries: () => entries,\n\t\t\tgetSessionFile: () => undefined,\n\t\t\tgetEntry: () => undefined,\n\t\t\tbuildSessionProjection: () => ({ messages, thinkingLevel: \"off\", model: null }),\n\t\t},\n\t\t...(contextWindow === undefined ? {} : { model: { contextWindow } }),\n\t};\n}\n\nasync function fireHandlers(\n\tcaptured: ReturnType<typeof capturePi>,\n\tname: string,\n\tevent: Record<string, unknown>,\n\tctx: TestCtx,\n): Promise<unknown[]> {\n\tconst results: unknown[] = [];\n\tfor (const handler of captured.handlers.get(name) ?? []) {\n\t\tresults.push(await handler(event as never, ctx));\n\t}\n\treturn results;\n}\n\n// ─── Q3：source_fts 词法索引 ──────────────────────────────────────────────\n\ndescribe(\"Q3 来源原文词法索引\", () => {\n\tit(\"采集的未提炼事件 history 命中 sourceHits；current 不返\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3\",\n\t\t\t[msgUser(\"拍板决定记忆存储用 SQLite 而非向量库\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\texpect(sourceId).toBeTruthy();\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst history = await svc.searchMemory({ scope: SCOPE, query: \"SQLite\", mode: \"history\" });\n\t\texpect(history.ok).toBe(true);\n\t\tif (history.ok) {\n\t\t\texpect(history.sourceHits).toBeDefined();\n\t\t\tconst hit = history.sourceHits?.find((h: SourceSearchHit) => h.sourceId === sourceId);\n\t\t\texpect(hit).toBeDefined();\n\t\t\texpect(hit?.sessionId).toBe(\"sess-q3\");\n\t\t\texpect(hit?.eventType).toBe(\"user\");\n\t\t\texpect(hit?.snippet).toContain(\"SQLite\");\n\t\t}\n\t\tconst current = await svc.searchMemory({ scope: SCOPE, query: \"SQLite\", mode: \"current\" });\n\t\texpect(current.ok).toBe(true);\n\t\tif (current.ok) expect(current.sourceHits).toBeUndefined();\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"封存段后 history 仍命中同一 sourceId\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-seal\",\n\t\t\t[msgUser(`封存长文 ${\"段\".repeat(300 * 1024)} 可命中词`)] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, \"sess-q3-seal\");\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(getSegment(store.db, segment!.segmentId)?.status).toBe(\"sealed\");\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"可命中词\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.sourceHits?.some((h: SourceSearchHit) => h.sourceId === sourceId)).toBe(true);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"删除来源关联记忆后该来源不再命中（source_exclusions 生效）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-del\",\n\t\t\t[msgUser(\"要删掉的来源词甲\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"无关结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(created.ok).toBe(true);\n\t\tif (!created.ok) return;\n\n\t\t// 删除会写 source_exclusions（memory_id 有值）→ history lane 剔除。\n\t\tconst deleted = await svc.deleteMemory({\n\t\t\tmemoryIds: [created.id],\n\t\t\trevisions: { [created.id]: 1 },\n\t\t\tsource: { sessionId: \"sess-q3-del\" },\n\t\t});\n\t\texpect(deleted.ok).toBe(true);\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"来源词甲\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.sourceHits?.some((h: SourceSearchHit) => h.sourceId === sourceId) ?? false).toBe(false);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"rebuildSourceFts 后 history 命中与重建前一致\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-rebuild\",\n\t\t\t[msgUser(\"重建校验词乙\"), msgAssistant([{ type: \"text\", text: \"重建校验词乙 回执\" }])] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst ids = captured.filter((r) => r.outcome === \"captured\").map((r) => r.sourceId as string);\n\t\texpect(ids.length).toBe(2);\n\n\t\t// 清空后重建：索引应从 sources+段文件恢复。\n\t\tstore.db.exec(\"DELETE FROM source_fts\");\n\t\texpect((store.db.prepare(\"SELECT COUNT(*) n FROM source_fts\").get() as { n: number }).n).toBe(0);\n\t\tconst rebuilt = await rebuildSourceFts(store);\n\t\texpect(rebuilt.rebuilt).toBe(2);\n\t\texpect(rebuilt.skipped).toBe(0);\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"重建校验词乙\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\tconst hitIds = new Set((r.sourceHits ?? []).map((h: SourceSearchHit) => h.sourceId));\n\t\t\tfor (const id of ids) expect(hitIds.has(id)).toBe(true);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n\n// ─── Q4：pao_memory_read 工具 ─────────────────────────────────────────────\n\ndescribe(\"Q4 pao_memory_read 只读工具\", () => {\n\tasync function setupBuiltin() {\n\t\tconst home = tempHome();\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\twriteFileSync(join(home, \"pao配置\", \"记忆供应商.json\"), JSON.stringify({ 供应商: \"builtin\" }), \"utf8\");\n\t\tconst captured = capturePi();\n\t\tconst registration = registerBuiltinMemory(captured.pi, { paoHome: home });\n\t\tconst tool = captured.tools.get(\"pao_memory_read\");\n\t\tif (!tool) throw new Error(\"pao_memory_read 未注册\");\n\t\treturn { home, captured, registration, tool };\n\t}\n\n\tit(\"只传 memory_id 返回当前修订详情与来源列表\", async () => {\n\t\tconst { home, captured, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read\", [msgUser(\"详情来源词\")] as never, AT);\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"读详情结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [cap[0]?.sourceId as string],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\"tc-1\", { memory_id: created.id }, undefined, undefined, testCtx());\n\t\texpect(result.isError).toBeUndefined();\n\t\tconst text = result.content[0]?.text ?? \"\";\n\t\texpect(text).toContain(\"读详情结论\");\n\t\texpect(text).toContain(\"rev-1\");\n\t\texpect(text).toContain(cap[0]?.sourceId);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t\tvoid captured;\n\t});\n\n\tit(\"source_id 分页：hasMore/nextOffset 连续翻页\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst entries = Array.from({ length: 5 }, (_, i) => msgUser(`翻页事件 ${i + 1}`));\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-page\", entries as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\n\t\tconst page1 = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: sourceId, offset: 0, limit: 2 },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-page\" }),\n\t\t);\n\t\texpect(page1.isError).toBeUndefined();\n\t\texpect(page1.details?.hasMore).toBe(true);\n\t\tconst nextOffset = page1.details?.nextOffset as number;\n\t\texpect(nextOffset).toBeGreaterThan(0);\n\t\tconst text1 = page1.content[0]?.text ?? \"\";\n\t\texpect(text1).toContain(\"翻页事件 1\");\n\t\texpect(text1).toContain(\"还有后续\");\n\n\t\tconst page2 = await tool.execute(\n\t\t\t\"tc-2\",\n\t\t\t{ source_id: sourceId, offset: nextOffset, limit: 10 },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-page\" }),\n\t\t);\n\t\texpect(page2.isError).toBeUndefined();\n\t\texpect(page2.details?.hasMore).toBe(false);\n\t\texpect(page2.content[0]?.text).toContain(`翻页事件 ${5}`);\n\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"memory_id+source_id 不归属返回 invalid_input\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst sourceId = \"src-member-check\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(sourceId, \"sess-read\", \"e-member\", \"user\", AT);\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"归属核对结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ memory_id: created.id, source_id: \"src-not-member\" },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(),\n\t\t);\n\t\texpect(result.isError).toBe(true);\n\t\texpect(result.content[0]?.text).toContain(\"不属于\");\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"缺失来源如实 source_missing\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: \"src-nonexistent\" },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(),\n\t\t);\n\t\texpect(result.isError).toBe(true);\n\t\texpect(result.content[0]?.text).toContain(\"来源不存在\");\n\t\tawait registration.close();\n\t\tvoid home;\n\t});\n\n\tit(\"memory_id+source_id 归属核对通过 → 展开且 expand 记账落 memory_usage\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-exp\", [msgUser(\"记账来源词\")] as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"记账核对结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ memory_id: created.id, source_id: sourceId },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-exp\" }),\n\t\t);\n\t\texpect(result.isError).toBeUndefined();\n\t\texpect(result.content[0]?.text).toContain(\"记账来源词\");\n\n\t\tconst rows = store.db\n\t\t\t.prepare(\"SELECT action, memory_id, usage_ref FROM memory_usage WHERE action = 'expand'\")\n\t\t\t.all() as unknown as Array<{ action: string; memory_id: string; usage_ref: string }>;\n\t\texpect(rows).toHaveLength(1);\n\t\texpect(rows[0]?.memory_id).toBe(created.id);\n\t\texpect(rows[0]?.usage_ref).toBe(sourceId);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"只 source_id 展开不写 expand 记账（与桌面口径一致）\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-noacc\", [msgUser(\"无记账来源词\")] as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: sourceId },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-noacc\" }),\n\t\t);\n\t\texpect(result.isError).toBeUndefined();\n\t\tconst rows = store.db\n\t\t\t.prepare(\"SELECT COUNT(*) n FROM memory_usage WHERE action = 'expand'\")\n\t\t\t.get() as { n: number };\n\t\texpect(rows.n).toBe(0);\n\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n});\n\n// ─── Q6：完整渲染预算 ──────────────────────────────────────────────────────\n\ndescribe(\"Q6 渲染预算\", () => {\n\tasync function setupRecall() {\n\t\tconst home = tempHome();\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\twriteFileSync(\n\t\t\tjoin(home, \"pao配置\", \"记忆供应商.json\"),\n\t\t\tJSON.stringify({ 供应商: \"builtin\", 自动召回: true }),\n\t\t\t\"utf8\",\n\t\t);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst captured = capturePi();\n\t\tbindBuiltinMemoryService(captured.pi, () => (svc.opened ? svc : undefined));\n\t\tregisterResidentMemory(captured.pi, { resolvePaoHome: () => home, getManager: () => undefined });\n\t\treturn { home, svc, store, captured };\n\t}\n\tasync function addMemory(\n\t\tf: { svc: ReturnType<typeof openMemoryService>; store: ReturnType<typeof openMemoryStore> },\n\t\targs: { conclusion: string; conditions?: string },\n\t): Promise<string> {\n\t\tconst sourceId = `src-q6-${Math.random().toString(36).slice(2)}`;\n\t\tf.store.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(sourceId, \"sess-q6\", `e-${Math.random()}`, \"user\", AT);\n\t\tconst r = await f.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: args.conclusion,\n\t\t\t...(args.conditions === undefined ? {} : { conditions: args.conditions }),\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!r.ok) throw new Error(r.error.message);\n\t\treturn r.id;\n\t}\n\tasync function fireTurn(\n\t\tcaptured: ReturnType<typeof capturePi>,\n\t\tprompt: string,\n\t\tctx: TestCtx,\n\t): Promise<{ message?: { content?: string } }> {\n\t\tconst sections: Record<string, string> = {};\n\t\tconst event = { type: \"before_agent_start\", prompt, systemPromptOptions: { sections } };\n\t\tlet message: { content?: string } | undefined;\n\t\tfor (const handler of captured.handlers.get(\"before_agent_start\") ?? []) {\n\t\t\tconst result = (await handler(event as never, ctx)) as { message?: { content?: string } } | undefined;\n\t\t\tif (result?.message) message = result.message;\n\t\t}\n\t\treturn { message };\n\t}\n\n\tit(\"长 conditions+多来源条目渲染超限时整项省略（不截条件）\", async () => {\n\t\tconst f = await setupRecall();\n\t\tawait addMemory(f, {\n\t\t\tconclusion: \"短结论\",\n\t\t\tconditions: `条件${\"长\".repeat(900)}`, // 渲染后 >800 → __paoWholeOnly 整项省略\n\t\t});\n\t\tconst fired = await fireTurn(f.captured, \"短结论\", testCtx());\n\t\t// builtin 命中渲染后带条件/状态行,__paoWholeOnly 装不下 → 整项省略不截半句。\n\t\tconst content = fired.message?.content ?? \"\";\n\t\texpect(content).not.toContain(\"短结论rev\");\n\t\texpect(content.includes(\"条件长\")).toBe(false); // 半句条件不注入\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n\n\tit(\"候选 8 条预算够时注入超过 3 条\", async () => {\n\t\tconst f = await setupRecall();\n\t\tfor (let i = 1; i <= 6; i++) await addMemory(f, { conclusion: `预算校验词丙第${i}条` });\n\t\tconst fired = await fireTurn(f.captured, \"预算校验词丙\", testCtx());\n\t\tconst count = (fired.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(count).toBeGreaterThan(3);\n\t\texpect(count).toBeLessThanOrEqual(8);\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n\n\tit(\"上下文余量收紧（投影接近 contextWindow）时注入减少\", async () => {\n\t\tconst f = await setupRecall();\n\t\tfor (let i = 1; i <= 6; i++) await addMemory(f, { conclusion: `预算校验词丁第${i}条` });\n\t\t// 对照组：空投影下预算=2000,6 条短命中全注入。\n\t\tconst base = await fireTurn(f.captured, \"预算校验词丁\", testCtx());\n\t\tconst baseCount = (base.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(baseCount).toBe(6);\n\n\t\t// 投影约 500k 码点 ≈ 125k token,逼近 128k contextWindow——\n\t\t// availableChars≈12k,5%≈600 码点 → 预算收紧注入减少。\n\t\tsessionMemory(f.captured.pi).reset(); // 清对照组注入态,免因当前上下文已有被去重\n\t\tconst bigProjection = Array.from({ length: 125 }, (_, i) => ({\n\t\t\trole: \"user\" as const,\n\t\t\tcontent: \"占\".repeat(4000) + i,\n\t\t}));\n\t\tconst fired = await fireTurn(\n\t\t\tf.captured,\n\t\t\t\"预算校验词丁\",\n\t\t\ttestCtx(bigProjection, { contextWindow: 128_000 }),\n\t\t);\n\t\tconst count = (fired.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(count).toBeLessThan(baseCount);\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n});\n\n// ─── F10：事件段 settled 封存 ─────────────────────────────────────────────\n\ndescribe(\"F10 agent_settled 封存\", () => {\n\tit(\"agent_settled 后本会话 unsealed 段被封存，原文仍可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst captured = capturePi();\n\t\tconst unmount = registerCapture(\n\t\t\tcaptured.pi,\n\t\t\t{ store, paoHome: home },\n\t\t\tcreateCapture({ store, paoHome: home, now: () => AT }),\n\t\t);\n\t\tconst sessionId = \"sess-f10\";\n\t\tconst entries = [msgUser(\"settled 封存词\")];\n\t\tconst ctx = testCtx(undefined, { sessionId, entries });\n\t\t// 触发 agent_settled：采集 + 段封存（seal 是异步 fire-and-forget，等一拍）。\n\t\tawait fireHandlers(captured, \"agent_settled\", { type: \"agent_settled\" }, ctx);\n\t\tawait new Promise((resolve) => setTimeout(resolve, 300));\n\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeUndefined(); // 已封存,不再有 unsealed\n\t\tconst sealed = store.db\n\t\t\t.prepare(\"SELECT segment_id, status FROM archive_segments WHERE session_id = ?\")\n\t\t\t.all(sessionId) as unknown as Array<{ segment_id: string; status: string }>;\n\t\texpect(sealed.length).toBe(1);\n\t\texpect([\"sealed\", \"uncompressed\"].includes(sealed[0]?.status ?? \"\")).toBe(true);\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sourceId = store.db\n\t\t\t.prepare(\"SELECT source_id FROM sources WHERE session_id = ? LIMIT 1\")\n\t\t\t.get(sessionId) as { source_id: string } | undefined;\n\t\tconst read = await svc.readMemorySource({ sourceId: sourceId!.source_id });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) expect(read.content).toContain(\"settled 封存词\");\n\n\t\tunmount();\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * O05 定向测试：来源原文词法索引(Q3)、pao_memory_read 工具(Q4)、\n * 完整渲染预算(Q6)、事件段 settled 封存(F10)。\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-del\", [msgUser(\"要删掉的来源词甲\")] as never,AT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\tit(\"缺失来源如实 source_missing\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst result = await tool.execute(\"tc-1\",{ source_id: \"src-nonexistent\" },undefined,testCtx());\n\t\texpect(result.isError).toBe(true);\n\t\texpect(result.content[0]?.text).toContain(\"来源不存在\");\t\t);\n\t\texpect(result.isError).toBeUndefined();\n\t\tconst rows = store.db\n\t\t\t.preparestore.db.prepare(\"SELECT COUNT(*) n FROM memory_usage WHERE action = 'expand'\").get() as {n: number;\n\t\t};\n\t\texpect(rows.n).toBe(0);\n\t\t\tcontent: \"占\".repeat(4000) + i,\n\t\t}));\n\t\tconst fired = await fireTurn(f.captured,\"预算校验词丁\",testCtx(bigProjection, { contextWindow: 128_000 }));\n\t\tconst count = (fired.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(count).toBeLessThan(baseCount);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sourceId = (\"SELECT source_id FROM sources WHERE session_id = ? LIMIT 1\").get(sessionId) as\n\t\t\t| { source_id: string }| undefined;\n\t\tconst read = await svc.readMemorySource({ sourceId: sourceId!.source_id });\n\t\texpect(read.ok).toBe(true);\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,147]}}},{"equalLines":{"line_count":212}},{"diffOp":{"equal":{"range":[147,324]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[328,342]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[343,390]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[390,392]}}},{"diffOp":{"delete":{"range":[392,396]}}},{"diffOp":{"equal":{"range":[396,521]}}},{"equalLines":{"line_count":178}},{"diffOp":{"equal":{"range":[521,673]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[673,680]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[680,713]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[713,723]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[713,723]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[723,732]}}},{"diffOp":{"delete":{"range":[392,396]}}},{"diffOp":{"equal":{"range":[732,835]}}},{"equalLines":{"line_count":57}},{"diffOp":{"equal":{"range":[835,897]}}},{"diffOp":{"delete":{"range":[897,917]}}},{"diffOp":{"insert":{"range":[917,933]}}},{"diffOp":{"equal":{"range":[933,996]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[996,1007]}}},{"diffOp":{"delete":{"range":[342,343]}}},{"diffOp":{"insert":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[1007,1016]}}},{"diffOp":{"delete":{"range":[342,343]}}},{"diffOp":{"insert":{"range":[1016,1020]}}},{"diffOp":{"equal":{"range":[1020,1049]}}},{"equalLines":{"line_count":101}},{"diffOp":{"equal":{"range":[1049,1123]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[1123,1134]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[1134,1155]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"insert":{"range":[342,343]}}},{"diffOp":{"equal":{"range":[1155,1205]}}},{"diffOp":{"delete":{"range":[392,396]}}},{"diffOp":{"equal":{"range":[1205,1323]}}},{"equalLines":{"line_count":31}},{"diffOp":{"equal":{"range":[1323,1414]}}},{"diffOp":{"delete":{"range":[897,917]}}},{"diffOp":{"insert":{"range":[917,933]}}},{"diffOp":{"equal":{"range":[1414,1476]}}},{"diffOp":{"delete":{"range":[324,328]}}},{"diffOp":{"equal":{"range":[1476,1494]}}},{"diffOp":{"insert":{"range":[1494,1499]}}},{"diffOp":{"equal":{"range":[1499,1521]}}},{"diffOp":{"delete":{"range":[1499,1500]}}},{"diffOp":{"insert":{"range":[1494,1498]}}},{"diffOp":{"equal":{"range":[1521,1641]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1641,1650]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-o05.test.ts"},"span":null,"sourceCode":"/**\n * O05 定向测试：来源原文词法索引(Q3)、pao_memory_read 工具(Q4)、\n * 完整渲染预算(Q6)、事件段 settled 封存(F10)。\n *\n * 覆盖：\n * - Q3：capture 采集的未提炼事件 history 命中 sourceHits（含封存段回读路径）；\n *   current 模式不返 sourceHits；删除来源后不再命中；rebuildSourceFts 重建一致。\n * - Q4：pao_memory_read 三用法（memory_id 详情 / source_id 分页 / 归属核对展开）、\n *   invalid_input / source_missing 如实透传、expand 记账只带 memory_id 时落 memory_usage。\n * - Q6：渲染预算整项省略（长 conditions+多来源）、候选 8 预算够注入 >3、\n *   上下文余量收紧时注入减少。\n * - F10：agent_settled 后 archive_segments.status='sealed'/'uncompressed'，原文仍可读。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-o05.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync, writeFileSync, mkdirSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\n\nimport type { ExtensionAPI } from \"../../src/core/extensions/types.ts\";\nimport { findOpenSegment, getSegment, sealSegment } from \"../../src/pao/memory/archive.ts\";\nimport { createCapture, registerCapture } from \"../../src/pao/memory/capture.ts\";\nimport type { MemoryScope, SourceSearchHit } from \"../../src/pao/memory/index.ts\";\nimport { rebuildSourceFts } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerResidentMemory } from \"../../src/pao/memory/resident.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { bindBuiltinMemoryService, sessionMemory } from \"../../src/pao/memory/session.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerBuiltinMemory } from \"../../src/pao/memory/tools.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(prefix = \"pao-o05-\"): string {\n\tconst dir = mkdtempSync(join(tmpdir(), prefix));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-08T10:00:00.000Z\";\nconst SCOPE: MemoryScope = resolveMemoryScope(process.cwd());\n\nlet seq = 0;\nfunction entry(partial: Record<string, unknown>) {\n\tseq += 1;\n\treturn { id: `e-${seq}`, parentId: seq > 1 ? `e-${seq - 1}` : null, timestamp: AT, ...partial };\n}\nconst msgUser = (content: unknown, extra: Record<string, unknown> = {}) =>\n\tentry({ type: \"message\", message: { role: \"user\", content, timestamp: 1, ...extra } });\nconst msgAssistant = (blocks: unknown[]) =>\n\tentry({\n\t\ttype: \"message\",\n\t\tmessage: { role: \"assistant\", content: blocks, provider: \"p\", model: \"m\", usage: {}, stopReason: \"stop\" },\n\t});\n\n// ─── capturePi 夹具（与 memory-recall-inject.test.ts 同款） ────────────────────\n\ntype AnyHandler = (event: never, ctx: unknown) => unknown;\ninterface CapturedTool {\n\texecute(\n\t\ttoolCallId: string,\n\t\tparams: Record<string, unknown>,\n\t\tsignal: AbortSignal | undefined,\n\t\tonUpdate: unknown,\n\t\tctx: TestCtx,\n\t): Promise<{\n\t\tcontent: Array<{ type: string; text: string }>;\n\t\tdetails?: Record<string, unknown>;\n\t\tisError?: true;\n\t}>;\n}\n\nfunction capturePi() {\n\tconst handlers = new Map<string, AnyHandler[]>();\n\tconst tools = new Map<string, CapturedTool>();\n\tconst pi = {\n\t\ton: (event: string, handler: AnyHandler) => {\n\t\t\tconst list = handlers.get(event) ?? [];\n\t\t\tlist.push(handler);\n\t\t\thandlers.set(event, list);\n\t\t\treturn () => {\n\t\t\t\tconst current = handlers.get(event);\n\t\t\t\tif (!current) return;\n\t\t\t\tconst index = current.indexOf(handler);\n\t\t\t\tif (index >= 0) current.splice(index, 1);\n\t\t\t};\n\t\t},\n\t\tregisterTool: (tool: { name: string }) => {\n\t\t\ttools.set(tool.name, tool as unknown as CapturedTool);\n\t\t},\n\t\tregisterCommand: () => {},\n\t\tsendMessage: () => {},\n\t};\n\treturn { handlers, tools, pi: pi as unknown as ExtensionAPI };\n}\n\ninterface TestCtx {\n\tcwd: string;\n\tsignal?: AbortSignal;\n\tsessionManager: {\n\t\tgetSessionId(): string;\n\t\tgetBranch(): unknown[];\n\t\tgetEntries(): unknown[];\n\t\tgetSessionFile(): string | undefined;\n\t\tgetEntry(): undefined;\n\t\tbuildSessionProjection(): { messages: unknown[]; thinkingLevel: string; model: null };\n\t};\n\tmodel?: { contextWindow?: number };\n}\n\nfunction testCtx(\n\tmessages: unknown[] = [],\n\toptions: { signal?: AbortSignal; sessionId?: string; entries?: unknown[]; contextWindow?: number } = {},\n): TestCtx {\n\tconst sessionId = options.sessionId ?? \"sess-inject\";\n\tconst entries = options.entries ?? [];\n\tconst contextWindow = options.contextWindow;\n\treturn {\n\t\tcwd: process.cwd(),\n\t\t...(options.signal === undefined ? {} : { signal: options.signal }),\n\t\tsessionManager: {\n\t\t\tgetSessionId: () => sessionId,\n\t\t\tgetBranch: () => entries as never[],\n\t\t\tgetEntries: () => entries,\n\t\t\tgetSessionFile: () => undefined,\n\t\t\tgetEntry: () => undefined,\n\t\t\tbuildSessionProjection: () => ({ messages, thinkingLevel: \"off\", model: null }),\n\t\t},\n\t\t...(contextWindow === undefined ? {} : { model: { contextWindow } }),\n\t};\n}\n\nasync function fireHandlers(\n\tcaptured: ReturnType<typeof capturePi>,\n\tname: string,\n\tevent: Record<string, unknown>,\n\tctx: TestCtx,\n): Promise<unknown[]> {\n\tconst results: unknown[] = [];\n\tfor (const handler of captured.handlers.get(name) ?? []) {\n\t\tresults.push(await handler(event as never, ctx));\n\t}\n\treturn results;\n}\n\n// ─── Q3：source_fts 词法索引 ──────────────────────────────────────────────\n\ndescribe(\"Q3 来源原文词法索引\", () => {\n\tit(\"采集的未提炼事件 history 命中 sourceHits；current 不返\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3\",\n\t\t\t[msgUser(\"拍板决定记忆存储用 SQLite 而非向量库\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\texpect(sourceId).toBeTruthy();\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst history = await svc.searchMemory({ scope: SCOPE, query: \"SQLite\", mode: \"history\" });\n\t\texpect(history.ok).toBe(true);\n\t\tif (history.ok) {\n\t\t\texpect(history.sourceHits).toBeDefined();\n\t\t\tconst hit = history.sourceHits?.find((h: SourceSearchHit) => h.sourceId === sourceId);\n\t\t\texpect(hit).toBeDefined();\n\t\t\texpect(hit?.sessionId).toBe(\"sess-q3\");\n\t\t\texpect(hit?.eventType).toBe(\"user\");\n\t\t\texpect(hit?.snippet).toContain(\"SQLite\");\n\t\t}\n\t\tconst current = await svc.searchMemory({ scope: SCOPE, query: \"SQLite\", mode: \"current\" });\n\t\texpect(current.ok).toBe(true);\n\t\tif (current.ok) expect(current.sourceHits).toBeUndefined();\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"封存段后 history 仍命中同一 sourceId\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-seal\",\n\t\t\t[msgUser(`封存长文 ${\"段\".repeat(300 * 1024)} 可命中词`)] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst segment = findOpenSegment(store.db, \"sess-q3-seal\");\n\t\tconst seal = await sealSegment(store.db, home, segment!.segmentId);\n\t\texpect(seal.ok).toBe(true);\n\t\texpect(getSegment(store.db, segment!.segmentId)?.status).toBe(\"sealed\");\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"可命中词\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.sourceHits?.some((h: SourceSearchHit) => h.sourceId === sourceId)).toBe(true);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"删除来源关联记忆后该来源不再命中（source_exclusions 生效）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-del\",\n\t\t\t[msgUser(\"要删掉的来源词甲\")] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst sourceId = captured[0]?.sourceId as string;\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"无关结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(created.ok).toBe(true);\n\t\tif (!created.ok) return;\n\n\t\t// 删除会写 source_exclusions（memory_id 有值）→ history lane 剔除。\n\t\tconst deleted = await svc.deleteMemory({\n\t\t\tmemoryIds: [created.id],\n\t\t\trevisions: { [created.id]: 1 },\n\t\t\tsource: { sessionId: \"sess-q3-del\" },\n\t\t});\n\t\texpect(deleted.ok).toBe(true);\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"来源词甲\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\texpect(r.sourceHits?.some((h: SourceSearchHit) => h.sourceId === sourceId) ?? false).toBe(false);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"rebuildSourceFts 后 history 命中与重建前一致\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst captured = capture.captureCommittedEntries(\n\t\t\t\"sess-q3-rebuild\",\n\t\t\t[msgUser(\"重建校验词乙\"), msgAssistant([{ type: \"text\", text: \"重建校验词乙 回执\" }])] as never,\n\t\t\tAT,\n\t\t);\n\t\tconst ids = captured.filter((r) => r.outcome === \"captured\").map((r) => r.sourceId as string);\n\t\texpect(ids.length).toBe(2);\n\n\t\t// 清空后重建：索引应从 sources+段文件恢复。\n\t\tstore.db.exec(\"DELETE FROM source_fts\");\n\t\texpect((store.db.prepare(\"SELECT COUNT(*) n FROM source_fts\").get() as { n: number }).n).toBe(0);\n\t\tconst rebuilt = await rebuildSourceFts(store);\n\t\texpect(rebuilt.rebuilt).toBe(2);\n\t\texpect(rebuilt.skipped).toBe(0);\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst r = await svc.searchMemory({ scope: SCOPE, query: \"重建校验词乙\", mode: \"history\" });\n\t\texpect(r.ok).toBe(true);\n\t\tif (r.ok) {\n\t\t\tconst hitIds = new Set((r.sourceHits ?? []).map((h: SourceSearchHit) => h.sourceId));\n\t\t\tfor (const id of ids) expect(hitIds.has(id)).toBe(true);\n\t\t}\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n\n// ─── Q4：pao_memory_read 工具 ─────────────────────────────────────────────\n\ndescribe(\"Q4 pao_memory_read 只读工具\", () => {\n\tasync function setupBuiltin() {\n\t\tconst home = tempHome();\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\twriteFileSync(join(home, \"pao配置\", \"记忆供应商.json\"), JSON.stringify({ 供应商: \"builtin\" }), \"utf8\");\n\t\tconst captured = capturePi();\n\t\tconst registration = registerBuiltinMemory(captured.pi, { paoHome: home });\n\t\tconst tool = captured.tools.get(\"pao_memory_read\");\n\t\tif (!tool) throw new Error(\"pao_memory_read 未注册\");\n\t\treturn { home, captured, registration, tool };\n\t}\n\n\tit(\"只传 memory_id 返回当前修订详情与来源列表\", async () => {\n\t\tconst { home, captured, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read\", [msgUser(\"详情来源词\")] as never, AT);\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"读详情结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [cap[0]?.sourceId as string],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\"tc-1\", { memory_id: created.id }, undefined, undefined, testCtx());\n\t\texpect(result.isError).toBeUndefined();\n\t\tconst text = result.content[0]?.text ?? \"\";\n\t\texpect(text).toContain(\"读详情结论\");\n\t\texpect(text).toContain(\"rev-1\");\n\t\texpect(text).toContain(cap[0]?.sourceId);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t\tvoid captured;\n\t});\n\n\tit(\"source_id 分页：hasMore/nextOffset 连续翻页\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst entries = Array.from({ length: 5 }, (_, i) => msgUser(`翻页事件 ${i + 1}`));\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-page\", entries as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\n\t\tconst page1 = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: sourceId, offset: 0, limit: 2 },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-page\" }),\n\t\t);\n\t\texpect(page1.isError).toBeUndefined();\n\t\texpect(page1.details?.hasMore).toBe(true);\n\t\tconst nextOffset = page1.details?.nextOffset as number;\n\t\texpect(nextOffset).toBeGreaterThan(0);\n\t\tconst text1 = page1.content[0]?.text ?? \"\";\n\t\texpect(text1).toContain(\"翻页事件 1\");\n\t\texpect(text1).toContain(\"还有后续\");\n\n\t\tconst page2 = await tool.execute(\n\t\t\t\"tc-2\",\n\t\t\t{ source_id: sourceId, offset: nextOffset, limit: 10 },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-page\" }),\n\t\t);\n\t\texpect(page2.isError).toBeUndefined();\n\t\texpect(page2.details?.hasMore).toBe(false);\n\t\texpect(page2.content[0]?.text).toContain(`翻页事件 ${5}`);\n\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"memory_id+source_id 不归属返回 invalid_input\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst sourceId = \"src-member-check\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(sourceId, \"sess-read\", \"e-member\", \"user\", AT);\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"归属核对结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ memory_id: created.id, source_id: \"src-not-member\" },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(),\n\t\t);\n\t\texpect(result.isError).toBe(true);\n\t\texpect(result.content[0]?.text).toContain(\"不属于\");\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"缺失来源如实 source_missing\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: \"src-nonexistent\" },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(),\n\t\t);\n\t\texpect(result.isError).toBe(true);\n\t\texpect(result.content[0]?.text).toContain(\"来源不存在\");\n\t\tawait registration.close();\n\t\tvoid home;\n\t});\n\n\tit(\"memory_id+source_id 归属核对通过 → 展开且 expand 记账落 memory_usage\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-exp\", [msgUser(\"记账来源词\")] as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\t\tconst created = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: \"记账核对结论\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!created.ok) throw new Error(created.error.message);\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ memory_id: created.id, source_id: sourceId },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-exp\" }),\n\t\t);\n\t\texpect(result.isError).toBeUndefined();\n\t\texpect(result.content[0]?.text).toContain(\"记账来源词\");\n\n\t\tconst rows = store.db\n\t\t\t.prepare(\"SELECT action, memory_id, usage_ref FROM memory_usage WHERE action = 'expand'\")\n\t\t\t.all() as unknown as Array<{ action: string; memory_id: string; usage_ref: string }>;\n\t\texpect(rows).toHaveLength(1);\n\t\texpect(rows[0]?.memory_id).toBe(created.id);\n\t\texpect(rows[0]?.usage_ref).toBe(sourceId);\n\n\t\tawait svc.close();\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n\n\tit(\"只 source_id 展开不写 expand 记账（与桌面口径一致）\", async () => {\n\t\tconst { home, registration, tool } = await setupBuiltin();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst capture = createCapture({ store, paoHome: home, now: () => AT });\n\t\tconst cap = capture.captureCommittedEntries(\"sess-read-noacc\", [msgUser(\"无记账来源词\")] as never, AT);\n\t\tconst sourceId = cap[0]?.sourceId as string;\n\n\t\tconst result = await tool.execute(\n\t\t\t\"tc-1\",\n\t\t\t{ source_id: sourceId },\n\t\t\tundefined,\n\t\t\tundefined,\n\t\t\ttestCtx(undefined, { sessionId: \"sess-read-noacc\" }),\n\t\t);\n\t\texpect(result.isError).toBeUndefined();\n\t\tconst rows = store.db\n\t\t\t.prepare(\"SELECT COUNT(*) n FROM memory_usage WHERE action = 'expand'\")\n\t\t\t.get() as { n: number };\n\t\texpect(rows.n).toBe(0);\n\n\t\tstore.close();\n\t\tawait registration.close();\n\t});\n});\n\n// ─── Q6：完整渲染预算 ──────────────────────────────────────────────────────\n\ndescribe(\"Q6 渲染预算\", () => {\n\tasync function setupRecall() {\n\t\tconst home = tempHome();\n\t\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\t\twriteFileSync(\n\t\t\tjoin(home, \"pao配置\", \"记忆供应商.json\"),\n\t\t\tJSON.stringify({ 供应商: \"builtin\", 自动召回: true }),\n\t\t\t\"utf8\",\n\t\t);\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst captured = capturePi();\n\t\tbindBuiltinMemoryService(captured.pi, () => (svc.opened ? svc : undefined));\n\t\tregisterResidentMemory(captured.pi, { resolvePaoHome: () => home, getManager: () => undefined });\n\t\treturn { home, svc, store, captured };\n\t}\n\tasync function addMemory(\n\t\tf: { svc: ReturnType<typeof openMemoryService>; store: ReturnType<typeof openMemoryStore> },\n\t\targs: { conclusion: string; conditions?: string },\n\t): Promise<string> {\n\t\tconst sourceId = `src-q6-${Math.random().toString(36).slice(2)}`;\n\t\tf.store.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO sources (source_id, session_id, entry_id, event_type, captured_at)\n\t\t\t\t VALUES (?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(sourceId, \"sess-q6\", `e-${Math.random()}`, \"user\", AT);\n\t\tconst r = await f.svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: { projectId: SCOPE.projectId },\n\t\t\tconclusion: args.conclusion,\n\t\t\t...(args.conditions === undefined ? {} : { conditions: args.conditions }),\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sourceId],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!r.ok) throw new Error(r.error.message);\n\t\treturn r.id;\n\t}\n\tasync function fireTurn(\n\t\tcaptured: ReturnType<typeof capturePi>,\n\t\tprompt: string,\n\t\tctx: TestCtx,\n\t): Promise<{ message?: { content?: string } }> {\n\t\tconst sections: Record<string, string> = {};\n\t\tconst event = { type: \"before_agent_start\", prompt, systemPromptOptions: { sections } };\n\t\tlet message: { content?: string } | undefined;\n\t\tfor (const handler of captured.handlers.get(\"before_agent_start\") ?? []) {\n\t\t\tconst result = (await handler(event as never, ctx)) as { message?: { content?: string } } | undefined;\n\t\t\tif (result?.message) message = result.message;\n\t\t}\n\t\treturn { message };\n\t}\n\n\tit(\"长 conditions+多来源条目渲染超限时整项省略（不截条件）\", async () => {\n\t\tconst f = await setupRecall();\n\t\tawait addMemory(f, {\n\t\t\tconclusion: \"短结论\",\n\t\t\tconditions: `条件${\"长\".repeat(900)}`, // 渲染后 >800 → __paoWholeOnly 整项省略\n\t\t});\n\t\tconst fired = await fireTurn(f.captured, \"短结论\", testCtx());\n\t\t// builtin 命中渲染后带条件/状态行,__paoWholeOnly 装不下 → 整项省略不截半句。\n\t\tconst content = fired.message?.content ?? \"\";\n\t\texpect(content).not.toContain(\"短结论rev\");\n\t\texpect(content.includes(\"条件长\")).toBe(false); // 半句条件不注入\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n\n\tit(\"候选 8 条预算够时注入超过 3 条\", async () => {\n\t\tconst f = await setupRecall();\n\t\tfor (let i = 1; i <= 6; i++) await addMemory(f, { conclusion: `预算校验词丙第${i}条` });\n\t\tconst fired = await fireTurn(f.captured, \"预算校验词丙\", testCtx());\n\t\tconst count = (fired.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(count).toBeGreaterThan(3);\n\t\texpect(count).toBeLessThanOrEqual(8);\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n\n\tit(\"上下文余量收紧（投影接近 contextWindow）时注入减少\", async () => {\n\t\tconst f = await setupRecall();\n\t\tfor (let i = 1; i <= 6; i++) await addMemory(f, { conclusion: `预算校验词丁第${i}条` });\n\t\t// 对照组：空投影下预算=2000,6 条短命中全注入。\n\t\tconst base = await fireTurn(f.captured, \"预算校验词丁\", testCtx());\n\t\tconst baseCount = (base.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(baseCount).toBe(6);\n\n\t\t// 投影约 500k 码点 ≈ 125k token,逼近 128k contextWindow——\n\t\t// availableChars≈12k,5%≈600 码点 → 预算收紧注入减少。\n\t\tsessionMemory(f.captured.pi).reset(); // 清对照组注入态,免因当前上下文已有被去重\n\t\tconst bigProjection = Array.from({ length: 125 }, (_, i) => ({\n\t\t\trole: \"user\" as const,\n\t\t\tcontent: \"占\".repeat(4000) + i,\n\t\t}));\n\t\tconst fired = await fireTurn(\n\t\t\tf.captured,\n\t\t\t\"预算校验词丁\",\n\t\t\ttestCtx(bigProjection, { contextWindow: 128_000 }),\n\t\t);\n\t\tconst count = (fired.message?.content?.match(/^\\d+\\. /gm) ?? []).length;\n\t\texpect(count).toBeLessThan(baseCount);\n\t\tawait f.svc.close();\n\t\tf.store.close();\n\t});\n});\n\n// ─── F10：事件段 settled 封存 ─────────────────────────────────────────────\n\ndescribe(\"F10 agent_settled 封存\", () => {\n\tit(\"agent_settled 后本会话 unsealed 段被封存，原文仍可读\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst captured = capturePi();\n\t\tconst unmount = registerCapture(\n\t\t\tcaptured.pi,\n\t\t\t{ store, paoHome: home },\n\t\t\tcreateCapture({ store, paoHome: home, now: () => AT }),\n\t\t);\n\t\tconst sessionId = \"sess-f10\";\n\t\tconst entries = [msgUser(\"settled 封存词\")];\n\t\tconst ctx = testCtx(undefined, { sessionId, entries });\n\t\t// 触发 agent_settled：采集 + 段封存（seal 是异步 fire-and-forget，等一拍）。\n\t\tawait fireHandlers(captured, \"agent_settled\", { type: \"agent_settled\" }, ctx);\n\t\tawait new Promise((resolve) => setTimeout(resolve, 300));\n\n\t\tconst segment = findOpenSegment(store.db, sessionId);\n\t\texpect(segment).toBeUndefined(); // 已封存,不再有 unsealed\n\t\tconst sealed = store.db\n\t\t\t.prepare(\"SELECT segment_id, status FROM archive_segments WHERE session_id = ?\")\n\t\t\t.all(sessionId) as unknown as Array<{ segment_id: string; status: string }>;\n\t\texpect(sealed.length).toBe(1);\n\t\texpect([\"sealed\", \"uncompressed\"].includes(sealed[0]?.status ?? \"\")).toBe(true);\n\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst sourceId = store.db\n\t\t\t.prepare(\"SELECT source_id FROM sources WHERE session_id = ? LIMIT 1\")\n\t\t\t.get(sessionId) as { source_id: string } | undefined;\n\t\tconst read = await svc.readMemorySource({ sourceId: sourceId!.source_id });\n\t\texpect(read.ok).toBe(true);\n\t\tif (read.ok) expect(read.content).toContain(\"settled 封存词\");\n\n\t\tunmount();\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"// O06 独立复核反面场景（审核口径：验证业务结果，不只看能力存在）。\n// - F01：等待期删除一条候选记忆后，organize 整理不得复活/提交它；\n// - F06：重建 A 项目索引后，B 项目 FTS 完整保留、A 范围内仍可检索。import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryServicecollectChangedMemories, runOrganizeMaintenance } from \"../../src/pao/memory/service.tsorganize.ts\";openMemoryStorerebuildMemoryIndex } from \"../../src/pao/memory/store.tsrebuild-index.tsrunOrganizeMaintenance, collectChangedMemoriesregisterSourcesources.ts\n\nconst dirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,281]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[281,406]}}},{"diffOp":{"equal":{"range":[406,416]}}},{"diffOp":{"delete":{"range":[416,433]}}},{"diffOp":{"insert":{"range":[433,456]}}},{"diffOp":{"equal":{"range":[456,457]}}},{"diffOp":{"insert":{"range":[457,480]}}},{"diffOp":{"equal":{"range":[480,509]}}},{"diffOp":{"delete":{"range":[509,519]}}},{"diffOp":{"insert":{"range":[519,530]}}},{"diffOp":{"equal":{"range":[530,532]}}},{"diffOp":{"equal":{"range":[406,416]}}},{"diffOp":{"delete":{"range":[532,547]}}},{"diffOp":{"insert":{"range":[547,565]}}},{"diffOp":{"equal":{"range":[565,595]}}},{"diffOp":{"delete":{"range":[595,603]}}},{"diffOp":{"insert":{"range":[603,619]}}},{"diffOp":{"equal":{"range":[530,532]}}},{"diffOp":{"equal":{"range":[406,416]}}},{"diffOp":{"delete":{"range":[619,665]}}},{"diffOp":{"insert":{"range":[416,433]}}},{"diffOp":{"equal":{"range":[565,595]}}},{"diffOp":{"delete":{"range":[519,530]}}},{"diffOp":{"insert":{"range":[509,519]}}},{"diffOp":{"equal":{"range":[530,532]}}},{"diffOp":{"equal":{"range":[406,416]}}},{"diffOp":{"delete":{"range":[547,565]}}},{"diffOp":{"insert":{"range":[665,679]}}},{"diffOp":{"equal":{"range":[565,595]}}},{"diffOp":{"delete":{"range":[603,619]}}},{"diffOp":{"insert":{"range":[679,689]}}},{"diffOp":{"equal":{"range":[530,532]}}},{"diffOp":{"equal":{"range":[406,416]}}},{"diffOp":{"delete":{"range":[665,679]}}},{"diffOp":{"insert":{"range":[532,547]}}},{"diffOp":{"equal":{"range":[565,595]}}},{"diffOp":{"delete":{"range":[679,689]}}},{"diffOp":{"insert":{"range":[595,603]}}},{"diffOp":{"equal":{"range":[530,532]}}},{"diffOp":{"equal":{"range":[689,717]}}},{"equalLines":{"line_count":121}},{"diffOp":{"equal":{"range":[717,726]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-o06-verify.test.ts"},"span":[282,328],"sourceCode":"// O06 独立复核反面场景（审核口径：验证业务结果，不只看能力存在）。\n// - F01：等待期删除一条候选记忆后，organize 整理不得复活/提交它；\n// - F06：重建 A 项目索引后，B 项目 FTS 完整保留、A 范围内仍可检索。\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { runOrganizeMaintenance, collectChangedMemories } from \"../../src/pao/memory/organize.ts\";\nimport { rebuildMemoryIndex } from \"../../src/pao/memory/rebuild-index.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\n\nconst dirs: string[] = [];\nfunction tmp(): string {\n\tconst d = mkdtempSync(join(tmpdir(), \"o06v-\"));\n\tdirs.push(d);\n\treturn d;\n}\nafterEach(() => {\n\tfor (const d of dirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(d, { recursive: true, force: true });\n\t\t} catch {}\n\t}\n});\nconst AT = \"2026-11-14T08:00:00.000Z\";\nlet seq = 0;\nfunction seedSource(store: ReturnType<typeof openMemoryStore>, projectId?: string): string {\n\tseq += 1;\n\treturn registerSource(store.db, {\n\t\tsessionId: \"sess-o06v\",\n\t\tentryId: `e-${seq}`,\n\t\teventType: \"user\",\n\t\tcapturedAt: AT,\n\t\t...(projectId === undefined ? {} : { projectId }),\n\t});\n}\n\ndescribe(\"O06 独立反面场景\", () => {\n\tit(\"F01: 等待期删除一条候选记忆后，整理不复活不提交\", async () => {\n\t\tconst home = tmp();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scope = { projectId: \"proj-x\" };\n\t\tconst s1 = seedSource(store, \"proj-x\");\n\t\tconst s2 = seedSource(store, \"proj-x\");\n\t\t// 两条词法完全相同的 decision，会成 organize 词法重复候选\n\t\tconst a = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope,\n\t\t\tconclusion: \"采用 SQLite 作为本地存储\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s1],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\tconst b = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope,\n\t\t\tconclusion: \"采用 SQLite 作为本地存储\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [s2],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\texpect(a.ok && b.ok).toBe(true);\n\t\tif (!a.ok || !b.ok) return;\n\t\t// 等待期彻底删除 b：用户已删，整理不得把它当候选复活/提交\n\t\tconst del = await svc.deleteMemory({\n\t\t\tmemoryIds: [b.id],\n\t\t\trevisions: { [b.id]: 1 },\n\t\t\tsource: { sessionId: \"sess-o06v\" },\n\t\t});\n\t\texpect(del.ok).toBe(true);\n\t\tconst changed = collectChangedMemories(store, scope, undefined);\n\t\t// 已删记忆不应出现在「待整理变化」里\n\t\texpect(changed.items.some((m) => m.memoryId === b.id)).toBe(false);\n\t\tconst res = await runOrganizeMaintenance({\n\t\t\tstore,\n\t\t\tservice: svc,\n\t\t\tpaoHome: home,\n\t\t\tsourceScope: JSON.stringify(scope),\n\t\t\tjobId: \"j1\",\n\t\t\tnow: () => AT,\n\t\t});\n\t\t// 即便 b 残留为候选，stale/excluded 复核也应拦截——a 不得 merged_into 到已删 b\n\t\tconst still = await svc.getMemory({ id: a.id });\n\t\texpect(still.ok).toBe(true);\n\t\tif (still.ok) expect(still.memory.mergedInto).toBeUndefined();\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n\n\tit(\"F06: 重建A项目后B项目FTS完整保留，A范围内仍可检索\", async () => {\n\t\tconst home = tmp();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tconst svc = openMemoryService({ paoHome: home, mode: \"readwrite\" });\n\t\tconst scopeA = { projectId: \"proj-A\" };\n\t\tconst scopeB = { projectId: \"proj-B\" };\n\t\tconst sa = seedSource(store, \"proj-A\");\n\t\tconst sb = seedSource(store, \"proj-B\");\n\t\tconst ma = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: scopeA,\n\t\t\tconclusion: \"A项目采用方案甲\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sa],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\tconst mb = await svc.createMemory({\n\t\t\tkind: \"decision\",\n\t\t\tscope: scopeB,\n\t\t\tconclusion: \"B项目采用方案乙\",\n\t\t\tevidenceKind: \"user_statement\",\n\t\t\tconfirmation: \"confirmed\",\n\t\t\tsourceIds: [sb],\n\t\t\tcreatedBy: \"user\",\n\t\t});\n\t\texpect(ma.ok && mb.ok).toBe(true);\n\t\tif (!ma.ok || !mb.ok) return;\n\t\t// 重建前 B 可检索\n\t\tconst preB = await svc.searchMemory({ scope: scopeB, query: \"方案乙\", mode: \"current\" });\n\t\texpect(preB.ok && preB.hits.length > 0).toBe(true);\n\t\t// 只重建 A\n\t\trebuildMemoryIndex(store, { projectId: \"proj-A\", dropExistingFts: true });\n\t\t// B 的 FTS 应完整保留（proj-B 行不被清掉）\n\t\tconst postB = await svc.searchMemory({ scope: scopeB, query: \"方案乙\", mode: \"current\" });\n\t\texpect(postB.ok && postB.hits.some((h) => h.memoryId === mb.id)).toBe(true);\n\t\t// A 重建后仍可检索\n\t\tconst postA = await svc.searchMemory({ scope: scopeA, query: \"方案甲\", mode: \"current\" });\n\t\texpect(postA.ok && postA.hits.some((h) => h.memoryId === ma.id)).toBe(true);\n\t\tawait svc.close();\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *import { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { registerMaintenanceScheduler, type MaintenanceSchedulerDeps, registerMaintenanceScheduler } from \"../../src/pao/memory/maintenance.ts\";\nimport {\n\tcollectChangedMemories,\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,89]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[89,270]}}},{"diffOp":{"equal":{"range":[270,280]}}},{"diffOp":{"delete":{"range":[280,310]}}},{"diffOp":{"equal":{"range":[310,339]}}},{"diffOp":{"insert":{"range":[339,369]}}},{"diffOp":{"equal":{"range":[369,415]}}},{"diffOp":{"equal":{"range":[415,449]}}},{"equalLines":{"line_count":565}},{"diffOp":{"equal":{"range":[449,458]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\memory-organize.test.ts"},"span":[741,787],"sourceCode":"/**\n * O06/J01(F01)+J02(F02) 定向测试：organize 维护 handler 与复合游标。\n *\n * 覆盖：\n * - collectChangedMemories 复合游标（updated_at|id）：首批、无变化、新增、\n *   旧记录修订、同时间戳超 200 条不漏；\n * - organize handler 全链：变化→分组→词法候选→复核→service.mergeMemories\n *   实际合并（merged_into 指向、修订推进）；\n * - 提交保护：双 confirmed 结论不同拒并；等待期停用/来源被排除的旧候选不提交；\n * - handler 经 registerMaintenanceScheduler 领取 organize job 分派执行。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/memory-organize.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport { registerMaintenanceScheduler, type MaintenanceSchedulerDeps } from \"../../src/pao/memory/maintenance.ts\";\nimport {\n\tcollectChangedMemories,\n\trunOrganizeMaintenance,\n\tserializeOrganizeCursor,\n\tstaleOrganizeMembers,\n} from \"../../src/pao/memory/organize.ts\";\nimport { resolveMemoryScope } from \"../../src/pao/memory/project-identity.ts\";\nimport { openMemoryService } from \"../../src/pao/memory/service.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport type { MemoryScope, MemoryService } from \"../../src/pao/memory/types.ts\";\n\nconst tempDirs: string[] = [];\nafterEach(() => {\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// Windows 句柄释放延迟；不掩盖断言。\n\t\t}\n\t}\n});\n\nconst PROJECT = \"proj-organize\";\nconst AT = \"2026-11-14T10:00:00.000Z\";\nconst AT2 = \"2026-11-14T10:01:00.000Z\";\nconst AT3 = \"2026-11-14T10:02:00.000Z\";\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-org-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\ninterface Fixture {\n\thome: string;\n\tstore: MemoryStore;\n\tservice: MemoryService;\n}\n\nfunction fixture(): Fixture {\n\tconst home = tempHome();\n\treturn { home, store: openMemoryStore(home, \"readwrite\"), service: openMemoryService({ paoHome: home, mode: \"readwrite\" }) };\n}\n\nasync function closeFixture(fx: Fixture): Promise<void> {\n\tawait fx.service.close();\n\tfx.store.close();\n}\n\nlet sourceSeq = 0;\nfunction seedSource(store: MemoryStore, capturedAt: string = AT): string {\n\tsourceSeq += 1;\n\treturn registerSource(store.db, {\n\t\tsessionId: \"sess-org\",\n\t\tentryId: `e-org-${sourceSeq}`,\n\t\teventType: \"user\",\n\t\tcapturedAt,\n\t});\n}\n\nasync function seedMemory(\n\tservice: MemoryService,\n\tover: {\n\t\tconclusion: string;\n\t\tkind?: \"decision\" | \"experience\";\n\t\tconfirmation?: \"confirmed\" | \"tentative\";\n\t\tconditions?: string;\n\t\ttaskId?: string;\n\t\tprojectId?: string;\n\t\tsourceIds: string[];\n\t\tcreatedAt?: string;\n\t},\n): Promise<string> {\n\tconst created = await service.createMemory({\n\t\tkind: over.kind ?? \"experience\",\n\t\tscope: {\n\t\t\tprojectId: over.projectId ?? PROJECT,\n\t\t\t...(over.taskId === undefined ? {} : { taskId: over.taskId }),\n\t\t},\n\t\tconclusion: over.conclusion,\n\t\t...(over.conditions === undefined ? {} : { conditions: over.conditions }),\n\t\tevidenceKind: \"user_statement\",\n\t\tconfirmation: over.confirmation ?? \"tentative\",\n\t\tsourceIds: over.sourceIds,\n\t\tcreatedBy: \"user\",\n\t\t...(over.createdAt === undefined ? {} : { createdAt: over.createdAt }),\n\t});\n\tif (!created.ok) throw new Error(created.error.message);\n\treturn created.id;\n}\n\n/** 直改 updated_at 造同时间戳批次（createdAt 控制不了 updated_at 列的独立值）。 */\nfunction setUpdatedAt(store: MemoryStore, memoryId: string, updatedAt: string): void {\n\tstore.db.prepare(\"UPDATE memories SET updated_at = ? WHERE id = ?\").run(updatedAt, memoryId);\n}\n\n// ── J02：复合游标 ────────────────────────────────────────────────────────\n\ndescribe(\"collectChangedMemories 复合游标（F02）\", () => {\n\tit(\"首批返回、无变化原样返回 cursor、新增/修订只回增量\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\tconst id1 = await seedMemory(fx.service, { conclusion: \"结论一\", sourceIds: [s1], createdAt: AT });\n\t\t\tconst id2 = await seedMemory(fx.service, { conclusion: \"结论二\", sourceIds: [s2], createdAt: AT });\n\t\t\tsetUpdatedAt(fx.store, id1, AT);\n\t\t\tsetUpdatedAt(fx.store, id2, AT2);\n\n\t\t\tconst first = collectChangedMemories(fx.store, { projectId: PROJECT }, undefined);\n\t\t\texpect(first.items.map((m) => m.memoryId)).toEqual([id1, id2]);\n\t\t\texpect(first.nextCursor).toBe(serializeOrganizeCursor(AT2, id2));\n\t\t\texpect(first.scanned).toBe(2);\n\n\t\t\t// 无变化：同游标再查为空且 cursor 原样。\n\t\t\tconst none = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(none.items).toHaveLength(0);\n\t\t\texpect(none.nextCursor).toBe(first.nextCursor);\n\n\t\t\t// 新增一条（更晚 updated_at）只返回新条目。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst id3 = await seedMemory(fx.service, { conclusion: \"结论三\", sourceIds: [s3], createdAt: AT3 });\n\t\t\tsetUpdatedAt(fx.store, id3, AT3);\n\t\t\tconst added = collectChangedMemories(fx.store, { projectId: PROJECT }, first.nextCursor);\n\t\t\texpect(added.items.map((m) => m.memoryId)).toEqual([id3]);\n\n\t\t\t// 旧记录修订：id1 再修订使 updated_at 前进，重扫应只返回 id1。\n\t\t\tconst corrected = await fx.service.correctMemory({\n\t\t\t\tid: id1,\n\t\t\t\texpectedRevision: 1,\n\t\t\t\treplacement: { conclusion: \"结论一（修订）\", evidenceKind: \"user_statement\", confirmation: \"confirmed\" },\n\t\t\t\tsource: { sessionId: \"sess-org\" },\n\t\t\t});\n\t\t\texpect(corrected.ok).toBe(true);\n\t\t\tsetUpdatedAt(fx.store, id1, \"2026-11-14T10:05:00.000Z\");\n\t\t\tconst revised = collectChangedMemories(fx.store, { projectId: PROJECT }, added.nextCursor);\n\t\t\texpect(revised.items.map((m) => m.memoryId)).toEqual([id1]);\n\t\t\texpect(revised.items[0]!.currentRevision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"同时间戳超过 200 条不漏：复合游标按 (updated_at,id) 推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst total = 250;\n\t\t\tconst ids: string[] = [];\n\t\t\tfor (let i = 0; i < total; i++) {\n\t\t\t\tconst sourceId = seedSource(fx.store);\n\t\t\t\tconst id = await seedMemory(fx.service, {\n\t\t\t\t\tconclusion: `同时间批次结论 ${i}`,\n\t\t\t\t\tsourceIds: [sourceId],\n\t\t\t\t\tcreatedAt: AT,\n\t\t\t\t});\n\t\t\t\tsetUpdatedAt(fx.store, id, AT);\n\t\t\t\tids.push(id);\n\t\t\t}\n\t\t\tconst seen = new Set<string>();\n\t\t\tlet cursor: string | undefined;\n\t\t\tfor (let round = 0; round < 5; round++) {\n\t\t\t\tconst batch = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\t\tfor (const item of batch.items) seen.add(item.memoryId);\n\t\t\t\tcursor = batch.nextCursor;\n\t\t\t\tif (batch.scanned < 200) break;\n\t\t\t}\n\t\t\texpect(seen.size).toBe(total);\n\t\t\tfor (const id of ids) expect(seen.has(id)).toBe(true);\n\t\t\t// 全部扫完后再查应为空。\n\t\t\tconst tail = collectChangedMemories(fx.store, { projectId: PROJECT }, cursor);\n\t\t\texpect(tail.items).toHaveLength(0);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n});\n\n// ── J01：organize handler 全链 ───────────────────────────────────────────\n\ndescribe(\"runOrganizeMaintenance（F01）\", () => {\n\tit(\"词法重复候选经 mergeMemories 合并：merged_into 指向 keep、keep 修订推进\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 两条同结论 active 记忆（同 kind+同 taskId 组内）→ 词法候选。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"使用 SQLite 存储本地记忆\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-1\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\texpect(result.done).toBe(true);\n\n\t\t\t// keep/merge 方向由 sortByExpiry+memoryId 排序决定（UUID 随机），\n\t\t\t// 只断言一条 merged_into 指向另一条且 keep 修订推进。\n\t\t\tconst rows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into, current_revision FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null; current_revision: number }>;\n\t\t\tconst mergedOne = rows.find((r) => r.merged_into !== null);\n\t\t\tconst keptOne = rows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedOne).toBeDefined();\n\t\t\texpect(keptOne).toBeDefined();\n\t\t\texpect(mergedOne!.merged_into).toBe(keptOne!.id);\n\t\t\texpect(keptOne!.current_revision).toBe(2);\n\t\t} finally {\n\t\t\tawait closeFixture(fx);\n\t\t}\n\t});\n\n\tit(\"双 confirmed 同结论可并；不同结论的服务层拒并保护仍在\", async () => {\n\t\tconst fx = fixture();\n\t\ttry {\n\t\t\tconst s1 = seedSource(fx.store);\n\t\t\tconst s2 = seedSource(fx.store);\n\t\t\t// 双 confirmed 同结论 → organize 的候选合并不被「双 confirmed」误拦。\n\t\t\tconst keepId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s1],\n\t\t\t\tcreatedAt: AT,\n\t\t\t});\n\t\t\tconst mergeId = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"部署用方案 A\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\tsourceIds: [s2],\n\t\t\t\tcreatedAt: AT2,\n\t\t\t});\n\t\t\tconst result = await runOrganizeMaintenance({\n\t\t\t\tstore: fx.store,\n\t\t\t\tservice: fx.service,\n\t\t\t\tpaoHome: fx.home,\n\t\t\t\tsourceScope: JSON.stringify({ projectId: PROJECT }),\n\t\t\t\tjobId: \"job-org-2\",\n\t\t\t});\n\t\t\texpect(result.merged).toBe(1);\n\t\t\tconst pairRows = fx.store.db\n\t\t\t\t.prepare(\"SELECT id, merged_into FROM memories WHERE id IN (?, ?)\")\n\t\t\t\t.all(keepId, mergeId) as Array<{ id: string; merged_into: string | null }>;\n\t\t\tconst mergedPair = pairRows.find((r) => r.merged_into !== null);\n\t\t\tconst keptPair = pairRows.find((r) => r.merged_into === null);\n\t\t\texpect(mergedPair).toBeDefined();\n\t\t\texpect(keptPair).toBeDefined();\n\t\t\texpect(mergedPair!.merged_into).toBe(keptPair!.id);\n\n\t\t\t// 服务层保护仍在：不同结论的双 confirmed 直接调 mergeMemories 被拒——\n\t\t\t// organize 走同一入口，语义/词法候选若命中这类对同样会被拒。\n\t\t\tconst s3 = seedSource(fx.store);\n\t\t\tconst s4 = seedSource(fx.store);\n\t\t\tconst conflictA = await seedMemory(fx.service, {\n\t\t\t\tconclusion: \"缓存层选 Redis\",\n\t\t\t\tkind: \"decision\",\n\t\t\t\tconfirmation: \"confi