sage } from \"@pao/ai\";\nimport { SessionManager } from \"../../core/session-manager.ts\";\nimport type { ArchivedEvent } from \"../memory/archive.ts\";\nimport type { ContextUsageSnapshot } from \"../memory/context-usage.ts\";\nimport { getEffectiveVersion } from \"../evolution/activation.ts\";\nimport { listTaskBindings, type TaskBinding } from \"../evolution/binding.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n\ttype ActivationHistoryEntry,\n} from \"../evolution/control.ts\";\nimport { countUsageByVersion, type UsageByVersionCounts } from \"../evolution/observe.ts\";\nimport { readResourceVersion } from \"../evolution/versions.ts\";\nimport type {\n\tEvolutionFileDiff,\n\tEvolutionResource,\n\tValidationRunResult,\n} from \"../evolution/types.ts\";\nimport { evolutionPaths, memoryPaths } from \"../memory/paths.ts\";\nimport { decodeArtifactReceiptRef } from \"../memory/artifacts.ts\";\nimport { readProjectContext, recordProjectGoalChange } from \"../memory/project-context.ts\";\nimport { archiveProjectOperationSource } from \"../memory/project-operation-source.ts\";\nimport { historyScopeFilter } from \"../memory/scope.ts\";\nimport { openMemoryService } from \"../memory/service.ts\";\nimport { sourcesForRevision } from \"../memory/sources.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport {\n\tlistTaskContinuationsForProject,\n\treadTaskContinuationForPage,\n\ttype TaskContinuationPageListResult,\n} from \"../memory/task-continuation-page.ts\";\nimport type {\n\tArtifact,\n\tArtifactLocation,\n\tArtifactRefKind,\n\tConfirmationState,\n\tCorrectMemoryResult,\n\tDeleteMemoryResult,\n\tDeletionOperationDto,\n\tDeletionSessionCoordinator,\n\tEvidenceKind,\n\tGetMemoryResult,\n\tMemoryDto,\n\tMemoryError,\n\tMemoryKind,\n\tMemoryResult,\n\tMemoryRevision,\n\tMemoryScope,\n\tMemoryService,\n\tMemoryUsageAction,\n\tMemoryUsageState,\n\tMergeMemoriesResult,\n\tPreviewMemoryDeletionResult,\n\tProjectContextBrief,\n\tProjectSourceRef,\n\tReadTaskContinuationOutput,\n\tRecordProjectGoalChangeResult,\n\tSearchMemoryResult,\n\tSetMemoryUsageResult,\n\tSharedSourcePolicy,\n} from \"../memory/types.ts\";\nimport { readMemoryUsage } from \"../memory/usage-query.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 0. 错误与统一返回\n// ════════════════════════════════════════════════════════════════════════\n\nexport type {\n\tTaskContinuationPageItem,\n\tTaskContinuationPageListResult,\n} from \"../memory/task-continuation-page.ts\";\nexport type {\n\tArtifact,\n\tArtifactLocation,\n\tArtifactRefKind,\n\tArtifactUse,\n\tArtifactVersion,\n\tConfirmationState,\n\tDeleteMemoryInput,\n\tDeleteMemoryResult,\n\tDeletionOperationDto,\n\tDeletionPendingObject,\n\tDeletionSessionCoordinator,\n\tDeletionSessionImpact,\n\tDeletionSourceImpact,\n\tDeletionStatus,\n\tEvidenceKind,\n\tMemoryDto,\n\tMemoryError,\n\tMemoryErrorCode,\n\tMemoryKind,\n\tMemoryResult,\n\tMemoryRevision,\n\tMemoryRevisionContent,\n\tMemorySource,\n\tMemoryUsageAction,\n\tMemoryUsageState,\n\tPreviewMemoryDeletionInput,\n\tPreviewMemoryDeletionResult,\n\tProjectCardSnapshot,\n\tProjectContextBinding,\n\tProjectContextBrief,\n\tProjectGoalHistoryEntry,\n\tProjectGoalSnapshot,\n\tProjectSourceRef,\n\tReadDeletionOperationInput,\n\tReadTaskContinuationOutput,\n\tRecordProjectGoalChangeResult,\n\tResumeDeletionInput,\n\tSharedSourcePolicy,\n\tTaskContinuationCurrentState,\n\tTaskContinuationDifference,\n\tTaskContinuationRecord,\n\tTaskContinuationStatement,\n} from \"../memory/types.ts\";\nexport { MEMORY_ERROR_CODES } from \"../memory/types.ts\";\nexport type {\n\tEvolutionFileDiff,\n\tEvolutionResource,\n\tValidationRunResult,\n} from \"../evolution/types.ts\";\nexport type { ActivationHistoryEntry } from \"../evolution/control.ts\";\nexport type { TaskBinding, TaskBindingSwitch } from \"../evolution/binding.ts\";\nexport type { UsageByVersionCounts } from \"../evolution/observe.ts\";\n\n/** 本层抛出的环境级错误（PAO_HOME 缺、库打不开）；业务拒绝走 MemoryResult 不抛。 */\nexport class DesktopMemoryError extends Error {\n\toverride name = \"DesktopMemoryError\";\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 入参形状（调用方传入已解析身份）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 桌面侧的已解析范围：只带桌面能合法确定的身份。\n * projectId 必填（dept 桥同源：不在这里猜项目）；taskId/sessionId/department 可选。\n * 内核映射成 MemoryScope 使用；deptId 与内核字段名 department 对齐。\n */\nexport interface DesktopMemoryScope {\n\t/** 稳定项目 ID（projects 表主键；调用方按宿主项目解析传入）。 */\n\tprojectId: string;\n\t/** 任务 ID（卡号/工作流实例等；通用记忆不传）。 */\n\ttaskId?: string;\n\t/** 会话 ID（页面侧通常不传——读不依赖活动会话；mutate source 另行给）。 */\n\tsessionId?: string;\n\t/** 所属部门（部门库归属；字段名与内核 MemoryScope.department 对应）。 */\n\tdeptId?: string;\n}\n\nfunction toMemoryScope(scope: DesktopMemoryScope): MemoryScope {\n\treturn {\n\t\tprojectId: scope.projectId,\n\t\t...(scope.taskId === undefined ? {} : { taskId: scope.taskId }),\n\t\t...(scope.sessionId === undefined ? {} : { sessionId: scope.sessionId }),\n\t\t...(scope.deptId === undefined ? {} : { department: scope.deptId }),\n\t};\n}\n\n/** 列表/详情/来源回读的公共入参。 */\nexport interface DesktopMemoryHomeInput {\n\t/** PAO_HOME 根路径（必填——不在这里猜）。 */\n\thome: string;\n}\n\n// ── readDesktopMemoryList ────────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryListInput extends DesktopMemoryHomeInput {\n\tscope: DesktopMemoryScope;\n\t/** 查询词（可空串——空串按「全部」词法列举，不触发语义路）。 */\n\tquery: string;\n\t/** 使用状态过滤；缺省按当前召回口径（active、未合并、来源未排除）。 */\n\tstatus?: MemoryUsageState;\n\t/** 类型过滤；缺省全部类型。 */\n\tkind?: MemoryKind;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n\t/** current=只查当前有效修订（默认）；history=含被替代修订与归档段。 */\n\tmode?: \"current\" | \"history\";\n}\n\n/** 列表项：单条记忆的页面展示摘要（详情走 readDesktopMemoryDetail）。 */\nexport interface MemoryListItem {\n\tmemoryId: string;\n\trevision: number;\n\tkind: MemoryKind;\n\tscope: MemoryScope;\n\t/** 当前修订结论正文（页面列表主文本）。 */\n\tconclusion: string;\n\t/** 适用条件（可空）。 */\n\tconditions?: string;\n\t/** 理由（可空；模型未给出时不补造）。 */\n\trationale?: string;\n\tevidenceKind: EvidenceKind;\n\tconfirmation: ConfirmationState;\n\tusageState: MemoryUsageState;\n\t/** 相关度（0-1；query 为空时为 1——按当前修订时间倒序而非召回分）。 */\n\trelevance: number;\n\tmatchKind: \"lexical\" | \"semantic\" | \"both\";\n\t/** 跨项目命中标记（referenceOnly：不可作为当前项目约束）。 */\n\treferenceOnly?: boolean;\n\t/** 命中修订引用的来源 ID 列表。 */\n\tsourceIds?: string[];\n\t/** 合并指向（本记忆是副本时为 canonical ID）。 */\n\tmergedInto?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\nexport interface ReadDesktopMemoryListResult {\n\titems: MemoryListItem[];\n\t/** 空查询时的精确总条数；关键词召回无法证明全量时省略。 */\n\ttotal?: number;\n\t/** total 是否覆盖同一范围与筛选条件下的全部记录。 */\n\ttotalKnown: boolean;\n\t/** 关键词召回窗内、应用 status/kind 后的候选数。 */\n\tcandidateCount?: number;\n\t/** 关键词查询的候选窗上限。 */\n\tcandidateLimit?: number;\n\t/** 是否还有下一页。 */\n\thasMore: boolean;\n\t/** 是否降级（语义路未参与）。 */\n\tdegraded?: boolean;\n\t/** 降级原因（degraded 时）。 */\n\tdegradeReason?: string;\n\t/** 空态说明（items 为空时）。 */\n\temptyReason?: string;\n}\n\n// ── readDesktopMemoryDetail ──────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryDetailInput extends DesktopMemoryHomeInput {\n\tid: string;\n\t/** 所选修订号；缺省读当前版。 */\n\trevision?: number;\n}\n\n/** 详情：所选修订决定 + 修订时间线 + 同修订来源摘要 + 使用计数（memory_usage 聚合）。 */\nexport interface DesktopMemoryDetailResult {\n\t/** 所选修订内容；memory.currentRevision 仍是库内真实当前修订。 */\n\tmemory: MemoryDto;\n\t/** 当前修订号。 */\n\tcurrentRevision: number;\n\t/** 实际展示的修订号。 */\n\tselectedRevision: number;\n\t/** 所选修订早于当前修订时 true。 */\n\tisHistorical: boolean;\n\t/** 历史修订只读；查看当前版后可继续执行变更。 */\n\treadOnly: boolean;\n\t/** 全部修订时间线（includeHistory）。 */\n\trevisions: MemoryRevision[];\n\t/** 所选修订的来源摘要（含已删除/未封存的来源标记）。 */\n\tsources: GetMemoryResult[\"sourceSummaries\"];\n\t/** 替代关系链（当前修订→被替代修订→更早…）。 */\n\tsupersessionChain: GetMemoryResult[\"supersessionChain\"];\n\t/** 使用计数：按 memory_usage.action 聚合的注入/展开/明确引用次数。 */\n\tusageSummary: {\n\t\tsearch: number;\n\t\tinject: number;\n\t\texpand: number;\n\t\tused: number;\n\t};\n}\n\n// ── readDesktopMemoryUsage ───────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryUsageInput extends DesktopMemoryHomeInput {\n\t/** 已由宿主解析的可信范围；task/session 可选，用于收窄事件归因。 */\n\tscope: DesktopMemoryScope;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n}\n\nexport interface DesktopMemoryUsageCounts {\n\tsearch: number;\n\tinject: number;\n\texpand: number;\n\tused: number;\n}\n\nexport interface DesktopMemoryUsageEvent {\n\tid: number;\n\t/** 保留原始动作：search/inject/expand/used。 */\n\taction: MemoryUsageAction;\n\tmemoryId: string;\n\trevision: number;\n\tcreatedAt: string;\n\trequestId?: string;\n\tusageRef?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n}\n\nexport interface ReadDesktopMemoryUsageResult {\n\titems: DesktopMemoryUsageEvent[];\n\t/** 同一可信范围和事件筛选条件下的精确事件总数。 */\n\ttotal: number;\n\tpage: number;\n\tpageSize: number;\n\thasMore: boolean;\n\t/** 同一筛选条件下按动作聚合的计数，不受当前页限制。 */\n\tcounts: DesktopMemoryUsageCounts;\n\t/** 是否实际记录了明确采用；inject/search/expand 不推导成 used。 */\n\tusedRecorded: boolean;\n}\n\n// ── 项目背景 ─────────────────────────────────────────────────────────────\n\n/** 只读项目背景；身份由可信宿主解析后传入，不在内核层猜 cwd。 */\nexport interface ReadDesktopProjectContextInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n\tprojectRoot: string;\n\t/** 指定一份临时计划详情；缺省读取项目内全部计划。 */\n\tplanId?: string;\n}\n\n/**\n * 用户从记忆页明确修改项目目标。只收文本；正式文档、阶段来源、项目身份、\n * 来源 ID、确认态和捕获时间都由宿主或内核按当前正本解析。\n */\nexport interface RecordDesktopProjectGoalChangeInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n\tprojectRoot: string;\n\tuserId: string;\n\tconclusion: string;\n\tconditions?: string;\n\trationale?: string;\n}\n\n/** 任务接续只按可信项目身份列举；具体任务差异由既有读取入口逐项回查。 */\nexport interface ReadDesktopTaskContinuationsInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n}\n\nexport interface ReadDesktopTaskContinuationInput extends ReadDesktopTaskContinuationsInput {\n\ttaskId: string;\n}\n\nexport type ReadDesktopTaskContinuationsResult = TaskContinuationPageListResult;\nexport type ReadDesktopTaskContinuationResult = MemoryResult<ReadTaskContinuationOutput>;\n\n// ── 成果（S6-09 记忆页成果区） ───────────────────────────────────────────\n\n/** 成果列表只按可信项目身份列举；身份由宿主解析后传入。 */\nexport interface ReadDesktopArtifactsInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n}\n\nexport interface ReadDesktopArtifactDetailInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n}\n\nexport interface ReadDesktopArtifactVersionInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n\tversionId: string;\n\t/** 文本片段起点（字符偏移；缺省 0）。 */\n\toffset?: number;\n\t/** 单页字符数（缺省 4000，上限 20000）。 */\n\tlimit?: number;\n}\n\nexport interface ReadDesktopArtifactUsesInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n}\n\n/** 版本选择器条目：列表只给定位与预判，不回读内容。 */\nexport interface DesktopArtifactVersionItem {\n\tversionId: string;\n\tseq: number;\n\tcreatedAt: string;\n\toriginTaskId?: string;\n\t/** 登记定位；页面不展开路径细节，只区分 git/managed 形态。 */\n\tlocationKind: ArtifactLocation[\"kind\"];\n\t/** Git 版本给出仓内相对路径（「打开当前文件」用）；受管版本省略——受管副本不属于工作区。 */\n\tlocationPath?: string;\n\tsizeBytes: number;\n\treceiptRef?: string;\n\t/**\n\t * F13（O08）：receipt_ref 前缀 `<verdict>:` 解码后的验证状态\n\t * （pass|fail|not_run|pending_review）；存量无前推行 undefined——页面如实「结果待核」。\n\t */\n\tverificationStatus?: string;\n\t/** 产生来源的会话（有则带上，供页面定位来源会话）。 */\n\tsourceSessionId?: string;\n\t/** 本次登记关联的账本/请求引用（usage_refs）。 */\n\tusageRefs?: string[];\n\t/** 登记来源 ID 列表（生成来源段可跳 sourceEntryId 定位）。 */\n\tsourceIds: string[];\n\t/** 产生来源的会话条目（有则带上，供页面定位来源）。 */\n\tsourceEntryId?: string;\n\t/** 预判是否可回读（受管副本存在/Git 仓可达）；仅提示，实际以 version 回读为准。 */\n\tavailable: boolean;\n\t/** 引用计数（memory/task/use 分类聚合）。 */\n\trefs: Record<ArtifactRefKind, number>;\n}\n\nexport interface DesktopArtifactDetailResult {\n\tartifact: Artifact;\n\tversions: DesktopArtifactVersionItem[];\n}\n\nexport interface DesktopArtifactVersionResult {\n\tartifact: Artifact;\n\tversion: DesktopArtifactVersionItem;\n\t/** 文本化片段；available=false 时为空串。 */\n\tcontent: string;\n\tavailable: boolean;\n\t/** 不可预览原因（二进制/不可解码/定位缺失），不拿工作树文件顶替。 */\n\tunavailableReason?: string;\n\t/** 片段后是否还有内容。 */\n\thasMore: boolean;\n\t/** 下一页原样作为 offset；仅 hasMore=true 时返回。 */\n\tnextOffset?: number;\n}\n\nexport interface DesktopArtifactUseItem {\n\tuseId: string;\n\tversionId: string;\n\ttaskId: string;\n\taction: string;\n\treceiptRef?: string;\n\tcreatedAt: string;\n}\n\nexport interface ReadDesktopArtifactUsesResult {\n\titems: DesktopArtifactUseItem[];\n\ttotal: number;\n\tpage: number;\n\tpageSize: number;\n\thasMore: boolean;\n}\n\n/** 成果列表项：名称/用途/版本可用性/最近验证状态。 */\nexport interface DesktopArtifactListItem {\n\tartifact: Artifact;\n\tversionCount: number;\n\t/** 最新版本的预判可用性与验证回执；无版本时省略。 */\n\tlatestVersion?: DesktopArtifactVersionItem;\n\t/** 全部版本累计使用记录数。 */\n\tuseCount: number;\n}\n\nexport interface ReadDesktopArtifactsResult {\n\titems: DesktopArtifactListItem[];\n}\n\n// ── mutateDesktopMemory ──────────────────────────────────────────────────\n\n/**\n * 页面提交附带的用户标识。聊天 session/entry 字段仅为旧调用兼容；页面操作本身\n * 由 mutateDesktopMemory 生成独立归档来源，不借用旧对话充当本次结论证据。\n */\nexport interface DesktopMemoryOperationSource {\n\tsessionId?: string;\n\tentryId?: string;\n\tuserId?: string;\n}\n\n/** 纠正（页面纠正表单；expectedRevision 冲突返回最新修订不自动重试）。 */\nexport interface DesktopMemoryCorrectOp {\n\top: \"correct\";\n\tid: string;\n\texpectedRevision: number;\n\treplacement: {\n\t\tconclusion: string;\n\t\tconditions?: string;\n\t\trationale?: string;\n\t\tevidenceKind: EvidenceKind;\n\t\tconfirmation: ConfirmationState;\n\t};\n\t/** 页面提交的用户标识；可省略，修正来源由内核按本次页面动作归档。 */\n\tsource?: DesktopMemoryOperationSource;\n\t/** 旧调用兼容字段；纠正修订只关联本次页面操作来源。 */\n\tsourceIds?: string[];\n}\n\n/** 停用/恢复（target=stopped 停用、active 恢复；恢复只切使用状态不复活已纠正内容）。 */\nexport interface DesktopMemorySetUsageOp {\n\top: \"setUsage\";\n\tid: string;\n\texpectedRevision: number;\n\ttarget: MemoryUsageState;\n\tsource?: DesktopMemoryOperationSource;\n}\n\n/** 合并（多选合并；keepId 保留、mergeId 并入；rationale 必填）。 */\nexport interface DesktopMemoryMergeOp {\n\top: \"merge\";\n\tkeepId: string;\n\tkeepExpectedRevision: number;\n\tmergeId: string;\n\tmergeExpectedRevision: number;\n\trationale: string;\n\tsource?: DesktopMemoryOperationSource;\n}\n\n/** 删除预览（不删数据；memoryId 或来源范围至少一项）。 */\nexport interface DesktopMemoryDeletePreviewOp {\n\top: \"deletePreview\";\n\tmemoryId?: string;\n\tsourceId?: string;\n\tsessionId?: string;\n\tentryId?: string;\n\t/** 缺省 retain；include-referencing-memories 只在预览明确展示扩展范围后使用。 */\n\tsharedSourcePolicy?: SharedSourcePolicy;\n}\n\n/** 删除确认（按 preview 返回的对象列表+修订号执行）。 */\nexport interface DesktopMemoryDeleteConfirmOp {\n\top: \"deleteConfirm\";\n\tmemoryIds: string[];\n\trevisions: Record<string, number>;\n\tsource?: DesktopMemoryOperationSource;\n\tsharedSourcePolicy?: SharedSourcePolicy;\n}\n\nexport type DesktopMemoryOp =\n\t| DesktopMemoryCorrectOp\n\t| DesktopMemorySetUsageOp\n\t| DesktopMemoryMergeOp\n\t| DesktopMemoryDeletePreviewOp\n\t| DesktopMemoryDeleteConfirmOp;\n\nexport interface MutateDesktopMemoryInput extends DesktopMemoryHomeInput {\n\top: DesktopMemoryOp;\n}\n\n/** 各 op 的结构化结果（含 revision 冲突信息——error.currentRevision 如实带）。 */\nexport type MutateDesktopMemoryResult =\n\t| ({ op: \"correct\" } & MemoryResult<CorrectMemoryResult>)\n\t| ({ op: \"setUsage\" } & MemoryResult<SetMemoryUsageResult>)\n\t| ({ op: \"merge\" } & MemoryResult<MergeMemoriesResult>)\n\t| ({ op: \"deletePreview\" } & MemoryResult<PreviewMemoryDeletionResult>)\n\t| ({ op: \"deleteConfirm\" } & MemoryResult<DeleteMemoryResult>);\n\n// ── 删除作业读取与续作 ──────────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryDeletionOperationInput extends DesktopMemoryHomeInput {\n\toperationId: string;\n}\n\nexport interface ResumeDesktopMemoryDeletionInput extends DesktopMemoryHomeInput {\n\toperationId: string;\n}\n\n// ── readDesktopMemorySource ──────────────────────────────────────────────\n\nexport interface ReadDesktopMemorySourceInput extends DesktopMemoryHomeInput {\n\tsourceId: string;\n\t/** 当前展开的 memoryId；与 revision 同时提供时，成功回读后记 expand。 */\n\tmemoryId?: string;\n\t/** 当前展开所依据的修订；修订变化后仍保留原修订，不追到新修订。 */\n\trevision?: number;\n\t/** 发起原文展开的真实会话；页面无活动会话时省略。 */\n\tsessionId?: string;\n\t/** 发起原文展开的真实任务；通用浏览或未知时省略。 */\n\ttaskId?: string;\n\t/** 事件锚点；缺省用来源行自身 entryId。 */\n\tentryId?: string;\n\t/** 相对锚点的整数偏移；缺省 0，首次上下文可取负数。 */\n\toffset?: number;\n\t/** 单页事件数；缺省 50，最大 200。 */\n\tlimit?: number;\n}\n\nexport interface ReadDesktopMemorySourceResult {\n\t/** 回读到的事件（结构化数组——页面逐条渲染，不是 JSONL 文本）。 */\n\tevents: ArchivedEvent[];\n\t/** 来源元数据。 */\n\tmetadata: {\n\t\tsourceId: string;\n\t\tsessionId: string;\n\t\tentryId: string;\n\t\teventType: string;\n\t\tsegmentId: string;\n\t\t/** 锚定事件在段内行号（1 起；缺失时不带）。 */\n\t\tlineNo?: number;\n\t\t/** 本次实际窗口首事件行号（1 起；空窗口不带）。 */\n\t\tstartLine?: number;\n\t\t/** 本次实际窗口末事件行号（1 起；空窗口不带）。 */\n\t\tendLine?: number;\n\t\teventCount: number;\n\t};\n\t/** 来源行、锚点与段文件均可读取。 */\n\tavailable: boolean;\n\t/** 来源行/段行/段文件缺失时 true——页面按「已失效」渲染不拿空内容冒充。 */\n\tmissing: boolean;\n\t/** 段是否已封存（gzip 压缩路）。 */\n\tarchived?: boolean;\n\t/** 归档段 ID（archived 时也带回顶层，便于展示）。 */\n\tsegmentId?: string;\n\t/** 当前来源窗口后是否还有事件。 */\n\thasMore: boolean;\n\t/** 下一页原样作为 offset；仅 hasMore=true 时返回。 */\n\tnextOffset?: number;\n}\n\n// ── 成果表只读投影（desktop 层直读，不复制 artifacts.ts 私有映射） ────────\ninterface DesktopArtifactRow {\n\tartifact_id: string;\n\tproject_id: string;\n\tname: string;\n\tpurpose: string;\n\tinputs: string;\n\toutputs: string;\n\tconditions: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface DesktopVersionRow {\n\tversion_id: string;\n\tartifact_id: string;\n\tseq: number;\n\tlocation_json: string;\n\tsize_bytes: number;\n\torigin_task_id: string | null;\n\tsource_ids_json: string;\n\tsource_session_id: string | null;\n\tsource_entry_id: string | null;\n\treceipt_ref: string | null;\n\tusage_refs_json: string;\n\tcreated_at: string;\n}\n\ninterface DesktopRefRow {\n\tversion_id: string;\n\tref_kind: string;\n\towner_id: string;\n}\n\ninterface DesktopUseRow {\n\tuse_id: string;\n\tversion_id: string;\n\ttask_id: string;\n\taction: string;\n\treceipt_ref: string | null;\n\tcreated_at: string;\n}\n\nconst ARTIFACT_VERSION_COLUMNS =\n\t\"version_id, artifact_id, seq, location_json, size_bytes, origin_task_id, source_ids_json, source_session_id, source_entry_id, receipt_ref, usage_refs_json, created_at\";\n\nfunction mapArtifactRow(row: DesktopArtifactRow): Artifact {\n\treturn {\n\t\tartifactId: row.artifact_id,\n\t\tprojectId: row.project_id,\n\t\tname: row.name,\n\t\tpurpose: row.purpose,\n\t\tinputs: row.inputs,\n\t\toutputs: row.outputs,\n\t\tconditions: row.conditions,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\n/** 预判版本可回读性：受管副本存在/Git 仓根可达。仅提示，实际以 resolveArtifactVersion 为准。 */\nfunction artifactVersionAvailable(location: ArtifactLocation): boolean {\n\tif (location.kind === \"managed\") {\n\t\treturn existsSync(join(location.dir, location.file));\n\t}\n\treturn existsSync(location.repoRoot);\n}\n\nfunction mapVersionItem(row: DesktopVersionRow, refs: DesktopRefRow[]): DesktopArtifactVersionItem {\n\tconst location = JSON.parse(row.location_json) as ArtifactLocation;\n\tconst counts: Record<ArtifactRefKind, number> = { memory: 0, task: 0, use: 0 };\n\tfor (const ref of refs) {\n\t\tif (ref.ref_kind === \"memory\" || ref.ref_kind === \"task\" || ref.ref_kind === \"use\") {\n\t\t\tcounts[ref.ref_kind] += 1;\n\t\t}\n\t}\n\tconst decoded = decodeArtifactReceiptRef(row.receipt_ref);\n\tconst usageRefs = JSON.parse(row.usage_refs_json) as string[];\n\treturn {\n\t\tversionId: row.version_id,\n\t\tseq: row.seq,\n\t\tcreatedAt: row.created_at,\n\t\t...(row.origin_task_id === null ? {} : { originTaskId: row.origin_task_id }),\n\t\tlocationKind: location.kind,\n\t\t...(location.kind === \"git\" ? { locationPath: location.path } : {}),\n\t\tsizeBytes: row.size_bytes,\n\t\t// F13：receiptRef 剥离 verdict 前缀（页面拿到的就是干净回执引用）；\n\t\t// verificationStatus 单独透传，无前推行 undefined → 页面显示「有回执/结果待核」。\n\t\t...(decoded.receiptRef === undefined || decoded.receiptRef === \"\"\n\t\t\t? {}\n\t\t\t: { receiptRef: decoded.receiptRef }),\n\t\t...(decoded.verdict === undefined ? {} : { verificationStatus: decoded.verdict }),\n\t\tsourceIds: JSON.parse(row.source_ids_json) as string[],\n\t\t...(row.source_session_id === null ? {} : { sourceSessionId: row.source_session_id }),\n\t\t...(row.source_entry_id === null ? {} : { sourceEntryId: row.source_entry_id }),\n\t\t...(usageRefs.length === 0 ? {} : { usageRefs }),\n\t\tavailable: artifactVersionAvailable(location),\n\t\trefs: counts,\n\t};\n}\n\nfunction readArtifactRow(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tartifactId: string,\n): DesktopArtifactRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at\n\t\t\t FROM artifacts WHERE artifact_id = ?`,\n\t\t)\n\t\t.get(artifactId) as DesktopArtifactRow | undefined;\n}\n\nfunction readVersionRows(store: ReturnType<typeof openMemoryStore>, artifactId: string): DesktopVersionRow[] {\n\treturn store.db\n\t\t.prepare(`SELECT ${ARTIFACT_VERSION_COLUMNS} FROM artifact_versions WHERE artifact_id = ? ORDER BY seq`)\n\t\t.all(artifactId) as unknown as DesktopVersionRow[];\n}\n\nfunction readRefs(store: ReturnType<typeof openMemoryStore>, artifactId: string): DesktopRefRow[] {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT version_id, ref_kind, owner_id FROM artifact_refs WHERE artifact_id = ? ORDER BY ref_kind, owner_id`,\n\t\t)\n\t\t.all(artifactId) as unknown as DesktopRefRow[];\n}\n\nfunction readVersionRowById(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tversionId: string,\n): DesktopVersionRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT ${ARTIFACT_VERSION_COLUMNS} FROM artifact_versions WHERE version_id = ?`)\n\t\t.get(versionId) as DesktopVersionRow | undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 服务借用与装配\n// ════════════════════════════════════════════════════════════════════════\n\nfunction openService(\n\thome: string,\n\tmode: \"readonly\" | \"readwrite\",\n\tdeletionCoordinator?: DeletionSessionCoordinator,\n): MemoryService {\n\tif (typeof home !== \"string\" || home.length === 0) {\n\t\tthrow new DesktopMemoryError(\"PAO_HOME 不能为空\");\n\t}\n\t// 生产检索依赖由 service 从 scope.executionRoot/projectId 与 PAO_HOME 统一解析。\n\treturn openMemoryService({\n\t\tpaoHome: home,\n\t\tmode,\n\t\t...(deletionCoordinator === undefined ? {} : { deletionCoordinator }),\n\t});\n}\n\n/** 库未建（memory.sqlite 不存在）时 openMemoryStore readonly 抛 SQLite 错；\n *  判一下路径存在性，把「库还没建」转成可控分支，不拿裸 SQLite 错当业务结果。 */\nfunction databaseExists(home: string): boolean {\n\treturn existsSync(memoryPaths(home).database);\n}\n\nasync function withService<T>(\n\thome: string,\n\tmode: \"readonly\" | \"readwrite\",\n\trun: (service: MemoryService) => Promise<T>,\n\tdeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<T> {\n\tconst service = openService(home, mode, deletionCoordinator);\n\ttry {\n\t\treturn await run(service);\n\t} finally {\n\t\tawait service.close();\n\t}\n}\n\nconst PAGE_OPERATION_SESSION_ID = \"desktop-page-operations\";\n\ninterface PageOperationIdentity {\n\tsessionId: string;\n\tentryId: string;\n\tuserId?: string;\n\tcapturedAt: string;\n}\n\nfunction createPageOperationIdentity(source?: DesktopMemoryOperationSource): PageOperationIdentity {\n\treturn {\n\t\tsessionId: PAGE_OPERATION_SESSION_ID,\n\t\tentryId: `page-operation-${randomUUID()}`,\n\t\t...(source?.userId === undefined ? {} : { userId: source.userId }),\n\t\tcapturedAt: new Date().toISOString(),\n\t};\n}\n\n/**\n * 把一次已到达公开变更入口的页面动作写成可回读来源。入口本身由宿主用户动作建立，\n * 这里不创建 SessionManager 或聊天，只借用归档段与 sources 表保存本次操作正文。\n */\nfunction archivePageOperation(\n\thome: string,\n\toperation: DesktopMemoryOp[\"op\"] | \"setProjectGoal\",\n\tdetails: Record<string, unknown>,\n\tsource?: DesktopMemoryOperationSource,\n): { sourceId: string; source: PageOperationIdentity } {\n\tconst identity = createPageOperationIdentity(source);\n\tconst archived = archiveProjectOperationSource({\n\t\tpaoHome: home,\n\t\toperation,\n\t\tdetails,\n\t\tsessionId: identity.sessionId,\n\t\tentryId: identity.entryId,\n\t\tcapturedAt: identity.capturedAt,\n\t\t...(identity.userId === undefined ? {} : { userId: identity.userId }),\n\t});\n\treturn { sourceId: archived.sourceId, source: identity };\n}\n\nfunction unavailable(message: string): MemoryError {\n\treturn { code: \"unavailable\", message };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 四个公开函数\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 列表：query+scope+status+kind 过滤 + 分页。\n * - query 非空走 service.searchMemory（双路召回；status/kind 在命中后过滤）。\n * - query 为空按 updatedAt 倒序列举（不经召回——搜索页空态即全部）。\n * - status 过滤缺省时列表仍回全部（页面自己区分显示）；传值才过滤。\n *   注意：service.searchMemory 的 current 模式已滤 stopped/merged/来源排除——\n *   要列 stopped 请传 mode:\"history\" 或走空 query 列举。\n */\nexport async function readDesktopMemoryList(\n\tinput: ReadDesktopMemoryListInput,\n): Promise<MemoryResult<ReadDesktopMemoryListResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Math.max(1, input.page ?? 1);\n\tconst pageSize = Math.min(200, Math.max(1, input.pageSize ?? 50));\n\tconst mode = input.mode ?? \"current\";\n\tconst scope = toMemoryScope(input.scope);\n\t// 库未建 = 还没有任何记忆：返回空列表而非错误（新装桌面没有库也应显示空态）。\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, items: [], total: 0, totalKnown: true, hasMore: false };\n\t}\n\n\tconst query = typeof input.query === \"string\" ? input.query.trim() : \"\";\n\tif (query.length === 0) {\n\t\tconst pageResult = listScopedMemoriesPage(input.home, scope, mode, {\n\t\t\tstatus: input.status,\n\t\t\tkind: input.kind,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\t...pageResult,\n\t\t\ttotalKnown: true,\n\t\t\thasMore: page * pageSize < pageResult.total,\n\t\t};\n\t}\n\n\treturn withService(input.home, \"readonly\", async (service) => {\n\t\t// 召回路只能声明候选窗。过滤后取得下一页探测项即停止；最多扫描 200 条候选。\n\t\tconst required = page * pageSize + 1;\n\t\tlet candidateLimit = Math.min(200, Math.max(page * pageSize, 50));\n\t\tlet search = await service.searchMemory({\n\t\t\tscope,\n\t\t\tquery,\n\t\t\tmode,\n\t\t\tlimit: candidateLimit,\n\t\t\t...(input.status === undefined ? {} : { usageState: input.status }),\n\t\t\t...(input.kind === undefined ? {} : { kind: input.kind }),\n\t\t});\n\t\tif (!search.ok) return search as MemoryResult<ReadDesktopMemoryListResult>;\n\t\tlet filtered = (await hydrateListItems(input.home, search.hits)).filter(\n\t\t\t(item) =>\n\t\t\t\t(input.status === undefined || item.usageState === input.status) &&\n\t\t\t\t(input.kind === undefined || item.kind === input.kind),\n\t\t);\n\t\twhile (filtered.length < required && search.hits.length >= candidateLimit && candidateLimit < 200) {\n\t\t\tconst nextLimit = Math.min(200, Math.max(required, candidateLimit * 2));\n\t\t\tif (nextLimit <= candidateLimit) break;\n\t\t\tcandidateLimit = nextLimit;\n\t\t\tsearch = await service.searchMemory({\n\t\t\t\tscope,\n\t\t\t\tquery,\n\t\t\t\tmode,\n\t\t\t\tlimit: candidateLimit,\n\t\t\t\t...(input.status === undefined ? {} : { usageState: input.status }),\n\t\t\t\t...(input.kind === undefined ? {} : { kind: input.kind }),\n\t\t\t});\n\t\t\tif (!search.ok) return search as MemoryResult<ReadDesktopMemoryListResult>;\n\t\t\tfiltered = (await hydrateListItems(input.home, search.hits)).filter(\n\t\t\t\t(item) =>\n\t\t\t\t\t(input.status === undefined || item.usageState === input.status) &&\n\t\t\t\t\t(input.kind === undefined || item.kind === input.kind),\n\t\t\t);\n\t\t}\n\t\tconst start = (page - 1) * pageSize;\n\t\tconst items = filtered.slice(start, start + pageSize);\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems,\n\t\t\ttotalKnown: false,\n\t\t\tcandidateCount: filtered.length,\n\t\t\tcandidateLimit,\n\t\t\thasMore: filtered.length > page * pageSize,\n\t\t\t...(search.degraded === undefined ? {} : { degraded: search.degraded }),\n\t\t\t...(search.degradeReason === undefined ? {} : { degradeReason: search.degradeReason }),\n\t\t\t...(items.length === 0 && search.emptyReason !== undefined ? { emptyReason: search.emptyReason } : {}),\n\t\t};\n\t});\n}\n\n/** 详情：当前决定 + 修订时间线 + 来源摘要 + 使用计数（memory_usage 聚合）。 */\nexport async function readDesktopMemoryDetail(\n\tinput: ReadDesktopMemoryDetailInput,\n): Promise<MemoryResult<DesktopMemoryDetailResult>> {\n\tif (typeof input.id !== \"string\" || input.id.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"id 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.revision !== undefined && (!Number.isInteger(input.revision) || input.revision < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"revision 必须是正整数\",\n\t\t\t\trefId: input.id,\n\t\t\t} satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(input.home, \"readonly\", async (service) => {\n\t\tconst got = await service.getMemory({\n\t\t\tid: input.id,\n\t\t\tincludeHistory: true,\n\t\t\t...(input.revision === undefined ? {} : { revision: input.revision }),\n\t\t});\n\t\tif (!got.ok) return got as MemoryResult<DesktopMemoryDetailResult>;\n\t\tconst currentRevision = got.memory.currentRevision;\n\t\tconst selectedRevision = input.revision ?? currentRevision;\n\t\tconst isHistorical = selectedRevision !== currentRevision;\n\t\t// 使用计数：detail 需要「这条记忆被参考过几次」；usage 行在库内，\n\t\t// 服务公开接口没有 usage 聚合——本层经 openMemoryStore 的平行引用读\n\t\t// （与 tools.ts 捕获侧同口径，按 PAO_HOME 引用计数共享同一连接）。\n\t\tconst usageSummary = countMemoryUsage(input.home, input.id);\n\t\treturn {\n\t\t\tok: true,\n\t\t\tmemory: got.memory,\n\t\t\tcurrentRevision,\n\t\t\tselectedRevision,\n\t\t\tisHistorical,\n\t\t\treadOnly: isHistorical,\n\t\t\trevisions: got.revisions ?? [],\n\t\t\tsources: got.sourceSummaries,\n\t\t\tsupersessionChain: got.supersessionChain,\n\t\t\tusageSummary,\n\t\t};\n\t});\n}\n\n/** 本任务参考：按可信项目范围及可选 task/session 读取 memory_usage。 */\nexport async function readDesktopMemoryUsage(\n\tinput: ReadDesktopMemoryUsageInput,\n): Promise<MemoryResult<ReadDesktopMemoryUsageResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Number.isInteger(input.page) && (input.page as number) > 0 ? (input.page as number) : 1;\n\tconst pageSize =\n\t\tNumber.isInteger(input.pageSize) && (input.pageSize as number) > 0 ? Math.min(200, input.pageSize as number) : 50;\n\tconst emptyCounts = (): DesktopMemoryUsageCounts => ({ search: 0, inject: 0, expand: 0, used: 0 });\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: [],\n\t\t\ttotal: 0,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t\thasMore: false,\n\t\t\tcounts: emptyCounts(),\n\t\t\tusedRecorded: false,\n\t\t};\n\t}\n\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions = [\n\t\t\t\"json_extract(m.scope_json, '$.projectId') = ?\",\n\t\t\t\"u.action IN ('search', 'inject', 'expand', 'used')\",\n\t\t];\n\t\tconst params: Array<string> = [input.scope.projectId];\n\t\tif (input.scope.taskId !== undefined) {\n\t\t\tconditions.push(\"u.task_id = ?\");\n\t\t\tparams.push(input.scope.taskId);\n\t\t}\n\t\tif (input.scope.sessionId !== undefined) {\n\t\t\tconditions.push(\"u.session_id = ?\");\n\t\t\tparams.push(input.scope.sessionId);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS total\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}`,\n\t\t\t)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT u.id, u.action, u.memory_id, u.revision, u.created_at,\n\t\t\t\t        u.request_id, u.usage_ref, u.task_id, u.session_id\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY u.created_at DESC, u.id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, pageSize, (page - 1) * pageSize) as unknown as Array<{\n\t\t\tid: number;\n\t\t\taction: MemoryUsageAction;\n\t\t\tmemory_id: string;\n\t\t\trevision: number;\n\t\t\tcreated_at: string;\n\t\t\trequest_id: string | null;\n\t\t\tusage_ref: string | null;\n\t\t\ttask_id: string | null;\n\t\t\tsession_id: string | null;\n\t\t}>;\n\t\tconst counts = emptyCounts();\n\t\tconst countRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT u.action, COUNT(*) AS n\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}\n\t\t\t\t GROUP BY u.action`,\n\t\t\t)\n\t\t\t.all(...params) as unknown as Array<{ action: MemoryUsageAction; n: number }>;\n\t\tfor (const row of countRows) counts[row.action] = row.n;\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: rows.map((row) => ({\n\t\t\t\tid: row.id,\n\t\t\t\taction: row.action,\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\t...(row.request_id === null ? {} : { requestId: row.request_id }),\n\t\t\t\t...(row.usage_ref === null ? {} : { usageRef: row.usage_ref }),\n\t\t\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t\t\t...(row.session_id === null ? {} : { sessionId: row.session_id }),\n\t\t\t})),\n\t\t\ttotal: totalRow.total,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t\thasMore: page * pageSize < totalRow.total,\n\t\t\tcounts,\n\t\t\tusedRecorded: counts.used > 0,\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 变更：correct/setUsage/merge/deletePreview/deleteConfirm 五操作走 service 既有入口。\n * revision 冲突如实返回（error.currentRevision 带最新），不自动重试。\n * deletePreview 用 readonly 借用（纯读）；其余写操作用 readwrite。\n * correct/setUsage/merge 先通过既有 archive+sources 入口保存本次用户页面动作；\n * deleteConfirm 只使用本次操作身份，不把被删除正文另写一份操作日志。\n */\nexport async function mutateDesktopMemory(\n\tinput: MutateDesktopMemoryInput,\n\ttrustedDeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<MutateDesktopMemoryResult> {\n\tconst op = input.op;\n\tif (!op || typeof op !== \"object\" || typeof op.op !== \"string\") {\n\t\treturn {\n\t\t\top: \"correct\",\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"op 不能为空\" },\n\t\t} as MutateDesktopMemoryResult;\n\t}\n\t// mutate 走 readwrite：库未建时 createMemory 会建库，但 mutate 只改不建——\n\t// 库不存在即「还没有记忆可改」，返回 unavailable 而非让 SQLite 报裸错。\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\top: op.op,\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t} as MutateDesktopMemoryResult;\n\t}\n\n\tswitch (op.op) {\n\t\tcase \"correct\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"correct\",\n\t\t\t\t{\n\t\t\t\t\tmemoryId: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\treplacement: op.replacement,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.correctMemory({\n\t\t\t\t\tid: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\treplacement: op.replacement,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\t});\n\t\t\t\treturn { op: \"correct\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"setUsage\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"setUsage\",\n\t\t\t\t{\n\t\t\t\t\tmemoryId: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\ttarget: op.target,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.setMemoryUsage({\n\t\t\t\t\tid: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\ttarget: op.target,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\t});\n\t\t\t\treturn { op: \"setUsage\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"merge\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"merge\",\n\t\t\t\t{\n\t\t\t\t\tkeepId: op.keepId,\n\t\t\t\t\tkeepExpectedRevision: op.keepExpectedRevision,\n\t\t\t\t\tmergeId: op.mergeId,\n\t\t\t\t\tmergeExpectedRevision: op.mergeExpectedRevision,\n\t\t\t\t\trationale: op.rationale,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.mergeMemories({\n\t\t\t\t\tkeepId: op.keepId,\n\t\t\t\t\tkeepExpectedRevision: op.keepExpectedRevision,\n\t\t\t\t\tmergeId: op.mergeId,\n\t\t\t\t\tmergeExpectedRevision: op.mergeExpectedRevision,\n\t\t\t\t\trationale: op.rationale,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t});\n\t\t\t\treturn { op: \"merge\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"deletePreview\": {\n\t\t\treturn withService(input.home, \"readonly\", async (service) => {\n\t\t\t\tconst result = await service.previewMemoryDeletion({\n\t\t\t\t\t...(op.memoryId === undefined ? {} : { memoryId: op.memoryId }),\n\t\t\t\t\t...(op.sourceId === undefined ? {} : { sourceId: op.sourceId }),\n\t\t\t\t\t...(op.sessionId === undefined ? {} : { sessionId: op.sessionId }),\n\t\t\t\t\t...(op.entryId === undefined ? {} : { entryId: op.entryId }),\n\t\t\t\t\t...(op.sharedSourcePolicy === undefined ? {} : { sharedSourcePolicy: op.sharedSourcePolicy }),\n\t\t\t\t});\n\t\t\t\treturn { op: \"deletePreview\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"deleteConfirm\": {\n\t\t\tconst pageSource = createPageOperationIdentity(op.source);\n\t\t\treturn withService(\n\t\t\t\tinput.home,\n\t\t\t\t\"readwrite\",\n\t\t\t\tasync (service) => {\n\t\t\t\t\tconst result = await service.deleteMemory({\n\t\t\t\t\t\tmemoryIds: op.memoryIds,\n\t\t\t\t\t\trevisions: op.revisions,\n\t\t\t\t\t\tsource: {\n\t\t\t\t\t\t\tsessionId: pageSource.sessionId,\n\t\t\t\t\t\t\tentryId: pageSource.entryId,\n\t\t\t\t\t\t\t...(pageSource.userId === undefined ? {} : { userId: pageSource.userId }),\n\t\t\t\t\t\t},\n\t\t\t\t\t\t...(op.sharedSourcePolicy === undefined ? {} : { sharedSourcePolicy: op.sharedSourcePolicy }),\n\t\t\t\t\t});\n\t\t\t\t\treturn { op: \"deleteConfirm\", ...result } as MutateDesktopMemoryResult;\n\t\t\t\t},\n\t\t\t\ttrustedDeletionCoordinator,\n\t\t\t);\n\t\t}\n\t\tdefault: {\n\t\t\treturn {\n\t\t\t\top: \"correct\",\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `未知变更操作:${String((op as { op?: unknown }).op)}`,\n\t\t\t\t},\n\t\t\t} as MutateDesktopMemoryResult;\n\t\t}\n\t}\n}\n\n/** 只读聚合当前目标、正式引用、计划、卡与工作流实例。 */\nexport async function readDesktopProjectContext(\n\tinput: ReadDesktopProjectContextInput,\n): Promise<MemoryResult<ProjectContextBrief>> {\n\tif (!databaseExists(input.home)) {\n\t\treturn readProjectContext({\n\t\t\tpaoHome: input.home,\n\t\t\tprojectId: input.projectId,\n\t\t\tprojectRoot: input.projectRoot,\n\t\t\t...(input.planId === undefined ? {} : { planId: input.planId }),\n\t\t});\n\t}\n\treturn withService(input.home, \"readonly\", (service) =>\n\t\treadProjectContext({\n\t\t\tpaoHome: input.home,\n\t\t\tprojectId: input.projectId,\n\t\t\tprojectRoot: input.projectRoot,\n\t\t\t...(input.planId === undefined ? {} : { planId: input.planId }),\n\t\t\tmemoryService: service,\n\t\t}),\n\t);\n}\n\n/**\n * 列当前项目的任务接续。项目内 taskId 来自接续表，正文和现场差异由既有\n * readTaskContinuation 逐项回查；单个任务失败仍保留在 items 中。\n */\nexport async function readDesktopTaskContinuations(\n\tinput: ReadDesktopTaskContinuationsInput,\n): Promise<MemoryResult<ReadDesktopTaskContinuationsResult>> {\n\treturn listTaskContinuationsForProject({\n\t\tpaoHome: input.home,\n\t\tprojectId: input.projectId,\n\t});\n}\n\n/** 按当前项目读取一条任务接续详情；只读，不迁移或改写历史路径。 */\nexport async function readDesktopTaskContinuation(\n\tinput: ReadDesktopTaskContinuationInput,\n): Promise<ReadDesktopTaskContinuationResult> {\n\treturn readTaskContinuationForPage({\n\t\tpaoHome: input.home,\n\t\tprojectId: input.projectId,\n\t\ttaskId: input.taskId,\n\t});\n}\n\n/**\n * 成果列表（S6-09）：按可信项目身份列举成果条目。\n * 库未建返回空列表；列表只给版本可用性预判与计数，不回读内容。\n */\nexport async function readDesktopArtifacts(\n\tinput: ReadDesktopArtifactsInput,\n): Promise<MemoryResult<ReadDesktopArtifactsResult>> {\n\tif (typeof input.projectId !== \"string\" || input.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, items: [] };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at\n\t\t\t\t FROM artifacts WHERE project_id = ? ORDER BY updated_at D