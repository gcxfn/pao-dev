\tevent.onConfirmedShutdown?.(() => releaseBackgroundHost(ctx.sessionManager, background));\n\t});\n\tregister(\"worker\", () => {\n\t\tconst worker = registerWorkerTools(pi, {\n\t\t\tverificationCommandRunner: options.verificationCommandRunner,\n\t\t\trunner,\n\t\t\thost,\n\t\t\tresolveCardsDir,\n\t\t\tresolvePaoHome: paoHome,\n\t\t\tnotifySurface,\n\t\t\tonBackgroundChange: () => background.changed(),\n\t\t\tworktreeHost: primaryWorktreeHost(),\n\t\t\tworkflow: workerWorkflowPort,\n\t\t\tresolveSupervisionRoute,\n\t\t\tresolveMemoryReferences: () => sessionMemory(pi).selectedReferences(),\n\t\t});\n\t\tbackground.trackWorker(worker);\n\t\tteardown.add(\"worker-tools\", () => worker.dispose());\n\t});\n\t// 主控/部长使用通用简报、地图和契约工具；worker 只获得把侦察结论交回当前\n\t// attempt 的最小保存面。两处都惰性注册，保持既有角色装载边界。\n\tif (role === \"worker\") {\n\t\tregister(\"worker-result\", () => registerWorkerResultTool(pi));\n\t\tregister(\"dispatch-recon\", () => registerDispatchReconTool(pi));\n\t\t// worker 注入接收面（批3a）：激活 stdio[3] IPC，proc.send→本端落成真实 user 消息→ack。\n\t\tregister(\"worker-inject\", () => registerWorkerInject(pi));\n\t} else {\n\t\tregister(\"dispatch-brief\", () =>\n\t\t\tregisterDispatchBriefTools(pi, {\n\t\t\t\tresolveCardsDir,\n\t\t\t\tonReferenceImpact: async (impact) => {\n\t\t\t\t\tawait reconcileDispatchReferenceImpact({\n\t\t\t\t\t\trunner,\n\t\t\t\t\t\timpact,\n\t\t\t\t\t\tnotify: ({ body, toastBody }) => notifySurface.notify(body, \"PAO dispatch 输入升版\", toastBody),\n\t\t\t\t\t});\n\t\t\t\t},\n\t\t\t}),\n\t\t);\n\t}\n\tregister(\"worktrees\", () => {\n\t\tif (!installedWorktreeHost.host) throw new Error(installedWorktreeHost.reason);\n\t\tregisterWorktreeTools(pi, {\n\t\t\thost: installedWorktreeHost.host,\n\t\t\towner: pi,\n\t\t\tresolveProjectRoot: () => resolveProjectRoot(),\n\t\t\tisExecutionActive: ({ executionRoot }) =>\n\t\t\t\texecutionRoot ? runner.isExecutionActive(executionRoot) : \"unknown\",\n\t\t});\n\t});\n\tregister(\"cleanup\", () => registerCleanupTools(pi, { resolveCardsDir }));\n\tregister(\"healthcheck\", () => registerHealthcheck(pi));\n\t// 记忆供应商管理器先声明后填:knowledge 在 memory 之前注册,vendorRecall 闭包引用它,\n\t// 两模块共享同一实例(同一次惰性启动、同一份降级状态,不双拉供应商子进程)。\n\t// builtin 配置时 manager 为 undefined——查库召回/常驻自动召回都依赖供应商实例,\n\t// 如实保持未启用(S3/S4 阶段再接到 searchMemory)。\n\tlet memoryManager: MemoryVendorManager | undefined;\n\tlet builtinMemoryRegistration: BuiltinMemoryRegistration | undefined;\n\tlet builtinMemorySourceStore: ReturnType<typeof openMemoryStore> | undefined;\n\t// 内置记忆服务收尾(builtin 配置时由 register(\"memory\") 填)：卸载采集＋关服务。\n\tlet builtinMemoryClose: (() => Promise<void>) | undefined;\n\tconst memorySourceStore = (): ReturnType<typeof openMemoryStore> => {\n\t\tbuiltinMemorySourceStore ??= openMemoryStore(paoHome(), \"readwrite\");\n\t\treturn builtinMemorySourceStore;\n\t};\n\tconst resolveExecutionEvidence = (verificationSource: string, department?: string) =>\n\t\tmatchExecutionEvidence(listCards(resolveCardsDir()), verificationSource, department);\n\tconst knowledgeMemory = (): KnowledgeMemoryRuntime | undefined => {\n\t\tconst registration = builtinMemoryRegistration;\n\t\tif (!registration?.service.opened) return undefined;\n\t\treturn {\n\t\t\tservice: registration.service,\n\t\t\tscope: (ctx, department) => ({\n\t\t\t\t...scopeFromContext(ctx, paoHome()),\n\t\t\t\t...(department === undefined ? {} : { department }),\n\t\t\t}),\n\t\t\tregisterSource: (input) => {\n\t\t\t\t// 同 PAO_HOME 的 store 引用只用于登记来源；与 builtin service 共享同一条 SQLite 连接。\n\t\t\t\treturn registerSource(memorySourceStore().db, input);\n\t\t\t},\n\t\t\tresolveExecutionEvidence,\n\t\t\tarchiveSource: (input) => {\n\t\t\t\tconst store = memorySourceStore();\n\t\t\t\tconst existing = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT source_id FROM sources\n\t\t\t\t\t\t WHERE session_id = ? AND entry_id = ? AND event_type = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(input.sessionId, input.entryId, input.eventType) as { source_id: string } | undefined;\n\t\t\t\tif (existing) {\n\t\t\t\t\tconst source = getSource(store.db, existing.source_id);\n\t\t\t\t\tif (source?.segmentId && source.location) {\n\t\t\t\t\t\treturn { sourceRef: source.sourceId, segmentId: source.segmentId, location: source.location };\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tconst event: ArchivedEvent = {\n\t\t\t\t\tv: 1,\n\t\t\t\t\tsessionId: input.sessionId,\n\t\t\t\t\tentryId: input.entryId,\n\t\t\t\t\tentryType: \"receipt\",\n\t\t\t\t\teventType: input.eventType,\n\t\t\t\t\ttimestamp: input.timestamp,\n\t\t\t\t\tcapturedAt: input.capturedAt,\n\t\t\t\t\tcontent: redactContext(input.content),\n\t\t\t\t};\n\t\t\t\tconst appended = appendToOpenSegment(store.db, paoHome(), input.sessionId, event, input.capturedAt);\n\t\t\t\tconst location = `${appended.segmentId}#${appended.lineNo}`;\n\t\t\t\tconst sourceRef = registerSource(store.db, {\n\t\t\t\t\tsessionId: input.sessionId,\n\t\t\t\t\tentryId: input.entryId,\n\t\t\t\t\teventType: input.eventType,\n\t\t\t\t\tlocation,\n\t\t\t\t\tsegmentId: appended.segmentId,\n\t\t\t\t\tcapturedAt: input.capturedAt,\n\t\t\t\t});\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\"UPDATE sources SET segment_id = ?, location = ?, captured_at = ? WHERE source_id = ?\")\n\t\t\t\t\t.run(appended.segmentId, location, input.capturedAt, sourceRef);\n\t\t\t\treturn { sourceRef, segmentId: appended.segmentId, location };\n\t\t\t},\n\t\t};\n\t};\n\n\t// F11（O08）挂点 A/B 的登记闭包。cards/delivery 注册先于 memory——不能在装配期\n\t// 硬取服务，deps.registration 在工具执行时才解引用 builtinMemoryRegistration；\n\t// 记忆未启用或尚未就绪时回调返回 undefined（如实跳过），不阻断回执/交卷落定。\n\t// 业务实现集中在 memory/artifact-registration.ts（测试直接驱动同一份代码）。\n\tconst artifactRegistrationDeps = {\n\t\tregistration: () => builtinMemoryRegistration,\n\t\tpi,\n\t\tpaoHome,\n\t};\n\tconst registerReceiptArtifacts = makeRegisterReceiptArtifacts(artifactRegistrationDeps);\n\tconst registerDeliveryArtifacts = makeRegisterDeliveryArtifacts(artifactRegistrationDeps);\n\tregister(\"knowledge\", () =>\n\t\tregisterKnowledgeTools(pi, {\n\t\t\tafterInspect: patrolAfterInspect(paoHome, resolveCardsDir),\n\t\t\tmemory: knowledgeMemory,\n\t\t\t// 查库时按 memory 模块的实际注册结果判断旧供应商接缝；builtin 或未配置时保持未接。\n\t\t\tresolveVendorRecall: () => (memoryManager ? createVendorRecall(() => memoryManager) : undefined),\n\t\t}),\n\t);\n\t// §21 后台区:/pao status 读 fanout 会话级运行态计数(在途/完成未读;R25 重启归零)。\n\t// 惰性闭包取——fanout 未注册/注册失败时 /pao status 如实显示「未接入」,不互相拖垮。\n\tlet fanoutBackgroundCount: (() => FanoutBackgroundState) | undefined;\n\tregister(\"fanout\", () => {\n\t\tconst fanout = registerFanout(pi, {\n\t\t\tnotifySurface,\n\t\t\tonBackgroundChange: () => background.changed(),\n\t\t\tresolveCardsDir,\n\t\t\trunner,\n\t\t\tresolvePaoHome: paoHome,\n\t\t\tworktreeHost: primaryWorktreeHost(),\n\t\t\tworktreeTarget: { kind: \"primary\" },\n\t\t\tworkflow: workerWorkflowPort,\n\t\t\tonReceipt: async (card, receipt) => {\n\t\t\t\tif (runner.isStopped()) return;\n\t\t\t\tconst route = workflowSupervision.resolveRoute(card, {\n\t\t\t\t\tcardNo: String(card.card_no),\n\t\t\t\t\tcardsDir: dirname(card.path),\n\t\t\t\t\toperator: \"主控\",\n\t\t\t\t\townerSession: ownerSessionId,\n\t\t\t\t\tgoal: card.frontmatter.goal ?? \"\",\n\t\t\t\t});\n\t\t\t\tif (!route) return;\n\t\t\t\tconst minister = host.hotSession(route.department, route.projectRoot, route.context);\n\t\t\t\tif (!minister || minister.会话标识 !== route.sessionId)\n\t\t\t\t\tthrow new Error(\"扇出回执的绑定部长当前不在线或会话已变更\");\n\t\t\t\tconst result = await host.inject(\n\t\t\t\t\troute.department,\n\t\t\t\t\troute.projectRoot,\n\t\t\t\t\t[\n\t\t\t\t\t\t`[工人回执] 卡${card.card_no} 尝试${receipt.attempt}：${receipt.status}`,\n\t\t\t\t\t\t`摘要：${receipt.summary}`,\n\t\t\t\t\t\t`卡面：${card.path}`,\n\t\t\t\t\t\t`证据：${receipt.evidence_path}`,\n\t\t\t\t\t\t\"回执已落卡，请核对目标、机械验收与证据后处理；自报成功不等于已交付。\",\n\t\t\t\t\t].join(\"\\n\"),\n\t\t\t\t\troute.context,\n\t\t\t\t\t\"followUp\",\n\t\t\t\t);\n\t\t\t\tif (!result.ok) throw new Error(result.原因 ?? \"扇出回执投递未受理\");\n\t\t\t},\n\t\t});\n\t\tfanoutBackgroundCount = fanout.backgroundCount;\n\t\tbackground.trackFanout(fanout);\n\t});\n\t// 宿主接线(S2 收口):拉起/散场部长会话工具＋通知面/保险丝钩(主控专有——role.ts 跳过清单门控)。\n\t// 每个扩展实例独占宿主，桌面多会话不会覆盖通知或停止彼此的部长。\n\tregister(\"host\", () => registerHostTools(pi, { host, notifySurface, resolveContext: () => ownerSessionId }));\n\n\t// 用量页脚(§15):两角色都装——worker 会话(json 模式)里 setStatus 无处渲染时自然无感。\n\t// 返回的解绑函数登记进装配清理袋(S5-4):半装配失败时撤掉这 8 个 pi.on,不留订阅。\n\t// 跨会话落账(M2-04 尾):session_shutdown 把本会话累计写进 用量账.jsonl(纯追加一行);\n\t// 全角色都落(行带角色字段);落账失败如实缺账不炸退出流程(崩溃会话本来就不落账)。\n\tconst unbindUsageFooter = criticalValue(\"usage-footer\", () =>\n\t\tregisterUsageFooter(pi, {\n\t\t\tonShutdown: (state, sessionStartIso) => {\n\t\t\t\ttry {\n\t\t\t\t\tappendLedgerRow(paoHome(), buildLedgerRow(state, role, sessionStartIso));\n\t\t\t\t} catch (error) {\n\t\t\t\t\tlogWarn(\n\t\t\t\t\t\t`[pao] 用量账落账失败(本会话账如实缺账):${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t},\n\t\t}),\n\t);\n\tteardown.add(\"usage-footer\", unbindUsageFooter);\n\n\t// 巡库 shell 护栏(§6 预案①第二道防线):顶层注册不进任何被跳过的模块,三角色同装;\n\t// 只有派发链对巡库卡注入了 PAO_SHELL_GUARD_WORKSPACE 时才挂 tool_call 门禁,其余零行为。\n\tcritical(\"shell-guard\", () => registerShellGuard(pi));\n\n\tregister(\"verifier\", () =>\n\t\tregisterVerifierTools(pi, {\n\t\t\tresolveCardsDir,\n\t\t\tverificationCommandRunner: options.verificationCommandRunner,\n\t\t}),\n\t);\n\tregister(\"delivery\", () => {\n\t\tregisterDeliveryTools(pi, {\n\t\t\tresolveCardsDir,\n\t\t\t// F11 挂点 B：惰性闭包——delivery 注册先于 memory，执行时才取服务。\n\t\t\tregisterDeliveryArtifacts: async (input) => registerDeliveryArtifacts(input),\n\t\t});\n\t\tregisterIntegrationTools(pi, {\n\t\t\tresolveCardsDir,\n\t\t\tresolveProjectRoot,\n\t\t\tacquireWriteLock: acquireIntegrationWriteLock,\n\t\t\tresolveOperator: () =>\n\t\t\t\trole === \"主控\" ? \"主控\" : role === \"部长\" ? process.env.PAO_DEPT?.trim() || undefined : undefined,\n\t\t});\n\t});\n\tregister(\"workflow\", () => {\n\t\tconst workflow = registerWorkflowTools(pi, {\n\t\t\tverificationCommandRunner: options.verificationCommandRunner,\n\t\t\trunner,\n\t\t\tresolveOwnerSessionId: () => ownerSessionId,\n\t\t\tresolveRunMode,\n\t\t\tdriveDepartments: (recipe, driverOptions) => workflowBridge.drive(recipe, driverOptions),\n\t\t\tresolvePaoHome: paoHome,\n\t\t\tresolveCardsDir,\n\t\t\tresolveWorkspaceDir: () => dirname(resolveCardsDir()),\n\t\t\tresolveProjectRoot,\n\t\t\tnotifySurface,\n\t\t\tonBackgroundChange: () => background.changed(),\n\t\t\t...(installedWorktreeHost.host\n\t\t\t\t? {\n\t\t\t\t\t\tworktreeHost: installedWorktreeHost.host,\n\t\t\t\t\t\tworktreeTarget: { kind: \"primary\" as const },\n\t\t\t\t\t}\n\t\t\t\t: {}),\n\t\t});\n\t\tbackground.trackWorkflow(workflow);\n\t});\n\t// 记忆供应商(§18.5)或内置记忆(供应商=\"builtin\"):配置缺失静默不装,配置坏警告降级;\n\t// 供应商子进程/内置服务随 session_shutdown 收尾。\n\tpi.on(\"before_agent_start\", () => {\n\t\tsessionMemory(pi).beginTurn();\n\t});\n\tregister(\"memory\", () => {\n\t\tconst registration = registerMemory(pi, { resolvePaoHome: paoHome });\n\t\tif (registration instanceof MemoryVendorManager) {\n\t\t\tmemoryManager = registration;\n\t\t} else if (registration) {\n\t\t\tbuiltinMemoryRegistration = registration;\n\t\t\tbuiltinMemoryClose = registration.close;\n\t\t}\n\t\t// S5-1/S5-2:记忆是可选能力,缺配置＝显式降级(不是失败)——登记原因,普通任务照常可用。\n\t\tif (!registration)\n\t\t\ttracker.noteDegraded({\n\t\t\t\tmodule: \"memory\",\n\t\t\t\tcapability: \"memory\",\n\t\t\t\tlevel: \"optional\",\n\t\t\t\tsource: \"记忆供应商.json\",\n\t\t\t\treason: \"未配置或未启用记忆供应商，将按无记忆路径执行\",\n\t\t\t});\n\t});\n\t// 记忆是可选能力,但清理失败不能因「可选」被吞:装配半途失败时仍要关闭已启动的\n\t// 供应商管理器/内置服务,关闭异常汇进 cleanup 报告(§11.3「记忆清理失败必须暴露并保留可重试资源」)。\n\tteardown.add(\"memory-source-store\", () => {\n\t\tbuiltinMemorySourceStore?.close();\n\t\tbuiltinMemorySourceStore = undefined;\n\t});\n\tteardown.add(\"memory-vendor\", async () => {\n\t\tconst manager = memoryManager;\n\t\tif (manager) await manager.close();\n\t\tconst closeBuiltin = builtinMemoryClose;\n\t\tif (closeBuiltin) await closeBuiltin();\n\t});\n\n\t// §18.1 事实层门面(主控专用,角色跳过清单门控):常驻索引 MEMORY.md 每轮注入＋\n\t// 自动召回（缺省关）；旧「自动交接」字段只兼容读取，不会写共享事实库。\n\t// 与 memory 模块共享同一管理器闭包——不再拉第二份供应商子进程。\n\tregister(\"resident\", () => {\n\t\tregisterResidentMemory(pi, { resolvePaoHome: paoHome, getManager: () => memoryManager });\n\t});\n\t// S5-04/05/06/07：已有 project-context/task-continuation 的生命周期与用户目标命令接线。\n\t// 打开与切树只恢复绑定；背景读取、接续保存仍由既有正本模块完成。\n\tif (role !== \"worker\") {\n\t\tcritical(\"project-session\", () => {\n\t\t\tconst projectSessionOptions = {\n\t\t\t\tresolvePaoHome: () => {\n\t\t\t\t\ttry {\n\t\t\t\t\t\treturn paoHome();\n\t\t\t\t\t} catch {\n\t\t\t\t\t\treturn undefined;\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\tresolveMemoryService: () =>\n\t\t\t\t\tbuiltinMemoryRegistration?.service.opened ? builtinMemoryRegistration.service : undefined,\n\t\t\t\tresolveCardsDir,\n\t\t\t\tresolveScope: scopeFromContext,\n\t\t\t};\n\t\t\tregisterProjectSession(pi, projectSessionOptions);\n\t\t\tregisterProjectGoalCommand(pi, projectSessionOptions);\n\t\t});\n\t}\n\n\t// 品牌指示器:干活时的加载动画由默认盲文点阵换成 pao 字母循环\n\t// (三色帧与字标同源,内嵌 ANSI 真彩;结束码只复位前景色不炸外层着色)。\n\t// 走扩展 API 官方口子 ctx.ui.setWorkingIndicator(事件处理器第二参 ctx),\n\t// 自定义帧原样渲染,不改上游文件,rebase 零负担。\n\tpi.on(\"session_start\", (_event, ctx) => {\n\t\tctx.ui.setWorkingIndicator({\n\t\t\tframes: [...BRAND_SPINNER_FRAMES],\n\t\t\tintervalMs: BRAND_SPINNER_INTERVAL_MS,\n\t\t});\n\t});\n\n\t// TUI 面板渲染器(美化·一批):5 个 customType 消息换统一彩色面板组件,\n\t// 文案零改动——纯展示层,renderer 抛错上游自动回落默认渲染。\n\t// 全角色注册(json 模式永不调用,零成本);worker 不例外,保持接线简单。\n\tcritical(\"pao-panels\", () => registerPaoPanels(pi));\n\n\tregister(\"dept\", () => {\n\t\tregisterDeptTools(pi, { paoHome: undefined }); // 缺省在渲染/执行时读环境变量\n\t});\n\t// §21 /pao status 先行区（任务＋部门）:纯读聚合,数据源与 /pao queue 同源;主控/部长装,worker 跳过。\n\t// §16.1 首跑清单随 status 模块同口径注册:session_start 显示一次今日待办（同出口详情=/pao status）。\n\tregister(\"status\", () => {\n\t\tregisterStatusCommand(pi, { resolvePaoHome: paoHome, 后台计数: () => fanoutBackgroundCount?.() });\n\t\tregisterFirstRun(pi, { resolvePaoHome: paoHome });\n\t});\n\tregister(\"tiers\", () => {\n\t\tregisterTiers(pi);\n\t});\n\t// H0-B 总预算人工巡检（/pao budget）：**只挂命令面,绝不挂 worker 工具面**——\n\t// 这条命令能改钱账（把停着的预留放回额度），交给 agent 自己能调等于让它自己提额度。\n\t// worker 角色整模块跳过（role.ts WORKER_SKIPPED_MODULES），agent 连这条路都看不见。\n\tregister(\"budget-command\", () => {\n\t\tregisterBudgetCommand(pi, { resolvePaoHome: paoHome });\n\t}); // §22 /pao model 档位化(原 /model 接管,2026-10-03 命令统一迁入 pao 子命令路由;\n\t// TUI 薄改道已回退,原生 /model 回归物理模型直选)。主控/部长装;worker 不装\n\t// (json 模式无处敲命令,装载面保持纯干活零命令——loadout-role 钉住)。\n\t// 独立注册不随 tiers 连坐:命令本身零配置依赖,缺 PAO_HOME/坏档位.json 由\n\t// handler 内兜底报错(2026-10-03 真机教训:裸起无 PAO_HOME,tiers 注册抛错把\n\t// 本命令连坐跳过,/model 落回原生选择器)。\n\tif (role !== \"worker\") register(\"model-command\", () => registerModelCommand(pi));\n\t// 全景聚合＋部门/worker 钻取（三批,原 /全景 → /pao pano）:五区一屏纯读＋TUI 钻取循环\n\t// （select/实时页）;主控/部长装,worker 不装（与 status 同口径）。数据源全复用:\n\t// renderAllQueues/firstrun 扫法/deptBacklogSnapshot/fanout 后台计数/usage 账/listActive 实时尾巴。\n\tif (role !== \"worker\")\n\t\tregister(\"panorama\", () =>\n\t\t\tregisterPanorama(pi, {\n\t\t\t\tresolvePaoHome: paoHome,\n\t\t\t\t后台计数: () => fanoutBackgroundCount?.(),\n\t\t\t\tgetRunner: () => runner,\n\t\t\t}),\n\t\t);\n\t// /pao 总入口（命令统一 2026-10-03 用户拍板:中文命令名全删,唯一扩展命令 pao＋\n\t// 英文子命令路由,见 command-router.ts）。裸 /pao 开面板（panel/index.ts）;\n\t// queue/status/pano/flow/collab/model 由各模块 addPaoSubcommand 挂表——模块被\n\t// 角色跳过清单跳过即子命令缺席,天然角色门控,与旧「模块不注册命令」同语义。\n\t// worker 不装:装载面保持零命令。注册放最后:子命令表在命令调用时才查,与\n\t// 各模块注册顺序无关,但放尾部让接线图读起来「入口殿后」。\n\tif (role !== \"worker\")\n\t\tregister(\"pao-command\", () =>\n\t\t\tregisterPaoCommand(pi, (pi2, ctx) => openPaoPanel(pi2, ctx, { resolvePaoHome: paoHome })),\n\t\t);\n\t// 控制权身份须覆盖其他业务关闭处理器；运行期锁最后释放，关闭后迟到请求仍由\n\t// runtime/index.ts 的 check(ctx) 严格拒绝。\n\tcritical(\"runtime-controls\", () => registerRuntimeControls(pi, { resolvePaoHome: paoHome }));\n\n\t// 装配完成自检(§11.3「后续新实例只注册一次」的可观测前提):能力清单要求的模块\n\t// 必须都被装配器见过——漏 register 调用或清单与接线漂移时,这里直接失败而不是\n\t// 静默少装一个能力(旧行为会警告后继续,宿主照常启用会话)。\n\tconst unassembled = [...plan.keys()].filter((module) => !seen.has(module));\n\tif (unassembled.length > 0)\n\t\tthrow new PaoAssemblyFailure({\n\t\t\tmodule: unassembled.join(\",\"),\n\t\t\tsource: \"assembly-manifest\",\n\t\t\treason: \"能力清单要求的模块没有被注册\",\n\t\t});\n\treturn tracker.snapshot();\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆的归档段封存与原文回读（S1-07、S1-08）。\n *\t\t\t\tresolved.set(\n\t\t\t\t\tsource.sourceId,\n\t\t\t\t\tmissing(\n\t\t\t\t\t\t`段 ${key} 读取失败:${error instanceof Error ? error.message : String(error)}`, source.sourceId,\n\t\t\t\t\t),\n\t\t\t\t);\n\t\t\t}\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":457}},{"diffOp":{"equal":{"range":[77,130]}}},{"diffOp":{"delete":{"range":[130,137]}}},{"diffOp":{"equal":{"range":[137,221]}}},{"diffOp":{"delete":{"range":[130,137]}}},{"diffOp":{"insert":{"range":[221,222]}}},{"diffOp":{"equal":{"range":[222,237]}}},{"diffOp":{"delete":{"range":[237,244]}}},{"diffOp":{"equal":{"range":[244,258]}}},{"equalLines":{"line_count":113}},{"diffOp":{"equal":{"range":[258,264]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\archive.ts"},"span":null,"sourceCode":"/**\n * 内置记忆的归档段封存与原文回读（S1-07、S1-08）。\n *\n * 契约：\n * - 段文件位置：`archives/<sessionId>/<segmentId>.jsonl`（未封存，可追加）；\n *   封存后经流式 gzip 发布为 `<file>.jsonl.gz`，数据库 `archive_segments` 行\n *   记录 `original_path`/`compressed_path`/`status`（unsealed/sealed/failed）。\n * - 封存复用 `../shared/evidence.ts` 的压缩原语（临时文件 → gzip → link 发布 →\n *   清理临时副本 → 删除原文）：发布成功的段才删原 JSONL；压缩/发布失败保留原段\n *   并把行标 `failed`，可重试。\n * - 回读按 sourceId → segment → entryId/相对窗口过滤：未封存段直接读 JSONL，\n *   已封存段流式解压；来源行不存在或段文件丢失返回结构化 `source_missing`，\n *   不伪造内容。\n * - 崩溃窗口兜底：UPDATE 行在 evidence 原语删原文之后执行；若进程在两者之间\n *   崩溃，行仍标 unsealed 但 .gz 已发布——回读时原路径缺失会自动回退 `.gz`。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { appendFileSync, createReadStream, existsSync, mkdirSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { createGunzip } from \"node:zlib\";\nimport { archiveWorkerEvidence } from \"../shared/evidence.ts\";\nimport { memoryPaths } from \"./paths.ts\";\nimport { getSource, type SourceRow } from \"./sources.ts\";\nimport type { MemoryError } from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 段行与事件形状\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * archive_segments 表一行。status: unsealed（可追加）/ sealing（封存发布中，\n * 已移出可追加集合）/ sealed（已封存）/ failed（发布失败可重试）。\n */\nexport interface ArchiveSegmentRow {\n\tsegmentId: string;\n\tsessionId: string;\n\toriginalPath: string;\n\tcompressedPath?: string;\n\tstatus: \"unsealed\" | \"sealing\" | \"sealed\" | \"failed\";\n\tcreatedAt: string;\n}\n\ninterface SegmentDbRow {\n\tsegment_id: string;\n\tsession_id: string;\n\toriginal_path: string | null;\n\tcompressed_path: string | null;\n\tstatus: string;\n\tcreated_at: string;\n}\n\nfunction mapSegmentRow(row: SegmentDbRow): ArchiveSegmentRow {\n\treturn {\n\t\tsegmentId: row.segment_id,\n\t\tsessionId: row.session_id,\n\t\toriginalPath: row.original_path ?? \"\",\n\t\tcompressedPath: row.compressed_path ?? undefined,\n\t\tstatus: row.status as ArchiveSegmentRow[\"status\"],\n\t\tcreatedAt: row.created_at,\n\t};\n}\n\n/**\n * 归档段里的一行事件。`content` 是已经过脱敏的允许保存内容（capture.ts 写入前\n * 过 redactContext）；附件块已被替换为受管副本引用，原文不落地。\n */\nexport interface ArchivedEvent {\n\t/** 格式版本。 */\n\tv: 1;\n\tsessionId: string;\n\tentryId: string;\n\t/** 会话条目类型（message/custom_message/…）。 */\n\tentryType: string;\n\t/** 事件类型（user/assistant/toolResult/custom/boundary）。 */\n\teventType: string;\n\t/** 条目自带时间戳（会话持久化的原文时间）。 */\n\ttimestamp: string;\n\t/** 采集时间（夹具注入）。 */\n\tcapturedAt: string;\n\t/** 脱敏后的正文/消息结构。 */\n\tcontent: unknown;\n}\n\n/** readSourceEvents 的成功返回。 */\nexport interface ReadSourceEventsOk {\n\tok: true;\n\t/** 按窗口过滤后的事件（含请求事件与邻近上下文）。 */\n\tevents: ArchivedEvent[];\n\t/** 段 ID。 */\n\tsegmentId: string;\n\t/** 段是否已封存（走解压路）。 */\n\tarchived: boolean;\n\t/** 锚定事件在段内行号（1 起）。 */\n\tlineNo?: number;\n\t/** 当前窗口首事件在段内行号（1 起）。 */\n\tstartLine?: number;\n\t/** 当前窗口末事件在段内行号（1 起）。 */\n\tendLine?: number;\n\t/** 当前来源窗口后是否还有事件。 */\n\thasMore: boolean;\n\t/** 下一页相对锚点的 offset；仅 hasMore=true 时返回。 */\n\tnextOffset?: number;\n}\n\nexport interface ReadSourceEventsErr {\n\tok: false;\n\terror: MemoryError;\n}\n\nexport type ReadSourceEventsResult = ReadSourceEventsOk | ReadSourceEventsErr;\n\n// ════════════════════════════════════════════════════════════════════════\n// 文件系统助手\n// ════════════════════════════════════════════════════════════════════════\n\n/** sessionId 落目录前消毒：会话 ID 可能带路径分隔等非常规字符，不让它逃出 archives/。 */\nfunction safeDirName(value: string): string {\n\tconst cleaned = value.replace(/[^A-Za-z0-9._-]/g, \"_\");\n\treturn cleaned.length > 0 ? cleaned : \"_\";\n}\n\nfunction segmentDir(home: string, sessionId: string): string {\n\treturn join(memoryPaths(home).archives, safeDirName(sessionId));\n}\n\nfunction segmentFilePath(home: string, sessionId: string, segmentId: string): string {\n\treturn join(segmentDir(home, sessionId), `${safeDirName(segmentId)}.jsonl`);\n}\n\n/** 现有文件行数（追加前算新行行号用）。 */\nfunction countLines(path: string): number {\n\tif (!existsSync(path)) return 0;\n\tconst content = readFileSync(path, \"utf8\");\n\tif (content.length === 0) return 0;\n\treturn content.endsWith(\"\\n\") ? content.split(\"\\n\").length - 1 : content.split(\"\\n\").length;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 段查询与创建\n// ════════════════════════════════════════════════════════════════════════\n\n/** 查某会话当前未封存段；无则 undefined。 */\nexport function findOpenSegment(db: DatabaseSync, sessionId: string): ArchiveSegmentRow | undefined {\n\tconst row = db\n\t\t.prepare(\n\t\t\t`SELECT segment_id, session_id, original_path, compressed_path, status, created_at\n\t\t\t FROM archive_segments\n\t\t\t WHERE session_id = ? AND status = 'unsealed'\n\t\t\t ORDER BY created_at DESC LIMIT 1`,\n\t\t)\n\t\t.get(sessionId) as SegmentDbRow | undefined;\n\treturn row ? mapSegmentRow(row) : undefined;\n}\n\nexport function getSegment(db: DatabaseSync, segmentId: string): ArchiveSegmentRow | undefined {\n\tconst row = db\n\t\t.prepare(\n\t\t\t`SELECT segment_id, session_id, original_path, compressed_path, status, created_at\n\t\t\t FROM archive_segments WHERE segment_id = ?`,\n\t\t)\n\t\t.get(segmentId) as SegmentDbRow | undefined;\n\treturn row ? mapSegmentRow(row) : undefined;\n}\n\n/**\n * 取该会话未封存段；没有则建段（行 + 空 JSONL 文件）。\n * 段文件路径写进 original_path；同一 sessionId 重复调用幂等返回既有段。\n */\nexport function openSegmentForSession(\n\tdb: DatabaseSync,\n\thome: string,\n\tsessionId: string,\n\tcreatedAt: string,\n): ArchiveSegmentRow {\n\tconst existing = findOpenSegment(db, sessionId);\n\tif (existing) return existing;\n\tconst segmentId = `seg-${randomUUID()}`;\n\tconst dir = segmentDir(home, sessionId);\n\tmkdirSync(dir, { recursive: true });\n\tconst originalPath = segmentFilePath(home, sessionId, segmentId);\n\tdb.prepare(\n\t\t`INSERT INTO archive_segments (segment_id, session_id, original_path, compressed_path, status, created_at)\n\t\t VALUES (?, ?, ?, NULL, 'unsealed', ?)`,\n\t).run(segmentId, sessionId, originalPath, createdAt);\n\treturn {\n\t\tsegmentId,\n\t\tsessionId,\n\t\toriginalPath,\n\t\tstatus: \"unsealed\",\n\t\tcreatedAt,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// S1-07：追加与封存\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 把一条事件追加到该会话当前未封存段（无段先建）。\n * 返回段 ID 与新行行号（1 起），供 sources.location/segment_id 登记。\n * 调用方保证 event.content 已过脱敏——本函数只做落盘，不再清洗。\n */\nexport function appendToOpenSegment(\n\tdb: DatabaseSync,\n\thome: string,\n\tsessionId: string,\n\tevent: ArchivedEvent,\n\tcreatedAt: string,\n): { segmentId: string; lineNo: number } {\n\tconst segment = openSegmentForSession(db, home, sessionId, createdAt);\n\tconst lineNo = countLines(segment.originalPath) + 1;\n\tappendFileSync(segment.originalPath, `${JSON.stringify(event)}\\n`, \"utf8\");\n\treturn { segmentId: segment.segmentId, lineNo };\n}\n\nexport interface SealSegmentResult {\n\tok: boolean;\n\tsegmentId: string;\n\t/** sealed=压缩发布成功；uncompressed=段太小原样保留；failed=失败可重试。 */\n\toutcome: \"sealed\" | \"uncompressed\" | \"failed\";\n\t/** 已发布的压缩路径（sealed 时）。 */\n\tcompressedPath?: string;\n\t/** 失败/跳过说明（evidence 原语如实上报）。 */\n\twarning?: string;\n}\n\n/**\n * 同段并发封存共用同一 in-flight 结果：第二个调用方拿到同一 Promise，\n * 不会重跑压缩原语；完成后移除，崩溃遗留 sealing 行可再次进入重试。\n */\nconst sealInFlight = new Map<string, Promise<SealSegmentResult>>();\n\n/**\n * 封存一个段：流式 gzip 到临时文件 → 发布 .gz → 更新行 → 原 JSONL 由压缩原语清理。\n * - 进入异步 I/O 前先把行标为 sealing：findOpenSegment 只查 unsealed，\n *   发布期间新采集会另开段，不再把新事件追加进即将删除的原 JSONL；\n * - 发布成功后行标 sealed + compressed_path；\n * - 原语按大小阈值跳过压缩（小段原样保留）时行标 sealed、compressed_path 留空，\n *   回读走 original_path——段不再可追加，语义上同属「已封存」；\n * - 压缩/发布失败：行标 failed、原 JSONL 保留，可重试 sealSegment。\n */\nexport function sealSegment(db: DatabaseSync, _home: string, segmentId: string): Promise<SealSegmentResult> {\n\tconst inflight = sealInFlight.get(segmentId);\n\tif (inflight) return inflight;\n\tconst run = sealSegmentExclusive(db, segmentId);\n\tsealInFlight.set(segmentId, run);\n\trun.then(\n\t\t() => sealInFlight.delete(segmentId),\n\t\t() => sealInFlight.delete(segmentId),\n\t);\n\treturn run;\n}\n\nasync function sealSegmentExclusive(db: DatabaseSync, segmentId: string): Promise<SealSegmentResult> {\n\tconst segment = getSegment(db, segmentId);\n\tif (!segment) {\n\t\treturn { ok: false, segmentId, outcome: \"failed\", warning: `段不存在:${segmentId}` };\n\t}\n\tif (segment.status === \"sealed\") {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tsegmentId,\n\t\t\toutcome: segment.compressedPath ? \"sealed\" : \"uncompressed\",\n\t\t\t...(segment.compressedPath === undefined ? {} : { compressedPath: segment.compressedPath }),\n\t\t};\n\t}\n\t// unsealed/failed → sealing（先移出可追加集合）；sealing 入参为崩溃遗留重试，\n\t// in-flight 去重已保证此处无并发封存者。\n\tif (segment.status !== \"sealing\") {\n\t\tdb.prepare(`UPDATE archive_segments SET status = 'sealing' WHERE segment_id = ?`).run(segmentId);\n\t}\n\tif (!existsSync(segment.originalPath)) {\n\t\t// 原文件都没有：可能是崩溃窗口（.gz 已发布而行未更新）——补登 compressed_path 收尾。\n\t\tconst gzPath = `${segment.originalPath}.gz`;\n\t\tif (existsSync(gzPath)) {\n\t\t\tdb.prepare(`UPDATE archive_segments SET status = 'sealed', compressed_path = ? WHERE segment_id = ?`).run(\n\t\t\t\tgzPath,\n\t\t\t\tsegmentId,\n\t\t\t);\n\t\t\treturn { ok: true, segmentId, outcome: \"sealed\", compressedPath: gzPath };\n\t\t}\n\t\tdb.prepare(`UPDATE archive_segments SET status = 'failed' WHERE segment_id = ?`).run(segmentId);\n\t\treturn { ok: false, segmentId, outcome: \"failed\", warning: `段文件丢失:${segment.originalPath}` };\n\t}\n\n\tconst result = await archiveWorkerEvidence(segment.originalPath);\n\tconst compressed = result.path !== segment.originalPath;\n\tif (result.warning) {\n\t\t// 压缩/发布失败：原语保证原文保留；行标 failed 供重试。\n\t\tdb.prepare(`UPDATE archive_segments SET status = 'failed' WHERE segment_id = ?`).run(segmentId);\n\t\treturn { ok: false, segmentId, outcome: \"failed\", warning: result.warning };\n\t}\n\tdb.prepare(`UPDATE archive_segments SET status = 'sealed', compressed_path = ? WHERE segment_id = ?`).run(\n\t\tcompressed ? result.path : null,\n\t\tsegmentId,\n\t);\n\treturn {\n\t\tok: true,\n\t\tsegmentId,\n\t\toutcome: compressed ? \"sealed\" : \"uncompressed\",\n\t\t...(compressed ? { compressedPath: result.path } : {}),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// S1-08：原文回读\n// ════════════════════════════════════════════════════════════════════════\n\nfunction missing(message: string, refId: string): ReadSourceEventsErr {\n\treturn { ok: false, error: { code: \"source_missing\", message, refId } };\n}\n\n/** 流式解压 .gz 全文（复用 evidence 原语的同款管道形状，按行解析 JSONL）。 */\nasync function readGzipLines(path: string): Promise<string[]> {\n\tconst chunks: Buffer[] = [];\n\tawait new Promise<void>((resolve, reject) => {\n\t\tconst stream = createReadStream(path).pipe(createGunzip());\n\t\tstream.on(\"data\", (chunk: Buffer) => chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)));\n\t\tstream.on(\"end\", resolve);\n\t\tstream.on(\"error\", reject);\n\t});\n\tconst text = Buffer.concat(chunks).toString(\"utf8\");\n\treturn text.split(\"\\n\").filter((line) => line.length > 0);\n}\n\nfunction readPlainLines(path: string): string[] {\n\treturn readFileSync(path, \"utf8\")\n\t\t.split(\"\\n\")\n\t\t.filter((line) => line.length > 0);\n}\n\n/** 段缺失的固定错误（与 readSourceEvents 的段缺失口径一致，供批量回读复用）。 */\nfunction segmentMissingError(segment: ArchiveSegmentRow, refId: string): ReadSourceEventsErr {\n\treturn missing(`段文件缺失:${segment.compressedPath ?? (segment.originalPath || segment.segmentId)}`, refId);\n}\n\n/**\n * 解析未解析的 JSONL 段行，返回与 readSourceEvents 相同的窗口结果。\n * 调用方保证 source/segment 行已核对过；解析与切片分别交给\n * parseSegmentLines 和 windowEventsFromParsed。\n */\nexport function windowEventsFromLines(\n\tsource: { sourceId: string; entryId: string },\n\tsegment: ArchiveSegmentRow,\n\tlines: string[],\n\tarchived: boolean,\n\trange?: { entryId?: string; offset?: number; limit?: number },\n): ReadSourceEventsResult {\n\treturn windowEventsFromParsed(source, segment, parseSegmentLines(lines), archived, range);\n}\n\nfunction parseSegmentLines(lines: string[]): Array<{ event: ArchivedEvent; lineNo: number }> {\n\tconst parsed: Array<{ event: ArchivedEvent; lineNo: number }> = [];\n\tfor (const [index, line] of lines.entries()) {\n\t\ttry {\n\t\t\tparsed.push({ event: JSON.parse(line) as ArchivedEvent, lineNo: index + 1 });\n\t\t} catch {\n\t\t\t// 坏行跳过：JSONL 追加写可能留下半行，不因此丢整段。\n\t\t}\n\t}\n\treturn parsed;\n}\n\nfunction windowEventsFromParsed(\n\tsource: { sourceId: string; entryId: string },\n\tsegment: ArchiveSegmentRow,\n\tparsed: Array<{ event: ArchivedEvent; lineNo: number }>,\n\tarchived: boolean,\n\trange?: { entryId?: string; offset?: number; limit?: number },\n): ReadSourceEventsResult {\n\tconst targetEntryId = range?.entryId ?? source.entryId;\n\tconst anchorIndex = parsed.findIndex(({ event }) => event.entryId === targetEntryId);\n\tif (anchorIndex === -1) {\n\t\treturn missing(`段 ${segment.segmentId} 内无条目 ${targetEntryId} 的事件`, source.sourceId);\n\t}\n\tconst offset = range?.offset ?? 0;\n\tconst limit = Math.min(200, Math.max(1, range?.limit ?? 50));\n\tconst start = Math.min(parsed.length, Math.max(0, anchorIndex + offset));\n\tconst end = Math.min(parsed.length, start + limit);\n\tconst window = parsed.slice(start, end);\n\tconst hasMore = end < parsed.length;\n\treturn {\n\t\tok: true,\n\t\tevents: window.map(({ event }) => event),\n\t\tsegmentId: segment.segmentId,\n\t\tarchived,\n\t\tlineNo: anchorIndex + 1,\n\t\t...(window.length === 0\n\t\t\t? {}\n\t\t\t: {\n\t\t\t\t\tstartLine: window[0].lineNo,\n\t\t\t\t\tendLine: window[window.length - 1].lineNo,\n\t\t\t\t}),\n\t\thasMore,\n\t\t...(hasMore ? { nextOffset: end - anchorIndex } : {}),\n\t};\n}\n\n/**\n * O14：同批多个来源命中同一段时只读一次段文件。\n *\n * 语义与逐条 readSourceEvents 完全一致：来源行不存在 / 段行缺失 / 段文件\n * 缺失 / 段内无锚点事件 → 同样的 source_missing；解压失败按段记录 source_missing。\n * 每段经 parseSegmentLines 解析一次，组内各来源通过 windowEventsFromParsed\n * 定位锚点并切窗口，与 windowEventsFromLines 共用解析和切片实现。\n */\nexport async function readSourceEventsBatch(\n\tdb: DatabaseSync,\n\t_home: string,\n\tsourceIds: string[],\n\toptions: {\n\t\t/** 段读取实现（生产固定走 readSegmentLines；测试可注入计数探针核对按段复用）。 */\n\t\treadSegment?: (segment: ArchiveSegmentRow) => Promise<{ lines: string[]; archived: boolean } | undefined>;\n\t\t/** 各来源的窗口参数（与 readSourceEvents 的 range 同口径；缺省从锚点取 50 条）。 */\n\t\trange?: { entryId?: string; offset?: number; limit?: number };\n\t} = {},\n): Promise<Map<string, ReadSourceEventsResult>> {\n\tconst readSegment = options.readSegment ?? readSegmentLines;\n\tconst early = new Map<string, ReadSourceEventsResult>();\n\tconst bySegment = new Map<string, { segment: ArchiveSegmentRow; sources: SourceRow[] }>();\n\n\tfor (const sourceId of sourceIds) {\n\t\tconst source = getSource(db, sourceId);\n\t\tif (!source) {\n\t\t\tearly.set(sourceId, missing(`来源不存在:${sourceId}`, sourceId));\n\t\t\tcontinue;\n\t\t}\n\t\t// 段定位与 readSourceEvents 同口径：来源行带 segmentId 走它；缺失时退回\n\t\t// 该会话未封存段（早期行可能无段引用）。\n\t\tlet segment: ArchiveSegmentRow | undefined;\n\t\tif (source.segmentId) {\n\t\t\tsegment = getSegment(db, source.segmentId);\n\t\t\tif (!segment) {\n\t\t\t\tearly.set(sourceId, missing(`来源 ${sourceId} 引用的段不存在:${source.segmentId}`, sourceId));\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t} else {\n\t\t\tsegment = findOpenSegment(db, source.sessionId);\n\t\t\tif (!segment) {\n\t\t\t\tearly.set(sourceId, missing(`来源 ${sourceId} 无段引用且会话 ${source.sessionId} 无未封存段`, sourceId));\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t}\n\t\tconst key = segment.segmentId;\n\t\tconst group = bySegment.get(key) ?? { segment, sources: [] };\n\t\tgroup.sources.push(source);\n\t\tbySegment.set(key, group);\n\t}\n\n\t// 每段一次解压/解析，组内逐来源切窗口。段读取失败（含解压失败）如实\n\t// 传染给该段全部来源——与逐条 readSourceEvents 对该段每个来源都抛同样的\n\t// 错是同一结果，不因批量化改变成败语义。\n\tconst resolved = new Map<string, ReadSourceEventsResult>();\n\tfor (const [key, group] of bySegment) {\n\t\tlet data: { lines: string[]; archived: boolean } | undefined;\n\t\ttry {\n\t\t\tdata = await readSegment(group.segment);\n\t\t} catch (error) {\n\t\t\tfor (const source of group.sources) {\n\t\t\t\tresolved.set(\n\t\t\t\t\tsource.sourceId,\n\t\t\t\t\tmissing(\n\t\t\t\t\t\t`段 ${key} 读取失败:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\tsource.sourceId,\n\t\t\t\t\t),\n\t\t\t\t);\n\t\t\t}\n\t\t\tcontinue;\n\t\t}\n\t\tif (data === undefined) {\n\t\t\tfor (const source of group.sources) {\n\t\t\t\tresolved.set(source.sourceId, segmentMissingError(group.segment, source.sourceId));\n\t\t\t}\n\t\t\tcontinue;\n\t\t}\n\t\tconst parsed = parseSegmentLines(data.lines);\n\t\tfor (const source of group.sources) {\n\t\t\tresolved.set(\n\t\t\t\tsource.sourceId,\n\t\t\t\twindowEventsFromParsed(source, group.segment, parsed, data.archived, options.range),\n\t\t\t);\n\t\t}\n\t}\n\n\t// 返回按输入 sourceIds 顺序的结果（先早退错误再按段解析顺序补全）。\n\tconst out = new Map<string, ReadSourceEventsResult>();\n\tfor (const sourceId of sourceIds) {\n\t\tconst value = early.get(sourceId) ?? resolved.get(sourceId);\n\t\tif (value !== undefined) out.set(sourceId, value);\n\t}\n\treturn out;\n}\n\n/**\n * 读取一个段的全部 JSONL 行；文件不存在返回 undefined（不伪造）。\n * 导出供 rebuild-index.ts 的 source_fts 重建逐段回读（封存段解压只在重建时做）。\n */\nexport async function readSegmentLines(\n\tsegment: ArchiveSegmentRow,\n): Promise<{ lines: string[]; archived: boolean } | undefined> {\n\tif (segment.status === \"sealed\" && segment.compressedPath) {\n\t\tif (!existsSync(segment.compressedPath)) return undefined;\n\t\treturn { lines: await readGzipLines(segment.compressedPath), archived: true };\n\t}\n\tif (existsSync(segment.originalPath)) {\n\t\treturn { lines: readPlainLines(segment.originalPath), archived: false };\n\t}\n\t// 崩溃窗口兜底：行还标 unsealed/failed 但 .gz 实际已发布。\n\tconst gzPath = `${segment.originalPath}.gz`;\n\tif (existsSync(gzPath)) {\n\t\treturn { lines: await readGzipLines(gzPath), archived: true };\n\t}\n\treturn undefined;\n}\n\n/**\n * 按 sourceId 回读来源原文。\n *\n * 过滤口径：`entryId`（缺省用来源行自身的 entryId）锚定段内事件；\n * `offset`/`limit` 是相对锚点的邻近窗口（offset=0、limit=1 即只回该事件，\n * offset=-2、limit=5 取前两行到后两行），用于取上下文。\n * 来源行/段行/段文件任一缺失 → `source_missing`，不返回伪造内容。\n */\nexport async function readSourceEvents(\n\tdb: DatabaseSync,\n\t_home: string,\n\tsourceId: string,\n\trange?: { entryId?: string; offset?: number; limit?: number },\n): Promise<ReadSourceEventsResult> {\n\tconst source = getSource(db, sourceId);\n\tif (!source) return missing(`来源不存在:${sourceId}`, sourceId);\n\n\t// 段定位：来源行带 segmentId 走它；缺失时退回该会话未封存段（早期行可能无段引用）。\n\tlet segment: ArchiveSegmentRow | undefined;\n\tif (source.segmentId) {\n\t\tsegment = getSegment(db, source.segmentId);\n\t\tif (!segment) return missing(`来源 ${sourceId} 引用的段不存在:${source.segmentId}`, sourceId);\n\t} else {\n\t\tsegment = findOpenSegment(db, source.sessionId);\n\t\tif (!segment) return missing(`来源 ${sourceId} 无段引用且会话 ${source.sessionId} 无未封存段`, sourceId);\n\t}\n\n\tconst segmentData = await readSegmentLines(segment);\n\tif (!segmentData) {\n\t\treturn missing(`段文件缺失:${segment.compressedPath ?? (segment.originalPath || segment.segmentId)}`, sourceId);\n\t}\n\tconst parsed: Array<{ event: ArchivedEvent; lineNo: number }> = [];\n\tfor (const [index, line] of segmentData.lines.entries()) {\n\t\ttry {\n\t\t\tparsed.push({ event: JSON.parse(line) as ArchivedEvent, lineNo: index + 1 });\n\t\t} catch {\n\t\t\t// 坏行跳过：JSONL 追加写可能留下半行，不因此丢整段。\n\t\t}\n\t}\n\n\tconst targetEntryId = range?.entryId ?? source.entryId;\n\tconst anchorIndex = parsed.findIndex(({ event }) => event.entryId === targetEntryId);\n\tif (anchorIndex === -1) {\n\t\treturn missing(`段 ${segment.segmentId} 内无条目 ${targetEntryId} 的事件`, sourceId);\n\t}\n\tconst offset = range?.offset ?? 0;\n\tconst limit = Math.min(200, Math.max(1, range?.limit ?? 50));\n\tconst start = Math.min(parsed.length, Math.max(0, anchorIndex + offset));\n\tconst end = Math.min(parsed.length, start + limit);\n\tconst window = parsed.slice(start, end);\n\tconst hasMore = end < parsed.length;\n\treturn {\n\t\tok: true,\n\t\tevents: window.map(({ event }) => event),\n\t\tsegmentId: segment.segmentId,\n\t\tarchived: segmentData.archived,\n\t\tlineNo: anchorIndex + 1,\n\t\t...(window.length === 0\n\t\t\t? {}\n\t\t\t: {\n\t\t\t\t\tstartLine: window[0].lineNo,\n\t\t\t\t\tendLine: window[window.length - 1].lineNo,\n\t\t\t\t}),\n\t\thasMore,\n\t\t...(hasMore ? { nextOffset: end - anchorIndex } : {}),\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * F11（O08）成果登记闭包：卡回执边界（挂点 A）与交卷边界（挂点 B）共用的\n * 业务实现。从 index.ts 抽出成模块——接线层装配期注入，测试可直接驱动。import { basename, dirname, join, resolve } from \"node:path\";\n\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type{ loadCard {\n\tDeliveryArtifactRegistrationInput,\n\tReceiptArtifactRegistrationInput,\n} from \"../cards/index.tscardfile.ts\";type  loadCard \n\tDeliveryArtifactRegistrationInput,\n\tReceiptArtifactRegistrationInput,\n\nimport { readLatestVerdict } from \"../cards/verifier.ts\";\nimport {import { requestIdFor } from \"./request-identity.ts\";\nimport { sessionMemory } from \"./session.ts\";\nimport { taskIdForCard } from \"./task-continuation.ts\";captureToolCallSource,scopeFromContextBuiltinMemoryRegistration } from \"./tools.ts\";captureToolCallSource, scopeFromContext\n\n/** 回调可用的记忆注册面（装配期闭包现取；service.opened=false 时回调返回 undefined）。 */\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,211]}}},{"equalLines":{"line_count":8}},{"diffOp":{"equal":{"range":[211,341]}}},{"diffOp":{"equal":{"range":[341,349]}}},{"diffOp":{"delete":{"range":[349,353]}}},{"diffOp":{"insert":{"range":[353,363]}}},{"diffOp":{"equal":{"range":[363,364]}}},{"diffOp":{"delete":{"range":[364,437]}}},{"diffOp":{"equal":{"range":[437,454]}}},{"diffOp":{"delete":{"range":[454,462]}}},{"diffOp":{"insert":{"range":[462,473]}}},{"diffOp":{"equal":{"range":[473,475]}}},{"diffOp":{"equal":{"range":[341,349]}}},{"diffOp":{"insert":{"range":[475,480]}}},{"diffOp":{"equal":{"range":[353,354]}}},{"diffOp":{"delete":{"range":[480,490]}}},{"diffOp":{"insert":{"range":[490,562]}}},{"diffOp":{"equal":{"range":[437,454]}}},{"diffOp":{"delete":{"range":[462,473]}}},{"diffOp":{"insert":{"range":[454,462]}}},{"diffOp":{"equal":{"range":[473,475]}}},{"diffOp":{"equal":{"range":[562,629]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[629,784]}}},{"diffOp":{"equal":{"range":[562,570]}}},{"diffOp":{"delete":{"range":[353,354]}}},{"diffOp":{"insert":{"range":[475,479]}}},{"diffOp":{"equal":{"range":[480,481]}}},{"diffOp":{"delete":{"range":[784,806]}}},{"diffOp":{"insert":{"range":[353,354]}}},{"diffOp":{"equal":{"range":[480,481]}}},{"diffOp":{"delete":{"range":[806,822]}}},{"diffOp":{"insert":{"range":[822,847]}}},{"diffOp":{"equal":{"range":[847,868]}}},{"diffOp":{"equal":{"range":[562,570]}}},{"diffOp":{"delete":{"range":[475,480]}}},{"diffOp":{"equal":{"range":[353,355]}}},{"diffOp":{"delete":{"range":[822,847]}}},{"diffOp":{"insert":{"range":[868,907]}}},{"diffOp":{"equal":{"range":[847,868]}}},{"diffOp":{"equal":{"range":[907,1025]}}},{"equalLines":{"line_count":144}},{"diffOp":{"equal":{"range":[1025,1031]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\artifact-registration.ts"},"span":[711,772],"sourceCode":"/**\n * F11（O08）成果登记闭包：卡回执边界（挂点 A）与交卷边界（挂点 B）共用的\n * 业务实现。从 index.ts 抽出成模块——接线层装配期注入，测试可直接驱动。\n *\n * 约束（任务书）：\n * - cards/delivery 注册先于 memory：回调在工具执行时才解引用服务；\n *   记忆未启用/未就绪返回 undefined（如实跳过），不阻断回执/交卷落定。\n * - 登记失败只留痕不重跑；归因失败只留痕不阻断。\n * - 浏览/预览不记执行——resolve 只读边界不动，复用归因统一挂在回执边界。\n * - 来源必须真实：captureToolCallSource 拿不到来源时不登记（不留无证行）。\n */\nimport { basename, dirname, join, resolve } from \"node:path\";\n\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type {\n\tDeliveryArtifactRegistrationInput,\n\tReceiptArtifactRegistrationInput,\n} from \"../cards/index.ts\";\nimport { loadCard } from \"../cards/cardfile.ts\";\nimport { readLatestVerdict } from \"../cards/verifier.ts\";\nimport {\n\ttype ArtifactVerificationStatus,\n\tencodeArtifactReceiptRef,\n\tgitRepoRoot,\n\trevParseCommitSha,\n} from \"./artifacts.ts\";\nimport { requestIdFor } from \"./request-identity.ts\";\nimport { sessionMemory } from \"./session.ts\";\nimport { taskIdForCard } from \"./task-continuation.ts\";\nimport { captureToolCallSource, scopeFromContext } from \"./tools.ts\";\nimport type { BuiltinMemoryRegistration } from \"./tools.ts\";\n\n/** 回调可用的记忆注册面（装配期闭包现取；service.opened=false 时回调返回 undefined）。 */\nexport interface ArtifactRegistrationDeps {\n\t/** 惰性取内置记忆注册结果（同 resolveMemoryService 先例）。 */\n\tregistration: () => BuiltinMemoryRegistration | undefined;\n\t/** 扩展宿主（sessionMemory 态按 ExtensionAPI 键控）。 */\n\tpi: ExtensionAPI;\n\t/** PAO_HOME 解析（scopeFromContext 用）。 */\n\tpaoHome: () => string;\n}\n\n/** 回执文本 → verdict 前缀；回执落定只代表 worker 自报，默认 pending_review。 */\nfunction receiptVerdict(result: string | undefined): ArtifactVerificationStatus {\n\tif (result !== undefined && /失败|fail/i.test(result)) return \"fail\";\n\treturn \"pending_review\";\n}\n\n/** 机械验收结论 → verdict 前缀；无记录/无法判都按 pending_review 如实留。 */\nfunction deliveryVerdict(conclusion: string | undefined): ArtifactVerificationStatus {\n\tif (conclusion === \"全过自动交付\" || conclusion === \"全过停人工审\") return \"pass\";\n\tif (conclusion === \"未过\") return \"fail\";\n\treturn \"pending_review\";\n}\n\n/**\n * 挂点 A：worker 经 pao_submit_receipt 交回执后的成果登记 + resolve 归因。\n * 返回追加到回执文本末的注记（可省）；跳过/失败如实说明，不抛。\n */\nexport function makeRegisterReceiptArtifacts(\n\tdeps: ArtifactRegistrationDeps,\n): (input: ReceiptArtifactRegistrationInput) => Promise<string | undefined> {\n\treturn async (input) => {\n\t\tconst registration = deps.registration();\n\t\tif (!registration?.service.opened) return undefined;\n\t\tconst taskId = taskIdForCard(input.cardsDir, input.card.card_no);\n\t\tconst sessionId = input.ctx.sessionManager.getSessionId();\n\t\tconst usageRefs = [requestIdFor(input.ctx.sessionManager)];\n\t\tconst receiptRef = encodeArtifactReceiptRef(\n\t\t\t`回执:${input.card.filename}#尝试${input.params.attempt}`,\n\t\t\treceiptVerdict(input.params.result),\n\t\t);\n\t\tconst notes: string[] = [];\n\t\tconst paths = input.params.artifactPath ?? [];\n\t\tif (paths.length > 0) {\n\t\t\t// 来源捕获失败（无会话文件/未提交条目）如实跳过登记——不伪造来源 ID。\n\t\t\tconst source = captureToolCallSource(registration.capture, input.toolCallId, input.ctx);\n\t\t\tif (source === undefined) {\n\t\t\t\tnotes.push(\"（成果登记跳过：本次工具调用来源未捕获，不留无证登记）\");\n\t\t\t} else {\n\t\t\t\tconst scope = scopeFromContext(input.ctx, deps.paoHome());\n\t\t\t\tconst registered = await registration.service.registerArtifact({\n\t\t\t\t\tname: `卡${input.card.card_no} 交付产物`,\n\t\t\t\t\tscope,\n\t\t\t\t\tfiles: paths.map((artifactPath) => ({\n\t\t\t\t\t\tname: basename(artifactPath),\n\t\t\t\t\t\tpath: resolve(input.ctx.cwd, artifactPath),\n\t\t\t\t\t})),\n\t\t\t\t\toriginTaskId: taskId,\n\t\t\t\t\tsourceIds: [source.sourceId],\n\t\t\t\t\tsourceSessionId: source.sessionId,\n\t\t\t\t\tsourceToolCallId: input.toolCallId,\n\t\t\t\t\tsourceToolName: \"pao_submit_receipt\",\n\t\t\t\t\treceiptRef,\n\t\t\t\t\tusageRefs,\n\t\t\t\t\tregistrationKey: `${taskId}:${input.params.attempt}`,\n\t\t\t\t});\n\t\t\t\tif (registered.ok) {\n\t\t\t\t\tnotes.push(\n\t\t\t\t\t\t`（成果已登记：${registered.artifactId}/${registered.versions.map((v) => v.versionId).join(\",\")}）`,\n\t\t\t\t\t);\n\t\t\t\t} else {\n\t\t\t\t\tnotes.push(`（成果登记未落成：${registered.error.message}）`);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t// 本会话 resolve 过的版本——回执边界统一归因 reuse；失败只留痕不阻断。\n\t\tconst state = sessionMemory(deps.pi);\n\t\tconst resolved = state.resolvedArtifacts();\n\t\tfor (const item of resolved) {\n\t\t\ttry {\n\t\t\t\tawait registration.service.recordArtifactUse({\n\t\t\t\t\tversionId: item.versionId,\n\t\t\t\t\ttaskId,\n\t\t\t\t\taction: \"reuse\",\n\t\t\t\t\treceiptRef,\n\t\t\t\t\tsessionId,\n\t\t\t\t});\n\t\t\t} catch (error) {\n\t\t\t\tnotes.push(\n\t\t\t\t\t`（复用归因失败 ${item.versionId}：${error instanceof Error ? error.message : String(error)}）`,\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t\tif (resolved.length > 0) state.clearResolvedArtifacts();\n\t\treturn notes.length > 0 ? notes.join(\"\\n\") : undefined;\n\t};\n}\n\n/**\n * 挂点 B：交卷成功（交卷:true 且 提交哈希 存在）后把 暂存文件 清单按交付\n * commit 登记成 Git 定位成果版本。返回追加行（可省）；跳过/失败如实说明，不抛。\n */\nexport function makeRegisterDeliveryArtifacts(\n\tdeps: ArtifactRegistrationDeps,\n): (input: DeliveryArtifactRegistrationInput) => Promise<string | undefined> {\n\treturn async (input) => {\n\t\tconst registration = deps.registration();\n\t\tif (!registration?.service.opened) return undefined;\n\t\tconst card = loadCard(input.cardsDir, input.result.card_no);\n\t\tconst verdict = deliveryVerdict(readLatestVerdict(card.body)?.结论);\n\t\tconst taskId = taskIdForCard(input.cardsDir, input.result.card_no);\n\t\tconst usageRefs = [requestIdFor(input.ctx.sessionManager)];\n\t\tconst receiptRef = encodeArtifactReceiptRef(\n\t\t\t`交卷:${card.filename}#${input.result.提交哈希}`,\n\t\t\tverdict,\n\t\t);\n\t\tconst staged = input.result.暂存文件;\n\t\tif (staged.length === 0) return undefined;\n\t\tconst source = captureToolCallSource(registration.capture, input.toolCallId, input.ctx);\n\t\tif (source === undefined) {\n\t\t\treturn `（卡${card.card_no} 成果登记跳过：本次工具调用来源未捕获，不留无证登记）`;\n\t\t}\n\t\tconst repoRoot = gitRepoRoot(dirname(card.path));\n\t\tif (repoRoot === undefined) return `（卡${card.card_no} 不在 Git 仓内，交卷成果未登记）`;\n\t\tconst fullSha = revParseCommitSha(repoRoot, input.result.提交哈希!);\n\t\tif (!fullSha.ok) return `（卡${card.card_no} 交卷哈希解析失败，未登记：${fullSha.reason}）`;\n\t\tconst scope = scopeFromContext(input.ctx, deps.paoHome());\n\t\tconst registered = await registration.service.registerArtifact({\n\t\t\tname: `卡${card.card_no} 交卷产物`,\n\t\t\tscope,\n\t\t\tfiles: staged.map((repoPath) => ({\n\t\t\t\tname: basename(repoPath),\n\t\t\t\tpath: join(repoRoot, repoPath),\n\t\t\t\tgit: { commit: fullSha.sha, path: repoPath.split(\"\\\\\").join(\"/\") },\n\t\t\t})),\n\t\t\toriginTaskId: taskId,\n\t\t\tsourceIds: [source.sourceId],\n\t\t\tsourceSessionId: source.sessionId,\n\t\t\tsourceToolCallId: input.toolCallId,\n\t\t\tsourceToolName: \"pao_deliver_card\",\n\t\t\treceiptRef,\n\t\t\tusageRefs,\n\t\t\tregistrationKey: `${taskId}:deliver:${fullSha.sha}`,\n\t\t});\n\t\tif (!registered.ok) return `（卡${card.card_no} 成果登记未落成：${registered.error.message}）`;\n\t\treturn `（卡${card.card_no} 交卷成果已登记：${registered.artifactId}/${registered.versions.map((v) => v.versionId).join(\",\")}）`;\n\t};\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * F11（O08）成果登记闭包：卡回执边界（挂点 A）与交卷边界（挂点 B）共用的\n * 业务实现。从 index.ts 抽出成模块——接线层装配期注入，测试可直接驱动。\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type {\n\t DeliveryArtifactRegistrationInput,ReceiptArtifactRegistrationInput,\n} from \"../cards/index.ts\";\nimport { loadCard } from \"../cards/cardfile.ts\";\nimport { readLatestVerdict } from \"../cards/verifier.ts\";\t\t\t\t});\n\t\t\t} catch (error) {\n\t\t\t\tnotes.push(\n\t\t\t\t\t`（复用归因失败 ${item.versionId}：${error instanceof Error ? error.message : String(error)}）`,\n\t\t\t\t);\n\t\t\t}\n\t\t}\t\tconst taskId = taskIdForCard(input.cardsDir, input.result.card_no);\n\t\tconst usageRefs = [requestIdFor(input.ctx.sessionManager)];\n\t\tconst receiptRef = encodeArtifactReceiptRef(`交卷:${card.filename}#${input.result.提交哈希}`,verdict);\n\t\tconst staged = input.result.暂存文件;\n\t\tif (staged.length === 0) return undefined;\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,211]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[211,293]}}},{"diffOp":{"delete":{"range":[293,295]}}},{"diffOp":{"insert":{"range":[295,296]}}},{"diffOp":{"equal":{"range":[296,330]}}},{"diffOp":{"delete":{"range":[293,295]}}},{"diffOp":{"insert":{"range":[295,296]}}},{"diffOp":{"equal":{"range":[330,362]}}},{"diffOp":{"delete":{"range":[362,364]}}},{"diffOp":{"insert":{"range":[295,296]}}},{"diffOp":{"equal":{"range":[364,498]}}},{"equalLines":{"line_count":97}},{"diffOp":{"equal":{"range":[498,542]}}},{"diffOp":{"delete":{"range":[542,548]}}},{"diffOp":{"equal":{"range":[548,652]}}},{"diffOp":{"delete":{"range":[652,658]}}},{"diffOp":{"equal":{"range":[658,669]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[669,847]}}},{"diffOp":{"delete":{"range":[542,546]}}},{"diffOp":{"equal":{"range":[847,902]}}},{"diffOp":{"delete":{"range":[542,546]}}},{"diffOp":{"insert":{"range":[295,296]}}},{"diffOp":{"equal":{"range":[902,909]}}},{"diffOp":{"delete":{"range":[652,656]}}},{"diffOp":{"equal":{"range":[909,1000]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[1000,1006]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\artifact-registration.ts"},"span":null,"sourceCode":"/**\n * F11（O08）成果登记闭包：卡回执边界（挂点 A）与交卷边界（挂点 B）共用的\n * 业务实现。从 index.ts 抽出成模块——接线层装配期注入，测试可直接驱动。\n *\n * 约束（任务书）：\n * - cards/delivery 注册先于 memory：回调在工具执行时才解引用服务；\n *   记忆未启用/未就绪返回 undefined（如实跳过），不阻断回执/交卷落定。\n * - 登记失败只留痕不重跑；归因失败只留痕不阻断。\n * - 浏览/预览不记执行——resolve 只读边界不动，复用归因统一挂在回执边界。\n * - 来源必须真实：captureToolCallSource 拿不到来源时不登记（不留无证行）。\n */\nimport { basename, dirname, join, resolve } from \"node:path\";\n\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type {\n\tDeliveryArtifactRegistrationInput,\n\tReceiptArtifactRegistrationInput,\n} from \"../cards/index.ts\";\nimport { loadCard } from \"../cards/cardfile.ts\";\nimport { readLatestVerdict } from \"../cards/verifier.ts\";\nimport {\n\ttype ArtifactVerificationStatus,\n\tencodeArtifactReceiptRef,\n\tgitRepoRoot,\n\trevParseCommitSha,\n} from \"./artifacts.ts\";\nimport { requestIdFor } from \"./request-identity.ts\";\nimport { sessionMemory } from \"./session.ts\";\nimport { taskIdForCard } from \"./task-continuation.ts\";\nimport { captureToolCallSource, scopeFromContext } from \"./tools.ts\";\nimport type { BuiltinMemoryRegistration } from \"./tools.ts\";\n\n/** 回调可用的记忆注册面（装配期闭包现取；service.opened=false 时回调返回 undefined）。 */\nexport interface ArtifactRegistrationDeps {\n\t/** 惰性取内置记忆注册结果（同 resolveMemoryService 先例）。 */\n\tregistration: () => BuiltinMemoryRegistration | undefined;\n\t/** 扩展宿主（sessionMemory 态按 ExtensionAPI 键控）。 */\n\tpi: ExtensionAPI;\n\t/** PAO_HOME 解析（scopeFromContext 用）。 */\n\tpaoHome: () => string;\n}\n\n/** 回执文本 → verdict 前缀；回执落定只代表 worker 自报，默认 pending_review。 */\nfunction receiptVerdict(result: string | undefined): ArtifactVerificationStatus {\n\tif (result !== undefined && /失败|fail/i.test(result)) return \"fail\";\n\treturn \"pending_review\";\n}\n\n/** 机械验收结论 → verdict 前缀；无记录/无法判都按 pending_review 如实留。 */\nfunction deliveryVerdict(conclusion: string | undefined): ArtifactVerificationStatus {\n\tif (conclusion === \"全过自动交付\" || conclusion === \"全过停人工审\") return \"pass\";\n\tif (conclusion === \"未过\") return \"fail\";\n\treturn \"pending_review\";\n}\n\n/**\n * 挂点 A：worker 经 pao_submit_receipt 交回执后的成果登记 + resolve 归因。\n * 返回追加到回执文本末的注记（可省）；跳过/失败如实说明，不抛。\n */\nexport function makeRegisterReceiptArtifacts(\n\tdeps: ArtifactRegistrationDeps,\n): (input: ReceiptArtifactRegistrationInput) => Promise<string | undefined> {\n\treturn async (input) => {\n\t\tconst registration = deps.registration();\n\t\tif (!registration?.service.opened) return undefined;\n\t\tconst taskId = taskIdForCard(input.cardsDir, input.card.card_no);\n\t\tconst sessionId = input.ctx.sessionManager.getSessionId();\n\t\tconst usageRefs = [requestIdFor(input.ctx.sessionManager)];\n\t\tconst receiptRef = encodeArtifactReceiptRef(\n\t\t\t`回执:${input.card.filename}#尝试${input.params.attempt}`,\n\t\t\treceiptVerdict(input.params.result),\n\t\t);\n\t\tconst notes: string[] = [];\n\t\tconst paths = input.params.artifactPath ?? [];\n\t\tif (paths.length > 0) {\n\t\t\t// 来源捕获失败（无会话文件/未提交条目）如实跳过登记——不伪造来源 ID。\n\t\t\tconst source = captureToolCallSource(registration.capture, input.toolCallId, input.ctx);\n\t\t\tif (source === undefined) {\n\t\t\t\tnotes.push(\"（成果登记跳过：本次工具调用来源未捕获，不留无证登记）\");\n\t\t\t} else {\n\t\t\t\tconst scope = scopeFromContext(input.ctx, deps.paoHome());\n\t\t\t\tconst registered = await registration.service.registerArtifact({\n\t\t\t\t\tname: `卡${input.card.card_no} 交付产物`,\n\t\t\t\t\tscope,\n\t\t\t\t\tfiles: paths.map((artifactPath) => ({\n\t\t\t\t\t\tname: basename(artifactPath),\n\t\t\t\t\t\tpath: resolve(input.ctx.cwd, artifactPath),\n\t\t\t\t\t})),\n\t\t\t\t\toriginTaskId: taskId,\n\t\t\t\t\tsourceIds: [source.sourceId],\n\t\t\t\t\tsourceSessionId: source.sessionId,\n\t\t\t\t\tsourceToolCallId: input.toolCallId,\n\t\t\t\t\tsourceToolName: \"pao_submit_receipt\",\n\t\t\t\t\treceiptRef,\n\t\t\t\t\tusageRefs,\n\t\t\t\t\tregistrationKey: `${taskId}:${input.params.attempt}`,\n\t\t\t\t});\n\t\t\t\tif (registered.ok) {\n\t\t\t\t\tnotes.push(\n\t\t\t\t\t\t`（成果已登记：${registered.artifactId}/${registered.versions.map((v) => v.versionId).join(\",\")}）`,\n\t\t\t\t\t);\n\t\t\t\t} else {\n\t\t\t\t\tnotes.push(`（成果登记未落成：${registered.error.message}）`);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t// 本会话 resolve 过的版本——回执边界统一归因 reuse；失败只留痕不阻断。\n\t\tconst state = sessionMemory(deps.pi);\n\t\tconst resolved = state.resolvedArtifacts();\n\t\tfor (const item of resolved) {\n\t\t\ttry {\n\t\t\t\tawait registration.service.recordArtifactUse({\n\t\t\t\t\tversionId: item.versionId,\n\t\t\t\t\ttaskId,\n\t\t\t\t\taction: \"reuse\",\n\t\t\t\t\treceiptRef,\n\t\t\t\t\tsessionId,\n\t\t\t\t});\n\t\t\t} catch (error) {\n\t\t\t\tnotes.push(\n\t\t\t\t\t`（复用归因失败 ${item.versionId}：${error instanceof Error ? error.message : String(error)}）`,\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t\tif (resolved.length > 0) state.clearResolvedArtifacts();\n\t\treturn notes.length > 0 ? notes.join(\"\\n\") : undefined;\n\t};\n}\n\n/**\n * 挂点 B：交卷成功（交卷:true 且 提交哈希 存在）后把 暂存文件 清单按交付\n * commit 登记成 Git 定位成果版本。返回追加行（可省）；跳过/失败如实说明，不抛。\n */\nexport function makeRegisterDeliveryArtifacts(\n\tdeps: ArtifactRegistrationDeps,\n): (input: DeliveryArtifactRegistrationInput) => Promise<string | undefined> {\n\treturn async (input) => {\n\t\tconst registration = deps.registration();\n\t\tif (!registration?.service.opened) return undefined;\n\t\tconst card = loadCard(input.cardsDir, input.result.card_no);\n\t\tconst verdict = deliveryVerdict(readLatestVerdict(card.body)?.结论);\n\t\tconst taskId = taskIdForCard(input.cardsDir, input.result.card_no);\n\t\tconst usageRefs = [requestIdFor(input.ctx.sessionManager)];\n\t\tconst receiptRef = encodeArtifactReceiptRef(\n\t\t\t`交卷:${card.filename}#${input.result.提交哈希}`,\n\t\t\tverdict,\n\t\t);\n\t\tconst staged = input.result.暂存文件;\n\t\tif (staged.length === 0) return undefined;\n\t\tconst source = captureToolCallSource(registration.capture, input.toolCallId, input.ctx);\n\t\tif (source === undefined) {\n\t\t\treturn `（卡${card.card_no} 成果登记跳过：本次工具调用来源未捕获，不留无证登记）`;\n\t\t}\n\t\tconst repoRoot = gitRepoRoot(dirname(card.path));\n\t\tif (repoRoot === undefined) return `（卡${card.card_no} 不在 Git 仓内，交卷成果未登记）`;\n\t\tconst fullSha = revParseCommitSha(repoRoot, input.result.提交哈希!);\n\t\tif (!fullSha.ok) return `（卡${card.card_no} 交卷哈希解析失败，未登记：${fullSha.reason}）`;\n\t\tconst scope = scopeFromContext(input.ctx, deps.paoHome());\n\t\tconst registered = await registration.service.registerArtifact({\n\t\t\tname: `卡${card.card_no} 交卷产物`,\n\t\t\tscope,\n\t\t\tfiles: staged.map((repoPath) => ({\n\t\t\t\tname: basename(repoPath),\n\t\t\t\tpath: join(repoRoot, repoPath),\n\t\t\t\tgit: { commit: fullSha.sha, path: repoPath.split(\"\\\\\").join(\"/\") },\n\t\t\t})),\n\t\t\toriginTaskId: taskId,\n\t\t\tsourceIds: [source.sourceId],\n\t\t\tsourceSessionId: source.sessionId,\n\t\t\tsourceToolCallId: input.toolCallId,\n\t\t\tsourceToolName: \"pao_deliver_card\",\n\t\t\treceiptRef,\n\t\t\tusageRefs,\n\t\t\tregistrationKey: `${taskId}:deliver:${fullSha.sha}`,\n\t\t});\n\t\tif (!registered.ok) return `（卡${card.card_no} 成果登记未落成：${registered.error.message}）`;\n\t\treturn `（卡${card.card_no} 交卷成果已登记：${registered.artifactId}/${registered.versions.map((v) => v.versionId).join(\",\")}）`;\n\t};\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 可复用成果的登记、确切版本回读与使用归因（S6-01—05、S6-10）。\n *}\n\nfunction resolveFile(\n\tfile: { name: string;path: string;git?: { commit: string; path: string };\n,\n): { ok: true; resolved: ResolvedFile } | { ok: false; error: MemoryError } {\n\tif (file.git !== undefined) {\n\t\t// Git 定位：调用方给了 commit+仓内路径，读回对象实测字节数。\treturn { ok: true, ...result };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,97]}}},{"equalLines":{"line_count":355}},{"diffOp":{"equal":{"range":[97,121]}}},{"diffOp":{"delete":{"range":[121,123]}}},{"diffOp":{"equal":{"range":[123,130]}}},{"diffOp":{"delete":{"range":[130,131]}}},{"diffOp":{"insert":{"range":[121,123]}}},{"diffOp":{"equal":{"range":[131,144]}}},{"diffOp":{"delete":{"range":[130,131]}}},{"diffOp":{"insert":{"range":[121,123]}}},{"diffOp":{"equal":{"range":[144,157]}}},{"diffOp":{"delete":{"range":[130,131]}}},{"diffOp":{"insert":{"range":[121,123]}}},{"diffOp":{"equal":{"range":[157,195]}}},{"diffOp":{"delete":{"range":[130,131]}}},{"diffOp":{"insert":{"range":[195,197]}}},{"diffOp":{"equal":{"range":[97,98]}}},{"diffOp":{"delete":{"range":[197,199]}}},{"diffOp":{"equal":{"range":[199,394]}}},{"equalLines":{"line_count":713}},{"diffOp":{"equal":{"range":[394,429]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\artifacts.ts"},"span":null,"sourceCode":"/**\n * 可复用成果的登记、确切版本回读与使用归因（S6-01—05、S6-10）。\n *\n * 契约（实施路径 S6 表与「成果关联与界面施工」后端段）：\n * - 登记顺序：执行结果与来源已落盘 → 确定交付清单及稳定版本 → 读取回执与可用\n *   用量引用 → `registerArtifact` 事务提交版本与关联。登记失败保留可重试结果，\n *   不为补登记重跑已执行工具；后来到达的用量只补 usageRefs 引用。\n * - Git 成果登记 repo+commit+path（经 spawnSync 参数数组读 rev-parse/cat-file，\n *   不读当前工作树）；非 Git/未提交成果写受管副本后登记定位，副本写失败不登记\n *   可用版本。\n * - 重放幂等：同一次来源登记重放（registrationKey 或同任务/调用身份）找到原\n *   记录，比较确切版本与内容后复用，不产生重复版本、不重复计 usageRef。\n * - 查重：Git 成果以 repo+commit+path 为既有身份（UNIQUE 索引）；受管成果先查\n *   同成果候选版本，比较大小与字节内容，相同复用 versionId，不另建哈希清单。\n * - 版本链：生成不同版本才新增记录，parentVersionId/originTaskId/receiptRef\n *   落表；回执失败如实关联，不标成功验证。\n * - S6-10：记忆删除先解除该记忆的成果引用（applyDatabasePlan 挂接）；删除成果\n *   时仍被引用的版本与受管文件保留，无引用且用户明确要求才物理清除。\n */\nimport { spawnSync } from \"node:child_process\";\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { dirname, join, resolve } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { GIT_READ_TIMEOUT_MS, gitProcessErrorText } from \"../shared/git.ts\";\nimport { memoryPaths } from \"./paths.ts\";\nimport { resolveSources } from \"./sources.ts\";\nimport { dropArtifactFts, type MemoryStore, upsertArtifactFts } from \"./store.ts\";\nimport {\n\tARTIFACT_UNKNOWN,\n\ttype ArtifactDeletionRefPreview,\n\ttype ArtifactLocation,\n\ttype ArtifactSearchHit,\n\ttype ArtifactVersion,\n\ttype DeleteArtifactInput,\n\ttype DeleteArtifactResult,\n\ttype MemoryError,\n\ttype MemoryResult,\n\ttype PreviewArtifactDeletionInput,\n\ttype PreviewArtifactDeletionResult,\n\ttype RecordArtifactUseInput,\n\ttype RecordArtifactUseResult,\n\ttype RegisterArtifactInput,\n\ttype RegisterArtifactResult,\n\ttype ResolveArtifactVersionInput,\n\ttype ResolveArtifactVersionOutput,\n\ttype SearchArtifactsInput,\n\ttype SearchArtifactsResult,\n} from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 行映射\n// ════════════════════════════════════════════════════════════════════════\n\ninterface ArtifactRow {\n\tartifact_id: string;\n\tproject_id: string;\n\tname: string;\n\tpurpose: string;\n\tinputs: string;\n\toutputs: string;\n\tconditions: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface VersionRow {\n\tversion_id: string;\n\tartifact_id: string;\n\tseq: number;\n\tlocation_json: string;\n\tsize_bytes: number;\n\tparent_version_id: string | null;\n\torigin_task_id: string | null;\n\tsource_ids_json: string;\n\tsource_session_id: string | null;\n\tsource_entry_id: string | null;\n\tsource_tool_call_id: string | null;\n\tsource_tool_name: string | null;\n\treceipt_ref: string | null;\n\tusage_refs_json: string;\n\tregistration_key: string | null;\n\tcreated_at: string;\n}\n\nfunction mapVersion(row: VersionRow): ArtifactVersion {\n\treturn {\n\t\tversionId: row.version_id,\n\t\tartifactId: row.artifact_id,\n\t\tseq: row.seq,\n\t\tlocation: JSON.parse(row.location_json) as ArtifactLocation,\n\t\tsizeBytes: row.size_bytes,\n\t\t...(row.parent_version_id === null ? {} : { parentVersionId: row.parent_version_id }),\n\t\t...(row.origin_task_id === null ? {} : { originTaskId: row.origin_task_id }),\n\t\tsourceIds: JSON.parse(row.source_ids_json) as string[],\n\t\t...(row.source_session_id === null ? {} : { sourceSessionId: row.source_session_id }),\n\t\t...(row.source_entry_id === null ? {} : { sourceEntryId: row.source_entry_id }),\n\t\t...(row.source_tool_call_id === null ? {} : { sourceToolCallId: row.source_tool_call_id }),\n\t\t...(row.source_tool_name === null ? {} : { sourceToolName: row.source_tool_name }),\n\t\t...(row.receipt_ref === null ? {} : { receiptRef: row.receipt_ref }),\n\t\tusageRefs: JSON.parse(row.usage_refs_json) as string[],\n\t\tcreatedAt: row.created_at,\n\t};\n}\n\nfunction fail(\n\tcode: MemoryError[\"code\"],\n\tmessage: string,\n\textra?: Partial<MemoryError>,\n): { ok: false; error: MemoryError } {\n\treturn { ok: false, error: { code, message, ...extra } };\n}\n\nfunction invalidInput(message: string, refId?: string): { ok: false; error: MemoryError } {\n\treturn fail(\"invalid_input\", message, refId === undefined ? {} : { refId });\n}\n\nfunction nowIso(): string {\n\treturn new Date().toISOString();\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// Git 读取（spawnSync 参数数组，不读工作树）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 执行一次 git 读；非零退出与执行器故障都返回文本原因，不抛。 */\nfunction gitRead(repoRoot: string, args: string[]): { ok: true; stdout: Buffer } | { ok: false; reason: string } {\n\tconst result = spawnSync(\"git\", [\"-c\", \"core.quotepath=off\", ...args], {\n\t\tcwd: repoRoot,\n\t\tencoding: null,\n\t\twindowsHide: true,\n\t\ttimeout: GIT_READ_TIMEOUT_MS,\n\t\tmaxBuffer: 64 * 1024 * 1024,\n\t});\n\tif (result.error) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\treason: `Git 读取失败：${gitProcessErrorText(\n\t\t\t\tresult.error,\n\t\t\t\tresult.stderr?.toString(\"utf8\") ?? \"\",\n\t\t\t\tGIT_READ_TIMEOUT_MS,\n\t\t\t)}`,\n\t\t};\n\t}\n\tif (result.status !== 0) {\n\t\tconst stderr = result.stderr?.toString(\"utf8\").trim() ?? \"\";\n\t\treturn { ok: false, reason: `Git 读取失败（${args.join(\" \")}）：${stderr}` };\n\t}\n\treturn { ok: true, stdout: result.stdout };\n}\n\n/** 由任意仓内路径定位规范仓根；非 Git 目录返回 undefined。 */\nexport function gitRepoRoot(cwd: string): string | undefined {\n\tconst result = gitRead(cwd, [\"rev-parse\", \"--show-toplevel\"]);\n\tif (!result.ok) return undefined;\n\treturn resolve(result.stdout.toString(\"utf8\").trim());\n}\n\nconst FULL_SHA = /^[0-9a-f]{40}$/i;\n\n/**\n * 把调用方给的 revision 解析成完整 commit SHA。\n * 分支名/tag/HEAD 会被解析成当前指向，但调用方必须显式传 commit——\n * 本函数只做 `rev-parse --verify <rev>^{commit}`，分支名也能通过校验，\n * 因此这里额外拒绝非完整 SHA：登记契约要求固定 commit，不接受移动引用。\n */\nexport function resolveCommitSha(\n\trepoRoot: string,\n\trevision: string,\n): { ok: true; sha: string } | { ok: false; reason: string } {\n\tif (!FULL_SHA.test(revision)) {\n\t\treturn { ok: false, reason: `版本定位必须是完整 commit SHA，不接受分支/tag:${revision}` };\n\t}\n\tconst result = gitRead(repoRoot, [\"rev-parse\", \"--verify\", `${revision}^{commit}`]);\n\tif (!result.ok) return { ok: false, reason: result.reason };\n\treturn { ok: true, sha: result.stdout.toString(\"utf8\").trim() };\n}\n\n/**\n * F11（O08）挂点 B：交卷落库拿到的是短哈希，登记前要补全成完整 SHA。\n * 与 resolveCommitSha 的差别：本函数接受短哈希/任意 rev 输入，但仍解析成\n * 固定 commit（`rev-parse <rev>^{commit}` 输出全长 SHA），产物不接受移动引用。\n */\nexport function revParseCommitSha(\n\trepoRoot: string,\n\trevision: string,\n): { ok: true; sha: string } | { ok: false; reason: string } {\n\tconst result = gitRead(repoRoot, [\"rev-parse\", \"--verify\", `${revision}^{commit}`]);\n\tif (!result.ok) return { ok: false, reason: result.reason };\n\treturn { ok: true, sha: result.stdout.toString(\"utf8\").trim() };\n}\n\n/** 读取指定 commit 中某仓内相对路径的对象内容与字节数；不存在返回 undefined。 */\nfunction gitShowFile(\n\trepoRoot: string,\n\tcommit: string,\n\tpath: string,\n): { ok: true; content: Buffer } | { ok: false; reason: string } | undefined {\n\tconst size = gitRead(repoRoot, [\"cat-file\", \"-s\", `${commit}:${path}`]);\n\tif (!size.ok) {\n\t\tif (/Not a valid object name|does not exist/i.test(size.reason)) return undefined;\n\t\treturn { ok: false, reason: size.reason };\n\t}\n\tconst content = gitRead(repoRoot, [\"cat-file\", \"blob\", `${commit}:${path}`]);\n\tif (!content.ok) return { ok: false, reason: content.reason };\n\treturn { ok: true, content: content.stdout };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 查询助手\n// ════════════════════════════════════════════════════════════════════════\n\nfunction artifactRow(db: DatabaseSync, artifactId: string): ArtifactRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at\n\t\t\t FROM artifacts WHERE artifact_id = ?`,\n\t\t)\n\t\t.get(artifactId) as ArtifactRow | undefined;\n}\n\nfunction versionRow(db: DatabaseSync, versionId: string): VersionRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT version_id, artifact_id, seq, location_json, size_bytes, parent_version_id, origin_task_id,\n\t\t\t        source_ids_json, source_session_id, source_entry_id, source_tool_call_id, source_tool_name,\n\t\t\t        receipt_ref, usage_refs_json, registration_key, created_at\n\t\t\t FROM artifact_versions WHERE version_id = ?`,\n\t\t)\n\t\t.get(versionId) as VersionRow | undefined;\n}\n\nfunction versionsForArtifact(db: DatabaseSync, artifactId: string): VersionRow[] {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT version_id, artifact_id, seq, location_json, size_bytes, parent_version_id, origin_task_id,\n\t\t\t        source_ids_json, source_session_id, source_entry_id, source_tool_call_id, source_tool_name,\n\t\t\t        receipt_ref, usage_refs_json, registration_key, created_at\n\t\t\t FROM artifact_versions WHERE artifact_id = ? ORDER BY seq`,\n\t\t)\n\t\t.all(artifactId) as unknown as VersionRow[];\n}\n\nfunction nextVersionSeq(db: DatabaseSync, artifactId: string): number {\n\tconst row = db.prepare(\"SELECT MAX(seq) AS seq FROM artifact_versions WHERE artifact_id = ?\").get(artifactId) as {\n\t\tseq: number | null;\n\t};\n\treturn (row.seq ?? 0) + 1;\n}\n\n/** 同 registration_key 的既有版本行（重放幂等查找）。 */\nfunction versionByRegistrationKey(db: DatabaseSync, key: string): VersionRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT version_id, artifact_id, seq, location_json, size_bytes, parent_version_id, origin_task_id,\n\t\t\t        source_ids_json, source_session_id, source_entry_id, source_tool_call_id, source_tool_name,\n\t\t\t        receipt_ref, usage_refs_json, registration_key, created_at\n\t\t\t FROM artifact_versions WHERE registration_key = ? ORDER BY created_at LIMIT 1`,\n\t\t)\n\t\t.get(key) as VersionRow | undefined;\n}\n\n/** Git 身份查重：repo+commit+path 已登记的版本行。 */\nfunction versionByGitIdentity(\n\tdb: DatabaseSync,\n\tlocation: Extract<ArtifactLocation, { kind: \"git\" }>,\n): VersionRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT version_id, artifact_id, seq, location_json, size_bytes, parent_version_id, origin_task_id,\n\t\t\t        source_ids_json, source_session_id, source_entry_id, source_tool_call_id, source_tool_name,\n\t\t\t        receipt_ref, usage_refs_json, registration_key, created_at\n\t\t\t FROM artifact_versions\n\t\t\t WHERE json_extract(location_json, '$.kind') = 'git'\n\t\t\t   AND json_extract(location_json, '$.repoRoot') = ?\n\t\t\t   AND json_extract(location_json, '$.commit') = ?\n\t\t\t   AND json_extract(location_json, '$.path') = ?\n\t\t\t LIMIT 1`,\n\t\t)\n\t\t.get(location.repoRoot, location.commit, location.path) as VersionRow | undefined;\n}\n\n/** 受管版本内容字节比较（同成果候选版本间查重）。 */\nfunction managedContentEquals(dir: string, file: string, candidate: Buffer): boolean {\n\tconst full = join(dir, file);\n\tif (!existsSync(full)) return false;\n\ttry {\n\t\tconst existing = readFileSync(full);\n\t\treturn existing.length === candidate.length && existing.equals(candidate);\n\t} catch {\n\t\treturn false;\n\t}\n}\n\n/**\n * 同步成果检索索引：每个版本一行，正文 = 成果元信息 + 该版本工具名。\n * 对新建/查重命中/重放所有返回版本幂等 upsert；索引不含版本文件正文。\n * F12：一次登记内查重命中的版本归属可能与登记行不同（共享成果身份），\n * 按版本自身 artifactId 分组逐成果刷索引，不拿登记行替代。\n */\nfunction syncArtifactFts(db: DatabaseSync, versions: ArtifactVersion[]): void {\n\tconst metaByArtifact = new Map<string, ArtifactRow>();\n\tfor (const version of versions) {\n\t\tlet artifact = metaByArtifact.get(version.artifactId);\n\t\tif (!artifact) {\n\t\t\tartifact = artifactRow(db, version.artifactId);\n\t\t\tif (!artifact) continue;\n\t\t\tmetaByArtifact.set(version.artifactId, artifact);\n\t\t}\n\t\tupsertArtifactFts(db, version.artifactId, version.versionId, {\n\t\t\tname: artifact.name,\n\t\t\tpurpose: artifact.purpose,\n\t\t\tinputs: artifact.inputs,\n\t\t\toutputs: artifact.outputs,\n\t\t\tconditions: artifact.conditions,\n\t\t\t...(version.sourceToolName === undefined ? {} : { toolName: version.sourceToolName }),\n\t\t});\n\t}\n}\n\n/** 把 usageRefs 并集写回既有版本行（迟到用量只补引用）。 */\nfunction mergeUsageRefs(db: DatabaseSync, versionId: string, incoming: string[]): void {\n\tif (incoming.length === 0) return;\n\tconst row = versionRow(db, versionId);\n\tif (!row) return;\n\tconst existing = JSON.parse(row.usage_refs_json) as string[];\n\tconst merged = [...new Set([...existing, ...incoming])];\n\tif (merged.length === existing.length) return;\n\tdb.prepare(\"UPDATE artifact_versions SET usage_refs_json = ? WHERE version_id = ?\").run(\n\t\tJSON.stringify(merged),\n\t\tversionId,\n\t);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// registerArtifact\n// ════════════════════════════════════════════════════════════════════════\n\ninterface PreparedFile {\n\tname: string;\n\tlocation: ArtifactLocation;\n\tsizeBytes: number;\n\t/** 受管副本的待写内容（Git 版本无此字段——内容在仓里）。 */\n\tmanagedContent?: Buffer;\n}\n\n/**\n * O14：事务外解析阶段的结果。每份交付文件在此阶段完成全部慢 I/O——\n * Git 定位（rev-parse/show-toplevel、cat-file 两个子进程）与受管源文件读入\n * 都不进写事务，避免 Git 超时（30s/次）或源文件读把 BEGIN IMMEDIATE 长占。\n * Git 文件保留 {repoRoot, commit} 身份供事务内复核；受管文件保留内容缓冲，\n * managed 副本目录要等事务内决出 artifactId+versionId 才能定。\n */\ninterface ResolvedFile {\n\tfile: { name: string; path: string; git?: { commit: string; path: string } };\n\tgitIdentity?: { repoRoot: string; commit: string };\n\tmanagedContent?: Buffer;\n\tsizeBytes: number;\n}\n\nfunction resolveFile(\n\tfile: { name: string; path: string; git?: { commit: string; path: string } },\n): { ok: true; resolved: ResolvedFile } | { ok: false; error: MemoryError } {\n\tif (file.git !== undefined) {\n\t\t// Git 定位：调用方给了 commit+仓内路径，读回对象实测字节数。\n\t\t// repoRoot 由文件所在目录实测（rev-parse 的 cwd 须是目录，不能直接传文件路径）。\n\t\tconst probe = gitRepoRoot(dirname(file.path));\n\t\tif (probe === undefined) {\n\t\t\treturn invalidInput(`Git 定位失败：${file.path} 不在任何 Git 仓内`, file.path);\n\t\t}\n\t\tconst commit = resolveCommitSha(probe, file.git.commit);\n\t\tif (!commit.ok) {\n\t\t\treturn { ok: false, error: { code: \"invalid_input\", message: commit.reason, refId: file.git.commit } };\n\t\t}\n\t\tconst shown = gitShowFile(probe, commit.sha, file.git.path);\n\t\tif (shown === undefined) {\n\t\t\treturn invalidInput(`commit ${commit.sha} 中没有路径 ${file.git.path}`, `${commit.sha}:${file.git.path}`);\n\t\t}\n\t\tif (!shown.ok) {\n\t\t\treturn { ok: false, error: { code: \"unavailable\", message: shown.reason, refId: file.git.path } };\n\t\t}\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresolved: {\n\t\t\t\tfile,\n\t\t\t\tgitIdentity: { repoRoot: probe, commit: commit.sha },\n\t\t\t\tsizeBytes: shown.content.length,\n\t\t\t},\n\t\t};\n\t}\n\t// 受管副本：源文件已落盘，读入内容备事务内复制——慢读留在事务外。\n\tif (!existsSync(file.path)) {\n\t\treturn invalidInput(`交付文件不存在:${file.path}`, file.path);\n\t}\n\tlet content: Buffer;\n\ttry {\n\t\tcontent = readFileSync(file.path);\n\t} catch (error) {\n\t\treturn fail(\n\t\t\t\"unavailable\",\n\t\t\t`交付文件不可读:${file.path}:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t{ refId: file.path },\n\t\t);\n\t}\n\treturn {\n\t\tok: true,\n\t\tresolved: { file, managedContent: content, sizeBytes: content.length },\n\t};\n}\n\n/**\n * 登记成果与确切版本。\n *\n * 一次调用可登记多份交付文件（files[]），它们共享同一 usageRefs——\n * 不重复计费。重放（同 registrationKey）命中既有版本时补登记欠缺的\n * usageRefs/来源字段，不产生新版本。\n */\nexport function registerArtifact(\n\tstore: MemoryStore,\n\tpaoHome: string,\n\tinput: RegisterArtifactInput,\n): MemoryResult<RegisterArtifactResult> {\n\tif (store.mode !== \"readwrite\") {\n\t\tthrow new Error(\"记忆服务以 readonly 模式打开，写接口不可用\");\n\t}\n\tif (typeof input.name !== \"string\" || input.name.length === 0) {\n\t\treturn invalidInput(\"成果名不能为空\");\n\t}\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn invalidInput(\"scope.projectId 不能为空\");\n\t}\n\tif (!Array.isArray(input.files) || input.files.length === 0) {\n\t\treturn invalidInput(\"交付文件清单不能为空\");\n\t}\n\tif (!Array.isArray(input.sourceIds) || input.sourceIds.length === 0) {\n\t\treturn invalidInput(\"至少需要一条来源 sourceId\");\n\t}\n\tconst createdAt = input.createdAt ?? nowIso();\n\n\t// O14 两阶段：先在事务外解析全部交付文件（Git 子进程定位/读对象、\n\t// 受管源文件读入），再进短事务核对身份（重放/查重/成果归属）并提交关联。\n\t// 原来这些慢 I/O 全在写事务内——一次 Git 调用最多 30s 超时，写事务会被\n\t// 长时间占住；移到事务外后事务里只剩查重 SQL、行写入与受管副本落盘。\n\tconst resolvedFiles: ResolvedFile[] = [];\n\tfor (const file of input.files) {\n\t\tconst resolved = resolveFile(file);\n\t\tif (!resolved.ok) return resolved;\n\t\tresolvedFiles.push(resolved.resolved);\n\t}\n\n\treturn store.transaction<MemoryResult<RegisterArtifactResult>>(() => {\n\t\t// 来源存在性校验（与 createMemory 同口径：缺一个整体拒绝）。\n\t\tconst { missing } = resolveSources(store.db, input.sourceIds);\n\t\tif (missing.length > 0) {\n\t\t\treturn fail(\"source_missing\", `来源不存在:${missing.join(\"、\")}`, { refId: missing[0] });\n\t\t}\n\t\tif (input.parentVersionId !== undefined && !versionRow(store.db, input.parentVersionId)) {\n\t\t\treturn invalidInput(`父版本不存在:${input.parentVersionId}`, input.parentVersionId);\n\t\t}\n\n\t\t// 重放幂等：registrationKey 命中既有登记，只补迟到引用不新建版本。\n\t\tif (input.registrationKey !== undefined) {\n\t\t\tconst existing = versionByRegistrationKey(store.db, input.registrationKey);\n\t\t\tif (existing) {\n\t\t\t\tmergeUsageRefs(store.db, existing.version_id, input.usageRefs ?? []);\n\t\t\t\tconst replayedVersions = versionsForArtifact(store.db, existing.artifact_id).map(mapVersion);\n\t\t\t\tsyncArtifactFts(store.db, replayedVersions);\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tartifactId: existing.artifact_id,\n\t\t\t\t\tversions: replayedVersions,\n\t\t\t\t\treplayed: true,\n\t\t\t\t};\n\t\t\t}\n\t\t}\n\n\t\t// F12：artifactId 决策后置——先逐文件做 Git 查重（命中即共享既有成果身份），\n\t\t// 再决定本登记行的成果归属：\n\t\t// - 调用方显式给 → 沿用（校验存在）；\n\t\t// - 未给且本次有 Git dup → 取首个 dup.artifact_id（共享成果身份，不另建孤儿行）；\n\t\t// - 未给且全部新定位 → 才真新建 artifacts 行。\n\t\t// managed 副本目录依赖 artifactId+versionId——所以 Git dup 必须先跑。\n\t\t// O14：Git 身份在解析阶段已定，这里只做库内查重 SQL，不再起子进程。\n\t\tconst pendingFiles: ResolvedFile[] = [];\n\t\tconst dupVersions: ArtifactVersion[] = [];\n\t\tfor (const resolved of resolvedFiles) {\n\t\t\tif (resolved.gitIdentity !== undefined) {\n\t\t\t\tconst dup = versionByGitIdentity(store.db, {\n\t\t\t\t\tkind: \"git\",\n\t\t\t\t\trepoRoot: resolved.gitIdentity.repoRoot,\n\t\t\t\t\tcommit: resolved.gitIdentity.commit,\n\t\t\t\t\tpath: resolved.file.git!.path,\n\t\t\t\t});\n\t\t\t\tif (dup) {\n\t\t\t\t\tmergeUsageRefs(store.db, dup.version_id, input.usageRefs ?? []);\n\t\t\t\t\t// F12：查重命中同样补当前任务的 aref 'task' 引用。\n\t\t\t\t\tif (input.originTaskId !== undefined) {\n\t\t\t\t\t\tstore.db\n\t\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t\t`INSERT OR IGNORE INTO artifact_refs (ref_id, artifact_id, version_id, ref_kind, owner_id, created_at)\n\t\t\t\t\t\t\t\t VALUES (?, ?, ?, 'task', ?, ?)`,\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\t.run(`aref-${randomUUID()}`, dup.artifact_id, dup.version_id, input.originTaskId, createdAt);\n\t\t\t\t\t}\n\t\t\t\t\t// 重读行：merge 后的 usageRefs 才是返回给调用方的确切引用集。\n\t\t\t\t\tdupVersions.push(mapVersion(versionRow(store.db, dup.version_id)!));\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t}\n\t\t\tpendingFiles.push(resolved);\n\t\t}\n\n\t\tlet artifactId = input.artifactId;\n\t\tif (artifactId === undefined) {\n\t\t\tartifactId = dupVersions.length > 0 ? dupVersions[0]!.artifactId : `art-${randomUUID()}`;\n\t\t} else if (!artifactRow(store.db, artifactId)) {\n\t\t\treturn invalidInput(`成果不存在:${artifactId}`, artifactId);\n\t\t}\n\t\tconst isNewArtifact = input.artifactId === undefined && dupVersions.length === 0;\n\t\tconst resolvedArtifactId = artifactId;\n\n\t\tconst preparedFiles: Array<{ versionId: string; prepared: PreparedFile }> = [];\n\t\tconst versions: ArtifactVersion[] = [...dupVersions];\n\t\tfor (const resolved of pendingFiles) {\n\t\t\tconst versionId = `aver-${randomUUID()}`;\n\t\t\t// 组装版本定位：Git 定位直接用解析阶段的 identity；受管定位指向\n\t\t\t// 将要落盘的副本目录（副本在本循环登记前同事务写入）。\n\t\t\tconst prepared: PreparedFile =\n\t\t\t\tresolved.gitIdentity !== undefined\n\t\t\t\t\t? {\n\t\t\t\t\t\t\tname: resolved.file.name,\n\t\t\t\t\t\t\tlocation: {\n\t\t\t\t\t\t\t\tkind: \"git\",\n\t\t\t\t\t\t\t\trepoRoot: resolved.gitIdentity.repoRoot,\n\t\t\t\t\t\t\t\tcommit: resolved.gitIdentity.commit,\n\t\t\t\t\t\t\t\tpath: resolved.file.git!.path,\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\tsizeBytes: resolved.sizeBytes,\n\t\t\t\t\t\t}\n\t\t\t\t\t: {\n\t\t\t\t\t\t\tname: resolved.file.name,\n\t\t\t\t\t\t\tlocation: {\n\t\t\t\t\t\t\t\tkind: \"managed\",\n\t\t\t\t\t\t\t\tdir: join(memoryPaths(paoHome).artifacts, resolvedArtifactId, versionId),\n\t\t\t\t\t\t\t\tfile: resolved.file.name,\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\tsizeBytes: resolved.sizeBytes,\n\t\t\t\t\t\t\tmanagedContent: resolved.managedContent,\n\t\t\t\t\t\t};\n\n\t\t\t// 受管查重：同成果候选版本间比较大小与字节内容，相同复用 versionId。\n\t\t\tif (prepared.location.kind === \"managed\" && prepared.managedContent !== undefined) {\n\t\t\t\tconst content = prepared.managedContent;\n\t\t\t\tconst candidates = versionsForArtifact(store.db, resolvedArtifactId).filter(\n\t\t\t\t\t(row) =>\n\t\t\t\t\t\t(JSON.parse(row.location_json) as ArtifactLocation).kind === \"managed\" &&\n\t\t\t\t\t\trow.size_bytes === content.length,\n\t\t\t\t);\n\t\t\t\tconst dup = candidates.find((row) => {\n\t\t\t\t\tconst loc = JSON.parse(row.location_json) as Extract<ArtifactLocation, { kind: \"managed\" }>;\n\t\t\t\t\treturn managedContentEquals(loc.dir, loc.file, content);\n\t\t\t\t});\n\t\t\t\tif (dup) {\n\t\t\t\t\tmergeUsageRefs(store.db, dup.version_id, input.usageRefs ?? []);\n\t\t\t\t\t// F12：受管查重命中同样补当前任务的 aref 'task' 引用。\n\t\t\t\t\tif (input.originTaskId !== undefined) {\n\t\t\t\t\t\tstore.db\n\t\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t\t`INSERT OR IGNORE INTO artifact_refs (ref_id, artifact_id, version_id, ref_kind, owner_id, created_at)\n\t\t\t\t\t\t\t\t VALUES (?, ?, ?, 'task', ?, ?)`,\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\t.run(`aref-${randomUUID()}`, dup.artifact_id, dup.version_id, input.originTaskId, createdAt);\n\t\t\t\t\t}\n\t\t\t\t\tversions.push(mapVersion(versionRow(store.db, dup.version_id)!));\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t}\n\t\t\tpreparedFiles.push({ versionId, prepared });\n\t\t}\n\n\t\tif (isNewArtifact) {\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO artifacts (artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at)\n\t\t\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\tresolvedArtifactId,\n\t\t\t\t\tinput.scope.projectId,\n\t\t\t\t\tinput.name,\n\t\t\t\t\tinput.purpose ?? ARTIFACT_UNKNOWN,\n\t\t\t\t\tinput.inputs ?? ARTIFACT_UNKNOWN,\n\t\t\t\t\tinput.outputs ?? ARTIFACT_UNKNOWN,\n\t\t\t\t\tinput.conditions ?? ARTIFACT_UNKNOWN,\n\t\t\t\t\tcreatedAt,\n\t\t\t\t\tcreatedAt,\n\t\t\t\t);\n\t\t} else {\n\t\t\tstore.db\n\t\t\t\t.prepare(\"UPDATE artifacts SET updated_at = ? WHERE artifact_id = ?\")\n\t\t\t\t.run(createdAt, resolvedArtifactId);\n\t\t}\n\n\t\tfor (const { versionId, prepared } of preparedFiles) {\n\t\t\t// 受管副本先落盘再登记版本定位；写失败不登记可用版本（整事务回滚，不留半成品）。\n\t\t\tif (prepared.location.kind === \"managed\" && prepared.managedContent !== undefined) {\n\t\t\t\tconst loc = prepared.location;\n\t\t\t\ttry {\n\t\t\t\t\tmkdirSync(loc.dir, { recursive: true });\n\t\t\t\t\twriteFileSync(join(loc.dir, loc.file), prepared.managedContent);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tthrow new Error(\n\t\t\t\t\t\t`受管副本写入失败:${join(loc.dir, loc.file)}:${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst seq = nextVersionSeq(store.db, resolvedArtifactId);\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`INSERT INTO artifact_versions (\n\t\t\t\t\t\tversion_id, artifact_id, seq, location_json, size_bytes, parent_version_id, origin_task_id,\n\t\t\t\t\t\tsource_ids_json, source_session_id, source_entry_id, source_tool_call_id, source_tool_name,\n\t\t\t\t\t\treceipt_ref, usage_refs_json, registration_key, created_at\n\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(\n\t\t\t\t\tversionId,\n\t\t\t\t\tresolvedArtifactId,\n\t\t\t\t\tseq,\n\t\t\t\t\tJSON.stringify(prepared.location),\n\t\t\t\t\tprepared.sizeBytes,\n\t\t\t\t\tinput.parentVersionId ?? null,\n\t\t\t\t\tinput.originTaskId ?? null,\n\t\t\t\t\tJSON.stringify(input.sourceIds),\n\t\t\t\t\tinput.sourceSessionId ?? null,\n\t\t\t\t\tinput.sourceEntryId ?? null,\n\t\t\t\t\tinput.sourceToolCallId ?? null,\n\t\t\t\t\tinput.sourceToolName ?? null,\n\t\t\t\t\tinput.receiptRef ?? null,\n\t\t\t\t\tJSON.stringify(input.usageRefs ?? []),\n\t\t\t\t\tinput.registrationKey ?? null,\n\t\t\t\t\tcreatedAt,\n\t\t\t\t);\n\t\t\t// 版本自带的登记引用：originTaskId 记 task 引用，来源调用方按 ref_kind 补记。\n\t\t\tif (input.originTaskId !== undefined) {\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`INSERT OR IGNORE INTO artifact_refs (ref_id, artifact_id, version_id, ref_kind, owner_id, created_at)\n\t\t\t\t\t\t VALUES (?, ?, ?, 'task', ?, ?)`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(`aref-${randomUUID()}`, resolvedArtifactId, versionId, input.originTaskId, createdAt);\n\t\t\t}\n\t\t\tversions.push(mapVersion(versionRow(store.db, versionId)!));\n\t\t}\n\t\tsyncArtifactFts(store.db, versions);\n\t\treturn { ok: true, artifactId: resolvedArtifactId, versions, replayed: false };\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// resolveArtifactVersion\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按确切版本回读内容。\n * Git 版本用 `git cat-file`/`show commit:path` 从仓根读；受管版本读受管副本。\n * 缺失/提交不可达返回 unavailable，绝不拿工作树当前文件顶替。\n */\nexport function resolveArtifactVersion(\n\tstore: MemoryStore,\n\tinput: ResolveArtifactVersionInput,\n): MemoryResult<ResolveArtifactVersionOutput> {\n\tconst row = versionRow(store.db, input.versionId);\n\tif (!row) {\n\t\treturn invalidInput(`成果版本不存在:${input.versionId}`, input.versionId);\n\t}\n\tconst version = mapVersion(row);\n\tconst location = version.location;\n\tif (location.kind === \"git\") {\n\t\tconst shown = gitShowFile(location.repoRoot, location.commit, location.path);\n\t\tif (shown === undefined) {\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tavailable: false,\n\t\t\t\tversion,\n\t\t\t\treason: `commit ${location.commit} 中没有路径 ${location.path}（提交不可达或路径已移除）`,\n\t\t\t};\n\t\t}\n\t\tif (!shown.ok) {\n\t\t\treturn { ok: true, available: false, version, reason: shown.reason };\n\t\t}\n\t\treturn { ok: true, available: true, version, content: shown.content };\n\t}\n\tconst full = join(location.dir, location.file);\n\tif (!existsSync(full)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tavailable: false,\n\t\t\tversion,\n\t\t\treason: `受管副本缺失:${full}`,\n\t\t};\n\t}\n\ttry {\n\t\treturn { ok: true, available: true, version, content: readFileSync(full) };\n\t} catch (error) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tavailable: false,\n\t\t\tversion,\n\t\t\treason: `受管副本不可读:${full}:${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// receipt_ref 验证状态编码（F13，O08）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * `artifact_versions.receipt_ref` 的验证状态前缀：`<verdict>:<receiptRef>`。\n * 不加列沿用前缀方案（同 evolution/observe.ts encodeReceiptRef 先例）——\n * 存量无前推行按「结果待核」处理。\n */\nexport const ARTIFACT_VERIFICATION_PREFIXES = [\"pass\", \"fail\", \"not_run\", \"pending_review\"] as const;\nexport type ArtifactVerificationStatus = (typeof ARTIFACT_VERIFICATION_PREFIXES)[number];\n\n/** 把 verdict 编进 receipt_ref；无 verdict 原样返回。 */\nexport function encodeArtifactReceiptRef(\n\treceiptRef: string | undefined,\n\tverdict: ArtifactVerificationStatus | undefined,\n): string | undefined {\n\tif (verdict === undefined) return receiptRef;\n\treturn `${verdict}:${receiptRef ?? \"\"}`;\n}\n\n/**\n * 从 receipt_ref 拆 verdict；返回 {receiptRef, verdict}：\n * - verdict 命中前缀：返回剥离前缀的 receiptRef + verdict；\n * - 无前推或前缀不在值域：verdict=undefined，receiptRef 原样返回（结果待核）。\n */\nexport function decodeArtifactReceiptRef(receiptRef: string | null | undefined): {\n\treceiptRef: string | undefined;\n\tverdict: ArtifactVerificationStatus | undefined;\n} {\n\tif (receiptRef === null || receiptRef === undefined) {\n\t\treturn { receiptRef: undefined, verdict: undefined };\n\t}\n\tfor (const prefix of ARTIFACT_VERIFICATION_PREFIXES) {\n\t\tif (receiptRef.startsWith(`${prefix}:`)) {\n\t\t\treturn { receiptRef: receiptRef.slice(prefix.length + 1), verdict: prefix };\n\t\t}\n\t}\n\treturn { receiptRef, verdict: undefined };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// recordArtifactUse\n// ════════════════════════════════════════════════════════════════════════\n\n/** 记录一次成果使用归因；使用行为本身由原文件/执行工具完成，这里只留记录。 */\nexport function recordArtifactUse(\n\tstore: MemoryStore,\n\tinput: RecordArtifactUseInput,\n): MemoryResult<RecordArtifactUseResult> {\n\tif (store.mode !== \"readwrite\") {\n\t\tthrow new Error(\"记忆服务以 readonly 模式打开，写接口不可用\");\n\t}\n\tif (typeof input.taskId !== \"string\" || input.taskId.length === 0) {\n\t\treturn invalidInput(\"taskId 不能为空\");\n\t}\n\tif (typeof input.action !== \"string\" || input.action.length === 0) {\n\t\treturn invalidInput(\"action 不能为空\");\n\t}\n\tconst row = versionRow(store.db, input.versionId);\n\tif (!row) {\n\t\treturn invalidInput(`成果版本不存在:${input.versionId}`, input.versionId);\n\t}\n\tconst createdAt = input.createdAt ?? nowIso();\n\tconst useId = `ause-${randomUUID()}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO artifact_uses (use_id, version_id, artifact_id, task_id, action, receipt_ref, session_id, created_at)\n\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tuseId,\n\t\t\tinput.versionId,\n\t\t\trow.artifact_id,\n\t\t\tinput.taskId,\n\t\t\tinput.action,\n\t\t\tinput.receiptRef ?? null,\n\t\t\tinput.sessionId ?? null,\n\t\t\tcreatedAt,\n\t\t);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO artifact_refs (ref_id, artifact_id, version_id, ref_kind, owner_id, created_at)\n\t\t\t VALUES (?, ?, ?, 'use', ?, ?)`,\n\t\t)\n\t\t.run(`aref-${randomUUID()}`, row.artifact_id, input.versionId, useId, createdAt);\n\treturn { ok: true, useId };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// S6-10：成果删除预览/确认\n// ════════════════════════════════════════════════════════════════════════\n\ninterface RefRow {\n\tref_id: string;\n\tversion_id: string;\n\tref_kind: string;\n\towner_id: string;\n}\n\nfunction refsForArtifact(db: DatabaseSync, artifactId: string): RefRow[] {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT ref_id, version_id, ref_kind, owner_id\n\t\t\t FROM artifact_refs WHERE artifact_id = ? ORDER BY ref_kind, owner_id`,\n\t\t)\n\t\t.all(artifactId) as unknown as RefRow[];\n}\n\n/** 删除预览：展示其他使用者引用；仍被引用的版本与受管文件保留。 */\nexport function previewArtifactDeletion(\n\tstore: MemoryStore,\n\tinput: PreviewArtifactDeletionInput,\n): MemoryResult<PreviewArtifactDeletionResult> {\n\tif (!artifactRow(store.db, input.artifactId)) {\n\t\treturn invalidInput(`成果不存在:${input.artifactId}`, input.artifactId);\n\t}\n\tconst refs = refsForArtifact(store.db, input.artifactId);\n\tconst versions = versionsForArtifact(store.db, input.artifactId).map((row) => {\n\t\tconst loc = JSON.parse(row.location_json) as ArtifactLocation;\n\t\treturn {\n\t\t\tversionId: row.version_id,\n\t\t\tseq: row.seq,\n\t\t\trefs: refs\n\t\t\t\t.filter((ref) => ref.version_id === row.version_id)\n\t\t\t\t.map(\n\t\t\t\t\t(ref): ArtifactDeletionRefPreview => ({\n\t\t\t\t\t\trefKind: ref.ref_kind as ArtifactDeletionRefPreview[\"refKind\"],\n\t\t\t\t\t\trefId: ref.owner_id,\n\t\t\t\t\t\tversionId: ref.version_id,\n\t\t\t\t\t}),\n\t\t\t\t),\n\t\t\t...(loc.kind === \"managed\" ? { managedDir: loc.dir } : {}),\n\t\t};\n\t});\n\tconst referencedVersionCount = versions.filter((version) => version.refs.length > 0).length;\n\treturn { ok: true, artifactId: input.artifactId, versions, referencedVersionCount };\n}\n\n/**\n * 删除成果登记。\n * 仍被引用的版本与受管文件保留；无引用且 purgeManaged=true 时才清受管文件。\n * 所有版本清除后删除 artifact 行；保留版本时登记行仍在（共享内容不破坏）。\n */\nexport function deleteArtifact(store: MemoryStore, input: DeleteArtifactInput): MemoryResult<DeleteArtifactResult> {\n\tif (store.mode !== \"readwrite\") {\n\t\tthrow new Error(\"记忆服务以 readonly 模式打开，写接口不可用\");\n\t}\n\tconst artifact = artifactRow(store.db, input.artifactId);\n\tif (!artifact) {\n\t\treturn invalidInput(`成果不存在:${input.artifactId}`, input.artifactId);\n\t}\n\treturn store.transaction<MemoryResult<DeleteArtifactResult>>(() => {\n\t\tconst refs = refsForArtifact(store.db, input.artifactId);\n\t\tconst versions = versionsForArtifact(store.db, input.artifactId);\n\t\tconst purgedVersionIds: string[] = [];\n\t\tconst retainedVersionIds: string[] = [];\n\t\tfor (const row of versions) {\n\t\t\tconst versionRefs = refs.filter((ref) => ref.version_id === row.version_id);\n\t\t\tif (versionRefs.length > 0) {\n\t\t\t\tretainedVersionIds.push(row.version_id);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tconst loc = JSON.parse(row.location_json) as ArtifactLocation;\n\t\t\tif (loc.kind === \"managed\" && input.purgeManaged === true) {\n\t\t\t\trmSync(loc.dir, { recursive: true, force: true });\n\t\t\t}\n\t\t\t// 引用表无外键级联：先清 uses/refs 行再删版本行；索引对同步清除。\n\t\t\tstore.db.prepare(\"DELETE FROM artifact_uses WHERE version_id = ?\").run(row.version_id);\n\t\t\tstore.db.prepare(\"DELETE FROM artifact_refs WHERE version_id = ?\").run(row.version_id);\n\t\t\tstore.db.prepare(\"DELETE FROM artifact_versions WHERE version_id = ?\").run(row.version_id);\n\t\t\tdropArtifactFts(store.db, input.artifactId, row.version_id);\n\t\t\tpurgedVersionIds.push(row.version_id);\n\t\t}\n\t\tlet removed = false;\n\t\tif (retainedVersionIds.length === 0) {\n\t\t\tstore.db.prepare(\"DELETE FROM artifacts WHERE artifact_id = ?\").run(input.artifactId);\n\t\t\t// 登记行删除时清掉该成果全部索引行（无残留对）。\n\t\t\tdropArtifactFts(store.db, input.artifactId);\n\t\t\tremoved = true;\n\t\t}\n\t\treturn { ok: true, artifactId: input.artifactId, purgedVersionIds, retainedVersionIds, removed };\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// S6-10：记忆删除挂接——解除该记忆的成果引用\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 在删除计划执行（applyDatabasePlan 事务）内解除一批记忆的成果引用。\n * 只删 artifact_refs 中 ref_kind='memory' 且 owner_id 命中目标的行；\n * artifact_uses 的使用归因保留（已发生的使用不因记忆删除而消失）。\n */\nexport function unlinkArtifactRefsForMemories(db: DatabaseSync, memoryIds: readonly string[]): void {\n\tif (memoryIds.length === 0) return;\n\tconst stmt = db.prepare(`DELETE FROM artifact_refs WHERE ref_kind = 'memory' AND owner_id = ?`);\n\tfor (const memoryId of memoryIds) stmt.run(memoryId);\n}\n\n/**\n * 记忆修订关联成果版本的登记入口（供调用方在登记/纠正时挂接）。\n * 同一 (versionId, memoryId) 只记一条引用，幂等。\n */\nexport function linkArtifactToMemory(db: DatabaseSync, versionId: string, memoryId: string, createdAt: string): void {\n\tconst version = db.prepare(\"SELECT artifact_id FROM artifact_versions WHERE version_id = ?\").get(versionId) as\n\t\t| { artifact_id: string }\n\t\t| undefined;\n\tif (!version) throw new Error(`成果版本不存在:${versionId}`);\n\tdb.prepare(\n\t\t`INSERT OR IGNORE INTO artifact_refs (ref_id, artifact_id, version_id, ref_kind, owner_id, created_at)\n\t\t VALUES (?, ?, ?, 'memory', ?, ?)`,\n\t).run(`aref-${randomUUID()}`, version.artifact_id, versionId, memoryId, createdAt);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// S6-06：成果检索（artifact_fts 双路词法召回；不扩展 MEMORY_KINDS）\n// ════════════════════════════════════════════════════════════════════════\n\ninterface ArtifactFtsHitRow {\n\tartifact_id: string;\n\tversion_id: string;\n\trank: number;\n}\n\ninterface ArtifactMetaRow {\n\tartifact_id: string;\n\tname: string;\n\tpurpose: string;\n\tconditions: string;\n\tupdated_at: string;\n}\n\n/** 查询按空白/标点切词；trigram 需 ≥3 字符成组，短词进 LIKE 兜底（与 memory 检索同口径）。 */\nconst ARTIFACT_FTS_TERM_MIN = 3;\n\nfunction splitArtifactTerms(query: string): { ftsTerms: string[]; likeTerms: string[] } {\n\tconst chunks = query\n\t\t.split(/[\\s，。、；：？！()（）[\\]【】,.;:?!\"'\"\"'']+/)\n\t\t.map((s) => s.trim())\n\t\t.filter((s) => s.length > 0);\n\tconst ftsTerms: string[] = [];\n\tconst likeTerms: string[] = [];\n\tfor (const term of chunks) {\n\t\tif (term.length >= ARTIFACT_FTS_TERM_MIN) ftsTerms.push(term);\n\t\telse likeTerms.push(term);\n\t}\n\treturn { ftsTerms, likeTerms };\n}\n\n/**\n * 按名称/用途/条件检索成果定位（FTS MATCH + 短词 LIKE 回退双路）。\n * 命中只回 artifactId+versionId+摘要：成果正文由调用方按需走\n * resolveArtifactVersion，没有使用意图时不把整份脚本注入上下文。\n */\nexport function searchArtifacts(store: MemoryStore, input: SearchArtifactsInput): MemoryResult<SearchArtifactsResult> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn invalidInput(\"scope.projectId 不能为空\");\n\t}\n\tif (typeof input.query !== \"string\" || input.query.trim().length === 0) {\n\t\treturn invalidInput(\"query 不能为空\");\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn fail(\"unavailable\", \"检索已取消\");\n\t}\n\tconst limit = Math.max(1, input.limit ?? 5);\n\tconst perLane = Math.max(20, 4 * limit);\n\tconst { ftsTerms, likeTerms } = splitArtifactTerms(input.query);\n\tconst hits = new Map<string, { artifactId: string; versionId: string; rank: number }>();\n\n\t// FTS5 路：长词各取 MATCH 命中（trigram 按词面子串，不加运算语法）。\n\tif (ftsTerms.length > 0) {\n\t\tconst terms = [...ftsTerms];\n\t\tconst trimmed = input.query.trim();\n\t\tif (trimmed.length >= ARTIFACT_FTS_TERM_MIN && !terms.includes(trimmed)) terms.push(trimmed);\n\t\tfor (const term of terms) {\n\t\t\ttry {\n\t\t\t\tconst rows = store.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT f.artifact_id, f.version_id, f.rank\n\t\t\t\t\t\t FROM artifact_fts f\n\t\t\t\t\t\t JOIN artifacts a ON a.artifact_id = f.artifact_id\n\t\t\t\t\t\t WHERE artifact_fts MATCH ? AND a.project_id = ?\n\t\t\t\t\t\t ORDER BY f.rank\n\t\t\t\t\t\t LIMIT ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.all(`\"${term.replace(/\"/g, '\"\"')}\"`, input.scope.projectId, perLane) as unknown as ArtifactFtsHitRow[];\n\t\t\t\tfor (const row of rows) {\n\t\t\t\t\tconst key = `${row.artifact_id}#${row.version_id}`;\n\t\t\t\t\tconst existing = hits.get(key);\n\t\t\t\t\tif (!existing || row.rank < existing.rank) {\n\t\t\t\t\t\thits.set(key, { artifactId: row.artifact_id, versionId: row.version_id, rank: row.rank });\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// FTS 语法错误（极端输入）→ 该词跳过，走 LIKE 兜底集合。\n\t\t\t\tlikeTerms.push(term);\n\t\t\t}\n\t\t}\n\t}\n\n\t// LIKE 路：短词 + FTS 失败词走字面子串；查询整体也参与（完整短语命中）。\n\tconst likeSet = new Set(likeTerms);\n\tconst trimmedAll = input.query.trim();\n\tif (trimmedAll.length > 0) likeSet.add(trimmedAll);\n\tfor (const term of likeSet) {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT f.artifact_id, f.version_id\n\t\t\t\t FROM artifact_fts f\n\t\t\t\t JOIN artifacts a ON a.artifact_id = f.artifact_id\n\t\t\t\t WHERE f.content LIKE ? ESCAPE '\\\\' AND a.project_id = ?\n\t\t\t\t LIMIT ?`,\n\t\t\t)\n\t\t\t.all(\n\t\t\t\t`%${term.replace(/\\\\/g, \"\\\\\\\\\").replace(/%/g, \"\\\\%\").replace(/_/g, \"\\\\_\")}%`,\n\t\t\t\tinput.scope.projectId,\n\t\t\t\tperLane,\n\t\t\t) as unknown as Array<{ artifact_id: string; version_id: string }>;\n\t\tfor (const row of rows) {\n\t\t\tconst key = `${row.artifact_id}#${row.version_id}`;\n\t\t\tif (!hits.has(key)) {\n\t\t\t\thits.set(key, { artifactId: row.artifact_id, versionId: row.version_id, rank: 0 });\n\t\t\t}\n\t\t}\n\t}\n\tif (input.signal?.aborted) {\n\t\treturn fail(\"unavailable\", \"检索已取消\");\n\t}\n\n\t// FTS rank 越小越好（BM25 负分，小=更相关）；LIKE 命中 rank=0 排后按 id 稳定。\n\tconst ordered = [...hits.values()]\n\t\t.sort((a, b) =>\n\t\t\ta.rank !== b.rank\n\t\t\t\t? a.rank - b.rank\n\t\t\t\t: `${a.artifactId}#${a.versionId}`.localeCompare(`${b.artifactId}#${b.versionId}`),\n\t\t)\n\t\t.slice(0, limit);\n\n\t// 回表核对成果与版本仍存在（索引可能滞后于删除的极端窗口）。\n\tconst metaStmt = store.db.prepare(\n\t\t\"SELECT artifact_id, name, purpose, conditions, updated_at FROM artifacts WHERE artifact_id = ?\",\n\t);\n\tconst resultHits: ArtifactSearchHit[] = [];\n\tfor (const hit of ordered) {\n\t\tconst meta = metaStmt.get(hit.artifactId) as ArtifactMetaRow | undefined;\n\t\tif (!meta) continue;\n\t\tconst version = versionRow(store.db, hit.versionId);\n\t\tif (!version || version.artifact_id !== hit.artifactId) continue;\n\t\tresultHits.push({\n\t\t\tartifactId: hit.artifactId,\n\t\t\tversionId: hit.versionId,\n\t\t\tname: meta.name,\n\t\t\tpurpose: meta.purpose,\n\t\t\tconditions: meta.conditions,\n\t\t\t...(version.source_tool_name === null ? {} : { sourceToolName: version.source_tool_name }),\n\t\t\trelevance: hit.rank === 0 ? 0.5 : Math.min(1, -hit.rank),\n\t\t\tupdatedAt: meta.updated_at,\n\t\t});\n\t}\n\tconst result: SearchArtifactsResult = { hits: resultHits };\n\tif (resultHits.length === 0) {\n\t\tresult.emptyReason = \"无命中：成果索引无匹配（名称/用途/条件均未覆盖查询词）\";\n\t}\n\treturn { ok: true, ...result };\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S7-09：记忆数据库与归档的一致性备份/恢复（O07 修复 F07/F08/F15）。\n * * - 返回计数供结果如实汇报。\n */\nfunction purgeExcludedContent(\n\tdb: DatabaseSync,at: string,\n): {\n\tfts: number;\n\tvectors: number;\tconst fullyPurgedMemoryIds: string[] = [];\n\tfor (const [memoryId, revisions] of victimSet) {\n\t\tconst total = db\n\t\t\t.preparedb.prepare(`SELECT COUNT(*) AS n FROM memory_revisions WHERE memory_id = ?`)\n\t\t\t.get(memoryId) as {n: number;\n\t\t};\n\t\tconst current = db.prepare(`SELECT current_revision FROM memories WHERE id = ?`).get(memoryId) as\n\t\t\t| { current_revision: number }\t\tdb.prepare(`DELETE FROM revision_links WHERE memory_id = ?`).run(memoryId);\n\t\tdb.prepare(`DELETE FROM revision_links WHERE target_memory_id = ?`).run(memoryId);\n\t\tpurgedRevisions += Number(db.prepare(`DELETE FROM memory_revisions WHERE memory_id = ?`).run(memoryId).changes,\n\t\t);\n\t\tdb.prepare(`DELETE FROM memories WHERE id = ?`).run(memoryId);\n\t}\t}\n}\n","ops":[{"diffOp":{"equal":{"range":[0,98]}}},{"equalLines":{"line_count":450}},{"diffOp":{"equal":{"range":[98,174]}}},{"diffOp":{"insert":{"range":[174,176]}}},{"diffOp":{"equal":{"range":[176,193]}}},{"diffOp":{"delete":{"range":[98,99]}}},{"diffOp":{"insert":{"range":[174,176]}}},{"diffOp":{"equal":{"range":[193,203]}}},{"diffOp":{"insert":{"range":[203,205]}}},{"diffOp":{"equal":{"range":[205,241]}}},{"equalLines":{"line_count":36}},{"diffOp":{"equal":{"range":[241,351]}}},{"diffOp":{"delete":{"range":[351,365]}}},{"diffOp":{"insert":{"range":[365,375]}}},{"diffOp":{"equal":{"range":[375,441]}}},{"diffOp":{"delete":{"range":[441,445]}}},{"diffOp":{"equal":{"range":[445,464]}}},{"diffOp":{"delete":{"range":[98,99]}}},{"diffOp":{"insert":{"range":[441,445]}}},{"diffOp":{"equal":{"range":[464,473]}}},{"diffOp":{"delete":{"range":[98,99]}}},{"diffOp":{"insert":{"range":[473,477]}}},{"diffOp":{"equal":{"range":[477,613]}}},{"equalLines":{"line_count":59}},{"diffOp":{"equal":{"range":[613,804]}}},{"diffOp":{"delete":{"range":[441,445]}}},{"diffOp":{"equal":{"range":[804,888]}}},{"diffOp":{"delete":{"range":[888,892]}}},{"diffOp":{"equal":{"range":[892,962]}}},{"equalLines":{"line_count":323}},{"diffOp":{"equal":{"range":[962,967]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\backup.ts"},"span":null,"sourceCode":"/**\n * S7-09：记忆数据库与归档的一致性备份/恢复（O07 修复 F07/F08/F15）。\n *\n * 契约：\n * - 备份用 `VACUUM INTO`（经 db.exec）取 SQLite 一致性快照，输出一份非 WAL\n *   的干净主库文件，不直接复制活跃 WAL 主库文件；只用 Node 与 Electron\n *   内嵌 node:sqlite 共有的 API（exec/prepare/VACUUM INTO），不依赖\n *   serialize/deserialize/backup（Electron 37/Node 22 的 DatabaseSync 没有）。\n *   归档段按 archive_segments 行登记复制到备份目录，行内容随快照入库；\n *   受管成果（artifact_versions 里 location.kind=\"managed\"）副本文件同样\n *   复制进备份目录并在 manifest 登记。\n * - `createMemoryBackup` 是「archive」jobKind 的维护作业：走 extraction_jobs\n *   队列领取后再执行，满足「暂停本 home 记忆写作业」的语义——领取后其他\n *   写入者仍可向主库写（VACUUM INTO 是一致读快照，拷贝的段文件是只读副本），\n *   但备份期间不开展提炼/规整/嵌入等付费维护作业（队列已被本作业占用）。\n * - `restoreMemoryBackup` 把备份恢复到目标新目录：\n *   1) 目标目录已存在且非空 → invalid_input（不覆盖现有 home）；\n *   2) 先保存「当前最新」exclusion 源（调用方可传 liveHome 表示当前现场，\n *      从其库读 source_exclusions 快照；不传则以备份内 exclusion 为准）；\n *   3) 快照文件直接复制为目标 memory.sqlite，按 manifest 复制段文件与\n *      受管成果副本，并在恢复库内把 archive_segments 的\n *      original_path/compressed_path 与 artifact_versions.location_json 的\n *      dir 重写到新落点（不写回旧 home 绝对路径）；\n *   4) 把当前 exclusion 重放进恢复后的库（INSERT 去重），并按「整体被排除\n *      且不再被有效记忆引用」的既有语义（复用 sources.ts 的\n *      isSourceGloballyExcluded 口径）清对应记忆正本、修订、来源行与\n *      FTS/向量/usage/links/task_continuations 正文——恢复后按 ID/原文/\n *      索引都不返回已删正文；\n *   5) 返回 RestoreMemoryBackupResult，含备份自身 exclusion 缺口的\n *      limitation 说明——独立旧备份如果没有后续删除记录，无法推断后来\n *      删除了什么，不承诺自动补全。\n * - 快照与段清单写 manifest.json（版本 1），便于无库工具检查与排障；\n *   manifest 只含身份与路径，不含正文。manifest 新增 artifacts 段时旧\n *   manifest（无该字段）按空清单兼容读取。\n */\nimport { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from \"node:fs\";\nimport { dirname, join, relative, resolve } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { unlinkArtifactRefsForMemories } from \"./artifacts.ts\";\nimport { rewriteSegmentFile } from \"./deletion.ts\";\nimport { memoryPaths } from \"./paths.ts\";\nimport { isSourceGloballyExcluded } from \"./sources.ts\";\nimport { type MemoryStore, openMemoryStore } from \"./store.ts\";\nimport type { ArtifactLocation, MemoryError, MemoryResult } from \"./types.ts\";\n\nconst MANIFEST_VERSION = 1;\n\n// ════════════════════════════════════════════════════════════════════════\n// manifest\n// ════════════════════════════════════════════════════════════════════════\n\n/** manifest.json 的一段归档文件登记。 */\nexport interface BackupSegmentEntry {\n\tsegmentId: string;\n\tsessionId: string;\n\t/** 相对备份根的路径（segments/<sessionId>/<file>）。 */\n\tbackupPath: string;\n\t/** 原登记的 original_path（可为空——封存崩溃窗口只走 .gz）。 */\n\toriginalPath?: string;\n\t/** 原登记的 compressed_path。 */\n\tcompressedPath?: string;\n\tstatus: string;\n\t/** 复制文件的字节数；源文件缺失时 undefined。 */\n\tsizeBytes?: number;\n\t/**\n\t * O07 修复后不再计算：恢复端不消费摘要，备份期整文件重读只为出 sha256\n\t * 没有校验收益。字段保留以维持 manifest 公共形状（旧 manifest 可含值）。\n\t */\n\tsha256?: string;\n}\n\n/** manifest.json 的一个受管成果文件登记（O07/F07 新增）。 */\nexport interface BackupArtifactFileEntry {\n\tartifactId: string;\n\tversionId: string;\n\t/** 相对备份根的路径（artifacts/<artifactId>/<versionId>/<file>）。 */\n\tbackupPath: string;\n\t/** 受管副本内文件名（location.file）。 */\n\tfile: string;\n\t/** 原登记的 location.dir（只作排障参考）。 */\n\toriginalDir: string;\n\tsizeBytes?: number;\n\t/** 同 BackupSegmentEntry.sha256：不再计算，仅保留字段形状兼容旧 manifest。 */\n\tsha256?: string;\n}\n\n/** manifest.json 内容。 */\nexport interface BackupManifest {\n\tversion: typeof MANIFEST_VERSION;\n\t/** 备份生成时间（调用方注入）。 */\n\tcreatedAt: string;\n\t/** 来源 PAO_HOME 根（只作排障参考，恢复不依赖）。 */\n\tsourceHome: string;\n\t/** 快照文件相对备份根路径（固定 memory.snapshot）。 */\n\tsnapshotPath: string;\n\t/** 备份时刻库内 exclusion 行数。 */\n\texclusionCount: number;\n\t/** 备份时刻库内记忆条数。 */\n\tmemoryCount: number;\n\t/** 拷贝的归档段清单。 */\n\tsegments: BackupSegmentEntry[];\n\t/**\n\t * 拷贝的受管成果文件清单（O07/F07）。kind=\"git\" 的版本不入列——\n\t * Git 对象由仓自身保留，备份只保留版本引用。\n\t * 旧版本 manifest 无此字段，恢复端按缺省空清单读取。\n\t */\n\tartifacts?: BackupArtifactFileEntry[];\n\t/**\n\t * 恢复限制：备份自身无法声明「备份后现场又删了什么」；\n\t * 始终为真，文案固定，供界面如实展示。\n\t */\n\tlimitation: string;\n}\n\ninterface SegmentDbRow {\n\tsegment_id: string;\n\tsession_id: string;\n\toriginal_path: string | null;\n\tcompressed_path: string | null;\n\tstatus: string;\n\tcreated_at: string;\n}\n\ninterface ManagedVersionDbRow {\n\tversion_id: string;\n\tartifact_id: string;\n\tlocation_json: string;\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): { ok: false; error: MemoryError } {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n\n/** 段文件名消毒（与 archive.ts 的 safeDirName 同口径）。 */\nfunction safeName(value: string): string {\n\tconst cleaned = value.replace(/[^A-Za-z0-9._-]/g, \"_\");\n\treturn cleaned.length > 0 ? cleaned : \"_\";\n}\n\n/** 段在备份/恢复目录下的落点：segments/<sessionId>/<file>。 */\nfunction segmentBackupRelPath(row: SegmentDbRow, compressed: boolean): string {\n\tconst dir = join(\"segments\", safeName(row.session_id));\n\tconst file = `${safeName(row.segment_id)}.jsonl${compressed ? \".gz\" : \"\"}`;\n\treturn join(dir, file);\n}\n\n/** 受管成果文件在备份/恢复目录下的落点：artifacts/<artifactId>/<versionId>/<file>。 */\nfunction artifactBackupRelPath(artifactId: string, versionId: string, file: string): string {\n\treturn join(\"artifacts\", safeName(artifactId), safeName(versionId), safeName(file));\n}\n\n/** VACUUM INTO 目标路径的单引号转义（SQLite 字符串字面量口径）。 */\nfunction vacuumIntoSql(target: string): string {\n\treturn `VACUUM INTO '${target.replace(/'/g, \"''\")}'`;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 备份\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface CreateMemoryBackupInput {\n\t/** 来源 PAO_HOME 根。 */\n\thome: string;\n\t/** 备份输出目录（不存在则创建；已存在则必须为空）。 */\n\tbackupDir: string;\n\t/** 备份时间（夹具注入）。 */\n\tcreatedAt?: string;\n}\n\nexport interface CreateMemoryBackupResult {\n\tbackupDir: string;\n\tmanifestPath: string;\n\tsnapshotPath: string;\n\tmemoryCount: number;\n\texclusionCount: number;\n\t/** 成功复制的段文件数。 */\n\tcopiedSegments: number;\n\t/** 源文件缺失被跳过、只登记身份的段数。 */\n\tmissingSegments: number;\n\t/** 成功复制的受管成果文件数。 */\n\tcopiedArtifacts: number;\n\t/** 源文件缺失被跳过的受管成果文件数。 */\n\tmissingArtifacts: number;\n}\n\n/**\n * 生成一个一致性备份。\n *\n * 步骤：`VACUUM INTO` 主库到 `memory.snapshot` → 从快照文件读段行/受管行/\n * 计数（清单与快照同一时刻，不经活动库拼）→ 按行复制段文件到 `segments/` →\n * 复制受管成果副本到 `artifacts/` → 写 `manifest.json`。\n * 源段文件缺失不使备份失败——只登记身份并在 manifest 里留下缺口\n * （恢复后读该来源如实 source_missing）。\n */\nexport function createMemoryBackup(\n\tstore: MemoryStore,\n\tinput: CreateMemoryBackupInput,\n): MemoryResult<CreateMemoryBackupResult> {\n\tconst home = resolve(input.home);\n\tconst backupDir = resolve(input.backupDir);\n\tconst createdAt = input.createdAt ?? new Date().toISOString();\n\n\tif (existsSync(backupDir)) {\n\t\tconst entries = readdirSync(backupDir);\n\t\tif (entries.length > 0) {\n\t\t\treturn fail(\"invalid_input\", `备份目录非空，拒绝覆盖:${backupDir}`);\n\t\t}\n\t}\n\tmkdirSync(join(backupDir, \"segments\"), { recursive: true });\n\n\t// VACUUM INTO 要求目标文件不存在；输出是一份非 WAL 的一致性主库镜像。\n\tconst snapshotPath = join(backupDir, \"memory.snapshot\");\n\tstore.db.exec(vacuumIntoSql(snapshotPath));\n\n\t// R1：清单必须与快照同一时刻。段行、受管成果行与计数全部从快照文件读，\n\t// 不回到活动库分次拼——取快照后活动库可能继续被其他写入者登记新段，\n\t// 从活动库补读会让清单与库内数据脱节（并发登记的新段快照有、清单没有）。\n\tconst snapshotDb = new DatabaseSync(snapshotPath, { readOnly: true });\n\tlet segmentRows: SegmentDbRow[];\n\tlet counts: { memories: number; exclusions: number };\n\tlet managedRows: ManagedVersionDbRow[];\n\ttry {\n\t\tsegmentRows = snapshotDb\n\t\t\t.prepare(\n\t\t\t\t`SELECT segment_id, session_id, original_path, compressed_path, status, created_at\n\t\t\t\t FROM archive_segments ORDER BY created_at, segment_id`,\n\t\t\t)\n\t\t\t.all() as unknown as SegmentDbRow[];\n\t\tcounts = snapshotDb\n\t\t\t.prepare(\n\t\t\t\t`SELECT\n\t\t\t\t   (SELECT COUNT(*) FROM memories) AS memories,\n\t\t\t\t   (SELECT COUNT(*) FROM source_exclusions) AS exclusions`,\n\t\t\t)\n\t\t\t.get() as { memories: number; exclusions: number };\n\t\t// O07/F07：受管成果副本纳入备份（kind=\"git\" 的版本不入列——Git 对象由仓自身保留）。\n\t\tmanagedRows = snapshotDb\n\t\t\t.prepare(\n\t\t\t\t`SELECT version_id, artifact_id, location_json\n\t\t\t\t FROM artifact_versions\n\t\t\t\t WHERE json_extract(location_json, '$.kind') = 'managed'\n\t\t\t\t ORDER BY artifact_id, version_id`,\n\t\t\t)\n\t\t\t.all() as unknown as ManagedVersionDbRow[];\n\t} finally {\n\t\tsnapshotDb.close();\n\t}\n\n\tconst segments: BackupSegmentEntry[] = [];\n\tlet copied = 0;\n\tlet missing = 0;\n\tfor (const row of segmentRows) {\n\t\tconst entry: BackupSegmentEntry = {\n\t\t\tsegmentId: row.segment_id,\n\t\t\tsessionId: row.session_id,\n\t\t\tbackupPath: \"\",\n\t\t\t...(row.original_path === null ? {} : { originalPath: row.original_path }),\n\t\t\t...(row.compressed_path === null ? {} : { compressedPath: row.compressed_path }),\n\t\t\tstatus: row.status,\n\t\t};\n\t\t// 每段可能有两个源（.jsonl 原样保留 / .jsonl.gz 已封存），按登记行选一个真实存在的；\n\t\t// 崩溃窗口行标 unsealed 但 .gz 已发布——两个候选都试。\n\t\tconst candidates: Array<{ path: string; compressed: boolean }> = [];\n\t\tif (row.compressed_path) candidates.push({ path: row.compressed_path, compressed: true });\n\t\tif (row.original_path) {\n\t\t\tcandidates.push({ path: row.original_path, compressed: false });\n\t\t\tcandidates.push({ path: `${row.original_path}.gz`, compressed: true });\n\t\t}\n\t\tconst source = candidates.find((c) => existsSync(c.path));\n\t\tif (source === undefined) {\n\t\t\tmissing += 1;\n\t\t\tentry.backupPath = \"\";\n\t\t\tsegments.push(entry);\n\t\t\tcontinue;\n\t\t}\n\t\tconst rel = segmentBackupRelPath(row, source.compressed);\n\t\tconst dest = join(backupDir, rel);\n\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\tcopyFileSync(source.path, dest);\n\t\tentry.backupPath = rel;\n\t\tentry.sizeBytes = statSync(dest).size;\n\t\tcopied += 1;\n\t\tsegments.push(entry);\n\t}\n\n\tconst artifacts: BackupArtifactFileEntry[] = [];\n\tlet copiedArtifacts = 0;\n\tlet missingArtifacts = 0;\n\tfor (const row of managedRows) {\n\t\tconst location = JSON.parse(row.location_json) as Extract<ArtifactLocation, { kind: \"managed\" }>;\n\t\tconst source = join(location.dir, location.file);\n\t\tconst entry: BackupArtifactFileEntry = {\n\t\t\tartifactId: row.artifact_id,\n\t\t\tversionId: row.version_id,\n\t\t\tbackupPath: \"\",\n\t\t\tfile: location.file,\n\t\t\toriginalDir: location.dir,\n\t\t};\n\t\tif (!existsSync(source)) {\n\t\t\tmissingArtifacts += 1;\n\t\t\tartifacts.push(entry);\n\t\t\tcontinue;\n\t\t}\n\t\tconst rel = artifactBackupRelPath(row.artifact_id, row.version_id, location.file);\n\t\tconst dest = join(backupDir, rel);\n\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\tcopyFileSync(source, dest);\n\t\tentry.backupPath = rel;\n\t\tentry.sizeBytes = statSync(dest).size;\n\t\tcopiedArtifacts += 1;\n\t\tartifacts.push(entry);\n\t}\n\n\tconst manifest: BackupManifest = {\n\t\tversion: MANIFEST_VERSION,\n\t\tcreatedAt,\n\t\tsourceHome: home,\n\t\tsnapshotPath: \"memory.snapshot\",\n\t\texclusionCount: counts.exclusions,\n\t\tmemoryCount: counts.memories,\n\t\tsegments,\n\t\tartifacts,\n\t\tlimitation:\n\t\t\t\"本备份只能还原到备份时刻状态；备份之后产生的删除排除记录不包含在内，恢复后须以当前现场的最新排除为准。\",\n\t};\n\tconst manifestPath = join(backupDir, \"manifest.json\");\n\twriteFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\\n`, \"utf8\");\n\n\treturn {\n\t\tok: true,\n\t\tbackupDir,\n\t\tmanifestPath,\n\t\tsnapshotPath,\n\t\tmemoryCount: counts.memories,\n\t\texclusionCount: counts.exclusions,\n\t\tcopiedSegments: copied,\n\t\tmissingSegments: missing,\n\t\tcopiedArtifacts,\n\t\tmissingArtifacts,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 恢复\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface RestoreMemoryBackupInput {\n\t/** 备份目录（含 manifest.json 与 memory.snapshot）。 */\n\tbackupDir: string;\n\t/** 恢复目标 PAO_HOME 根（不存在则创建；已存在则必须无 memory/ 子目录或为空）。 */\n\ttargetHome: string;\n\t/**\n\t * 当前最新 exclusion 所在的现场 home。\n\t * 传入时从该 home 的库读 source_exclusions 快照并重放到恢复库；\n\t * 不传则只以备份内自带 exclusion 为准（独立旧备份场景）。\n\t */\n\tliveHome?: string;\n\t/** 恢复时间（夹具注入）。 */\n\trestoredAt?: string;\n}\n\nexport interface RestoreMemoryBackupResult {\n\ttargetHome: string;\n\tdatabase: string;\n\trestoredSegments: number;\n\t/** 复制的受管成果文件数。 */\n\trestoredArtifacts: number;\n\t/** 恢复库内 exclusion 总数（重放后）。 */\n\texclusionCount: number;\n\t/** 本次从 liveHome 重放进来的 exclusion 条数（未传 liveHome 为 0）。 */\n\treplayedExclusions: number;\n\t/** 因 exclusion 命中的 FTS 清理行数。 */\n\tclearedFts: number;\n\t/** 因 exclusion 命中的向量清理行数。 */\n\tclearedVectors: number;\n\t/** 重放排除后物理清除的记忆正本行数。 */\n\tpurgedMemories: number;\n\t/** 重放排除后物理清除的修订行数。 */\n\tpurgedRevisions: number;\n\t/** 重放排除后物理清除的来源行数。 */\n\tpurgedSources: number;\n\t/** 归档段中被整体排除条目重写的行数（未能重写的计入 limitation）。 */\n\tredactedArchiveLines: number;\n\t/** 恢复限制文案（独立旧备份或残留清理不全时如实展示）。 */\n\tlimitation: string;\n\tmanifest: BackupManifest;\n}\n\ninterface ExclusionRow {\n\texclusion_id: string;\n\tmemory_id: string | null;\n\tsource_id: string | null;\n\tsession_id: string | null;\n\tentry_id: string | null;\n\treason: string | null;\n\tcreated_at: string;\n}\n\nfunction readManifest(backupDir: string): BackupManifest | undefined {\n\tconst path = join(backupDir, \"manifest.json\");\n\tif (!existsSync(path)) return undefined;\n\ttry {\n\t\tconst parsed = JSON.parse(readFileSync(path, \"utf8\")) as BackupManifest;\n\t\treturn parsed.version === MANIFEST_VERSION ? parsed : undefined;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\nfunction readExclusions(db: DatabaseSync): ExclusionRow[] {\n\tconst table = db.prepare(`SELECT 1 AS ok FROM sqlite_master WHERE type='table' AND name='source_exclusions'`).get();\n\tif (!table) return [];\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT exclusion_id, memory_id, source_id, session_id, entry_id, reason, created_at\n\t\t\t FROM source_exclusions`,\n\t\t)\n\t\t.all() as unknown as ExclusionRow[];\n}\n\n/** 把 exclusion 行重放进恢复库（INSERT OR IGNORE，按 exclusion_id 幂等）。 */\nfunction replayExclusions(db: DatabaseSync, rows: ExclusionRow[], restoredAt: string): number {\n\tconst insert = db.prepare(\n\t\t`INSERT OR IGNORE INTO source_exclusions\n\t\t (exclusion_id, memory_id, source_id, session_id, entry_id, reason, created_at)\n\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t);\n\tlet applied = 0;\n\tfor (const row of rows) {\n\t\tconst result = insert.run(\n\t\t\trow.exclusion_id,\n\t\t\trow.memory_id,\n\t\t\trow.source_id,\n\t\t\trow.session_id,\n\t\t\trow.entry_id,\n\t\t\trow.reason ?? `恢复重放 ${restoredAt}`,\n\t\t\trow.created_at,\n\t\t);\n\t\tif (result.changes > 0) applied += 1;\n\t}\n\treturn applied;\n}\n\n/**\n * O07/F08：按库内 exclusion 清理被排除来源及其关联正本。\n *\n * 口径复用 sources.ts 的 isSourceGloballyExcluded（「整体被排除且不再被\n * 有效记忆引用」），不自造判定：\n * - 对每条整体被排除的来源，取其全部引用修订 → 关联记忆若全部修订都\n *   被排除，则正本/修订/来源行与派生内容一并清除（与 applyDatabasePlan\n *   同款 DELETE 组）；\n * - 只命中部分修订的共享保留记忆不动正本，只清命中修订的 FTS/向量；\n * - task_continuations 正文按排除命中清空（content_available=0）；\n * - 返回计数供结果如实汇报。\n */\nfunction purgeExcludedContent(db: DatabaseSync, at: string): {\n\tfts: number;\n\tvectors: number;\n\tmemories: number;\n\trevisions: number;\n\tsources: number;\n} {\n\tconst sourceRows = db\n\t\t.prepare(`SELECT source_id, session_id, entry_id FROM sources ORDER BY source_id`)\n\t\t.all() as unknown as Array<{ source_id: string; session_id: string; entry_id: string }>;\n\tconst globallyExcluded = sourceRows.filter((row) => isSourceGloballyExcluded(db, { sourceId: row.source_id }));\n\tconst excludedSourceIds = new Set(globallyExcluded.map((row) => row.source_id));\n\n\t// 命中修订分两类：\n\t// - 排除行带 memory_id 的「该记忆被删」标记 → 该记忆全部修订命中；\n\t// - 整体被排除来源 → 其全部引用修订命中（共享保留来源不命中）。\n\tconst victimSet = new Map<string, Set<number>>();\n\tconst addVictim = (memoryId: string, revision: number): void => {\n\t\tconst set = victimSet.get(memoryId) ?? new Set<number>();\n\t\tset.add(revision);\n\t\tvictimSet.set(memoryId, set);\n\t};\n\tfor (const row of db\n\t\t.prepare(`SELECT DISTINCT memory_id FROM source_exclusions WHERE memory_id IS NOT NULL`)\n\t\t.all() as unknown as Array<{ memory_id: string }>) {\n\t\tfor (const rev of db\n\t\t\t.prepare(`SELECT revision FROM memory_revisions WHERE memory_id = ?`)\n\t\t\t.all(row.memory_id) as unknown as Array<{ revision: number }>) {\n\t\t\taddVictim(row.memory_id, rev.revision);\n\t\t}\n\t}\n\tfor (const row of db\n\t\t.prepare(`SELECT memory_id, revision, source_id FROM memory_source_links`)\n\t\t.all() as unknown as Array<{ memory_id: string; revision: number; source_id: string }>) {\n\t\tif (!excludedSourceIds.has(row.source_id)) continue;\n\t\taddVictim(row.memory_id, row.revision);\n\t}\n\n\t// 全修订被排除的记忆才清正本；部分命中的保留其余修订。\n\tconst fullyPurgedMemoryIds: string[] = [];\n\tfor (const [memoryId, revisions] of victimSet) {\n\t\tconst total = db\n\t\t\t.prepare(`SELECT COUNT(*) AS n FROM memory_revisions WHERE memory_id = ?`)\n\t\t\t.get(memoryId) as { n: number };\n\t\tconst current = db.prepare(`SELECT current_revision FROM memories WHERE id = ?`).get(memoryId) as\n\t\t\t| { current_revision: number }\n\t\t\t| undefined;\n\t\tif (current === undefined) continue;\n\t\tif (revisions.size >= total.n && revisions.has(current.current_revision)) {\n\t\t\tfullyPurgedMemoryIds.push(memoryId);\n\t\t}\n\t}\n\n\t// task_continuations 正文清（与 applyDatabasePlan 同款 UPDATE 口径）。\n\tdb.prepare(\n\t\t`UPDATE task_continuations\n\t\t SET workpoint = '',\n\t\t     workpoint_evidence_refs_json = '[]',\n\t\t     blocker = NULL,\n\t\t     blocker_evidence_kind = NULL,\n\t\t     blocker_evidence_refs_json = NULL,\n\t\t     next_step = '',\n\t\t     next_step_evidence_refs_json = '[]',\n\t\t     content_available = 0,\n\t\t     unavailable_reason = '来源已删除或排除',\n\t\t     updated_at = ?\n\t\t WHERE EXISTS (\n\t\t   SELECT 1\n\t\t   FROM task_continuation_sources s\n\t\t   JOIN source_exclusions e\n\t\t     ON e.source_id = s.source_id\n\t\t     OR (e.session_id = s.session_id AND e.entry_id = s.entry_id)\n\t\t   WHERE s.project_id = task_continuations.project_id\n\t\t     AND s.task_id = task_continuations.task_id\n\t\t )`,\n\t).run(at);\n\n\t// 先解除整删记忆的成果引用（ref_kind='memory'）。\n\tunlinkArtifactRefsForMemories(db, fullyPurgedMemoryIds);\n\n\tlet fts = 0;\n\tlet vectors = 0;\n\tconst deleteFts = db.prepare(`DELETE FROM memory_fts WHERE memory_id = ? AND revision = ?`);\n\tconst deleteVec = db.prepare(`DELETE FROM memory_vectors WHERE memory_id = ? AND revision = ?`);\n\tfor (const [memoryId, revisions] of victimSet) {\n\t\tfor (const revision of revisions) {\n\t\t\tfts += Number(deleteFts.run(memoryId, revision).changes);\n\t\t\tvectors += Number(deleteVec.run(memoryId, revision).changes);\n\t\t}\n\t}\n\n\t// 整删记忆引用的全部来源候选清行（不再被任何修订引用才落 DELETE）。\n\tconst purgedMemorySourceIds = new Set<string>();\n\tfor (const memoryId of fullyPurgedMemoryIds) {\n\t\tfor (const row of db\n\t\t\t.prepare(`SELECT DISTINCT source_id FROM memory_source_links WHERE memory_id = ?`)\n\t\t\t.all(memoryId) as unknown as Array<{ source_id: string }>) {\n\t\t\tpurgedMemorySourceIds.add(row.source_id);\n\t\t}\n\t}\n\n\tlet purgedRevisions = 0;\n\tfor (const memoryId of fullyPurgedMemoryIds) {\n\t\tdb.prepare(`DELETE FROM memory_usage WHERE memory_id = ?`).run(memoryId);\n\t\tdb.prepare(`DELETE FROM memory_source_links WHERE memory_id = ?`).run(memoryId);\n\t\tdb.prepare(`DELETE FROM revision_links WHERE memory_id = ?`).run(memoryId);\n\t\tdb.prepare(`DELETE FROM revision_links WHERE target_memory_id = ?`).run(memoryId);\n\t\tpurgedRevisions += Number(\n\t\t\tdb.prepare(`DELETE FROM memory_revisions WHERE memory_id = ?`).run(memoryId).changes,\n\t\t);\n\t\tdb.prepare(`DELETE FROM memories WHERE id = ?`).run(memoryId);\n\t}\n\n\t// 来源行删除：清整体排除来源 + 整删记忆的来源行（不再被任何修订引用才落 DELETE）。\n\t// R2：source_fts 只对「最终确实删除」的来源清——仍被存活记忆引用的共享保留来源\n\t// 行在索引也在，否则来源保留可读但历史检索失效。判定与来源行删除一致。\n\tconst deleteSourceFts = db.prepare(`DELETE FROM source_fts WHERE source_id = ?`);\n\tconst deleteSource = db.prepare(\n\t\t`DELETE FROM sources\n\t\t WHERE source_id = ?\n\t\t   AND NOT EXISTS (SELECT 1 FROM memory_source_links WHERE source_id = ?)`,\n\t);\n\tconst sourceStillLinked = db.prepare(`SELECT 1 AS ok FROM memory_source_links WHERE source_id = ? LIMIT 1`);\n\tlet purgedSources = 0;\n\tfor (const sourceId of new Set([...excludedSourceIds, ...purgedMemorySourceIds])) {\n\t\t// 与 deleteSource 的 NOT EXISTS 守卫同口径：仍有引用则行留、索引也留。\n\t\tif (sourceStillLinked.get(sourceId) !== undefined) continue;\n\t\tdeleteSourceFts.run(sourceId);\n\t\tpurgedSources += Number(deleteSource.run(sourceId, sourceId).changes);\n\t}\n\n\treturn {\n\t\tfts,\n\t\tvectors,\n\t\tmemories: fullyPurgedMemoryIds.length,\n\t\trevisions: purgedRevisions,\n\t\tsources: purgedSources,\n\t};\n}\n\n/**\n * 把恢复库的 archive_segments 行重写到新落点（F07 恢复重定位）。\n * R3：副本不可用（backupPath 空或备份文件缺失）的段也要解除旧 home 路径——\n * original_path/compressed_path 置 NULL，让 readSourceEvents 如实\n * source_missing，绝不回读旧现场。\n */\nfunction relocateArchiveSegments(\n\tdb: DatabaseSync,\n\tmanifest: BackupManifest,\n\tbackupDir: string,\n\ttargetArchivesRoot: string,\n): { relocated: number } {\n\tconst updateCompressed = db.prepare(\n\t\t`UPDATE archive_segments SET compressed_path = ?, original_path = NULL WHERE segment_id = ?`,\n\t);\n\tconst updateOriginal = db.prepare(\n\t\t`UPDATE archive_segments SET original_path = ?, compressed_path = NULL WHERE segment_id = ?`,\n\t);\n\tconst clearPaths = db.prepare(\n\t\t`UPDATE archive_segments SET original_path = NULL, compressed_path = NULL WHERE segment_id = ?`,\n\t);\n\tlet relocated = 0;\n\tfor (const entry of manifest.segments) {\n\t\tif (!entry.backupPath) {\n\t\t\tclearPaths.run(entry.segmentId);\n\t\t\tcontinue;\n\t\t}\n\t\tconst backupSource = join(backupDir, entry.backupPath);\n\t\tif (!existsSync(backupSource)) {\n\t\t\tclearPaths.run(entry.segmentId);\n\t\t\tcontinue;\n\t\t}\n\t\tconst dest = join(targetArchivesRoot, relative(\"segments\", entry.backupPath));\n\t\tif (entry.backupPath.endsWith(\".gz\")) {\n\t\t\tupdateCompressed.run(dest, entry.segmentId);\n\t\t} else {\n\t\t\tupdateOriginal.run(dest, entry.segmentId);\n\t\t}\n\t\trelocated += 1;\n\t}\n\treturn { relocated };\n}\n\n/**\n * 恢复受管成果副本并把 location_json.dir 重写到新落点（F07）。\n * kind=\"git\" 的版本不动——Git 对象由仓自身保留。\n * R3：副本不可用（backupPath 空、备份文件缺失）与旧版 manifest 无 artifacts\n * 清单的版本，都把 location.dir 重写到目标 home 预期位置——文件不存在时\n * resolveArtifactVersion 如实 available:false，绝不回读旧 home。\n */\nfunction restoreManagedArtifacts(\n\tdb: DatabaseSync,\n\tmanifest: BackupManifest,\n\tbackupDir: string,\n\ttargetArtifactsRoot: string,\n): { restored: number; missing: number } {\n\tconst updateLocation = db.prepare(`UPDATE artifact_versions SET location_json = ? WHERE version_id = ?`);\n\tconst managedRows = db\n\t\t.prepare(\n\t\t\t`SELECT version_id, artifact_id, location_json\n\t\t\t FROM artifact_versions\n\t\t\t WHERE json_extract(location_json, '$.kind') = 'managed'`,\n\t\t)\n\t\t.all() as unknown as Array<{ version_id: string; artifact_id: string; location_json: string }>;\n\tconst entries = manifest.artifacts ?? [];\n\tconst entryByVersion = new Map(entries.map((entry) => [entry.versionId, entry]));\n\n\tlet restored = 0;\n\tlet missing = 0;\n\t// 库内全部 managed 版本都在重定位范围：manifest 登记了按登记处理，未登记\n\t// （旧版 manifest 或漏记）按缺失处理——不留旧 home 绝对路径作隐式回读源。\n\tfor (const row of managedRows) {\n\t\tconst location = JSON.parse(row.location_json) as Extract<ArtifactLocation, { kind: \"managed\" }>;\n\t\tconst entry = entryByVersion.get(row.version_id);\n\t\tconst expectedDir = join(targetArtifactsRoot, safeName(row.artifact_id), safeName(row.version_id));\n\t\tif (entry === undefined || !entry.backupPath) {\n\t\t\tlocation.dir = expectedDir;\n\t\t\tupdateLocation.run(JSON.stringify(location), row.version_id);\n\t\t\tmissing += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tconst source = join(backupDir, entry.backupPath);\n\t\tif (!existsSync(source)) {\n\t\t\tmissing += 1;\n\t\t\tlocation.dir = expectedDir;\n\t\t\tupdateLocation.run(JSON.stringify(location), row.version_id);\n\t\t\tcontinue;\n\t\t}\n\t\tconst destDir = join(targetArtifactsRoot, relative(\"artifacts\", dirname(entry.backupPath)));\n\t\tmkdirSync(destDir, { recursive: true });\n\t\tcopyFileSync(source, join(destDir, entry.file));\n\t\tlocation.dir = destDir;\n\t\tupdateLocation.run(JSON.stringify(location), row.version_id);\n\t\trestored += 1;\n\t}\n\treturn { restored, missing };\n}\n\n/**\n * F08：把整体被排除来源对应的归档段条目从恢复副本中重写移除。\n * 调用方传入在删除正本前采集的整体被排除来源行；段内行按\n * entryId+eventType 整事件移除；未能重写的段记入 pending。\n */\nfunction redactExcludedArchiveEntries(\n\tdb: DatabaseSync,\n\texcludedRows: ReadonlyArray<{ source_id: string; segment_id: string | null; entry_id: string; event_type: string }>,\n): { redactedLines: number; pending: string[] } {\n\tconst targets = new Map<string, Array<{ entryId: string; eventTypes: string[] }>>();\n\tfor (const row of excludedRows) {\n\t\tif (row.segment_id === null) continue;\n\t\tconst list = targets.get(row.segment_id) ?? [];\n\t\tconst existing = list.find((item) => item.entryId === row.entry_id);\n\t\tif (existing) {\n\t\t\tif (!existing.eventTypes.includes(row.event_type)) existing.eventTypes.push(row.event_type);\n\t\t} else {\n\t\t\tlist.push({ entryId: row.entry_id, eventTypes: [row.event_type] });\n\t\t}\n\t\ttargets.set(row.segment_id, list);\n\t}\n\tconst pending: string[] = [];\n\tlet redactedLines = 0;\n\tfor (const [segmentId, selectors] of targets) {\n\t\tconst segment = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT segment_id, original_path, compressed_path, status\n\t\t\t\t FROM archive_segments WHERE segment_id = ?`,\n\t\t\t)\n\t\t\t.get(segmentId) as\n\t\t\t| { segment_id: string; original_path: string | null; compressed_path: string | null; status: string }\n\t\t\t| undefined;\n\t\tif (!segment) {\n\t\t\tpending.push(`归档段行缺失:${segmentId}`);\n\t\t\tcontinue;\n\t\t}\n\t\tconst path = segment.compressed_path ?? segment.original_path;\n\t\tif (!path || !existsSync(path)) {\n\t\t\tpending.push(`归档段文件缺失:${segmentId}`);\n\t\t\tcontinue;\n\t\t}\n\t\tconst result = rewriteSegmentFile(\n\t\t\tpath,\n\t\t\tselectors.map((selector) => ({ entryId: selector.entryId, eventTypes: selector.eventTypes })),\n\t\t\tsegment.compressed_path !== null,\n\t\t);\n\t\tif (result.ok) {\n\t\t\tredactedLines += result.removed + result.redacted;\n\t\t} else {\n\t\t\tpending.push(result.reason);\n\t\t}\n\t}\n\treturn { redactedLines, pending };\n}\n\n/**\n * 把备份恢复到目标 PAO_HOME。\n *\n * 只恢复 memory/ 子目录（库 + 归档段 + 受管成果副本）；不动 agent/、配置\n * 等其他 home 内容。恢复期间以 readwrite 打开目标库写 exclusion、重定位\n * 段路径与成果路径并按排除清单清正本，完成后由调用方决定是否把 home\n * 交给常规 openMemoryStore 使用（本函数不持有恢复后的连接）。\n */\nexport function restoreMemoryBackup(input: RestoreMemoryBackupInput): MemoryResult<RestoreMemoryBackupResult> {\n\tconst backupDir = resolve(input.backupDir);\n\tconst targetHome = resolve(input.targetHome);\n\tconst restoredAt = input.restoredAt ?? new Date().toISOString();\n\n\tconst manifest = readManifest(backupDir);\n\tif (!manifest) {\n\t\treturn fail(\"invalid_input\", `备份目录缺少有效 manifest.json:${backupDir}`);\n\t}\n\tconst snapshotPath = join(backupDir, manifest.snapshotPath);\n\tif (!existsSync(snapshotPath)) {\n\t\treturn fail(\"source_missing\", `备份快照缺失:${snapshotPath}`);\n\t}\n\n\t// 目标目录检查：允许不存在或仅有非 memory 内容；已存在非空 memory/ 拒绝覆盖。\n\tconst targetPaths = memoryPaths(targetHome);\n\tconst targetMemoryRoot = dirname(targetPaths.database);\n\tif (existsSync(targetMemoryRoot) && readdirSync(targetMemoryRoot).length > 0) {\n\t\treturn fail(\"invalid_input\", `恢复目标已有记忆数据，拒绝覆盖:${targetMemoryRoot}`);\n\t}\n\tmkdirSync(targetPaths.archives, { recursive: true });\n\n\t// 1) 恢复库：VACUUM INTO 的快照本身即非 WAL 的一致性主库镜像，\n\t// 直接复制为目标 memory.sqlite（不再走内存库中转）。\n\tmkdirSync(dirname(targetPaths.database), { recursive: true });\n\tcopyFileSync(snapshotPath, targetPaths.database);\n\tconst targetDb = new DatabaseSync(targetPaths.database);\n\ttry {\n\t\ttargetDb.exec(\"PRAGMA journal_mode=WAL\");\n\t\ttargetDb.exec(\"PRAGMA foreign_keys=ON\");\n\n\t\t// 2) 恢复归档段：按 manifest.backupPath 复制回 archives/<sessionId>/<file>，\n\t\t//    并在库内把 original_path/compressed_path 重写到新落点（F07）。\n\t\tlet restoredSegments = 0;\n\t\tfor (const entry of manifest.segments) {\n\t\t\tif (!entry.backupPath) continue;\n\t\t\tconst source = join(backupDir, entry.backupPath);\n\t\t\tif (!existsSync(source)) continue;\n\t\t\tconst dest = join(targetPaths.archives, relative(\"segments\", entry.backupPath));\n\t\t\tmkdirSync(dirname(dest), { recursive: true });\n\t\t\tcopyFileSync(source, dest);\n\t\t\trestoredSegments += 1;\n\t\t}\n\t\trelocateArchiveSegments(targetDb, manifest, backupDir, targetPaths.archives);\n\n\t\t// 3) 恢复受管成果副本并把 location_json.dir 重写到新落点（F07）。\n\t\tconst artifacts = restoreManagedArtifacts(targetDb, manifest, backupDir, targetPaths.artifacts);\n\n\t\t// 4) 重放当前最新 exclusion（liveHome 存在且给了才读现场库）。\n\t\tlet replayed = 0;\n\t\tif (input.liveHome !== undefined && existsSync(memoryPaths(input.liveHome).database)) {\n\t\t\tconst liveStore = openMemoryStore(input.liveHome, \"readonly\");\n\t\t\ttry {\n\t\t\t\treplayed = replayExclusions(targetDb, readExclusions(liveStore.db), restoredAt);\n\t\t\t} finally {\n\t\t\t\tliveStore.close();\n\t\t\t}\n\t\t}\n\n\t\t// 5) F08：先快照全部来源行（正本删除后 sources 行已不可查），\n\t\t//    再按既有排除语义清正本/修订/来源行与派生内容。\n\t\tconst allSourceRows = targetDb\n\t\t\t.prepare(`SELECT source_id, session_id, segment_id, entry_id, event_type FROM sources ORDER BY source_id`)\n\t\t\t.all() as unknown as Array<{\n\t\t\tsource_id: string;\n\t\t\tsession_id: string;\n\t\t\tsegment_id: string | null;\n\t\t\tentry_id: string;\n\t\t\tevent_type: string;\n\t\t}>;\n\t\tconst purged = purgeExcludedContent(targetDb, restoredAt);\n\t\t// purge 后用 isSourceGloballyExcluded 判定段重写候选：独占来源在其引用\n\t\t// 记忆整删后判整体排除（del 已删不再算引用）；共享保留来源判 false，\n\t\t// 其段条目留给仍引用它的记忆回读。判定走 sessionId+entryId 形态，\n\t\t// sources 行已删不影响排除表查询。\n\t\tconst excludedRows = allSourceRows.filter((row) =>\n\t\t\tisSourceGloballyExcluded(targetDb, { sessionId: row.session_id, entryId: row.entry_id }),\n\t\t);\n\t\tconst redacted = redactExcludedArchiveEntries(targetDb, excludedRows);\n\t\tconst exclusionTotal = (targetDb.prepare(`SELECT COUNT(*) AS n FROM source_exclusions`).get() as { n: number }).n;\n\n\t\tconst limitations: string[] = [manifest.limitation];\n\t\tif (artifacts.missing > 0) {\n\t\t\tlimitations.push(`受管成果副本缺失 ${artifacts.missing} 个，对应版本恢复后按原文缺失处理`);\n\t\t}\n\t\tfor (const reason of redacted.pending) {\n\t\t\tlimitations.push(`归档清理未完成:${reason}`);\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\ttargetHome,\n\t\t\tdatabase: targetPaths.database,\n\t\t\trestoredSegments,\n\t\t\trestoredArtifacts: artifacts.restored,\n\t\t\texclusionCount: exclusionTotal,\n\t\t\treplayedExclusions: replayed,\n\t\t\tclearedFts: purged.fts,\n\t\t\tclearedVectors: purged.vectors,\n\t\t\tpurgedMemories: purged.memories,\n\t\t\tpurgedRevisions: purged.revisions,\n\t\t\tpurgedSources: purged.sources,\n\t\t\tredactedArchiveLines: redacted.redactedLines,\n\t\t\tlimitation: limitations.join(\"；\"),\n\t\t\tmanifest,\n\t\t};\n\t} finally {\n\t\ttargetDb.close();\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 归档作业挂载（archive jobKind）\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface ArchiveBackupJobScope {\n\t/** 备份输出目录（必填）。 */\n\tbackupDir: string;\n}\n\n/**\n * 从 extraction_jobs.source_scope JSON 解析归档作业范围。\n * scope 约定：`{\"kind\":\"archive\",\"backupDir\":\"<dir>\"}`——scopeKey 形如\n * `archive:{backupDir}` 保证幂等。\n */\nexport function parseArchiveJobScope(sourceScope: string): ArchiveBackupJobScope | undefined {\n\ttry {\n\t\tconst parsed = JSON.parse(sourceScope) as { kind?: unknown; backupDir?: unknown };\n\t\tif (parsed.kind !== \"archive\" || typeof parsed.backupDir !== \"string\" || parsed.backupDir.length === 0) {\n\t\t\treturn undefined;\n\t\t}\n\t\treturn { backupDir: parsed.backupDir };\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S7-07：记忆后台作业的预算门。\n */** 拼预算判据：有 attemptKey 走尝试级，缺省 job 级（向后兼容）。 */\nfunction memoryJobKey(jobId: string, jobKind: string, attemptKey?: string): string {\n\treturn attemptKey === undefined\n\t\t ? `memory-job:${jobId}:${jobKind}`: `memory-job:${jobId}:${jobKind}:${attemptKey}`;\n}\nexport { budgetLedgerPath, currentGrant, readBudgetLedger };\nexport type { BudgetLedgerFile, BudgetReservation };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":109}},{"diffOp":{"equal":{"range":[51,259]}}},{"diffOp":{"delete":{"range":[259,262]}}},{"diffOp":{"insert":{"range":[262,263]}}},{"diffOp":{"equal":{"range":[263,297]}}},{"diffOp":{"delete":{"range":[259,262]}}},{"diffOp":{"insert":{"range":[262,263]}}},{"diffOp":{"equal":{"range":[297,349]}}},{"equalLines":{"line_count":148}},{"diffOp":{"equal":{"range":[349,463]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\budget.ts"},"span":null,"sourceCode":"/**\n * S7-07：记忆后台作业的预算门。\n *\n * 契约：\n * - 复用 `usage/budget-ledger.ts` 的 `reserveBudget/settleBudget/releaseBudget`：\n *   判据 = `memory-job:{jobId}:{kind}`（可选追加 `:{attemptKey}` 做尝试级判据），\n *   指纹 = sha256(jobId+scopeKey+kind) 前 16 位。\n *   同一 job 同一尝试重复预留复用同一条记录（不重复授额），与 worker 派发同一口径；\n *   不同 attemptKey 各自一条预留（每次实际请求有独立判据）。\n * - 额度配置：读 `$PAO_HOME/pao配置/记忆后台预算.json`（`{ \"每日上限\": 0.50, \"允许嵌入\": true }`）。\n *   配置文件缺失 = 不启用记忆后台额度——**后台作业不开展额外付费作业**\n *   （提炼/嵌入/规整都只跑本地逻辑；外发嵌入端点由各自许可把关）。\n *   首次验收不限总额的场景由调用方显式给 `unlimited: true`（如 S7-12 发行验收）。\n * - 日累计：`每日上限` 有值时按 UTC 当日聚合账本内 `memory:*` 预留\n *   （settled 取已结算费用、reserved/unknown 取预留额），\n *   `当日已发生 + 本次金额 > 每日上限` → 额度不足。只约束 memory:* 预留，不影响 dispatch 判据。\n * - 嵌入开关：`checkMemoryEmbeddingAllowed` 在 `允许嵌入 !== true` 时直接未授权，\n *   通过后走 `checkMemoryJobBudget`（jobKind=\"embed\"）。\n * - 超限处理：`checkMemoryJobBudget` 返回 `{ok:false, kind:\"未授权\"|\"额度不足\"|\"结果不明\"|\"配置无效\"}`\n *   后，job 保持 pending 不领取——恢复路径（recoverJobs）下一轮空闲仍会捞起；\n *   已 running 的 job 不在预算门内（已授额不重复扣）。\n * - 结算规则：模型请求返回后按实际 usage.cost.total 结算（已知费用）；返回未含\n *   cost 字段时 usage 记 unknown，预留额继续占着（不释放，不当作零费用）。\n * - 普通任务优先：记忆后台作业的额度不抢占主任务预算——同一总账下\n *   `checkDispatchBudget` 已给主任务预留的份额不受本模块影响。\n */\nimport { createHash } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport {\n\ttype BudgetLedgerFile,\n\ttype BudgetReservation,\n\tbudgetLedgerPath,\n\tcommittedSpend,\n\tcurrentGrant,\n\treadBudgetLedger,\n\treleaseBudget,\n\tremainingBudget,\n\treserveBudget,\n\tsettleBudget,\n} from \"../usage/budget-ledger.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 配置\n// ════════════════════════════════════════════════════════════════════════\n\n/** 记忆后台预算配置文件名（相对 PAO_HOME）。 */\nexport const MEMORY_BUDGET_CONFIG = \"pao配置/记忆后台预算.json\";\n\nexport interface MemoryBudgetConfig {\n\t/** 每日后台作业上限（美元）；缺省或 0 = 不启用额度（本地作业照跑，付费外发不跑）。 */\n\t每日上限?: number;\n\t/** 是否允许嵌入外发（缺省 false）。 */\n\t允许嵌入?: boolean;\n\t/** 单次 job 预留上限（美元，缺省 0.05）。 */\n\t单次预留上限?: number;\n\t/** 无限额验收标记（仅发行验收用；不对外暴露）。 */\n\tunlimited?: boolean;\n}\n\n/** 读后台预算配置；坏配置返回 undefined（调用方按未启用处理）。 */\nexport function readMemoryBudgetConfig(paoHome: string): MemoryBudgetConfig | undefined {\n\tconst path = join(paoHome, MEMORY_BUDGET_CONFIG);\n\tif (!existsSync(path)) return undefined;\n\ttry {\n\t\tconst parsed = JSON.parse(readFileSync(path, \"utf8\")) as Record<string, unknown>;\n\t\treturn {\n\t\t\t...(typeof parsed.每日上限 === \"number\" ? { 每日上限: parsed.每日上限 } : {}),\n\t\t\t...(typeof parsed.允许嵌入 === \"boolean\" ? { 允许嵌入: parsed.允许嵌入 } : {}),\n\t\t\t...(typeof parsed.单次预留上限 === \"number\" ? { 单次预留上限: parsed.单次预留上限 } : {}),\n\t\t\t...(parsed.unlimited === true ? { unlimited: true } : {}),\n\t\t};\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 预算门\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface CheckMemoryJobBudgetInput {\n\tpaoHome: string;\n\tjobId: string;\n\tjobKind: string;\n\tscopeKey: string;\n\t/**\n\t * 尝试级判据后缀（可选）。传入后判据 = `memory-job:{jobId}:{kind}:{attemptKey}`，\n\t * 单次请求/尝试一条预留；缺省保持 `memory-job:{jobId}:{kind}`（job 级幂等）。\n\t * 指纹不含 attemptKey——指纹回答「内容是否同一任务」，attemptKey 回答「第几次尝试」。\n\t */\n\tattemptKey?: string;\n\t/** 本次要预留的金额（美元）；缺省按 config.单次预留上限 或 0.05。 */\n\t金额?: number;\n\t/** 当前时间（ISO）。 */\n\t现在: string;\n\t/** 配置（缺省现读文件）。 */\n\tconfig?: MemoryBudgetConfig;\n}\n\nexport type MemoryJobBudgetVerdict =\n\t| { ok: true; reservation?: BudgetReservation; unlimited: boolean }\n\t| {\n\t\t\tok: false;\n\t\t\tkind: \"未授权\" | \"额度不足\" | \"结果不明\" | \"配置无效\";\n\t\t\treason: string;\n\t  };\n\nfunction fingerprintScopeKey(jobId: string, scopeKey: string, kind: string): string {\n\treturn createHash(\"sha256\").update(`${jobId}${scopeKey}${kind}`).digest(\"hex\").slice(0, 16);\n}\n\n/** 拼预算判据：有 attemptKey 走尝试级，缺省 job 级（向后兼容）。 */\nfunction memoryJobKey(jobId: string, jobKind: string, attemptKey?: string): string {\n\treturn attemptKey === undefined\n\t\t? `memory-job:${jobId}:${jobKind}`\n\t\t: `memory-job:${jobId}:${jobKind}:${attemptKey}`;\n}\n\n/**\n * 记忆后台 job 的预算检查 + 预留。\n *\n * 判据 `memory-job:{jobId}:{kind}`（可追加 `:{attemptKey}`）——同判据重复预留\n * 复用同一条记录；指纹 = sha256(jobId+scopeKey+kind) 前 16 位，防「同判据不同任务」。\n * `每日上限` 有值时传成 reserveBudget 的「当日上限」：日累计核对与预留在账本同一把锁内\n * （并行作业排队读最新账面，不会各看到旧累计后双双放行）。\n */\nexport async function checkMemoryJobBudget(input: CheckMemoryJobBudgetInput): Promise<MemoryJobBudgetVerdict> {\n\tconst config = input.config ?? readMemoryBudgetConfig(input.paoHome);\n\tif (config?.unlimited === true) {\n\t\treturn { ok: true, unlimited: true };\n\t}\n\tif (config === undefined) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\tkind: \"未授权\",\n\t\t\treason: \"记忆后台预算未配置：后台作业不开展额外付费作业（配置文件 pao配置/记忆后台预算.json 缺失）\",\n\t\t};\n\t}\n\tif (config.每日上限 !== undefined && config.每日上限 <= 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\tkind: \"额度不足\",\n\t\t\treason: `记忆后台每日上限 ${config.每日上限}：不开展额外付费作业`,\n\t\t};\n\t}\n\tconst 金额 = input.金额 ?? config.单次预留上限 ?? 0.05;\n\tif (config.每日上限 !== undefined && 金额 > config.每日上限) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\tkind: \"额度不足\",\n\t\t\treason: `单次预留 $${金额.toFixed(2)} 超过记忆后台每日上限 $${config.每日上限.toFixed(2)}`,\n\t\t};\n\t}\n\tconst 指纹 = fingerprintScopeKey(input.jobId, input.scopeKey, input.jobKind);\n\tconst result = await reserveBudget(budgetLedgerPath(input.paoHome), {\n\t\tidempotencyKey: memoryJobKey(input.jobId, input.jobKind, input.attemptKey),\n\t\t金额,\n\t\t指纹,\n\t\t现在: input.现在,\n\t\t卡号: `memory:${input.jobKind}`,\n\t\t...(config.每日上限 === undefined ? {} : { 当日上限: config.每日上限 }),\n\t});\n\tif (!result.ok) {\n\t\tif (result.code === \"no_grant\") {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\tkind: \"未授权\",\n\t\t\t\treason: \"总预算未授权：记忆后台作业不凭空设额度（请先给总预算）\",\n\t\t\t};\n\t\t}\n\t\tif (result.code === \"insufficient\" || result.code === \"daily_exceeded\") {\n\t\t\treturn { ok: false, kind: \"额度不足\", reason: result.reason };\n\t\t}\n\t\tif (result.code === \"fingerprint_mismatch\") {\n\t\t\treturn { ok: false, kind: \"结果不明\", reason: result.reason };\n\t\t}\n\t\treturn { ok: false, kind: \"配置无效\", reason: result.reason };\n\t}\n\treturn { ok: true, reservation: result.reservation, unlimited: false };\n}\n\n/**\n * 嵌入外发许可 + 预算：同一份 `记忆后台预算.json`，`unlimited` 直通；\n * `允许嵌入 !== true` → 未授权；其后走 `checkMemoryJobBudget`（jobKind=\"embed\"）。\n */\nexport async function checkMemoryEmbeddingAllowed(input: {\n\tpaoHome: string;\n\tjobId: string;\n\tscopeKey: string;\n\t/**\n\t * 尝试级判据后缀（可选，透传 checkMemoryJobBudget）。\n\t * 嵌入按每次实际请求传独立 requestId——逐请求一条预留/结算。\n\t */\n\tattemptKey?: string;\n\t金额?: number;\n\t现在: string;\n\tconfig?: MemoryBudgetConfig;\n}): Promise<MemoryJobBudgetVerdict> {\n\tconst config = input.config ?? readMemoryBudgetConfig(input.paoHome);\n\tif (config?.unlimited === true) {\n\t\treturn { ok: true, unlimited: true };\n\t}\n\tif (config?.允许嵌入 !== true) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\tkind: \"未授权\",\n\t\t\treason: \"记忆后台预算未允许嵌入外发（记忆后台预算.json 的 允许嵌入 非 true）\",\n\t\t};\n\t}\n\treturn checkMemoryJobBudget({ ...input, jobKind: \"embed\", config });\n}\n\n/**\n * 结算记忆后台 job 的实际费用。\n *\n * `实际费用` 为 undefined（供应商未返回 cost）→ 状态记 `unknown`，\n * 预留额继续占着（不释放，不当作零费用）。\n */\nexport async function settleMemoryJobBudget(\n\tpaoHome: string,\n\tjobId: string,\n\tjobKind: string,\n\t实际费用: number | undefined,\n\t现在: string,\n\t备注?: string,\n\tattemptKey?: string,\n): Promise<BudgetReservation> {\n\treturn settleBudget(budgetLedgerPath(paoHome), {\n\t\tidempotencyKey: memoryJobKey(jobId, jobKind, attemptKey),\n\t\t实际费用,\n\t\t现在,\n\t\t...(备注 === undefined ? {} : { 备注 }),\n\t});\n}\n\n/**\n * 归还未受理的记忆后台预留（job 被取消且未发模型请求）。\n * 只允许 reserved → released；unknown/settled 不动（结果未查清不归还）。\n */\nexport async function releaseMemoryJobBudget(\n\tpaoHome: string,\n\tjobId: string,\n\tjobKind: string,\n\t现在: string,\n\t备注?: string,\n\tattemptKey?: string,\n): Promise<BudgetReservation | undefined> {\n\treturn releaseBudget(budgetLedgerPath(paoHome), {\n\t\tidempotencyKey: memoryJobKey(jobId, jobKind, attemptKey),\n\t\t现在,\n\t\t...(备注 === undefined ? {} : { 备注 }),\n\t});\n}\n\n/** 当前总预算剩余（未授权时 undefined——与 remainingBudget 同口径）。 */\nexport function remainingMemoryBudget(paoHome: string): number | undefined {\n\tconst file = readBudgetLedger(budgetLedgerPath(paoHome));\n\treturn remainingBudget(file);\n}\n\n/** 当前已占用的总预算（含 settled+reserved+unknown）。 */\nexport function committedMemoryBudget(paoHome: string): number {\n\tconst file = readBudgetLedger(budgetLedgerPath(paoHome));\n\treturn committedSpend(file);\n}\n\nexport { budgetLedgerPath, currentGrant, readBudgetLedger };\nexport type { BudgetLedgerFile, BudgetReservation };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆的会话事件增量采集（S1-05、S1-06）。\n *\t\t\t\t})\n\t\t\t\t.catch((error: unknown) => {\n\t\t\t\t\tconsole.error(\n\t\t\t\t\t\t`[pao] 事件段封存失败(原段保留可读):${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t);\n\t\t\t\t});\n\t\t}\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,71]}}},{"equalLines":{"line_count":499}},{"diffOp":{"equal":{"range":[71,130]}}},{"diffOp":{"insert":{"range":[130,137]}}},{"diffOp":{"equal":{"range":[137,244]}}},{"diffOp":{"insert":{"range":[244,251]}}},{"diffOp":{"equal":{"range":[251,265]}}},{"equalLines":{"line_count":7}},{"diffOp":{"equal":{"range":[265,271]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\capture.ts"},"span":null,"sourceCode":"/**\n * 内置记忆的会话事件增量采集（S1-05、S1-06）。\n *\n * 契约：\n * - 采集对象是「已提交」的会话条目（SessionEntry，即 session-manager 公开投影/\n *   getBranch 读到的追加式条目）。`registerCapture` 挂 `turn_end`（用事件自带\n *   messageEntryId/toolResultEntryIds 还原已提交条目）与 `agent_settled`\n *   （补扫分支上仍无来源行的条目，主要是每轮用户消息）；装配层也可只调\n *   `createCapture` 拿 `captureCommittedEntries` 自行驱动。\n * - 去重与恢复游标只用 sources 行：`isCaptured(sessionId, entryId)` 查存在性；\n *   会话启用时只读记录存量条目，首次采集时将这些历史登记为\n *   `eventType='boundary'` 的来源行（已有来源保持原样），之后重开/分支切换\n *   只收新条目，不回追历史。\n * - 凭证剔除（S1-06）：正文、附件文本化内容在写库/写文件前过同一脱敏入口\n *   （默认 `../context/index.ts` 的 `redactContext`，可注入替换）。已知凭证\n *   字段与值不进入 sources 字段、归档正文、异常消息或附件说明——本模块不把\n *   原始正文拼进任何异常。\n * - 附件：ImageContent 块不落 base64 原文；字节写受管副本\n *   `attachments/<attachment-id>/`，事件里只留引用、mimeType 与受管位置。\n *   文本块仍走同一脱敏入口。\n * - 顺序：先 appendToOpenSegment（拿到 segmentId+行号）再 registerSource\n *   （带 location/segmentId）。段内出现孤儿行只浪费字节；反过来的\n *   「有来源行无事件」会让回读返回缺失，更糟，故不采用。\n */\nimport { closeSync, existsSync, mkdirSync, openSync, readSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { ImageContent } from \"@pao/ai\";\nimport type { ExtensionAPI } from \"../../core/extensions/types.ts\";\nimport type { ReadonlySessionManager, SessionEntry } from \"../../core/session-manager.ts\";\nimport { redactContext } from \"../context/index.ts\";\nimport { type ArchivedEvent, appendToOpenSegment, findOpenSegment, sealSegment } from \"./archive.ts\";\nimport { memoryPaths } from \"./paths.ts\";\nimport { resolveMemoryProjectIdentity } from \"./project-identity.ts\";\nimport { resolveProjectSessionBindingAtEntry } from \"./project-session.ts\";\nimport { extractIndexableText, upsertSourceFts } from \"./source-fts.ts\";\nimport { registerSource } from \"./sources.ts\";\nimport type { MemoryStore } from \"./store.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 类型\n// ════════════════════════════════════════════════════════════════════════\n\n/** createCapture 的依赖注入面。 */\nexport interface CaptureDeps {\n\t/** 批次 A 的存储句柄（db 访问 + 事务）。 */\n\tstore: MemoryStore;\n\t/** PAO_HOME 根（归档/附件位置由它推导，不从 cwd 推测）。 */\n\tpaoHome: string;\n\t/** 脱敏函数；缺省复用 context 模块的 redactContext。 */\n\tredact?: (value: unknown) => unknown;\n\t/** 采集时间源（夹具注入；缺省 UTC 当前时间）。 */\n\tnow?: () => string;\n\t/**\n\t * 会话级项目归属解析：条目级卡/任务绑定（branch 上的绑定条目）缺位时，\n\t * 给来源补 project_id。缺省实现：优先 memory_sessions 登记会话文件的\n\t * 头 cwd（宿主真实会话归属），无会话文件时回落进程 cwd 的项目身份。\n\t * 返回 undefined 表示无可信归属，来源 project_id 记 NULL（查询侧按\n\t * 「可证明归属」规则发现，不做跨项目无条件放行）。\n\t */\n\tresolveSessionProject?: (sessionId: string) => string | undefined;\n}\n\n/** 单条条目采集结果。 */\nexport interface CaptureEntryResult {\n\tentryId: string;\n\t/** captured=新采集；skipped=已采集过或不可采集类型；boundary=边界登记。 */\n\toutcome: \"captured\" | \"skipped\" | \"boundary\";\n\tsourceId?: string;\n\tsegmentId?: string;\n\t/** 跳过原因（不可采集类型时）。 */\n\treason?: string;\n}\n\nexport interface CaptureHandle {\n\t/** Record the real session file reported by the host; this is the only locator deletion uses. */\n\tregisterSession(sessionId: string, sessionFile: string | undefined): void;\n\t/** 查某会话条目是否已采集（sources 行存在即已采集，含边界行）。 */\n\tisCaptured(sessionId: string, entryId: string): boolean;\n\t/** Return the registered source for a real entry, optionally restricted to one event type. */\n\tsourceForEntry(sessionId: string, entryId: string, eventType?: string): string | undefined;\n\t/**\n\t * 登记启用边界：给一批存量条目写 eventType='boundary' 的来源行，\n\t * 之后这些条目被 isCaptured 判为已采集，不回追历史。\n\t */\n\tmarkBoundary(sessionId: string, entryIds: string[], capturedAt?: string): void;\n\t/**\n\t * 采集一批已提交条目：脱敏 → 附件落受管副本 → 追加段 → 登记来源。\n\t * 返回与输入同序的逐条结果；单条失败向上抛（不让异常带原始正文）。\n\t */\n\tcaptureCommittedEntries(\n\t\tsessionId: string,\n\t\tentries: SessionEntry[],\n\t\tcapturedAt?: string,\n\t\tbranch?: readonly SessionEntry[],\n\t): CaptureEntryResult[];\n\t/** Capture one committed entry with a precise source event type (for tool-call evidence). */\n\tcaptureCommittedEntry(\n\t\tsessionId: string,\n\t\tentry: SessionEntry,\n\t\tsourceEventType?: string,\n\t\tcapturedAt?: string,\n\t\tbranch?: readonly SessionEntry[],\n\t): CaptureEntryResult;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 事件类型与内容提取\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 由会话条目推导 (eventType, 待脱敏正文)。\n * 返回 undefined 表示该条目类型不采集（纯状态条目：usage/model_change/\n * thinking_level_change/label/session_info/context_edit/compaction/branch_summary——\n * 这些是状态或派生摘要，不是新提交的对话事件）。\n */\nfunction entryPayload(entry: SessionEntry): { eventType: string; content: unknown } | undefined {\n\tswitch (entry.type) {\n\t\tcase \"message\": {\n\t\t\tconst message = (entry as { message?: { role?: string } }).message;\n\t\t\tconst role = typeof message?.role === \"string\" ? message.role : \"unknown\";\n\t\t\treturn { eventType: role, content: message };\n\t\t}\n\t\tcase \"custom_message\": {\n\t\t\tconst record = entry as { customType?: string; content?: unknown; details?: unknown };\n\t\t\treturn {\n\t\t\t\teventType: \"custom\",\n\t\t\t\tcontent: {\n\t\t\t\t\tcustomType: record.customType,\n\t\t\t\t\tcontent: record.content,\n\t\t\t\t\tdetails: record.details,\n\t\t\t\t},\n\t\t\t};\n\t\t}\n\t\tdefault:\n\t\t\treturn undefined;\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 附件（S1-06）\n// ════════════════════════════════════════════════════════════════════════\n\nconst MIME_EXT: Record<string, string> = {\n\t\"image/png\": \"png\",\n\t\"image/jpeg\": \"jpg\",\n\t\"image/gif\": \"gif\",\n\t\"image/webp\": \"webp\",\n};\n\ninterface AttachmentRef {\n\ttype: \"image\";\n\tattachmentId: string;\n\tmimeType: string;\n\t/** 受管副本位置（相对 PAO_HOME 的 attachments/<id>/ 下文件名）。 */\n\tmanagedPath: string;\n}\n\nfunction isImageBlock(block: unknown): block is ImageContent {\n\treturn (\n\t\ttypeof block === \"object\" &&\n\t\tblock !== null &&\n\t\t(block as { type?: unknown }).type === \"image\" &&\n\t\ttypeof (block as { data?: unknown }).data === \"string\"\n\t);\n}\n\n/**\n * 处理消息 content：ImageContent 落受管副本换引用块，其余块（文本/工具调用/\n * thinking 等）原样交给脱敏层。返回处理后的 content（保持数组/字符串形状）。\n * O14：副本身份只用已有稳定定位（entryId + 块序号）——attachmentId 本就不能\n * 跨条目去重，同条目重复采集又已被 isCaptured 幂等挡住，不再为每图算 SHA256。\n */\nfunction offloadImages(content: unknown, home: string, indexPrefix: string): unknown {\n\tif (typeof content === \"string\") return content;\n\tif (!Array.isArray(content)) return content;\n\tconst root = memoryPaths(home).attachments;\n\treturn content.map((block, index) => {\n\t\tif (!isImageBlock(block)) return block;\n\t\tconst bytes = Buffer.from(block.data, \"base64\");\n\t\tconst attachmentId = `att-${indexPrefix}-${index}`;\n\t\tconst dir = join(root, attachmentId);\n\t\tmkdirSync(dir, { recursive: true });\n\t\tconst ext = MIME_EXT[block.mimeType] ?? \"bin\";\n\t\tconst fileName = `data.${ext}`;\n\t\tconst filePath = join(dir, fileName);\n\t\tif (!existsSync(filePath)) writeFileSync(filePath, bytes);\n\t\tconst ref: AttachmentRef = {\n\t\t\ttype: \"image\",\n\t\t\tattachmentId,\n\t\t\tmimeType: block.mimeType,\n\t\t\tmanagedPath: join(\"attachments\", attachmentId, fileName),\n\t\t};\n\t\treturn ref;\n\t});\n}\n\n/** 脱敏后内容里图片块的位置统一成附件引用（content 可能是字符串或块数组）。 */\nfunction sanitizeContent(\n\tcontent: unknown,\n\thome: string,\n\tentryId: string,\n\tredact: (value: unknown) => unknown,\n): unknown {\n\tif (content === undefined || content === null) return content;\n\tif (typeof content === \"string\") return redact(content);\n\tif (Array.isArray(content)) {\n\t\tconst offloaded = offloadImages(content, home, entryId);\n\t\treturn redact(offloaded);\n\t}\n\tif (typeof content === \"object\") {\n\t\t// 消息对象：先对其中的 content/块数组卸附件，再整体过脱敏。\n\t\tconst record = { ...(content as Record<string, unknown>) };\n\t\tif (\"content\" in record) record.content = offloadImages(record.content, home, entryId);\n\t\treturn redact(record);\n\t}\n\treturn redact(content);\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 会话级项目归属（O05 修复：未提炼来源的可信 project 绑定）\n// ════════════════════════════════════════════════════════════════════════\n\n/** 会话文件头扫描上限：头行固定在第一行，限界读取防大文件误当会话。 */\nconst SESSION_HEADER_SCAN_BYTES = 64 * 1024;\n\n/**\n * 读会话文件第一行头里的 cwd；不是会话文件/无 cwd 返回 undefined。\n * 与 SessionManager 头格式一致（{\"type\":\"session\",...,\"cwd\":...}），\n * 本模块只取 cwd，不引入会话管理器依赖。\n */\nfunction sessionFileCwd(sessionFile: string): string | undefined {\n\tlet fd: number | undefined;\n\ttry {\n\t\tfd = openSync(sessionFile, \"r\");\n\t\tconst buffer = Buffer.allocUnsafe(SESSION_HEADER_SCAN_BYTES);\n\t\tconst bytesRead = readSync(fd, buffer, 0, buffer.length, 0);\n\t\tif (bytesRead <= 0) return undefined;\n\t\tconst firstLine = buffer.subarray(0, bytesRead).toString(\"utf8\").split(\"\\n\", 1)[0] ?? \"\";\n\t\tconst parsed = JSON.parse(firstLine) as { type?: unknown; cwd?: unknown };\n\t\tif (parsed.type !== \"session\" || typeof parsed.cwd !== \"string\" || parsed.cwd.length === 0) {\n\t\t\treturn undefined;\n\t\t}\n\t\treturn parsed.cwd;\n\t} catch {\n\t\treturn undefined;\n\t} finally {\n\t\tif (fd !== undefined) closeSync(fd);\n\t}\n}\n\n/**\n * 缺省会话项目归属解析：\n * - 已登记会话（registerSession 写过 memory_sessions.session_file）→ 会话文件\n *   头 cwd 的项目身份（宿主真实会话归属，跨桌面多根会话也成立）；\n * - 未登记/文件不可读 → 进程 cwd 的项目身份（CLI 宿主的运行现场）；\n * - 两层都解析不出（cwd 已删等）→ undefined，来源记 NULL 而非伪造项目。\n * 结果按会话文件缓存：同一文件的 cwd 不可变，每会话只读一次头。\n */\nfunction defaultSessionProjectResolver(deps: CaptureDeps): (sessionId: string) => string | undefined {\n\tconst cache = new Map<string, string | undefined>();\n\treturn (sessionId) => {\n\t\tconst cached = cache.get(sessionId);\n\t\tif (cached !== undefined) return cached === \"\" ? undefined : cached;\n\t\tlet projectId: string | undefined;\n\t\tconst row = deps.store.db\n\t\t\t.prepare(`SELECT session_file FROM memory_sessions WHERE session_id = ?`)\n\t\t\t.get(sessionId) as { session_file: string } | undefined;\n\t\tconst cwd = row?.session_file === undefined ? undefined : sessionFileCwd(row.session_file);\n\t\tfor (const candidate of [cwd, process.cwd()]) {\n\t\t\tif (candidate === undefined) continue;\n\t\t\ttry {\n\t\t\t\tprojectId = resolveMemoryProjectIdentity(candidate, deps.paoHome).projectId;\n\t\t\t\tbreak;\n\t\t\t} catch {\n\t\t\t\t// cwd 目录已删等环境条件 → 归属不可证，记 NULL 不伪造。\n\t\t\t}\n\t\t}\n\t\tcache.set(sessionId, projectId ?? \"\");\n\t\treturn projectId;\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 采集本体\n// ════════════════════════════════════════════════════════════════════════\n\nexport function createCapture(deps: CaptureDeps): CaptureHandle {\n\tconst redact = deps.redact ?? ((value: unknown) => redactContext(value));\n\tconst now = deps.now ?? (() => new Date().toISOString());\n\tconst resolveSessionProject = deps.resolveSessionProject ?? defaultSessionProjectResolver(deps);\n\n\tfunction isCaptured(sessionId: string, entryId: string): boolean {\n\t\tconst db = deps.store.db;\n\t\treturn (\n\t\t\tdb\n\t\t\t\t.prepare(`SELECT 1 AS ok FROM sources WHERE session_id = ? AND entry_id = ? LIMIT 1`)\n\t\t\t\t.get(sessionId, entryId) !== undefined\n\t\t);\n\t}\n\n\tfunction registerSession(sessionId: string, sessionFile: string | undefined): void {\n\t\tif (!sessionFile || !existsSync(sessionFile)) return;\n\t\tconst db = deps.store.db;\n\t\tdb.prepare(\n\t\t\t`INSERT INTO memory_sessions (session_id, session_file, availability, updated_at)\n\t\t\t VALUES (?, ?, 'managed', ?)\n\t\t\t ON CONFLICT (session_id) DO UPDATE\n\t\t\t SET session_file = excluded.session_file,\n\t\t\t     availability = excluded.availability,\n\t\t\t     updated_at = excluded.updated_at`,\n\t\t).run(sessionId, sessionFile, now());\n\t}\n\n\tfunction sourceForEntry(sessionId: string, entryId: string, eventType?: string): string | undefined {\n\t\tconst db = deps.store.db;\n\t\tconst row = (\n\t\t\teventType === undefined\n\t\t\t\t? db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT source_id FROM sources\n\t\t\t\t\t\t\t WHERE session_id = ? AND entry_id = ?\n\t\t\t\t\t\t\t ORDER BY captured_at DESC LIMIT 1`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.get(sessionId, entryId)\n\t\t\t\t: db\n\t\t\t\t\t\t.prepare(\n\t\t\t\t\t\t\t`SELECT source_id FROM sources\n\t\t\t\t\t\t\t WHERE session_id = ? AND entry_id = ? AND event_type = ?\n\t\t\t\t\t\t\t LIMIT 1`,\n\t\t\t\t\t\t)\n\t\t\t\t\t\t.get(sessionId, entryId, eventType)\n\t\t) as { source_id: string } | undefined;\n\t\treturn row?.source_id;\n\t}\n\n\tfunction markBoundary(sessionId: string, entryIds: string[], capturedAt?: string): void {\n\t\tconst at = capturedAt ?? now();\n\t\tfor (const entryId of entryIds) {\n\t\t\tregisterSource(deps.store.db, {\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: \"boundary\",\n\t\t\t\tcapturedAt: at,\n\t\t\t});\n\t\t}\n\t}\n\n\tfunction captureCommittedEntry(\n\t\tsessionId: string,\n\t\tentry: SessionEntry,\n\t\tsourceEventType?: string,\n\t\tcapturedAt?: string,\n\t\tbranch?: readonly SessionEntry[],\n\t): CaptureEntryResult {\n\t\tconst at = capturedAt ?? now();\n\t\tconst entryId = entry.id;\n\t\tif (sourceEventType !== undefined) {\n\t\t\tconst existing = sourceForEntry(sessionId, entryId, sourceEventType);\n\t\t\tif (existing) {\n\t\t\t\treturn { entryId, outcome: \"skipped\", sourceId: existing, reason: \"该精确来源已采集\" };\n\t\t\t}\n\t\t} else if (isCaptured(sessionId, entryId)) {\n\t\t\treturn { entryId, outcome: \"skipped\", reason: \"已采集\" };\n\t\t}\n\t\tconst payload = entryPayload(entry);\n\t\tif (!payload) return { entryId, outcome: \"skipped\", reason: `不可采集类型:${entry.type}` };\n\t\tconst db = deps.store.db;\n\t\t// 1) 凭证剔除 + 附件卸副本（都在写库/写文件之前完成）。\n\t\tconst content = sanitizeContent(payload.content, deps.paoHome, entryId, redact);\n\t\t// 2) 原文追加未封存段，拿到段定位。\n\t\tconst event: ArchivedEvent = {\n\t\t\tv: 1,\n\t\t\tsessionId,\n\t\t\tentryId,\n\t\t\tentryType: entry.type,\n\t\t\teventType: payload.eventType,\n\t\t\ttimestamp: entry.timestamp,\n\t\t\tcapturedAt: at,\n\t\t\tcontent,\n\t\t};\n\t\tconst { segmentId, lineNo } = appendToOpenSegment(db, deps.paoHome, sessionId, event, at);\n\t\t// 3) 登记来源（幂等）：带段定位与行号。项目归属：条目级卡/任务绑定\n\t\t// （含 taskId）优先；缺位时用会话级归属（会话文件头 cwd / 进程 cwd 的\n\t\t// 项目身份）只补 projectId，taskId 仍记 NULL。\n\t\tconst entryBinding =\n\t\t\tbranch === undefined ? undefined : resolveProjectSessionBindingAtEntry(branch, entryId, sessionId);\n\t\tconst projectId = entryBinding?.projectId ?? resolveSessionProject(sessionId);\n\t\tconst taskId = entryBinding?.taskId;\n\t\tconst sourceId = deps.store.transaction(() => {\n\t\t\tconst id = registerSource(db, {\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: sourceEventType ?? payload.eventType,\n\t\t\t\t...(projectId === undefined ? {} : { projectId }),\n\t\t\t\t...(taskId === undefined ? {} : { taskId }),\n\t\t\t\tlocation: `${segmentId}#${lineNo}`,\n\t\t\t\tsegmentId,\n\t\t\t\tcapturedAt: at,\n\t\t\t});\n\t\t\t// O05/Q3：同一事务内同步来源原文词法索引（已脱敏 event.content 的可保存文本）。\n\t\t\tupsertSourceFts(db, id, {\n\t\t\t\tsessionId,\n\t\t\t\tentryId,\n\t\t\t\teventType: sourceEventType ?? payload.eventType,\n\t\t\t\t...(projectId === undefined ? {} : { projectId }),\n\t\t\t\t...(taskId === undefined ? {} : { taskId }),\n\t\t\t\tcontent: extractIndexableText(content),\n\t\t\t});\n\t\t\treturn id;\n\t\t});\n\t\treturn { entryId, outcome: \"captured\", sourceId, segmentId };\n\t}\n\n\tfunction captureCommittedEntries(\n\t\tsessionId: string,\n\t\tentries: SessionEntry[],\n\t\tcapturedAt?: string,\n\t\tbranch?: readonly SessionEntry[],\n\t): CaptureEntryResult[] {\n\t\treturn entries.map((entry) => captureCommittedEntry(sessionId, entry, undefined, capturedAt, branch));\n\t}\n\n\treturn {\n\t\tregisterSession,\n\t\tisCaptured,\n\t\tsourceForEntry,\n\t\tmarkBoundary,\n\t\tcaptureCommittedEntries,\n\t\tcaptureCommittedEntry,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 事件接线（S1-05）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 挂 turn_end / agent_settled 事件，把已提交条目增量采集进 sources + 未封存段。\n *\n * - `turn_end`：事件自带本轮已提交的 messageEntryId/toolResultEntryIds——\n *   经 ctx.sessionManager.getEntry 还原成 SessionEntry 后采集。\n * - `agent_settled`：补扫当前分支上仍没来源行的条目（主要是每轮的用户消息、\n *   以及 turn_end 之后才落盘的其他已提交条目）。\n * - 会话开始或首次请求前只读记录存量条目；采集时只将这批历史登记为\n *   `eventType='boundary'` 的边界行：启用前历史不追采，重开/分支切换后\n *   靠 isCaptured 去重，只收新条目。\n *\n * 返回 unmount 函数（关会话/测试清理用）。本函数不抛错——采集失败向上抛由\n * 事件宿主按扩展错误上报，不吞进静默降级。\n */\nexport function registerCapture(pi: ExtensionAPI, deps: CaptureDeps, capture?: CaptureHandle): () => void {\n\tconst handle = capture ?? createCapture(deps);\n\tconst boundaries = new Map<string, string[]>();\n\tconst snapshotBoundary = (sessionManager: ReadonlySessionManager): void => {\n\t\tconst sessionId = sessionManager.getSessionId();\n\t\tif (!boundaries.has(sessionId)) {\n\t\t\tboundaries.set(\n\t\t\t\tsessionId,\n\t\t\t\tsessionManager.getEntries().map((entry) => entry.id),\n\t\t\t);\n\t\t}\n\t};\n\tconst offStart = pi.on(\"session_start\", (_event, ctx) => snapshotBoundary(ctx.sessionManager));\n\tconst offBeforeStart = pi.on(\"before_agent_start\", (_event, ctx) => snapshotBoundary(ctx.sessionManager));\n\tconst ensureBoundary = (sessionId: string): void => {\n\t\tconst history = boundaries.get(sessionId);\n\t\tif (history === undefined) return;\n\t\thandle.markBoundary(\n\t\t\tsessionId,\n\t\t\thistory.filter((entryId) => !handle.isCaptured(sessionId, entryId)),\n\t\t);\n\t\tboundaries.set(sessionId, []);\n\t};\n\n\tconst offTurnEnd = pi.on(\"turn_end\", (event, ctx) => {\n\t\tconst sessionId = ctx.sessionManager.getSessionId();\n\t\thandle.registerSession(sessionId, ctx.sessionManager.getSessionFile());\n\t\tconst ids = [event.messageEntryId, ...event.toolResultEntryIds];\n\t\tconst entries = ids\n\t\t\t.map((id) => ctx.sessionManager.getEntry(id))\n\t\t\t.filter((entry): entry is SessionEntry => entry !== undefined);\n\t\tensureBoundary(sessionId);\n\t\thandle.captureCommittedEntries(sessionId, entries, undefined, ctx.sessionManager.getBranch());\n\t});\n\n\tconst offSettled = pi.on(\"agent_settled\", (_event, ctx) => {\n\t\tconst sessionId = ctx.sessionManager.getSessionId();\n\t\thandle.registerSession(sessionId, ctx.sessionManager.getSessionFile());\n\t\tensureBoundary(sessionId);\n\t\tconst branch = ctx.sessionManager.getBranch();\n\t\tconst fresh = branch.filter((entry) => !handle.isCaptured(sessionId, entry.id));\n\t\thandle.captureCommittedEntries(sessionId, fresh, undefined, branch);\n\t\t// O05/F10：本轮采集同步完成且无该段 writer 时封存未封存段。\n\t\t// 失败不阻塞 settled（封存是后台优化，原段保留可读）；下一条目\n\t\t// 再追加会自动开新段，语义兼容。\n\t\tconst open = findOpenSegment(deps.store.db, sessionId);\n\t\tif (open) {\n\t\t\tvoid sealSegment(deps.store.db, deps.paoHome, open.segmentId)\n\t\t\t\t.then((result) => {\n\t\t\t\t\tif (result.outcome === \"failed\") {\n\t\t\t\t\t\tconsole.error(`[pao] 事件段封存失败(原段保留可读):${result.warning ?? result.segmentId}`);\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t\t.catch((error: unknown) => {\n\t\t\t\t\tconsole.error(`[pao] 事件段封存失败(原段保留可读):${error instanceof Error ? error.message : String(error)}`);\n\t\t\t\t});\n\t\t}\n\t});\n\n\treturn () => {\n\t\toffStart();\n\t\toffBeforeStart();\n\t\toffTurnEnd();\n\t\toffSettled();\n\t};\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 记忆彻底删除的持久作业。\n *import type { DatabaseSync } from \"node:sqlite\";\nimport { gunzipSync, gzipSync } from \"node:zlib\";\nimport { type SessionEntry, SessionManager } from \"../../core/session-manager.ts\";\nimport { acquireSessionControldbCleanupSourceReferences } from \"../runtimeevolutionsession-lock.tsobserve.ts\";\nimport { unlinkArtifactRefsForMemories } from \"./artifacts.ts\";\nimport {\treturn executeOperation(store, archivesRoot, operationId, coordinator);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,46]}}},{"equalLines":{"line_count":7}},{"diffOp":{"equal":{"range":[46,227]}}},{"diffOp":{"equal":{"range":[227,237]}}},{"diffOp":{"delete":{"range":[237,258]}}},{"diffOp":{"insert":{"range":[258,283]}}},{"diffOp":{"equal":{"range":[283,295]}}},{"diffOp":{"delete":{"range":[295,302]}}},{"diffOp":{"insert":{"range":[302,311]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[311,326]}}},{"diffOp":{"insert":{"range":[326,336]}}},{"diffOp":{"equal":{"range":[336,338]}}},{"diffOp":{"equal":{"range":[227,237]}}},{"diffOp":{"delete":{"range":[258,283]}}},{"diffOp":{"insert":{"range":[237,258]}}},{"diffOp":{"equal":{"range":[283,295]}}},{"diffOp":{"delete":{"range":[302,311]}}},{"diffOp":{"insert":{"range":[295,302]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[326,336]}}},{"diffOp":{"insert":{"range":[311,326]}}},{"diffOp":{"equal":{"range":[336,338]}}},{"diffOp":{"equal":{"range":[338,411]}}},{"equalLines":{"line_count":1856}},{"diffOp":{"equal":{"range":[411,486]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\deletion.ts"},"span":[323,377],"sourceCode":"/**\n * 记忆彻底删除的持久作业。\n *\n * 删除前先持久化来源、会话、归档和附件范围；数据库清理、归档重写与受管会话\n * 重写沿同一 operationId 分别推进。SQLite 已清理后仍可依据持久计划续作，只有\n * 所有已选受管对象完成才返回 complete。\n */\nimport { randomBytes, randomUUID } from \"node:crypto\";\nimport { existsSync, mkdirSync, readFileSync, renameSync, unlinkSync, writeFileSync } from \"node:fs\";\nimport { dirname, isAbsolute, join, relative, resolve } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { gunzipSync, gzipSync } from \"node:zlib\";\nimport { type SessionEntry, SessionManager } from \"../../core/session-manager.ts\";\nimport { acquireSessionControl } from \"../runtime/session-lock.ts\";\nimport { dbCleanupSourceReferences } from \"../evolution/observe.ts\";\nimport { unlinkArtifactRefsForMemories } from \"./artifacts.ts\";\nimport {\n\tfindDerivedMemoryEntryIds,\n\tfindSourceReplyEntryIds,\n\tredactDeletedSession,\n\tredactManagedRecallFields,\n\tredactMessageContent,\n\ttype SessionEntryRedaction,\n\ttype SessionRedactionPlan,\n} from \"./session-redaction.ts\";\nimport { getSource, type SourceRow } from \"./sources.ts\";\nimport { type MemoryStore, nextScopeRevision } from \"./store.ts\";\nimport type {\n\tDeleteMemoryInput,\n\tDeleteMemoryResult,\n\tDeletionOperationDto,\n\tDeletionPendingObject,\n\tDeletionSessionCoordinator,\n\tDeletionSessionImpact,\n\tDeletionSourceImpact,\n\tDeletionStatus,\n\tMemoryError,\n\tMemoryKind,\n\tMemoryResult,\n\tMemoryScope,\n\tPreviewMemoryDeletionInput,\n\tPreviewMemoryDeletionResult,\n\tSharedSourcePolicy,\n} from \"./types.ts\";\n\nconst OPERATION_VERSION = 1;\nconst PAGE_OPERATION_SESSION_ID = \"desktop-page-operations\";\nconst REDACTED_TEXT = \"[关联记忆已彻底删除]\";\n\ninterface MemoryDbRow {\n\tid: string;\n\tkind: string;\n\tscope_json: string;\n\tcurrent_revision: number;\n\tusage_state: string;\n\tmerged_into: string | null;\n}\n\ninterface SegmentDbRow {\n\tsegment_id: string;\n\tsession_id: string;\n\toriginal_path: string | null;\n\tcompressed_path: string | null;\n\tstatus: string;\n}\n\ninterface SessionMappingRow {\n\tsession_id: string;\n\tsession_file: string;\n\tavailability: string;\n}\n\ninterface StoredDeletionTarget {\n\tmemoryId: string;\n\trevision: number;\n\tprojectId: string;\n}\n\ninterface StoredDeletionSource extends DeletionSourceImpact {\n\tlinkedMemoryIds: string[];\n\tsegmentId?: string;\n\t/** 共享来源仍需扫描其已登记会话，但当前无法定位时保留 pending。 */\n\tderivedScanPending?: string;\n}\n\ninterface StoredDeletionSession extends DeletionSessionImpact {\n\t/** 精确来源选择器仅供内部重写；公开 DTO 只暴露条目 ID。 */\n\tsourceTargets: SessionEntryRedaction[];\n\t/** 执行重写时用于重新核对带目标 ID 的受管派生正文。 */\n\tmemoryIds: string[];\n\t/** 目标记忆已知来源条目；用于识别受管任务快照里的真实引用。 */\n\treferenceEntryIds?: string[];\n\t/** 为 false 表示预览时未能完成受管派生内容扫描。 */\n\tscanComplete: boolean;\n\tdone: boolean;\n}\n\ninterface StoredArchivePlan {\n\tsegmentId: string;\n\tsessionId: string;\n\tpath?: string;\n\tcompressed: boolean;\n\ttargets: SessionEntryRedaction[];\n\treason?: string;\n\tdone: boolean;\n}\n\ninterface StoredAttachmentPlan {\n\tpath: string;\n\t/** 非空表示该引用未被确认位于受管附件目录，保留待处理。 */\n\treason?: string;\n\tdone: boolean;\n}\n\nexport interface StoredDeletionPlan {\n\tversion: typeof OPERATION_VERSION;\n\ttargets: StoredDeletionTarget[];\n\tsources: StoredDeletionSource[];\n\tsessions: StoredDeletionSession[];\n\tarchives: StoredArchivePlan[];\n\tattachments: StoredAttachmentPlan[];\n\tsourceRowsToDelete: string[];\n\tdatabaseDone: boolean;\n}\n\ninterface StoredOperationEnvelope {\n\tversion: typeof OPERATION_VERSION;\n\tplan: StoredDeletionPlan;\n\tfailureReason?: string;\n}\n\ninterface OperationRow {\n\toperation_id: string;\n\tstatus: DeletionStatus;\n\tscope_json: string;\n\tpending_json: string | null;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface PlanBuildResult {\n\tplan: StoredDeletionPlan;\n\tmissingMemoryIds: string[];\n\treferencedBy: PreviewMemoryDeletionResult[\"referencedBy\"];\n\tunmanagedSources: PreviewMemoryDeletionResult[\"unmanagedSources\"];\n}\n\ninterface PreparedHostSessions {\n\t/** 已安全停止、必须在作业 finally 中恢复的会话。 */\n\treload: StoredDeletionSession[];\n\t/** 宿主未能准备或关闭的会话；数据库清理必须先保持待处理。 */\n\tblocked: Set<string>;\n}\n\ninterface RetainedReplySource {\n\tsessionId: string;\n\tentryId: string;\n\tsourceIds: string[];\n\tmemoryIds: string[];\n}\n\nfunction fail(\n\tcode: MemoryError[\"code\"],\n\tmessage: string,\n\textra?: Partial<MemoryError>,\n): { ok: false; error: MemoryError } {\n\treturn { ok: false, error: { code, message, ...extra } };\n}\n\nfunction invalidInput(message: string, refId?: string): { ok: false; error: MemoryError } {\n\treturn fail(\"invalid_input\", message, refId === undefined ? {} : { refId });\n}\n\nfunction nowIso(): string {\n\treturn new Date().toISOString();\n}\n\nfunction paoHomeFromArchives(archivesRoot: string): string {\n\t// memoryPaths(paoHome).archives 位于 <paoHome>/memory/archives。\n\treturn dirname(dirname(resolve(archivesRoot)));\n}\n\nfunction parseScope(scopeJson: string): MemoryScope {\n\treturn JSON.parse(scopeJson) as MemoryScope;\n}\n\nfunction statementIds(values: readonly string[]): string {\n\treturn values.map(() => \"?\").join(\",\");\n}\n\nfunction memoryRow(db: DatabaseSync, memoryId: string): MemoryDbRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT id, kind, scope_json, current_revision, usage_state, merged_into\n\t\t\t FROM memories WHERE id = ?`,\n\t\t)\n\t\t.get(memoryId) as MemoryDbRow | undefined;\n}\n\nfunction tableExists(db: DatabaseSync, table: string): boolean {\n\treturn (\n\t\tdb.prepare(\"SELECT 1 AS ok FROM sqlite_master WHERE type = 'table' AND name = ? LIMIT 1\").get(table) !== undefined\n\t);\n}\n\nfunction conclusionFor(db: DatabaseSync, memoryId: string, revision: number): string {\n\tconst row = db\n\t\t.prepare(\"SELECT content_json FROM memory_revisions WHERE memory_id = ? AND revision = ?\")\n\t\t.get(memoryId, revision) as { content_json: string } | undefined;\n\tif (!row) return \"\";\n\tconst content = JSON.parse(row.content_json) as { conclusion?: unknown };\n\treturn typeof content.conclusion === \"string\" ? content.conclusion : \"\";\n}\n\nfunction conclusionsForTargets(db: DatabaseSync, memoryIds: readonly string[]): string[] {\n\tif (memoryIds.length === 0) return [];\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT content_json FROM memory_revisions\n\t\t\t WHERE memory_id IN (${statementIds(memoryIds)})\n\t\t\t ORDER BY memory_id, revision`,\n\t\t)\n\t\t.all(...memoryIds) as unknown as Array<{ content_json: string }>;\n\tconst conclusions = rows\n\t\t.map((row) => {\n\t\t\tconst content = JSON.parse(row.content_json) as { conclusion?: unknown };\n\t\t\treturn typeof content.conclusion === \"string\" ? content.conclusion : \"\";\n\t\t})\n\t\t.filter((conclusion) => conclusion.length >= 8);\n\treturn [...new Set(conclusions)];\n}\n\nfunction normalizePolicy(policy: SharedSourcePolicy | undefined): SharedSourcePolicy {\n\treturn policy ?? \"retain\";\n}\n\nfunction validatePolicy(input: PreviewMemoryDeletionInput | DeleteMemoryInput): MemoryError | undefined {\n\tif (\n\t\tinput.sharedSourcePolicy !== undefined &&\n\t\tinput.sharedSourcePolicy !== \"retain\" &&\n\t\tinput.sharedSourcePolicy !== \"include-referencing-memories\"\n\t) {\n\t\treturn {\n\t\t\tcode: \"invalid_input\",\n\t\t\tmessage: `未知共享来源策略:${String(input.sharedSourcePolicy)}`,\n\t\t};\n\t}\n\treturn undefined;\n}\n\n/** 路径是否为受管根目录下的严格子路径。 */\nexport function isInsideArchives(managedRoot: string, candidate: string): boolean {\n\tconst rel = relative(resolve(managedRoot), resolve(candidate));\n\treturn rel !== \"\" && !rel.startsWith(\"..\") && !isAbsolute(rel);\n}\n\nfunction replaceFileAtomic(filePath: string, data: Buffer): void {\n\tmkdirSync(dirname(filePath), { recursive: true });\n\tconst tmp = `${filePath}.${process.pid}.${randomBytes(4).toString(\"hex\")}.tmp`;\n\ttry {\n\t\twriteFileSync(tmp, data);\n\t\tfor (let attempt = 0; attempt < 3; attempt += 1) {\n\t\t\ttry {\n\t\t\t\trenameSync(tmp, filePath);\n\t\t\t\treturn;\n\t\t\t} catch (error) {\n\t\t\t\tconst code = (error as NodeJS.ErrnoException).code;\n\t\t\t\tif (attempt === 2 || (code !== \"EPERM\" && code !== \"EACCES\")) throw error;\n\t\t\t}\n\t\t}\n\t} catch (error) {\n\t\ttry {\n\t\t\tunlinkSync(tmp);\n\t\t} catch {\n\t\t\t// 清理临时文件失败时保留原始重写错误。\n\t\t}\n\t\tthrow error;\n\t}\n}\n\nfunction segmentText(segment: SegmentDbRow): { text: string; compressed: boolean; path: string } | undefined {\n\tconst candidates = segment.compressed_path\n\t\t? [{ path: segment.compressed_path, compressed: true }]\n\t\t: segment.original_path\n\t\t\t? [\n\t\t\t\t\t{ path: segment.original_path, compressed: false },\n\t\t\t\t\t{ path: `${segment.original_path}.gz`, compressed: true },\n\t\t\t\t]\n\t\t\t: [];\n\tfor (const candidate of candidates) {\n\t\tif (!existsSync(candidate.path)) continue;\n\t\ttry {\n\t\t\tconst raw = readFileSync(candidate.path);\n\t\t\treturn {\n\t\t\t\ttext: candidate.compressed ? gunzipSync(raw).toString(\"utf8\") : raw.toString(\"utf8\"),\n\t\t\t\tcompressed: candidate.compressed,\n\t\t\t\tpath: candidate.path,\n\t\t\t};\n\t\t} catch {\n\t\t\treturn undefined;\n\t\t}\n\t}\n\treturn undefined;\n}\n\nfunction segmentDbRow(db: DatabaseSync, segmentId: string): SegmentDbRow | undefined {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT segment_id, session_id, original_path, compressed_path, status\n\t\t\t FROM archive_segments WHERE segment_id = ?`,\n\t\t)\n\t\t.get(segmentId) as SegmentDbRow | undefined;\n}\n\nfunction archiveEntryType(db: DatabaseSync, source: SourceRow): string | undefined {\n\tif (!source.segmentId) return undefined;\n\tconst segment = segmentDbRow(db, source.segmentId);\n\tif (!segment) return undefined;\n\tconst data = segmentText(segment);\n\tif (!data) return undefined;\n\tfor (const line of data.text.split(\"\\n\")) {\n\t\tif (!line.trim()) continue;\n\t\ttry {\n\t\t\tconst event = JSON.parse(line) as { entryId?: unknown; entryType?: unknown };\n\t\t\tif (event.entryId === source.entryId && typeof event.entryType === \"string\") return event.entryType;\n\t\t} catch {\n\t\t\t// 损坏的归档行不能用于确认所有权或条目类型。\n\t\t}\n\t}\n\treturn undefined;\n}\n\nfunction isArchiveOnlySource(db: DatabaseSync, source: SourceRow): boolean {\n\tif (source.sessionId === PAGE_OPERATION_SESSION_ID) return true;\n\tif (source.entryId.startsWith(\"receipt-\")) return true;\n\tconst entryType = archiveEntryType(db, source);\n\treturn entryType === \"page_operation\" || entryType === \"receipt\";\n}\n\nfunction parseArchiveLine(line: string): Record<string, unknown> | undefined {\n\ttry {\n\t\tconst value = JSON.parse(line) as unknown;\n\t\treturn value && typeof value === \"object\" ? (value as Record<string, unknown>) : undefined;\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\nfunction archivedEventIsManaged(event: Record<string, unknown>): boolean {\n\tconst entryType = typeof event.entryType === \"string\" ? event.entryType : \"\";\n\tconst content =\n\t\tevent.content && typeof event.content === \"object\" ? (event.content as Record<string, unknown>) : undefined;\n\tif (entryType === \"custom_message\") {\n\t\treturn (\n\t\t\tcontent?.customType === \"pao-auto-recall\" ||\n\t\t\t(typeof content?.customType === \"string\" && content.customType.startsWith(\"pao-memory-\"))\n\t\t);\n\t}\n\tif (entryType === \"custom\") {\n\t\treturn (\n\t\t\tcontent?.customType === \"pao-task-snapshot\" ||\n\t\t\t(typeof content?.customType === \"string\" && content.customType.startsWith(\"pao-memory-\"))\n\t\t);\n\t}\n\tif (entryType === \"compaction\" || entryType === \"branch_summary\") return true;\n\treturn (\n\t\tentryType === \"message\" &&\n\t\tcontent?.role === \"toolResult\" &&\n\t\ttypeof content.toolName === \"string\" &&\n\t\tcontent.toolName.startsWith(\"pao_memory_\")\n\t);\n}\n\nfunction archivedEventMentionsTarget(\n\tevent: Record<string, unknown>,\n\tmemoryIds: readonly string[],\n\tconclusions: readonly string[],\n\treferenceEntryIds: readonly string[],\n): boolean {\n\tconst text = JSON.stringify(event.content) ?? \"\";\n\tif (memoryIds.some((id) => text.includes(id))) return true;\n\tif (conclusions.some((conclusion) => conclusion.length >= 8 && text.includes(conclusion))) return true;\n\tconst content =\n\t\tevent.content && typeof event.content === \"object\" ? (event.content as Record<string, unknown>) : undefined;\n\tif (content?.customType !== \"pao-task-snapshot\") return false;\n\tconst data =\n\t\tcontent.data && typeof content.data === \"object\" ? (content.data as Record<string, unknown>) : undefined;\n\tif (!Array.isArray(data?.items)) return false;\n\tconst refs = new Set(referenceEntryIds);\n\treturn data.items.some((item) => {\n\t\tconst record = item && typeof item === \"object\" ? (item as Record<string, unknown>) : undefined;\n\t\treturn typeof record?.entryId === \"string\" && refs.has(record.entryId);\n\t});\n}\n\nfunction hasWholeEventSelector(targets: readonly SessionEntryRedaction[], eventType: string): boolean {\n\treturn targets.some((target) => target.eventTypes.includes(eventType));\n}\n\nfunction toolCallIds(targets: readonly SessionEntryRedaction[]): string[] {\n\treturn [\n\t\t...new Set(\n\t\t\ttargets.flatMap((target) =>\n\t\t\t\ttarget.eventTypes\n\t\t\t\t\t.filter((eventType) => eventType.startsWith(\"toolcall:\"))\n\t\t\t\t\t.map((eventType) => eventType.slice(\"toolcall:\".length)),\n\t\t\t),\n\t\t),\n\t];\n}\n\nfunction redactArchiveContent(content: unknown, ids: readonly string[]): unknown {\n\tif (typeof content === \"string\") return REDACTED_TEXT;\n\tconst record = content && typeof content === \"object\" ? (content as Record<string, unknown>) : undefined;\n\tif (!record) return content;\n\tif (record.role === \"assistant\" && (\"content\" in record || record.content === undefined)) {\n\t\tif (ids.length === 1) {\n\t\t\treturn { ...record, content: redactMessageContent(record.content, ids[0]) };\n\t\t}\n\t\treturn {\n\t\t\t...record,\n\t\t\tcontent: Array.isArray(record.content)\n\t\t\t\t? record.content.map((raw) => {\n\t\t\t\t\t\tconst block = raw && typeof raw === \"object\" ? (raw as Record<string, unknown>) : undefined;\n\t\t\t\t\t\tif (block?.type !== \"toolCall\" || !ids.includes(String(block.id))) return raw;\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\ttype: \"toolCall\",\n\t\t\t\t\t\t\tid: block.id,\n\t\t\t\t\t\t\tname: block.name,\n\t\t\t\t\t\t\targuments: {},\n\t\t\t\t\t\t\t...(typeof block.namespace === \"string\" ? { namespace: block.namespace } : {}),\n\t\t\t\t\t\t};\n\t\t\t\t\t})\n\t\t\t\t: redactMessageContent(record.content),\n\t\t};\n\t}\n\treturn { redacted: true };\n}\n\n/**\n * 按 entryId 与 eventType 选择器重写一段归档 JSONL。\n *\n * 整事件选择器移除对应行；toolcall:{id} 保留 assistant 条目及无关调用，只清空\n * 被选工具调用的参数。无法解析的行原样保留。\n */\nexport function redactSegmentLines(\n\tcontent: string,\n\ttargets: readonly SessionEntryRedaction[],\n): { filtered: string; removed: number; redacted: number } {\n\tconst selectors = new Map<string, string[]>();\n\tfor (const target of targets) {\n\t\tselectors.set(target.entryId, [...new Set([...(selectors.get(target.entryId) ?? []), ...target.eventTypes])]);\n\t}\n\tconst recallMemoryIds = [...new Set(targets.flatMap((target) => target.memoryIds ?? []))];\n\tconst kept: string[] = [];\n\tlet removed = 0;\n\tlet redacted = 0;\n\tfor (const line of content.split(\"\\n\")) {\n\t\tif (line.length === 0) {\n\t\t\tkept.push(line);\n\t\t\tcontinue;\n\t\t}\n\t\tconst parsed = parseArchiveLine(line);\n\t\tconst entryId = typeof parsed?.entryId === \"string\" ? parsed.entryId : undefined;\n\t\tconst eventTypes = entryId ? selectors.get(entryId) : undefined;\n\t\tif (!parsed || !entryId || !eventTypes) {\n\t\t\tkept.push(line);\n\t\t\tcontinue;\n\t\t}\n\t\tconst archivedEventType = typeof parsed.eventType === \"string\" ? parsed.eventType : \"\";\n\t\tconst redactedRecall = redactManagedRecallFields(parsed.content, recallMemoryIds);\n\t\tif (redactedRecall) {\n\t\t\tkept.push(JSON.stringify({ ...parsed, content: redactedRecall }));\n\t\t\tredacted += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tif (\n\t\t\thasWholeEventSelector(\n\t\t\t\ttargets.filter((target) => target.entryId === entryId),\n\t\t\t\tarchivedEventType,\n\t\t\t)\n\t\t) {\n\t\t\tremoved += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tconst ids = toolCallIds(targets.filter((target) => target.entryId === entryId));\n\t\tif (ids.length > 0) {\n\t\t\tkept.push(JSON.stringify({ ...parsed, content: redactArchiveContent(parsed.content, ids) }));\n\t\t\tredacted += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tkept.push(line);\n\t}\n\treturn { filtered: kept.join(\"\\n\"), removed, redacted };\n}\n\n/** 供需要整行移除条目的调用方使用的兼容入口。 */\nexport function filterSegmentLines(\n\tcontent: string,\n\tremoveEntryIds: ReadonlySet<string>,\n): { filtered: string; removed: number } {\n\tconst targets = [...removeEntryIds].map((entryId) => ({ entryId, eventTypes: [] as string[] }));\n\tconst result = redactSegmentLines(\n\t\tcontent,\n\t\ttargets.map((target) => ({ ...target, eventTypes: [\"__whole_event__\"] })),\n\t);\n\tif (result.removed === 0) {\n\t\tconst kept: string[] = [];\n\t\tlet removed = 0;\n\t\tfor (const line of content.split(\"\\n\")) {\n\t\t\tconst parsed = parseArchiveLine(line);\n\t\t\tconst id =\n\t\t\t\ttypeof parsed?.entryId === \"string\"\n\t\t\t\t\t? parsed.entryId\n\t\t\t\t\t: typeof parsed?.id === \"string\"\n\t\t\t\t\t\t? parsed.id\n\t\t\t\t\t\t: undefined;\n\t\t\tif (id && removeEntryIds.has(id)) {\n\t\t\t\tremoved += 1;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tkept.push(line);\n\t\t}\n\t\treturn { filtered: kept.join(\"\\n\"), removed };\n\t}\n\treturn { filtered: result.filtered, removed: result.removed };\n}\n\nexport function rewriteSegmentFile(\n\tmanagedPath: string,\n\ttargets: readonly SessionEntryRedaction[],\n\tcompressed: boolean,\n): { ok: true; removed: number; redacted: number } | { ok: false; reason: string } {\n\tif (!existsSync(managedPath)) {\n\t\treturn { ok: false, reason: `归档段不存在:${managedPath}` };\n\t}\n\ttry {\n\t\tconst raw = readFileSync(managedPath);\n\t\tconst text = compressed ? gunzipSync(raw).toString(\"utf8\") : raw.toString(\"utf8\");\n\t\tconst result = redactSegmentLines(text, targets);\n\t\tif (result.removed === 0 && result.redacted === 0) {\n\t\t\treturn { ok: true, removed: 0, redacted: 0 };\n\t\t}\n\t\treplaceFileAtomic(\n\t\t\tmanagedPath,\n\t\t\tcompressed ? gzipSync(Buffer.from(result.filtered, \"utf8\")) : Buffer.from(result.filtered, \"utf8\"),\n\t\t);\n\t\treturn { ok: true, removed: result.removed, redacted: result.redacted };\n\t} catch (error) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\treason: `归档段重写失败:${managedPath}:${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n}\n\nfunction collectAttachmentPaths(value: unknown, output: Set<string>): void {\n\tif (!value || typeof value !== \"object\") return;\n\tif (Array.isArray(value)) {\n\t\tfor (const item of value) collectAttachmentPaths(item, output);\n\t\treturn;\n\t}\n\tconst record = value as Record<string, unknown>;\n\tif (typeof record.managedPath === \"string\" && typeof record.attachmentId === \"string\") {\n\t\toutput.add(record.managedPath);\n\t}\n\tfor (const child of Object.values(record)) collectAttachmentPaths(child, output);\n}\n\nfunction archiveEntryMatchesTarget(\n\tentryId: string,\n\teventType: string,\n\ttargets: readonly SessionEntryRedaction[],\n): boolean {\n\treturn targets.some(\n\t\t(target) =>\n\t\t\ttarget.entryId === entryId &&\n\t\t\t(target.eventTypes.includes(eventType) || target.eventTypes.some((value) => value.startsWith(\"toolcall:\"))),\n\t);\n}\n\nfunction findManagedAttachments(\n\tarchivesRoot: string,\n\tarchivePlans: readonly StoredArchivePlan[],\n): { paths: string[]; unmanaged: Array<{ path: string; segmentId: string }> } {\n\tconst attachmentRoot = join(dirname(archivesRoot), \"attachments\");\n\tconst targetRefs = new Set<string>();\n\tconst otherRefs = new Set<string>();\n\tfor (const archive of archivePlans) {\n\t\tif (!archive.path || archive.done || !existsSync(archive.path)) continue;\n\t\ttry {\n\t\t\tconst raw = readFileSync(archive.path);\n\t\t\tconst text = archive.compressed ? gunzipSync(raw).toString(\"utf8\") : raw.toString(\"utf8\");\n\t\t\tfor (const line of text.split(\"\\n\")) {\n\t\t\t\tconst event = parseArchiveLine(line);\n\t\t\t\tif (!event || typeof event.entryId !== \"string\" || typeof event.eventType !== \"string\") continue;\n\t\t\t\tconst refs = new Set<string>();\n\t\t\t\tcollectAttachmentPaths(event.content, refs);\n\t\t\t\tconst target = archiveEntryMatchesTarget(event.entryId, event.eventType, archive.targets);\n\t\t\t\tfor (const ref of refs) (target ? targetRefs : otherRefs).add(ref);\n\t\t\t}\n\t\t} catch {\n\t\t\t// 无法读取时让该归档对应的删除作业保持 pending。\n\t\t}\n\t}\n\tconst paths: string[] = [];\n\tconst unmanaged: Array<{ path: string; segmentId: string }> = [];\n\tfor (const ref of targetRefs) {\n\t\tif (otherRefs.has(ref)) continue;\n\t\tconst fullPath = resolve(dirname(archivesRoot), ref);\n\t\tif (isInsideArchives(attachmentRoot, fullPath)) paths.push(fullPath);\n\t\telse unmanaged.push({ path: fullPath, segmentId: \"\" });\n\t}\n\treturn { paths: [...new Set(paths)].sort(), unmanaged };\n}\n\nfunction sourceLinksForTargets(db: DatabaseSync, targetIds: readonly string[]): string[] {\n\tif (targetIds.length === 0) return [];\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT DISTINCT source_id FROM memory_source_links\n\t\t\t WHERE memory_id IN (${statementIds(targetIds)})\n\t\t\t ORDER BY source_id`,\n\t\t)\n\t\t.all(...targetIds) as unknown as Array<{ source_id: string }>;\n\treturn rows.map((row) => row.source_id);\n}\n\nfunction memoriesForSources(db: DatabaseSync, sourceIds: readonly string[]): string[] {\n\tif (sourceIds.length === 0) return [];\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT DISTINCT memory_id FROM memory_source_links\n\t\t\t WHERE source_id IN (${statementIds(sourceIds)})\n\t\t\t ORDER BY memory_id`,\n\t\t)\n\t\t.all(...sourceIds) as unknown as Array<{ memory_id: string }>;\n\treturn rows.map((row) => row.memory_id);\n}\n\nfunction sourceRowsForEntry(db: DatabaseSync, sessionId: string, entryId: string): string[] {\n\treturn (\n\t\tdb\n\t\t\t.prepare(\"SELECT source_id FROM sources WHERE session_id = ? AND entry_id = ? ORDER BY source_id\")\n\t\t\t.all(sessionId, entryId) as unknown as Array<{ source_id: string }>\n\t).map((row) => row.source_id);\n}\n\nfunction initialTargetIds(db: DatabaseSync, input: PreviewMemoryDeletionInput): Set<string> {\n\tconst ids = new Set<string>();\n\tif (input.memoryId) ids.add(input.memoryId);\n\tif (input.sourceId) {\n\t\tfor (const row of db\n\t\t\t.prepare(\"SELECT DISTINCT memory_id FROM memory_source_links WHERE source_id = ?\")\n\t\t\t.all(input.sourceId) as unknown as Array<{ memory_id: string }>) {\n\t\t\tids.add(row.memory_id);\n\t\t}\n\t}\n\tif (input.sessionId || input.entryId) {\n\t\tconst rows = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT DISTINCT l.memory_id\n\t\t\t\t FROM memory_source_links l\n\t\t\t\t JOIN sources s ON s.source_id = l.source_id\n\t\t\t\t WHERE (? IS NULL OR s.session_id = ?)\n\t\t\t\t   AND (? IS NULL OR s.entry_id = ?)`,\n\t\t\t)\n\t\t\t.all(\n\t\t\t\tinput.sessionId ?? null,\n\t\t\t\tinput.sessionId ?? null,\n\t\t\t\tinput.entryId ?? null,\n\t\t\t\tinput.entryId ?? null,\n\t\t\t) as unknown as Array<{ memory_id: string }>;\n\t\tfor (const row of rows) ids.add(row.memory_id);\n\t}\n\treturn ids;\n}\n\nfunction expandRetainedSourceTargets(\n\tdb: DatabaseSync,\n\tinitialIds: ReadonlySet<string>,\n\tpolicy: SharedSourcePolicy,\n): Set<string> {\n\tconst targetIds = new Set(initialIds);\n\tif (policy === \"retain\") return targetIds;\n\tlet changed = true;\n\twhile (changed) {\n\t\tchanged = false;\n\t\tfor (const memoryId of memoriesForSources(db, sourceLinksForTargets(db, [...targetIds]))) {\n\t\t\tif (targetIds.has(memoryId) || !memoryRow(db, memoryId)) continue;\n\t\t\ttargetIds.add(memoryId);\n\t\t\tchanged = true;\n\t\t}\n\t}\n\treturn targetIds;\n}\n\nfunction expandCausalReplyTargets(\n\tdb: DatabaseSync,\n\tmappings: readonly SessionMappingRow[],\n\tinitialIds: ReadonlySet<string>,\n\tpolicy: SharedSourcePolicy,\n): Set<string> {\n\tif (policy === \"retain\") return new Set(initialIds);\n\tconst targetIds = new Set(initialIds);\n\tconst entriesBySession = new Map<string, SessionEntry[]>();\n\tconst readEntries = (mapping: SessionMappingRow): SessionEntry[] => {\n\t\tconst cached = entriesBySession.get(mapping.session_id);\n\t\tif (cached) return cached;\n\t\tif (!existsSync(mapping.session_file)) return [];\n\t\tconst entries = readSessionEntries(mapping.session_file);\n\t\tentriesBySession.set(mapping.session_id, entries);\n\t\treturn entries;\n\t};\n\n\tlet changed = true;\n\twhile (changed) {\n\t\tchanged = false;\n\t\tconst sourceRows = sourceLinksForTargets(db, [...targetIds])\n\t\t\t.map((sourceId) => getSource(db, sourceId))\n\t\t\t.filter((source): source is SourceRow => source !== undefined);\n\t\tconst references = sourceRows.map((source) => source.entryId);\n\t\tconst conclusions = conclusionsForTargets(db, [...targetIds]);\n\t\tfor (const mapping of mappings) {\n\t\t\tconst userSources = sourceRows\n\t\t\t\t.filter((source) => source.sessionId === mapping.session_id && source.eventType === \"user\")\n\t\t\t\t.map((source) => source.entryId);\n\t\t\tconst entries = readEntries(mapping);\n\t\t\tif (entries.length === 0) continue;\n\t\t\tconst managedAnchors = findDerivedMemoryEntryIds(entries, [...targetIds], conclusions, references, references);\n\t\t\tfor (const replyId of findSourceReplyEntryIds(entries, userSources, managedAnchors)) {\n\t\t\t\tconst linkedMemoryIds = memoriesForSources(db, sourceRowsForEntry(db, mapping.session_id, replyId)).filter(\n\t\t\t\t\t(memoryId) => memoryRow(db, memoryId) !== undefined,\n\t\t\t\t);\n\t\t\t\tfor (const memoryId of linkedMemoryIds) {\n\t\t\t\t\tif (targetIds.has(memoryId)) continue;\n\t\t\t\t\ttargetIds.add(memoryId);\n\t\t\t\t\tchanged = true;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn targetIds;\n}\n\nfunction sourceMemoryIds(db: DatabaseSync, sourceId: string): string[] {\n\treturn (\n\t\tdb\n\t\t\t.prepare(\"SELECT DISTINCT memory_id FROM memory_source_links WHERE source_id = ? ORDER BY memory_id\")\n\t\t\t.all(sourceId) as unknown as Array<{ memory_id: string }>\n\t).map((row) => row.memory_id);\n}\n\nfunction sessionMapping(db: DatabaseSync, sessionId: string): SessionMappingRow | undefined {\n\tif (!tableExists(db, \"memory_sessions\")) return undefined;\n\treturn db\n\t\t.prepare(\"SELECT session_id, session_file, availability FROM memory_sessions WHERE session_id = ?\")\n\t\t.get(sessionId) as SessionMappingRow | undefined;\n}\n\nfunction sessionMappings(db: DatabaseSync): SessionMappingRow[] {\n\tif (!tableExists(db, \"memory_sessions\")) return [];\n\treturn db\n\t\t.prepare(\"SELECT session_id, session_file, availability FROM memory_sessions ORDER BY session_id\")\n\t\t.all() as unknown as SessionMappingRow[];\n}\n\nfunction usageSessionIds(db: DatabaseSync, memoryIds: readonly string[]): string[] {\n\tif (memoryIds.length === 0 || !tableExists(db, \"memory_usage\")) return [];\n\treturn (\n\t\tdb\n\t\t\t.prepare(\n\t\t\t\t`SELECT DISTINCT session_id FROM memory_usage\n\t\t\t\t WHERE memory_id IN (${statementIds(memoryIds)})\n\t\t\t\t   AND action IN ('inject', 'expand', 'used')\n\t\t\t\t   AND session_id IS NOT NULL\n\t\t\t\t ORDER BY session_id`,\n\t\t\t)\n\t\t\t.all(...memoryIds) as unknown as Array<{ session_id: string }>\n\t).map((row) => row.session_id);\n}\n\nfunction segmentsForSession(db: DatabaseSync, sessionId: string): SegmentDbRow[] {\n\treturn db\n\t\t.prepare(\n\t\t\t`SELECT segment_id, session_id, original_path, compressed_path, status\n\t\t\t FROM archive_segments WHERE session_id = ?\n\t\t\t ORDER BY segment_id`,\n\t\t)\n\t\t.all(sessionId) as unknown as SegmentDbRow[];\n}\n\nfunction addSourceTarget(map: Map<string, string[]>, entryId: string, eventType: string): void {\n\tmap.set(entryId, [...new Set([...(map.get(entryId) ?? []), eventType])]);\n}\n\nfunction sourceTargetsFromMap(\n\tmap: ReadonlyMap<string, string[]>,\n\tmemoryIds: readonly string[] = [],\n): SessionEntryRedaction[] {\n\treturn [...map.entries()]\n\t\t.sort(([left], [right]) => left.localeCompare(right))\n\t\t.map(([entryId, eventTypes]) => ({\n\t\t\tentryId,\n\t\t\teventTypes: [...new Set(eventTypes)].sort(),\n\t\t\t...(memoryIds.length === 0 ? {} : { memoryIds: [...memoryIds] }),\n\t\t}));\n}\n\nfunction readSessionEntries(sessionFile: string): SessionEntry[] {\n\treturn SessionManager.open(sessionFile).getEntries();\n}\n\n/**\n * 在来源图仍存在时构建完整删除计划。本函数只读取 SQLite 与受管文件。\n */\nexport async function buildDeletionPlan(\n\tdb: DatabaseSync,\n\tarchivesRoot: string,\n\tmemoryIds: readonly string[],\n\tpolicyInput?: SharedSourcePolicy,\n): Promise<PlanBuildResult> {\n\tconst policy = normalizePolicy(policyInput);\n\tconst initial = new Set(memoryIds);\n\tconst registeredMappings = sessionMappings(db);\n\tconst retainedExpanded = expandRetainedSourceTargets(db, initial, policy);\n\tconst causalExpanded = expandCausalReplyTargets(db, registeredMappings, retainedExpanded, policy);\n\tconst expanded = expandRetainedSourceTargets(db, causalExpanded, policy);\n\tconst missingMemoryIds = [...expanded].filter((id) => !memoryRow(db, id)).sort();\n\tconst targetRows = [...expanded]\n\t\t.filter((id) => memoryRow(db, id) !== undefined)\n\t\t.sort()\n\t\t.map((id) => memoryRow(db, id)!);\n\tconst targetIds = targetRows.map((row) => row.id);\n\tconst targetSet = new Set(targetIds);\n\tconst conclusions = conclusionsForTargets(db, targetIds);\n\tconst registeredMappingsById = new Map(registeredMappings.map((mapping) => [mapping.session_id, mapping]));\n\n\tconst referencedBy: PreviewMemoryDeletionResult[\"referencedBy\"] = [];\n\tfor (const memoryId of targetIds) {\n\t\tconst rows = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT DISTINCT memory_id, relation FROM revision_links\n\t\t\t\t WHERE target_memory_id = ? AND memory_id != ?`,\n\t\t\t)\n\t\t\t.all(memoryId, memoryId) as unknown as Array<{ memory_id: string; relation: string }>;\n\t\tfor (const row of rows) {\n\t\t\tif (!targetSet.has(row.memory_id)) {\n\t\t\t\treferencedBy.push({ memoryId, referencedBy: row.memory_id, relation: row.relation });\n\t\t\t}\n\t\t}\n\t}\n\n\tconst sources: StoredDeletionSource[] = [];\n\tconst unmanagedSources: PreviewMemoryDeletionResult[\"unmanagedSources\"] = [];\n\tconst sessionSourceTargets = new Map<string, Map<string, string[]>>();\n\tconst sessionFiles = new Map<string, string>();\n\tconst derivedScanSessionIds = new Set<string>();\n\tconst archiveTargets = new Map<string, Map<string, string[]>>();\n\tconst archiveSessions = new Map<string, string>();\n\tconst archiveOnlySessions = new Set<string>();\n\tfor (const sourceId of sourceLinksForTargets(db, targetIds)) {\n\t\tconst source = getSource(db, sourceId);\n\t\tconst linkedMemoryIds = sourceMemoryIds(db, sourceId);\n\t\tconst sharedWithMemoryIds = linkedMemoryIds.filter((id) => !targetSet.has(id)).sort();\n\t\tif (!source) {\n\t\t\tsources.push({\n\t\t\t\tsourceId,\n\t\t\t\tsessionId: \"\",\n\t\t\t\tentryId: \"\",\n\t\t\t\teventType: \"\",\n\t\t\t\tcapturedAt: \"\",\n\t\t\t\tresolution: \"unknown\",\n\t\t\t\tsharedWithMemoryIds,\n\t\t\t\taction: \"retain\",\n\t\t\t\tlinkedMemoryIds,\n\t\t\t});\n\t\t\tunmanagedSources.push({ sourceId, reason: \"sources 行缺失，无法定位来源正文\" });\n\t\t\tcontinue;\n\t\t}\n\t\tconst retain = sharedWithMemoryIds.length > 0 && policy === \"retain\";\n\t\tconst archiveOnly = isArchiveOnlySource(db, source);\n\t\tconst mapping = archiveOnly ? undefined : sessionMapping(db, source.sessionId);\n\t\tlet derivedScanPending: string | undefined;\n\t\tlet resolution: DeletionSourceImpact[\"resolution\"];\n\t\tif (retain) {\n\t\t\tresolution = \"shared-retained\";\n\t\t\tif (!archiveOnly) {\n\t\t\t\tif (mapping && existsSync(mapping.session_file)) {\n\t\t\t\t\tsessionFiles.set(source.sessionId, mapping.session_file);\n\t\t\t\t\tderivedScanSessionIds.add(source.sessionId);\n\t\t\t\t} else if (!mapping) {\n\t\t\t\t\tderivedScanPending = `会话 ${source.sessionId} 没有真实 SessionManager 文件登记`;\n\t\t\t\t\tunmanagedSources.push({ sourceId, reason: derivedScanPending });\n\t\t\t\t}\n\t\t\t}\n\t\t} else if (archiveOnly) {\n\t\t\tresolution = \"archive-only\";\n\t\t\tarchiveOnlySessions.add(source.sessionId);\n\t\t} else {\n\t\t\tif (mapping && existsSync(mapping.session_file)) {\n\t\t\t\tresolution = \"session\";\n\t\t\t\tsessionFiles.set(source.sessionId, mapping.session_file);\n\t\t\t\tderivedScanSessionIds.add(source.sessionId);\n\t\t\t} else if (mapping) {\n\t\t\t\t// 登记路径已确认不存在时，不再把“没有 live JSONL 可重写”误报成未知位置。\n\t\t\t\tresolution = source.segmentId ? \"archive-only\" : \"session\";\n\t\t\t} else {\n\t\t\t\tresolution = \"unknown\";\n\t\t\t\tunmanagedSources.push({\n\t\t\t\t\tsourceId,\n\t\t\t\t\treason: `会话 ${source.sessionId} 没有真实 SessionManager 文件登记`,\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t\tsources.push({\n\t\t\tsourceId,\n\t\t\tsessionId: source.sessionId,\n\t\t\tentryId: source.entryId,\n\t\t\teventType: source.eventType,\n\t\t\tcapturedAt: source.capturedAt,\n\t\t\tresolution,\n\t\t\tsharedWithMemoryIds,\n\t\t\taction: retain ? \"retain\" : \"redact\",\n\t\t\tlinkedMemoryIds,\n\t\t\t...(source.segmentId === undefined ? {} : { segmentId: source.segmentId }),\n\t\t\t...(derivedScanPending === undefined ? {} : { derivedScanPending }),\n\t\t});\n\t\tif (retain) continue;\n\t\tif (resolution !== \"archive-only\") {\n\t\t\tconst perSession = sessionSourceTargets.get(source.sessionId) ?? new Map<string, string[]>();\n\t\t\taddSourceTarget(perSession, source.entryId, source.eventType);\n\t\t\tsessionSourceTargets.set(source.sessionId, perSession);\n\t\t}\n\t\tif (source.segmentId) {\n\t\t\tconst perSegment = archiveTargets.get(source.segmentId) ?? new Map<string, string[]>();\n\t\t\taddSourceTarget(perSegment, source.entryId, source.eventType);\n\t\t\tarchiveTargets.set(source.segmentId, perSegment);\n\t\t\tarchiveSessions.set(sou