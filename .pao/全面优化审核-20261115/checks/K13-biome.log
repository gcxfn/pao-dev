ferences: options.resolveMemoryReferences() } : {}),\r\n\t\t\t\t});\r\n\t\t\t\tconst snapshot = await freezeDispatchBrief(draft, claim, {\r\n\t\t\t\t\tcardsDir: input.cardsDir,\r\n\t\t\t\t\tcardNo: claimed.card.card_no,\r\n\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\tprojectRoot,\r\n\t\t\t\t\trepositoryRoot: workspace.repositoryRoot!,\r\n\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\tcommonGitDir: workspace.commonGitDir,\r\n\t\t\t\t\tversionControl: workspace.commonGitDir ? \"git\" : \"none\",\r\n\t\t\t\t\t...(workspace.worktreeId ? { worktreeId: workspace.worktreeId } : {}),\r\n\t\t\t\t\t...(workspace.baseHead ? { baseHead: workspace.baseHead } : {}),\r\n\t\t\t\t\t...(workspace.baseTreeId ? { baseTreeId: workspace.baseTreeId } : {}),\r\n\t\t\t\t\tinputVersion: workspace.inputVersion,\r\n\t\t\t\t\tbindingDigest: workspace.bindingDigest,\r\n\t\t\t\t});\r\n\t\t\t\tconst snapshotPath = dispatchInputSnapshotPath(input.cardsDir, claimed.card.card_no, claimed.尝试号);\r\n\t\t\t\texecutionIdentity = await bindExecutionContext(\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tkey: { cardsDir: input.cardsDir, cardNo: claimed.card.card_no, attempt: claimed.尝试号 },\r\n\t\t\t\t\t\tprojectRoot,\r\n\t\t\t\t\t\trepositoryRoot: workspace.repositoryRoot!,\r\n\t\t\t\t\t\texecutionRoot: authoritative.executionRoot,\r\n\t\t\t\t\t\tworktree: authoritative,\r\n\t\t\t\t\t\tsnapshotRef: snapshotPath,\r\n\t\t\t\t\t\tsnapshotDigest: snapshot.snapshotDigest,\r\n\t\t\t\t\t\t...(snapshot.brief.ref ? { briefRef: snapshot.brief.ref } : {}),\r\n\t\t\t\t\t},\r\n\t\t\t\t\t{ expectedCurrentAttempt: claimed.尝试号 },\r\n\t\t\t\t);\r\n\t\t\t\tconst baseline = await snapshotClaimBaseline(input.cardsDir, claimed.card.card_no, {\r\n\t\t\t\t\towner: claim.owner,\r\n\t\t\t\t\t时间: input.time,\r\n\t\t\t\t\tattempt: claimed.尝试号,\r\n\t\t\t\t\t验收: claimed.card.frontmatter.acceptance,\r\n\t\t\t\t\texecution: executionIdentity,\r\n\t\t\t\t\tsignal: options.信号,\r\n\t\t\t\t});\r\n\t\t\t\tclaimed.claimBaseline = {\r\n\t\t\