:{"insert":{"range":[333,341]}}},{"diffOp":{"equal":{"range":[354,356]}}},{"diffOp":{"equal":{"range":[654,727]}}},{"equalLines":{"line_count":505}},{"diffOp":{"equal":{"range":[727,736]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-regression.test.ts"},"span":[906,978],"sourceCode":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *\n * 覆盖：\n * - judgeRegression 三种 kind：original_problem（problemId 候选发布过坏版）、\n *   normal_breakage（坏版有 used 行 + 报失败任务绑坏版）、user_reported；\n * - 无关失败不乱归因（无 problemId 无 taskId、problemId 不匹配、任务绑别版）；\n * - handleRegression 完整路径：rollback 事务切回、受影响任务清单、同源未终态\n *   候选标 cancelled、通知载荷（资源/原因/当前有效版/受影响任务）；\n * - 「回退期间另一修复已生效」：指向已非坏版 → no_change 不覆盖；\n * - 无上一有效版 → 不回退，通知如实说明。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-regression.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recordUsed } from \"../../src/pao/evolution/observe.ts\";\nimport { handleRegression, judgeRegression } from \"../../src/pao/evolution/regression.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-reg-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\nconst AT5 = \"2026-11-11T10:04:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId };\n}\n\n/** 直插 problem 行（disposition='candidate' 表示已生成候选解决）。 */\nfunction seedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string; disposition?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\tover.disposition ?? \"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tskillContent?: string;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(\n\t\tjoin(candidateDir, \"SKILL.md\"),\n\t\tover.skillContent ?? `# patched\\n\\n步骤一: 输入\\n步骤三: 验证\\n`,\n\t\t\"utf8\",\n\t);\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { validationId?: string; candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(validationId, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n\treturn validationId;\n}\n\n/** 种到「新版本已激活」：resource + problem + 合法 passed 链 + publish + activate。 */\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── judgeRegression ──────────────────────────────────────────────────────\n\ndescribe(\"judgeRegression\", () => {\n\tit(\"problemId 的候选发布过坏版 → original_problem\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"同样的输出又错了\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"original_problem\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.problemId).toBe(problemId);\n\t\texpect(result.sourceIds).toContain(problemId);\n\t});\n\n\tit(\"坏版有 used 行 + 报失败任务绑坏版 → normal_breakage\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\t// 记一条成功 used（任务用过该版本）。\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r1\", outcome: \"success\" });\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"正常用法现在报错\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"normal_breakage\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"userReported=true → user_reported（无需其他证据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"用户说这版更差了\",\n\t\t\tuserReported: true,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"user_reported\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"无 problemId 无 taskId → isRegression=false 不乱归因\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"不明失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t\texpect(result.reason).toContain(\"保留调查\");\n\t});\n\n\tit(\"problemId 指向的候选没发布过坏版 → isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 另一个 problem 的候选没发布（只种 candidate 行不 publish/activate）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-other\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-other\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId: otherProblemId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"报失败任务绑的是别的版本（非坏版）→ isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 任务绑了坏版后，手动把绑定改回 baseVersion（模拟任务用的旧版）。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = 'task-1'`)\n\t\t\t.run(baseVersion);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── handleRegression ─────────────────────────────────────────────────────\n\ndescribe(\"handleRegression\", () => {\n\tit(\"完整路径：rollback 事务 + 受影响任务清单 + 同源候选标 cancelled + 通知载荷\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 两个任务绑坏版。\n\t\tbindTaskResources(store, { taskId: \"task-a\", resourceIds: [resourceId] });\n\t\tbindTaskResources(store, { taskId: \"task-b\", resourceIds: [resourceId] });\n\t\t// 同源未终态候选（与坏版同 base_version 的 proposed 候选）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-stale\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-stale\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tstatus: \"proposed\",\n\t\t});\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"原问题复现\",\n\t\t\tpaoHome: home,\n\t\t\trollbackAt: AT5,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(true);\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.previousVersion).toBe(baseVersion);\n\n\t\t// 指向切回 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// 受影响任务清单（待切换）。\n\t\texpect(result.affectedTasks.length).toBe(2);\n\t\texpect(result.affectedTasks.map((t) => t.taskId).sort()).toEqual([\"task-a\", \"task-b\"]);\n\t\texpect(result.affectedTasks[0]!.targetVersion).toBe(baseVersion);\n\n\t\t// 通知载荷。\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.resourceId).toBe(resourceId);\n\t\texpect(result.notification!.badVersion).toBe(newVersionId);\n\t\texpect(result.notification!.currentVersion).toBe(baseVersion);\n\t\texpect(result.notification!.affectedTaskIds.sort()).toEqual([\"task-a\", \"task-b\"]);\n\n\t\t// 同源未终态候选标 cancelled。\n\t\tconst staleCand = store.db\n\t\t\t.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = 'cand-stale'`)\n\t\t\t.get() as { status: string; failure_reason: string };\n\t\texpect(staleCand.status).toBe(\"cancelled\");\n\t\texpect(staleCand.failure_reason).toContain(\"已停用\");\n\n\t\t// 坏版 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish' AND reason LIKE '停用:%'`,\n\t\t\t)\n\t\t\t.get(resourceId, newVersionId) as { reason: string } | undefined;\n\t\texpect(pubRow).toBeDefined();\n\t});\n\n\tit(\"回退期间另一修复已生效（指向已非坏版）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 另一路径把 effective_version 改成第三个版本。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tversionId: newVersionId, // 显式指定坏版（因当前指向已变）\n\t\t\tfailureDescription: \"退步判定\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.currentVersion).toBe(otherVersion);\n\t\texpect(result.notification!.reason).toContain(\"另一修复已生效\");\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t});\n\n\tit(\"无上一有效版（坏版是首个生效版且无前版）→ 不回退，通知如实说明\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 种资源但不走 snapshot（effective_version 为 NULL 起步）；\n\t\t// 手动插一条 effective 凭据到坏版，模拟「首个激活版本即坏版」。\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"lonely-skill\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"lonely-skill\", paoHome: home });\n\t\tconst resourceId = \"skill:lonely-skill\";\n\n\t\t// 直接设 effective_version + 一条 effective 凭据（不走快照，模拟无前版场景）。\n\t\tconst badVersion = \"v-firstbad0123\";\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst badDir = join(evolutionPaths(home).versions, dirSafe, badVersion);\n\t\tmkdirSync(badDir, { recursive: true });\n\t\twriteFileSync(join(badDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(badVersion, AT2, resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-first\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbadVersion,\n\t\t\t\t\"首次生效\",\n\t\t\t\tJSON.stringify({ activation: \"effective\", candidateId: \"cand-x\" }),\n\t\t\t\tAT2,\n\t\t\t);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tuserReported: true,\n\t\t\tfailureDescription: \"首个版本就退步\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.reason).toContain(\"找不到上一有效版\");\n\t\texpect(result.notification!.currentVersion).toBe(badVersion);\n\t\t// 指向未改。\n\t\texpect(readEffective(store, resourceId)).toBe(badVersion);\n\t});\n\n\tit(\"judge 为 false → 直接返回 rolledBack=false 不动指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.affectedTasks).toEqual([]);\n\t\texpect(result.notification).toBeUndefined();\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tvalidationId, \"tp-1\",over.candidateId,over.problemId,over.resourceId,over.baseVersion,\"[]\",\"passed\",AT,,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\t\t// 任务绑了坏版后，手动把绑定改回 baseVersion（模拟任务用的旧版）。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tstore.db\n\t\t\t.preparestore.db.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = 'task-1'`).run(baseVersion);\n\n\t\tconst result = judgeRegression(store, {\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,110]}}},{"equalLines":{"line_count":181}},{"diffOp":{"equal":{"range":[110,166]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[170,183]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[184,191]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[191,208]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[208,223]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[223,239]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[239,256]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[256,261]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[261,270]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[270,273]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[270,272]}}},{"diffOp":{"insert":{"range":[273,277]}}},{"diffOp":{"equal":{"range":[277,375]}}},{"equalLines":{"line_count":140}},{"diffOp":{"equal":{"range":[375,550]}}},{"diffOp":{"delete":{"range":[550,570]}}},{"diffOp":{"insert":{"range":[570,586]}}},{"diffOp":{"equal":{"range":[586,664]}}},{"diffOp":{"delete":{"range":[166,170]}}},{"diffOp":{"equal":{"range":[664,725]}}},{"equalLines":{"line_count":197}},{"diffOp":{"equal":{"range":[725,734]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-regression.test.ts"},"span":null,"sourceCode":"/**\n * S9-07/08/09 定向测试：退步判定（judgeRegression）与回退编排（handleRegression）。\n *\n * 覆盖：\n * - judgeRegression 三种 kind：original_problem（problemId 候选发布过坏版）、\n *   normal_breakage（坏版有 used 行 + 报失败任务绑坏版）、user_reported；\n * - 无关失败不乱归因（无 problemId 无 taskId、problemId 不匹配、任务绑别版）；\n * - handleRegression 完整路径：rollback 事务切回、受影响任务清单、同源未终态\n *   候选标 cancelled、通知载荷（资源/原因/当前有效版/受影响任务）；\n * - 「回退期间另一修复已生效」：指向已非坏版 → no_change 不覆盖；\n * - 无上一有效版 → 不回退，通知如实说明。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-regression.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recordUsed } from \"../../src/pao/evolution/observe.ts\";\nimport { handleRegression, judgeRegression } from \"../../src/pao/evolution/regression.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-reg-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\nconst AT5 = \"2026-11-11T10:04:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId };\n}\n\n/** 直插 problem 行（disposition='candidate' 表示已生成候选解决）。 */\nfunction seedProblem(\n\tstore: MemoryStore,\n\tover: { problemId?: string; resourceId?: string; baseVersion?: string; disposition?: string } = {},\n) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\tover.disposition ?? \"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: {\n\t\tcandidateId?: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tstatus?: string;\n\t\tskillContent?: string;\n\t},\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(\n\t\tjoin(candidateDir, \"SKILL.md\"),\n\t\tover.skillContent ?? `# patched\\n\\n步骤一: 输入\\n步骤三: 验证\\n`,\n\t\t\"utf8\",\n\t);\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { validationId?: string; candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst validationId = over.validationId ?? `val-${over.candidateId}`;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(validationId, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${validationId}-e1`, validationId, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n\treturn validationId;\n}\n\n/** 种到「新版本已激活」：resource + problem + 合法 passed 链 + publish + activate。 */\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── judgeRegression ──────────────────────────────────────────────────────\n\ndescribe(\"judgeRegression\", () => {\n\tit(\"problemId 的候选发布过坏版 → original_problem\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"同样的输出又错了\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"original_problem\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.problemId).toBe(problemId);\n\t\texpect(result.sourceIds).toContain(problemId);\n\t});\n\n\tit(\"坏版有 used 行 + 报失败任务绑坏版 → normal_breakage\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\t// 记一条成功 used（任务用过该版本）。\n\t\trecordUsed(store, { resourceId, taskId: \"task-1\", receiptRef: \"r1\", outcome: \"success\" });\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"正常用法现在报错\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"normal_breakage\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"userReported=true → user_reported（无需其他证据）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"用户说这版更差了\",\n\t\t\tuserReported: true,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(true);\n\t\texpect(result.kind).toBe(\"user_reported\");\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t});\n\n\tit(\"无 problemId 无 taskId → isRegression=false 不乱归因\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = await seedActivated(home, store);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"不明失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t\texpect(result.reason).toContain(\"保留调查\");\n\t});\n\n\tit(\"problemId 指向的候选没发布过坏版 → isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 另一个 problem 的候选没发布（只种 candidate 行不 publish/activate）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-other\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-other\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId: otherProblemId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"报失败任务绑的是别的版本（非坏版）→ isRegression=false\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = await seedActivated(home, store);\n\t\t// 任务绑了坏版后，手动把绑定改回 baseVersion（模拟任务用的旧版）。\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_task_bindings SET version_id = ? WHERE task_id = 'task-1'`)\n\t\t\t.run(baseVersion);\n\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId,\n\t\t\ttaskId: \"task-1\",\n\t\t\tfailureDescription: \"失败\",\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.isRegression).toBe(false);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = judgeRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n\n// ── handleRegression ─────────────────────────────────────────────────────\n\ndescribe(\"handleRegression\", () => {\n\tit(\"完整路径：rollback 事务 + 受影响任务清单 + 同源候选标 cancelled + 通知载荷\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 两个任务绑坏版。\n\t\tbindTaskResources(store, { taskId: \"task-a\", resourceIds: [resourceId] });\n\t\tbindTaskResources(store, { taskId: \"task-b\", resourceIds: [resourceId] });\n\t\t// 同源未终态候选（与坏版同 base_version 的 proposed 候选）。\n\t\tconst otherProblemId = seedProblem(store, { problemId: \"prob-stale\", resourceId, baseVersion });\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-stale\",\n\t\t\tproblemId: otherProblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tstatus: \"proposed\",\n\t\t});\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tfailureDescription: \"原问题复现\",\n\t\t\tpaoHome: home,\n\t\t\trollbackAt: AT5,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(true);\n\t\texpect(result.badVersion).toBe(newVersionId);\n\t\texpect(result.previousVersion).toBe(baseVersion);\n\n\t\t// 指向切回 baseVersion。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// 受影响任务清单（待切换）。\n\t\texpect(result.affectedTasks.length).toBe(2);\n\t\texpect(result.affectedTasks.map((t) => t.taskId).sort()).toEqual([\"task-a\", \"task-b\"]);\n\t\texpect(result.affectedTasks[0]!.targetVersion).toBe(baseVersion);\n\n\t\t// 通知载荷。\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.resourceId).toBe(resourceId);\n\t\texpect(result.notification!.badVersion).toBe(newVersionId);\n\t\texpect(result.notification!.currentVersion).toBe(baseVersion);\n\t\texpect(result.notification!.affectedTaskIds.sort()).toEqual([\"task-a\", \"task-b\"]);\n\n\t\t// 同源未终态候选标 cancelled。\n\t\tconst staleCand = store.db\n\t\t\t.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = 'cand-stale'`)\n\t\t\t.get() as { status: string; failure_reason: string };\n\t\texpect(staleCand.status).toBe(\"cancelled\");\n\t\texpect(staleCand.failure_reason).toContain(\"已停用\");\n\n\t\t// 坏版 publish 凭据被标「停用:」。\n\t\tconst pubRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish' AND reason LIKE '停用:%'`,\n\t\t\t)\n\t\t\t.get(resourceId, newVersionId) as { reason: string } | undefined;\n\t\texpect(pubRow).toBeDefined();\n\t});\n\n\tit(\"回退期间另一修复已生效（指向已非坏版）→ no_change 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId, problemId } = await seedActivated(home, store);\n\n\t\t// 另一路径把 effective_version 改成第三个版本。\n\t\tconst otherVersion = \"v-otherfixxx12\";\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(otherVersion, AT4, resourceId);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tproblemId,\n\t\t\tversionId: newVersionId, // 显式指定坏版（因当前指向已变）\n\t\t\tfailureDescription: \"退步判定\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.currentVersion).toBe(otherVersion);\n\t\texpect(result.notification!.reason).toContain(\"另一修复已生效\");\n\t\t// 指向未被覆盖。\n\t\texpect(readEffective(store, resourceId)).toBe(otherVersion);\n\t});\n\n\tit(\"无上一有效版（坏版是首个生效版且无前版）→ 不回退，通知如实说明\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 种资源但不走 snapshot（effective_version 为 NULL 起步）；\n\t\t// 手动插一条 effective 凭据到坏版，模拟「首个激活版本即坏版」。\n\t\tconst skillDir = join(home, \"pao配置\", \"skills\", \"lonely-skill\");\n\t\tmkdirSync(skillDir, { recursive: true });\n\t\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tregisterResource(store, { kind: \"skill\", name: \"lonely-skill\", paoHome: home });\n\t\tconst resourceId = \"skill:lonely-skill\";\n\n\t\t// 直接设 effective_version + 一条 effective 凭据（不走快照，模拟无前版场景）。\n\t\tconst badVersion = \"v-firstbad0123\";\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\tconst badDir = join(evolutionPaths(home).versions, dirSafe, badVersion);\n\t\tmkdirSync(badDir, { recursive: true });\n\t\twriteFileSync(join(badDir, \"SKILL.md\"), \"# lonely\\n\", \"utf8\");\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(badVersion, AT2, resourceId);\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-first\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbadVersion,\n\t\t\t\t\"首次生效\",\n\t\t\t\tJSON.stringify({ activation: \"effective\", candidateId: \"cand-x\" }),\n\t\t\t\tAT2,\n\t\t\t);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tuserReported: true,\n\t\t\tfailureDescription: \"首个版本就退步\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.notification).toBeDefined();\n\t\texpect(result.notification!.reason).toContain(\"找不到上一有效版\");\n\t\texpect(result.notification!.currentVersion).toBe(badVersion);\n\t\t// 指向未改。\n\t\texpect(readEffective(store, resourceId)).toBe(badVersion);\n\t});\n\n\tit(\"judge 为 false → 直接返回 rolledBack=false 不动指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId,\n\t\t\tfailureDescription: \"无关失败\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.rolledBack).toBe(false);\n\t\texpect(result.affectedTasks).toEqual([]);\n\t\texpect(result.notification).toBeUndefined();\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"资源未登记 → invalid_input\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst result = handleRegression(store, {\n\t\t\tresourceId: \"skill:missing\",\n\t\t\tfailureDescription: \"x\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.code).toBe(\"invalid_input\");\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`val-${over.candidateId}`, \"tp-1\",over.candidateId,over.problemId,over.resourceId,over.baseVersion,\"[]\",\"passed\",AT,,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find((a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, {candidateId: \"cand-b\",problemId: probB,resourceId: b.resourceId,baseVersion: b.baseVersion});\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\treturn row.effective_version;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":159}},{"diffOp":{"equal":{"range":[73,129]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[133,159]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[160,167]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[167,184]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[184,199]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[199,215]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[215,232]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[232,237]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[237,246]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[246,249]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[246,248]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[253,351]}}},{"equalLines":{"line_count":94}},{"diffOp":{"equal":{"range":[351,447]}}},{"diffOp":{"delete":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[447,519]}}},{"diffOp":{"delete":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[519,616]}}},{"equalLines":{"line_count":58}},{"diffOp":{"equal":{"range":[616,831]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[831,853]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[853,870]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[870,895]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[129,133]}}},{"diffOp":{"equal":{"range":[895,921]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[249,253]}}},{"diffOp":{"equal":{"range":[921,1116]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[1116,1149]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-restart.test.ts"},"span":null,"sourceCode":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\n * 覆盖：\n * - 正常态：effective_version 指向目录完整 → dirOk=true，无 needsAttention；\n * - 发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单（不自动激活）；\n * - 生效指向目录缺失 → needsAttention(effective_dir_missing)，保留旧指向不主动改；\n * - 绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)，不改绑定；\n * - 生效指向完整但无 effective 凭据 → needsAttention(version_without_credential)；\n * - 多资源混合场景。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-restart.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-rec-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`val-${over.candidateId}`, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { problemId: `prob-${name}`, resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, {\n\t\tcandidateId: `cand-${name}`,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# patched cand-${name}\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId, skillDir };\n}\n\n// ── recoverEvolutionState ────────────────────────────────────────────────\n\ndescribe(\"recoverEvolutionState\", () => {\n\tit(\"正常态：指向目录完整 → dirOk=true 无 needsAttention\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(1);\n\t\texpect(result.resources[0]!.resourceId).toBe(resourceId);\n\t\texpect(result.resources[0]!.effectiveVersion).toBe(newVersionId);\n\t\texpect(result.resources[0]!.dirOk).toBe(true);\n\t\texpect(result.resources[0]!.pendingPublish).toEqual([]);\n\t\texpect(result.resources[0]!.staleBindings).toEqual([]);\n\t\texpect(result.unfinishedActivations).toEqual([]);\n\t\texpect(result.needsAttention).toEqual([]);\n\t});\n\n\tit(\"发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 只 publish 不 activate → 发布中断状态。\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candidateId);\n\t\texpect(result.unfinishedActivations[0]!.versionId).toBe(pub.versionId);\n\t\texpect(result.unfinishedActivations[0]!.dirComplete).toBe(true);\n\n\t\t// 该资源视图也含 pendingPublish。\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.pendingPublish.length).toBe(1);\n\t\texpect(view!.pendingPublish[0]!.candidateId).toBe(candidateId);\n\t});\n\n\tit(\"生效指向目录缺失 → needsAttention(effective_dir_missing) 保留指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\t// 删版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(false);\n\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find(\n\t\t\t(a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\",\n\t\t);\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\n\n\t\t// 指向未被改动。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(row.effective_version).toBe(newVersionId);\n\t});\n\n\tit(\"绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\t// 删绑定的版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.staleBindings.length).toBe(1);\n\t\texpect(view!.staleBindings[0]!.taskId).toBe(\"task-1\");\n\t\texpect(view!.staleBindings[0]!.versionId).toBe(newVersionId);\n\t\texpect(view!.staleBindings[0]!.reason).toContain(\"不存在\");\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"stale_binding\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"task-1\");\n\t});\n\n\tit(\"生效指向目录完整但无 effective 凭据 → version_without_credential\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\t// baseVersion 是快照版：目录完整但无 activation 凭据；\n\t\t// effective_version 指它 → 触发「指向完整但无 effective 凭据」异常。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(true);\n\t\texpect(view!.missingCredential).toBe(true);\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"version_without_credential\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"无 activation='effective' 凭据\");\n\t});\n\n\tit(\"多资源混合：一正常 + 一发布中断 + 一生效目录缺失\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, { candidateId: \"cand-b\", problemId: probB, resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\n\t\t// 生效目录缺失资源（先激活再删目录）。\n\t\tconst c = await seedActivated(home, store, \"skill-c\");\n\t\tconst dirSafeC = c.resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafeC, c.newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(3);\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candB.candidateId);\n\t\tconst missing = result.needsAttention.filter((a) => a.kind === \"effective_dir_missing\");\n\t\texpect(missing.length).toBe(1);\n\t\texpect(missing[0]!.resourceId).toBe(c.resourceId);\n\t});\n});\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStoreactivateCandidate } from \"../../src/pao/memoryevolutionstore.tsactivation.ts\";evolutionPathsbindTaskResourcespaths.tsbinding.tsregisterResource, snapshotResourceFilesrecoverEvolutionState } from \"../../src/pao/evolution/resources.tsrecovery.tspublishCandidatesnapshotResourceFiles } from \"../../src/pao/evolution/versions.tstype MemoryStore,openMemoryStore \nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\treturn row.effective_version;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[73,198]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[208,241]}}},{"diffOp":{"insert":{"range":[241,258]}}},{"diffOp":{"equal":{"range":[258,281]}}},{"diffOp":{"delete":{"range":[281,287]}}},{"diffOp":{"insert":{"range":[287,296]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[296,304]}}},{"diffOp":{"insert":{"range":[304,317]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[319,333]}}},{"diffOp":{"insert":{"range":[333,350]}}},{"diffOp":{"equal":{"range":[258,281]}}},{"diffOp":{"delete":{"range":[281,287]}}},{"diffOp":{"insert":{"range":[319,328]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[350,358]}}},{"diffOp":{"insert":{"range":[358,368]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[368,407]}}},{"diffOp":{"insert":{"range":[407,428]}}},{"diffOp":{"equal":{"range":[428,461]}}},{"diffOp":{"delete":{"range":[461,473]}}},{"diffOp":{"insert":{"range":[473,484]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[484,500]}}},{"diffOp":{"insert":{"range":[368,385]}}},{"diffOp":{"equal":{"range":[428,429]}}},{"diffOp":{"insert":{"range":[500,522]}}},{"diffOp":{"equal":{"range":[522,554]}}},{"diffOp":{"delete":{"range":[554,565]}}},{"diffOp":{"insert":{"range":[461,473]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[241,258]}}},{"diffOp":{"insert":{"range":[484,500]}}},{"diffOp":{"equal":{"range":[428,461]}}},{"diffOp":{"delete":{"range":[304,317]}}},{"diffOp":{"insert":{"range":[554,565]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[333,350]}}},{"diffOp":{"insert":{"range":[319,333]}}},{"diffOp":{"equal":{"range":[428,451]}}},{"diffOp":{"delete":{"range":[319,328]}}},{"diffOp":{"insert":{"range":[281,287]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[358,368]}}},{"diffOp":{"insert":{"range":[350,358]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[198,208]}}},{"diffOp":{"delete":{"range":[407,428]}}},{"diffOp":{"insert":{"range":[565,582]}}},{"diffOp":{"equal":{"range":[428,429]}}},{"diffOp":{"insert":{"range":[582,598]}}},{"diffOp":{"equal":{"range":[522,544]}}},{"diffOp":{"delete":{"range":[319,328]}}},{"diffOp":{"insert":{"range":[281,287]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[473,484]}}},{"diffOp":{"insert":{"range":[296,304]}}},{"diffOp":{"equal":{"range":[317,319]}}},{"diffOp":{"equal":{"range":[598,671]}}},{"equalLines":{"line_count":326}},{"diffOp":{"equal":{"range":[671,704]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-restart.test.ts"},"span":[766,838],"sourceCode":"/**\n * S9-11 定向测试：重启恢复（recoverEvolutionState）。\n *\n * 覆盖：\n * - 正常态：effective_version 指向目录完整 → dirOk=true，无 needsAttention；\n * - 发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单（不自动激活）；\n * - 生效指向目录缺失 → needsAttention(effective_dir_missing)，保留旧指向不主动改；\n * - 绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)，不改绑定；\n * - 生效指向完整但无 effective 凭据 → needsAttention(version_without_credential)；\n * - 多资源混合场景。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-restart.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport { bindTaskResources } from \"../../src/pao/evolution/binding.ts\";\nimport { recoverEvolutionState } from \"../../src/pao/evolution/recovery.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-rec-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（activation 核对四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(`val-${over.candidateId}`, \"tp-1\", over.candidateId, over.problemId, over.resourceId, over.baseVersion, \"[]\", \"passed\", AT, AT);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { problemId: `prob-${name}`, resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, {\n\t\tcandidateId: `cand-${name}`,\n\t\tproblemId,\n\t\tresourceId,\n\t\tbaseVersion,\n\t\tfiles: { \"SKILL.md\": `# patched cand-${name}\\n` },\n\t});\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, candidateId, skillDir };\n}\n\n// ── recoverEvolutionState ────────────────────────────────────────────────\n\ndescribe(\"recoverEvolutionState\", () => {\n\tit(\"正常态：指向目录完整 → dirOk=true 无 needsAttention\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(1);\n\t\texpect(result.resources[0]!.resourceId).toBe(resourceId);\n\t\texpect(result.resources[0]!.effectiveVersion).toBe(newVersionId);\n\t\texpect(result.resources[0]!.dirOk).toBe(true);\n\t\texpect(result.resources[0]!.pendingPublish).toEqual([]);\n\t\texpect(result.resources[0]!.staleBindings).toEqual([]);\n\t\texpect(result.unfinishedActivations).toEqual([]);\n\t\texpect(result.needsAttention).toEqual([]);\n\t});\n\n\tit(\"发布中断：publish-落盘凭据在、effective 凭据不在 → 待激活清单\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\t\t// 只 publish 不 activate → 发布中断状态。\n\t\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candidateId);\n\t\texpect(result.unfinishedActivations[0]!.versionId).toBe(pub.versionId);\n\t\texpect(result.unfinishedActivations[0]!.dirComplete).toBe(true);\n\n\t\t// 该资源视图也含 pendingPublish。\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.pendingPublish.length).toBe(1);\n\t\texpect(view!.pendingPublish[0]!.candidateId).toBe(candidateId);\n\t});\n\n\tit(\"生效指向目录缺失 → needsAttention(effective_dir_missing) 保留指向\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\t// 删版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(false);\n\t\texpect(view!.effectiveVersion).toBe(newVersionId);\n\n\t\tconst attn = result.needsAttention.find(\n\t\t\t(a) => a.resourceId === resourceId && a.kind === \"effective_dir_missing\",\n\t\t);\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"保留旧指向不主动改\");\n\n\t\t// 指向未被改动。\n\t\tconst row = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string };\n\t\texpect(row.effective_version).toBe(newVersionId);\n\t});\n\n\tit(\"绑定指向目录缺失 → staleBindings + needsAttention(stale_binding)\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\t\tbindTaskResources(store, { taskId: \"task-1\", resourceIds: [resourceId] });\n\n\t\t// 删绑定的版本目录。\n\t\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafe, newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.staleBindings.length).toBe(1);\n\t\texpect(view!.staleBindings[0]!.taskId).toBe(\"task-1\");\n\t\texpect(view!.staleBindings[0]!.versionId).toBe(newVersionId);\n\t\texpect(view!.staleBindings[0]!.reason).toContain(\"不存在\");\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"stale_binding\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"task-1\");\n\t});\n\n\tit(\"生效指向目录完整但无 effective 凭据 → version_without_credential\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\t// baseVersion 是快照版：目录完整但无 activation 凭据；\n\t\t// effective_version 指它 → 触发「指向完整但无 effective 凭据」异常。\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\tconst view = result.resources.find((r) => r.resourceId === resourceId);\n\t\texpect(view!.dirOk).toBe(true);\n\t\texpect(view!.missingCredential).toBe(true);\n\n\t\tconst attn = result.needsAttention.find((a) => a.kind === \"version_without_credential\");\n\t\texpect(attn).toBeDefined();\n\t\texpect(attn!.detail).toContain(\"无 activation='effective' 凭据\");\n\t});\n\n\tit(\"多资源混合：一正常 + 一发布中断 + 一生效目录缺失\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\t// 正常资源。\n\t\tconst a = await seedActivated(home, store, \"skill-a\");\n\t\t// 发布中断资源。\n\t\tconst b = seedSkill(home, store, \"skill-b\");\n\t\tconst probB = seedProblem(store, { problemId: \"prob-b\", resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst candB = await legalPassedChain(store, home, { candidateId: \"cand-b\", problemId: probB, resourceId: b.resourceId, baseVersion: b.baseVersion });\n\t\tconst pubB = await publishCandidate(store, { candidateId: candB.candidateId, paoHome: home, createdAt: AT2 });\n\t\tif (!pubB.ok || !(\"versionId\" in pubB)) throw new Error(\"publish b failed\");\n\t\t// 生效目录缺失资源（先激活再删目录）。\n\t\tconst c = await seedActivated(home, store, \"skill-c\");\n\t\tconst dirSafeC = c.resourceId.replace(/:/g, \"_\");\n\t\trmSync(join(evolutionPaths(home).versions, dirSafeC, c.newVersionId), { recursive: true, force: true });\n\n\t\tconst result = recoverEvolutionState(store, { paoHome: home });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.resources.length).toBe(3);\n\t\texpect(result.unfinishedActivations.length).toBe(1);\n\t\texpect(result.unfinishedActivations[0]!.candidateId).toBe(candB.candidateId);\n\t\tconst missing = result.needsAttention.filter((a) => a.kind === \"effective_dir_missing\");\n\t\texpect(missing.length).toBe(1);\n\t\texpect(missing[0]!.resourceId).toBe(c.resourceId);\n\t});\n});\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *import { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStoreproposeCandidate } from \"../../src/pao/memoryevolutionstore.tscandidates.ts\";budgetLedgerPathgetResource, readBudgetLedgerregisterResource, snapshotResourceFilesusagebudget-ledger.tsresources.ts\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";freezeValidationPlan } from \"../../src/pao/evolution/validation.tsevolutionPathspaths.tstype { TierConfigroutingconfig.tsbudgetLedgerPath, readBudgetLedger\n\nconst tempDirs: string[] = [];\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":16}},{"diffOp":{"equal":{"range":[70,201]}}},{"diffOp":{"equal":{"range":[201,211]}}},{"diffOp":{"delete":{"range":[211,226]}}},{"diffOp":{"insert":{"range":[226,242]}}},{"diffOp":{"equal":{"range":[242,265]}}},{"diffOp":{"delete":{"range":[265,271]}}},{"diffOp":{"insert":{"range":[271,280]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[280,288]}}},{"diffOp":{"insert":{"range":[288,301]}}},{"diffOp":{"equal":{"range":[301,303]}}},{"diffOp":{"equal":{"range":[201,211]}}},{"diffOp":{"delete":{"range":[303,319]}}},{"diffOp":{"insert":{"range":[319,330]}}},{"diffOp":{"equal":{"range":[330,332]}}},{"diffOp":{"delete":{"range":[332,348]}}},{"diffOp":{"insert":{"range":[348,387]}}},{"diffOp":{"equal":{"range":[242,265]}}},{"diffOp":{"delete":{"range":[387,392]}}},{"diffOp":{"insert":{"range":[271,280]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[392,408]}}},{"diffOp":{"insert":{"range":[408,420]}}},{"diffOp":{"equal":{"range":[30