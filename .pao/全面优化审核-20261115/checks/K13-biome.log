rboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-evaluate.test.ts"},"span":null,"sourceCode":"/**\n * S8-10/11 定向测试：逐项评估决策与来源/旧候选处理、观察骨架。\n *\n * 覆盖：\n * - evaluateCandidate：原问题改善且关键正常/保留样例通过才 passed；\n *   总体得分提高不能掩盖关键用法退步；\n *   环境失败记 incomplete 不画成业务失败或通过；\n *   开发样例通过不直接标 passed；\n *   候选定稿后才跑保留样例（holdout 结果参与判定）；\n *   baseline 未复现原问题不宣称改善；\n *   模型随机性补做成对运行后仍不稳定不宣称改善；\n *   evolution_validations 行 + evolution_source_links 写入；\n *   候选状态推进 proposed→testing→passed|failed|cancelled。\n * - cleanupSourceReferences：来源删除沿关联清理候选输入/回执；\n *   未完成保持未完成状态。\n * - markStaleCandidates：基础版本变动标待重评估；旧候选不重新排发布。\n * - recordEvolutionObservation/countEvolutionObservations：三态计数骨架。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-evaluate.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { registerSource } from \"../../src/pao/memory/sources.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { evaluateCandidate } from \"../../src/pao/evolution/evaluate.ts\";\nimport {\n\tcleanupSourceReferences,\n\tcountEvolutionObservations,\n\tmarkStaleCandidates,\n\trecordEvolutionObservation,\n} from \"../../src/pao/evolution/observe.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { ValidationCaseResult } from \"../../src/pao/evolution/types.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-eval-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(() => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\ttry {\n\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t} catch {\n\t\t\t// 残留不阻塞\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nfunction seedSource(store: MemoryStore, sessionId: string, entryId: string, eventType = \"toolResult\"): string {\n\treturn registerSource(store.db, { sessionId, entryId, eventType, capturedAt: AT });\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, store: MemoryStore, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类 problem。 */\nfunction seedProblem(store: MemoryStore, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\n/** 造一个 proposed 状态的候选。 */\nfunction seedCandidate(store: MemoryStore, over: {\n\tcandidateId?: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n\tstatus?: string;\n\tusageRefs?: string[];\n}) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\tover.testPlanId,\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\" }]),\n\t\t\t\"修正步骤一\",\n\t\t\tJSON.stringify(over.usageRefs ?? []),\n\t\t\tover.status ?? \"proposed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn candidateId;\n}\n\n/** 组装逐项结果。 */\nfunction makeCaseResult(over: Partial<ValidationCaseResult> & { caseId: string }): ValidationCaseResult {\n\treturn {\n\t\tcaseId: over.caseId,\n\t\tbaseline: over.baseline ?? { passed: false },\n\t\tcandidate: over.candidate ?? { passed: true },\n\t\tverdict: over.verdict ?? \"passed\",\n\t\t...(over.reason === undefined ? {} : { reason: over.reason }),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// evaluateCandidate\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"evaluateCandidate\", () => {\n\tit(\"原问题改善且关键正常/保留样例全部通过 → passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"holdout-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\ttotalUsageRef: \"req-eval-1\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"passed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.passed).toBe(1);\n\t\texpect(result.score.holdout.passed).toBe(1);\n\t\texpect(result.score.total.passed).toBe(3);\n\n\t\t// 候选状态推进到 passed\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\n\t\t// evolution_validations 行已写入\n\t\tconst valRow = store.db.prepare(`SELECT verdict, case_results_json FROM evolution_validations WHERE candidate_id = ?`).get(candidateId) as { verdict: string; case_results_json: string };\n\t\texpect(valRow.verdict).toBe(\"passed\");\n\t\tconst cases = JSON.parse(valRow.case_results_json) as ValidationCaseResult[];\n\t\texpect(cases).toHaveLength(3);\n\t\texpect(cases[0].verdict).toBe(\"passed\");\n\n\t\t// 费用归因追加到候选\n\t\tconst candRow = store.db.prepare(`SELECT usage_refs_json FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { usage_refs_json: string };\n\t\tconst refs = JSON.parse(candRow.usage_refs_json) as string[];\n\t\texpect(refs).toContain(\"req-eval-1\");\n\n\t\tstore.close();\n\t});\n\n\tit(\"总体得分提高不能掩盖关键用法退步 → failed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 修复但 normal 被破坏——即使总分 1/2 也标 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: false }, verdict: \"failed\", reason: \"正常用法被破坏\" }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\texpect(result.score.reproduction.passed).toBe(1);\n\t\texpect(result.score.normal.failed).toBe(1);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"failed\");\n\t\texpect(row.failure_reason).toContain(\"验证失败\");\n\t\tstore.close();\n\t});\n\n\tit(\"环境失败记 incomplete 不画成业务失败或通过\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 启动失败/进程停止未确认 → incomplete（O11/E07：凭 executionFailure 字段判环境失败）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, executionFailure: \"start\", failureReason: \"进程停止未确认\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"环境异常，无法判定业务结果\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\tstore.close();\n\t});\n\n\tit(\"baseline 未复现原问题 → incomplete 而非宣称改善\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline 也 passed——复现不了原问题，验证前提不成立\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"baseline 未复现原问题\");\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 未通过 → failed（即使 candidate 有改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// reproduction 失败 → 原问题未修复，即使 normal 通过也 failed\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"failed\", reason: \"原问题未修复\" }),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"failed\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型随机性补做成对运行后仍不稳定 → 不宣称改善（保持 incomplete）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 补做后仍 incomplete（前后矛盾未解决）\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false },\n\t\t\t\t\tcandidate: { passed: false, failureReason: \"前后结论矛盾，补做后仍不稳定\" },\n\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\treason: \"补做成对运行后仍不稳定\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\trepairedContradictions: true,\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tstore.close();\n\t});\n\n\tit(\"evolution_source_links 以 owner_kind=validation 写入\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tsourceRefs: [{ sourceId }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(`SELECT * FROM evolution_source_links WHERE owner_kind = 'validation' AND owner_id = ?`)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\tstore.close();\n\t});\n\n\tit(\"候选状态机推进 proposed→testing→passed\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 初始状态 proposed\n\t\tlet row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\");\n\n\t\tevaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\n\t\trow = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"passed\");\n\t\tstore.close();\n\t});\n\n\tit(\"testPlanId 不匹配拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: \"tp-wrong\",\n\t\t\tcaseResults: [],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"testPlanId\");\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：freezeValidationPlan 不传 sourceRefs 时自动继承 problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-inherit\", \"e-inherit\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 级登记一条来源关联（带 memory 修订定位）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-inherit\", problemId, sourceId, \"mem-9\", 3, AT);\n\n\t\t// 不传 sourceRefs → 内核自动读 problem links。\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id, memory_id, revision FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(plan.testPlanId) as Array<{ source_id: string; memory_id: string | null; revision: number | null }>;\n\t\texpect(links).toHaveLength(1);\n\t\texpect(links[0].source_id).toBe(sourceId);\n\t\texpect(links[0].memory_id).toBe(\"mem-9\");\n\t\texpect(links[0].revision).toBe(3);\n\t\tstore.close();\n\t});\n\n\tit(\"O12/E11：evaluateCandidate 不传 sourceRefs 时自动继承 candidate→problem links\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s-eval\", \"e-eval\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\t// problem 与 candidate 两级各有来源关联：优先继承 candidate 自身 links。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'problem', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-prob-eval\", problemId, \"evidence:prob-src\", AT);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\"link-cand-eval\", candidateId, sourceId, AT);\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\n\t\tconst links = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'validation' AND owner_id = ?`,\n\t\t\t)\n\t\t\t.all(result.validationId) as Array<{ source_id: string }>;\n\t\t// 继承 candidate 自身 links（非 problem）。\n\t\texpect(links.map((l) => l.source_id)).toEqual([sourceId]);\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：plan 内缺 holdout 回执 → incomplete（不宣称改善）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [{ input: \"保留\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 只交 reproduction 回执，holdout-0 漏跑 → 完整集合不齐 → incomplete。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\n\t\texpect(row.failure_reason).toContain(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：未知 caseId 不在冻结计划内 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"unknown-9\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"未知 caseId:unknown-9\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06：重复 caseId 回执 → incomplete\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t\tmakeCaseResult({ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: true } }),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"重复 caseId:reproduction-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E06+E07：baseline 侧 executionFailure 算环境失败 → incomplete（不算 baseline 复现）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// baseline timeout（环境失败）+ candidate passed → 不能据此宣称修复。\n\t\tconst result = evaluateCandidate(store, {\n\t\t\tcandidateId,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({\n\t\t\t\t\tcaseId: \"reproduction-0\",\n\t\t\t\t\tbaseline: { passed: false, executionFailure: \"timeout\", failureReason: \"超时\" },\n\t\t\t\t\tcandidate: { passed: true },\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\t\texpect(result.caseResults[0].reason).toContain(\"环境/启动失败\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// cleanupSourceReferences\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"cleanupSourceReferences\", () => {\n\tit(\"来源删除沿关联清理：problem evidenceRefs 缩减，候选取消，link 保留定位\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst sourceId2 = seedSource(store, \"s2\", \"e2\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 登记 source links\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'problem', ?, ?, ?)`)\n\t\t\t.run(\"link-p-1\", problemId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'candidate', ?, ?, ?)`)\n\t\t\t.run(\"link-c-1\", candidateId, sourceId, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", plan.testPlanId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.problemsCleaned).toBeGreaterThanOrEqual(0);\n\t\texpect(result.candidatesCleaned).toBe(1);\n\t\texpect(result.validationsCleaned).toBe(1);\n\n\t\t// 候选被标 cancelled\n\t\tconst candRow = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(candRow.status).toBe(\"cancelled\");\n\t\texpect(candRow.failure_reason).toContain(\"已删除\");\n\t\tstore.close();\n\t});\n\n\tit(\"清理未完成保持未完成状态\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst sourceId = seedSource(store, \"s1\", \"e1\");\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造候选（外键要求 candidate_id 已存在）\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\t\t// 造一个 incomplete 验证\n\t\tconst validationId = \"val-incomplete-1\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(validationId, plan.testPlanId, candidateId, problemId, resourceId, baseVersion,\n\t\t\t\tJSON.stringify([{ caseId: \"reproduction-0\", baseline: { passed: false }, candidate: { passed: false }, verdict: \"incomplete\" }]),\n\t\t\t\t\"incomplete\", AT, AT);\n\t\tstore.db.prepare(`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", validationId, sourceId, AT);\n\n\t\tconst result = cleanupSourceReferences(store, { sourceId, createdAt: AT2 });\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.pendingObjects).toHaveLength(1);\n\t\texpect(result.pendingObjects[0].id).toBe(validationId);\n\t\texpect(result.pendingObjects[0].reason).toContain(\"incomplete\");\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// markStaleCandidates\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"markStaleCandidates\", () => {\n\tit(\"基础版本变动标待重评估；旧候选不得重新排发布\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\t// 新基础版本 → 旧候选标待重评估\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: \"v-new-abc\",\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(1);\n\t\texpect(result.staleCandidateIds).toContain(candidateId);\n\n\t\tconst row = store.db.prepare(`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"待重评估\");\n\t\texpect(row.failure_reason).toContain(\"不得直接重新排发布\");\n\t\tstore.close();\n\t});\n\n\tit(\"同 baseVersion 的候选不受影响\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion } = seedSkill(home, store);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId, resourceId, baseVersion, paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\t\tconst candidateId = seedCandidate(store, { problemId, resourceId, baseVersion, testPlanId: plan.testPlanId });\n\n\t\tconst result = markStaleCandidates(store, {\n\t\t\tresourceId,\n\t\t\tcurrentBaseVersion: baseVersion, // 同版本\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.staleCount).toBe(0);\n\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\"); // 未变\n\t\tstore.close();\n\t});\n});\n\n// ════════════════════════════════════════════════════════════════════════\n// 观察骨架：recordEvolutionObservation / countEvolutionObservations\n// ════════════════════════════════════════════════════════════════════════\n\ndescribe(\"观察骨架\", () => {\n\tit(\"viewed/used/patched 三态计数入口（落库后可读回）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\t// 记录观察（evolution_observations 表由 SCHEMA_SQL 建，真实落库）\n\t\tconst viewed = recordEvolutionObservation(store, {\n\t\t\taction: \"viewed\",\n\t\t\tresourceId,\n\t\t\tcandidateId: \"cand-1\",\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(viewed.ok).toBe(true);\n\t\tif (!viewed.ok) return;\n\n\t\t// 计数：落库后可读回三态计数\n\t\tconst counts = countEvolutionObservations(store, { resourceId });\n\t\texpect(counts.ok).toBe(true);\n\t\tif (!counts.ok) return;\n\t\texpect(counts.persisted).toBe(true);\n\t\texpect(counts.counts.viewed).toBe(1);\n\t\texpect(counts.counts.used).toBe(0);\n\t\texpect(counts.counts.patched).toBe(0);\n\t\texpect(counts.total).toBe(1);\n\t\tstore.close();\n\t});\n\n\tit(\"未知观察动作返回业务错误\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store);\n\n\t\tconst bad = recordEvolutionObservation(store, {\n\t\t\taction: \"deleted\" as never,\n\t\t\tresourceId,\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(bad.ok).toBe(false);\n\t\tif (bad.ok) return;\n\t\texpect(bad.error.code).toBe(\"invalid_input\");\n\t\tstore.close();\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * O10 定向测试：单次进化作业入口 / 真实身份幂等 / 选择顺序 / 基础正文与停止条件。\n *import type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { ExtensionAPI, ExtensionContext } from \"../../src/core/extensions/types.ts\";\nimport {\n\tenqueueEvolveJob,\n\tregisterMaintenanceScheduler,\n\ttype MaintenanceSchedulerDeps,\nproposeCandidate } from \"../../src/pao/memoryevolutionmaintenance.tscandidates.ts\";\nimport { openMemoryStoreclassifyProblem, type MemoryStoredeclareImprovementIntent } from \"../../src/pao/store.tsproblems.ts{registerResource, setAutoEvolution,MemoryScopesnapshotResourceFilestypes.tsresources.tsresolveMemoryScopeselectImprovementproject-identity.tsselect.ts{ TierConfigfreezeValidationPlanroutingconfig.tsvalidation.ts\nimport { drainFrictionDraftWrites, recordFrictionDraft } from \"../../src/pao/friction/drafts.ts\";\n\tenqueueEvolveJob,\n\ttype setAutoEvolution\n\tregisterMaintenanceScheduler snapshotResourceFiles classifyProblem,declareImprovementIntent type MemoryStore,openMemoryStore \nimport { getEvolveMaintenanceHandlersForTest } from \"./fixtures/evolve-handler.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,122]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[122,309]}}},{"diffOp":{"equal":{"range":[309,318]}}},{"diffOp":{"delete":{"range":[318,374]}}},{"diffOp":{"equal":{"range":[374,375]}}},{"diffOp":{"delete":{"range":[375,401]}}},{"diffOp":{"insert":{"range":[401,418]}}},{"diffOp":{"equal":{"range":[418,440]}}},{"diffOp":{"delete":{"range":[440,446]}}},{"diffOp":{"insert":{"range":[446,455]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[455,469]}}},{"diffOp":{"insert":{"range":[469,482]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[484,494]}}},{"diffOp":{"delete":{"range":[494,509]}}},{"diffOp":{"insert":{"range":[509,524]}}},{"diffOp":{"equal":{"range":[524,526]}}},{"diffOp":{"delete":{"range":[526,542]}}},{"diffOp":{"insert":{"range":[542,566]}}},{"diffOp":{"equal":{"range":[566,589]}}},{"diffOp":{"delete":{"range":[440,446]}}},{"diffOp":{"insert":{"range":[446,455]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[589,597]}}},{"diffOp":{"insert":{"range":[597,608]}}},{"diffOp":{"equal":{"range":[482,484]}}},{"diffOp":{"equal":{"range":[484,492]}}},{"diffOp":{"delete":{"range":[526,530]}}},{"diffOp":{"insert":{"range":[608,609]}}},{"diffOp":{"equal":{"range":[566,567]}}},{"diffOp":{"de