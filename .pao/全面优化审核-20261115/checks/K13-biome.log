:{"insert":{"range":[392,408]}}},{"diffOp":{"equal":{"range":[301,303]}}},{"diffOp":{"equal":{"range":[642,674]}}},{"equalLines":{"line_count":753}},{"diffOp":{"equal":{"range":[674,683]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-validation.test.ts"},"span":[760,832],"sourceCode":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\n * 覆盖：\n * - 冻结计划三组样例且 testPlanId 绑定 baseVersion；\n * - 验收依据不入候选可写目录；\n * - 旧版须真失败否则回分类（reproduction 至少一条）；\n * - 候选只改批准资源（范围核对）；\n * - 无改进返回 no_change；\n * - 相同差异不重复验证；\n * - 保留组失败结束且不回灌（生成器读不到 holdout）；\n * - 模型调用沿账本记账；\n * - 范围越界候选被拒。\n *\n * 模型一律假（streamSimple 返回固定 JSON），不发起真实请求。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-validation.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type { Context } from \"@pao/ai\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { budgetLedgerPath, readBudgetLedger } from \"../../src/pao/usage/budget-ledger.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { proposeCandidate } from \"../../src/pao/evolution/candidates.ts\";\nimport { getResource } from \"../../src/pao/evolution/resources.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-val-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有毫秒级释放延迟；\n\t// 重试几次避开 EPERM，不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nconst TIER: TierConfig = {\n\tprovider: \"pao\",\n\t档位: [{ 名: \"快\", provider: \"test\", model: \"m\", thinkingLevel: \"off\" }],\n} as TierConfig;\n\n/** 外发许可（测试注入）：proposeCandidate 的外发门要求编排显式传项目名与许可。 */\nconst OUTBOUND_PROJECTS = [\"proj-x\"] as const;\nconst OUTBOUND = { projects: { \"proj-x\": { allowed: true, asOf: \"2099-12-31\" } } };\n\nfunction fakeRegistry(reply: string, onRequest?: (context: Context) => void) {\n\treturn {\n\t\tfind: (_provider: string, _modelId: string) => ({}) as never,\n\t\tstreamSimple: (_model: unknown, context: Context) => {\n\t\t\tonRequest?.(context);\n\t\t\treturn {\n\t\t\t\tresult: () =>\n\t\t\t\t\tPromise.resolve({\n\t\t\t\t\t\tprovider: \"test\",\n\t\t\t\t\t\tmodel: \"m\",\n\t\t\t\t\t\tresponseModel: \"m\",\n\t\t\t\t\t\tstopReason: \"stop\",\n\t\t\t\t\t\tusage: { totalTokens: 10, inputTokens: 5, outputTokens: 5 },\n\t\t\t\t\t\tcontent: [{ type: \"text\", text: reply }],\n\t\t\t\t\t}),\n\t\t\t} as never;\n\t\t},\n\t};\n}\n\nfunction fakeLedger() {\n\tconst calls: { custom: string[]; usage: { kind: string; note: string }[] } = { custom: [], usage: [] };\n\treturn {\n\t\tcalls,\n\t\tappendUsage: (kind: string, _p: string, _m: string, _u: unknown, note?: string) => {\n\t\t\tcalls.usage.push({ kind, note: note ?? \"\" });\n\t\t\treturn {} as never;\n\t\t},\n\t\tappendCustomEntry: (type: string, data?: unknown) => {\n\t\t\tcalls.custom.push(`${type}:${JSON.stringify(data)}`);\n\t\t\treturn {} as never;\n\t\t},\n\t};\n}\n\n/** 造一个已登记 skill 资源 + baseVersion 快照 + 预算配置。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), \"# code-review\\n步骤一\\n\", \"utf8\");\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\t// 预算配置：checkMemoryJobBudget 需要此文件存在才允许付费作业。\n\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\t// 总预算账：checkMemoryJobBudget 检查 reserveBudget 需要已授权的总预算。\n\twriteFileSync(join(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}));\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\n/** 造一个已分类的 problem。 */\nfunction seedProblem(store: ReturnType<typeof openMemoryStore>, over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tconst now = AT;\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\tover.status ?? \"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tnow,\n\t\t\tnow,\n\t\t);\n\treturn problemId;\n}\n\n// ── freezeValidationPlan ────────────────────────────────────────────────\n\ndescribe(\"freezeValidationPlan\", () => {\n\tit(\"冻结计划三组样例且 testPlanId 绑定 baseVersion\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t}],\n\t\t\tnormal: [{\n\t\t\t\tinput: \"正常输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 B\",\n\t\t\t}],\n\t\t\tholdout: [{\n\t\t\t\tinput: \"保留输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 C\",\n\t\t\t}],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.testPlanId).toContain(baseVersion);\n\t\texpect(result.plan.reproduction).toHaveLength(1);\n\t\texpect(result.plan.normal).toHaveLength(1);\n\t\texpect(result.plan.holdout).toHaveLength(1);\n\t\texpect(result.plan.reproduction[0].caseId).toBe(\"reproduction-0\");\n\t\texpect(result.plan.holdout[0].caseId).toBe(\"holdout-0\");\n\t\tstore.close();\n\t});\n\n\tit(\"验收依据存核心管理位置，不在候选可写目录\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\tacceptance: \"x\",\n\t\t\t}],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// plan.json 在 evolution/validations/ 下，不在 candidates/ 下。\n\t\texpect(result.planPath).toContain(\"validations\");\n\t\texpect(result.planPath).not.toContain(\"candidates\");\n\t\t// 文件实际存在。\n\t\tconst planOnDisk = JSON.parse(\n\t\t\trequire(\"node:fs\").readFileSync(result.planPath, \"utf8\"),\n\t\t);\n\t\texpect(planOnDisk.testPlanId).toBe(result.testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\n\t\tstore.close();\n\t});\n\n\tit(\"reproduction 组至少一条；空则拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"复现样例至少一条\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"resourceId 与 problem 登记不一致时拒绝\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, baseVersion } = seedSkill(home);\n\t\t// 登记另一资源供 problem 绑定（外键要求 resourceId 已登记）。\n\t\tregisterResource(store, { kind: \"skill\", name: \"other\", paoHome: home });\n\t\tconst problemId = seedProblem(store, { resourceId: \"skill:other\", baseVersion });\n\n\t\tconst result = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tstore.close();\n\t});\n});\n\n// ── proposeCandidate ────────────────────────────────────────────────────\n\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan(store: ReturnType<typeof openMemoryStore>, over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t}) {\n\t\treturn freezeValidationPlan(store, {\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\tpaoHome: tempHome(), // 用临时 home；实际测试时传同一 home\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t}\n\n\tit(\"模型返回空编辑列表 → no_change\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({ rationale: \"无需改动\", edits: [] });\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"no_change\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型返回编辑 → changed 且差异正确\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion, skillDir } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正步骤一\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n步骤一（已修正）\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"changed\");\n\t\tif (result.status !== \"changed\") return;\n\t\texpect(result.diffs).toHaveLength(1);\n\t\texpect(result.diffs[0].path).toBe(\"SKILL.md\");\n\t\texpect(result.diffs[0].kind).toBe(\"edit\");\n\t\t// 候选目录已创建且文件已改。\n\t\tconst candidateDir = join(evolutionPaths(home).candidates, \"skill_code-review\", result.candidateId);\n\t\tconst newContent = require(\"node:fs\").readFileSync(join(candidateDir, \"SKILL.md\"), \"utf8\");\n\t\texpect(newContent).toContain(\"已修正\");\n\t\t// 问题状态推进到 candidate。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as { status: string };\n\t\texpect(row.status).toBe(\"candidate\");\n\t\tstore.close();\n\t});\n\n\tit(\"相同差异不重复付费验证\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\t\tif (!first.ok || first.status !== \"changed\") return;\n\n\t\t// 第二次相同差异 → duplicate。\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\n\t\texpect(second.status).toBe(\"duplicate\");\n\t\tif (second.status !== \"duplicate\") return;\n\t\texpect(second.candidateId).toBe(first.candidateId);\n\t\tstore.close();\n\t});\n\n\tit(\"范围越界候选被拒（改资源根外文件）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"改核心\",\n\t\t\tedits: [{ path: \"src/pao/role.ts\", action: \"edit\", content: \"hack\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.status).toBe(\"rejected\");\n\t\tif (result.status !== \"rejected\") return;\n\t\texpect(result.reason).toContain(\"超出资源根\");\n\t\tstore.close();\n\t});\n\n\tit(\"模型调用沿账本记账（attempt + usage）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"修正\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n已修正\\n\" }],\n\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(ledger.calls.custom.some((c) => c.includes(\"pao-evolution-candidate-attempt\"))).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.kind === \"evolution_candidate\")).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.note.includes(`problemId=${problemId}`))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"保留组样例不喂给生成器（提示词不含 holdout）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [{ input: \"正常\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tholdout: [{ input: \"保留秘密\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst requests: Context[] = [];\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [] });\n\t\tawait proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply, (ctx) => requests.push(ctx)),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"开发样例\", failure: \"失败\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\n\t\texpect(prompt).toContain(\"开发样例\");\n\t\texpect(prompt).not.toContain(\"保留秘密\");\n\t\tstore.close();\n\t});\n\n\tit(\"problem 未分类时拒绝\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(\"{}\"),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"须为 classified\");\n\t\tstore.close();\n\t});\n\n\tit(\"每问题最多 3 候选\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\t// 先造 3 个候选。\n\t\tfor (let i = 0; i < 3; i++) {\n\t\t\tconst reply = JSON.stringify({\n\t\t\t\trationale: `修正 ${i}`,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n修正 ${i}\\n` }],\n\t\t\t});\n\t\t\tconst r = await proposeCandidate(store, {\n\t\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\tbudgetPaoHome: home,\n\t\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\t\toutbound: OUTBOUND,\n\t\t\t}, {\n\t\t\t\tproblemId,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\t\tcreatedAt: `2026-11-11T10:0${i}:00.000Z`,\n\t\t\t});\n\t\t\texpect(r.ok && r.status === \"changed\").toBe(true);\n\t\t}\n\n\t\t// 第 4 个应被拒。\n\t\tconst reply = JSON.stringify({\n\t\t\trationale: \"第 4 个\",\n\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: \"# code-review\\n第 4 个\\n\" }],\n\t\t});\n\t\tconst result = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(reply),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\n\t\texpect(result.error.message).toContain(\"已达候选上限\");\n\t\tstore.close();\n\t});\n\n\tit(\"O01：同 problemId 第二次生成 → 两条不同判据预留，首条已结算费用不被覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\tif (!plan.ok) throw new Error(\"freeze failed\");\n\n\t\tconst mkReply = (tag: string) =>\n\t\t\tJSON.stringify({\n\t\t\t\trationale: tag,\n\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n${tag}\\n` }],\n\t\t\t});\n\t\tconst first = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正一\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t});\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\n\t\tconst second = await proposeCandidate(store, {\n\t\t\tmodelRegistry: fakeRegistry(mkReply(\"修正二\")),\n\t\t\tledger: fakeLedger() as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t}, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT2,\n\t\t});\n\t\texpect(second.ok && second.status === \"changed\").toBe(true);\n\n\t\t// 账本：两次实际请求各一条独立判据（attemptKey=本次 requestId），不再互相复用/覆盖。\n\t\tconst file = readBudgetLedger(budgetLedgerPath(home));\n\t\tconst keys = file.reservations.map((r) => r.idempotencyKey);\n\t\tconst evo = file.reservations.filter((r) => r.idempotencyKey.startsWith(`memory-job:evo-${problemId}:candidate:`));\n\t\t// 假模型 usage 无 cost → settle 记 unknown；两条都各自留痕（首条不被第二条覆盖）。\n\t\texpect(evo).toHaveLength(2);\n\t\texpect(evo.every((r) => r.status === \"unknown\")).toBe(true);\n\t\texpect(new Set(keys).size).toBe(keys.length);\n\t\tstore.close();\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S8-06/07 定向测试：冻结验收与局部候选生成。\n *\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\t// 总预算账：checkMemoryJobBudget 检查 reserveBudget 需要已授权的总预算。\n\twriteFileSync(\n\t\tjoin(home, \"总预算账.json\"), JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\" }],\n\t\treservations: [],\n\t}),\n\t);\n\n\tconst store = openMemoryStore(home, \"readwrite\");\n/** 造一个已分类的 problem。 */\nfunction seedProblem(store: ReturnType<typeof openMemoryStore>,over: {\n\tproblemId?: string;\n\tresourceId?: string;\n\tbaseVersion?: string;\n\tstatus?: string;\n} = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tconst now = AT;\t\t\tbaseVersion,\n\t\t\tpaoHome: home,\n\t\t\treproduction: [\n\t\t\t\t{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t,\n\t\t\t],\n\t\t\tnormal: [input: \"正常输入\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tacceptance: \"输出 B\",\n\t\t\t],\n\t\t\tholdout: [input: \"保留输入\",\n\t\t\t\tacceptance: \"输出 C\",\n\t\t\t],\n\t\t\tcreatedAt: AT,\n\t\t});allowedTools: [],\n\t\t\t\tacceptance: \"x\",\n\t\t\t],\n\t\t\tnormal: [],\n\t\t\tholdout: [],\t\texpect(result.planPath).not.toContain(\"candidates\");\n\t\t// 文件实际存在。\n\t\tconst planOnDisk = JSON.parse(require(\"node:fs\").readFileSync(result.planPath, \"utf8\"));\n\t\texpect(planOnDisk.testPlanId).toBe(result.testPlanId);\n\t\texpect(planOnDisk.baseVersion).toBe(baseVersion);\ndescribe(\"proposeCandidate\", () => {\n\tfunction seedValidationPlan(over: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t) {\n\t\treturn freezeValidationPlan(store, {\n\t\t\tproblemId: over.problemId,\t\tconst reply = JSON.stringify({ rationale: \"无需改动\", edits: [] });\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(store,modelRegistry: fakeRegistry(reply),\n\t\t\tledger: ledger as never,\n\t\t\ttierConfig: TIER,\n\t\t\tpaoHome: home,\n\t\t\tbudgetPaoHome: home,\n\t\t\toutboundProjects: [...OUTBOUND_PROJECTS],\n\t\t\toutbound: OUTBOUND,\n\t\t},problemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tallowedFiles: [\"SKILL.md\"],\n\t\t\tdevCases: [{ input: \"x\", failure: \"y\" }],\n\t\t\tcreatedAt: AT,\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst result = await proposeCandidate(\t\texpect(newContent).toContain(\"已修正\");\n\t\t// 问题状态推进到 candidate。\n\t\tconst row = store.db.prepare(`SELECT status FROM evolution_problems WHERE problem_id = ?`).get(problemId) as {status: string;\n\t\t};\n\t\texpect(row.status).toBe(\"candidate\");\n\t\tstore.close();\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tconst first = await proposeCandidate();\n\t\texpect(first.ok && first.status === \"changed\").toBe(true);\n\t\tif (!first.ok || first.status !== \"changed\") return;\n\n\t\t// 第二次相同差异 → duplicate。\n\t\tconst second = await proposeCandidate(createdAt: AT2,\n\t\t);\n\t\texpect(second.ok).toBe(true);\n\t\tif (!second.ok) return;\t\t});\n\t\tconst ledger = fakeLedger();\n\t\tawait proposeCandidate();\n\t\texpect(ledger.calls.custom.some((c) => c.includes(\"pao-evolution-candidate-attempt\"))).toBe(true);\n\t\texpect(ledger.calls.usage.some((u) => u.kind === \"evolution_candidate\")).toBe(true);\t\tconst requests: Context[] = [];\n\t\tconst reply = JSON.stringify({ rationale: \"x\", edits: [] });\n\t\tawait proposeCandidate(modelRegistry: fakeRegistry(reply, (ctx) => requests.push(ctx)),\n\t\t\tledger: fakeLedger() as never,\n\t\t\tdevCases: [{ input: \"开发样例\", failure: \"失败\" }],\n\t\t\t);\n\t\texpect(requests).toHaveLength(1);\n\t\tconst prompt = requests[0]!.systemPrompt ?? \"\";\t\tconst problemId = seedProblem(store, { resourceId, baseVersion, status: \"observed\" });\n\n\t\tconst result = await proposeCandidate(modelRegistry: fakeRegistry(\"{}\"),\n\t\t\ttestPlanId: \"tp-x\",\n\t\t\tdevCases: [],\n\t\t\t);\n\t\texpect(result.ok).toBe(false);\n\t\tif (result.ok) return;\t\t\t\tedits: [{ path: \"SKILL.md\", action: \"edit\", content: `# code-review\\n修正 ${i}\\n` }],\n\t\t\t});\n\t\t\tconst r = await proposeCandidate(modelRegistry: fakeRegistry(reply),\n\t\t\t\tledger: fakeLedger() as never,\n\t\t\t\ttierConfig: TIER,\n\t\t\t\tpaoHome: home,\n\t\t\t\tbudgetPaoHome: home,\n\t\t\t\toutboundProjects: [...OUTBOU