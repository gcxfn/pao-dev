\t\tconst store = openMemoryStore(input.home, \"readonly\");\n\t\ttry {\n\t\t\tconst artifactRow = readArtifactRow(store, input.artifactId);\n\t\t\tconst versionRow = readVersionRowById(store, input.versionId);\n\t\t\tif (!artifactRow || !versionRow || versionRow.artifact_id !== input.artifactId) {\n\t\t\t\treturn {\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: `成果版本不属于该成果或不存在:${input.artifactId}/${input.versionId}`,\n\t\t\t\t\t\trefId: input.versionId,\n\t\t\t\t\t} satisfies MemoryError,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst artifact = mapArtifactRow(artifactRow);\n\t\t\tconst refs = readRefs(store, input.artifactId).filter((ref) => ref.version_id === versionRow.version_id);\n\t\t\tconst version = mapVersionItem(versionRow, refs);\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId: input.versionId });\n\t\t\tif (!resolved.ok) {\n\t\t\t\treturn resolved as MemoryResult<DesktopArtifactVersionResult>;\n\t\t\t}\n\t\t\tif (!resolved.available) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tartifact,\n\t\t\t\t\tversion,\n\t\t\t\t\tcontent: \"\",\n\t\t\t\t\tavailable: false,\n\t\t\t\t\tunavailableReason: resolved.reason,\n\t\t\t\t\thasMore: false,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst text = decodeArtifactContent(resolved.content);\n\t\t\tif (text === undefined) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tartifact,\n\t\t\t\t\tversion,\n\t\t\t\t\tcontent: \"\",\n\t\t\t\t\tavailable: false,\n\t\t\t\t\tunavailableReason: `版本内容不是可解码文本（${resolved.content.length} 字节），不提供预览`,\n\t\t\t\t\thasMore: false,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst content = text.slice(offset, offset + limit);\n\t\t\tconst hasMore = offset + limit < text.length;\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tartifact,\n\t\t\t\tversion,\n\t\t\t\tcontent,\n\t\t\t\tavailable: true,\n\t\t\t\thasMore,\n\t\t\t\t...(hasMore ? { nextOffset: offset + limit } : {}),\n\t\t\t};\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n}\n\n/** 文