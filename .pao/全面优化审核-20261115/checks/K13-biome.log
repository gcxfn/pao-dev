gth} 条${replaced > 0 ? \"（已刷新为当前修订）\" : removed ? \"（其余已纠正或失效）\" : \"\"}:`,\n\t\t\t\t\t...remaining.map((hit, index) => renderMemoryHit(hit, index, currentSessionId)),\n\t\t\t\t].join(\"\\n\");\n\t\t\t\treturn [\n\t\t\t\t\t{\n\t\t\t\t\t\t...recall.message,\n\t\t\t\t\t\tcontent: [{ type: \"text\" as const, text }],\n\t\t\t\t\t\tdetails: { ...messageDetails(recall.message), memories: remaining },\n\t\t\t\t\t},\n\t\t\t\t];\n\t\t\t}\n\t\t\t// 消息头按最终可见条数实计（remaining ≥ 最终条数，位数按上界估不低估）。\n\t\t\tconst headerSuffix = replaced > 0 ? \"（已刷新为当前修订）\" : removed ? \"（其余已纠正或失效）\" : \"\";\n\t\t\tconst headerChars = Array.from(\n\t\t\t\t`[pao 自动召回] 当前可见 ${remaining.length} 条${headerSuffix}。${AUTO_RECALL_RESULTS_BOUNDARY}`,\n\t\t\t).length;\n\t\t\t// J09/J10：automatic 块无论是否变化都过本轮剩余预算；装不下整项/整块省略，\n\t\t\t// 完整条件不截断，保留依据留在 details.hits 与 state.visibleHits。\n\t\t\tconst budgeted = budgetAutomaticRecallHits(\n\t\t\t\tremaining,\n\t\t\t\tcurrentSessionId,\n\t\t\t\tMath.max(0, remainingBudget),\n\t\t\t\theaderChars,\n\t\t\t);\n\t\t\t// J13：整块省略成本为 0，不扣剩余预算，后续可放入的消息继续处理。\n\t\t\tif (budgeted.hits.length === 0) return [];\n\t\t\t// J11/J12：复用必须命中列表完整相同（数量+逐项同对象），且原消息实际可见\n\t\t\t// 文本装得下剩余预算——复用时按 recall.message.content 完整文本扣费，\n\t\t\t// 不按刷新短头 cost（原消息可能是首次注入长头/带降级说明）。\n\t\t\tconst identical =\n\t\t\t\tbudgeted.hits.length === remaining.length &&\n\t\t\t\tbudgeted.hits.every((hit, index) => hit === remaining[index]);\n\t\t\tif (unchanged && identical) {\n\t\t\t\tconst rawChars = Array.from(visibleText(recall.message.content)).length;\n\t\t\t\tif (rawChars <= remainingBudget) {\n\t\t\t\t\tremainingBudget -= rawChars;\n\t\t\t\t\treturn [raw];\n\t\t\t\t}\n\t\t\t\t// 原消息文本装不下 → 走裁剪/副本路径，按副本实际文本实扣。\n\t\t\t}\n\t\t\t// 「内容未变可复用」只在整块按剩余预算原样保留时成立——条数相同但正文被\n\t\t\t// 提示项/截断替换、只留前缀或原消息超限都不算未变，必须重建可见副本。\n\t\t\tconst visibleHits = budgeted.hits;\n\t\t\tconst text = [\n\t\t\t\t`[pao 自动召回] 当前可见 ${visibleHits.length} 条${replaced > 0 ? \"（已刷新为当前修订）\" : removed ? \"（其余已纠正或失效）\" : \"\"}。${AUTO_RECALL_RESULTS_BOUNDARY}`,\n\t\t\t\t...visibleHits.map((hit, index) => renderMemoryHit(hit, index, currentSessionId)),\n\t\t\t].join(\"\\n\");\n\t\t\t// J12：副本按最终实际文本实扣（头+保留项+附注+分隔），不按估算 cost。\n\t\t\tremainingBudget -= Array.from(text).length;\n\t\t\treturn [\n\t\t\t\t{\n\t\t\t\t\t...recall.message,\n\t\t\t\t\tcontent: text,\n\t\t\t\t\tdetails: {\n\t\t\t\t\t\t...messageDetails(recall.message),\n\t\t\t\t\t\thits: visibleHits,\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t];\n\t\t});\n\t}\n\texclude(hit: InjectedMemory, replacement?: string): void {\n\t\tthis.excluded.add(this.exclusionKey(hit));\n\t\tconst target = this.exclusionKey(hit);\n\t\tfor (const previous of this.injected) if (this.exclusionKey(previous) === target) previous.排除 = true;\n\t\tif (hit.记忆ID?.trim()) {\n\t\t\tthis.currentReferences.delete(hit.记忆ID.trim());\n\t\t\tthis.visibleHits.delete(hit.记忆ID.trim());\n\t\t}\n\t\tthis.corrections.push(\n\t\t\t`此前召回“${hit.内容}”（ID：${hit.记忆ID ?? \"未知\"}）不再采用。${replacement ? `用户纠正为：${replacement}` : \"后续不要以此作为事实依据。\"} 已发送内容无法撤回。`,\n\t\t);\n\t}\n\t/** 已注入且带修订号的 builtin ID；刷新只读这些 ID，不扫全库。 */\n\tbuiltinMemoryIds(): string[] {\n\t\tconst ids = new Set<string>();\n\t\tfor (const hit of this.injected) {\n\t\t\tconst id = hit.记忆ID?.trim();\n\t\t\tif (hit.供应商 === BUILTIN_PROVIDER && id && Number.isInteger(hit.修订号)) ids.add(id);\n\t\t}\n\t\treturn [...ids];\n\t}\n\tmarkFreshnessPending(memoryIds: readonly string[]): void {\n\t\tfor (const memoryId of memoryIds) {\n\t\t\tconst id = memoryId.trim();\n\t\t\tif (id) this.pendingFreshness.add(id);\n\t\t}\n\t}\n\thasFreshnessPending(): boolean {\n\t\treturn this.pendingFreshness.size > 0;\n\t}\n\tacknowledgeFreshness(): void {\n\t\tthis.pendingFreshness.clear();\n\t}\n\t/**\n\t * F11（O08）：本会话经 pao_memory_resolve_artifact 读到的成果版本记录；\n\t * 浏览/预览不记执行，只在 worker 回执边界把它转成 recordArtifactUse。\n\t */\n\tmarkArtifactResolved(versionId: string, artifactId: string): void {\n\t\tthis.resolvedArtifactVersions.set(versionId, { versionId, artifactId });\n\t}\n\t/** 返回本会话 resolve 过的版本快照；不消费（同一次回执可关联多个版本）。 */\n\tresolvedArtifacts(): ReadonlyArray<{ versionId: string; artifactId: string }> {\n\t\treturn [...this.resolvedArtifactVersions.values()];\n\t}\n\t/** 回执边界消费后清空——一次回执归因一次，避免下次回执把上次的浏览再算一次执行。 */\n\tclearResolvedArtifacts(): void {\n\t\tthis.resolvedArtifactVersions.clear();\n\t}\n\tfreshnessReason(memoryIds: readonly string[]): string {\n\t\tconst wanted = new Set(memoryIds);\n\t\tconst current = this.selectedReferences().filter((reference) => wanted.has(reference.memoryId));\n\t\tconst changed = current.map((reference) => {\n\t\t\tconst conditions = reference.conditions ? `；条件:${reference.conditions}` : \"\";\n\t\t\treturn `- ${reference.memoryId}@rev-${reference.revision}:${reference.conclusion}${conditions}`;\n\t\t});\n\t\tconst retained = new Set(current.map((reference) => reference.memoryId));\n\t\tconst unavailable = [...wanted].filter((memoryId) => !retained.has(memoryId));\n\t\tfor (const memoryId of unavailable) changed.push(`- ${memoryId}:已被停用或删除，不再作为现行依据`);\n\t\treturn [\"记忆依据已变化，旧动作未执行。下一次请求会用当前修订替换旧召回正文。\", ...changed].join(\"\\n\");\n\t}\n\t/**\n\t * 本会话当前用于派发的内置记忆依据。只给引用和当前修订的元数据，\n\t * 不暴露 SessionMemory 内部条目；同一 memoryId 只取最近选定的一条。\n\t */\n\tselectedReferences(): SelectedMemoryReference[] {\n\t\treturn [...this.currentReferences.values()].map((reference) => ({\n\t\t\t...reference,\n\t\t\t...(reference.sourceIds === undefined ? {} : { sourceIds: [...reference.sourceIds] }),\n\t\t}));\n\t}\n\tprivate referenceFromHit(hit: MemoryHit, vendor: string): SelectedMemoryReference | undefined {\n\t\tconst basis = (hit as IdentityMemoryHit).记忆依据;\n\t\tif (\n\t\t\tvendor !== BUILTIN_PROVIDER ||\n\t\t\t!hit.记忆ID?.trim() ||\n\t\t\thit.修订号 === undefined ||\n\t\t\t!Number.isInteger(hit.修订号) ||\n\t\t\thit.修订号 < 1 ||\n\t\t\tbasis === undefined\n\t\t) {\n\t\t\treturn;\n\t\t}\n\t\treturn {\n\t\t\tmemoryId: hit.记忆ID.trim(),\n\t\t\trevision: hit.修订号,\n\t\t\tconclusion: basis.conclusion,\n\t\t\t...(basis.conditions === undefined ? {} : { conditions: basis.conditions }),\n\t\t\t...(basis.sourceIds === undefined ? {} : { sourceIds: [...basis.sourceIds] }),\n\t\t\t...(basis.confirmation === undefined ? {} : { confirmation: basis.confirmation }),\n\t\t\t...(basis.needsReDiscussion === undefined ? {} : { needsReDiscussion: basis.needsReDiscussion }),\n\t\t\t...(basis.referenceOnly === undefined ? {} : { referenceOnly: basis.referenceOnly }),\n\t\t};\n\t}\n\t/**\n\t * S2-10 修订感知：已注入记忆的当前派发依据同步到内置库当前修订。\n\t * `fetch` 回每条记忆当前修订（content/revision/usageState/sourceIds）；\n\t * 返回刷新到新修订的 memoryId 列表。历史 injected 条目保留当时的正文和修订，\n\t * 用于证明最终请求实际可见的是哪一版；后续派发与 /pao memory 当前依据走 currentReferences。\n\t * 记忆被停用时只做会话内临时可见抑制；删除才进入永久排除。\n\t * 外部供应商条目不参与此内置修订刷新。\n\t */\n\trefreshInjected(\n\t\tmemoryIds: readonly string[],\n\t\tfetch: (memoryId: string) =>\n\t\t\t| {\n\t\t\t\t\tcontent: MemoryRevisionContent;\n\t\t\t\t\trevision: number;\n\t\t\t\t\tusageState: string;\n\t\t\t\t\tsourceIds?: string[];\n\t\t\t\t\tsourceSummaries?: MemorySourceSummary[];\n\t\t\t\t\t/** 产生来源的分支（命中 scope.branch），有值时注入正文标「来源分支」。 */\n\t\t\t\t\tsourceBranch?: string;\n\t\t\t  }\n\t\t\t| null\n\t\t\t| undefined,\n\t): string[] {\n\t\tconst wanted = new Set(memoryIds);\n\t\tconst refreshed: string[] = [];\n\t\tfor (const memoryId of wanted) {\n\t\t\tconst matching = this.injected.filter((hit) => hit.记忆ID === memoryId);\n\t\t\tif (matching.length === 0) continue;\n\t\t\tconst current = fetch(memoryId);\n\t\t\tif (current === undefined) continue;\n\t\t\tconst builtinMatching = matching.filter((hit) => hit.修订号 !== undefined);\n\t\t\tif (builtinMatching.length === 0) {\n\t\t\t\tconst previous = matching.at(-1);\n\t\t\t\tif (previous === undefined) continue;\n\t\t\t\tif (current === null) {\n\t\t\t\t\tif (!previous.排除) {\n\t\t\t\t\t\tthis.excluded.add(this.exclusionKey(previous));\n\t\t\t\t\t\tprevious.排除 = true;\n\t\t\t\t\t\tthis.corrections.push(\n\t\t\t\t\t\t\t`此前召回“${previous.内容}”（ID：${memoryId}）在记忆库中已删除。后续不要以此作为事实依据。已发送内容无法撤回。`,\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tif (current.usageState === \"stopped\") {\n\t\t\t\t\tthis.currentReferences.delete(memoryId);\n\t\t\t\t\tthis.visibleHits.delete(memoryId);\n\t\t\t\t\tthis.suppressed.add(this.exclusionKey(previous));\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tthis.suppressed.delete(this.exclusionKey(previous));\n\t\t\t\tif (previous.内容 !== current.content.conclusion) {\n\t\t\t\t\tprevious.内容 = current.content.conclusion;\n\t\t\t\t\trefreshed.push(memoryId);\n\t\t\t\t}\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tconst latest = builtinMatching.at(-1);\n\t\t\tif (latest === undefined || this.isExcluded(latest, BUILTIN_PROVIDER)) {\n\t\t\t\tthis.currentReferences.delete(memoryId);\n\t\t\t\tthis.visibleHits.delete(memoryId);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif (current === null) {\n\t\t\t\tthis.currentReferences.delete(memoryId);\n\t\t\t\tthis.visibleHits.delete(memoryId);\n\t\t\t\tthis.suppressed.delete(this.exclusionKey(latest));\n\t\t\t\tconst unexcluded = builtinMatching.filter((hit) => !hit.排除);\n\t\t\t\tif (unexcluded.length > 0) {\n\t\t\t\t\tfor (const hit of builtinMatching) {\n\t\t\t\t\t\tthis.excluded.add(this.exclusionKey(hit));\n\t\t\t\t\t\thit.排除 = true;\n\t\t\t\t\t}\n\t\t\t\t\tthis.corrections.push(\n\t\t\t\t\t\t`此前召回“${unexcluded[0].内容}”（ID：${memoryId}）在记忆库中已删除。后续不要以此作为事实依据。已发送内容无法撤回。`,\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\trefreshed.push(memoryId);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif (current.usageState === \"stopped\") {\n\t\t\t\tthis.currentReferences.delete(memoryId);\n\t\t\t\tthis.visibleHits.delete(memoryId);\n\t\t\t\tfor (const hit of builtinMatching) this.suppressed.add(this.exclusionKey(hit));\n\t\t\t\trefreshed.push(memoryId);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tfor (const hit of builtinMatching) this.suppressed.delete(this.exclusionKey(hit));\n\t\t\tconst previous = this.currentReferences.get(memoryId);\n\t\t\tconst referenceOnly =\n\t\t\t\tprevious?.referenceOnly === true ||\n\t\t\t\tbuiltinMatching.some((hit) => hit.来源?.includes(\"跨项目参考\") === true);\n\t\t\tconst candidate: IdentityMemoryHit = {\n\t\t\t\t内容: renderBuiltinHitBody({\n\t\t\t\t\tcontent: current.content,\n\t\t\t\t\trevision: current.revision,\n\t\t\t\t\tcurrentRevision: current.revision,\n\t\t\t\t\treferenceOnly,\n\t\t\t\t\t...(current.sourceBranch === undefined ? {} : { sourceBranch: current.sourceBranch }),\n\t\t\t\t}),\n\t\t\t\t记忆ID: memoryId,\n\t\t\t\t修订号: current.revision,\n\t\t\t\t来源: latest.来源 ?? \"内置记忆库\",\n\t\t\t\t...(latest.相关度 === undefined ? {} : { 相关度: latest.相关度 }),\n\t\t\t\t...(current.sourceSummaries === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: { 来源摘要: current.sourceSummaries.map((source) => ({ ...source })) }),\n\t\t\t\t当前修订号: current.revision,\n\t\t\t\t记忆依据: {\n\t\t\t\t\tconclusion: current.content.conclusion,\n\t\t\t\t\t...(current.content.conditions === undefined ? {} : { conditions: current.content.conditions }),\n\t\t\t\t\t...(current.sourceIds === undefined ? {} : { sourceIds: [...current.sourceIds] }),\n\t\t\t\t\tconfirmation: current.content.confirmation,\n\t\t\t\t\t...(current.content.needsReDiscussion === undefined\n\t\t\t\t\t\t? {}\n\t\t\t\t\t\t: { needsReDiscussion: current.content.needsReDiscussion }),\n\t\t\t\t\treferenceOnly,\n\t\t\t\t},\n\t\t\t\t__paoWholeOnly: true,\n\t\t\t};\n\t\t\tconst reference = this.referenceFromHit(candidate, BUILTIN_PROVIDER);\n\t\t\tif (latest.修订号 !== current.revision) {\n\t\t\t\trefreshed.push(memoryId);\n\t\t\t}\n\t\t\tif (reference !== undefined) {\n\t\t\t\tthis.currentReferences.set(memoryId, reference);\n\t\t\t\tthis.visibleHits.set(memoryId, candidate);\n\t\t\t}\n\t\t}\n\t\treturn refreshed;\n\t}\n\tview(): string {\n\t\tif (!this.injected.length) return \"本会话尚无实际注入的自动召回。记忆时间、置信度由供应商未提供时均为未知。\";\n\t\treturn this.injected\n\t\t\t.map(\n\t\t\t\t(hit) =>\n\t\t\t\t\t`${hit.编号}. ${hit.内容}\\nID：${hit.记忆ID ?? \"未知\"}；来源：${hit.来源 ?? \"未知\"}；供应商：${hit.供应商}；作用范围：${hit.作用范围}；记忆时间：未知；置信度：未知；注入时间：${hit.注入时间}；${hit.排除 ? \"后续排除，已发送不能撤回\" : \"已加入请求消息\"}`,\n\t\t\t)\n\t\t\t.join(\"\\n\\n\");\n\t}\n}\n\nconst sessions = new WeakMap<ExtensionAPI, SessionMemory>();\nexport function sessionMemory(pi: ExtensionAPI): SessionMemory {\n\tlet state = sessions.get(pi);\n\tif (!state) {\n\t\tstate = new SessionMemory();\n\t\tsessions.set(pi, state);\n\t}\n\treturn state;\n}\n\n/**\n * S2-08 两路共用命令的内置服务绑定：builtin 路（tools.ts registerBuiltinMemory）\n * 装配时把服务访问子挂到这里；/pao memory 命令不论由 resident 还是 builtin\n * 哪一侧注册，命中「供应商=builtin」的注入条目时都直接走 service 层，\n * 不经过供应商子进程，也不查外发许可（本地 SQLite 不外发）。\n */\nconst builtinServices = new WeakMap<ExtensionAPI, () => MemoryService | undefined>();\nexport function bindBuiltinMemoryService(pi: ExtensionAPI, get: () => MemoryService | undefined): void {\n\tbuiltinServices.set(pi, get);\n}\n/** resident/tools 等模块取 builtin 服务实例；未装配（非 builtin 供应商）返回 undefined。 */\nexport function builtinMemoryService(pi: ExtensionAPI): MemoryService | undefined {\n\treturn builtinServices.get(pi)?.();\n}\n\n/**\n * S2-08 builtin 路的纠正/忘却：直接调 service.correctMemory / setMemoryUsage\n * （不走旧供应商两步「写新忘旧」——本地库修订链在 correctMemory 内完成替代）。\n * 先 getMemory 取当前修订号做 CAS；冲突如实报最新修订号，不伪造成功。\n */\nasync function runBuiltinMemoryCommand(\n\thit: InjectedMemory,\n\treplacement: string | undefined,\n\tstate: SessionMemory,\n\tctx: ExtensionCommandContext,\n\tpi: ExtensionAPI,\n\tcurrent: () => boolean,\n\tpaoHome: string,\n): Promise<void> {\n\tconst service = builtinMemoryService(pi);\n\tif (!service) {\n\t\tctx.ui.notify(\"内置记忆服务当前不在线（已卸载或关闭），未执行。\", \"warning\");\n\t\treturn;\n\t}\n\tconst confirmed = await ctx.ui.confirm(\n\t\t\"确认内置记忆修改\",\n\t\t`原文：${hit.内容}\\n${replacement ? `新文：${replacement}` : \"（停用）\"}\\n准确 ID：${hit.记忆ID}\\n影响：本地内置记忆库持久修订，其他会话召回同条目时同样受影响。`,\n\t);\n\tif (!confirmed) {\n\t\tctx.ui.notify(\"已取消，未修改记忆。\", \"info\");\n\t\treturn;\n\t}\n\tif (!current()) {\n\t\tctx.ui.notify(\"会话已切换，旧确认失效；未修改记忆。\", \"warning\");\n\t\treturn;\n\t}\n\tconst id = hit.记忆ID;\n\tif (!id) {\n\t\tctx.ui.notify(\"该条目无准确记忆 ID，未执行。\", \"warning\");\n\t\treturn;\n\t}\n\ttry {\n\t\tconst got = await service.getMemory({ id });\n\t\tif (!got.ok) {\n\t\t\tctx.ui.notify(`读取当前修订失败：${got.error.message}`, \"error\");\n\t\t\treturn;\n\t\t}\n\t\tif (!current()) {\n\t\t\tctx.ui.notify(\"会话已切换或操作已取消，未修改记忆。\", \"warning\");\n\t\t\treturn;\n\t\t}\n\t\tif (replacement) {\n\t\t\t// 先把本次纠正登记为可回读来源：新修订来源 = 本次纠正原文 + 旧修订\n\t\t\t// 来源（并集口径在 service.correctMemory 内保证）——旧结论的出处不丢。\n\t\t\tconst archived = archiveProjectOperationSource({\n\t\t\t\tpaoHome,\n\t\t\t\tsessionId: ctx.sessionManager.getSessionId(),\n\t\t\t\toperation: \"memoryCorrect\",\n\t\t\t\tdetails: {\n\t\t\t\t\tmemoryId: id,\n\t\t\t\t\toldRevision: got.memory.currentRevision,\n\t\t\t\t\treplacement,\n\t\t\t\t},\n\t\t\t});\n\t\t\t// 未编辑字段沿用旧值：条件/理由/承诺状态不被纠正清空（用户只纠正了结论）。\n\t\t\tconst result = await service.correctMemory({\n\t\t\t\tid,\n\t\t\t\texpectedRevision: got.memory.currentRevision,\n\t\t\t\treplacement: {\n\t\t\t\t\tconclusion: replacement,\n\t\t\t\t\t...(got.memory.content.conditions === undefined\n\t\t\t\t\t\t? {}\n\t\t\t\t\t\t: { conditions: got.memory.content.conditions }),\n\t\t\t\t\t...(got.memory.content.rationale === undefined ? {} : { rationale: got.memory.content.rationale }),\n\t\t\t\t\t...(got.memory.content.commitmentStatus === undefined\n\t\t\t\t\t\t? {}\n\t\t\t\t\t\t: { commitmentStatus: got.memory.content.commitmentStatus }),\n\t\t\t\t\t// 用户就是纠正者：纠正后保持「用户明确陈述 + 已确认」语义。\n\t\t\t\t\tevidenceKind: \"user_statement\",\n\t\t\t\t\tconfirmation: \"confirmed\",\n\t\t\t\t},\n\t\t\t\tsource: { sessionId: archived.sessionId, entryId: archived.entryId },\n\t\t\t\tsourceIds: [archived.sourceId],\n\t\t\t});\n\t\t\tif (!result.ok) {\n\t\t\t\tconst hint =\n\t\t\t\t\tresult.error.code === \"revision_conflict\"\n\t\t\t\t\t\t? `该记忆刚被其他操作修改（当前 rev-${result.error.currentRevision ?? \"?\"}），请重新查看 /pao memory 后再纠正。`\n\t\t\t\t\t\t: result.error.message;\n\t\t\t\tctx.ui.notify(`纠正被拒：${hint}`, \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!current()) {\n\t\t\t\tctx.ui.notify(\n\t\t\t\t\t`纠正已提交（rev-${result.revision}）但会话已切换，未注入当前会话；结果见记忆库。`,\n\t\t\t\t\t\"warning\",\n\t\t\t\t);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tstate.exclude(hit, replacement);\n\t\t\tpi.appendEntry(\"pao-memory-state\", state.snapshot());\n\t\t\tpi.appendEntry(\"pao-memory-correction\", { oldId: id, newRevision: result.revision });\n\t\t\tctx.ui.notify(`已纠正（新修订 rev-${result.revision}）；本会话后续按新结论走，已发送内容不能撤回。`, \"info\");\n\t\t\treturn;\n\t\t}\n\t\tconst stopped = await service.setMemoryUsage({\n\t\t\tid,\n\t\t\texpectedRevision: got.memory.currentRevision,\n\t\t\ttarget: \"stopped\",\n\t\t\tsource: { sessionId: ctx.sessionManager.getSessionId() },\n\t\t});\n\t\tif (!stopped.ok) {\n\t\t\tconst hint =\n\t\t\t\tstopped.error.code === \"revision_conflict\"\n\t\t\t\t\t? `该记忆刚被其他操作修改（当前 rev-${stopped.error.currentRevision ?? \"?\"}），请重新查看 /pao memory 后再停用。`\n\t\t\t\t\t: stopped.error.message;\n\t\t\tctx.ui.notify(`停用被拒：${hint}`, \"warning\");\n\t\t\treturn;\n\t\t}\n\t\tif (!current()) {\n\t\t\tctx.ui.notify(\"停用已提交但会话已切换，未注入当前会话；结果见记忆库。\", \"warning\");\n\t\t\treturn;\n\t\t}\n\t\tpi.appendEntry(\"pao-memory-state\", state.snapshot());\n\t\tctx.ui.notify(\"已停用该记忆（修订链与来源保留，可恢复）；已发送内容不能撤回。\", \"info\");\n\t} catch (error) {\n\t\tctx.ui.notify(error instanceof Error ? error.message : String(error), \"error\");\n\t}\n}\n\nexport interface CorrectionResult {\n\t状态: \"完成\" | \"部分成功\";\n\t新记忆?: MemoryWriteReceipt;\n\t说明: string;\n}\n\n/** 两步更新的证据不能在忘旧失败时丢失。缺写入 ID 的供应商不删旧条。 */\nexport async function correctMemory(\n\tvendor: MemoryVendor,\n\tid: string,\n\ttext: string,\n\tisCurrent: () => boolean = () => true,\n): Promise<CorrectionResult> {\n\tif (!id.trim()) throw new Error(\"缺准确 ID，不能纠正共享记忆\");\n\tif (!text.trim()) throw new Error(\"纠正内容不能为空\");\n\tif (!vendor.capabilities.忘却 || !vendor.forget) throw new Error(\"供应商不支持忘却，未改共享记忆\");\n\tif (!isCurrent()) throw new Error(\"会话已变化或操作已取消，未写共享记忆\");\n\tconst receipt = await vendor.write(text, [\"用户纠正\"]);\n\tif (!receipt) return { 状态: \"部分成功\", 说明: \"新文已写入，但供应商未返回准确 ID；保留旧条，不能确认完整纠正。\" };\n\tif (!isCurrent())\n\t\treturn { 状态: \"部分成功\", 新记忆: receipt, 说明: \"新文已写入，但会话已变化或操作已取消；旧条未删。\" };\n\tif (receipt.记忆ID === id)\n\t\treturn { 状态: \"部分成功\", 新记忆: receipt, 说明: \"供应商返回旧 ID，无法证明已替代旧内容；未执行忘却。\" };\n\ttry {\n\t\tawait vendor.forget(id);\n\t\treturn { 状态: \"完成\", 新记忆: receipt, 说明: \"新文写入后旧条已忘却（两步操作）。\" };\n\t} catch (error) {\n\t\treturn {\n\t\t\t状态: \"部分成功\",\n\t\t\t新记忆: receipt,\n\t\t\t说明: `新文已写入，旧条忘却失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n}\n\n/**\n * O06/J03（F05）：`/pao memory` 管理子命令的维护入口注入面。\n * builtin 装配侧（tools.ts）提供；resident 侧不注册管理命令（旧供应商无本地库概念）。\n */\nexport interface MemoryMaintenanceCommandAccess {\n\t/**\n\t * 备份登记：经维护队列 enqueue(\"archive\", …)（archive handler 走\n\t * createMemoryBackup）；未提供或调度器已关时 restore/rebuild 仍可用、\n\t * backup 如实提示维护队列未就绪。\n\t */\n\tenqueue?: (kind: \"archive\", scopeKey: string, sourceScope: string) => boolean;\n}\n\n/**\n * O06/R4：管理子命令参数解析——支持 `\"带空格值\"` 与不带引号单值。\n *\n * 逐段扫描，双引号内整体为一个参数（含空格）；无引号段按非空白连续字符取。\n * 未闭合引号或解析到非法片段返回 undefined（调用方按用法错误处理，不截断伪装）。\n */\nfunction parseCommandArgs(input: string): string[] | undefined {\n\tconst args: string[] = [];\n\tlet i = 0;\n\twhile (i < input.length) {\n\t\t// 跳过段间空白。\n\t\twhile (i < input.length && /\\s/.test(input[i]!)) i += 1;\n\t\tif (i >= input.length) break;\n\t\tif (input[i] === '\"') {\n\t\t\tconst end = input.indexOf('\"', i + 1);\n\t\t\tif (end < 0) return undefined; // 未闭合引号：用法错误，不截断。\n\t\t\targs.push(input.slice(i + 1, end));\n\t\t\ti = end + 1;\n\t\t} else {\n\t\t\tlet end = i;\n\t\t\twhile (end < input.length && !/\\s/.test(input[end]!)) end += 1;\n\t\t\targs.push(input.slice(i, end));\n\t\t\ti = end;\n\t\t}\n\t}\n\treturn args;\n}\n\nexport function registerMemoryCommand(\n\tpi: ExtensionAPI,\n\tgetManager: () => MemoryVendorManager | undefined,\n\thome: () => string,\n\tmaintenance?: MemoryMaintenanceCommandAccess,\n): void {\n\tconst state = sessionMemory(pi);\n\taddPaoSubcommand(pi, {\n\t\tname: \"memory\",\n\t\tlabel: \"记忆来源与纠正\",\n\t\tdescription: \"查看实际召回；排除只影响本会话，共享纠正与忘却需确认\",\n\t\trun: async (_pi, args, rawCtx) => {\n\t\t\tconst ctx = rawCtx as ExtensionCommandContext;\n\t\t\tconst command = args.trim();\n\t\t\tif (!command) {\n\t\t\t\tctx.ui.notify(state.view(), \"info\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (command === \"init\") {\n\t\t\t\ttry {\n\t\t\t\t\tconst result = initializeMemoryConfig(home());\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\tresult.status === \"created\"\n\t\t\t\t\t\t\t? `已初始化记忆供应商：builtin（本地 SQLite，不导入旧历史）。配置：${result.configPath}\\n新配置对后续新会话生效；当前会话未替换。`\n\t\t\t\t\t\t\t: `记忆供应商配置已存在：${result.config.供应商}，未覆盖。配置：${result.configPath}`,\n\t\t\t\t\t\t\"info\",\n\t\t\t\t\t);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`记忆初始化失败，原配置未改动：${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\"error\",\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (/^(?:use|switch)\\s+builtin$/.test(command)) {\n\t\t\t\ttry {\n\t\t\t\t\tconst result = switchMemoryConfigToBuiltin(home());\n\t\t\t\t\tif (result.status === \"already-builtin\") {\n\t\t\t\t\t\tctx.ui.notify(`记忆供应商已是 builtin，未改动。配置：${result.configPath}`, \"info\");\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\t`记忆供应商已从 ${result.previousProvider} 切到 builtin。`,\n\t\t\t\t\t\t\t`原配置备份：${result.backupPath}`,\n\t\t\t\t\t\t\t`启用边界：本地 SQLite 管理与召回；语义端点不可用时降级为本地词法。`,\n\t\t\t\t\t\t\t\"仅后续新会话读取 builtin；当前会话和已运行会话保持原供应商。\",\n\t\t\t\t\t\t\t\"未导入旧历史，未停止或修改原供应商共享服务。\",\n\t\t\t\t\t\t\t\"如需恢复，停止写入后复制备份覆盖现配置，再从新会话启动。\",\n\t\t\t\t\t\t].join(\"\\n\"),\n\t\t\t\t\t\t\"info\",\n\t\t\t\t\t);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`记忆供应商切换失败，原配置未改动：${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\"error\",\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t// ── O06/J03（F05）：管理子命令（本地库维护入口）───────────────────\n\t\t\t// rebuild：重建 memory_fts 索引（清除范围=读取范围，不动范围外项目/类型）。\n\t\t\tif (/^rebuild\\b/.test(command)) {\n\t\t\t\t// R4：统一参数解析，支持 --project \"带空格id\" / --kind \"带空格kind\"。\n\t\t\t\tconst parsed = parseCommandArgs(command.slice(\"rebuild\".length));\n\t\t\t\tlet projectId: string | undefined;\n\t\t\t\tlet kind: string | undefined;\n\t\t\t\tlet parseFailed = parsed === undefined;\n\t\t\t\tif (parsed !== undefined) {\n\t\t\t\t\tfor (let i = 0; i < parsed.length; i++) {\n\t\t\t\t\t\tconst token = parsed[i]!;\n\t\t\t\t\t\tif (token === \"--project\") {\n\t\t\t\t\t\t\tconst next = parsed[++i];\n\t\t\t\t\t\t\tif (next === undefined || next.startsWith(\"--\")) parseFailed = true;\n\t\t\t\t\t\t\telse projectId = next;\n\t\t\t\t\t\t} else if (token === \"--kind\") {\n\t\t\t\t\t\t\tconst next = parsed[++i];\n\t\t\t\t\t\t\tif (next === undefined || next.startsWith(\"--\")) parseFailed = true;\n\t\t\t\t\t\t\telse kind = next;\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tparseFailed = true; // 未识别片段：用法错误，不截断伪装。\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif (parseFailed) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t\"用法：/pao memory rebuild [--project <项目id>] [--kind <类型>]；参数带空格请加引号。\",\n\t\t\t\t\t\t\"warning\",\n\t\t\t\t\t);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\ttry {\n\t\t\t\t\tconst store = openMemoryStore(home(), \"readwrite\");\n\t\t\t\t\ttry {\n\t\t\t\t\t\tconst result = rebuildMemoryIndex(store, {\n\t\t\t\t\t\t\t...(projectId === undefined ? {} : { projectId }),\n\t\t\t\t\t\t\t...(kind === undefined ? {} : { kind: kind as never }),\n\t\t\t\t\t\t\tdropExistingFts: true,\n\t\t\t\t\t\t});\n\t\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t\t`索引重建完成：清除 ${result.droppedFts} 行、重建 ${result.rebuiltFts} 行` +\n\t\t\t\t\t\t\t\t`${result.skipped > 0 ? `、跳过 ${result.skipped} 条（已排除/已合并/正文缺失）` : \"\"}` +\n\t\t\t\t\t\t\t\t`${projectId !== undefined || kind !== undefined ? `；范围=${projectId !== undefined ? `project=${projectId}` : \"\"}${kind !== undefined ? ` kind=${kind}` : \"\"}` : \"（全库）\"}`,\n\t\t\t\t\t\t\t\"info\",\n\t\t\t\t\t\t);\n\t\t\t\t\t} finally {\n\t\t\t\t\t\tstore.close();\n\t\t\t\t\t}\n\t\t\t\t} catch (error) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`索引重建失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\"error\",\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t// backup：经维护队列登记 archive 作业（空闲 drain 时执行 createMemoryBackup）。\n\t\t\tif (/^backup\\b/.test(command)) {\n\t\t\t\tconst parsed = parseCommandArgs(command.slice(\"backup\".length));\n\t\t\t\tif (parsed === undefined || parsed.length !== 1) {\n\t\t\t\t\tctx.ui.notify(\"用法：/pao memory backup <备份目录>；目录带空格请加引号。\", \"warning\");\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tconst backupDir = parsed[0]!;\n\t\t\t\tif (maintenance?.enqueue === undefined) {\n\t\t\t\t\tctx.ui.notify(\"维护队列未就绪（维护调度器未装配或已关闭），未登记备份作业。\", \"warning\");\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tconst accepted = maintenance.enqueue(\n\t\t\t\t\t\"archive\",\n\t\t\t\t\t`archive:${backupDir}`,\n\t\t\t\t\tJSON.stringify({ kind: \"archive\", backupDir }),\n\t\t\t\t);\n\t\t\t\tctx.ui.notify(\n\t\t\t\t\taccepted\n\t\t\t\t\t\t? `已登记备份作业（archive:${backupDir}）：空闲维护轮次执行一致性备份；` +\n\t\t\t\t\t\t\t\t`结果可用 /pao memory 维护队列状态查看，备份目录=${backupDir}`\n\t\t\t\t\t\t: \"维护调度器已关闭（会话收尾中），未登记备份作业。\",\n\t\t\t\t\taccepted ? \"info\" : \"warning\",\n\t\t\t\t);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t// restore：从备份目录恢复到独立目标 home（目标库独立打开，不动当前现场）。\n\t\t\tif (/^restore\\b/.test(command)) {\n\t\t\t\tconst parsed = parseCommandArgs(command.slice(\"restore\".length));\n\t\t\t\tif (parsed === undefined || parsed.length !== 2) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t\"用法：/pao memory restore <备份目录> <目标目录>；目录带空格请加引号。\",\n\t\t\t\t\t\t\"warning\",\n\t\t\t\t\t);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tconst backupDir = parsed[0]!;\n\t\t\t\tconst targetHome = parsed[1]!;\n\t\t\t\ttry {\n\t\t\t\t\tconst result = restoreMemoryBackup({ backupDir, targetHome, liveHome: home() });\n\t\t\t\t\tif (!result.ok) {\n\t\t\t\t\t\tctx.ui.notify(`记忆恢复失败：${result.error.message}`, \"error\");\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`记忆已恢复到 ${result.targetHome}：段 ${result.restoredSegments} 个、` +\n\t\t\t\t\t\t\t`重放排除 ${result.replayedExclusions} 条（共 ${result.exclusionCount}）、` +\n\t\t\t\t\t\t\t`清派生索引 FTS=${result.clearedFts}/向量=${result.clearedVectors}。${result.limitation}`,\n\t\t\t\t\t\t\"info\",\n\t\t\t\t\t);\n\t\t\t\t} catch (error) {\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`记忆恢复失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t\t\t\t\t\"error\",\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst match = /^(exclude|correct|forget)\\s+(\\d+)(?:\\s+([\\s\\S]+))?$/.exec(command);\n\t\t\tif (!match) {\n\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\"用法：/pao memory；memory init；memory use builtin；memory switch builtin；memory exclude 编号；memory correct 编号 新内容；memory forget 编号；memory rebuild [--project id] [--kind kind]；memory backup 目录；memory restore 备份目录 目标目录\",\n\t\t\t\t\t\"warning\",\n\t\t\t\t);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst hit = state.injected.find((item) => item.编号 === Number(match[2]));\n\t\t\tif (!hit) {\n\t\t\t\tctx.ui.notify(\"没有该注入编号；请先查看 /pao memory。\", \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (match[1] === \"exclude\") {\n\t\t\t\tstate.exclude(hit);\n\t\t\t\tpi.appendEntry(\"pao-memory-state\", state.snapshot());\n\t\t\t\tctx.ui.notify(\"本会话后续不再采用此条；已发送内容不能撤回。\", \"info\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!hit.记忆ID) {\n\t\t\t\tctx.ui.notify(\"来源未提供准确 ID，不能修改或忘却共享记忆。\", \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst replacement = match[1] === \"correct\" ? match[3]?.trim() : undefined;\n\t\t\tif (match[1] === \"correct\" && !replacement) {\n\t\t\t\tctx.ui.notify(\"纠正内容不能为空。\", \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!ctx.hasUI) {\n\t\t\t\tctx.ui.notify(\"共享修改需要可交互确认；本次未执行。\", \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst generation = state.generation;\n\t\t\tconst originalSessionId = ctx.sessionManager.getSessionId();\n\t\t\tconst current = () =>\n\t\t\t\tgeneration === state.generation &&\n\t\t\t\tctx.sessionManager.getSessionId() === originalSessionId &&\n\t\t\t\t!ctx.signal?.aborted;\n\t\t\tif (hit.供应商 === BUILTIN_PROVIDER) {\n\t\t\t\tawait runBuiltinMemoryCommand(hit, replacement, state, ctx, pi, current, home());\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst confirmed = await ctx.ui.confirm(\n\t\t\t\t\"确认共享记忆修改\",\n\t\t\t\t`原文：${hit.内容}\\n新文：${replacement ?? \"（忘却）\"}\\n准确 ID：${hit.记忆ID}\\n影响：供应商共享库，其他会话也可能受影响。${replacement ? \"先写新再忘旧，两步可能部分成功。\" : \"\"}`,\n\t\t\t);\n\t\t\tif (!confirmed) {\n\t\t\t\tctx.ui.notify(\"已取消，未修改共享记忆。\", \"info\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!current()) {\n\t\t\t\tctx.ui.notify(\"会话已切换，旧确认失效；未修改共享记忆。\", \"warning\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\ttry {\n\t\t\t\tconst project = projectFromCwd(ctx.cwd);\n\t\t\t\tconst check = checkOutbound(project ? [project] : [], loadOutboundConfig(home()));\n\t\t\t\tif (!check.allowed) throw new Error(\"当前项目未获外发许可，未修改共享记忆\");\n\t\t\t\tconst vendor = await getManager()?.acquire();\n\t\t\t\tif (!current()) throw new Error(\"会话已切换或操作已取消，未修改共享记忆。\");\n\t\t\t\tif (!vendor) throw new Error(\"记忆供应商未启用或不可用\");\n\t\t\t\tif (vendor.vendorName !== hit.供应商)\n\t\t\t\t\tthrow new Error(\"当前供应商与此条来源不同，未修改；请从当前供应商重新召回后操作。\");\n\t\t\t\tif (!vendor.capabilities.忘却 || !vendor.forget) throw new Error(\"供应商不支持忘却，未修改共享记忆\");\n\t\t\t\tif (replacement) {\n\t\t\t\t\tconst result = await correctMemory(vendor, hit.记忆ID, replacement, current);\n\t\t\t\t\tif (!current()) {\n\t\t\t\t\t\tconst evidence = join(ctx.cwd, \".pao\", \"记忆操作\", `${randomUUID()}.json`);\n\t\t\t\t\t\twriteFileAtomic(\n\t\t\t\t\t\t\tevidence,\n\t\t\t\t\t\t\tJSON.stringify({ sessionId: originalSessionId, oldId: hit.记忆ID, result }, null, 2),\n\t\t\t\t\t\t);\n\t\t\t\t\t\tctx.ui.notify(`原会话的记忆操作返回：${result.说明}。未注入当前会话。证据：${evidence}`, \"warning\");\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tstate.exclude(hit, replacement);\n\t\t\t\t\tpi.appendEntry(\"pao-memory-state\", state.snapshot());\n\t\t\t\t\tpi.appendEntry(\"pao-memory-correction\", { oldId: hit.记忆ID, result });\n\t\t\t\t\tctx.ui.notify(\n\t\t\t\t\t\t`${result.状态}：${result.说明} 新 ID：${result.新记忆?.记忆ID ?? \"未知\"}`,\n\t\t\t\t\t\tresult.状态 === \"完成\" ? \"info\" : \"warning\",\n\t\t\t\t\t);\n\t\t\t\t} else {\n\t\t\t\t\tconst count = await vendor.forget(hit.记忆ID);\n\t\t\t\t\tif (!current()) {\n\t\t\t\t\t\tconst evidence = join(ctx.cwd, \".pao\", \"记忆操作\", `${randomUUID()}.json`);\n\t\t\t\t\t\twriteFileAtomic(\n\t\t\t\t\t\t\tevidence,\n\t\t\t\t\t\t\tJSON.stringify({ sessionId: originalSessionId, oldId: hit.记忆ID, forgotten: count }, null, 2),\n\t\t\t\t\t\t);\n\t\t\t\t\t\tctx.ui.notify(`原会话忘却已返回，未注入当前会话。证据：${evidence}`, \"warning\");\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tstate.exclude(hit);\n\t\t\t\t\tpi.appendEntry(\"pao-memory-state\", state.snapshot());\n\t\t\t\t\tctx.ui.notify(\"已执行忘却；已发送内容无法撤回。\", \"info\");\n\t\t\t\t}\n\t\t\t} catch (error) {\n\t\t\t\tctx.ui.notify(error instanceof Error ? error.message : String(error), \"error\");\n\t\t\t}\n\t\t},\n\t});\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 来源原文词法索引（O05/Q3）：source_fts 的写入、清理与候选查询。\n *\t\t`INSERT INTO source_fts (source_id, session_id, entry_id, event_type, project_id, task_id, content)\n\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t).run(\n\t\tsourceId, row.sessionId,row.entryId,row.eventType,row.projectId ?? null,row.taskId ?? null,row.content,\n\t);\n}\n\t\t      )))`,\n\t];\n\tconst scopeParams: SQLInputValue[] = [scope.projectId,scope.sessionId ?? \"\",];\n\tif (scope.taskId !== undefined) {\n\t\tscopeParts.push(`(s.task_id IS NULL OR s.task_id = ?)`);\treturn hits2;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,96]}}},{"equalLines":{"line_count":72}},{"diffOp":{"equal":{"range":[96,239]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"equal":{"range":[242,251]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[252,266]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[266,278]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[278,292]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[292,314]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[314,333]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[333,344]}}},{"diffOp":{"delete":{"range":[344,347]}}},{"diffOp":{"equal":{"range":[347,352]}}},{"equalLines":{"line_count":97}},{"diffOp":{"equal":{"range":[352,409]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"equal":{"range":[409,425]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[409,425]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[425,447]}}},{"diffOp":{"delete":{"range":[239,242]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[409,424]}}},{"diffOp":{"delete":{"range":[344,347]}}},{"diffOp":{"equal":{"range":[447,543]}}},{"equalLines":{"line_count":64}},{"diffOp":{"equal":{"range":[543,560]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\source-fts.ts"},"span":null,"sourceCode":"/**\n * 来源原文词法索引（O05/Q3）：source_fts 的写入、清理与候选查询。\n *\n * 契约：\n * - 索引对象是 capture 主路登记进 sources 的已脱敏事件正文；只提取可保存文本\n *   （字符串/文本块），附件引用块、图片块不产生索引文本。\n * - 写路径调用方（capture.ts captureCommittedEntry）在 registerSource 成功后\n *   同一事务内调 `upsertSourceFts`；删除路径在 sources 行删除/段内整行移除时\n *   调 `dropSourceFts`（deletion.ts）。\n * - 三个旁路写入方（knowledge archiveSource、project-operation-source、\n *   receipts）不接入——它们不是会话讨论原文，需求只覆盖「未提炼讨论」。\n * - 查询只服务 history 模式：sourceHits 是独立的「来源命中」lane，不进 RRF、\n *   不占 perLane；命中后由调用方经 readMemorySource 展开原文。\n */\nimport type { DatabaseSync, SQLInputValue } from \"node:sqlite\";\nimport { sourceExclusionsMemoryIdColumn, sourceGlobalExclusionSql } from \"./sources.ts\";\nimport type { MemoryScope, SourceSearchHit } from \"./types.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 索引文本提取\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 从已脱敏的 event.content 提取可索引文本。\n * 与 capture 的写库口径一致（sanitizeContent 之后的形状），但本函数只读不写：\n * - 字符串：直取；\n * - 数组：取各 {type:\"text\", text:string} 块的 text 拼接（附件引用块不含 text 字段，\n *   自然跳过；图片块已在 capture 侧替换为引用块，同样不进索引）；\n * - 对象（消息/custom 包装）：递归取 .content；\n * - 其他形状（数字/null/…）：空串。\n */\nexport function extractIndexableText(content: unknown): string {\n\tif (typeof content === \"string\") return content;\n\tif (Array.isArray(content)) {\n\t\treturn content\n\t\t\t.map((block) => {\n\t\t\t\tif (typeof block === \"string\") return block;\n\t\t\t\tif (block && typeof block === \"object\") {\n\t\t\t\t\tconst record = block as { type?: unknown; text?: unknown };\n\t\t\t\t\tif (record.type === \"text\" && typeof record.text === \"string\") return record.text;\n\t\t\t\t}\n\t\t\t\treturn \"\";\n\t\t\t})\n\t\t\t.filter((part) => part.length > 0)\n\t\t\t.join(\"\\n\");\n\t}\n\tif (content && typeof content === \"object\") {\n\t\tconst record = content as Record<string, unknown>;\n\t\tif (\"content\" in record) return extractIndexableText(record.content);\n\t}\n\treturn \"\";\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 写入与清理（调用方事务内）\n// ════════════════════════════════════════════════════════════════════════\n\nexport interface SourceFtsRowInput {\n\tsessionId: string;\n\tentryId: string;\n\teventType: string;\n\tprojectId?: string;\n\ttaskId?: string;\n\t/** extractIndexableText 提取后的索引文本（可能为空串——空文本仍登记行，不参与命中）。 */\n\tcontent: string;\n}\n\n/**\n * 把一条来源的索引文本 upsert 进 source_fts。\n * 先删该 sourceId 旧行再插，幂等可重放；必须在调用方事务内执行，\n * 与 sources 行登记同生同死。\n */\nexport function upsertSourceFts(db: DatabaseSync, sourceId: string, row: SourceFtsRowInput): void {\n\tdb.prepare(\"DELETE FROM source_fts WHERE source_id = ?\").run(sourceId);\n\tdb.prepare(\n\t\t`INSERT INTO source_fts (source_id, session_id, entry_id, event_type, project_id, task_id, content)\n\t\t VALUES (?, ?, ?, ?, ?, ?, ?)`,\n\t).run(\n\t\tsourceId,\n\t\trow.sessionId,\n\t\trow.entryId,\n\t\trow.eventType,\n\t\trow.projectId ?? null,\n\t\trow.taskId ?? null,\n\t\trow.content,\n\t);\n}\n\n/**\n * 清掉一个来源的全部索引行。两种粒度：\n * - `{sourceId}`：sources 行删除时按行清；\n * - `{entryId}`：归档段整行移除某条目时按条目清（覆盖同 entryId 的多 eventType 来源）。\n */\nexport function dropSourceFts(db: DatabaseSync, target: { sourceId: string } | { entryId: string }): void {\n\tif (\"sourceId\" in target) {\n\t\tdb.prepare(\"DELETE FROM source_fts WHERE source_id = ?\").run(target.sourceId);\n\t} else {\n\t\tdb.prepare(\"DELETE FROM source_fts WHERE entry_id = ?\").run(target.entryId);\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// history 检索的 source lane\n// ════════════════════════════════════════════════════════════════════════\n\n/** source lane 返回行数上限（独立于 memory lane 的 perLane；source 命中不进 RRF）。 */\nexport function sourceLaneLimit(limit: number): number {\n\treturn Math.max(10, 2 * limit);\n}\n\n/** 命中行文本截断上限（码点；snippet 只回定位摘要，展开交给 readMemorySource）。 */\nconst SOURCE_SNIPPET_LIMIT = 200;\n\ninterface SourceFtsHitRow {\n\tsource_id: string;\n\tsession_id: string;\n\tentry_id: string;\n\tevent_type: string;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsegment_id: string | null;\n\tcaptured_at: string;\n\tcontent: string;\n\trank: number;\n}\n\n/** LIKE 子串模式的转义（与 search.ts 词法路同口径）。 */\nfunction likePattern(term: string): string {\n\treturn `%${term.replace(/\\\\/g, \"\\\\\\\\\").replace(/%/g, \"\\\\%\").replace(/_/g, \"\\\\_\")}%`;\n}\n\n/**\n * history 模式的来源候选：FTS MATCH（≥3 字符词）+ LIKE 子串（短词/MATCH 失败降级）。\n *\n * 范围过滤以 sources 行 project_id/task_id 为准（source_fts 同名列是同步冗余），\n * 对齐 historyScopeFilter 语义且在候选 LIMIT 前落实：\n * - projectId：scope.projectId 准确匹配；本项目有效记忆的引用关系也能证明归属\n *   （删除共享记忆后保留的来源在其引用项目内仍可发现）；NULL（采集时无可靠绑定）\n *   只在能证明归属时命中——本会话来源，或同会话已有其他来源绑定到本项目。\n *   NULL 不再无条件跨项目放行。\n * - taskId：scope.taskId 有值时 `NULL 或匹配`；未指定任务查询只取无任务来源\n *   （与 current 记忆的 taskId 语义一致）。\n * - 排除：source_exclusions 整体排除判定（isSourceGloballyExcluded 同一语义）\n *   下推到 SQL WHERE，被排除来源不占候选 LIMIT 位；「被删记忆的引用排除」\n *   不连带隐藏仍被其他有效记忆引用的保留来源。\n */\nexport function sourceCandidates(\n\tdb: DatabaseSync,\n\tscope: MemoryScope,\n\tquery: string,\n\tlimit: number,\n): SourceSearchHit[] {\n\tconst laneLimit = sourceLaneLimit(limit);\n\tconst terms = query\n\t\t.trim()\n\t\t.split(/[\\s，。、；：？！()（）[\\]【】,.;:?!\"'\"\"'']+/)\n\t\t.map((s) => s.trim())\n\t\t.filter((s) => s.length > 0);\n\tconst trimmed = query.trim();\n\tif (trimmed.length > 0 && !terms.includes(trimmed)) terms.push(trimmed);\n\tif (terms.length === 0) return [];\n\n\tconst hits = new Map<string, { row: SourceFtsHitRow; rank: number }>();\n\tconst collect = (rows: SourceFtsHitRow[], rank0: number): void => {\n\t\tfor (const row of rows) {\n\t\t\tconst existing = hits.get(row.source_id);\n\t\t\tconst rank = rank0 + row.rank;\n\t\t\tif (!existing || rank < existing.rank) hits.set(row.source_id, { row, rank });\n\t\t}\n\t};\n\n\tconst scopeParts: string[] = [\n\t\t`(s.project_id = ?\n\t\t  OR EXISTS (\n\t\t    SELECT 1 FROM memory_source_links lp\n\t\t    JOIN memories mp ON mp.id = lp.memory_id\n\t\t    WHERE lp.source_id = s.source_id\n\t\t      AND json_extract(mp.scope_json, '$.projectId') = ?\n\t\t  )\n\t\t  OR (s.project_id IS NULL AND (\n\t\t        s.session_id = ?\n\t\t        OR EXISTS (\n\t\t          SELECT 1 FROM sources sx\n\t\t          WHERE sx.session_id = s.session_id AND sx.project_id = ?\n\t\t        )\n\t\t      )))`,\n\t];\n\tconst scopeParams: SQLInputValue[] = [\n\t\tscope.projectId,\n\t\tscope.projectId,\n\t\tscope.sessionId ?? \"\",\n\t\tscope.projectId,\n\t];\n\tif (scope.taskId !== undefined) {\n\t\tscopeParts.push(`(s.task_id IS NULL OR s.task_id = ?)`);\n\t\tscopeParams.push(scope.taskId);\n\t} else {\n\t\tscopeParts.push(`s.task_id IS NULL`);\n\t}\n\tscopeParts.push(sourceGlobalExclusionSql(sourceExclusionsMemoryIdColumn(db)));\n\tconst scopeWhere = scopeParts.join(\" AND \");\n\n\tfor (const term of terms) {\n\t\tlet rows: SourceFtsHitRow[] | undefined;\n\t\tif (term.length >= 3) {\n\t\t\t// trigram 需 ≥3 字符成组；带引号防特殊符被当 FTS 运算语法。\n\t\t\tconst matchArg = `\"${term.replace(/\"/g, '\"\"')}\"`;\n\t\t\ttry {\n\t\t\t\trows = db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT f.source_id, f.session_id, f.entry_id, f.event_type,\n\t\t\t\t\t\t        f.project_id, f.task_id, s.segment_id, s.captured_at, f.content, f.rank\n\t\t\t\t\t\t FROM source_fts f\n\t\t\t\t\t\t JOIN sources s ON s.source_id = f.source_id\n\t\t\t\t\t\t WHERE source_fts MATCH ? AND ${scopeWhere}\n\t\t\t\t\t\t ORDER BY f.rank, f.source_id\n\t\t\t\t\t\t LIMIT ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.all(matchArg, ...scopeParams, laneLimit) as unknown as SourceFtsHitRow[];\n\t\t\t} catch {\n\t\t\t\trows = undefined; // MATCH 语法失败 → 该词走 LIKE 兜底\n\t\t\t}\n\t\t}\n\t\tif (rows === undefined) {\n\t\t\trows = db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT f.source_id, f.session_id, f.entry_id, f.event_type,\n\t\t\t\t\t        f.project_id, f.task_id, s.segment_id, s.captured_at, f.content, 0 AS rank\n\t\t\t\t\t FROM source_fts f\n\t\t\t\t\t JOIN sources s ON s.source_id = f.source_id\n\t\t\t\t\t WHERE f.content LIKE ? ESCAPE '\\\\' AND ${scopeWhere}\n\t\t\t\t\t ORDER BY f.source_id\n\t\t\t\t\t LIMIT ?`,\n\t\t\t\t)\n\t\t\t\t.all(likePattern(term), ...scopeParams, laneLimit) as unknown as SourceFtsHitRow[];\n\t\t}\n\t\tcollect(rows, 0);\n\t\tif (hits.size >= laneLimit) break;\n\t}\n\n\tconst sorted = [...hits.values()].sort((a, b) =>\n\t\ta.rank !== b.rank ? a.rank - b.rank : a.row.source_id.localeCompare(b.row.source_id),\n\t);\n\tconst hits2: SourceSearchHit[] = [];\n\tfor (const { row } of sorted) {\n\t\tif (hits2.length >= laneLimit) break;\n\t\tconst snippet = Array.from(row.content).slice(0, SOURCE_SNIPPET_LIMIT).join(\"\");\n\t\thits2.push({\n\t\t\tsourceId: row.source_id,\n\t\t\tsessionId: row.session_id,\n\t\t\tentryId: row.entry_id,\n\t\t\teventType: row.event_type,\n\t\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t\t...(row.segment_id === null ? {} : { segmentId: row.segment_id }),\n\t\t\tcapturedAt: row.captured_at,\n\t\t\tsnippet,\n\t\t});\n\t}\n\treturn hits2;\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 内置记忆的来源登记与查询（S1-04）。\n *): boolean {\n\tif (!sourceExclusionsHaveMemoryId(db)) return isSourceExcluded(db, target);\n\tconst rows = (\n\t\t\"sourceId\" in target\n\t\t\t? (() => {\t\t\t\t\t\t\t\t).map((r) => r.source_id)\n\t\t\t\t\t\t\t: [row.source_id],\n\t\t\t\t});\n\tfor (const row of rows) {\n\t\tif (row.memory_id === null) return true;\treturn rows.map((row) => row.source_id);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,60]}}},{"equalLines":{"line_count":282}},{"diffOp":{"equal":{"range":[60,163]}}},{"diffOp":{"delete":{"range":[163,165]}}},{"diffOp":{"equal":{"range":[165,202]}}},{"equalLines":{"line_count":29}},{"diffOp":{"equal":{"range":[202,267]}}},{"diffOp":{"delete":{"range":[60,61]}}},{"diffOp":{"equal":{"range":[60,61]}}},{"diffOp":{"delete":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[267,339]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[339,383]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\memory\\sources.ts"},"span":null,"sourceCode":"/**\n * 内置记忆的来源登记与查询（S1-04）。\n *\n * 契约：\n * - `registerSource` 幂等：sourceId 由 `src-{sessionId}-{entryId}` 派生，配合\n *   `UNIQUE(session_id, entry_id, event_type)` 约束——同一来源重复登记返回既有 ID，\n *   不复制行；同一 entryId 出现在不同会话会生成不同 sourceId，不会混淆。\n * - `resolveSources` 只做存在性校验：调用方（create/correct/merge）落修订前必须\n *   先过这道关，缺任何一个都整体拒绝，不写半套来源关系。\n * - 查询接口供 getMemory/后续删除预览使用：来源关系精确绑定到修订。\n */\nimport type { DatabaseSync } from \"node:sqlite\";\n\n/** registerSource 的输入。 */\nexport interface RegisterSourceInput {\n\tsessionId: string;\n\tentryId: string;\n\t/** 原始事件类型（user/assistant/toolResult/custom）。 */\n\teventType: string;\n\t/** 采集时由会话树位置证明的项目身份；没有可靠绑定时省略。 */\n\tprojectId?: string;\n\t/** 采集时由会话树位置证明的任务身份；没有可靠绑定时省略。 */\n\ttaskId?: string;\n\t/** 来源位置：归档段内偏移或 JSONL 行号。 */\n\tlocation?: string;\n\t/** 归档段 ID（已封存时填入）。 */\n\tsegmentId?: string;\n\t/** 采集时间（由夹具注入）。 */\n\tcapturedAt: string;\n}\n\n/** 来源行（sources 表一行的映射）。 */\nexport interface SourceRow {\n\tsourceId: string;\n\tsessionId: string;\n\tentryId: string;\n\teventType: string;\n\tprojectId?: string;\n\ttaskId?: string;\n\tlocation?: string;\n\tsegmentId?: string;\n\tcapturedAt: string;\n}\n\ninterface SourceDbRow {\n\tsource_id: string;\n\tsession_id: string;\n\tentry_id: string;\n\tevent_type: string;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tlocation: string | null;\n\tsegment_id: string | null;\n\tcaptured_at: string;\n}\n\nfunction mapSourceRow(row: SourceDbRow): SourceRow {\n\treturn {\n\t\tsourceId: row.source_id,\n\t\tsessionId: row.session_id,\n\t\tentryId: row.entry_id,\n\t\teventType: row.event_type,\n\t\t...(row.project_id === null ? {} : { projectId: row.project_id }),\n\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\tlocation: row.location ?? undefined,\n\t\tsegmentId: row.segment_id ?? undefined,\n\t\tcapturedAt: row.captured_at,\n\t};\n}\n\n/**\n * 登记一条来源并返回稳定 sourceId。\n *\n * 幂等：先按 (session_id, entry_id, event_type) 查既有行，命中直接返回；\n * 未命中才 INSERT。并发下若撞 UNIQUE 冲突（另一写入者先登记同一来源），\n * 回读既有行返回——调用方不感知冲突。\n */\nexport function registerSource(db: DatabaseSync, input: RegisterSourceInput): string {\n\tconst existing = db\n\t\t.prepare(\n\t\t\t`SELECT source_id FROM sources\n\t\t\t WHERE session_id = ? AND entry_id = ? AND event_type = ?`,\n\t\t)\n\t\t.get(input.sessionId, input.entryId, input.eventType) as { source_id: string } | undefined;\n\tif (existing) return existing.source_id;\n\n\t// sourceId 必须含 eventType：同一 (sessionId, entryId) 允许不同事件类型各登记一条\n\t// （UNIQUE 是三列联合）；不带 eventType 会让第二条撞 source_id 主键。\n\tconst sourceId = `src-${input.sessionId}-${input.entryId}-${input.eventType}`;\n\ttry {\n\t\tdb.prepare(\n\t\t\t`INSERT INTO sources (\n\t\t\t\tsource_id, session_id, entry_id, event_type, project_id, task_id, location, segment_id, captured_at\n\t\t\t ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t).run(\n\t\t\tsourceId,\n\t\t\tinput.sessionId,\n\t\t\tinput.entryId,\n\t\t\tinput.eventType,\n\t\t\tinput.projectId ?? null,\n\t\t\tinput.taskId ?? null,\n\t\t\tinput.location ?? null,\n\t\t\tinput.segmentId ?? null,\n\t\t\tinput.capturedAt,\n\t\t);\n\t} catch (error) {\n\t\t// UNIQUE(session_id, entry_id, event_type) 冲突：另一写入者抢先登记同一来源。\n\t\t// 回读既有 source_id 返回（可能与本次派生不同——以先登记者的 ID 为准）。\n\t\tconst raced = db\n\t\t\t.prepare(\n\t\t\t\t`SELECT source_id FROM sources\n\t\t\t\t WHERE session_id = ? AND entry_id = ? AND event_type = ?`,\n\t\t\t)\n\t\t\t.get(input.sessionId, input.entryId, input.eventType) as { source_id: string } | undefined;\n\t\tif (raced) return raced.source_id;\n\t\tthrow error;\n\t}\n\treturn sourceId;\n}\n\n/**\n * 校验一组 sourceId 全部存在。\n * 返回缺失列表；空数组表示全部可解析。调用方在写修订前调用，\n * 缺任何一个都整体拒绝（不部分写入来源关系）。\n */\nexport function resolveSources(db: DatabaseSync, sourceIds: string[]): { missing: string[] } {\n\tif (sourceIds.length === 0) return { missing: [] };\n\tconst missing: string[] = [];\n\tconst stmt = db.prepare(\"SELECT 1 AS ok FROM sources WHERE source_id = ?\");\n\tfor (const sourceId of sourceIds) {\n\t\tif (!stmt.get(sourceId)) missing.push(sourceId);\n\t}\n\treturn { missing };\n}\n\n/** 按 sourceId 取来源行；不存在返回 undefined。 */\nexport function getSource(db: DatabaseSync, sourceId: string): SourceRow | undefined {\n\tconst row = db\n\t\t.prepare(\n\t\t\t`SELECT source_id, session_id, entry_id, event_type, project_id, task_id, location, segment_id, captured_at\n\t\t\t FROM sources WHERE source_id = ?`,\n\t\t)\n\t\t.get(sourceId) as SourceDbRow | undefined;\n\treturn row ? mapSourceRow(row) : undefined;\n}\n\n/**\n * 取某条记忆指定修订引用的全部来源（按登记顺序）。\n * memoryId + revision 定位修订，来源关系精确绑定到修订——\n * 查不同修订返回各自的来源集。\n */\nexport function sourcesForRevision(db: DatabaseSync, memoryId: string, revision: number): SourceRow[] {\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT s.source_id, s.session_id, s.entry_id, s.event_type, s.project_id, s.task_id,\n\t\t\t        s.location, s.segment_id, s.captured_at\n\t\t\t FROM memory_source_links l\n\t\t\t JOIN sources s ON s.source_id = l.source_id\n\t\t\t WHERE l.memory_id = ? AND l.revision = ?\n\t\t\t ORDER BY s.captured_at, s.source_id`,\n\t\t)\n\t\t.all(memoryId, revision) as unknown as SourceDbRow[];\n\treturn rows.map(mapSourceRow);\n}\n\n/**\n * 取引用了某来源的全部记忆修订（删除预览/影响面查询用）。\n * 返回 memoryId+revision 对；同一来源可跨多条记忆、多条修订被引用。\n */\nexport function revisionsForSource(db: DatabaseSync, sourceId: string): Array<{ memoryId: string; revision: number }> {\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT memory_id, revision FROM memory_source_links\n\t\t\t WHERE source_id = ?\n\t\t\t ORDER BY memory_id, revision`,\n\t\t)\n\t\t.all(sourceId) as unknown as Array<{ memory_id: string; revision: number }>;\n\treturn rows.map((row) => ({ memoryId: row.memory_id, revision: row.revision }));\n}\n\n/**\n * 取某条记忆全部修订引用过的去重来源列表（getMemory 的 sourceSummaries 用）。\n * 返回 sources 行；links 指向但 sources 已缺的 sourceId 单独列进 missing。\n */\nexport function sourcesForMemory(db: DatabaseSync, memoryId: string): { sources: SourceRow[]; missing: string[] } {\n\tconst rows = db\n\t\t.prepare(\n\t\t\t`SELECT DISTINCT s.source_id, s.session_id, s.entry_id, s.event_type, s.project_id, s.task_id,\n\t\t\t        s.location, s.segment_id, s.captured_at\n\t\t\t FROM memory_source_links l\n\t\t\t JOIN sources s ON s.source_id = l.source_id\n\t\t\t WHERE l.memory_id = ?\n\t\t\t ORDER BY s.captured_at, s.source_id`,\n\t\t)\n\t\t.all(memoryId) as unknown as SourceDbRow[];\n\tconst missingRows = db\n\t\t.prepare(\n\t\t\t`SELECT DISTINCT l.source_id FROM memory_source_links l\n\t\t\t LEFT JOIN sources s ON s.source_id = l.source_id\n\t\t\t WHERE l.memory_id = ? AND s.source_id IS NULL`,\n\t\t)\n\t\t.all(memoryId) as unknown as Array<{ source_id: string }>;\n\treturn {\n\t\tsources: rows.map(mapSourceRow),\n\t\tmissing: missingRows.map((row) => row.source_id),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// source_exclusions 查询（S2：提交前核对）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 查询某来源是否已被排除（source_exclusions 有记录）。\n *\n * 两种查法：\n * - 按 sourceId 精确查；\n * - 按 sessionId + entryId 查（删除时按这两个字段记排除，未必有 sourceId）。\n * 命中即排除，供提交前核对与采集侧可选过滤。\n *\n * 注意：本函数是写路径核对语义（任一排除记录命中即排除），不区分 memory_id；\n * 查询/展开的「来源整体不可用」判定用 isSourceGloballyExcluded。\n */\nexport function isSourceExcluded(\n\tdb: DatabaseSync,\n\ttarget: { sourceId: string } | { sessionId: string; entryId: string },\n): boolean {\n\tif (\"sourceId\" in target) {\n\t\treturn (\n\t\t\tdb.prepare(`SELECT 1 AS ok FROM source_exclusions WHERE source_id = ? LIMIT 1`).get(target.sourceId) !==\n\t\t\tundefined\n\t\t);\n\t}\n\treturn (\n\t\tdb\n\t\t\t.prepare(`SELECT 1 AS ok FROM source_exclusions WHERE session_id = ? AND entry_id = ? LIMIT 1`)\n\t\t\t.get(target.sessionId, target.entryId) !== undefined\n\t);\n}\n\n/**\n * O05 修复：source_exclusions 是否带 memory_id 列（S0-S3 旧库没有）。\n * 查询路径只读不改 schema；无列时全部排除记录按全局来源排除处理。\n */\nfunction sourceExclusionsHaveMemoryId(db: DatabaseSync): boolean {\n\tconst columns = db.prepare(\"PRAGMA table_info(source_exclusions)\").all() as unknown as Array<{ name: string }>;\n\treturn columns.some((column) => column.name === \"memory_id\");\n}\n\n/**\n * 「来源整体不可用」的 SQL 片段（NOT EXISTS 形式），`s` 为候选 sources 行别名。\n *\n * 区分两类排除记录：\n * - `memory_id IS NULL` → 全局来源排除，整体隐藏；\n * - `memory_id` 非空 → 仅「该被删记忆」的引用标记；来源仍被其他有效（未删）记忆\n *   引用时不算整体排除。仅当来源不再被任何其他有效记忆引用时才隐藏。\n * 无 memory_id 列的旧库按全局排除处理（任一命中即隐藏）。\n */\nexport function sourceGlobalExclusionSql(hasMemoryId: boolean): string {\n\tconst perMemoryGuard = hasMemoryId\n\t\t? `(e.memory_id IS NULL OR NOT EXISTS (\n\t\t     SELECT 1 FROM memory_source_links l2\n\t\t     JOIN memories m2 ON m2.id = l2.memory_id\n\t\t     WHERE l2.source_id = s.source_id AND l2.memory_id <> e.memory_id))`\n\t\t: \"1 = 1\";\n\treturn `NOT EXISTS (\n\t  SELECT 1 FROM source_exclusions e\n\t  WHERE (e.source_id = s.source_id OR (e.session_id = s.session_id AND e.entry_id = s.entry_id))\n\t    AND ${perMemoryGuard}\n\t)`;\n}\n\n/** 供 source-fts 在候选 LIMIT 前下推排除判定时做列守卫。 */\nexport function sourceExclusionsMemoryIdColumn(db: DatabaseSync): boolean {\n\treturn sourceExclusionsHaveMemoryId(db);\n}\n\n/**\n * 来源整体排除判定（查询/展开可见性口径，与 sourceGlobalExclusionSql 同一语义）：\n * 全局排除（memory_id IS NULL）或不再被任何其他有效记忆引用时返回 true。\n * 仍有其他有效记忆引用的保留来源返回 false——共享保留是既有删除契约。\n */\nexport function isSourceGloballyExcluded(\n\tdb: DatabaseSync,\n\ttarget: { sourceId: string } | { sessionId: string; entryId: string },\n): boolean {\n\tif (!sourceExclusionsHaveMemoryId(db)) return isSourceExcluded(db, target);\n\tconst rows = (\n\t\t\"sourceId\" in target\n\t\t\t? (() => {\n\t\t\t\t\tconst direct = db\n\t\t\t\t\t\t.prepare(`SELECT memory_id FROM source_exclusions WHERE source_id = ?`)\n\t\t\t\t\t\t.all(target.sourceId) as unknown as Array<{ memory_id: string | null }>;\n\t\t\t\t\tconst source = getSource(db, target.sourceId);\n\t\t\t\t\tconst byEntry = source\n\t\t\t\t\t\t? (db\n\t\t\t\t\t\t\t\t.prepare(`SELECT memory_id FROM source_exclusions WHERE session_id = ? AND entry_id = ?`)\n\t\t\t\t\t\t\t\t.all(source.sessionId, source.entryId) as unknown as Array<{ memory_id: string | null }>)\n\t\t\t\t\t\t: [];\n\t\t\t\t\treturn [...direct, ...byEntry].map((row) => ({\n\t\t\t\t\t\tmemory_id: row.memory_id,\n\t\t\t\t\t\tsourceIds: [target.sourceId],\n\t\t\t\t\t}));\n\t\t\t\t})()\n\t\t\t: (\n\t\t\t\t\tdb\n\t\t\t\t\t\t.prepare(`SELECT memory_id, source_id FROM source_exclusions WHERE session_id = ? AND entry_id = ?`)\n\t\t\t\t\t\t.all(target.sessionId, target.entryId) as unknown as Array<{\n\t\t\t\t\t\tmemory_id: string | null;\n\t\t\t\t\t\tsource_id: string | null;\n\t\t\t\t\t}>\n\t\t\t\t).map((row) => ({\n\t\t\t\t\tmemory_id: row.memory_id,\n\t\t\t\t\tsourceIds:\n\t\t\t\t\t\trow.source_id === null\n\t\t\t\t\t\t\t? (\n\t\t\t\t\t\t\t\t\tdb\n\t\t\t\t\t\t\t\t\t\t.prepare(`SELECT source_id FROM sources WHERE session_id = ? AND entry_id = ?`)\n\t\t\t\t\t\t\t\t\t\t.all(target.sessionId, target.entryId) as unknown as Array<{ source_id: string }>\n\t\t\t\t\t\t\t\t).map((r) => r.source_id)\n\t\t\t\t\t\t\t: [row.source_id],\n\t\t\t\t}))\n\t);\n\tfor (const row of rows) {\n\t\tif (row.memory_id === null) return true;\n\t\t// 该记忆已删的引用标记：来源仍被其他有效记忆引用则不算整体排除。\n\t\tconst stillReferenced = row.sourceIds.some(\n\t\t\t(sourceId) =>\n\t\t\t\tdb\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`SELECT 1 AS ok FROM memory_source_links l\n\t\t\t\t\t\t JOIN memories m ON m.id = l.memory_id\n\t\t\t\t\t\t WHERE l.source_id = ? AND l.memory_id <> ? LIMIT 1`,\n\t\t\t\t\t)\n\t\t\t\t\t.get(sourceId, row.memory_id) !== undefined,\n\t\t);\n\t\tif (!stillReferenced) return true;\n\t}\n\treturn false;\n}\n\n/**\n * 列出已被排除的来源 ID。\n *\n * 有 sessionId 时只返该会话的排除项；无则返全部。\n * 返回 source_id 非空的排除记录（sessionId+entryId 形式的排除不返 source_id）。\n */\nexport function listExcludedSourceIds(db: DatabaseSync, sessionId?: string): string[] {\n\tconst rows = (sessionId === undefined\n\t\t? db.prepare(`SELECT source_id FROM source_exclusions WHERE source_id IS NOT NULL`).all()\n\t\t: db\n\t\t\t\t.prepare(`SELECT source_id FROM source_exclusions WHERE source_id IS NOT NULL AND session_id = ?`)\n\t\t\t\t.all(sessionId)) as unknown as Array<{ source_id: string }>;\n\treturn rows.map((row) => row.source_id);\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\r\n * 内置记忆供应商（builtin）的三工具接线（S1-14）。\r\n *\rimport { Type } from \"typebox\";\r\nimport type { ExtensionAPI, ExtensionContext, ToolDefinition } from \"../../core/extensions/types.ts\";\r\nimport type { SessionMessageEntry } from \"../../core/session-manager.ts\";\r\nimport { createMemoryBackuplistTaskBindings, parseArchiveJobScopeswitchTaskResourceAtSafePoint } from \"../evolutionbackup.tsbinding.ts\";type CaptureHandle, createCapture, registerCaptureproposeCandidatecapture.tsevolution/candidates.tsregisterContextUsagerecordUsedcontext-usage.tsobserve.tsregisterExtractionSchedulerclassifyProblem, declareImprovementIntentextraction-scheduler.tsevolution/problems.tsrunOrganizeMaintenancehandleRegressionorganize.tsevolution/regression.tsextractIndexableTextgetResourcesource-fts.tsresources.tsselectImprovement } from \"../evolution/problems.tsselect.tsfreezeValidationPlanvalidation.tscreateMemoryBackup, parseArchiveJobScoperegression.tsregisterCaptureevolution/binding.ts/evolution\r\n\ttypeMaintenanceHandler,\r\n\ttypeMaintenanceSchedulerHandle,\r\n\tregisterMaintenanceScheduler,\r\n} from \".maintenance.ts{ MemoryHitmemory-vendor.ts} from \"./resolveMemoryScope } from \"./project-vendor.tsidentity.tsrequestIdFor-identity.ts\";embedCurrentMemories, openPersistentMemoryLedger, resolveMemoryOutboundContextruntimeembedding.tsopenMem