projectRoot: input.projectRoot,\n\t\t\tmemoryService: service,\n\t\t\tdecision: {\n\t\t\t\tsourceKind: \"explicit_user_decision\",\n\t\t\t\tuserId: input.userId.trim(),\n\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\tconclusion,\n\t\t\t\t...(input.conditions === undefined ? {} : { conditions: input.conditions }),\n\t\t\t\t...(input.rationale === undefined ? {} : { rationale: input.rationale }),\n\t\t\t\tdecidedAt: pageSource.source.capturedAt,\n\t\t\t},\n\t\t\tformalDocuments,\n\t\t\t...(stageDescriptionSource === undefined ? {} : { stageDescriptionSource }),\n\t\t}),\n\t);\n}\n\n/** 按 operationId 读取持久删除计划；目标记忆已删除后仍可校验 projectIds。 */\nexport async function readDesktopMemoryDeletionOperation(\n\tinput: ReadDesktopMemoryDeletionOperationInput,\n): Promise<MemoryResult<DeletionOperationDto>> {\n\tif (typeof input.operationId !== \"string\" || input.operationId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"operationId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(input.home, \"readonly\", (service) =>\n\t\tservice.readDeletionOperation({ operationId: input.operationId }),\n\t);\n}\n\n/** 按 operationId 续作删除；仅宿主可信层可传入会话生命周期协调器。 */\nexport async function resumeDesktopMemoryDeletion(\n\tinput: ResumeDesktopMemoryDeletionInput,\n\ttrustedDeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<MemoryResult<DeleteMemoryResult>> {\n\tif (typeof input.operationId !== \"string\" || input.operationId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"operationId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(\n\t\tinput.home,\n\t\t\"readwrite\",\n\t\t(service) => service.resumeDeletion({ operationId: input.operationId }),\n\t\ttrustedDeletionCoordinator,\n\t);\n}\n\n/**\n * 来源回读：按 sourceId 回读原文事件。\n * 返回结构化事件数组（页面逐条渲染）；来源行/段缺失时 missing=true 不伪造内容。\n */\nexport async function readDesktopMemorySource(\n\tinput: ReadDesktopMemorySourceInput,\n): Promise<MemoryResult<ReadDesktopMemorySourceResult>> {\n\tif (typeof input.sourceId !== \"string\" || input.sourceId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"sourceId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.entryId !== undefined && input.entryId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"entryId 不能为空\", refId: input.sourceId },\n\t\t};\n\t}\n\tif ((input.memoryId === undefined) !== (input.revision === undefined)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"memoryId 与 revision 必须同时提供\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.memoryId !== undefined && input.memoryId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"memoryId 不能为空\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.revision !== undefined && (!Number.isInteger(input.revision) || input.revision < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"revision 必须是正整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.offset !== undefined && !Number.isInteger(input.offset)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"offset 必须是整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.limit !== undefined && (!Number.isInteger(input.limit) || input.limit < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"limit 必须是正整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tconst offset = input.offset ?? 0;\n\tconst limit = Math.min(200, input.limit ?? 50);\n\tconst missingResult = (): MemoryResult<ReadDesktopMemorySourceResult> => ({\n\t\tok: true,\n\t\tevents: [],\n\t\tmetadata: {\n\t\t\tsourceId: input.sourceId,\n\t\t\tsessionId: \"\",\n\t\t\tentryId: input.entryId ?? \"\",\n\t\t\teventType: \"\",\n\t\t\tsegmentId: \"\",\n\t\t\teventCount: 0,\n\t\t},\n\t\tavailable: false,\n\t\tmissing: true,\n\t\thasMore: false,\n\t});\n\tif (!databaseExists(input.home)) {\n\t\t// 库未建：来源必然不存在，按 missing 如实渲染（不伪造内容）。\n\t\treturn missingResult();\n\t}\n\tconst recordExpand = input.memoryId !== undefined && input.revision !== undefined;\n\treturn withService(input.home, recordExpand ? \"readwrite\" : \"readonly\", async (service) => {\n\t\tconst result = await service.readMemorySource({\n\t\t\tsourceId: input.sourceId,\n\t\t\t...(input.entryId === undefined ? {} : { entryId: input.entryId }),\n\t\t\toffset,\n\t\t\tlimit,\n\t\t});\n\t\tif (!result.ok) {\n\t\t\t// source_missing 走业务错误通道；页面按 missing 渲染不拿空内容冒充。\n\t\t\tif (result.error.code === \"source_missing\") {\n\t\t\t\treturn missingResult();\n\t\t\t}\n\t\t\treturn result as MemoryResult<ReadDesktopMemorySourceResult>;\n\t\t}\n\t\t// content 是 service 侧 JSONL 字符串（一行一事件）；解析回结构化数组给页面。\n\t\tconst events = result.content\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((line) => line.length > 0)\n\t\t\t.map((line) => JSON.parse(line) as ArchivedEvent);\n\t\tconst response: MemoryResult<ReadDesktopMemorySourceResult> = {\n\t\t\tok: true,\n\t\t\tevents,\n\t\t\tmetadata: {\n\t\t\t\tsourceId: result.sourceId,\n\t\t\t\tsessionId: result.sessionId,\n\t\t\t\tentryId: result.entryId,\n\t\t\t\teventType: result.eventType,\n\t\t\t\tsegmentId: result.segmentId ?? \"\",\n\t\t\t\tlineNo: (result.metadata.lineNo as number | undefined) ?? undefined,\n\t\t\t\tstartLine: result.startLine,\n\t\t\t\tendLine: result.endLine,\n\t\t\t\teventCount: events.length,\n\t\t\t},\n\t\t\tavailable: true,\n\t\t\tmissing: false,\n\t\t\tarchived: result.archived,\n\t\t\t...(result.segmentId === undefined ? {} : { segmentId: result.segmentId }),\n\t\t\thasMore: result.hasMore,\n\t\t\t...(result.nextOffset === undefined ? {} : { nextOffset: result.nextOffset }),\n\t\t};\n\t\tif (recordExpand && events.length > 0) {\n\t\t\ttry {\n\t\t\t\tconst memory = await service.getMemory({\n\t\t\t\t\tid: input.memoryId!,\n\t\t\t\t\trevision: input.revision!,\n\t\t\t\t});\n\t\t\t\tif (memory.ok && memory.sourceSummaries.some((source) => source.sourceId === input.sourceId)) {\n\t\t\t\t\tawait service.recordMemoryUsage({\n\t\t\t\t\t\taction: \"expand\",\n\t\t\t\t\t\tmemoryId: input.memoryId!,\n\t\t\t\t\t\trevision: input.revision!,\n\t\t\t\t\t\trequestId: randomUUID(),\n\t\t\t\t\t\t...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),\n\t\t\t\t\t\t...(input.taskId === undefined ? {} : { taskId: input.taskId }),\n\t\t\t\t\t\tusageRef: input.sourceId,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 使用计数是增益；原文已经成功回读，不因记账故障把页面回读判失败。\n\t\t\t}\n\t\t}\n\t\treturn response;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. S7-10：运行与用量三读桥（纯 DTO，不返回句柄/函数/Map）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 整理状态（memory-activity）：列出本 home 全部记忆作业，\n * 状态直接来自 extraction_jobs 队列，含失败原因与关联会话/任务。\n */\nexport interface ReadDesktopMemoryMaintenanceInput extends DesktopMemoryHomeInput {\n\t/** 限定类别；缺省全部（extract/embed/organize/archive）。 */\n\tkind?: string;\n}\n\nexport interface DesktopMemoryMaintenanceJob {\n\tjobId: string;\n\tjobKind: string;\n\tstatus: string;\n\tscopeKey: string;\n\tsourceScope: string;\n\tcursor?: string;\n\tattemptCount: number;\n\tlastError?: string;\n\townerProcess?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n\t/** 来源会话（source_scope JSON 里的 sessionId，能解析到时）。 */\n\tsourceSessionId?: string;\n\t/** 来源任务（source_scope JSON 里的 taskId，能解析到时）。 */\n\ttaskId?: string;\n}\n\nexport interface ReadDesktopMemoryMaintenanceResult {\n\titems: DesktopMemoryMaintenanceJob[];\n\t/** 队列摘要计数。 */\n\tcounts: { pending: number; running: number; done: number; failed: number };\n}\n\n/**\n * 读取本 home 的记忆维护作业队列。\n * 库未建返回空队列（新装桌面没有库也应显示空态）。\n */\nexport async function readDesktopMemoryMaintenance(\n\tinput: ReadDesktopMemoryMaintenanceInput,\n): Promise<MemoryResult<ReadDesktopMemoryMaintenanceResult>> {\n\tconst empty: ReadDesktopMemoryMaintenanceResult = {\n\t\titems: [],\n\t\tcounts: { pending: 0, running: 0, done: 0, failed: 0 },\n\t};\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, ...empty };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions: string[] = [];\n\t\tconst params: string[] = [];\n\t\tif (input.kind !== undefined) {\n\t\t\tconditions.push(\"job_kind = ?\");\n\t\t\tparams.push(input.kind);\n\t\t}\n\t\tconst where = conditions.length > 0 ? `WHERE ${conditions.join(\" AND \")}` : \"\";\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\t\t\tlast_error, owner_process, created_at, updated_at\n\t\t\t\t FROM extraction_jobs ${where}\n\t\t\t\t ORDER BY updated_at DESC, job_id`,\n\t\t\t)\n\t\t\t.all(...params) as unknown as Array<{\n\t\t\tjob_id: string;\n\t\t\tjob_kind: string;\n\t\t\tsource_scope: string;\n\t\t\tscope_key: string;\n\t\t\tstatus: string;\n\t\t\tcursor: string | null;\n\t\t\tattempt_count: number;\n\t\t\tlast_error: string | null;\n\t\t\towner_process: string | null;\n\t\t\tcreated_at: string;\n\t\t\tupdated_at: string;\n\t\t}>;\n\t\tconst counts = { pending: 0, running: 0, done: 0, failed: 0 };\n\t\tconst items = rows.map((row) => {\n\t\t\tif (row.status in counts) counts[row.status as keyof typeof counts] += 1;\n\t\t\tlet sourceSessionId: string | undefined;\n\t\t\tlet taskId: string | undefined;\n\t\t\ttry {\n\t\t\t\tconst parsed = JSON.parse(row.source_scope) as Record<string, unknown>;\n\t\t\t\tif (typeof parsed.sessionId === \"string\") sourceSessionId = parsed.sessionId;\n\t\t\t\tif (typeof parsed.taskId === \"string\") taskId = parsed.taskId;\n\t\t\t} catch {\n\t\t\t\t// source_scope 非 JSON（自定义 scopeKey）：不带会话/任务关联。\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tjobId: row.job_id,\n\t\t\t\tjobKind: row.job_kind,\n\t\t\t\tstatus: row.status,\n\t\t\t\tscopeKey: row.scope_key,\n\t\t\t\tsourceScope: row.source_scope,\n\t\t\t\t...(row.cursor === null ? {} : { cursor: row.cursor }),\n\t\t\t\tattemptCount: row.attempt_count,\n\t\t\t\t...(row.last_error === null ? {} : { lastError: row.last_error }),\n\t\t\t\t...(row.owner_process === null ? {} : { ownerProcess: row.owner_process }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tupdatedAt: row.updated_at,\n\t\t\t\t...(sourceSessionId === undefined ? {} : { sourceSessionId }),\n\t\t\t\t...(taskId === undefined ? {} : { taskId }),\n\t\t\t};\n\t\t});\n\t\treturn { ok: true, items, counts };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ── readDesktopTaskMemoryCost ─────────────────────────────────────────────\n\nexport interface ReadDesktopTaskMemoryCostInput extends DesktopMemoryHomeInput {\n\t/** 限定来源任务；缺省该 home 全部后台用量。 */\n\ttaskId?: string;\n\t/** 限定来源会话。 */\n\tsourceSessionId?: string;\n\t/** 限定后台 jobId。 */\n\tjobId?: string;\n}\n\nexport interface ReadDesktopTaskMemoryCostResult {\n\t/** 按用途（kind）分组的合计：提炼/嵌入/规整/归档。 */\n\tbyPurpose: Array<{\n\t\tpurpose: string;\n\t\trequestCount: number;\n\t\tknownTokens: number;\n\t\tknownCost?: number;\n\t\tunknownCount: number;\n\t}>;\n\t/** 去重后的逐请求明细。 */\n\tentries: Array<{\n\t\tjobId: string;\n\t\tpurpose: string;\n\t\trequestId?: string;\n\t\tsourceSessionId?: string;\n\t\ttaskId?: string;\n\t\tprovider: string;\n\t\tmodel: string;\n\t\tinputTokens: number;\n\t\toutputTokens: number;\n\t\tcacheReadTokens: number;\n\t\tcacheWriteTokens: number;\n\t\ttotalTokens: number;\n\t\tcost?: number;\n\t\ttimestamp: string;\n\t}>;\n\t/** 全量合计；unknownCount 计 usage.totalTokens=0 或 cost 未返回的条目。 */\n\ttotal: {\n\t\trequestCount: number;\n\t\tknownTokens: number;\n\t\tknownCost?: number;\n\t\tunknownCount: number;\n\t};\n}\n\n/**\n * 任务用量（memory-task-usage）：按用途分组 + 去重请求明细 + 已知/未知费用。\n * 不返回 store/ledger 句柄，只给可 JSON 序列化的合计与明细。\n */\nexport async function readDesktopTaskMemoryCost(\n\tinput: ReadDesktopTaskMemoryCostInput,\n): Promise<MemoryResult<ReadDesktopTaskMemoryCostResult>> {\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tbyPurpose: [],\n\t\t\tentries: [],\n\t\t\ttotal: { requestCount: 0, knownTokens: 0, unknownCount: 0 },\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst result = readMemoryUsage(store, {\n\t\t\tpaoHome: input.home,\n\t\t\t...(input.taskId === undefined ? {} : { taskId: input.taskId }),\n\t\t\t...(input.sourceSessionId === undefined ? {} : { sourceSessionId: input.sourceSessionId }),\n\t\t\t...(input.jobId === undefined ? {} : { jobId: input.jobId }),\n\t\t});\n\t\t// O14：用途分组在内核聚合一次返回——本层只做 DTO 映射，不再重复\n\t\t// known/unknown 判定（与 byJob 同一聚合点，F09 单一口径）。\n\t\tconst entries = result.entries.map((entry) => ({\n\t\t\tjobId: entry.jobId,\n\t\t\tpurpose: entry.kind,\n\t\t\t...(entry.requestId === undefined ? {} : { requestId: entry.requestId }),\n\t\t\t...(entry.sourceSessionId === undefined ? {} : { sourceSessionId: entry.sourceSessionId }),\n\t\t\t...(entry.taskId === undefined ? {} : { taskId: entry.taskId }),\n\t\t\tprovider: entry.provider,\n\t\t\tmodel: entry.model,\n\t\t\tinputTokens: entry.usage.input,\n\t\t\toutputTokens: entry.usage.output,\n\t\t\tcacheReadTokens: entry.usage.cacheRead,\n\t\t\tcacheWriteTokens: entry.usage.cacheWrite,\n\t\t\ttotalTokens: entry.usage.totalTokens,\n\t\t\t...(entry.usage.cost?.total === undefined ? {} : { cost: entry.usage.cost.total }),\n\t\t\ttimestamp: entry.timestamp,\n\t\t}));\n\t\treturn {\n\t\t\tok: true,\n\t\t\tbyPurpose: result.byPurpose.map((bucket) => ({\n\t\t\t\tpurpose: bucket.purpose,\n\t\t\t\trequestCount: bucket.requestCount,\n\t\t\t\tknownTokens: bucket.knownTokens,\n\t\t\t\t...(bucket.knownCost === undefined ? {} : { knownCost: bucket.knownCost }),\n\t\t\t\tunknownCount: bucket.unknownCount,\n\t\t\t})),\n\t\t\tentries,\n\t\t\ttotal: {\n\t\t\t\trequestCount: result.entries.length,\n\t\t\t\tknownTokens: result.total.totalTokens,\n\t\t\t\t...(result.total.cost === undefined ? {} : { knownCost: result.total.cost }),\n\t\t\t\tunknownCount: result.total.unknownCount,\n\t\t\t},\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ── readDesktopContextUsage ───────────────────────────────────────────────\n\nexport interface ReadDesktopContextUsageInput extends DesktopMemoryHomeInput {\n\t/** 必给：按 requestId 回读单条快照。 */\n\trequestId?: string;\n\t/** 限定会话（配合 requestId 缩小扫描；单 requestId 时可省略）。 */\n\tsessionId?: string;\n\t/** 列最近 N 条快照（requestId 缺省时；缺省 20，上限 100）。 */\n\tlimit?: number;\n}\n\nexport interface DesktopContextUsageItem {\n\trequestId: string;\n\tsessionId: string;\n\ttaskId?: string;\n\tsampledAt: string;\n\testimateMethod: string;\n\tbyCategory: Record<string, number>;\n\testimatedTotal: number;\n\tmessageCount: number;\n\tunestimated: Array<{ kind: string; note: string; messageIndexes: number[] }>;\n\tnotes: string[];\n\t/** 旁列：同会话里该请求相邻的真实供应商 usage（能找到时）。 */\n\tactual?: {\n\t\tinputTokens: number;\n\t\toutputTokens: number;\n\t\tcacheReadTokens: number;\n\t\tcacheWriteTokens: number;\n\t\ttotalTokens: number;\n\t\tcost?: number;\n\t};\n}\n\nexport interface ReadDesktopContextUsageResult {\n\titems: DesktopContextUsageItem[];\n\t/** 按 requestId 单查且未命中时 true——页面显示「尚无该请求记录」。 */\n\tnotFound?: boolean;\n}\n\n/**\n * 上下文用量（memory-context-usage）：按 requestId 或最近若干条读会话\n * `pao-context-usage` custom entry；旁列同会话相邻真实 usage 条目。\n *\n * 会话文件扫描：遍历 `<home>/agent/sessions/<cwd-encoded>/*.jsonl`，\n * 逐会话读 entries 找 customType===\"pao-context-usage\" 的条目。\n * 正常请求不为生成统计额外调用模型——本函数只读已落库的会话文件。\n */\nexport async function readDesktopContextUsage(\n\tinput: ReadDesktopContextUsageInput,\n): Promise<MemoryResult<ReadDesktopContextUsageResult>> {\n\tconst sessionsRoot = join(input.home, \"agent\", \"sessions\");\n\tconst limit = Math.min(100, Math.max(1, input.limit ?? 20));\n\tconst items: DesktopContextUsageItem[] = [];\n\tif (!existsSync(sessionsRoot)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: [],\n\t\t\t...(input.requestId === undefined ? {} : { notFound: true }),\n\t\t};\n\t}\n\n\t// 收集全部会话文件（每个 cwd-encoded 子目录下的 *.jsonl），并按文件\n\t// mtime 降序先选候选：O14 修复——原按目录枚举顺序扫到 limit 即停，目录序\n\t// 靠后的较新会话可能被整批跳过；现在「先取 mtime 最近的候选再逐文件读」，\n\t// limit 名单按文件新鲜度排定，不把较新会话漏在窗口外。\n\tconst sessionFiles: Array<{ path: string; mtimeMs: number }> = [];\n\tfor (const dir of readdirSync(sessionsRoot, { withFileTypes: true })) {\n\t\tif (!dir.isDirectory()) continue;\n\t\tconst sub = join(sessionsRoot, dir.name);\n\t\tfor (const file of readdirSync(sub)) {\n\t\t\tif (!file.endsWith(\".jsonl\")) continue;\n\t\t\tconst full = join(sub, file);\n\t\t\tlet mtimeMs = 0;\n\t\t\ttry {\n\t\t\t\tmtimeMs = statSync(full).mtimeMs;\n\t\t\t} catch {\n\t\t\t\t// 读不到时间的文件按最旧处理——不阻止其余文件进候选。\n\t\t\t}\n\t\t\tsessionFiles.push({ path: full, mtimeMs });\n\t\t}\n\t}\n\tsessionFiles.sort((a, b) => b.mtimeMs - a.mtimeMs);\n\t// requestId 单查不受 limit 候选窗口约束（须全量找），否则只读最近文件\n\t// 候选再逐条解析——文件内 sampledAt 排序在收集后统一截断。\n\tconst candidates =\n\t\tinput.requestId === undefined ? sessionFiles.slice(0, Math.max(limit, 1)) : sessionFiles;\n\n\tfor (const { path: filePath } of candidates) {\n\t\tif (items.length >= limit && input.requestId === undefined) break;\n\t\tlet ledger: SessionManager;\n\t\ttry {\n\t\t\tledger = SessionManager.open(filePath);\n\t\t} catch {\n\t\t\tcontinue; // 坏文件跳过，不炸整个查询。\n\t\t}\n\t\tconst entries = ledger.getEntries();\n\t\t// 同会话的真实 usage 条目（type===\"usage\"），按时间序用于旁列匹配。\n\t\tconst usageEntries = entries.filter((e) => e.type === \"usage\");\n\t\t// requestId → assistant 实际用量（turn_end 由 context-usage 扩展落库；\n\t\t// 普通前台请求没有 usage entry 可兜底，靠这条关联命中）。\n\t\tconst actualByRequest = new Map<string, Usage>();\n\t\tfor (const entry of entries) {\n\t\t\tif (entry.type !== \"custom\") continue;\n\t\t\tconst custom = entry as { customType?: string; data?: unknown };\n\t\t\tif (custom.customType !== \"pao-request-usage\") continue;\n\t\t\tconst data = custom.data as { requestId?: unknown; usage?: Usage } | undefined;\n\t\t\tif (typeof data?.requestId === \"string\" && data.usage !== undefined) {\n\t\t\t\tactualByRequest.set(data.requestId, data.usage);\n\t\t\t}\n\t\t}\n\t\tfor (const entry of entries) {\n\t\t\tif (entry.type !== \"custom\") continue;\n\t\t\tconst custom = entry as { customType?: string; data?: unknown };\n\t\t\tif (custom.customType !== \"pao-context-usage\") continue;\n\t\t\tconst snapshot = custom.data as ContextUsageSnapshot | undefined;\n\t\t\tif (snapshot === undefined || typeof snapshot.requestId !== \"string\") continue;\n\t\t\tif (input.requestId !== undefined && snapshot.requestId !== input.requestId) continue;\n\t\t\tif (input.sessionId !== undefined && snapshot.sessionId !== input.sessionId) continue;\n\t\t\t// 旁列真实 usage：优先 requestId 直接关联（pao-request-usage，\n\t\t\t// turn_end 落库的 assistant 实际用量）；查不到回退 note 子串匹配\n\t\t\t// （后台任务把 requestId 写进 usage note 的既有路径）。\n\t\t\tconst actualUsage =\n\t\t\t\tactualByRequest.get(snapshot.requestId) ??\n\t\t\t\t(usageEntries.find((u) => {\n\t\t\t\t\tconst note = (u as { note?: string }).note ?? \"\";\n\t\t\t\t\treturn note.includes(snapshot.requestId);\n\t\t\t\t}) as { usage?: Usage } | undefined)?.usage;\n\t\t\titems.push({\n\t\t\t\trequestId: snapshot.requestId,\n\t\t\t\tsessionId: snapshot.sessionId,\n\t\t\t\t...(snapshot.taskId === undefined ? {} : { taskId: snapshot.taskId }),\n\t\t\t\tsampledAt: snapshot.sampledAt,\n\t\t\t\testimateMethod: snapshot.estimateMethod,\n\t\t\t\tbyCategory: snapshot.byCategory as Record<string, number>,\n\t\t\t\testimatedTotal: snapshot.estimatedTotal,\n\t\t\t\tmessageCount: snapshot.messageCount,\n\t\t\t\tunestimated: (snapshot.unestimated ?? []).map((u) => ({\n\t\t\t\t\tkind: u.kind,\n\t\t\t\t\tnote: u.note,\n\t\t\t\t\tmessageIndexes: u.messageIndexes,\n\t\t\t\t})),\n\t\t\t\tnotes: snapshot.notes ?? [],\n\t\t\t\t...(actualUsage === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: {\n\t\t\t\t\t\t\tactual: {\n\t\t\t\t\t\t\t\tinputTokens: actualUsage.input ?? 0,\n\t\t\t\t\t\t\t\toutputTokens: actualUsage.output ?? 0,\n\t\t\t\t\t\t\t\tcacheReadTokens: actualUsage.cacheRead ?? 0,\n\t\t\t\t\t\t\t\tcacheWriteTokens: actualUsage.cacheWrite ?? 0,\n\t\t\t\t\t\t\t\ttotalTokens: actualUsage.totalTokens ?? 0,\n\t\t\t\t\t\t\t\t...(actualUsage.cost?.total === undefined ? {} : { cost: actualUsage.cost.total }),\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t}),\n\t\t\t});\n\t\t}\n\t}\n\n\t// 按采样时间倒序。\n\titems.sort((a, b) => (a.sampledAt < b.sampledAt ? 1 : a.sampledAt > b.sampledAt ? -1 : 0));\n\treturn {\n\t\tok: true,\n\t\titems: items.slice(0, limit),\n\t\t...(input.requestId !== undefined && items.length === 0 ? { notFound: true } : {}),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. usageSummary 聚合（detail 用；服务不暴露 db，本层经既有内部接口读库）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按 memory_usage 表聚合某记忆的 search/inject/expand/used 计数。\n * 库内读只在本层做——桌面详情页要「这条被参考过几次」，\n * service 现有接口没有 usage 聚合，故在桌面桥层读（不经 SQL 字符串拼接，参数化）。\n */\nfunction countMemoryUsage(\n\thome: string,\n\tmemoryId: string,\n): { search: number; inject: number; expand: number; used: number } {\n\tconst counts = { search: 0, inject: 0, expand: 0, used: 0 };\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT action, COUNT(*) AS n FROM memory_usage\n\t\t\t\t WHERE memory_id = ? GROUP BY action`,\n\t\t\t)\n\t\t\t.all(memoryId) as unknown as Array<{ action: string; n: number }>;\n\t\tfor (const row of rows) {\n\t\t\tif (row.action === \"search\") counts.search = row.n;\n\t\t\telse if (row.action === \"inject\") counts.inject = row.n;\n\t\t\telse if (row.action === \"expand\") counts.expand = row.n;\n\t\t\telse if (row.action === \"used\") counts.used = row.n;\n\t\t}\n\t} finally {\n\t\tstore.close();\n\t}\n\treturn counts;\n}\n\n/**\n * 召回命中 → MemoryListItem：批量取 createdAt/updatedAt/mergedInto。\n * 一次 SQL 查全部命中（不逐条 getMemory）。\n */\nasync function hydrateListItems(home: string, hits: SearchMemoryResult[\"hits\"]): Promise<MemoryListItem[]> {\n\tif (hits.length === 0) return [];\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst meta = new Map<string, { created_at: string; updated_at: string; merged_into: string | null }>();\n\t\tconst stmt = store.db.prepare(\"SELECT created_at, updated_at, merged_into FROM memories WHERE id = ?\");\n\t\tfor (const hit of hits) {\n\t\t\tconst row = stmt.get(hit.memoryId) as\n\t\t\t\t| { created_at: string; updated_at: string; merged_into: string | null }\n\t\t\t\t| undefined;\n\t\t\tif (row) meta.set(hit.memoryId, row);\n\t\t}\n\t\treturn hits.map((hit) => {\n\t\t\tconst row = meta.get(hit.memoryId);\n\t\t\treturn {\n\t\t\t\tmemoryId: hit.memoryId,\n\t\t\t\trevision: hit.revision,\n\t\t\t\tkind: hit.kind,\n\t\t\t\tscope: hit.scope,\n\t\t\t\tconclusion: hit.content.conclusion,\n\t\t\t\t...(hit.content.conditions === undefined ? {} : { conditions: hit.content.conditions }),\n\t\t\t\t...(hit.content.rationale === undefined ? {} : { rationale: hit.content.rationale }),\n\t\t\t\tevidenceKind: hit.content.evidenceKind,\n\t\t\t\tconfirmation: hit.content.confirmation,\n\t\t\t\tusageState: hit.usageState,\n\t\t\t\trelevance: hit.relevance,\n\t\t\t\tmatchKind: hit.matchKind,\n\t\t\t\t...(hit.referenceOnly === undefined ? {} : { referenceOnly: hit.referenceOnly }),\n\t\t\t\t...(hit.sourceIds === undefined ? {} : { sourceIds: hit.sourceIds }),\n\t\t\t\t...(row?.merged_into ? { mergedInto: row.merged_into } : {}),\n\t\t\t\tcreatedAt: row?.created_at ?? \"\",\n\t\t\t\tupdatedAt: row?.updated_at ?? \"\",\n\t\t\t};\n\t\t});\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 空 query 列举：scope/usage/kind 过滤 + updatedAt 倒序。\n * scope 过滤复用 scope.ts 的 currentScopeFilter/historyScopeFilter（与召回同口径：\n * 同 projectId；任务粒度规则一致）。status 过滤显式传入时叠加（库内 AND）。\n */\nfunction listScopedMemoriesPage(\n\thome: string,\n\tscope: MemoryScope,\n\tmode: \"current\" | \"history\",\n\tfilter: { status?: MemoryUsageState; kind?: MemoryKind; page: number; pageSize: number },\n): { items: MemoryListItem[]; total: number } {\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst scopeFilter = historyScopeFilter(scope);\n\t\tconst conditions: string[] = [scopeFilter.where];\n\t\tconst params = [...scopeFilter.params];\n\t\tif (mode === \"current\") {\n\t\t\tconditions.push(\"m.merged_into IS NULL\");\n\t\t\tconditions.push(\"m.usage_state = ?\");\n\t\t\tparams.push(filter.status ?? \"active\");\n\t\t} else if (filter.status !== undefined) {\n\t\t\tconditions.push(\"m.usage_state = ?\");\n\t\t\tparams.push(filter.status);\n\t\t}\n\t\tif (filter.kind !== undefined) {\n\t\t\tconditions.push(\"m.kind = ?\");\n\t\t\tparams.push(filter.kind);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS total\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE ${where}`,\n\t\t\t)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, m.kind, m.scope_json, m.current_revision, m.usage_state,\n\t\t\t\t        m.merged_into, m.created_at, m.updated_at, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY m.updated_at DESC, m.id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, filter.pageSize, (filter.page - 1) * filter.pageSize) as unknown as Array<{\n\t\t\tid: string;\n\t\t\tkind: string;\n\t\t\tscope_json: string;\n\t\t\tcurrent_revision: number;\n\t\t\tusage_state: string;\n\t\t\tmerged_into: string | null;\n\t\t\tcreated_at: string;\n\t\t\tupdated_at: string;\n\t\t\tcontent_json: string;\n\t\t}>;\n\t\tconst items = rows.map((row) => {\n\t\t\tconst content = JSON.parse(row.content_json) as import(\"../memory/types.ts\").MemoryRevisionContent;\n\t\t\tconst hitScope = JSON.parse(row.scope_json) as MemoryScope;\n\t\t\treturn {\n\t\t\t\tmemoryId: row.id,\n\t\t\t\trevision: row.current_revision,\n\t\t\t\tkind: row.kind as MemoryKind,\n\t\t\t\tscope: hitScope,\n\t\t\t\tconclusion: content.conclusion,\n\t\t\t\t...(content.conditions === undefined ? {} : { conditions: content.conditions }),\n\t\t\t\t...(content.rationale === undefined ? {} : { rationale: content.rationale }),\n\t\t\t\tevidenceKind: content.evidenceKind,\n\t\t\t\tconfirmation: content.confirmation,\n\t\t\t\tusageState: row.usage_state as MemoryUsageState,\n\t\t\t\trelevance: 1,\n\t\t\t\tmatchKind: \"lexical\" as const,\n\t\t\t\tsourceIds: sourcesForRevision(store.db, row.id, row.current_revision).map((s) => s.sourceId),\n\t\t\t\t...(row.merged_into === null ? {} : { mergedInto: row.merged_into }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tupdatedAt: row.updated_at,\n\t\t\t};\n\t\t});\n\t\treturn { items, total: totalRow.total };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. S8-12：进化详情三读桥（只读 DTO；不返回句柄，不重复内核类型）\n// ════════════════════════════════════════════════════════════════════════\n\n// ── readDesktopEvolutionProblems ─────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionProblemsInput extends DesktopMemoryHomeInput {\n\tscope: DesktopMemoryScope;\n\t/** 资源类别过滤；缺省全部。 */\n\tkind?: string;\n\t/** 状态过滤；缺省全部。 */\n\tstatus?: \"observed\" | \"classified\" | \"candidate\" | \"no_change\" | \"development_suggestion\";\n\tpage?: number;\n\tpageSize?: number;\n}\n\nexport interface DesktopEvolutionProblemItem {\n\tproblemId: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpectedBehavior: string;\n\tactualBehavior: string;\n\t/** 证据引用（evidence_refs_json 解析结果；界面逐条展示 sourceId）。 */\n\tevidenceRefs: string[];\n\toccurrenceCount: number;\n\tresourceId: string | null;\n\tbaseVersion: string | null;\n\tprojectId: string | null;\n\ttaskId: string | null;\n\tsessionId: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\nexport interface ReadDesktopEvolutionProblemsResult {\n\titems: DesktopEvolutionProblemItem[];\n\ttotal: number;\n\thasMore: boolean;\n}\n\n// ── readDesktopEvolutionDetail ───────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionDetailInput extends DesktopMemoryHomeInput {\n\tproblemId: string;\n}\n\nexport interface DesktopEvolutionCandidateItem {\n\tcandidateId: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n\tdiffs: EvolutionFileDiff[];\n\trationale: string;\n\tusageRefs: string[];\n\tstatus: string;\n\tfailureReason: string | null;\n\tcreatedAt: string;\n\tupdatedAt: string;\n\t/**\n\t * O12/E13：baseVersion 文件正文（路径 → 内容），供详情页对 edit/delete\n\t * 差异做基线对照；版本目录不可读时为空对象。\n\t */\n\tbaseFiles: Record<string, string>;\n}\n\nexport interface DesktopEvolutionDetailResult {\n\tproblem: DesktopEvolutionProblemItem;\n\t/** 该问题的全部候选（含 diffs、rationale、usageRefs、status、failureReason、baseFiles）。 */\n\tcandidates: DesktopEvolutionCandidateItem[];\n\t/** 来源链接（evolution_source_links → sourceId/memoryId/revision）。 */\n\tsourceLinks: Array<{\n\t\tlinkId: string;\n\t\tsourceId: string;\n\t\tmemoryId: string | null;\n\t\trevision: number | null;\n\t}>;\n}\n\n// ── readDesktopEvolutionValidation ───────────────────────────────────────\n\nexport interface ReadDesktopEvolutionValidationInput extends DesktopMemoryHomeInput {\n\tcandidateId: string;\n}\n\nexport interface DesktopEvolutionValidationResult {\n\tvalidation: {\n\t\tvalidationId: string;\n\t\ttestPlanId: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tcaseResults: Array<{\n\t\t\tcaseId: string;\n\t\t\tgroup: string;\n\t\t\tbaseline: ValidationRunResult | null;\n\t\t\tcandidate: ValidationRunResult | null;\n\t\t\tverdict: string;\n\t\t\t/** O12/E13：该用例的完成判据（从冻结 plan.json 取；缺失时为空）。 */\n\t\t\tacceptance?: string;\n\t\t\t/**\n\t\t\t * O12/E13：该用例的运行回执文件路径（`<home>/evolution/validations/<tp>/runs/`\n\t\t\t * 下 `<caseId>-<side>-*.json`；两侧各取最新一个）。无回执时为空。\n\t\t\t */\n\t\t\treceipts?: { baseline?: string; candidate?: string };\n\t\t}>;\n\t\tverdict: string;\n\t\ttotalUsageRef: string | null;\n\t\tcreatedAt: string;\n\t} | null;\n}\n\n// ── 行映射 ────────────────────────────────────────────────────────────────\n\ninterface EvolutionProblemDbRow {\n\tproblem_id: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpected_behavior: string;\n\tactual_behavior: string;\n\tevidence_refs_json: string;\n\toccurrence_count: number;\n\tresource_id: string | null;\n\tbase_version: string | null;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsession_id: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface EvolutionCandidateDbRow {\n\tcandidate_id: string;\n\tproblem_id: string;\n\tresource_id: string;\n\tbase_version: string;\n\ttest_plan_id: string;\n\tdiffs_json: string;\n\trationale: string;\n\tusage_refs_json: string;\n\tstatus: string;\n\tfailure_reason: string | null;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface EvolutionValidationDbRow {\n\tvalidation_id: string;\n\ttest_plan_id: string;\n\tcandidate_id: string;\n\tproblem_id: string;\n\tresource_id: string;\n\tbase_version: string;\n\tcase_results_json: string;\n\tverdict: string;\n\ttotal_usage_ref: string | null;\n\tcreated_at: string;\n}\n\ninterface EvolutionSourceLinkDbRow {\n\tlink_id: string;\n\tsource_id: string;\n\tmemory_id: string | null;\n\trevision: number | null;\n}\n\nfunction mapEvolutionProblemRow(row: EvolutionProblemDbRow): DesktopEvolutionProblemItem {\n\treturn {\n\t\tproblemId: row.problem_id,\n\t\tkind: row.kind,\n\t\taction: row.action,\n\t\tsummary: row.summary,\n\t\treason: row.reason,\n\t\texpectedBehavior: row.expected_behavior,\n\t\tactualBehavior: row.actual_behavior,\n\t\tevidenceRefs: JSON.parse(row.evidence_refs_json) as string[],\n\t\toccurrenceCount: row.occurrence_count,\n\t\tresourceId: row.resource_id,\n\t\tbaseVersion: row.base_version,\n\t\tprojectId: row.project_id,\n\t\ttaskId: row.task_id,\n\t\tsessionId: row.session_id,\n\t\tstatus: row.status,\n\t\tdisposition: row.disposition,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction mapEvolutionCandidateRow(\n\tstore: ReturnType<typeof openMemoryStore>,\n\trow: EvolutionCandidateDbRow,\n\tpaoHome: string,\n): DesktopEvolutionCandidateItem {\n\t// O12/E13：读 baseVersion 文件正文供详情页 diff/delete 对照；版本目录\n\t// 缺失或不可读时为空对象（详情页退回只显示 diff/newContent）。\n\tconst baseVersionContent = readResourceVersion(store, {\n\t\tresourceId: row.resource_id,\n\t\tversionId: row.base_version,\n\t\tpaoHome,\n\t});\n\tconst baseFiles: Record<string, string> = {};\n\tif (baseVersionContent.ok) {\n\t\tfor (const file of baseVersionContent.files) baseFiles[file.path] = file.content;\n\t}\n\treturn {\n\t\tcandidateId: row.candidate_id,\n\t\tproblemId: row.problem_id,\n\t\tresourceId: row.resource_id,\n\t\tbaseVersion: row.base_version,\n\t\ttestPlanId: row.test_plan_id,\n\t\tdiffs: JSON.parse(row.diffs_json) as EvolutionFileDiff[],\n\t\trationale: row.rationale,\n\t\tusageRefs: JSON.parse(row.usage_refs_json) as string[],\n\t\tstatus: row.status,\n\t\tfailureReason: row.failure_reason,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t\tbaseFiles,\n\t};\n}\n\n/** 库未建 = 还没有进化登记：返回空态，不拿裸 SQLite 错当业务结果。 */\nfunction evolutionDatabaseReady(home: string): boolean {\n\treturn databaseExists(home);\n}\n\n/**\n * 问题列表：scope.projectId + 可选 kind/status 过滤 + createdAt 倒序分页。\n * 只读；evidenceRefs 不在列表项展开（详情走 readDesktopEvolutionDetail）。\n */\nexport async function readDesktopEvolutionProblems(\n\tinput: ReadDesktopEvolutionProblemsInput,\n): Promise<MemoryResult<ReadDesktopEvolutionProblemsResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Math.max(1, input.page ?? 1);\n\tconst pageSize = Math.min(200, Math.max(1, input.pageSize ?? 50));\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn { ok: true, items: [], total: 0, hasMore: false };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions = [\"p.project_id = ?\"];\n\t\tconst params: Array<string | number> = [input.scope.projectId];\n\t\tif (input.kind !== undefined) {\n\t\t\tconditions.push(\"p.kind = ?\");\n\t\t\tparams.push(input.kind);\n\t\t}\n\t\tif (input.status !== undefined) {\n\t\t\tconditions.push(\"p.status = ?\");\n\t\t\tparams.push(input.status);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS total FROM evolution_problems p WHERE ${where}`)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT p.problem_id, p.kind, p.action, p.summary, p.reason,\n\t\t\t\t        p.expected_behavior, p.actual_behavior, p.evidence_refs_json,\n\t\t\t\t        p.occurrence_count, p.resource_id, p.base_version,\n\t\t\t\t        p.project_id, p.task_id, p.session_id,\n\t\t\t\t        p.status, p.disposition, p.created_at, p.updated_at\n\t\t\t\t FROM evolution_problems p\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY p.created_at DESC, p.problem_id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, pageSize, (page - 1) * pageSize) as unknown as EvolutionProblemDbRow[];\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: rows.map(mapEvolutionProblemRow),\n\t\t\ttotal: totalRow.total,\n\t\t\thasMore: page * pageSize < totalRow.total,\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 问题详情：problem 行 + 全部候选 + 来源链接。\n * problem 不存在返回 invalid_input；其余空集合如实为空。\n */\nexport async function readDesktopEvolutionDetail(\n\tinput: ReadDesktopEvolutionDetailInput,\n): Promise<MemoryResult<DesktopEvolutionDetailResult>> {\n\tif (typeof input.problemId !== \"string\" || input.problemId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"problemId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst problemRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT problem_id, kind, action, summary, reason,\n\t\t\t\t        expected_behavior, actual_behavior, evidence_refs_json,\n\t\t\t\t        occurrence_count, resource_id, base_version,\n\t\t\t\t        project_id, task_id, session_id,\n\t\t\t\t        status, disposition, created_at, updated_at\n\t\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.get(input.problemId) as EvolutionProblemDbRow | undefined;\n\t\tif (!problemRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化问题不存在:${input.problemId}`,\n\t\t\t\t\trefId: input.problemId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst candidateRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t        diffs_json, rationale, usage_refs_json, status, failure_reason,\n\t\t\t\t        created_at, updated_at\n\t\t\t\t FROM evolution_candidates WHERE problem_id = ?\n\t\t\t\t ORDER BY created_at, candidate_id`,\n\t\t\t)\n\t\t\t.all(input.problemId) as unknown as EvolutionCandidateDbRow[];\n\t\tconst linkRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT link_id, source_id, memory_id, revision\n\t\t\t\t FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?\n\t\t\t\t ORDER BY created_at, link_id`,\n\t\t\t)\n\t\t\t.all(input.problemId) as unknown as EvolutionSourceLinkDbRow[];\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblem: mapEvolutionProblemRow(problemRow),\n\t\t\tcandidates: candidateRows.map((row) => mapEvolutionCandidateRow(store, row, input.home)),\n\t\t\tsourceLinks: linkRows.map((row) => ({\n\t\t\t\tlinkId: row.link_id,\n\t\t\t\tsourceId: row.source_id,\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t})),\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 候选验证：按 candidateId 读最新一条 validation（同候选多次验证取最新）。\n * 候选存在但尚无验证时 validation=null；候选不存在返回 invalid_input。\n */\nexport async function readDesktopEvolutionValidation(\n\tinput: ReadDesktopEvolutionValidationInput,\n): Promise<MemoryResult<DesktopEvolutionValidationResult>> {\n\tif (typeof input.candidateId !== \"string\" || input.candidateId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"candidateId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst candidateRow = store.db\n\t\t\t.prepare(`SELECT candidate_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { candidate_id: string } | undefined;\n\t\tif (!candidateRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化候选不存在:${input.candidateId}`,\n\t\t\t\t\trefId: input.candidateId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT validation_id, test_plan_id, candidate_id, problem_id, resource_id,\n\t\t\t\t        base_version, case_results_json, verdict, total_usage_ref, created_at\n\t\t\t\t FROM evolution_validations WHERE candidate_id = ?\n\t\t\t\t ORDER BY created_at DESC, validation_id DESC\n\t\t\t\t LIMIT 1`,\n\t\t\t)\n\t\t\t.get(input.candidateId) as EvolutionValidationDbRow | undefined;\n\t\tif (!row) {\n\t\t\treturn { ok: true, validation: null };\n\t\t}\n\t\t// O12/E13：补每项 case 的 acceptance（冻结 plan.json）与运行回执路径\n\t\t// （runs/<caseId>-<side>-*.json 取最新）。plan.json/runs 缺失时如实为空，\n\t\t// 不挡主结果。\n\t\tconst acceptanceByCase = new Map<string, string>();\n\t\ttry {\n\t\t\tconst planPath = join(evolutionPaths(input.home).validations, row.test_plan_id, \"plan.json\");\n\t\t\tif (existsSync(planPath)) {\n\t\t\t\tconst plan = JSON.parse(readFileSync(planPath, \"utf8\")) as {\n\t\t\t\t\treproduction?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t\tnormal?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t\tholdout?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t};\n\t\t\t\tfor (const group of [plan.reproduction, plan.normal, plan.holdout]) {\n\t\t\t\t\tfor (const item of group ?? []) {\n\t\t\t\t\t\tif (typeof item.caseId === \"string\" && typeof item.acceptance === \"string\") {\n\t\t\t\t\t\t\tacceptanceByCase.set(item.caseId, item.acceptance);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// plan.json 缺失/损坏：acceptance 留空。\n\t\t}\n\t\tconst receiptsByCase = new Map<string, { baseline?: string; candidate?: string }>();\n\t\ttry {\n\t\t\tconst runsDir = join(evolutionPaths(input.home).validations, row.test_plan_id, \"runs\");\n\t\t\tif (existsSync(runsDir)) {\n\t\t\t\tfor (const entry of readdirSync(runsDir)) {\n\t\t\t\t\t// 命名约定：<caseId>-<baseline|candidate>-<uuid8>.json\n\t\t\t\t\tconst m = /^(.+)-(baseline|candidate)-[0-9a-f]{8}\\.json$/.exec(entry);\n\t\t\t\t\tif (!m) continue;\n\t\t\t\t\tconst bucket = receiptsByCase.get(m[1]!) ?? {};\n\t\t\t\t\tconst side = m[2] as \"baseline\" | \"candidate\";\n\t\t\t\t\tbucket[side] = join(runsDir, entry);\n\t\t\t\t\treceiptsByCase.set(m[1]!, bucket);\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// runs 目录缺失/不可读：receipts 留空。\n\t\t}\n\t\tconst caseResults = (\n\t\t\tJSON.parse(row.case_results_json) as Array<{\n\t\t\t\tcaseId: string;\n\t\t\t\tgroup: string;\n\t\t\t\tbaseline: ValidationRunResult | null;\n\t\t\t\tcandidate: ValidationRunResult | null;\n\t\t\t\tverdict: string;\n\t\t\t}>\n\t\t).map((caseResult) => {\n\t\t\tconst receipts = receiptsByCase.get(caseResult.caseId);\n\t\t\treturn {\n\t\t\t\t...caseResult,\n\t\t\t\t...(acceptanceByCase.has(caseResult.caseId)\n\t\t\t\t\t? { acceptance: acceptanceByCase.get(caseResult.caseId) }\n\t\t\t\t\t: {}),\n\t\t\t\t...(receipts !== undefined ? { receipts } : {}),\n\t\t\t};\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\tvalidation: {\n\t\t\t\tvalidationId: row.validation_id,\n\t\t\t\ttestPlanId: row.test_plan_id,\n\t\t\t\tcandidateId: row.candidate_id,\n\t\t\t\tproblemId: row.problem_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\tbaseVersion: row.base_version,\n\t\t\t\tcaseResults,\n\t\t\t\tverdict: row.verdict,\n\t\t\t\ttotalUsageRef: row.total_usage_ref,\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t},\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 7. S9-12：单资源「生效与观察」读取 + 受控写通道\n// ════════════════════════════════════════════════════════════════════════\n//\n// 边界：\n// - readDesktopEvolutionResource 只读装配：effectiveVersion/开关/activation\n//   历史/active 绑定/按版本观察计数，全部走既有内核入口，本层不新造语义。\n// - mutateDesktopEvolution 只暴露 setAutoEvolution 与 restoreVersion 两个动作；\n//   恢复版本内部仍走 restoreResourceVersion 的完整发布判据（页面不能绕过判据\n//   直接改指向；冲突返回当前版本不自动覆盖）。\n// - 资源本身无项目维度：evolution_resources 无 project_id 列，资源与激活历史\n//   是 PAO_HOME 级。归属核对由桌面桥在调用前按 problem/绑定行完成；本层只做\n//   资源存在性校验（内核 getResource 同口径）。\n\n// ── readDesktopEvolutionResource ─────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionResourceInput extends DesktopMemoryHomeInput {\n\tresourceId: string;\n}\n\n/** 一个待恢复目标版本的预判（publish 凭据 + 停用标记）。 */\nexport interface DesktopEvolutionVersionOption {\n\tversionId: string;\n\t/** 有未停用 publish 凭据且版本目录在（restore 判据 b 的页面预判口径）。 */\n\trestorable: boolean;\n\t/** 不可恢复原因（凭据缺失/已被停用/目录缺失），供界面置灰提示。 */\n\tblockReason?: string;\n\t/** 该版本当前是否即生效版。 */\n\tcurrent: boolean;\n}\n\nexport interface ReadDesktopEvolutionResourceResult {\n\t/** 资源登记行（kind/relativeRoot/effectiveVersion/autoEvolutionEnabled 等）。 */\n\tresource: EvolutionResource;\n\t/** 当前生效版本 + 目录可用性（目录缺失/指纹不符时 available=false）。 */\n\teffective: {\n\t\tversionId?: string;\n\t\tavailable: boolean;\n\t\tversionDir?: string;\n\t};\n\t/** publish/restore/rollback 全量时间线（含 effective/disabled 标记）。 */\n\tactivationHistory: ActivationHistoryEntry[];\n\t/** 当前 active 任务绑定（versionId 是任务实际固定版本，不是 effectiveVersion）。 */\n\ttaskBindings: TaskBinding[];\n\t/** 最近回退记录（kind='rollback' 最新一条；界面「回退通知」区）。 */\n\tlastRollback?: ActivationHistoryEntry;\n\t/** 观察计数：对当前生效版和最近一个不同版本各一份。 */\n\tusageByVersion: Array<{ versionId: string } & UsageByVersionCounts>;\n\t/** 版本清单（activationHistory 中出现的版本去重，含可恢复预判）。 */\n\tversions: DesktopEvolutionVersionOption[];\n}\n\n// ── mutateDesktopEvolution ───────────────────────────────────────────────\n\n/** 停用/恢复单资源自动进化。 */\nexport interface DesktopEvolutionSetAutoEvolutionAction {\n\taction: \"setAutoEvolution\";\n\tresourceId: string;\n\tenabled: boolean;\n\treason?: string;\n}\n\n/** 恢复历史版本为当前生效版（CAS + 重过发布判据）。 */\nexport interface DesktopEvolutionRestoreVersionAction {\n\taction: \"restoreVersion\";\n\tresourceId: string;\n\ttargetVersionId: string;\n\t/** 调用方持有的当前生效版本；不一致即 conflict，不自动覆盖。 */\n\texpectedEffectiveVersion: string;\n\treason?: string;\n}\n\nexport type DesktopEvolutionAction =\n\t| DesktopEvolutionSetAutoEvolutionAction\n\t| DesktopEvolutionRestoreVersionAction;\n\nexport interface MutateDesktopEvolutionInput extends DesktopMemoryHomeInput {\n\taction: DesktopEvolutionAction;\n}\n\nexport interface DesktopEvolutionSetAutoEvolutionResult {\n\taction: \"setAutoEvolution\";\n\t/** 写后最新资源行（autoEvolutionEnabled 已更新）。 */\n\tresource: EvolutionResource;\n}\n\nexport interface DesktopEvolutionRestoreVersionResult {\n\taction: \"restoreVersion\";\n\t/** 已切指向（restored=true；业务拒绝为 false）。 */\n\trestored: boolean;\n\t/** 业务拒绝形态；restored=false 时给出。 */\n\tstatus?: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（判据逐条说明）。 */\n\treason?: string;\n\t/** 当前实际生效版本（供页面重取；restored 后为 targetVersionId）。 */\n\tcurrentEffectiveVersion?: string;\n\t/** 受影响 active 任务绑定（切版后仍绑旧版的任务；宿主决定安全点换版）。 */\n\taffectedTasks: TaskBinding[];\n}\n\nexport type MutateDesktopEvolutionResult =\n\t| ({ action: \"setAutoEvolution\" } & MemoryResult<DesktopEvolutionSetAutoEvolutionResult>)\n\t| ({ action: \"restoreVersion\" } & MemoryResult<DesktopEvolutionRestoreVersionResult>);\n\n// ── 行读取辅助 ────────────────────────────────────────────────────────────\n\n/**\n * 可恢复版本清单：activationHistory 中出现过的全部版本去重，逐版标注\n * 「有未停用 publish 凭据且目录在」与否。指纹级完整性核对归\n * restoreResourceVersion 服务内判据，页面预判只查凭据与目录存在性。\n */\nfunction listVersionOptions(\n\tstore: ReturnType<typeof openMemoryStore>,\n\thome: string,\n\tresourceId: string,\n\teffectiveVersion: string | undefined,\n\thistory: ActivationHistoryEntry[],\n): DesktopEvolutionVersionOption[] {\n\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t// 每个版本取最新一条 publish 凭据判停用：kind='publish' 的落盘凭据与\n\t// activation='effective' 的生效行都算「发布过」；只看最新一条的 reason\n\t// 前缀（旧行停用标记若被后来有效凭据覆盖，以最新为准）。\n\tconst credRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT to_version, reason\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId) as unknown as Array<{ to_version: string; reason: string | null }>;\n\tconst latestPublishReason = new Map<string, string | null>();\n\tfor (const row of credRows) {\n\t\tif (!latestPublishReason.has(row.to_version)) {\n\t\t\tlatestPublishReason.set(row.to_version, row.reason);\n\t\t}\n\t}\n\tconst seen = new Set<string>();\n\tconst options: DesktopEvolutionVersionOption[] = [];\n\tfor (const entry of history) {\n\t\tconst ids = [entry.toVersion];\n\t\tif (entry.fromVersion !== undefined) ids.push(entry.fromVersion);\n\t\tfor (const versionId of ids) {\n\t\t\tif (seen.has(versionId)) continue;\n\t\t\tseen.add(versionId);\n\t\t\tconst versionDir = join(evolutionPaths(home).versions, dirSafe, versionId);\n\t\t\tconst dirExists = existsSync(versionDir);\n\t\t\tconst hasCred = latestPublishReason.has(versionId);\n\t\t\tconst credDisabled =\n\t\t\t\thasCred && (latestPublishReason.get(versionId) ?? \"\").startsWith(\"停用:\");\n\t\t\tlet restorable = true;\n\t\t\tlet blockReason: string | undefined;\n\t\t\tif (!hasCred) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"该版本没有发布凭据（未曾完整发布过）\";\n\t\t\t} else if (credDisabled) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"该版本的发布凭据已被停用（曾失败或被回退），不能直接恢复\";\n\t\t\t} else if (!dirExists) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"版本目录缺失，不能直接恢复\";\n\t\t\t}\n\t\t\toptions.push({\n\t\t\t\tversionId,\n\t\t\t\trestorable,\n\t\t\t\t...(blockReason === undefined ? {} : { blockReason }),\n\t\t\t\tcurrent: versionId === effectiveVersion,\n\t\t\t});\n\t\t}\n\t}\n\treturn options;\n}\n\n/**\n * 单资源「生效与观察」读取（只读）。\n * 资源无项目维度：归属核对由调用方（桌面桥）完成；本层只做存在性校验。\n * 库未建返回 unavailable（无资源可读），与 readDesktopEvolutionDetail 同口径。\n */\nexport async function readDesktopEvolutionResource(\n\tinput: ReadDesktopEvolutionResourceInput,\n): Promise<MemoryResult<ReadDesktopEvolutionResourceResult>> {\n\tif (typeof input.resourceId !== \"string\" || input.resourceId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst resourceRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.resourceId) as\n\t\t\t| {\n\t\t\t\t\tresource_id: string;\n\t\t\t\t\tkind: string;\n\t\t\t\t\trelative_root: string;\n\t\t\t\t\tallowed_ops_json: string;\n\t\t\t\t\tcapability_scope_json: string;\n\t\t\t\t\tload_method: string;\n\t\t\t\t\teffective_version: string | null;\n\t\t\t\t\tauto_evolution_enabled: number;\n\t\t\t\t\tregistered_at: string;\n\t\t\t\t\tupdated_at: string;\n\t\t\t  }\n\t\t\t| undefined;\n\t\tif (!resourceRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化资源未登记:${input.resourceId}`,\n\t\t\t\t\trefId: input.resourceId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst resource: EvolutionResource = {\n\t\t\tresourceId: resourceRow.resource_id,\n\t\t\tkind: resourceRow.kind as EvolutionResource[\"kind\"],\n\t\t\trelativeRoot: resourceRow.relative_root,\n\t\t\tallowedOps: JSON.parse(resourceRow.allowed_ops_json) as EvolutionResource[\"allowedOps\"],\n\t\t\tcapabilityScope: JSON.parse(resourceRow.capability_scope_json) as string[],\n\t\t\tloadMethod: resourceRow.load_method as EvolutionResource[\"loadMethod\"],\n\t\t\t...(resourceRow.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { effectiveVersion: resourceRow.effective_version }),\n\t\t\tautoEvolutionEnabled: resourceRow.auto_evolution_enabled === 1,\n\t\t\tregisteredAt: resourceRow.registered_at,\n\t\t\tupdatedAt: resourceRow.updated_at,\n\t\t};\n\n\t\tconst effectiveResult = getEffectiveVersion(store, input.resourceId, input.home);\n\t\tif (!effectiveResult.ok) {\n\t\t\treturn effectiveResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\t\tconst historyResult = listActivationHistory(store, input.resourceId);\n\t\tif (!historyResult.ok) {\n\t\t\treturn historyResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\t\tconst bindingsResult = listTaskBindings(store, {\n\t\t\tresourceId: input.resourceId,\n\t\t\tactiveOnly: true,\n\t\t});\n\t\tif (!bindingsResult.ok) {\n\t\t\treturn bindingsResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\n\t\tconst history = historyResult.items;\n\t\tconst lastRollback = [...history].reverse().find((entry) => entry.kind === \"rollback\");\n\n\t\t// 观察计数：当前生效版 + 最近一个不同版本（时间线上最新非当前版）。\n\t\tconst usageByVersion: Array<{ versionId: string } & UsageByVersionCounts> = [];\n\t\tconst observedVersions: string[] = [];\n\t\tif (effectiveResult.versionId !== undefined) observedVersions.push(effectiveResult.versionId);\n\t\tconst latestOther = [...history]\n\t\t\t.reverse()\n\t\t\t.find((entry) => entry.toVersion !== effectiveResult.versionId);\n\t\tif (latestOther !== undefined) observedVersions.push(latestOther.toVersion);\n\t\tfor (const versionId of observedVersions) {\n\t\t\tconst counts = countUsageByVersion(store, { resourceId: input.resourceId, versionId });\n\t\t\tif (!counts.ok) return counts as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t\tusageByVersion.push({ versionId, ...counts });\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresource,\n\t\t\teffective: {\n\t\t\t\t...(effectiveResult.versionId === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: { versionId: effectiveResult.versionId }),\n\t\t\t\tavailable: effectiveResult.available,\n\t\t\t\t...(effectiveResult.versionDir === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: { versionDir: effectiveResult.versionDir }),\n\t\t\t},\n\t\t\tactivationHistory: history,\n\t\t\ttaskBindings: bindingsResult.items,\n\t\t\t...(lastRollback === undefined ? {} : { lastRollback }),\n\t\t\tusageByVersion,\n\t\t\tversions: listVersionOptions(\n\t\t\t\tstore,\n\t\t\t\tinput.home,\n\t\t\t\tinput.resourceId,\n\t\t\t\teffectiveResult.versionId,\n\t\t\t\thistory,\n\t\t\t),\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 受控写通道：setAutoEvolution / restoreVersion。\n * readwrite 借用；restoreVersion 完整走 restoreResourceVersion 判据\n * （目录指纹、publish 凭据、来源依据、CAS），冲突/待重评估如实返回\n * 当前版本，不自动覆盖。\n */\nexport async function mutateDesktopEvolution(\n\tinput: MutateDesktopEvolutionInput,\n): Promise<MutateDesktopEvolutionResult> {\n\tconst action = input.action;\n\tif (!action || typeof action !== \"object\" || typeof action.action !== \"string\") {\n\t\treturn {\n\t\t\taction: \"setAutoEvolution\",\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"action 不能为空\" },\n\t\t} as MutateDesktopEvolutionResult;\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\taction: action.action,\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t} as MutateDesktopEvolutionResult;\n\t}\n\n\tswitch (action.action) {\n\t\tcase \"setAutoEvolution\": {\n\t\t\tif (typeof action.resourceId !== \"string\" || action.resourceId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"setAutoEvolution\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (typeof action.enabled !== \"boolean\") {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"setAutoEvolution\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"enabled 必须是布尔值\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst store = openMemoryStore(input.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst result = setResourceAutoEvolution(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\tenabled: action.enabled,\n\t\t\t\t\t...(action.reason === undefined ? {} : { reason: action.reason }),\n\t\t\t\t});\n\t\t\t\tif (!result.ok) return { action: \"setAutoEvolution\", ok: false, error: result.error };\n\t\t\t\treturn { action: \"setAutoEvolution\", ok: true, resource: result };\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t}\n\t\tcase \"restoreVersion\": {\n\t\t\tif (typeof action.resourceId !== \"string\" || action.resourceId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (typeof action.targetVersionId !== \"string\" || action.targetVersionId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: \"targetVersionId 不能为空\",\n\t\t\t\t\t\trefId: action.resourceId,\n\t\t\t\t\t},\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (\n\t\t\t\ttypeof action.expectedEffectiveVersion !== \"string\" ||\n\t\t\t\taction.expectedEffectiveVersion.length === 0\n\t\t\t) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: \"expectedEffectiveVersion 不能为空\",\n\t\t\t\t\t\trefId: action.resourceId,\n\t\t\t\t\t},\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst store = openMemoryStore(input.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst result = restoreResourceVersion(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\ttargetVersionId: action.targetVersionId,\n\t\t\t\t\texpectedEffectiveVersion: action.expectedEffectiveVersion,\n\t\t\t\t\tpaoHome: input.home,\n\t\t\t\t\t...(action.reason === undefined ? {} : { reason: action.reason }),\n\t\t\t\t});\n\t\t\t\tif (!result.ok) {\n\t\t\t\t\treturn { action: \"restoreVersion\", ok: false, error: result.error };\n\t\t\t\t}\n\t\t\t\t// 受影响任务：切版后仍绑旧版（与当前指向不同）的 active 绑定。\n\t\t\t\tconst currentRow = store.db\n\t\t\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t\t\t.get(action.resourceId) as { effective_version: string | null } | undefined;\n\t\t\t\tconst currentEffective = currentRow?.effective_version ?? undefined;\n\t\t\t\tconst bindingsResult = listTaskBindings(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\tactiveOnly: true,\n\t\t\t\t});\n\t\t\t\tif (!bindingsResult.ok) {\n\t\t\t\t\treturn { action: \"restoreVersion\", ok: false, error: bindingsResult.error };\n\t\t\t\t}\n\t\t\t\tconst affectedTasks = bindingsResult.items.filter(\n\t\t\t\t\t(binding) => binding.versionId !== currentEffective,\n\t\t\t\t);\n\t\t\t\tif (\"restored\" in result && result.restored === true) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\trestored: true,\n\t\t\t\t\t\tcurrentEffectiveVersion: result.versionId,\n\t\t\t\t\t\taffectedTasks,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\t// 业务拒绝：restoreResourceVersion 返回 RestoreRejected（status/reason）。\n\t\t\t\tconst rejected = result as { status: \"needs_reevaluation\" | \"conflict\"; reason: string; currentEffectiveVersion?: string };\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: true,\n\t\t\t\t\trestored: false,\n\t\t\t\t\tstatus: rejected.status,\n\t\t\t\t\treason: rejected.reason,\n\t\t\t\t\t...(rejected.currentEffectiveVersion === undefined\n\t\t\t\t\t\t? {}\n\t\t\t\t\t\t: { currentEffectiveVersion: rejected.currentEffectiveVersion }),\n\t\t\t\t\taffectedTasks,\n\t\t\t\t};\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t}\n\t\tdefault: {\n\t\t\treturn {\n\t\t\t\taction: \"setAutoEvolution\",\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `未知进化变更操作:${String((action as { action?: unknown }).action)}`,\n\t\t\t\t},\n\t\t\t} as MutateDesktopEvolutionResult;\n\t\t}\n\t}\n}\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\r\n * 受控自进化版本生效与回退事务（S9-02/03）。\r\n *\rimport { randomUUID } from \"node:crypto\";\r\nimport { existsSync, statSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\r\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\r\nimport { checkOwnerSourceLinksIntact, recordPatched } from \"./observe.ts\";\r\nimport { fingerprintResourceRoot } from \"./versions.ts\";\r\t};\r\n}\r\n","ops":[{"diffOp":{"equal":{"range":[0,72]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[72,197]}}},{"diffOp":{"equal":{"range":[197,206]}}},{"diffOp":{"delete":{"range":[206,211]}}},{"diffOp":{"equal":{"range":[211,212]}}},{"diffOp":{"delete":{"range":[212,225]}}},{"diffOp":{"equal":{"range":[212,213]}}},{"diffOp":{"delete":{"range":[225,237]}}},{"diffOp":{"insert":{"range":[237,251]}}},{"diffOp":{"equal":{"range":[251,270]}}},{"diffOp":{"delete":{"range":[270,278]}}},{"diffOp":{"insert":{"range":[278,286]}}},{"diffOp":{"equal":{"range":[286,288]}}},{"diffOp":{"equal":{"range":[288,344]}}},{"diffOp":{"equal":{"range":[288,297]}}},{"diffOp":{"insert":{"range":[206,211]}}},{"diffOp":{"equal":{"range":[344,346]}}},{"diffOp":{"delete":{"range":[237,251]}}},{"diffOp":{"insert":{"range":[346,371]}}},{"diffOp":{"equal":{"range":[251,270]}}},{"diffOp":{"delete":{"range":[278,286]}}},{"diffOp":{"insert":{"range":[270,278]}}},{"diffOp":{"equal":{"range":[286,288]}}},{"diffOp":{"equal":{"range":[371,506]}}},{"equalLines":{"line_count":610}},{"diffOp":{"equal":{"range":[506,514]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\activation.ts"},"span":[2370,2411],"sourceCode":"/**\r\n * 受控自进化版本生效与回退事务（S9-02/03）。\r\n *\r\n * 职责：\r\n * - `activateCandidate`：前置核对（事务外快筛 + 事务内重读确认）后单事务\r\n *   UPDATE `evolution_resources.effective_version` + INSERT `evolution_activations`。\r\n * - `rollbackResource`：事务体执行回退——当前指向仍是坏版才切回上一版；\r\n *   退步判定（哪些证据算 regression）归批 D，本模块只暴露执行入口。\r\n * - `getEffectiveVersion`：当前生效 versionId + 目录存在性。\r\n *\r\n * 契约（S9 任务书 §5）：\r\n * - 生效凭据复用 `kind='publish'` 行（批 A 已建表 CHECK('publish','restore','rollback')，\r\n *   不改表）；落盘凭据 vs 生效凭据由 `source_links_json.activation` 区分：\r\n *   `published`（候选已固化进版本目录）vs `effective`（已切指向）。\r\n *   判生效行时按 kind='publish' + activation='effective' 过滤，不看 reason 文案。\r\n * - 事务内不含模型调用或进程执行；只记已完整发布的版本路径。\r\n * - 核对口径：expectedEffectiveVersion === effective_version === 候选 baseVersion；\r\n *   授权未收回（auto_evolution_enabled）；最新验证仍 passed 且同一条；\r\n *   资源根当前指纹 === baseVersion 快照指纹（重算 sha256 清单哈希，与\r\n *   snapshotResourceFiles 同口径，不复制磁盘内容，只在内存比对）；\r\n *   候选/冻结计划/验证三方各自的 evolution_source_links 行仍在\r\n *   （关联缺失或引用的记忆行已不存在 → 依据失效 → 标待重评估）。\r\n * - 任一前置不满足 → `{status:\"conflict\"}`：保留旧指向，并沿\r\n *   markStaleCandidates 口径把同资源同 baseVersion 的未终态候选标 cancelled\r\n *   待重评估（旧候选不得直接重新排发布；本候选保持 passed 终态不再出库）。\r\n * - `rollbackResource` 只在前置（资源存在、当前指向仍是 badVersion）成立时写：\r\n *   同事务 UPDATE effective_version→previousVersion + INSERT activation\r\n *   kind='rollback' + UPDATE 坏版 publish 凭据的 reason 前缀「停用:」\r\n *   （activations 行不可原位修改语义指版本文件不被覆盖，reason 标停用\r\n *   属生效历史修订，不扩表）。指向已非 badVersion → no_change，不覆盖其他已生效修复。\r\n */\r\nimport { randomUUID } from \"node:crypto\";\r\nimport { existsSync, statSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\r\nimport type { MemoryStore } from \"../memory/store.ts\";\r\nimport { evolutionPaths } from \"../memory/paths.ts\";\r\nimport { checkOwnerSourceLinksIntact, recordPatched } from \"./observe.ts\";\r\nimport { fingerprintResourceRoot } from \"./versions.ts\";\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 1. 输入输出契约\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/** `activateCandidate` 的输入。 */\r\nexport interface ActivateCandidateInput {\r\n\t/** 已发布成固定版本的候选 ID。 */\r\n\tcandidateId: string;\r\n\t/** 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突）。 */\r\n\texpectedEffectiveVersion: string;\r\n\t/** PAO_HOME 根。 */\r\n\tpaoHome: string;\r\n\t/** 生效授权引用（宿主侧的批准凭据身份，记入 source_links_json.authRef）。 */\r\n\tauthRef?: string;\r\n\t/** 生效原因（人读，记入 activation.reason）。 */\r\n\treason?: string;\r\n\t/** 生效时间（夹具注入；缺省取当前）。 */\r\n\tcreatedAt?: string;\r\n}\r\n\r\n/** `activateCandidate` 的成功输出。 */\r\nexport interface ActivateResult {\r\n\t/** 生效后的版本 ID（= 该候选的 publish 凭据 to_version）。 */\r\n\tversionId: string;\r\n\t/** 本次写入的 activation 行 ID（kind='publish'，activation='effective'）。 */\r\n\tactivationId: string;\r\n\t/** 生效前指向（= 候选 baseVersion）。 */\r\n\tfromVersion: string;\r\n}\r\n\r\n/** `activateCandidate` 的冲突输出（业务拒绝，不是系统错误）。 */\r\nexport interface ActivateConflict {\r\n\tstatus: \"conflict\";\r\n\t/** 冲突原因（前置核对失败的逐条说明）。 */\r\n\treason: string;\r\n\t/** 资源当前实际生效版本（供调用方重取后继续判断；资源行缺失时缺省）。 */\r\n\tcurrentEffectiveVersion?: string;\r\n}\r\n\r\n/** `rollbackResource` 的输入。 */\r\nexport interface RollbackResourceInput {\r\n\tresourceId: string;\r\n\t/** 被判退步的版本（当前指向必须是它才执行回退）。 */\r\n\tbadVersion: string;\r\n\t/** 回退目标（上一有效版）。 */\r\n\tpreviousVersion: string;\r\n\t/** 退步证据来源 ID（记入 rollback 行的 source_links_json）。 */\r\n\tsourceIds: string[];\r\n\t/** 回退原因（人读）。 */\r\n\treason: string;\r\n\t/** 回退时间（夹具注入；缺省取当前）。 */\r\n\tcreatedAt?: string;\r\n}\r\n\r\n/** `rollbackResource` 的输出。 */\r\nexport type RollbackResult =\r\n\t| {\r\n\t\t\tstatus: \"rolled_back\";\r\n\t\t\t/** 本次写入的 rollback activation ID。 */\r\n\t\t\tactivationId: string;\r\n\t  }\r\n\t| {\r\n\t\t\t/** 当前指向已不是 badVersion：另一修复已生效，不覆盖。 */\r\n\t\t\tstatus: \"no_change\";\r\n\t\t\tcurrentEffectiveVersion?: string;\r\n\t\t\treason: string;\r\n\t  };\r\n\r\n/** `getEffectiveVersion` 的输出。 */\r\nexport interface EffectiveVersionInfo {\r\n\t/** 当前生效版本 ID（未设过 effective_version 时缺省）。 */\r\n\tversionId?: string;\r\n\t/** 指向版本目录是否存在且非空（无指向时为 false）。 */\r\n\tavailable: boolean;\r\n\t/** 指向版本目录绝对路径（有指向时给出，不论存在与否）。 */\r\n\tversionDir?: string;\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 2. 内部：行读取与指纹\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\r\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\r\n}\r\n\r\n/** 把 resourceId 转为目录安全名（`:` → `_`，与 versions.ts 同规则）。 */\r\nfunction dirSafeId(resourceId: string): string {\r\n\treturn resourceId.replace(/:/g, \"_\");\r\n}\r\n\r\n/**\r\n * 目录指纹 = `v-{sha256(文件清单[路径,sha256])前12位}`，与 snapshotResourceFiles\r\n * 同口径：只重算哈希比对，不把快照文件复制到版本目录（本模块是核对不是快照）。\r\n * O12/E12：三处私有重复收拢为 versions.ts 的 fingerprintResourceRoot 共享实现；\r\n * 本模块仍要求「目录形态」——文件型根不支持，激活判据只认目录型版本底座。\r\n */\r\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\r\n\treturn fingerprintResourceRoot(root);\r\n}\r\n\r\n/**\r\n * 版本目录完整性核对。versionId 即内容清单哈希（`v-{sha12}`），\r\n * 重算目录指纹与版本号比对：文件被删/被改都会改变指纹——比只数文件更严。\r\n * 非哈希形 versionId（理论上不会出现：snapshot/publish 都是 v-sha12）退化为非空核对。\r\n */\r\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\r\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\r\n\tconst current = fingerprintDirectory(versionDir);\r\n\tif (current.fileCount === 0) return false;\r\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\r\n}\r\n\r\ninterface ResourceRow {\r\n\tresource_id: string;\r\n\trelative_root: string;\r\n\teffective_version: string | null;\r\n\tauto_evolution_enabled: number;\r\n}\r\n\r\ninterface CandidateRow {\r\n\tcandidate_id: string;\r\n\tproblem_id: string;\r\n\tresource_id: string;\r\n\tbase_version: string;\r\n\ttest_plan_id: string;\r\n\tstatus: string;\r\n}\r\n\r\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT resource_id, relative_root, effective_version, auto_evolution_enabled\r\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\r\n\t\t)\r\n\t\t.get(resourceId) as ResourceRow | undefined;\r\n}\r\n\r\nfunction getCandidateRow(store: MemoryStore, candidateId: string): CandidateRow | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status\r\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\r\n\t\t)\r\n\t\t.get(candidateId) as CandidateRow | undefined;\r\n}\r\n\r\nfunction getLatestValidation(\r\n\tstore: MemoryStore,\r\n\tcandidateId: string,\r\n): { validation_id: string; verdict: string; created_at: string } | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT validation_id, verdict, created_at FROM evolution_validations\r\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\r\n\t\t)\r\n\t\t.get(candidateId) as { validation_id: string; verdict: string; created_at: string } | undefined;\r\n}\r\n\r\ninterface ActivationRow {\r\n\tactivation_id: string;\r\n\tfrom_version: string | null;\r\n\tto_version: string;\r\n\tkind: string;\r\n\tsource_links_json: string | null;\r\n\tcreated_at: string;\r\n}\r\n\r\n/** 查该候选的 publish-落盘凭据（取最新一条带 candidateId 的 kind='publish' 行）。 */\r\nfunction getPublishCredentialForCandidate(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tcandidateId: string,\r\n): ActivationRow | undefined {\r\n\tconst rows = store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT activation_id, from_version, to_version, kind, source_links_json, created_at\r\n\t\t\t FROM evolution_activations\r\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\r\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\r\n\t\t)\r\n\t\t.all(resourceId) as unknown as ActivationRow[];\r\n\tfor (const row of rows) {\r\n\t\tif (row.source_links_json === null) continue;\r\n\t\ttry {\r\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\r\n\t\t\tif (links.candidateId === candidateId) return row;\r\n\t\t} catch {\r\n\t\t\t// 非 JSON 行跳过（不当作凭据）。\r\n\t\t}\r\n\t}\r\n\treturn undefined;\r\n}\r\n\r\n/**\r\n * 根基线（O13/E15）：资源根最后被同步到的版本。激活不回写资源根，\r\n * 根基线留在最初快照值——首轮 = 登记快照 baseVersion，由首个\r\n * activation='effective' 凭据的 from_version 记档；无 effective 凭据 =\r\n * 未激活过，根基线=当前 effective_version（即登记快照本身，与首轮\r\n * 「比资源根 vs base_version」等价）。返回 undefined = 连快照指向都没有，\r\n * 调用处跳过根基线核对。\r\n */\r\nfunction getRootBaselineVersion(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tcurrentEffective: string | null,\r\n): string | undefined {\r\n\tconst rows = store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT from_version, source_links_json FROM evolution_activations\r\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\r\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\r\n\t\t)\r\n\t\t.all(resourceId) as unknown as Array<{ from_version: string | null; source_links_json: string | null }>;\r\n\tfor (const row of rows) {\r\n\t\tif (row.source_links_json === null) continue;\r\n\t\ttry {\r\n\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\r\n\t\t\tif (links.activation === \"effective\") return row.from_version ?? undefined;\r\n\t\t} catch {\r\n\t\t\t// 非 JSON 行跳过。\r\n\t\t}\r\n\t}\r\n\treturn currentEffective ?? undefined;\r\n}\r\n\r\n/**\r\n * 来源核对（契约 f，O12/E11 强化）：\r\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\r\n * - problem（owner_kind='problem', owner_id=candidate.problem_id）链加入核对——\r\n *   候选从 problem 继承来源，只查候选自身 links 会绕过问题级失效；\r\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\r\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\r\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」，\r\n *   不再放行——正常登记必有至少一条 evidenceRef 写入 problem links。\r\n * 返回失效说明（undefined = 来源仍有效）。\r\n * O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享\r\n * （publish 门/activation/control 同口径）。\r\n */\r\nfunction checkSourceLinksIntact(\r\n\tstore: MemoryStore,\r\n\tcandidate: CandidateRow,\r\n\tvalidationId: string,\r\n): string | undefined {\r\n\treturn checkOwnerSourceLinksIntact(store.db, {\r\n\t\towners: [\r\n\t\t\t{ ownerKind: \"problem\", ownerId: candidate.problem_id, label: \"问题\" },\r\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidate.candidate_id, label: \"候选\" },\r\n\t\t\t{ ownerKind: \"validation\", ownerId: candidate.test_plan_id, label: \"冻结计划\" },\r\n\t\t\t{ ownerKind: \"validation\", ownerId: validationId, label: \"验证\" },\r\n\t\t],\r\n\t});\r\n}\r\n\r\n/**\r\n * 标同资源同 baseVersion 的未终态候选待重评估（markStaleCandidates 同口径：\r\n * cancelled + failure_reason「基础版本已变动/依据失效，旧候选不得直接重新排发布」）。\r\n * 本事务内执行；passed 终态候选不动。\r\n */\r\nfunction markPendingCandidatesStale(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tbaseVersion: string,\r\n\treason: string,\r\n\tnow: string,\r\n): void {\r\n\tstore.db\r\n\t\t.prepare(\r\n\t\t\t`UPDATE evolution_candidates\r\n\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\r\n\t\t\t WHERE resource_id = ? AND base_version = ? AND status IN ('proposed','testing')`,\r\n\t\t)\r\n\t\t.run(`${reason}（依据失效，待重评估；旧候选不得直接重新排发布）`, now, resourceId, baseVersion);\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 3. activateCandidate\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 已发布候选的原子生效：前置核对（外读 + 事务内重读）→ 单事务切指向 + 写生效凭据。\r\n *\r\n * 前置核对（全部满足才进生效事务）：\r\n * a. 候选 status='passed' 且最新一条 validation verdict='passed'；\r\n * b. 已有 publish-落盘凭据（批 A 发布过），对应版本目录存在且非空；\r\n * c. 库内 effective_version === expectedEffectiveVersion === 候选 base_version；\r\n * d. auto_evolution_enabled 仍为 1；\r\n * e. 基线分离（O13/E15）：base_version 有完整版本目录时核对该目录指纹\r\n *    （验证依据未被换），否则比资源根（首轮兼容）；另核资源根指纹 ===\r\n *    根基线（首个 effective 凭据 from_version，无凭据时 = 当前 effective_version）\r\n *    ——人工改资源根 → 冲突；\r\n * f. 候选/冻结计划/最新验证的 source links 仍完整（依据未被删除排除）。\r\n *\r\n * 事务内重读 c/d（BEGIN IMMEDIATE 后到写入前的竞态窗）：任一不符即回滚，\r\n * 返回 conflict；生效写两条：INSERT kind='publish' + activation='effective' 的\r\n * activation 行 + UPDATE effective_version。事务不含模型/进程调用。\r\n */\r\nexport async function activateCandidate(\r\n\tstore: MemoryStore,\r\n\tinput: ActivateCandidateInput,\r\n): Promise<MemoryResult<ActivateResult | ActivateConflict>> {\r\n\tconst now = input.createdAt ?? new Date().toISOString();\r\n\r\n\t// ── 事务外核对（先读；事务内再重读 c/d 防竞态）──────────────────────────\r\n\r\n\t// a. 候选存在 + passed + 最新验证 passed。\r\n\tconst candidate = getCandidateRow(store, input.candidateId);\r\n\tif (!candidate) {\r\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\r\n\t}\r\n\tif (candidate.status !== \"passed\") {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 ${input.candidateId} 状态 ${candidate.status}，须为 passed 才能生效`,\r\n\t\t};\r\n\t}\r\n\tconst latestValidation = getLatestValidation(store, input.candidateId);\r\n\tif (!latestValidation || latestValidation.verdict !== \"passed\") {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: latestValidation\r\n\t\t\t\t? `候选 ${input.candidateId} 最新验证判定 ${latestValidation.verdict}，须为 passed 才能生效`\r\n\t\t\t\t: `候选 ${input.candidateId} 无验证记录，须先完成验证`,\r\n\t\t};\r\n\t}\r\n\r\n\t// b. publish-落盘凭据 + 版本目录完整可读。\r\n\tconst publishAct = getPublishCredentialForCandidate(store, candidate.resource_id, input.candidateId);\r\n\tif (!publishAct) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 ${input.candidateId} 尚无发布凭据（须先经 publishCandidate 固化成版本目录）`,\r\n\t\t};\r\n\t}\r\n\tconst versionId = publishAct.to_version;\r\n\tconst dirSafe = dirSafeId(candidate.resource_id);\r\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, versionId);\r\n\tif (!isVersionDirComplete(versionDir, versionId)) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `版本目录缺失或指纹不匹配:${versionDir}（versionId ${versionId} 是内容清单哈希，文件被删/改都会改变指纹；部分目录不构成可加载版本）`,\r\n\t\t};\r\n\t}\r\n\r\n\t// c/d（外读）：资源行 + 指向一致性 + 开关。\r\n\tconst resource = getResourceRow(store, candidate.resource_id);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\r\n\t}\r\n\tif (resource.auto_evolution_enabled !== 1) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `资源 ${candidate.resource_id} 已停用自动进化，生效须先恢复授权`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ${resource.effective_version ?? \"（空）\"} 不一致`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\tif (candidate.base_version !== input.expectedEffectiveVersion) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 base_version ${candidate.base_version} 与 expectedEffectiveVersion ${input.expectedEffectiveVersion} 不一致（验证基础已过期）`,\r\n\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t};\r\n\t}\r\n\r\n\t// e. 基线分离（O13/E15）：分清「验证基线」与「根基线」两个核对——\r\n\t//    验证基线 = candidate.base_version：它已是已发布版本（存在完整\r\n\t//    versions/<dirSafe>/<baseVersion>/ 目录）时，验证依据是版本目录正文，\r\n\t//    核对**该目录**指纹 === baseVersion，不要求资源根等于它（第二轮起\r\n\t//    资源根停在最初快照值，与 base_version 必然不等，不能混为一谈）；\r\n\t//    版本目录不存在时退回比资源根（首轮兼容：此时 base_version 就是根快照）。\r\n\t//    根基线 = 资源根最后被同步到的版本（getRootBaselineVersion）：根指纹\r\n\t//    vs 根基线不一致 = 用户现场被人工改 → conflict。两个核对都过才进事务：\r\n\t//    「验证对象没被换」由版本目录守住；「用户现场被人工改」由根基线守住。\r\n\tconst resourceRoot = join(input.paoHome, resource.relative_root);\r\n\tconst baseVersionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, candidate.base_version);\r\n\tif (isVersionDirComplete(baseVersionDir, candidate.base_version)) {\r\n\t\t// base_version 已是已发布版本：版本目录即验证依据（versionId 即清单哈希，\r\n\t\t// isVersionDirComplete 已核对该目录指纹 === baseVersion，无需重复比对）。\r\n\t} else {\r\n\t\t// 首轮兼容：base_version 是根快照（无版本目录），比资源根。\r\n\t\tconst current = fingerprintDirectory(resourceRoot);\r\n\t\tif (current.versionId !== candidate.base_version) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\t`资源当前文件指纹 ${current.versionId}（${current.fileCount} 个文件）与 base_version ` +\r\n\t\t\t\t\t`${candidate.base_version} 不一致——验证期资源被人改动，旧版保留，待重评估`,\r\n\t\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t\t};\r\n\t\t}\r\n\t}\r\n\tconst rootBaseline = getRootBaselineVersion(store, candidate.resource_id, resource.effective_version);\r\n\tif (rootBaseline !== undefined) {\r\n\t\tconst rootCurrent = fingerprintDirectory(resourceRoot);\r\n\t\tif (rootCurrent.versionId !== rootBaseline) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\t`资源根当前文件指纹 ${rootCurrent.versionId}（${rootCurrent.fileCount} 个文件）与根基线 ` +\r\n\t\t\t\t\t`${rootBaseline} 不一致——用户现场资源根被人工改动，旧版保留，待重评估`,\r\n\t\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t\t};\r\n\t\t}\r\n\t}\r\n\r\n\t// f. 候选/冻结计划/最新验证的 source links 仍在，引用记忆未被删除。\r\n\tconst sourceViolation = checkSourceLinksIntact(store, candidate, latestValidation.validation_id);\r\n\tif (sourceViolation !== undefined) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `来源依据失效：${sourceViolation}`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\r\n\t// ── 生效事务（BEGIN IMMEDIATE；内重读 c/d 确认到写入前仍成立）──────────\r\n\r\n\treturn store.transaction(() => {\r\n\t\tconst inTx = getResourceRow(store, candidate.resource_id);\r\n\t\tif (!inTx) {\r\n\t\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\r\n\t\t}\r\n\t\tif (\r\n\t\t\tinTx.effective_version !== input.expectedEffectiveVersion ||\r\n\t\t\tinTx.auto_evolution_enabled !== 1\r\n\t\t) {\r\n\t\t\t// 竞态冲突：保留旧指向；同 baseVersion 未终态候选标待重评估。\r\n\t\t\tmarkPendingCandidatesStale(store, candidate.resource_id, candidate.base_version, \"生效期间指向或授权被改\", now);\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\tinTx.auto_evolution_enabled !== 1\r\n\t\t\t\t\t\t? `资源 ${candidate.resource_id} 在生效期间被停用`\r\n\t\t\t\t\t\t: `生效期间指向已由 ${input.expectedEffectiveVersion} 变为 ${inTx.effective_version ?? \"（空）\"}`,\r\n\t\t\t\t...(inTx.effective_version === null ? {} : { currentEffectiveVersion: inTx.effective_version }),\r\n\t\t\t} as MemoryResult<ActivateResult | ActivateConflict>;\r\n\t\t}\r\n\r\n\t\tconst activationId = `act-${randomUUID()}`;\r\n\t\t// kind 复用 'publish'（不改表 CHECK）；activation='effective' 区分落盘凭据。\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`INSERT INTO evolution_activations (\r\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\r\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\r\n\t\t\t)\r\n\t\t\t.run(\r\n\t\t\t\tactivationId,\r\n\t\t\t\tcandidate.resource_id,\r\n\t\t\t\tinput.expectedEffectiveVersion,\r\n\t\t\t\tversionId,\r\n\t\t\t\tinput.reason ?? `生效候选 ${input.candidateId}（验证 ${latestValidation.validation_id}）`,\r\n\t\t\t\tJSON.stringify({\r\n\t\t\t\t\tactivation: \"effective\",\r\n\t\t\t\t\tcandidateId: input.candidateId,\r\n\t\t\t\t\tvalidationId: latestValidation.validation_id,\r\n\t\t\t\t\t...(input.authRef === undefined ? {} : { authRef: input.authRef }),\r\n\t\t\t\t}),\r\n\t\t\t\tnow,\r\n\t\t\t);\r\n\t\tstore.db\r\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\r\n\t\t\t.run(versionId, now, candidate.resource_id);\r\n\t\t// S9-06：生效成功同事务记 patched 观察（生效历史的一部分，\r\n\t\t// 与 activation 行/effective_version 指向同生同死）。\r\n\t\tconst patched = recordPatched(store, {\r\n\t\t\tresourceId: candidate.resource_id,\r\n\t\t\tversionId,\r\n\t\t\tcandidateId: input.candidateId,\r\n\t\t\tcreatedAt: now,\r\n\t\t});\r\n\t\tif (!patched.ok) {\r\n\t\t\t// recordPatched 只有 INSERT，理论上不返回业务错误；\r\n\t\t\t// 真返回属异常，直接 throw 让事务回滚，不留半份生效。\r\n\t\t\tthrow new Error(`patched 观察写入失败:${patched.error.message}`);\r\n\t\t}\r\n\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tversionId,\r\n\t\t\tactivationId,\r\n\t\t\tfromVersion: input.expectedEffectiveVersion,\r\n\t\t} as MemoryResult<ActivateResult | ActivateConflict>;\r\n\t});\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 4. rollbackResource\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 事务回退：当前指向仍是 badVersion 时切回 previousVersion。\r\n *\r\n * 本批只实现执行入口（退步判定归批 D）：\r\n * - 资源存在；当前 effective_version === badVersion（已不是它 → no_change，\r\n *   不覆盖回退期间已生效的其他修复）；\r\n * - 同事务：UPDATE effective_version→previousVersion + INSERT kind='rollback'\r\n *   activation（from=badVersion、to=previousVersion、source_links_json 带\r\n *   sourceIds）+ UPDATE 坏版 publish 凭据 reason 前缀「停用:」。\r\n * 事务不含模型/进程调用；previousVersion 不核对目录（调用方给的是已发布过的有效版）。\r\n */\r\nexport function rollbackResource(\r\n\tstore: MemoryStore,\r\n\tinput: RollbackResourceInput,\r\n): MemoryResult<RollbackResult> {\r\n\tconst now = input.createdAt ?? new Date().toISOString();\r\n\r\n\tconst resource = getResourceRow(store, input.resourceId);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\r\n\t}\r\n\r\n\treturn store.transaction(() => {\r\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\r\n\t\tif (inTx.effective_version !== input.badVersion) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"no_change\",\r\n\t\t\t\t...(inTx.effective_version === null ? {} : { currentEffectiveVersion: inTx.effective_version }),\r\n\t\t\t\treason: `当前指向已是 ${inTx.effective_version ?? \"（空）\"}，不是 ${input.badVersion}——另一修复已生效，不覆盖`,\r\n\t\t\t} as MemoryResult<RollbackResult>;\r\n\t\t}\r\n\r\n\t\tconst activationId = `act-${randomUUID()}`;\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`INSERT INTO evolution_activations (\r\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\r\n\t\t\t\t) VALUES (?, ?, ?, ?, 'rollback', ?, ?, ?)`,\r\n\t\t\t)\r\n\t\t\t.run(\r\n\t\t\t\tactivationId,\r\n\t\t\t\tinput.resourceId,\r\n\t\t\t\tinput.badVersion,\r\n\t\t\t\tinput.previousVersion,\r\n\t\t\t\tinput.reason,\r\n\t\t\t\tJSON.stringify({ sourceIds: input.sourceIds }),\r\n\t\t\t\tnow,\r\n\t\t\t);\r\n\t\tstore.db\r\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\r\n\t\t\t.run(input.previousVersion, now, input.resourceId);\r\n\t\t// 停用失败版：在 publish 凭据 reason 前加「停用:」标，不改指向语义。\r\n\t\t// activations 行的 reason 属生效历史修订，更新它不算破坏版本文件不可原位修改。\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`UPDATE evolution_activations\r\n\t\t\t\t SET reason = CASE\r\n\t\t\t\t\t WHEN reason IS NULL OR reason NOT LIKE '停用:%' THEN '停用:' || COALESCE(reason, '')\r\n\t\t\t\t\t ELSE reason\r\n\t\t\t\t END\r\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'`,\r\n\t\t\t)\r\n\t\t\t.run(input.resourceId, input.badVersion);\r\n\r\n\t\treturn { ok: true, status: \"rolled_back\", activationId } as MemoryResult<RollbackResult>;\r\n\t});\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 5. getEffectiveVersion\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 当前生效版本查询：返回 versionId + 指向目录是否完整可读。\r\n * 目录缺失/为空时 available=false（旧指向可能是快照目录而非发布凭据版本，\r\n * 调用方据此判断能否实际加载）。\r\n */\r\nexport function getEffectiveVersion(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tpaoHome: string,\r\n): MemoryResult<EffectiveVersionInfo> {\r\n\tconst resource = getResourceRow(store, resourceId);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\r\n\t}\r\n\tif (resource.effective_version === null) {\r\n\t\treturn { ok: true, available: false };\r\n\t}\r\n\tconst versionDir = join(\r\n\t\tevolutionPaths(paoHome).versions,\r\n\t\tdirSafeId(resourceId),\r\n\t\tresource.effective_version,\r\n\t);\r\n\tconst available = isVersionDirComplete(versionDir, resource.effective_version);\r\n\treturn {\r\n\t\tok: true,\r\n\t\tversionId: resource.effective_version,\r\n\t\tavailable,\r\n\t\tversionDir,\r\n\t};\r\n}\r\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\r\n\n * 受控自进化版本生效与回退事务（S9-02/03）。 * 职责： * - `activateCandidate`：前置核对（事务外快筛 + 事务内重读确认）后单事务 *   UPDATE `evolution_resources.effective_version` + INSERT `evolution_activations`。 * - `rollbackResource`：事务体执行回退——当前指向仍是坏版才切回上一版； *   退步判定（哪些证据算 regression）归批 D，本模块只暴露执行入口。 * - `getEffectiveVersion`：当前生效 versionId + 目录存在性。 * 契约（S9 任务书 §5）： * - 生效凭据复用 `kind='publish'` 行（批 A 已建表 CHECK('publish','restore','rollback')， *   不改表）；落盘凭据 vs 生效凭据由 `source_links_json.activation` 区分： *   `published`（候选已固化进版本目录）vs `effective`（已切指向）。 *   判生效行时按 kind='publish' + activation='effective' 过滤，不看 reason 文案。 * - 事务内不含模型调用或进程执行；只记已完整发布的版本路径。 * - 核对口径：expectedEffectiveVersion === effective_version === 候选 baseVersion； *   授权未收回（auto_evolution_enabled）；最新验证仍 passed 且同一条； *   资源根当前指纹 === baseVersion 快照指纹（重算 sha256 清单哈希，与 *   snapshotResourceFiles 同口径，不复制磁盘内容，只在内存比对）； *   候选/冻结计划/验证三方各自的 evolution_source_links 行仍在 *   （关联缺失或引用的记忆行已不存在 → 依据失效 → 标待重评估）。 * - 任一前置不满足 → `{status:\"conflict\"}`：保留旧指向，并沿 *   markStaleCandidates 口径把同资源同 baseVersion 的未终态候选标 cancelled *   待重评估（旧候选不得直接重新排发布；本候选保持 passed 终态不再出库）。 * - `rollbackResource` 只在前置（资源存在、当前指向仍是 badVersion）成立时写： *   同事务 UPDATE effective_version→previousVersion + INSERT activation *   kind='rollback' + UPDATE 坏版 publish 凭据的 reason 前缀「停用:」 *   （activations 行不可原位修改语义指版本文件不被覆盖，reason 标停用 *   属生效历史修订，不扩表）。指向已非 badVersion → no_change，不覆盖其他已生效修复。 */import { randomUUID } from \"node:crypto\";import { existsSync, statSync } from \"node:fs\";import { join } from \"node:path\";import type { MemoryError, MemoryResult } from \"../memory/types.ts\";import type { MemoryStore } from \"../memory/store.ts\";import { evolutionPaths } from \"../memory/paths.ts\";import { checkOwnerSourceLinksIntact, recordPatched } from \"./observe.ts\";import { fingerprintResourceRoot } from \"./versions.ts\";\r\n\r\n\n\n// ════════════════════════════════════════════════════════════════════════// 1. 输入输出契约/** `activateCandidate` 的输入。 */export interface ActivateCandidateInput {\t/** 已发布成固定版本的候选 ID。 */\tcandidateId: string;\t/** 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突）。 */\texpectedEffectiveVersion: string;\t/** PAO_HOME 根。 */\tpaoHome: string;\t/** 生效授权引用（宿主侧的批准凭据身份，记入 source_links_json.authRef）。 */\tauthRef?: string;\t/** 生效原因（人读，记入 activation.reason）。 */\treason?: string;\t/** 生效时间（夹具注入；缺省取当前）。 */\tcreatedAt?: string;}/** `activateCandidate` 的成功输出。 */export interface ActivateResult {\t/** 生效后的版本 ID（= 该候选的 publish 凭据 to_version）。 */\tversionId: string;\t/** 本次写入的 activation 行 ID（kind='publish'，activation='effective'）。 */\tactivationId: string;\t/** 生效前指向（= 候选 baseVersion）。 */\tfromVersion: string;/** `activateCandidate` 的冲突输出（业务拒绝，不是系统错误）。 */export interface ActivateConflict {\tstatus: \"conflict\";\t/** 冲突原因（前置核对失败的逐条说明）。 */\treason: string;\t/** 资源当前实际生效版本（供调用方重取后继续判断；资源行缺失时缺省）。 */\tcurrentEffectiveVersion?: string;/** `rollbackResource` 的输入。 */export interface RollbackResourceInput {\tresourceId: string;\t/** 被判退步的版本（当前指向必须是它才执行回退）。 */\tbadVersion: string;\t/** 回退目标（上一有效版）。 */\tpreviousVersion: string;\t/** 退步证据来源 ID（记入 rollback 行的 source_links_json）。 */\tsourceIds: string[];\t/** 回退原因（人读）。 */\t/** 回退时间（夹具注入；缺省取当前）。 *//** `rollbackResource` 的输出。 */export type RollbackResult =\t| {\t\t\tstatus: \"rolled_back\";\t\t\t/** 本次写入的 rollback activation ID。 */\t\t\tactivationId: string;\t  }\t\t\t/** 当前指向已不是 badVersion：另一修复已生效，不覆盖。 */\t\t\tstatus: \"no_change\";\t\t\tcurrentEffectiveVersion?: string;\t\t\treason: string;\t  };/** `getEffectiveVersion` 的输出。 */export interface EffectiveVersionInfo {\t/** 当前生效版本 ID（未设过 effective_version 时缺省）。 */\tversionId?: string;\t/** 指向版本目录是否存在且非空（无指向时为 false）。 */\tavailable: boolean;\t/** 指向版本目录绝对路径（有指向时给出，不论存在与否）。 */\tversionDir?: string;// 2. 内部：行读取与指纹function fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };/** 把 resourceId 转为目录安全名（`:` → `_`，与 versions.ts 同规则）。 */function dirSafeId(resourceId: string): string {\treturn resourceId.replace(/:/g, \"_\"); * 目录指纹 = `v-{sha256(文件清单[路径,sha256])前12位}`，与 snapshotResourceFiles * 同口径：只重算哈希比对，不把快照文件复制到版本目录（本模块是核对不是快照）。 * O12/E12：三处私有重复收拢为 versions.ts 的 fingerprintResourceRoot 共享实现； * 本模块仍要求「目录形态」——文件型根不支持，激活判据只认目录型版本底座。function fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\treturn fingerprintResourceRoot(root); * 版本目录完整性核对。versionId 即内容清单哈希（`v-{sha12}`）， * 重算目录指纹与版本号比对：文件被删/被改都会改变指纹——比只数文件更严。 * 非哈希形 versionId（理论上不会出现：snapshot/publish 都是 v-sha12）退化为非空核对。function isVersionDirComplete(versionDir: string, versionId: string): boolean {\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\tconst current = fingerprintDirectory(versionDir);\tif (current.fileCount === 0) return false;\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;interface ResourceRow {\tresource_id: string;\trelative_root: string;\teffective_version: string | null;\tauto_evolution_enabled: number;interface CandidateRow {\tcandidate_id: string;\tproblem_id: string;\tbase_version: string;\ttest_plan_id: string;\tstatus: string;function getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\treturn store.db\t\t.prepare(\t\t\t`SELECT resource_id, relative_root, effective_version, auto_evolution_enabled\t\t\t FROM evolution_resources WHERE resource_id = ?`,\t\t)\t\t.get(resourceId) as ResourceRow | undefined;function getCandidateRow(store: MemoryStore, candidateId: string): CandidateRow | undefined {\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\t\t.get(candidateId) as CandidateRow | undefined;function getLatestValidation(\tstore: MemoryStore,\tcandidateId: string,): { validation_id: string; verdict: string; created_at: string } | undefined {\t\t\t`SELECT validation_id, verdict, created_at FROM evolution_validations\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\t\t.get(candidateId) as { validation_id: string; verdict: string; created_at: string } | undefined;interface ActivationRow {\tactivation_id: string;\tfrom_version: string | null;\tto_version: string;\tkind: string;\tsource_links_json: string | null;\tcreated_at: string;/** 查该候选的 publish-落盘凭据（取最新一条带 candidateId 的 kind='publish' 行）。 */function getPublishCredentialForCandidate(\tresourceId: string,): ActivationRow | undefined {\tconst rows = store.db\t\t\t`SELECT activation_id, from_version, to_version, kind, source_links_json, created_at\t\t\t FROM evolution_activations\t\t\t WHERE resource_id = ? AND kind = 'publish'\t\t\t ORDER BY created_at DESC, activation_id DESC`,\t\t.all(resourceId) as unknown as ActivationRow[];\tfor (const row of rows) {\t\tif (row.source_links_json === null) continue;\t\ttry {\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\t\t\tif (links.candidateId === candidateId) return row;\t\t} catch {\t\t\t// 非 JSON 行跳过（不当作凭据）。\t}\treturn undefined; * 根基线（O13/E15）：资源根最后被同步到的版本。激活不回写资源根， * 根基线留在最初快照值——首轮 = 登记快照 baseVersion，由首个 * activation='effective' 凭据的 from_version 记档；无 effective 凭据 = * 未激活过，根基线=当前 effective_version（即登记快照本身，与首轮 * 「比资源根 vs base_version」等价）。返回 undefined = 连快照指向都没有， * 调用处跳过根基线核对。function getRootBaselineVersion(\tcurrentEffective: string | null,): string | undefined {\t\t\t`SELECT from_version, source_links_json FROM evolution_activations\t\t\t ORDER BY created_at ASC, activation_id ASC`,\t\t.all(resourceId) as unknown as Array<{ from_version: string | null; source_links_json: string | null }>;\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\t\t\tif (links.activation === \"effective\") return row.from_version ?? undefined;\t\t\t// 非 JSON 行跳过。\treturn currentEffective ?? undefined; * 来源核对（契约 f，O12/E11 强化）： * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links： * - problem（owner_kind='problem', owner_id=candidate.problem_id）链加入核对—— *   候选从 problem 继承来源，只查候选自身 links 会绕过问题级失效； * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、 *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision； * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」， *   不再放行——正常登记必有至少一条 evidenceRef 写入 problem links。 * 返回失效说明（undefined = 来源仍有效）。 * O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享 * （publish 门/activation/control 同口径）。function checkSourceLinksIntact(\r\n\tstore: MemoryStore,candidate: CandidateRow,validationId: string,\r\n\treturn checkOwnerSourceLinksIntact(store.db, {\t\towners: [\t\t\t{ ownerKind: \"problem\", ownerId: candidate.problem_id, label: \"问题\" },\t\t\t{ ownerKind: \"candidate\", ownerId: candidate.candidate_id, label: \"候选\" },\t\t\t{ ownerKind: \"validation\", ownerId: candidate.test_plan_id, label: \"冻结计划\" },\t\t\t{ ownerKind: \"validation\", ownerId: validationId, label: \"验证\" },\t\t],\t}); * 标同资源同 baseVersion 的未终态候选待重评估（markStaleCandidates 同口径： * cancelled + failure_reason「基础版本已变动/依据失效，旧候选不得直接重新排发布」）。 * 本事务内执行；passed 终态候选不动。function markPendingCandidatesStale(\tbaseVersion: string,\treason: string,\tnow: string,): void {\tstore.db\t\t\t`UPDATE evolution_candidates\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\t\t\t WHERE resource_id = ? AND base_version = ? AND status IN ('proposed','testing')`,\t\t.run(`${reason}（依据失效，待重评估；旧候选不得直接重新排发布）`, now, resourceId, baseVersion);// 3. activateCandidate * 已发布候选的原子生效：前置核对（外读 + 事务内重读）→ 单事务切指向 + 写生效凭据。 * 前置核对（全部满足才进生效事务）： * a. 候选 status='passed' 且最新一条 validation verdict='passed'； * b. 已有 publish-落盘凭据（批 A 发布过），对应版本目录存在且非空； * c. 库内 effective_version === expectedEffectiveVersion === 候选 base_version； * d. auto_evolution_enabled 仍为 1； * e. 基线分离（O13/E15）：base_version 有完整版本目录时核对该目录指纹 *    （验证依据未被换），否则比资源根（首轮兼容）；另核资源根指纹 === *    根基线（首个 effective 凭据 from_version，无凭据时 = 当前 effective_version） *    ——人工改资源根 → 冲突； * f. 候选/冻结计划/最新验证的 source links 仍完整（依据未被删除排除）。 * 事务内重读 c/d（BEGIN IMMEDIATE 后到写入前的竞态窗）：任一不符即回滚， * 返回 conflict；生效写两条：INSERT kind='publish' + activation='effective' 的 * activation 行 + UPDATE effective_version。事务不含模型/进程调用。export async function activateCandidate(\tinput: ActivateCandidateInput,): Promise<MemoryResult<ActivateResult | ActivateConflict>> {\tconst now = input.createdAt ?? new Date().toISOString();\t// ── 事务外核对（先读；事务内再重读 c/d 防竞态）──────────────────────────\t// a. 候选存在 + passed + 最新验证 passed。\tconst candidate = getCandidateRow(store, input.candidateId);\tif (!candidate) {\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\tif (candidate.status !== \"passed\") {\t\treturn {\t\t\tok: true,\t\t\tstatus: \"conflict\",\t\t\treason: `候选 ${input.candidateId} 状态 ${candidate.status}，须为 passed 才能生效`,\t\t};\tconst latestValidation = getLatestValidation(store, input.candidateId);\tif (!latestValidation || latestValidation.verdict !== \"passed\") {\t\t\treason: latestValidation\t\t\t\t? `候选 ${input.candidateId} 最新验证判定 ${latestValidation.verdict}，须为 passed 才能生效`\t\t\t\t: `候选 ${input.candidateId} 无验证记录，须先完成验证`,\t// b. publish-落盘凭据 + 版本目录完整可读。\tconst publishAct = getPublishCredentialForCandidate(store, candidate.resource_id, input.candidateId);\tif (!publishAct) {\t\t\treason: `候选 ${input.candidateId} 尚无发布凭据（须先经 publishCandidate 固化成版本目录）`,\tconst versionId = publishAct.to_version;\tconst dirSafe = dirSafeId(candidate.resource_id);\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, versionId);\tif (!isVersionDirComplete(versionDir, versionId)) {\t\t\treason: `版本目录缺失或指纹不匹配:${versionDir}（versionId ${versionId} 是内容清单哈希，文件被删/改都会改变指纹；部分目录不构成可加载版本）`,\t// c/d（外读）：资源行 + 指向一致性 + 开关。\tconst resource = getResourceRow(store, candidate.resource_id);\tif (!resource) {\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\tif (resource.auto_evolution_enabled !== 1) {\t\t\treason: `资源 ${candidate.resource_id} 已停用自动进化，生效须先恢复授权`,\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\tif (resource.effective_version !== input.expectedEffectiveVersion) {\t\t\treason: `expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ${resource.effective_version ?? \"（空）\"} 不一致`,\tif (candidate.base_version !== input.expectedEffectiveVersion) {\t\t\treason: `候选 base_version ${candidate.base_version} 与 expectedEffectiveVersion ${input.expectedEffectiveVersion} 不一致（验证基础已过期）`,\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\t// e. 基线分离（O13/E15）：分清「验证基线」与「根基线」两个核对——\t//    验证基线 = candidate.base_version：它已是已发布版本（存在完整\t//    versions/<dirSafe>/<baseVersion>/ 目录）时，验证依据是版本目录正文，\t//    核对**该目录**指纹 === baseVersion，不要求资源根等于它（第二轮起\t//    资源根停在最初快照值，与 base_version 必然不等，不能混为一谈）；\t//    版本目录不存在时退回比资源根（首轮兼容：此时 base_version 就是根快照）。\t//    根基线 = 资源根最后被同步到的版本（getRootBaselineVersion）：根指纹\t//    vs 根基线不一致 = 用户现场被人工改 → conflict。两个核对都过才进事务：\t//    「验证对象没被换」由版本目录守住；「用户现场被人工改」由根基线守住。\tconst resourceRoot = join(input.paoHome, resource.relative_root);\tconst baseVersionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, candidate.base_version);\tif (isVersionDirComplete(baseVersionDir, candidate.base_version)) {\t\t// base_version 已是已发布版本：版本目录即验证依据（versionId 即清单哈希，\t\t// isVersionDirComplete 已核对该目录指纹 === baseVersion，无需重复比对）。\t} else {\t\t// 首轮兼容：base_version 是根快照（无版本目录），比资源根。\t\tconst current = fingerprintDirectory(resourceRoot);\t\tif (current.versionId !== candidate.base_version) {\t\t\treturn {\t\t\t\tok: true,\t\t\t\tstatus: \"conflict\",\t\t\t\treason:\t\t\t\t\t`资源当前文件指纹 ${current.versionId}（${current.fileCount} 个文件）与 base_version ` +\t\t\t\t\t`${candidate.base_version} 不一致——验证期资源被人改动，旧版保留，待重评估`,\t\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\t\t\t};\tconst rootBaseline = getRootBaselineVersion(store, candidate.resource_id, resource.effective_version);\tif (rootBaseline !== undefined) {\t\tconst rootCurrent = fingerprintDirectory(resourceRoot);\t\tif (rootCurrent.versionId !== rootBaseline) {\t\t\t\t\t`资源根当前文件指纹 ${rootCurrent.versionId}（${rootCurrent.fileCount} 个文件）与根基线 ` +\t\t\t\t\t`${rootBaseline} 不一致——用户现场资源根被人工改动，旧版保留，待重评估`,\t// f. 候选/冻结计划/最新验证的 source links 仍在，引用记忆未被删除。\tconst sourceViolation = checkSourceLinksIntact(store, candidate, latestValidation.validation_id);\tif (sourceViolation !== undefined) {\t\t\treason: `来源依据失效：${sourceViolation}`,\t// ── 生效事务（BEGIN IMMEDIATE；内重读 c/d 确认到写入前仍成立）──────────\treturn store.transaction(() => {\t\tconst inTx = getResourceRow(store, candidate.resource_id);\t\tif (!inTx) {\t\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\r\n\t\t\tinTx.effective_version !== input.expectedEffectiveVersion ||inTx.auto_evolution_enabled !== 1) {\t\t\t// 竞态冲突：保留旧指向；同 baseVersion 未终态候选标待重评估。\t\t\tmarkPendingCandidatesStale(\n\t\t\t\tstore,candidate.resource_id,candidate.base_version,\"生效期间指向或授权被改\",now,\n\t\t\t);\t\t\t\t\tinTx.auto_evolution_enabled !== 1\t\t\t\t\t\t? `资源 ${candidate.resource_id} 在生效期间被停用`\t\t\t\t\t\t: `生效期间指向已由 ${input.expectedEffectiveVersion} 变为 ${inTx.effective_version ?? \"（空）\"}`,\t\t\t\t...(inTx.effective_version === null ? {} : { currentEffectiveVersion: inTx.effective_version }),\t\t\t} as MemoryResult<ActivateResult | ActivateConflict>;\t\tconst activationId = `act-${randomUUID()}`;\t\t// kind 复用 'publish'（不改表 CHECK）；activation='effective' 区分落盘凭据。\t\tstore.db\t\t\t.prepare(\t\t\t\t`INSERT INTO evolution_activations (\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\t\t\t)\t\t\t.run(\t\t\t\tactivationId,\t\t\t\tcandidate.resource_id,\t\t\t\tinput.expectedEffectiveVersion,\t\t\t\tversionId,\t\t\t\tinput.reason ?? `生效候选 ${input.candidateId}（验证 ${latestValidation.validation_id}）`,\t\t\t\tJSON.stringify({\t\t\t\t\tactivation: \"effective\",\t\t\t\t\tcandidateId: input.candidateId,\t\t\t\t\tvalidationId: latestValidation.validation_id,\t\t\t\t\t...(input.authRef === undefined ? {} : { authRef: input.authRef }),\t\t\t\t}),\t\t\t\tnow,\t\t\t);\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\t\t\t.run(versionId, now, candidate.resource_id);\t\t// S9-06：生效成功同事务记 patched 观察（生效历史的一部分，\t\t// 与 activation 行/effective_version 指向同生同死）。\t\tconst patched = recordPatched(store, {\t\t\tresourceId: candidate.resource_id,\t\t\tversionId,\t\t\tcandidateId: input.candidateId,\t\t\tcreatedAt: now,\t\t});\t\tif (!patched.ok) {\t\t\t// recordPatched 只有 INSERT，理论上不返回业务错误；\t\t\t// 真返回属异常，直接 throw 让事务回滚，不留半份生效。\t\t\tthrow new Error(`patched 观察写入失败:${patched.error.message}`);\t\t\tactivationId,\t\t\tfromVersion: input.expectedEffectiveVersion,\t\t} as MemoryResult<ActivateResult | ActivateConflict>;// 4. rollbackResource * 事务回退：当前指向仍是 badVersion 时切回 previousVersion。 * 本批只实现执行入口（退步判定归批 D）： * - 资源存在；当前 effective_version === badVersion（已不是它 → no_change， *   不覆盖回退期间已生效的其他修复）； * - 同事务：UPDATE effective_version→previousVersion + INSERT kind='rollback' *   activation（from=badVersion、to=previousVersion、source_links_json 带 *   sourceIds）+ UPDATE 坏版 publish 凭据 reason 前缀「停用:」。 * 事务不含模型/进程调用；previousVersion 不核对目录（调用方给的是已发布过的有效版）。export function rollbackResource(input: RollbackResourceInput): MemoryResult<RollbackResult> {\tconst resource = getResourceRow(store, input.resourceId);\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\t\tconst inTx = getResourceRow(store, input.resourceId)!;\t\tif (inTx.effective_version !== input.badVersion) {\t\t\t\tstatus: \"no_change\",\t\t\t\treason: `当前指向已是 ${inTx.effective_version ?? \"（空）\"}，不是 ${input.badVersion}——另一修复已生效，不覆盖`,\t\t\t} as MemoryResult<RollbackResult>;\t\t\t\t) VALUES (?, ?, ?, ?, 'rollback', ?, ?, ?)`,\t\t\t\tinput.resourceId,\t\t\t\tinput.badVersion,\t\t\t\tinput.previousVersion,\t\t\t\tinput.reason,\t\t\t\tJSON.stringify({ sourceIds: input.sourceIds }),\t\t\t.run(input.previousVersion, now, input.resourceId);\t\t// 停用失败版：在 publish 凭据 reason 前加「停用:」标，不改指向语义。\t\t// activations 行的 reason 属生效历史修订，更新它不算破坏版本文件不可原位修改。\t\t\t\t`UPDATE evolution_activations\t\t\t\t SET reason = CASE\t\t\t\t\t WHEN reason IS NULL OR reason NOT LIKE '停用:%' THEN '停用:' || COALESCE(reason, '')\t\t\t\t\t ELSE reason\t\t\t\t END\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'`,\t\t\t.run(input.resourceId, input.badVersion);\t\treturn { ok: true, status: \"rolled_back\", activationId } as MemoryResult<RollbackResult>;// 5. getEffectiveVersion * 当前生效版本查询：返回 versionId + 指向目录是否完整可读。 * 目录缺失/为空时 available=false（旧指向可能是快照目录而非发布凭据版本， * 调用方据此判断能否实际加载）。export function getEffectiveVersion(\tpaoHome: string,): MemoryResult<EffectiveVersionInfo> {\tconst resource = getResourceRow(store, resourceId);\t\treturn fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\tif (resource.effective_version === null) {\t\treturn { ok: true, available: false };evolutionPaths(paoHome).versions,dirSafeId(resourceId),resource.effective_version,\r\n\t\tconst available = isVersionDirComplete(versionDir, resource.effective_version);\t\tok: true,\t\tversionId: resource.effective_version,\t\tavailable,\t\tversionDir,\t};","ops":[{"diffOp":{"equal":{"range":[0,3]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[6,68]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[6,8]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[68,80]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[80,176]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[176,263]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[263,361]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[361,454]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[454,526]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[68,70]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[526,560]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[560,663]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[663,755]}}},{"diffOp":{"delete":{"range":[3,5]}}},{"diffOp":{"insert":{"range":[5,6]}}},{"diffOp":{"equal":{"range":[755,842]}}},{"diffOp":{