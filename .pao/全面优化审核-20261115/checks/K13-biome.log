"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[23792,23831]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[23831,23883]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[15383,15400]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[23883,23959]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[11592,11594]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[23959,24002]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24002,24042]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[11592,11594]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[14932,14957]}}},{"diffOp":{"delete":{"range":[19163,19167]}}},{"diffOp":{"equal":{"range":[24042,24075]}}},{"diffOp":{"delete":{"range":[19163,19167]}}},{"diffOp":{"insert":{"range":[2304,2305]}}},{"diffOp":{"equal":{"range":[24075,24097]}}},{"diffOp":{"delete":{"range":[19163,19167]}}},{"diffOp":{"insert":{"range":[2304,2305]}}},{"diffOp":{"equal":{"range":[24097,24123]}}},{"diffOp":{"delete":{"range":[24123,24127]}}},{"diffOp":{"equal":{"range":[19482,19484]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24127,24207]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[5598,5607]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24207,24218]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24218,24258]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24258,24270]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24270,24283]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[24283,24286]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}},{"diffOp":{"equal":{"range":[3578,3579]}}},{"diffOp":{"delete":{"range":[2732,2734]}}},{"diffOp":{"insert":{"range":[2736,2737]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\activation.ts"},"span":null,"sourceCode":"/**\r\n * 受控自进化版本生效与回退事务（S9-02/03）。\r\n *\r\n * 职责：\r\n * - `activateCandidate`：前置核对（事务外快筛 + 事务内重读确认）后单事务\r\n *   UPDATE `evolution_resources.effective_version` + INSERT `evolution_activations`。\r\n * - `rollbackResource`：事务体执行回退——当前指向仍是坏版才切回上一版；\r\n *   退步判定（哪些证据算 regression）归批 D，本模块只暴露执行入口。\r\n * - `getEffectiveVersion`：当前生效 versionId + 目录存在性。\r\n *\r\n * 契约（S9 任务书 §5）：\r\n * - 生效凭据复用 `kind='publish'` 行（批 A 已建表 CHECK('publish','restore','rollback')，\r\n *   不改表）；落盘凭据 vs 生效凭据由 `source_links_json.activation` 区分：\r\n *   `published`（候选已固化进版本目录）vs `effective`（已切指向）。\r\n *   判生效行时按 kind='publish' + activation='effective' 过滤，不看 reason 文案。\r\n * - 事务内不含模型调用或进程执行；只记已完整发布的版本路径。\r\n * - 核对口径：expectedEffectiveVersion === effective_version === 候选 baseVersion；\r\n *   授权未收回（auto_evolution_enabled）；最新验证仍 passed 且同一条；\r\n *   资源根当前指纹 === baseVersion 快照指纹（重算 sha256 清单哈希，与\r\n *   snapshotResourceFiles 同口径，不复制磁盘内容，只在内存比对）；\r\n *   候选/冻结计划/验证三方各自的 evolution_source_links 行仍在\r\n *   （关联缺失或引用的记忆行已不存在 → 依据失效 → 标待重评估）。\r\n * - 任一前置不满足 → `{status:\"conflict\"}`：保留旧指向，并沿\r\n *   markStaleCandidates 口径把同资源同 baseVersion 的未终态候选标 cancelled\r\n *   待重评估（旧候选不得直接重新排发布；本候选保持 passed 终态不再出库）。\r\n * - `rollbackResource` 只在前置（资源存在、当前指向仍是 badVersion）成立时写：\r\n *   同事务 UPDATE effective_version→previousVersion + INSERT activation\r\n *   kind='rollback' + UPDATE 坏版 publish 凭据的 reason 前缀「停用:」\r\n *   （activations 行不可原位修改语义指版本文件不被覆盖，reason 标停用\r\n *   属生效历史修订，不扩表）。指向已非 badVersion → no_change，不覆盖其他已生效修复。\r\n */\r\nimport { randomUUID } from \"node:crypto\";\r\nimport { existsSync, statSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\r\nimport type { MemoryStore } from \"../memory/store.ts\";\r\nimport { evolutionPaths } from \"../memory/paths.ts\";\r\nimport { checkOwnerSourceLinksIntact, recordPatched } from \"./observe.ts\";\r\nimport { fingerprintResourceRoot } from \"./versions.ts\";\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 1. 输入输出契约\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/** `activateCandidate` 的输入。 */\r\nexport interface ActivateCandidateInput {\r\n\t/** 已发布成固定版本的候选 ID。 */\r\n\tcandidateId: string;\r\n\t/** 调用方持有的当前生效版本（CAS；与 effective_version 不一致即冲突）。 */\r\n\texpectedEffectiveVersion: string;\r\n\t/** PAO_HOME 根。 */\r\n\tpaoHome: string;\r\n\t/** 生效授权引用（宿主侧的批准凭据身份，记入 source_links_json.authRef）。 */\r\n\tauthRef?: string;\r\n\t/** 生效原因（人读，记入 activation.reason）。 */\r\n\treason?: string;\r\n\t/** 生效时间（夹具注入；缺省取当前）。 */\r\n\tcreatedAt?: string;\r\n}\r\n\r\n/** `activateCandidate` 的成功输出。 */\r\nexport interface ActivateResult {\r\n\t/** 生效后的版本 ID（= 该候选的 publish 凭据 to_version）。 */\r\n\tversionId: string;\r\n\t/** 本次写入的 activation 行 ID（kind='publish'，activation='effective'）。 */\r\n\tactivationId: string;\r\n\t/** 生效前指向（= 候选 baseVersion）。 */\r\n\tfromVersion: string;\r\n}\r\n\r\n/** `activateCandidate` 的冲突输出（业务拒绝，不是系统错误）。 */\r\nexport interface ActivateConflict {\r\n\tstatus: \"conflict\";\r\n\t/** 冲突原因（前置核对失败的逐条说明）。 */\r\n\treason: string;\r\n\t/** 资源当前实际生效版本（供调用方重取后继续判断；资源行缺失时缺省）。 */\r\n\tcurrentEffectiveVersion?: string;\r\n}\r\n\r\n/** `rollbackResource` 的输入。 */\r\nexport interface RollbackResourceInput {\r\n\tresourceId: string;\r\n\t/** 被判退步的版本（当前指向必须是它才执行回退）。 */\r\n\tbadVersion: string;\r\n\t/** 回退目标（上一有效版）。 */\r\n\tpreviousVersion: string;\r\n\t/** 退步证据来源 ID（记入 rollback 行的 source_links_json）。 */\r\n\tsourceIds: string[];\r\n\t/** 回退原因（人读）。 */\r\n\treason: string;\r\n\t/** 回退时间（夹具注入；缺省取当前）。 */\r\n\tcreatedAt?: string;\r\n}\r\n\r\n/** `rollbackResource` 的输出。 */\r\nexport type RollbackResult =\r\n\t| {\r\n\t\t\tstatus: \"rolled_back\";\r\n\t\t\t/** 本次写入的 rollback activation ID。 */\r\n\t\t\tactivationId: string;\r\n\t  }\r\n\t| {\r\n\t\t\t/** 当前指向已不是 badVersion：另一修复已生效，不覆盖。 */\r\n\t\t\tstatus: \"no_change\";\r\n\t\t\tcurrentEffectiveVersion?: string;\r\n\t\t\treason: string;\r\n\t  };\r\n\r\n/** `getEffectiveVersion` 的输出。 */\r\nexport interface EffectiveVersionInfo {\r\n\t/** 当前生效版本 ID（未设过 effective_version 时缺省）。 */\r\n\tversionId?: string;\r\n\t/** 指向版本目录是否存在且非空（无指向时为 false）。 */\r\n\tavailable: boolean;\r\n\t/** 指向版本目录绝对路径（有指向时给出，不论存在与否）。 */\r\n\tversionDir?: string;\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 2. 内部：行读取与指纹\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\r\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\r\n}\r\n\r\n/** 把 resourceId 转为目录安全名（`:` → `_`，与 versions.ts 同规则）。 */\r\nfunction dirSafeId(resourceId: string): string {\r\n\treturn resourceId.replace(/:/g, \"_\");\r\n}\r\n\r\n/**\r\n * 目录指纹 = `v-{sha256(文件清单[路径,sha256])前12位}`，与 snapshotResourceFiles\r\n * 同口径：只重算哈希比对，不把快照文件复制到版本目录（本模块是核对不是快照）。\r\n * O12/E12：三处私有重复收拢为 versions.ts 的 fingerprintResourceRoot 共享实现；\r\n * 本模块仍要求「目录形态」——文件型根不支持，激活判据只认目录型版本底座。\r\n */\r\nfunction fingerprintDirectory(root: string): { versionId: string; fileCount: number } {\r\n\treturn fingerprintResourceRoot(root);\r\n}\r\n\r\n/**\r\n * 版本目录完整性核对。versionId 即内容清单哈希（`v-{sha12}`），\r\n * 重算目录指纹与版本号比对：文件被删/被改都会改变指纹——比只数文件更严。\r\n * 非哈希形 versionId（理论上不会出现：snapshot/publish 都是 v-sha12）退化为非空核对。\r\n */\r\nfunction isVersionDirComplete(versionDir: string, versionId: string): boolean {\r\n\tif (!existsSync(versionDir) || !statSync(versionDir).isDirectory()) return false;\r\n\tconst current = fingerprintDirectory(versionDir);\r\n\tif (current.fileCount === 0) return false;\r\n\treturn /^v-[0-9a-f]{12}$/.test(versionId) ? current.versionId === versionId : true;\r\n}\r\n\r\ninterface ResourceRow {\r\n\tresource_id: string;\r\n\trelative_root: string;\r\n\teffective_version: string | null;\r\n\tauto_evolution_enabled: number;\r\n}\r\n\r\ninterface CandidateRow {\r\n\tcandidate_id: string;\r\n\tproblem_id: string;\r\n\tresource_id: string;\r\n\tbase_version: string;\r\n\ttest_plan_id: string;\r\n\tstatus: string;\r\n}\r\n\r\nfunction getResourceRow(store: MemoryStore, resourceId: string): ResourceRow | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT resource_id, relative_root, effective_version, auto_evolution_enabled\r\n\t\t\t FROM evolution_resources WHERE resource_id = ?`,\r\n\t\t)\r\n\t\t.get(resourceId) as ResourceRow | undefined;\r\n}\r\n\r\nfunction getCandidateRow(store: MemoryStore, candidateId: string): CandidateRow | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id, status\r\n\t\t\t FROM evolution_candidates WHERE candidate_id = ?`,\r\n\t\t)\r\n\t\t.get(candidateId) as CandidateRow | undefined;\r\n}\r\n\r\nfunction getLatestValidation(\r\n\tstore: MemoryStore,\r\n\tcandidateId: string,\r\n): { validation_id: string; verdict: string; created_at: string } | undefined {\r\n\treturn store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT validation_id, verdict, created_at FROM evolution_validations\r\n\t\t\t WHERE candidate_id = ? ORDER BY created_at DESC, validation_id DESC LIMIT 1`,\r\n\t\t)\r\n\t\t.get(candidateId) as { validation_id: string; verdict: string; created_at: string } | undefined;\r\n}\r\n\r\ninterface ActivationRow {\r\n\tactivation_id: string;\r\n\tfrom_version: string | null;\r\n\tto_version: string;\r\n\tkind: string;\r\n\tsource_links_json: string | null;\r\n\tcreated_at: string;\r\n}\r\n\r\n/** 查该候选的 publish-落盘凭据（取最新一条带 candidateId 的 kind='publish' 行）。 */\r\nfunction getPublishCredentialForCandidate(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tcandidateId: string,\r\n): ActivationRow | undefined {\r\n\tconst rows = store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT activation_id, from_version, to_version, kind, source_links_json, created_at\r\n\t\t\t FROM evolution_activations\r\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\r\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\r\n\t\t)\r\n\t\t.all(resourceId) as unknown as ActivationRow[];\r\n\tfor (const row of rows) {\r\n\t\tif (row.source_links_json === null) continue;\r\n\t\ttry {\r\n\t\t\tconst links = JSON.parse(row.source_links_json) as { candidateId?: string };\r\n\t\t\tif (links.candidateId === candidateId) return row;\r\n\t\t} catch {\r\n\t\t\t// 非 JSON 行跳过（不当作凭据）。\r\n\t\t}\r\n\t}\r\n\treturn undefined;\r\n}\r\n\r\n/**\r\n * 根基线（O13/E15）：资源根最后被同步到的版本。激活不回写资源根，\r\n * 根基线留在最初快照值——首轮 = 登记快照 baseVersion，由首个\r\n * activation='effective' 凭据的 from_version 记档；无 effective 凭据 =\r\n * 未激活过，根基线=当前 effective_version（即登记快照本身，与首轮\r\n * 「比资源根 vs base_version」等价）。返回 undefined = 连快照指向都没有，\r\n * 调用处跳过根基线核对。\r\n */\r\nfunction getRootBaselineVersion(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tcurrentEffective: string | null,\r\n): string | undefined {\r\n\tconst rows = store.db\r\n\t\t.prepare(\r\n\t\t\t`SELECT from_version, source_links_json FROM evolution_activations\r\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\r\n\t\t\t ORDER BY created_at ASC, activation_id ASC`,\r\n\t\t)\r\n\t\t.all(resourceId) as unknown as Array<{ from_version: string | null; source_links_json: string | null }>;\r\n\tfor (const row of rows) {\r\n\t\tif (row.source_links_json === null) continue;\r\n\t\ttry {\r\n\t\t\tconst links = JSON.parse(row.source_links_json) as { activation?: string };\r\n\t\t\tif (links.activation === \"effective\") return row.from_version ?? undefined;\r\n\t\t} catch {\r\n\t\t\t// 非 JSON 行跳过。\r\n\t\t}\r\n\t}\r\n\treturn currentEffective ?? undefined;\r\n}\r\n\r\n/**\r\n * 来源核对（契约 f，O12/E11 强化）：\r\n * 核对 problem→candidate→冻结计划→验证四级 owner 的 source links：\r\n * - problem（owner_kind='problem', owner_id=candidate.problem_id）链加入核对——\r\n *   候选从 problem 继承来源，只查候选自身 links 会绕过问题级失效；\r\n * - 每个 link 校验：sources 行仍在（src- 前缀才查）、source_exclusions 无命中、\r\n *   带 memory_id 的记忆行仍在且 current_revision ≥ link.revision；\r\n * - 空 links 集拒绝：problem 或其任一继承方没有任何 link 行时视为「必要来源缺失」，\r\n *   不再放行——正常登记必有至少一条 evidenceRef 写入 problem links。\r\n * 返回失效说明（undefined = 来源仍有效）。\r\n * O12/E11：核对本体收拢到 observe.ts checkOwnerSourceLinksIntact 共享\r\n * （publish 门/activation/control 同口径）。\r\n */\r\nfunction checkSourceLinksIntact(\r\n\tstore: MemoryStore,\r\n\tcandidate: CandidateRow,\r\n\tvalidationId: string,\r\n): string | undefined {\r\n\treturn checkOwnerSourceLinksIntact(store.db, {\r\n\t\towners: [\r\n\t\t\t{ ownerKind: \"problem\", ownerId: candidate.problem_id, label: \"问题\" },\r\n\t\t\t{ ownerKind: \"candidate\", ownerId: candidate.candidate_id, label: \"候选\" },\r\n\t\t\t{ ownerKind: \"validation\", ownerId: candidate.test_plan_id, label: \"冻结计划\" },\r\n\t\t\t{ ownerKind: \"validation\", ownerId: validationId, label: \"验证\" },\r\n\t\t],\r\n\t});\r\n}\r\n\r\n/**\r\n * 标同资源同 baseVersion 的未终态候选待重评估（markStaleCandidates 同口径：\r\n * cancelled + failure_reason「基础版本已变动/依据失效，旧候选不得直接重新排发布」）。\r\n * 本事务内执行；passed 终态候选不动。\r\n */\r\nfunction markPendingCandidatesStale(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tbaseVersion: string,\r\n\treason: string,\r\n\tnow: string,\r\n): void {\r\n\tstore.db\r\n\t\t.prepare(\r\n\t\t\t`UPDATE evolution_candidates\r\n\t\t\t SET status = 'cancelled', failure_reason = ?, updated_at = ?\r\n\t\t\t WHERE resource_id = ? AND base_version = ? AND status IN ('proposed','testing')`,\r\n\t\t)\r\n\t\t.run(`${reason}（依据失效，待重评估；旧候选不得直接重新排发布）`, now, resourceId, baseVersion);\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 3. activateCandidate\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 已发布候选的原子生效：前置核对（外读 + 事务内重读）→ 单事务切指向 + 写生效凭据。\r\n *\r\n * 前置核对（全部满足才进生效事务）：\r\n * a. 候选 status='passed' 且最新一条 validation verdict='passed'；\r\n * b. 已有 publish-落盘凭据（批 A 发布过），对应版本目录存在且非空；\r\n * c. 库内 effective_version === expectedEffectiveVersion === 候选 base_version；\r\n * d. auto_evolution_enabled 仍为 1；\r\n * e. 基线分离（O13/E15）：base_version 有完整版本目录时核对该目录指纹\r\n *    （验证依据未被换），否则比资源根（首轮兼容）；另核资源根指纹 ===\r\n *    根基线（首个 effective 凭据 from_version，无凭据时 = 当前 effective_version）\r\n *    ——人工改资源根 → 冲突；\r\n * f. 候选/冻结计划/最新验证的 source links 仍完整（依据未被删除排除）。\r\n *\r\n * 事务内重读 c/d（BEGIN IMMEDIATE 后到写入前的竞态窗）：任一不符即回滚，\r\n * 返回 conflict；生效写两条：INSERT kind='publish' + activation='effective' 的\r\n * activation 行 + UPDATE effective_version。事务不含模型/进程调用。\r\n */\r\nexport async function activateCandidate(\r\n\tstore: MemoryStore,\r\n\tinput: ActivateCandidateInput,\r\n): Promise<MemoryResult<ActivateResult | ActivateConflict>> {\r\n\tconst now = input.createdAt ?? new Date().toISOString();\r\n\r\n\t// ── 事务外核对（先读；事务内再重读 c/d 防竞态）──────────────────────────\r\n\r\n\t// a. 候选存在 + passed + 最新验证 passed。\r\n\tconst candidate = getCandidateRow(store, input.candidateId);\r\n\tif (!candidate) {\r\n\t\treturn fail(\"invalid_input\", `候选未登记:${input.candidateId}`, input.candidateId);\r\n\t}\r\n\tif (candidate.status !== \"passed\") {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 ${input.candidateId} 状态 ${candidate.status}，须为 passed 才能生效`,\r\n\t\t};\r\n\t}\r\n\tconst latestValidation = getLatestValidation(store, input.candidateId);\r\n\tif (!latestValidation || latestValidation.verdict !== \"passed\") {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: latestValidation\r\n\t\t\t\t? `候选 ${input.candidateId} 最新验证判定 ${latestValidation.verdict}，须为 passed 才能生效`\r\n\t\t\t\t: `候选 ${input.candidateId} 无验证记录，须先完成验证`,\r\n\t\t};\r\n\t}\r\n\r\n\t// b. publish-落盘凭据 + 版本目录完整可读。\r\n\tconst publishAct = getPublishCredentialForCandidate(store, candidate.resource_id, input.candidateId);\r\n\tif (!publishAct) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 ${input.candidateId} 尚无发布凭据（须先经 publishCandidate 固化成版本目录）`,\r\n\t\t};\r\n\t}\r\n\tconst versionId = publishAct.to_version;\r\n\tconst dirSafe = dirSafeId(candidate.resource_id);\r\n\tconst versionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, versionId);\r\n\tif (!isVersionDirComplete(versionDir, versionId)) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `版本目录缺失或指纹不匹配:${versionDir}（versionId ${versionId} 是内容清单哈希，文件被删/改都会改变指纹；部分目录不构成可加载版本）`,\r\n\t\t};\r\n\t}\r\n\r\n\t// c/d（外读）：资源行 + 指向一致性 + 开关。\r\n\tconst resource = getResourceRow(store, candidate.resource_id);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\r\n\t}\r\n\tif (resource.auto_evolution_enabled !== 1) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `资源 ${candidate.resource_id} 已停用自动进化，生效须先恢复授权`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\tif (resource.effective_version !== input.expectedEffectiveVersion) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `expectedEffectiveVersion ${input.expectedEffectiveVersion} 与当前指向 ${resource.effective_version ?? \"（空）\"} 不一致`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\tif (candidate.base_version !== input.expectedEffectiveVersion) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `候选 base_version ${candidate.base_version} 与 expectedEffectiveVersion ${input.expectedEffectiveVersion} 不一致（验证基础已过期）`,\r\n\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t};\r\n\t}\r\n\r\n\t// e. 基线分离（O13/E15）：分清「验证基线」与「根基线」两个核对——\r\n\t//    验证基线 = candidate.base_version：它已是已发布版本（存在完整\r\n\t//    versions/<dirSafe>/<baseVersion>/ 目录）时，验证依据是版本目录正文，\r\n\t//    核对**该目录**指纹 === baseVersion，不要求资源根等于它（第二轮起\r\n\t//    资源根停在最初快照值，与 base_version 必然不等，不能混为一谈）；\r\n\t//    版本目录不存在时退回比资源根（首轮兼容：此时 base_version 就是根快照）。\r\n\t//    根基线 = 资源根最后被同步到的版本（getRootBaselineVersion）：根指纹\r\n\t//    vs 根基线不一致 = 用户现场被人工改 → conflict。两个核对都过才进事务：\r\n\t//    「验证对象没被换」由版本目录守住；「用户现场被人工改」由根基线守住。\r\n\tconst resourceRoot = join(input.paoHome, resource.relative_root);\r\n\tconst baseVersionDir = join(evolutionPaths(input.paoHome).versions, dirSafe, candidate.base_version);\r\n\tif (isVersionDirComplete(baseVersionDir, candidate.base_version)) {\r\n\t\t// base_version 已是已发布版本：版本目录即验证依据（versionId 即清单哈希，\r\n\t\t// isVersionDirComplete 已核对该目录指纹 === baseVersion，无需重复比对）。\r\n\t} else {\r\n\t\t// 首轮兼容：base_version 是根快照（无版本目录），比资源根。\r\n\t\tconst current = fingerprintDirectory(resourceRoot);\r\n\t\tif (current.versionId !== candidate.base_version) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\t`资源当前文件指纹 ${current.versionId}（${current.fileCount} 个文件）与 base_version ` +\r\n\t\t\t\t\t`${candidate.base_version} 不一致——验证期资源被人改动，旧版保留，待重评估`,\r\n\t\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t\t};\r\n\t\t}\r\n\t}\r\n\tconst rootBaseline = getRootBaselineVersion(store, candidate.resource_id, resource.effective_version);\r\n\tif (rootBaseline !== undefined) {\r\n\t\tconst rootCurrent = fingerprintDirectory(resourceRoot);\r\n\t\tif (rootCurrent.versionId !== rootBaseline) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\t`资源根当前文件指纹 ${rootCurrent.versionId}（${rootCurrent.fileCount} 个文件）与根基线 ` +\r\n\t\t\t\t\t`${rootBaseline} 不一致——用户现场资源根被人工改动，旧版保留，待重评估`,\r\n\t\t\t\tcurrentEffectiveVersion: resource.effective_version ?? undefined,\r\n\t\t\t};\r\n\t\t}\r\n\t}\r\n\r\n\t// f. 候选/冻结计划/最新验证的 source links 仍在，引用记忆未被删除。\r\n\tconst sourceViolation = checkSourceLinksIntact(store, candidate, latestValidation.validation_id);\r\n\tif (sourceViolation !== undefined) {\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tstatus: \"conflict\",\r\n\t\t\treason: `来源依据失效：${sourceViolation}`,\r\n\t\t\t...(resource.effective_version === null ? {} : { currentEffectiveVersion: resource.effective_version }),\r\n\t\t};\r\n\t}\r\n\r\n\t// ── 生效事务（BEGIN IMMEDIATE；内重读 c/d 确认到写入前仍成立）──────────\r\n\r\n\treturn store.transaction(() => {\r\n\t\tconst inTx = getResourceRow(store, candidate.resource_id);\r\n\t\tif (!inTx) {\r\n\t\t\treturn fail(\"invalid_input\", `资源未登记:${candidate.resource_id}`, candidate.resource_id);\r\n\t\t}\r\n\t\tif (\r\n\t\t\tinTx.effective_version !== input.expectedEffectiveVersion ||\r\n\t\t\tinTx.auto_evolution_enabled !== 1\r\n\t\t) {\r\n\t\t\t// 竞态冲突：保留旧指向；同 baseVersion 未终态候选标待重评估。\r\n\t\t\tmarkPendingCandidatesStale(store, candidate.resource_id, candidate.base_version, \"生效期间指向或授权被改\", now);\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"conflict\",\r\n\t\t\t\treason:\r\n\t\t\t\t\tinTx.auto_evolution_enabled !== 1\r\n\t\t\t\t\t\t? `资源 ${candidate.resource_id} 在生效期间被停用`\r\n\t\t\t\t\t\t: `生效期间指向已由 ${input.expectedEffectiveVersion} 变为 ${inTx.effective_version ?? \"（空）\"}`,\r\n\t\t\t\t...(inTx.effective_version === null ? {} : { currentEffectiveVersion: inTx.effective_version }),\r\n\t\t\t} as MemoryResult<ActivateResult | ActivateConflict>;\r\n\t\t}\r\n\r\n\t\tconst activationId = `act-${randomUUID()}`;\r\n\t\t// kind 复用 'publish'（不改表 CHECK）；activation='effective' 区分落盘凭据。\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`INSERT INTO evolution_activations (\r\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\r\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\r\n\t\t\t)\r\n\t\t\t.run(\r\n\t\t\t\tactivationId,\r\n\t\t\t\tcandidate.resource_id,\r\n\t\t\t\tinput.expectedEffectiveVersion,\r\n\t\t\t\tversionId,\r\n\t\t\t\tinput.reason ?? `生效候选 ${input.candidateId}（验证 ${latestValidation.validation_id}）`,\r\n\t\t\t\tJSON.stringify({\r\n\t\t\t\t\tactivation: \"effective\",\r\n\t\t\t\t\tcandidateId: input.candidateId,\r\n\t\t\t\t\tvalidationId: latestValidation.validation_id,\r\n\t\t\t\t\t...(input.authRef === undefined ? {} : { authRef: input.authRef }),\r\n\t\t\t\t}),\r\n\t\t\t\tnow,\r\n\t\t\t);\r\n\t\tstore.db\r\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\r\n\t\t\t.run(versionId, now, candidate.resource_id);\r\n\t\t// S9-06：生效成功同事务记 patched 观察（生效历史的一部分，\r\n\t\t// 与 activation 行/effective_version 指向同生同死）。\r\n\t\tconst patched = recordPatched(store, {\r\n\t\t\tresourceId: candidate.resource_id,\r\n\t\t\tversionId,\r\n\t\t\tcandidateId: input.candidateId,\r\n\t\t\tcreatedAt: now,\r\n\t\t});\r\n\t\tif (!patched.ok) {\r\n\t\t\t// recordPatched 只有 INSERT，理论上不返回业务错误；\r\n\t\t\t// 真返回属异常，直接 throw 让事务回滚，不留半份生效。\r\n\t\t\tthrow new Error(`patched 观察写入失败:${patched.error.message}`);\r\n\t\t}\r\n\r\n\t\treturn {\r\n\t\t\tok: true,\r\n\t\t\tversionId,\r\n\t\t\tactivationId,\r\n\t\t\tfromVersion: input.expectedEffectiveVersion,\r\n\t\t} as MemoryResult<ActivateResult | ActivateConflict>;\r\n\t});\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 4. rollbackResource\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 事务回退：当前指向仍是 badVersion 时切回 previousVersion。\r\n *\r\n * 本批只实现执行入口（退步判定归批 D）：\r\n * - 资源存在；当前 effective_version === badVersion（已不是它 → no_change，\r\n *   不覆盖回退期间已生效的其他修复）；\r\n * - 同事务：UPDATE effective_version→previousVersion + INSERT kind='rollback'\r\n *   activation（from=badVersion、to=previousVersion、source_links_json 带\r\n *   sourceIds）+ UPDATE 坏版 publish 凭据 reason 前缀「停用:」。\r\n * 事务不含模型/进程调用；previousVersion 不核对目录（调用方给的是已发布过的有效版）。\r\n */\r\nexport function rollbackResource(\r\n\tstore: MemoryStore,\r\n\tinput: RollbackResourceInput,\r\n): MemoryResult<RollbackResult> {\r\n\tconst now = input.createdAt ?? new Date().toISOString();\r\n\r\n\tconst resource = getResourceRow(store, input.resourceId);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${input.resourceId}`, input.resourceId);\r\n\t}\r\n\r\n\treturn store.transaction(() => {\r\n\t\tconst inTx = getResourceRow(store, input.resourceId)!;\r\n\t\tif (inTx.effective_version !== input.badVersion) {\r\n\t\t\treturn {\r\n\t\t\t\tok: true,\r\n\t\t\t\tstatus: \"no_change\",\r\n\t\t\t\t...(inTx.effective_version === null ? {} : { currentEffectiveVersion: inTx.effective_version }),\r\n\t\t\t\treason: `当前指向已是 ${inTx.effective_version ?? \"（空）\"}，不是 ${input.badVersion}——另一修复已生效，不覆盖`,\r\n\t\t\t} as MemoryResult<RollbackResult>;\r\n\t\t}\r\n\r\n\t\tconst activationId = `act-${randomUUID()}`;\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`INSERT INTO evolution_activations (\r\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\r\n\t\t\t\t) VALUES (?, ?, ?, ?, 'rollback', ?, ?, ?)`,\r\n\t\t\t)\r\n\t\t\t.run(\r\n\t\t\t\tactivationId,\r\n\t\t\t\tinput.resourceId,\r\n\t\t\t\tinput.badVersion,\r\n\t\t\t\tinput.previousVersion,\r\n\t\t\t\tinput.reason,\r\n\t\t\t\tJSON.stringify({ sourceIds: input.sourceIds }),\r\n\t\t\t\tnow,\r\n\t\t\t);\r\n\t\tstore.db\r\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\r\n\t\t\t.run(input.previousVersion, now, input.resourceId);\r\n\t\t// 停用失败版：在 publish 凭据 reason 前加「停用:」标，不改指向语义。\r\n\t\t// activations 行的 reason 属生效历史修订，更新它不算破坏版本文件不可原位修改。\r\n\t\tstore.db\r\n\t\t\t.prepare(\r\n\t\t\t\t`UPDATE evolution_activations\r\n\t\t\t\t SET reason = CASE\r\n\t\t\t\t\t WHEN reason IS NULL OR reason NOT LIKE '停用:%' THEN '停用:' || COALESCE(reason, '')\r\n\t\t\t\t\t ELSE reason\r\n\t\t\t\t END\r\n\t\t\t\t WHERE resource_id = ? AND to_version = ? AND kind = 'publish'`,\r\n\t\t\t)\r\n\t\t\t.run(input.resourceId, input.badVersion);\r\n\r\n\t\treturn { ok: true, status: \"rolled_back\", activationId } as MemoryResult<RollbackResult>;\r\n\t});\r\n}\r\n\r\n// ════════════════════════════════════════════════════════════════════════\r\n// 5. getEffectiveVersion\r\n// ════════════════════════════════════════════════════════════════════════\r\n\r\n/**\r\n * 当前生效版本查询：返回 versionId + 指向目录是否完整可读。\r\n * 目录缺失/为空时 available=false（旧指向可能是快照目录而非发布凭据版本，\r\n * 调用方据此判断能否实际加载）。\r\n */\r\nexport function getEffectiveVersion(\r\n\tstore: MemoryStore,\r\n\tresourceId: string,\r\n\tpaoHome: string,\r\n): MemoryResult<EffectiveVersionInfo> {\r\n\tconst resource = getResourceRow(store, resourceId);\r\n\tif (!resource) {\r\n\t\treturn fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\r\n\t}\r\n\tif (resource.effective_version === null) {\r\n\t\treturn { ok: true, available: false };\r\n\t}\r\n\tconst versionDir = join(\r\n\t\tevolutionPaths(paoHome).versions,\r\n\t\tdirSafeId(resourceId),\r\n\t\tresource.effective_version,\r\n\t);\r\n\tconst available = isVersionDirComplete(versionDir, resource.effective_version);\r\n\treturn {\r\n\t\tok: true,\r\n\t\tversionId: resource.effective_version,\r\n\t\tavailable,\r\n\t\tversionDir,\r\n\t};\r\n}\r\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 受控自进化任务绑定（S9-04/05）。\n * */\nimport { randomUUID } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport type { MemoryError,MemoryResultevolutionPaths } from \"../memory/types.tspaths.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";{ MemoryError, MemoryResult\n\n// ════════════════════════════════════════════════════════════════════════\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,54]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[54,133]}}},{"diffOp":{"equal":{"range":[133,141]}}},{"diffOp":{"delete":{"range":[141,146]}}},{"diffOp":{"equal":{"range":[146,147]}}},{"diffOp":{"delete":{"range":[147,160]}}},{"diffOp":{"equal":{"range":[147,148]}}},{"diffOp":{"delete":{"range":[160,172]}}},{"diffOp":{"insert":{"range":[172,186]}}},{"diffOp":{"equal":{"range":[186,205]}}},{"diffOp":{"delete":{"range":[205,213]}}},{"diffOp":{"insert":{"range":[213,221]}}},{"diffOp":{"equal":{"range":[221,223]}}},{"diffOp":{"equal":{"range":[223,278]}}},{"diffOp":{"equal":{"range":[223,231]}}},{"diffOp":{"insert":{"range":[141,146]}}},{"diffOp":{"equal":{"range":[278,280]}}},{"diffOp":{"delete":{"range":[172,186]}}},{"diffOp":{"insert":{"range":[280,305]}}},{"diffOp":{"equal":{"range":[186,205]}}},{"diffOp":{"delete":{"range":[213,221]}}},{"diffOp":{"insert":{"range":[205,213]}}},{"diffOp":{"equal":{"range":[221,223]}}},{"diffOp":{"equal":{"range":[305,526]}}},{"equalLines":{"line_count":390}},{"diffOp":{"equal":{"range":[526,620]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\binding.ts"},"span":[1164,1205],"sourceCode":"/**\n * 受控自进化任务绑定（S9-04/05）。\n *\n * 职责：宿主创建/恢复任务前把 resourceId 解析成固定 versionId 落\n * `evolution_task_bindings`；运行中任务继续用绑定版本；安全点换版把\n * 前后值追加进 `switch_history_json`；任务结束/重绑前停旧绑定（active=0）。\n *\n * 契约（S9 任务书 §5）：\n * - 任务绑定是宿主装配的解析结果：本模块只管数据契约，不碰 resource-loader\n *   装配（additionalSkillPaths/additionalExtensionPaths 挂接归宿主侧）。\n * - `UNIQUE(task_id, resource_id)`：同任务同资源重绑即更新（换版/复用同一行，\n *   历史换版沿 switch_history_json 追加不丢）。\n * - `resolveTaskResourceVersion` 只读绑定，返回该任务该用哪个版本目录；\n *   绑定不存在或已停用 → 业务错误，不静默回退到当前 effective_version\n *   （未绑定任务用资源的失败不归因，见 observe.ts recordUsed）。\n * - 运行中工具定义不漂移：绑定写定后 effective_version 再变也不影响本任务，\n *   只有 `switchTaskResourceAtSafePoint` 在安全点显式换版。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一条任务绑定（evolution_task_bindings 行的外读形态）。 */\nexport interface TaskBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定资源 ID。 */\n\tresourceId: string;\n\t/** 本任务固定使用的版本 ID（安全点换版后指向最新值）。 */\n\tversionId: string;\n\t/** 最近一次绑定/换版时间。 */\n\tboundAt: string;\n\t/** 是否仍在使用（false = 任务已结束或已被重绑停用）。 */\n\tactive: boolean;\n\t/** 安全点换版历史（按时间先后追加）。 */\n\tswitchHistory: TaskBindingSwitch[];\n}\n\n/** 一次安全点换版记录（switch_history_json 的单项）。 */\nexport interface TaskBindingSwitch {\n\t/** 换前版本。 */\n\tfrom: string;\n\t/** 换后版本。 */\n\tto: string;\n\t/** 换版原因（人读；如「阻塞修复后重载」「后台进化生效」）。 */\n\treason: string;\n\t/** 换版时间。 */\n\tat: string;\n}\n\ninterface TaskBindingRow {\n\tbinding_id: string;\n\ttask_id: string;\n\tresource_id: string;\n\tversion_id: string;\n\tbound_at: string;\n\tactive: number;\n\tswitch_history_json: string | null;\n}\n\nfunction rowToBinding(row: TaskBindingRow): TaskBinding {\n\tlet switchHistory: TaskBindingSwitch[] = [];\n\tif (row.switch_history_json !== null) {\n\t\ttry {\n\t\t\tconst parsed = JSON.parse(row.switch_history_json) as TaskBindingSwitch[];\n\t\t\tif (Array.isArray(parsed)) switchHistory = parsed;\n\t\t} catch {\n\t\t\t// 历史行损坏按空历史返回，不当作系统错误（绑定本身仍有效）。\n\t\t}\n\t}\n\treturn {\n\t\tbindingId: row.binding_id,\n\t\ttaskId: row.task_id,\n\t\tresourceId: row.resource_id,\n\t\tversionId: row.version_id,\n\t\tboundAt: row.bound_at,\n\t\tactive: row.active === 1,\n\t\tswitchHistory,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. bindTaskResources：任务开始前解析 effective_version → 落绑定\n// ════════════════════════════════════════════════════════════════════════\n\n/** `bindTaskResources` 的输入。 */\nexport interface BindTaskResourcesInput {\n\t/** 任务 ID（宿主生成）。 */\n\ttaskId: string;\n\t/** 本任务要固定版本的资源清单。 */\n\tresourceIds: string[];\n\t/** 关联会话 ID（审计定位；不进绑定表，只透传给调用方日志用）。 */\n\tsessionId?: string;\n\t/** 绑定时间（夹具注入；缺省取当前）。 */\n\tboundAt?: string;\n}\n\n/**\n * 任务开始时把每个 resourceId 解析成当前 effective_version 并落绑定。\n *\n * - 资源未登记或尚无 effective_version → 业务错误（invalid_input），\n *   整批不写（同事务）；调用方应先让资源过 snapshotResourceFiles 或 activation。\n * - `UNIQUE(task_id, resource_id)` 冲突即复用同一行：version_id 与 bound_at\n *   更新为新解析值，active 复位 1（重绑视为新绑定，旧 switch_history 保留追加）。\n * - 同事务批量写：任一资源解析失败即整体回滚，不留半套绑定。\n */\nexport function bindTaskResources(\n\tstore: MemoryStore,\n\tinput: BindTaskResourcesInput,\n): MemoryResult<{ bindings: TaskBinding[] }> {\n\tconst now = input.boundAt ?? new Date().toISOString();\n\tif (input.resourceIds.length === 0) {\n\t\treturn fail(\"invalid_input\", \"resourceIds 为空：绑定至少要有一个资源\", input.taskId);\n\t}\n\n\t// 先校验全部资源（store.transaction 只回滚异常，业务返回会 COMMIT；\n\t// 在事务外先拒绝，保证整批要么全写要么不写）。\n\tconst resolvedVersions = new Map<string, string>();\n\tfor (const resourceId of input.resourceIds) {\n\t\tconst resource = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string | null } | undefined;\n\t\tif (!resource) {\n\t\t\treturn fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\n\t\t}\n\t\tif (resource.effective_version === null) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`资源 ${resourceId} 尚无生效版本（须先快照或激活，绑定不能只凭资源根现状）`,\n\t\t\t\tresourceId,\n\t\t\t);\n\t\t}\n\t\tresolvedVersions.set(resourceId, resource.effective_version);\n\t}\n\n\treturn store.transaction(() => {\n\t\tconst bindings: TaskBinding[] = [];\n\t\tfor (const resourceId of input.resourceIds) {\n\t\t\tconst effectiveVersion = resolvedVersions.get(resourceId)!;\n\n\t\t\t// UNIQUE(task_id, resource_id) 冲突即复用：重绑更新 version/bound_at 并复位 active。\n\t\t\t// 旧 switch_history_json 保留（换版历史不丢）。\n\t\t\tconst existing = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT binding_id FROM evolution_task_bindings\n\t\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t\t)\n\t\t\t\t.get(input.taskId, resourceId) as { binding_id: string } | undefined;\n\t\t\tif (existing) {\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`UPDATE evolution_task_bindings\n\t\t\t\t\t\t SET version_id = ?, bound_at = ?, active = 1\n\t\t\t\t\t\t WHERE binding_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(effectiveVersion, now, existing.binding_id);\n\t\t\t\tconst row = getBindingRow(store, existing.binding_id)!;\n\t\t\t\tbindings.push(rowToBinding(row));\n\t\t\t} else {\n\t\t\t\tconst bindingId = `bind-${randomUUID()}`;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`INSERT INTO evolution_task_bindings (\n\t\t\t\t\t\t\tbinding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, 1, NULL)`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(bindingId, input.taskId, resourceId, effectiveVersion, now);\n\t\t\t\tbindings.push({\n\t\t\t\t\tbindingId,\n\t\t\t\t\ttaskId: input.taskId,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tversionId: effectiveVersion,\n\t\t\t\t\tboundAt: now,\n\t\t\t\t\tactive: true,\n\t\t\t\t\tswitchHistory: [],\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t\treturn { ok: true, bindings } as MemoryResult<{ bindings: TaskBinding[] }>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. resolveTaskResourceVersion：资源加载器读绑定取版本目录\n// ════════════════════════════════════════════════════════════════════════\n\n/** `resolveTaskResourceVersion` 的输出。 */\nexport interface ResolvedTaskResourceVersion {\n\t/** 本任务固定使用的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录绝对路径（`evolution/versions/<dirSafe>/<versionId>/`）。 */\n\tversionDir: string;\n\t/** 绑定 ID（调用方记 used 观察时回传定位）。 */\n\tbindingId: string;\n}\n\n/**\n * 给资源加载器用：按 active 绑定返回该任务该用的版本目录。\n *\n * - 绑定不存在 → `invalid_input`（调用方不得静默回退到当前 effective_version：\n *   未绑定任务的失败不归因到任何版本，见 recordUsed 的绑定校验）。\n * - 绑定已停用（active=0）→ `invalid_input`：任务已结束，再用旧绑定属调用方\n *   生命周期错位。\n * - 本函数只拼路径不核对目录完整性（完整性由 activation/versions 侧在\n *   发布与生效时保证；运行中版本目录被删属环境故障，加载器读到缺文件自会报）。\n */\nexport function resolveTaskResourceVersion(\n\tstore: MemoryStore,\n\tinput: { taskId: string; resourceId: string; paoHome: string },\n): MemoryResult<ResolvedTaskResourceVersion> {\n\tconst row = store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, version_id, active FROM evolution_task_bindings\n\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as\n\t\t| { binding_id: string; version_id: string; active: number }\n\t\t| undefined;\n\tif (!row) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}（宿主须先 bindTaskResources）`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tif (row.active !== 1) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用（任务已结束或重绑后未再激活）`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst dirSafe = input.resourceId.replace(/:/g, \"_\");\n\treturn {\n\t\tok: true,\n\t\tversionId: row.version_id,\n\t\tversionDir: join(evolutionPaths(input.paoHome).versions, dirSafe, row.version_id),\n\t\tbindingId: row.binding_id,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. switchTaskResourceAtSafePoint：安全点换版\n// ════════════════════════════════════════════════════════════════════════\n\n/** `switchTaskResourceAtSafePoint` 的输入。 */\nexport interface SwitchTaskResourceInput {\n\ttaskId: string;\n\tresourceId: string;\n\t/** 换到的新版本（调用方保证已发布可用；本函数只记绑定不核对目录）。 */\n\tnewVersionId: string;\n\t/** 换版原因（人读，记入 switch_history）。 */\n\treason: string;\n\t/** 换版时间（夹具注入；缺省取当前）。 */\n\tswitchedAt?: string;\n}\n\n/** `switchTaskResourceAtSafePoint` 的输出。 */\nexport interface SwitchTaskResourceResult {\n\t/** 换前版本。 */\n\tfromVersion: string;\n\t/** 换后版本。 */\n\ttoVersion: string;\n\t/** 追加后的完整换版历史。 */\n\tswitchHistory: TaskBindingSwitch[];\n}\n\n/**\n * 安全点换版：读当前绑定 versionId → append switch_history_json {from,to,reason,at}\n * → UPDATE version_id + bound_at。\n *\n * - 绑定不存在 → invalid_input；已停用 → invalid_input（停了先 bindTaskResources 重绑）。\n * - newVersionId === 当前 versionId → 安全点复核：不追加历史噪音，只刷新 bound_at。\n */\nexport function switchTaskResourceAtSafePoint(\n\tstore: MemoryStore,\n\tinput: SwitchTaskResourceInput,\n): MemoryResult<SwitchTaskResourceResult> {\n\tconst now = input.switchedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, version_id, active, switch_history_json FROM evolution_task_bindings\n\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.taskId, input.resourceId) as\n\t\t\t| { binding_id: string; version_id: string; active: number; switch_history_json: string | null }\n\t\t\t| undefined;\n\t\tif (!row) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}，无安全点可换`,\n\t\t\t\tinput.resourceId,\n\t\t\t) as MemoryResult<SwitchTaskResourceResult>;\n\t\t}\n\t\tif (row.active !== 1) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用，不能在停用绑定上换版`,\n\t\t\t\tinput.resourceId,\n\t\t\t) as MemoryResult<SwitchTaskResourceResult>;\n\t\t}\n\n\t\tconst history = rowToBinding(row as TaskBindingRow).switchHistory;\n\t\tconst fromVersion = row.version_id;\n\t\t// from===to 视为安全点复核：不追加历史噪音，只刷新 bound_at。\n\t\tif (fromVersion !== input.newVersionId) {\n\t\t\thistory.push({ from: fromVersion, to: input.newVersionId, reason: input.reason, at: now });\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`UPDATE evolution_task_bindings\n\t\t\t\t\t SET version_id = ?, bound_at = ?, switch_history_json = ?\n\t\t\t\t\t WHERE binding_id = ?`,\n\t\t\t\t)\n\t\t\t\t.run(input.newVersionId, now, JSON.stringify(history), row.binding_id);\n\t\t} else {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_task_bindings SET bound_at = ? WHERE binding_id = ?`)\n\t\t\t\t.run(now, row.binding_id);\n\t\t}\n\t\treturn {\n\t\t\tok: true,\n\t\t\tfromVersion,\n\t\t\ttoVersion: input.newVersionId,\n\t\t\tswitchHistory: history,\n\t\t} as MemoryResult<SwitchTaskResourceResult>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. listTaskBindings / deactivateTaskBinding\n// ════════════════════════════════════════════════════════════════════════\n\n/** `listTaskBindings` 的输入（全部可选过滤）。 */\nexport interface ListTaskBindingsInput {\n\t/** 按任务过滤。 */\n\ttaskId?: string;\n\t/** 按资源过滤。 */\n\tresourceId?: string;\n\t/** 只看仍在使用的绑定（缺省 false：含已停用）。 */\n\tactiveOnly?: boolean;\n}\n\n/** 查询绑定（界面「任务绑定」区与 recordUsed 校验共用读取口径）。 */\nexport function listTaskBindings(\n\tstore: MemoryStore,\n\tinput: ListTaskBindingsInput = {},\n): MemoryResult<{ items: TaskBinding[] }> {\n\tconst where: string[] = [];\n\tconst params: unknown[] = [];\n\tif (input.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(input.taskId);\n\t}\n\tif (input.resourceId !== undefined) {\n\t\twhere.push(\"resource_id = ?\");\n\t\tparams.push(input.resourceId);\n\t}\n\tif (input.activeOnly === true) {\n\t\twhere.push(\"active = 1\");\n\t}\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t FROM evolution_task_bindings\n\t\t\t ${where.length > 0 ? `WHERE ${where.join(\" AND \")}` : \"\"}\n\t\t\t ORDER BY bound_at DESC, binding_id DESC`,\n\t\t)\n\t\t.all(...(params as never[])) as unknown as TaskBindingRow[];\n\treturn { ok: true, items: rows.map(rowToBinding) };\n}\n\n/**\n * 停用一条绑定（任务结束/重绑前）：active=0。\n * 幂等：已停用或不存在都返回 ok，不存在时 `found=false` 供调用方区分。\n */\nexport function deactivateTaskBinding(\n\tstore: MemoryStore,\n\tinput: { taskId: string; resourceId: string },\n): MemoryResult<{ found: boolean }> {\n\tconst result = store.db\n\t\t.prepare(\n\t\t\t`UPDATE evolution_task_bindings SET active = 0\n\t\t\t WHERE task_id = ? AND resource_id = ? AND active = 1`,\n\t\t)\n\t\t.run(input.taskId, input.resourceId);\n\tconst existed = store.db\n\t\t.prepare(`SELECT 1 AS x FROM evolution_task_bindings WHERE task_id = ? AND resource_id = ?`)\n\t\t.get(input.taskId, input.resourceId) as { x: number } | undefined;\n\treturn { ok: true, found: existed !== undefined || result.changes > 0 };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 内部\n// ════════════════════════════════════════════════════════════════════════\n\nfunction getBindingRow(store: MemoryStore, bindingId: string): TaskBindingRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t FROM evolution_task_bindings WHERE binding_id = ?`,\n\t\t)\n\t\t.get(bindingId) as TaskBindingRow | undefined;\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化任务绑定（S9-04/05）。\n *\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as\n\t\t| { binding_id: string; version_id: string; active: number }| undefined;\n\tif (!row) {\n\t\treturn fail(\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,54]}}},{"equalLines":{"line_count":218}},{"diffOp":{"equal":{"range":[54,143]}}},{"diffOp":{"delete":{"range":[143,147]}}},{"diffOp":{"equal":{"range":[147,206]}}},{"diffOp":{"delete":{"range":[143,146]}}},{"diffOp":{"insert":{"range":[147,148]}}},{"diffOp":{"equal":{"range":[206,246]}}},{"equalLines":{"line_count":187}},{"diffOp":{"equal":{"range":[246,340]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\evolution\\binding.ts"},"span":null,"sourceCode":"/**\n * 受控自进化任务绑定（S9-04/05）。\n *\n * 职责：宿主创建/恢复任务前把 resourceId 解析成固定 versionId 落\n * `evolution_task_bindings`；运行中任务继续用绑定版本；安全点换版把\n * 前后值追加进 `switch_history_json`；任务结束/重绑前停旧绑定（active=0）。\n *\n * 契约（S9 任务书 §5）：\n * - 任务绑定是宿主装配的解析结果：本模块只管数据契约，不碰 resource-loader\n *   装配（additionalSkillPaths/additionalExtensionPaths 挂接归宿主侧）。\n * - `UNIQUE(task_id, resource_id)`：同任务同资源重绑即更新（换版/复用同一行，\n *   历史换版沿 switch_history_json 追加不丢）。\n * - `resolveTaskResourceVersion` 只读绑定，返回该任务该用哪个版本目录；\n *   绑定不存在或已停用 → 业务错误，不静默回退到当前 effective_version\n *   （未绑定任务用资源的失败不归因，见 observe.ts recordUsed）。\n * - 运行中工具定义不漂移：绑定写定后 effective_version 再变也不影响本任务，\n *   只有 `switchTaskResourceAtSafePoint` 在安全点显式换版。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport type { MemoryError, MemoryResult } from \"../memory/types.ts\";\nimport type { MemoryStore } from \"../memory/store.ts\";\nimport { evolutionPaths } from \"../memory/paths.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 数据契约\n// ════════════════════════════════════════════════════════════════════════\n\n/** 一条任务绑定（evolution_task_bindings 行的外读形态）。 */\nexport interface TaskBinding {\n\t/** 绑定 ID。 */\n\tbindingId: string;\n\t/** 任务 ID。 */\n\ttaskId: string;\n\t/** 绑定资源 ID。 */\n\tresourceId: string;\n\t/** 本任务固定使用的版本 ID（安全点换版后指向最新值）。 */\n\tversionId: string;\n\t/** 最近一次绑定/换版时间。 */\n\tboundAt: string;\n\t/** 是否仍在使用（false = 任务已结束或已被重绑停用）。 */\n\tactive: boolean;\n\t/** 安全点换版历史（按时间先后追加）。 */\n\tswitchHistory: TaskBindingSwitch[];\n}\n\n/** 一次安全点换版记录（switch_history_json 的单项）。 */\nexport interface TaskBindingSwitch {\n\t/** 换前版本。 */\n\tfrom: string;\n\t/** 换后版本。 */\n\tto: string;\n\t/** 换版原因（人读；如「阻塞修复后重载」「后台进化生效」）。 */\n\treason: string;\n\t/** 换版时间。 */\n\tat: string;\n}\n\ninterface TaskBindingRow {\n\tbinding_id: string;\n\ttask_id: string;\n\tresource_id: string;\n\tversion_id: string;\n\tbound_at: string;\n\tactive: number;\n\tswitch_history_json: string | null;\n}\n\nfunction rowToBinding(row: TaskBindingRow): TaskBinding {\n\tlet switchHistory: TaskBindingSwitch[] = [];\n\tif (row.switch_history_json !== null) {\n\t\ttry {\n\t\t\tconst parsed = JSON.parse(row.switch_history_json) as TaskBindingSwitch[];\n\t\t\tif (Array.isArray(parsed)) switchHistory = parsed;\n\t\t} catch {\n\t\t\t// 历史行损坏按空历史返回，不当作系统错误（绑定本身仍有效）。\n\t\t}\n\t}\n\treturn {\n\t\tbindingId: row.binding_id,\n\t\ttaskId: row.task_id,\n\t\tresourceId: row.resource_id,\n\t\tversionId: row.version_id,\n\t\tboundAt: row.bound_at,\n\t\tactive: row.active === 1,\n\t\tswitchHistory,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. bindTaskResources：任务开始前解析 effective_version → 落绑定\n// ════════════════════════════════════════════════════════════════════════\n\n/** `bindTaskResources` 的输入。 */\nexport interface BindTaskResourcesInput {\n\t/** 任务 ID（宿主生成）。 */\n\ttaskId: string;\n\t/** 本任务要固定版本的资源清单。 */\n\tresourceIds: string[];\n\t/** 关联会话 ID（审计定位；不进绑定表，只透传给调用方日志用）。 */\n\tsessionId?: string;\n\t/** 绑定时间（夹具注入；缺省取当前）。 */\n\tboundAt?: string;\n}\n\n/**\n * 任务开始时把每个 resourceId 解析成当前 effective_version 并落绑定。\n *\n * - 资源未登记或尚无 effective_version → 业务错误（invalid_input），\n *   整批不写（同事务）；调用方应先让资源过 snapshotResourceFiles 或 activation。\n * - `UNIQUE(task_id, resource_id)` 冲突即复用同一行：version_id 与 bound_at\n *   更新为新解析值，active 复位 1（重绑视为新绑定，旧 switch_history 保留追加）。\n * - 同事务批量写：任一资源解析失败即整体回滚，不留半套绑定。\n */\nexport function bindTaskResources(\n\tstore: MemoryStore,\n\tinput: BindTaskResourcesInput,\n): MemoryResult<{ bindings: TaskBinding[] }> {\n\tconst now = input.boundAt ?? new Date().toISOString();\n\tif (input.resourceIds.length === 0) {\n\t\treturn fail(\"invalid_input\", \"resourceIds 为空：绑定至少要有一个资源\", input.taskId);\n\t}\n\n\t// 先校验全部资源（store.transaction 只回滚异常，业务返回会 COMMIT；\n\t// 在事务外先拒绝，保证整批要么全写要么不写）。\n\tconst resolvedVersions = new Map<string, string>();\n\tfor (const resourceId of input.resourceIds) {\n\t\tconst resource = store.db\n\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(resourceId) as { effective_version: string | null } | undefined;\n\t\tif (!resource) {\n\t\t\treturn fail(\"invalid_input\", `资源未登记:${resourceId}`, resourceId);\n\t\t}\n\t\tif (resource.effective_version === null) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`资源 ${resourceId} 尚无生效版本（须先快照或激活，绑定不能只凭资源根现状）`,\n\t\t\t\tresourceId,\n\t\t\t);\n\t\t}\n\t\tresolvedVersions.set(resourceId, resource.effective_version);\n\t}\n\n\treturn store.transaction(() => {\n\t\tconst bindings: TaskBinding[] = [];\n\t\tfor (const resourceId of input.resourceIds) {\n\t\t\tconst effectiveVersion = resolvedVersions.get(resourceId)!;\n\n\t\t\t// UNIQUE(task_id, resource_id) 冲突即复用：重绑更新 version/bound_at 并复位 active。\n\t\t\t// 旧 switch_history_json 保留（换版历史不丢）。\n\t\t\tconst existing = store.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`SELECT binding_id FROM evolution_task_bindings\n\t\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t\t)\n\t\t\t\t.get(input.taskId, resourceId) as { binding_id: string } | undefined;\n\t\t\tif (existing) {\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`UPDATE evolution_task_bindings\n\t\t\t\t\t\t SET version_id = ?, bound_at = ?, active = 1\n\t\t\t\t\t\t WHERE binding_id = ?`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(effectiveVersion, now, existing.binding_id);\n\t\t\t\tconst row = getBindingRow(store, existing.binding_id)!;\n\t\t\t\tbindings.push(rowToBinding(row));\n\t\t\t} else {\n\t\t\t\tconst bindingId = `bind-${randomUUID()}`;\n\t\t\t\tstore.db\n\t\t\t\t\t.prepare(\n\t\t\t\t\t\t`INSERT INTO evolution_task_bindings (\n\t\t\t\t\t\t\tbinding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t\t\t\t) VALUES (?, ?, ?, ?, ?, 1, NULL)`,\n\t\t\t\t\t)\n\t\t\t\t\t.run(bindingId, input.taskId, resourceId, effectiveVersion, now);\n\t\t\t\tbindings.push({\n\t\t\t\t\tbindingId,\n\t\t\t\t\ttaskId: input.taskId,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tversionId: effectiveVersion,\n\t\t\t\t\tboundAt: now,\n\t\t\t\t\tactive: true,\n\t\t\t\t\tswitchHistory: [],\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t\treturn { ok: true, bindings } as MemoryResult<{ bindings: TaskBinding[] }>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. resolveTaskResourceVersion：资源加载器读绑定取版本目录\n// ════════════════════════════════════════════════════════════════════════\n\n/** `resolveTaskResourceVersion` 的输出。 */\nexport interface ResolvedTaskResourceVersion {\n\t/** 本任务固定使用的版本 ID。 */\n\tversionId: string;\n\t/** 版本目录绝对路径（`evolution/versions/<dirSafe>/<versionId>/`）。 */\n\tversionDir: string;\n\t/** 绑定 ID（调用方记 used 观察时回传定位）。 */\n\tbindingId: string;\n}\n\n/**\n * 给资源加载器用：按 active 绑定返回该任务该用的版本目录。\n *\n * - 绑定不存在 → `invalid_input`（调用方不得静默回退到当前 effective_version：\n *   未绑定任务的失败不归因到任何版本，见 recordUsed 的绑定校验）。\n * - 绑定已停用（active=0）→ `invalid_input`：任务已结束，再用旧绑定属调用方\n *   生命周期错位。\n * - 本函数只拼路径不核对目录完整性（完整性由 activation/versions 侧在\n *   发布与生效时保证；运行中版本目录被删属环境故障，加载器读到缺文件自会报）。\n */\nexport function resolveTaskResourceVersion(\n\tstore: MemoryStore,\n\tinput: { taskId: string; resourceId: string; paoHome: string },\n): MemoryResult<ResolvedTaskResourceVersion> {\n\tconst row = store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, version_id, active FROM evolution_task_bindings\n\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t)\n\t\t.get(input.taskId, input.resourceId) as\n\t\t| { binding_id: string; version_id: string; active: number }\n\t\t| undefined;\n\tif (!row) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}（宿主须先 bindTaskResources）`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tif (row.active !== 1) {\n\t\treturn fail(\n\t\t\t\"invalid_input\",\n\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用（任务已结束或重绑后未再激活）`,\n\t\t\tinput.resourceId,\n\t\t);\n\t}\n\tconst dirSafe = input.resourceId.replace(/:/g, \"_\");\n\treturn {\n\t\tok: true,\n\t\tversionId: row.version_id,\n\t\tversionDir: join(evolutionPaths(input.paoHome).versions, dirSafe, row.version_id),\n\t\tbindingId: row.binding_id,\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. switchTaskResourceAtSafePoint：安全点换版\n// ════════════════════════════════════════════════════════════════════════\n\n/** `switchTaskResourceAtSafePoint` 的输入。 */\nexport interface SwitchTaskResourceInput {\n\ttaskId: string;\n\tresourceId: string;\n\t/** 换到的新版本（调用方保证已发布可用；本函数只记绑定不核对目录）。 */\n\tnewVersionId: string;\n\t/** 换版原因（人读，记入 switch_history）。 */\n\treason: string;\n\t/** 换版时间（夹具注入；缺省取当前）。 */\n\tswitchedAt?: string;\n}\n\n/** `switchTaskResourceAtSafePoint` 的输出。 */\nexport interface SwitchTaskResourceResult {\n\t/** 换前版本。 */\n\tfromVersion: string;\n\t/** 换后版本。 */\n\ttoVersion: string;\n\t/** 追加后的完整换版历史。 */\n\tswitchHistory: TaskBindingSwitch[];\n}\n\n/**\n * 安全点换版：读当前绑定 versionId → append switch_history_json {from,to,reason,at}\n * → UPDATE version_id + bound_at。\n *\n * - 绑定不存在 → invalid_input；已停用 → invalid_input（停了先 bindTaskResources 重绑）。\n * - newVersionId === 当前 versionId → 安全点复核：不追加历史噪音，只刷新 bound_at。\n */\nexport function switchTaskResourceAtSafePoint(\n\tstore: MemoryStore,\n\tinput: SwitchTaskResourceInput,\n): MemoryResult<SwitchTaskResourceResult> {\n\tconst now = input.switchedAt ?? new Date().toISOString();\n\n\treturn store.transaction(() => {\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT binding_id, version_id, active, switch_history_json FROM evolution_task_bindings\n\t\t\t\t WHERE task_id = ? AND resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.taskId, input.resourceId) as\n\t\t\t| { binding_id: string; version_id: string; active: number; switch_history_json: string | null }\n\t\t\t| undefined;\n\t\tif (!row) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`任务 ${input.taskId} 未绑定资源 ${input.resourceId}，无安全点可换`,\n\t\t\t\tinput.resourceId,\n\t\t\t) as MemoryResult<SwitchTaskResourceResult>;\n\t\t}\n\t\tif (row.active !== 1) {\n\t\t\treturn fail(\n\t\t\t\t\"invalid_input\",\n\t\t\t\t`任务 ${input.taskId} 对资源 ${input.resourceId} 的绑定已停用，不能在停用绑定上换版`,\n\t\t\t\tinput.resourceId,\n\t\t\t) as MemoryResult<SwitchTaskResourceResult>;\n\t\t}\n\n\t\tconst history = rowToBinding(row as TaskBindingRow).switchHistory;\n\t\tconst fromVersion = row.version_id;\n\t\t// from===to 视为安全点复核：不追加历史噪音，只刷新 bound_at。\n\t\tif (fromVersion !== input.newVersionId) {\n\t\t\thistory.push({ from: fromVersion, to: input.newVersionId, reason: input.reason, at: now });\n\t\t\tstore.db\n\t\t\t\t.prepare(\n\t\t\t\t\t`UPDATE evolution_task_bindings\n\t\t\t\t\t SET version_id = ?, bound_at = ?, switch_history_json = ?\n\t\t\t\t\t WHERE binding_id = ?`,\n\t\t\t\t)\n\t\t\t\t.run(input.newVersionId, now, JSON.stringify(history), row.binding_id);\n\t\t} else {\n\t\t\tstore.db\n\t\t\t\t.prepare(`UPDATE evolution_task_bindings SET bound_at = ? WHERE binding_id = ?`)\n\t\t\t\t.run(now, row.binding_id);\n\t\t}\n\t\treturn {\n\t\t\tok: true,\n\t\t\tfromVersion,\n\t\t\ttoVersion: input.newVersionId,\n\t\t\tswitchHistory: history,\n\t\t} as MemoryResult<SwitchTaskResourceResult>;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. listTaskBindings / deactivateTaskBinding\n// ════════════════════════════════════════════════════════════════════════\n\n/** `listTaskBindings` 的输入（全部可选过滤）。 */\nexport interface ListTaskBindingsInput {\n\t/** 按任务过滤。 */\n\ttaskId?: string;\n\t/** 按资源过滤。 */\n\tresourceId?: string;\n\t/** 只看仍在使用的绑定（缺省 false：含已停用）。 */\n\tactiveOnly?: boolean;\n}\n\n/** 查询绑定（界面「任务绑定」区与 recordUsed 校验共用读取口径）。 */\nexport function listTaskBindings(\n\tstore: MemoryStore,\n\tinput: ListTaskBindingsInput = {},\n): MemoryResult<{ items: TaskBinding[] }> {\n\tconst where: string[] = [];\n\tconst params: unknown[] = [];\n\tif (input.taskId !== undefined) {\n\t\twhere.push(\"task_id = ?\");\n\t\tparams.push(input.taskId);\n\t}\n\tif (input.resourceId !== undefined) {\n\t\twhere.push(\"resource_id = ?\");\n\t\tparams.push(input.resourceId);\n\t}\n\tif (input.activeOnly === true) {\n\t\twhere.push(\"active = 1\");\n\t}\n\tconst rows = store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t FROM evolution_task_bindings\n\t\t\t ${where.length > 0 ? `WHERE ${where.join(\" AND \")}` : \"\"}\n\t\t\t ORDER BY bound_at DESC, binding_id DESC`,\n\t\t)\n\t\t.all(...(params as never[])) as unknown as TaskBindingRow[];\n\treturn { ok: true, items: rows.map(rowToBinding) };\n}\n\n/**\n * 停用一条绑定（任务结束/重绑前）：active=0。\n * 幂等：已停用或不存在都返回 ok，不存在时 `found=false` 供调用方区分。\n */\nexport function deactivateTaskBinding(\n\tstore: MemoryStore,\n\tinput: { taskId: string; resourceId: string },\n): MemoryResult<{ found: boolean }> {\n\tconst result = store.db\n\t\t.prepare(\n\t\t\t`UPDATE evolution_task_bindings SET active = 0\n\t\t\t WHERE task_id = ? AND resource_id = ? AND active = 1`,\n\t\t)\n\t\t.run(input.taskId, input.resourceId);\n\tconst existed = store.db\n\t\t.prepare(`SELECT 1 AS x FROM evolution_task_bindings WHERE task_id = ? AND resource_id = ?`)\n\t\t.get(input.taskId, input.resourceId) as { x: number } | undefined;\n\treturn { ok: true, found: existed !== undefined || result.changes > 0 };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. 内部\n// ════════════════════════════════════════════════════════════════════════\n\nfunction getBindingRow(store: MemoryStore, bindingId: string): TaskBindingRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT binding_id, task_id, resource_id, version_id, bound_at, active, switch_history_json\n\t\t\t FROM evolution_task_bindings WHERE binding_id = ?`,\n\t\t)\n\t\t.get(bindingId) as TaskBindingRow | undefined;\n}\n\nfunction fail(code: MemoryError[\"code\"], message: string, refId?: string): MemoryResult<never> {\n\treturn { ok: false, error: { code, message, ...(refId === undefined ? {} : { refId }) } };\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * 受控自进化局部候选生成（S8-07）。\n * */\nimport { randomUUID } from \"node:crypto\";\nimport {\n\tcopyFileSync,existsSync,mkdirSync,readdirSync,readFileSync,rmSync,statSync,writeFileSync,\n} from \"node:fs\";\nimport { basename, dirname, join, relative } from \"node:path\";\nimport type { Context, ModelThinkingLevel, Usage } from \"@pao/ai\";\t\t\t}\n\t\t\tfor (const c of cases) {\n\t\t\t\tif (\n\t\t\t\t\ttypeof c.caseId === \"string\" &&c.caseId.startsWith(\"holdout\") &&c.verdict !== undefined &&c.verdict !== \"passed\") {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tok: true,\tconst model = slash === -1 ? undefined : deps.modelRegistry.find(provider, modelId);\n\tif (!model) {\n\t\treturn fail(\"invalid_input\",`档位「${deps.tierName ?? DEFAULT_TIER}」解析到 ${resolved.model}，但 modelRegistry 找不到该模型`,\n\t\t);\n\t}\n\tif (!baseContent.ok) {\n\t\tif (budgetReserved) {\n\t\t\tawait releaseMemoryJobBudget(budgetPaoHome,budgetJobId,budgetKind,new Date().toISOString(),baseContent.error.message,attemptKey,\n\t\t\t);\n\t\t}\n\t\t// O10/E05：透传 readResourceVersion 的真实错误码——版本目录缺失是\t// 只放清单内文件（模型只改这些），空清单放全部；{PROBLEM} 放真实问题\n\t// 摘要/原因/预期/实际/类别/证据，不再只放 ID。holdout 内容绝不进提示词。\n\tconst allowedFilesText = input.allowedFiles.length > 0? input.allowedFiles.join(\"\\n\"): \"（资源根内全部文件）\";\n\tconst allowedSet = new Set(input.allowedFiles.map((p) => p.replace(/\\\\/g, \"/\")));\n\tconst baseFilesText =\t\t\t\t\t.join(\"\\n\\n\") || \"（baseVersion 目录为空）\";\n\tconst devCasesText = input.devCases\n\t\t.map((c, i) =>`--- 开发样例 ${i} ---\\n输入:${c.input}\\n失败:${c.failure}${c.expected ? `\\n期望:${c.expected}` : \"\"}`)\n\t\t.join(\"\\n\\n\");\n\tconst problemEvidence = (JSON.parse(problemRow.evidence_refs_json) as string[]).join(\"、\") || \"无\";\t\t`版本:${input.baseVersion}`,\n\t].join(\"\\n\");\n\tconst prompt = CANDIDATE_PROMPT\n\t\t.replaceCANDIDATE_PROMPT.replace(\"{ALLOWED_FILES}\", allowedFilesText)\n\t\t.replace(\"{BASE_FILES}\", baseFilesText)\n\t\t.replace(\"{PROBLEM}\", problemDesc)\t\t\t);\n\t\t}\n\t\treturn fail(\"unavailable\",`候选生成请求${message.stopReason === \"aborted\" ? \"被取消\" : \"失败\"}:${message.errorMessage ?? message.stopReason}`\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\treturn {ok: true,status: \"rejected\",reason: `候选文件 ${normalized} 超出资源根（不在允许清单 ${input.allowedFiles.join(\"、\")} 内）`,\n\t\t\t\t};\n\t\t\t}\n\t\t}\t\t\t\t\t) VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t\t)\n\t\t\t\t.run(`link-${candidateId}-${link.source_id}`,candidateId,link.source_id,link.memory_id,link.revision,now);\n\t\t}\n\t\t// 问题状态推进到 candidate。\t\t\tbudgetKind,\n\t\t\tusage?.cost?.total,\n\t\t\tnew Date().toISOString(),\n\t\t\t\"候选生成完成\",\n\t\t\tattemptKey,\t};\n}\n","ops":[{"diffOp":{"equal":{"range":[0,57]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[57,111]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[113,126]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[126,137]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[137,147]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[147,159]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[159,172]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[172,179]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[179,188]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[111,113]}}},{"diffOp":{"equal":{"range":[188,201]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[201,203]}}},{"diffOp":{"equal":{"range":[203,350]}}},{"equalLines":{"line_count":406}},{"diffOp":{"equal":{"range":[350,391]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[397,428]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[428,461]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[461,487]}}},{"diffOp":{"delete":{"range":[57,58]}}},{"diffOp":{"insert":{"range":[391,397]}}},{"diffOp":{"equal":{"range":[487,509]}}},{"diffOp":{"insert":{"range":[391,396]}}},{"diffOp":{"equal":{"range":[509,542]}}},{"equalLines":{"line_count":46}},{"diffOp":{"equal":{"range":[542,657]}}},{"diffOp":{"insert":{"range":[391,395]}}},{"diffOp":{"equal":{"range":[657,673