e":[305,307]}}},{"diffOp":{"equal":{"range":[650,666]}}},{"diffOp":{"delete":{"range":[666,749]}}},{"diffOp":{"insert":{"range":[194,218]}}},{"diffOp":{"equal":{"range":[749,771]}}},{"diffOp":{"delete":{"range":[414,427]}}},{"diffOp":{"insert":{"range":[295,305]}}},{"diffOp":{"equal":{"range":[305,307]}}},{"diffOp":{"equal":{"range":[771,786]}}},{"diffOp":{"delete":{"range":[194,218]}}},{"diffOp":{"insert":{"range":[666,706]}}},{"diffOp":{"equal":{"range":[749,750]}}},{"diffOp":{"insert":{"range":[786,829]}}},{"diffOp":{"equal":{"range":[829,850]}}},{"diffOp":{"delete":{"range":[295,305]}}},{"diffOp":{"insert":{"range":[414,427]}}},{"diffOp":{"equal":{"range":[305,307]}}},{"diffOp":{"equal":{"range":[850,855]}}},{"equalLines":{"line_count":86}},{"diffOp":{"equal":{"range":[855,860]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\desktop\\host-mount.ts"},"span":[751,788],"sourceCode":"/**\n * 桌面侧任务绑定装配桥（S9-04/05 装配侧）。\n *\n * `resolveDesktopTaskBoundPaths`：会话装配前把该任务的 active 绑定解析成\n * 要挂进 resourceLoaderOptions 的版本目录清单。store 生命周期在本门面内\n * 开闭——与 `pao/desktop/memory.ts` 各读桥同口径（宿主不直接碰 store）。\n *\n * 语义同 `evolution/host-mount.ts`：\n * - `taskId = sessionId`；只接 skill-path/extension-path 两类，其余四类进\n *   `skipped`；版本目录缺失进 `missing`（宿主降级沿用资源根，不挂死路径）。\n * - 库未建（memory.sqlite 不存在）→ 返回全空清单：该现场还没做过进化\n *   登记，等同无绑定，不拿裸 SQLite 错当业务结果。\n */\nimport { existsSync } from \"node:fs\";\nimport type { MemoryResult } from \"../memory/types.ts\";\nimport { memoryPaths } from \"../memory/paths.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport { switchTaskResourceAtSafePoint, type SwitchTaskResourceResult } from \"../evolution/binding.ts\";\nimport { ensureTaskBindings, resolveTaskBoundResourcePaths, type TaskBoundResourcePaths } from \"../evolution/host-mount.ts\";\nimport { recoverEvolutionState, type RecoveryReport } from \"../evolution/recovery.ts\";\n\nexport type { MissingTaskBinding, MountedTaskResource, SkippedTaskBinding, TaskBoundResourcePaths } from \"../evolution/host-mount.ts\";\nexport type { SwitchTaskResourceResult } from \"../evolution/binding.ts\";\n\n/**\n * 读任务的绑定版本目录清单（桌面会话装配用）。\n *\n * O13/E14：读写打开——装配前先 ensure 初始绑定（全量已生效资源口径），\n * 再解析成挂载清单；ensure 失败如实上抛（绑定读不出来时静默降级会让\n * 会话拿错版本无留痕）。\n */\nexport function resolveDesktopTaskBoundPaths(input: {\n\ttaskId: string;\n\tpaoHome: string;\n}): MemoryResult<TaskBoundResourcePaths> {\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn { ok: true, skillPaths: [], extensionPaths: [], mounted: [], skipped: [], missing: [] };\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readwrite\");\n\ttry {\n\t\treturn ensureTaskBindings(store, { taskId: input.taskId, paoHome: input.paoHome });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/** `switchDesktopTaskResourceAtSafePoint` 的输出。 */\nexport interface SwitchDesktopTaskResourceResult {\n\t/** 换版事务结果（fromVersion/toVersion/switchHistory）。 */\n\tswitch: SwitchTaskResourceResult;\n\t/** 换版后重新解析的全量挂载清单（调用方据此覆盖 priority paths）。 */\n\tpaths: TaskBoundResourcePaths;\n}\n\n/**\n * 桌面侧安全点换版（写侧）：`switchTaskResourceAtSafePoint` 落绑定换版历史后，\n * 同事务外重读全量挂载清单返回——宿主拿 `paths` 调\n * `loader.updateAdditionalPaths` + 空闲时 `reload` 完成新版本目录生效。\n *\n * 读写打开：本函数是绑定换版的唯一写入口（绑定只在这里改指向）。\n * 库未建 → `invalid_input`（无绑定可换，不开空库）。\n */\nexport function switchDesktopTaskResourceAtSafePoint(input: {\n\ttaskId: string;\n\tresourceId: string;\n\tnewVersionId: string;\n\treason: string;\n\tpaoHome: string;\n}): MemoryResult<SwitchDesktopTaskResourceResult> {\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"记忆库未建立，无绑定可换版\", refId: input.resourceId },\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readwrite\");\n\ttry {\n\t\tconst switched = switchTaskResourceAtSafePoint(store, {\n\t\t\ttaskId: input.taskId,\n\t\t\tresourceId: input.resourceId,\n\t\t\tnewVersionId: input.newVersionId,\n\t\t\treason: input.reason,\n\t\t});\n\t\tif (!switched.ok) return switched;\n\t\tconst paths = resolveTaskBoundResourcePaths(store, { taskId: input.taskId, paoHome: input.paoHome });\n\t\tif (!paths.ok) return paths;\n\t\treturn { ok: true, switch: switched, paths };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\nexport type { RecoveryReport } from \"../evolution/recovery.ts\";\n\n/**\n * S9-11：桌面侧启动恢复检查门面（pi-sdk-driver 经 loadPaoDesktopModule 调用）。\n *\n * 库未建 → 返回空报告（该现场还没做过进化登记，不拿裸 SQLite 错当业务结果）；\n * needsAttention / unfinishedActivations 如实列出由宿主呈现（Notification/日志），\n * 不自动激活、不主动改指向。\n */\nexport function recoverDesktopEvolutionState(input: { paoHome: string }): MemoryResult<RecoveryReport> {\n\tconst empty: RecoveryReport = { resources: [], unfinishedActivations: [], needsAttention: [] };\n\tif (!existsSync(memoryPaths(input.paoHome).database)) {\n\t\treturn { ok: true, ...empty };\n\t}\n\tconst store = openMemoryStore(input.paoHome, \"readonly\");\n\ttry {\n\t\treturn recoverEvolutionState(store, { paoHome: input.paoHome });\n\t} finally {\n\t\tstore.close();\n\t}\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"import { createHash, randomUUID } from \"node:crypto\";\nimport { readdirSync, readFileSync, realpathSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";export * from \"./canvas.ts\";\nexport * from \"./dept.ts\";\nexport * from \"./editor.ts\";\nexport *type { DesktopFlowControlPayloadInput } from \"./hostflow-mount.tscontrol-payload.ts\";{ DesktopFlowControlPayloadInputdesktopFlowControlPayload } from \"./flow-control-payload.ts\";{ desktopFlowControlPayload }\nexport * from \"./maintenance.ts\";\nexport * from \"./memory.ts\";\tawait memory.run(current.pi, args, current.ctx);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,163]}}},{"equalLines":{"line_count":36}},{"diffOp":{"equal":{"range":[163,247]}}},{"diffOp":{"equal":{"range":[247,255]}}},{"diffOp":{"delete":{"range":[255,256]}}},{"diffOp":{"insert":{"range":[256,295]}}},{"diffOp":{"equal":{"range":[295,304]}}},{"diffOp":{"delete":{"range":[304,308]}}},{"diffOp":{"insert":{"range":[308,312]}}},{"diffOp":{"equal":{"range":[312,313]}}},{"diffOp":{"delete":{"range":[313,321]}}},{"diffOp":{"insert":{"range":[321,339]}}},{"diffOp":{"equal":{"range":[339,341]}}},{"diffOp":{"equal":{"range":[247,255]}}},{"diffOp":{"delete":{"range":[256,261]}}},{"diffOp":{"equal":{"range":[341,343]}}},{"diffOp":{"delete":{"range":[343,373]}}},{"diffOp":{"insert":{"range":[373,398]}}},{"diffOp":{"equal":{"range":[398,434]}}},{"diffOp":{"equal":{"range":[247,255]}}},{"diffOp":{"delete":{"range":[434,463]}}},{"diffOp":{"insert":{"range":[255,256]}}},{"diffOp":{"equal":{"range":[295,304]}}},{"diffOp":{"delete":{"range":[308,312]}}},{"diffOp":{"insert":{"range":[304,308]}}},{"diffOp":{"equal":{"range":[312,313]}}},{"diffOp":{"delete":{"range":[321,339]}}},{"diffOp":{"insert":{"range":[313,321]}}},{"diffOp":{"equal":{"range":[339,341]}}},{"diffOp":{"equal":{"range":[463,526]}}},{"equalLines":{"line_count":596}},{"diffOp":{"equal":{"range":[526,578]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\desktop\\index.ts"},"span":[0,53],"sourceCode":"import { createHash, randomUUID } from \"node:crypto\";\nimport { readdirSync, readFileSync, realpathSync } from \"node:fs\";\nimport { dirname, join } from \"node:path\";\nimport type { ExtensionContext } from \"../../core/extensions/types.ts\";\nimport { getPowerShellConfig } from \"../../utils/shell.ts\";\nimport { projectRootForCards } from \"../cards/cardfile.ts\";\nimport { formatCardNumber, parseCardRef } from \"../cards/counter.ts\";\nimport { listPaoSubcommands } from \"../command-router.ts\";\nimport { redactContext } from \"../context/index.ts\";\nimport type { MinisterHandle } from \"../host/handle.ts\";\nimport { sessionMemory } from \"../memory/session.ts\";\nimport { loadTierConfig, resolvePaoHome, THINKING_LEVELS, TIER_CONFIG_RELATIVE_PATH } from \"../routing/config.ts\";\nimport { FileLockError, withFileLock } from \"../shared/lock.ts\";\nimport { pathKey } from \"../shared/path-key.ts\";\nimport { utcNow } from \"../shared/time.ts\";\nimport { collectInstanceResults } from \"../status/results.ts\";\nimport { locateDispatchCard } from \"../worker/dispatch-core.ts\";\nimport { controlPath, readControl, saveControl } from \"../workflow/control.ts\";\nimport { loadFrozenRecipe } from \"../workflow/minister.ts\";\nimport { deleteRecipe, parseRecipe, recipePath, type WorkflowRecipe } from \"../workflow/recipe.ts\";\nimport { inspectTemplateInstall, installStarterTemplate } from \"../workflow/templates.ts\";\nimport {\n\tcheckDesktopRecipeDelete,\n\tcheckDesktopRecipeEdit,\n\tpreviewDesktopWorkflow,\n\treadDesktopRecipeCatalog,\n\trecipeRevision,\n\trenderDesktopRecipe,\n} from \"./editor.ts\";\nimport { desktopFlowControlPayload } from \"./flow-control-payload.ts\";\nimport { desktopOwnerEntry, desktopOwner as owner, readDesktopWorkerActivity } from \"./owners.ts\";\nimport { readDesktopSessionIncrement, readDesktopWorkflowMinister } from \"./read-model.ts\";\nimport { readDesktopFlowsFresh } from \"./workflow.ts\";\n\nexport { initializeMemoryConfig } from \"../memory/config.ts\";\nexport * from \"../memory/project-identity.ts\";\nexport { resolvePaoHome } from \"../routing/config.ts\";\nexport { collectPending, collectPendingFresh } from \"../status/pending.ts\";\nexport { scanWorkflowInstances, scanWorkflowInstancesFresh } from \"../status/workflow-instances.ts\";\nexport * from \"./canvas.ts\";\nexport * from \"./dept.ts\";\nexport * from \"./editor.ts\";\nexport * from \"./host-mount.ts\";\nexport type { DesktopFlowControlPayloadInput } from \"./flow-control-payload.ts\";\nexport { desktopFlowControlPayload } from \"./flow-control-payload.ts\";\nexport * from \"./maintenance.ts\";\nexport * from \"./memory.ts\";\nexport type { DesktopWorkerActivityRow, WorkerInjectOutcome } from \"./owners.ts\";\nexport { readDesktopWorkerActivity, registerDesktopOwner } from \"./owners.ts\";\nexport * from \"./plans.ts\";\nexport * from \"./read-model.ts\";\nexport * from \"./view-envelope.ts\";\nexport * from \"./workflow.ts\";\n\n/**\n * D8c 结果页聚合（设计包 2026-10-04 §6.4 拍板：不进 ./pao 包 exports，桌面扩展后端直调本桥）。\n * 只读零落盘：跨项目按实例聚合四样（要求/实际 diff/验收/遗留）＋恢复摘要四态＋异常行，\n * 输出过 redactContext（与桌面快照同口径脱敏）。不做任何续跑动作——「拟续跑」只是建议文案。\n */\nexport async function readDesktopResults(paoHome: string): Promise<unknown> {\n\treturn redactContext(await collectInstanceResults(paoHome));\n}\n\nexport function readDesktopMinisters(sessionId: string, project: string): MinisterHandle[] {\n\treturn redactContext(owner(sessionId, project).getMinisters()) as MinisterHandle[];\n}\n\nexport async function readDesktopMinister(sessionId: string, project: string, ministerId: string, offset: number) {\n\tconst current = owner(sessionId, project);\n\tconst minister = current.getMinisters().find((entry) => entry.会话标识 === ministerId);\n\tconst flow = (await readDesktopFlowsFresh(project)).工作流.find((entry) =>\n\t\tentry.控制.节点.some((node) => node.部长会话 === ministerId),\n\t);\n\tif (flow && flow.控制.owner !== sessionId) throw new Error(\"部长属于另一 owner，请跳转原会话读取\");\n\tif (!flow && (!minister || realpathSync(minister.项目根) !== realpathSync(project)))\n\t\tthrow new Error(\"该部长不属于当前项目/owner，不能读取任意会话\");\n\tif (flow) {\n\t\tconst node = flow.控制.节点.find((entry) => entry.部长会话 === ministerId)!;\n\t\treturn readDesktopWorkflowMinister(project, flow.控制.实例, node.名字, node.轮次, offset);\n\t}\n\tconst directory = current.ctx.sessionManager.getSessionDir();\n\tconst matches = readdirSync(directory).filter((name) => name.endsWith(`_${ministerId}.jsonl`));\n\tif (matches.length !== 1) throw new Error(\"部长会话未在当前会话目录唯一定位，保留未知；请在原 owner 查看会话\");\n\tconst path = realpathSync(join(directory, matches[0]));\n\tif (dirname(path) !== realpathSync(directory)) throw new Error(\"部长会话路径越出所属目录\");\n\treturn readDesktopSessionIncrement(path, offset);\n}\n\nexport async function runDesktopFlowCommand(\n\tsessionId: string,\n\tproject: string,\n\tparams: Record<string, unknown>,\n\tsignal?: AbortSignal,\n): Promise<DesktopInjectResult | undefined> {\n\t// 批3a：inject 三目标在 flow.run(\"control …\") 之前分发，不进 pao_control_node/flow-control-payload。\n\tif (params.action === \"inject\") {\n\t\tconst target = params.target;\n\t\tif (target === \"owner\")\n\t\t\treturn await runDesktopOwnerInject(sessionId, project, {\n\t\t\t\tinstance: String(params.instance ?? \"\"),\n\t\t\t\ttext: String(params.text ?? \"\"),\n\t\t\t});\n\t\tif (target === \"minister\")\n\t\t\treturn await runDesktopMinisterInject(sessionId, project, {\n\t\t\t\tinstance: String(params.instance ?? \"\"),\n\t\t\t\tnode: String(params.node ?? \"\"),\n\t\t\t\tround: typeof params.round === \"number\" ? params.round : Number(params.round),\n\t\t\t\ttext: String(params.text ?? \"\"),\n\t\t\t});\n\t\tif (target === \"worker\")\n\t\t\treturn await runDesktopWorkerInject(sessionId, project, {\n\t\t\t\tinstance: String(params.instance ?? \"\"),\n\t\t\t\tnode: String(params.node ?? \"\"),\n\t\t\t\tround: typeof params.round === \"number\" ? params.round : Number(params.round),\n\t\t\t\tcardRef: String(params.cardRef ?? \"\"),\n\t\t\t\texecutionId: String(params.executionId ?? \"\"),\n\t\t\t\tattempt: typeof params.attempt === \"number\" ? params.attempt : Number(params.attempt),\n\t\t\t\ttext: String(params.text ?? \"\"),\n\t\t\t});\n\t\tthrow new Error(`注入目标不认识：${String(target)}（合法目标：owner、minister、worker）`);\n\t}\n\tconst trusted = async () => {\n\t\t// 桌面侧请求键（S9-桌面包 57e1ec4 起）与 /pao flow control JSON 协议（nodeControlTool schema）均为英文键；\n\t\t// 读侧 flow.控制/节点 等中文键是 D5 保留的实例清单持久面，不随迁。\n\t\tconst matches = (await readDesktopFlowsFresh(project)).工作流.filter(\n\t\t\t(entry) => entry.控制.实例 === params.instance,\n\t\t);\n\t\tif (matches.length !== 1) throw new Error(\"实例不在当前项目唯一发现，拒绝外部卡目录\");\n\t\tconst flow = matches[0].控制;\n\t\tconst action = params.action;\n\t\tconst node = flow.节点.find((entry) => entry.名字 === params.node);\n\t\tconst staleError = () => new Error(\"实例/卡目录/节点/轮次已变化，请刷新\");\n\t\tif (params.name !== flow.工作流 || params.cards_dir !== flow.卡目录) throw staleError();\n\t\t// confirm 必须锁定节点与轮次；pause/resume 由内核按当前停因定位，只有调用方显式传入\n\t\t// node/round 时才核对——否则调用方漏传会得到「已变化，请刷新」这种误导性错误。\n\t\tif (action === \"confirm\" || params.node !== undefined || params.round !== undefined) {\n\t\t\tif (!node || params.round !== node.轮次) throw staleError();\n\t\t}\n\t\tif (action !== \"resume\" && flow.owner !== sessionId) throw new Error(\"请跳转原 owner 会话处理\");\n\t\tif (action === \"resume\" && params.prev_owner !== flow.owner) throw new Error(\"原 owner 已变化，请刷新\");\n\t\t// 桌面只发 confirm/pause/resume；按 S3 动作契约只带该动作允许的字段，不能把\n\t\t// node/round/prev_owner 全量塞给每个动作，否则内核会在字段校验阶段拒绝。\n\t\treturn desktopFlowControlPayload({\n\t\t\taction,\n\t\t\treason: params.reason,\n\t\t\tname: flow.工作流,\n\t\t\tcardsDir: flow.卡目录,\n\t\t\tinstance: flow.实例,\n\t\t\towner: flow.owner,\n\t\t\t...(node ? { node: node.名字, round: node.轮次 } : {}),\n\t\t});\n\t};\n\tconst current = await controlOwner(sessionId, project, signal, trusted);\n\tconst flow = listPaoSubcommands(current.pi).find((entry) => entry.name === \"flow\");\n\tif (!flow) throw new Error(\"此 owner 无工作流入口\");\n\tawait flow.run(current.pi, `control ${JSON.stringify(await trusted())}`, current.ctx);\n}\n\nexport function readDesktopEditor(sessionId: string, project: string) {\n\tconst current = owner(sessionId, project);\n\tconst messages = current.ctx.sessionManager\n\t\t.getBranch()\n\t\t.filter((entry) => entry.type === \"message\")\n\t\t.slice(-30)\n\t\t.map((entry) => {\n\t\t\tconst message = entry.message;\n\t\t\tif (message.role !== \"user\" && message.role !== \"assistant\" && message.role !== \"toolResult\")\n\t\t\t\treturn { role: message.role, content: \"扩展消息请在原对话查看\" };\n\t\t\treturn {\n\t\t\t\trole: message.role,\n\t\t\t\tcontent:\n\t\t\t\t\ttypeof message.content === \"string\"\n\t\t\t\t\t\t? message.content\n\t\t\t\t\t\t: message.content.filter((block) => block.type === \"text\"),\n\t\t\t};\n\t\t});\n\treturn {\n\t\tcatalog: readDesktopRecipeCatalog(resolvePaoHome()),\n\t\tsession: sessionId,\n\t\tproject: project,\n\t\t// 视图三键（§10 收口批随迁，定名 busy/dialog/currentModel；桌面 flow-desktop 消费点同批）\n\t\tbusy: !current.ctx.isIdle(),\n\t\tdialog: redactContext(messages),\n\t\tcurrentModel: current.ctx.model ? `${current.ctx.model.provider}/${current.ctx.model.id}` : \"未知\",\n\t};\n}\n\nasync function controlOwner(\n\tsessionId: string,\n\tproject: string,\n\tsignal?: AbortSignal,\n\tvalidate?: () => Promise<unknown> | unknown,\n) {\n\tconst current = owner(sessionId, project);\n\tconst control = listPaoSubcommands(current.pi).find((entry) => entry.name === \"runtime\");\n\tif (!control) throw new Error(\"原 owner 控制入口未装载\");\n\tconst combined =\n\t\tsignal && current.ctx.signal ? AbortSignal.any([signal, current.ctx.signal]) : (signal ?? current.ctx.signal);\n\tconst recheck = async () => {\n\t\tcombined?.throwIfAborted();\n\t\tif (owner(sessionId, project) !== current) throw new Error(\"原会话上下文已切换，请刷新\");\n\t\tawait control.run(current.pi, \"\", current.ctx);\n\t\tcombined?.throwIfAborted();\n\t\tif (owner(sessionId, project) !== current) throw new Error(\"原会话上下文已切换，请刷新\");\n\t\tawait validate?.();\n\t};\n\tawait recheck();\n\tconst ctx: ExtensionContext = {\n\t\t...current.ctx,\n\t\tsignal: combined,\n\t\tui: {\n\t\t\t...current.ctx.ui,\n\t\t\tconfirm: async (...args) => {\n\t\t\t\tawait recheck();\n\t\t\t\tconst result = await current.ctx.ui.confirm(...args);\n\t\t\t\tawait recheck();\n\t\t\t\treturn result;\n\t\t\t},\n\t\t},\n\t};\n\treturn { ...current, ctx, recheck };\n}\n\nexport async function sendDesktopChat(\n\tsessionId: string,\n\tproject: string,\n\ttext: string,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\tif (!text.trim() || text.length > 100_000) throw new Error(\"对话内容为空或过长\");\n\tif (text.trim().startsWith(\"/\")) throw new Error(\"斜杠命令请在原主控对话输入；画布聊天只提交普通对话。\");\n\tconst current = await controlOwner(sessionId, project, signal);\n\tif (!current.ctx.isIdle()) throw new Error(\"原会话仍在执行，请等结束或在原对话停止后发送。\");\n\tcurrent.pi.sendUserMessage(text);\n}\n\n// ── 批3a 三目标注入 ────────────────────────────────────────────────────────────\n\n/** 注入结果（批3a）：处置＝delivered（宿主受理）/queued（真实排队）/rejected（拒绝或未知）。 */\nexport interface DesktopInjectResult {\n\tok: boolean;\n\t处置?: \"delivered\" | \"queued\" | \"rejected\";\n\t原因?: string;\n}\n\nconst INJECT_TEXT_MAX = 100_000;\n\nfunction injectTextCheck(text: unknown): string {\n\tif (typeof text !== \"string\" || !text.trim() || text.length > INJECT_TEXT_MAX)\n\t\tthrow new Error(\"注入正文为空或超长（≤100000 字符）\");\n\treturn text;\n}\n\n/** flow 定位：按实例唯一发现（与 runDesktopFlowCommand 同口径）。 */\nasync function injectFlow(project: string, instance: unknown) {\n\tconst matches = (await readDesktopFlowsFresh(project)).工作流.filter((entry) => entry.控制.实例 === instance);\n\tif (matches.length !== 1) throw new Error(\"实例不在当前项目唯一发现，拒绝注入\");\n\treturn matches[0];\n}\n\n/**\n * 审计：复用 flow.记录 事件 \"inject\"。worker 记卡+attempt 在理由内（无专门字段）；\n * owner 不伪造节点/轮次（不传这两字段）。审计写入失败如实抛出，不假装已投递。\n */\nasync function auditInject(\n\toptions: { cardsDir: string; workspaceDir: string },\n\trecipe: WorkflowRecipe,\n\trecord: { 节点?: string; 轮次?: number; 理由: string },\n): Promise<void> {\n\tawait withFileLock(controlPath(recipe, options), () => {\n\t\tconst latest = readControl(recipe, options);\n\t\tlatest.记录.push({ 时间: utcNow(), 事件: \"inject\", ...record });\n\t\tsaveControl(recipe, options, latest);\n\t});\n}\n\n/** 处理结果映射：宿主 started/handled→delivered，queued→queued，其余→rejected。 */\nfunction mapInjectDisposition(处置: string | undefined, ok: boolean, 原因?: string): DesktopInjectResult {\n\tif (!ok) return { ok: false, 处置: \"rejected\", 原因: 原因 ?? \"未受理\" };\n\tconst mapped = 处置 === \"queued\" ? \"queued\" : \"delivered\";\n\treturn { ok: true, 处置: mapped, ...(原因 ? { 原因 } : {}) };\n}\n\n/**\n * owner 注入（批3a）：发起者必须是本实例 flow.控制.owner；目标 owner 存活且空闲（复用\n * sendDesktopChat 原生接受口径：非空 ≤100000、拒 `/`、ctx.isIdle()）。不要求 nodeName/round。\n */\nexport async function runDesktopOwnerInject(\n\tsessionId: string,\n\tproject: string,\n\tparams: { instance: string; text: string },\n\tsignal?: AbortSignal,\n): Promise<DesktopInjectResult> {\n\tconst text = injectTextCheck(params.text);\n\tconst flow = await injectFlow(project, params.instance);\n\tif (flow.控制.owner !== sessionId) throw new Error(\"注入发起者须是当前实例的 owner 会话\");\n\t// sendDesktopChat 自带 non-empty/≤100000/`/` 拒绝/isIdle 校验；这里先按同一口径投递。\n\tawait sendDesktopChat(sessionId, project, text, signal);\n\t// owner 记录不伪造节点/轮次（schema 字段缺省）。\n\ttry {\n\t\tconst recipe = loadFrozenRecipe(flow.控制.工作流, {\n\t\t\tcardsDir: flow.控制.卡目录,\n\t\t\tworkspaceDir: dirname(flow.路径),\n\t\t});\n\t\tconst options = { cardsDir: flow.控制.卡目录, workspaceDir: dirname(flow.路径) };\n\t\tawait auditInject(options, recipe, {\n\t\t\t理由: `目标=owner（会话 ${sessionId}）；结果=delivered；摘要=${text.slice(0, 200)}`,\n\t\t});\n\t} catch (error) {\n\t\tif (error instanceof FileLockError) throw error;\n\t\t// 已投递但审计失败：如实两项事实，不提示重发。\n\t\treturn {\n\t\t\tok: true,\n\t\t\t处置: \"delivered\",\n\t\t\t原因: `已投递到 owner，但审计写入失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n\treturn { ok: true, 处置: \"delivered\" };\n}\n\n/**\n * 部长注入（批3a）：目标须是当前轮次绑定部长，且实际热会话句柄与 node.部长会话 一致\n * （host-bridge #injectMinister 同范式）。复用 host.inject(dept, root, text, 脉络, \"followUp\")。\n */\nexport async function runDesktopMinisterInject(\n\tsessionId: string,\n\tproject: string,\n\tparams: { instance: string; node: string; round: number; text: string },\n\tsignal?: AbortSignal,\n): Promise<DesktopInjectResult> {\n\tconst text = injectTextCheck(params.text);\n\tconst flow = await injectFlow(project, params.instance);\n\tconst control = flow.控制;\n\tif (control.owner !== sessionId) throw new Error(\"注入发起者须是当前实例的 owner 会话\");\n\tconst node = control.节点.find((entry) => entry.名字 === params.node);\n\tif (!node || node.轮次 !== params.round) throw new Error(\"节点或轮次已变化，请刷新后重试\");\n\tconst def = control.冻结配方.节点.find((entry) => entry.名字 === params.node);\n\tif (!def) throw new Error(\"节点不在冻结配方内，无法定位部门\");\n\t// 脚本节点（批3b-E 启用）不提供注入；内核联合类型尚未含「脚本」，按运行期值防御。\n\tif ((def.执行方式 as string | undefined) === \"脚本\") throw new Error(\"脚本节点不提供注入\");\n\tif (!node.部长会话) throw new Error(\"当前轮次未绑定部长会话，拒绝注入\");\n\t// m4：与 controlOwner 同款的持锁校验——owner() 只查注册表，control.run 会重新解析\n\t// 会话锁并核对仍持有；takeover/残锁丢失后此处如实拒绝，不绕过权限层级。\n\tconst current = await controlOwner(sessionId, project, signal);\n\tconst host = current.getMinisterHost?.();\n\tif (!host) throw new Error(\"本宿主不支持部长注入\");\n\tconst root = projectRootForCards(control.卡目录);\n\tconst hot = host.hotSession(def.部门, root, control.脉络);\n\tif (!hot || hot.会话标识 !== node.部长会话)\n\t\tthrow new Error(`绑定部长 ${node.部长会话} 当前不是 ${def.部门}@${control.脉络} 的热会话，拒绝投递到其他上下文`);\n\tconst delivered = await host.inject(def.部门, root, text, control.脉络, \"followUp\");\n\tconst result = mapInjectDisposition(delivered.处置 ?? delivered.模式, delivered.ok, delivered.原因);\n\t// 已核对身份的投递结果记录（接受或拒绝都写——拒收也是真实处置结果）。\n\ttry {\n\t\tconst recipe = loadFrozenRecipe(control.工作流, {\n\t\t\tcardsDir: control.卡目录,\n\t\t\tworkspaceDir: dirname(flow.路径),\n\t\t});\n\t\tconst options = { cardsDir: control.卡目录, workspaceDir: dirname(flow.路径) };\n\t\tawait auditInject(options, recipe, {\n\t\t\t节点: params.node,\n\t\t\t轮次: params.round,\n\t\t\t理由: `目标=部长 ${node.部长会话}（部门 ${def.部门}）；结果=${result.处置 ?? (result.ok ? \"delivered\" : \"rejected\")}${result.原因 ? `；${result.原因}` : \"\"}；摘要=${text.slice(0, 200)}`,\n\t\t});\n\t} catch (error) {\n\t\tif (error instanceof FileLockError) throw error;\n\t\treturn {\n\t\t\t...result,\n\t\t\t原因: `${result.原因 ? `${result.原因}；` : \"\"}审计写入失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n\treturn result;\n}\n\n/**\n * worker 注入（批3a）：目标执行须属于当前节点当前轮（cardRef ∈ node.卡、attempt=当前\n * node 轮次的执行尝试、executionId 在途且属于本实例卡路径）。经 DesktopOwnerEntry.injectWorker\n * 投递；不向同节点另一 worker 代投（executionId 唯一定位）。\n */\nexport async function runDesktopWorkerInject(\n\tsessionId: string,\n\tproject: string,\n\tparams: {\n\t\tinstance: string;\n\t\tnode: string;\n\t\tround: number;\n\t\tcardRef: string;\n\t\texecutionId: string;\n\t\tattempt: number;\n\t\ttext: string;\n\t},\n\tsignal?: AbortSignal,\n): Promise<DesktopInjectResult> {\n\tconst text = injectTextCheck(params.text);\n\tconst flow = await injectFlow(project, params.instance);\n\tconst control = flow.控制;\n\tif (control.owner !== sessionId) throw new Error(\"注入发起者须是当前实例的 owner 会话\");\n\tconst node = control.节点.find((entry) => entry.名字 === params.node);\n\tif (!node || node.轮次 !== params.round) throw new Error(\"节点或轮次已变化，请刷新后重试\");\n\tconst def = control.冻结配方.节点.find((entry) => entry.名字 === params.node);\n\tif ((def?.执行方式 as string | undefined) === \"脚本\") throw new Error(\"脚本节点不提供注入\");\n\t// 卡须属于当前节点当前轮的卡集（引用形态非法→parseCardRef 抛错如实上抛）。\n\tconst cardNo = parseCardRef(params.cardRef);\n\tconst inNode = node.卡.some((ref) => {\n\t\ttry {\n\t\t\treturn parseCardRef(ref) === cardNo;\n\t\t} catch {\n\t\t\treturn false;\n\t\t}\n\t});\n\tif (!inNode) throw new Error(`卡 ${params.cardRef} 不属于节点「${params.node}」当前轮次，拒绝注入`);\n\t// 卡路径按真实卡文件定位（卡名含 slug 后缀，不能拼 formatCardNumber+\".md\"）。\n\tconst cardPath = realpathSync(locateDispatchCard(control.卡目录, params.cardRef).path);\n\t// m4：与 controlOwner 同款的持锁校验——owner() 只查注册表，control.run 会重新解析\n\t// 会话锁并核对仍持有；takeover/残锁丢失后此处如实拒绝，不绕过权限层级。\n\tconst current = await controlOwner(sessionId, project, signal);\n\tif (!current.injectWorker) throw new Error(\"本宿主不支持 worker 注入\");\n\t// 执行锚点：executionId 在途、卡路径归属本节点、attempt 为当前尝试。\n\tconst active = readDesktopWorkerActivity(project).find((row) => row.执行标识 === params.executionId);\n\tif (!active) throw new Error(`执行标识 ${params.executionId} 当前无在途 worker`);\n\tif (!active.运行中) throw new Error(`执行标识 ${params.executionId} 对应 worker 已结束，拒绝注入`);\n\tif (pathKey(active.卡路径) !== pathKey(cardPath))\n\t\tthrow new Error(`执行标识 ${params.executionId} 不属于卡 ${params.cardRef}，拒绝跨 worker 代投`);\n\tif (active.尝试 !== params.attempt)\n\t\tthrow new Error(`attempt ${params.attempt} 与执行标识 ${params.executionId} 当前尝试 ${active.尝试} 不一致`);\n\tconst delivered = await current.injectWorker(params.executionId, text);\n\tconst result = mapInjectDisposition(delivered.处置, delivered.ok, delivered.原因);\n\t// 已核对身份的投递结果记录（worker 记卡+attempt 在理由内）。\n\ttry {\n\t\tconst recipe = loadFrozenRecipe(control.工作流, {\n\t\t\tcardsDir: control.卡目录,\n\t\t\tworkspaceDir: dirname(flow.路径),\n\t\t});\n\t\tconst options = { cardsDir: control.卡目录, workspaceDir: dirname(flow.路径) };\n\t\tawait auditInject(options, recipe, {\n\t\t\t节点: params.node,\n\t\t\t轮次: params.round,\n\t\t\t理由: `目标=worker 执行 ${params.executionId}（卡 ${formatCardNumber(cardNo)} attempt ${params.attempt}）；结果=${result.处置 ?? (result.ok ? \"delivered\" : \"rejected\")}${result.原因 ? `；${result.原因}` : \"\"}；摘要=${text.slice(0, 200)}`,\n\t\t});\n\t} catch (error) {\n\t\tif (error instanceof FileLockError) throw error;\n\t\treturn {\n\t\t\t...result,\n\t\t\t原因: `${result.原因 ? `${result.原因}；` : \"\"}审计写入失败：${error instanceof Error ? error.message : String(error)}`,\n\t\t};\n\t}\n\treturn result;\n}\n\nexport async function installDesktopTemplate(\n\tsessionId: string,\n\tproject: string,\n\ttemplateId: string,\n\tname?: string,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\tconst current = await controlOwner(sessionId, project, signal);\n\tconst home = resolvePaoHome();\n\tconst preview = inspectTemplateInstall(home, templateId, { name });\n\tif (\n\t\t!current.ctx.hasUI ||\n\t\t!(await current.ctx.ui.confirm(\n\t\t\t\"安装工作流模板\",\n\t\t\t`${preview.name}\\n${preview.description}\\n${preview.status}\\n${preview.diff}\\n同名修改默认保留，不自动覆盖。`,\n\t\t))\n\t)\n\t\tthrow new Error(\"未确认安装模板\");\n\towner(sessionId, project);\n\tawait installStarterTemplate(home, templateId, { name });\n}\n\nexport async function saveDesktopRecipe(\n\tsessionId: string,\n\tproject: string,\n\trecipe: WorkflowRecipe,\n\trevision: string | null,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\tconst current = await controlOwner(sessionId, project, signal);\n\tconst home = resolvePaoHome();\n\tconst text = await checkDesktopRecipeEdit(home, project, recipe, revision);\n\tif (\n\t\t!current.ctx.hasUI ||\n\t\t!(await current.ctx.ui.confirm(\"保存工作流配方\", `${text}\\n覆盖现有配方会先留备份；运行实例不热更新。`))\n\t)\n\t\tthrow new Error(\"未确认保存，未修改配方\");\n\towner(sessionId, project);\n\tawait checkDesktopRecipeEdit(home, project, recipe, revision);\n\tconst flow = listPaoSubcommands(current.pi).find((entry) => entry.name === \"flow\");\n\tif (!flow) throw new Error(\"原 owner 没有工作流入口\");\n\tawait flow.run(\n\t\tcurrent.pi,\n\t\t`save ${JSON.stringify({ name: recipe.名字, content: text, overwrite: revision !== null })}`,\n\t\tcurrent.ctx,\n\t);\n}\n\n/** 桌面删除配方入口：守卫（版本漂移/清单不可读/运行中实例，与编辑同拒绝模式）＋ ui.confirm\n *  显式确认后复用内核 deleteRecipe（只删 <名字>.md 本体；同名 .bak 备份与实例冻结图不受影响）。 */\nexport async function deleteDesktopRecipe(\n\tsessionId: string,\n\tproject: string,\n\tname: string,\n\trevision: string | null,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\tconst current = await controlOwner(sessionId, project, signal);\n\tconst home = resolvePaoHome();\n\tconst check = () => checkDesktopRecipeDelete(home, project, name, revision);\n\tawait check();\n\tif (\n\t\t!current.ctx.hasUI ||\n\t\t!(await current.ctx.ui.confirm(\n\t\t\t\"删除工作流配方\",\n\t\t\t`删除 ${recipePath(home, name)}\\n同名 .bak 备份与冻结运行记录不受影响。`,\n\t\t))\n\t)\n\t\tthrow new Error(\"未确认删除，未修改配方\");\n\towner(sessionId, project);\n\tawait check();\n\tdeleteRecipe(home, name);\n}\n\nexport async function startDesktopWorkflow(\n\tsessionId: string,\n\tproject: string,\n\trecipe: WorkflowRecipe,\n\trevision: string,\n\tparameters: Record<string, string>,\n\tmasterTier: string,\n\tthinking: string,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\tconst current = await controlOwner(sessionId, project, signal);\n\tif (!current.ctx.isIdle()) throw new Error(\"原会话仍在执行，不能同时启流\");\n\tconst home = resolvePaoHome();\n\tconst check = () => {\n\t\tif (parameters.项目 && realpathSync(parameters.项目) !== realpathSync(project))\n\t\t\tthrow new Error(\"项目参数必须是当前主控项目；请切换到目标项目的专属主控后启动。\");\n\t\tconst actual = readFileSync(recipePath(home, recipe.名字), \"utf8\");\n\t\tif (recipeRevision(actual) !== revision) throw new Error(\"配方版本已变化，请刷新并重新预检\");\n\t\tif (\n\t\t\trenderDesktopRecipe(home, parseRecipe(actual, recipePath(home, recipe.名字))) !==\n\t\t\trenderDesktopRecipe(home, recipe)\n\t\t)\n\t\t\tthrow new Error(\"画布存在未保存改动；先保存，再启动，不能预览一份却执行另一份\");\n\t\tconst preview = previewDesktopWorkflow(home, project, recipe, parameters);\n\t\tif (!preview.report.canStart) throw new Error(`启动前检查未过：${JSON.stringify(preview.report.items)}`);\n\t\treturn preview;\n\t};\n\tconst preview = check();\n\tconst tiers = loadTierConfig(join(home, TIER_CONFIG_RELATIVE_PATH));\n\tconst tier = tiers.档位.find((entry) => entry.名 === masterTier);\n\tif (!tier || !THINKING_LEVELS.includes(thinking as (typeof THINKING_LEVELS)[number]))\n\t\tthrow new Error(\"主控档位或思考强度无效\");\n\tconst model = current.ctx.modelRegistry.find(tiers.provider, masterTier);\n\tif (!model) throw new Error(\"主控虚拟档位未注册，不能猜测其他模型\");\n\tif (\n\t\t!current.ctx.hasUI ||\n\t\t!(await current.ctx.ui.confirm(\n\t\t\t\"显式启动新工作流\",\n\t\t\t`${JSON.stringify(preview, null, 2)}\\n主控：${masterTier} / ${thinking}\\n启动会产生真实模型请求。`,\n\t\t))\n\t)\n\t\tthrow new Error(\"未确认启动，未派发\");\n\towner(sessionId, project);\n\tcheck();\n\tconst flow = listPaoSubcommands(current.pi).find((entry) => entry.name === \"flow\");\n\tif (!flow) throw new Error(\"原 owner 没有工作流入口\");\n\tconst previousModel = current.ctx.model;\n\tconst previousThinking = current.pi.getThinkingLevel();\n\tconst originalOwner = owner(sessionId, project);\n\ttry {\n\t\tif (!(await current.pi.setModel(model))) throw new Error(\"主控模型切换失败，未启动\");\n\t\tawait current.recheck();\n\t\tcurrent.pi.setThinkingLevel(thinking as (typeof THINKING_LEVELS)[number]);\n\t\tconst cardsDir = join(project, \".pao\", `工作流-${recipe.名字}-${randomUUID()}`, \"卡\");\n\t\tawait flow.run(\n\t\t\tcurrent.pi,\n\t\t\t`start ${JSON.stringify({ name: recipe.名字, params: parameters, cards_dir: cardsDir })}`,\n\t\t\tcurrent.ctx,\n\t\t);\n\t} catch (error) {\n\t\tif (\n\t\t\tdesktopOwnerEntry(sessionId) !== originalOwner ||\n\t\t\toriginalOwner.ctx.sessionManager.getSessionId() !== sessionId\n\t\t)\n\t\t\tthrow error;\n\t\tif (previousModel && !(await current.pi.setModel(previousModel)))\n\t\t\tthrow new Error(`启流失败且旧模型恢复失败：${String(error)}`);\n\t\tcurrent.pi.setThinkingLevel(previousThinking);\n\t\tthrow error;\n\t}\n}\n\n/**\n * 当前机脚本解释器探测（批3b-U）：包装 getPowerShellConfig 的只读结果。\n * 如实返回「当前机将用」的解释器（pwsh.exe→powershell.exe 探测序），不是历史执行当时值——\n * 执行层未持久化 interpreter，这是登记边界。探测失败（非 Windows/未装）落 可用:false 不抛顶层。\n */\nexport type DesktopScriptInterpreter =\n\t| { 可用: true; 解释器: string; 种类: \"pwsh\" | \"powershell\" }\n\t| { 可用: false; 原因: string };\n\nexport function readDesktopScriptInterpreter(): DesktopScriptInterpreter {\n\ttry {\n\t\tconst config = getPowerShellConfig();\n\t\tconst leaf = config.shell.replace(/\\\\/g, \"/\").split(\"/\").pop()?.toLowerCase() ?? \"\";\n\t\tconst 种类 = leaf.startsWith(\"pwsh\") ? (\"pwsh\" as const) : (\"powershell\" as const);\n\t\treturn { 可用: true, 解释器: config.shell, 种类 };\n\t} catch (error) {\n\t\treturn { 可用: false, 原因: error instanceof Error ? error.message : String(error) };\n\t}\n}\n\n/** 仅已有记忆命令；确认、供应商身份和写前重核继续由 owner 实现负责。 */\nexport async function runDesktopMemoryCommand(\n\tsessionId: string,\n\tproject: string,\n\targs: string,\n\trevision: string,\n\tsignal?: AbortSignal,\n): Promise<void> {\n\t// O06/J03：管理子命令（rebuild/backup/restore）不涉注入编号，\n\t// 不经 revision 快照校验；纠正/忘却仍按编号操作必须带最新 revision。\n\tconst isMaintenance = /^(?:rebuild|backup|restore)\\b/.test(args.trim());\n\tif (!isMaintenance && !/^(?:exclude|forget) \\d+$|^correct \\d+ [\\s\\S]+$/.test(args))\n\t\tthrow new Error(\"记忆动作参数不合法\");\n\tconst current = await controlOwner(sessionId, project, signal);\n\tif (\n\t\t!isMaintenance &&\n\t\tcreateHash(\"sha256\")\n\t\t\t.update(JSON.stringify(sessionMemory(current.pi).snapshot()))\n\t\t\t.digest(\"hex\") !== revision\n\t)\n\t\tthrow new Error(\"记忆来源已变化，旧编号操作失效；请刷新后重新选择。\");\n\tif (!current.ctx.isIdle()) throw new Error(\"会话正在执行，请结束或停止后操作记忆。\");\n\tconst commands = listPaoSubcommands(current.pi);\n\tconst control = commands.find((entry) => entry.name === \"runtime\");\n\tconst memory = commands.find((entry) => entry.name === \"memory\");\n\tif (!control || !memory) throw new Error(\"此 owner 没有可用的控制权/记忆入口\");\n\tawait control.run(current.pi, \"\", current.ctx);\n\towner(sessionId, project);\n\tawait memory.run(current.pi, args, current.ctx);\n}\n"},"tags":["fixable"],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * 内置记忆的桌面公开入口（S4-01）：列表/详情/使用记录/变更/来源回读五函数，\n * 全部只依赖 `openMemoryService(home)`——不需要活动 session owner，import { join } from \"node:path\";\nimport type { Usage } from \"@pao/ai\";\nimport { SessionManager } from \"../../core/session-manager.ts\";\nimport type { ArchivedEventgetEffectiveVersion } from \"../memoryevolutionarchive.tsactivation.ts\";listTaskBindings,ContextUsageSnapshotTaskBinding } from \"../context-usage.tsbinding.ts\nimport {\n\ttypegetEffectiveVersion ActivationHistoryEntry,\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../evolution/control.ts\nimport { countU