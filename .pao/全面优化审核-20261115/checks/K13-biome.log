},candidate: { passed: false },verdict: \"failed\",reason: \"正常用法被破坏\",\n\t\t\t\t}),\n\t\t\t],\n\t\t\tcreatedAt: AT2,\t\texpect(result.score.normal.failed).toBe(1);\n\n\t\tconst row = (`SELECT status, failure_reason FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"failed\");\n\t\texpect(row.failure_reason).toContain(\"验证失败\");paoHome: home,\n\t\t\treproduction: [{ input: \"复现\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\t\texpect(result.caseResults[0].verdict).toBe(\"incomplete\");\n\n\t\tconst row = .get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"验证未完成\");\t\t\tpaoHome: home,\n\t\t\tcaseResults: [\n\t\t\t\tmakeCaseResult({caseId: \"reproduction-0\",baseline: { passed: false },reason: \"原问题未修复\"}),\n\t\t\t\tmakeCaseResult({ caseId: \"normal-0\", baseline: { passed: true }, candidate: { passed: true } }),\n\t\t\t],\n\t\t// 初始状态 proposed\n\t\tlet row = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as {status: string;\n\t\t};\n\t\texpect(row.status).toBe(\"proposed\");\n\t\t});\n\n\t\trow = store.db.prepare(`SELECT status FROM evolution_candidates WHERE candidate_id = ?`).get(candidateId) as {};\n\t\texpect(row.status).toBe(\"passed\");\n\t\tstore.close();\t\t// 不传 sourceRefs → 内核自动读 problem links。\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\t\t\t.run(\"link-prob-eval\", problemId, \"evidence:prob-src\", AT);\n\t\tconst plan = freezeValidationPlan(store, {\n\t\t\tproblemId,\t\tif (!result.ok) return;\n\t\texpect(result.verdict).toBe(\"incomplete\");\n\t\tconst row = .get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"未知 caseId:unknown-9\");.get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"重复 caseId:reproduction-0\");paoHome: home,\n\t\t\treproduction: [{ input: \"x\", initialFiles: {}, allowedTools: [], acceptance: \"x\" }],\n\t\t\tnormal: [],\n\t\t// 登记 source links\n\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'problem', ?, ?, ?)`)\n\t\t\t.run(\"link-p-1\", problemId, sourceId, AT);\n\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'candidate', ?, ?, ?)`)\n\t\t\t.run(\"link-c-1\", candidateId, sourceId, AT);\n\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at) VALUES (?, 'validation', ?, ?, ?)`)\n\t\t\t.run(\"link-v-1\", plan.testPlanId, sourceId, AT);\n\n\t\t// 候选被标 cancelled\n\t\tconst candRow = .get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(candRow.status).toBe(\"cancelled\");\n\t\texpect(candRow.failure_reason).toContain(\"已删除\");\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(validationId,plan.testPlanId,candidateId,problemId,baseVersion,\n\t\t\t\tJSON.stringify([{\n\t\t\t\t\t\tverdict: \"incomplete\",\n\t\t\t\t\t]),\n\t\t\t\t\"incomplete\",AT,);\n\t\t)\n\t\t\t.run(\"link-v-1\", validationId, sourceId, AT);\n\t\texpect(result.staleCandidateIds).toContain(candidateId);\n\n\t\tconst row = .get(candidateId) as { status: string; failure_reason: string };\n\t\texpect(row.status).toBe(\"cancelled\");\n\t\texpect(row.failure_reason).toContain(\"待重评估\");\t\texpect(result.staleCount).toBe(0);\n\n\t\tconst row = .get(candidateId) as { status: string };\n\t\texpect(row.status).toBe(\"proposed\"); // 未变\n\t\tstore.close();\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,95]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[95,295]}}},{"diffOp":{"insert":{"range":[295,298]}}},{"diffOp":{"equal":{"r