nge":[804,808]}}},{"diffOp":{"equal":{"range":[808,850]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[580,586]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[586,589]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[589,594]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[594,619]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[619,634]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[634,650]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[850,872]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[872,898]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[671,703]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[703,721]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[721,741]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[741,791]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[791,804]}}},{"diffOp":{"insert":{"range":[73,74]}}},{"diffOp":{"equal":{"range":[263,264]}}},{"diffOp":{"insert":{"range":[804,808]}}},{"diffOp":{"equal":{"range":[898,977]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[977,1092]}}},{"diffOp":{"delete":{"range":[148,152]}}},{"diffOp":{"insert":{"range":[147,148]}}},{"diffOp":{"equal":{"range":[1092,1221]}}},{"equalLines":{"line_count":27}},{"diffOp":{"equal":{"range":[1221,1396]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[1396,1401]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[619,630]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[1401,1410]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[148,152]}}},{"diffOp":{"equal":{"range":[1410,1511]}}},{"diffOp":{"insert":{"range":[804,808]}}},{"diffOp":{"equal":{"range":[1511,1601]}}},{"equalLines":{"line_count":43}},{"diffOp":{"equal":{"range":[1601,1648]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[1648,1654]}}},{"diffOp":{"equal":{"range":[1654,1771]}}},{"diffOp":{"delete":{"range":[147,148]}}},{"diffOp":{"insert":{"range":[1648,1654]}}},{"diffOp":{"equal":{"range":[1771,1879]}}},{"equalLines":{"line_count":433}},{"diffOp":{"equal":{"range":[1879,1888]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-boundary.test.ts"},"span":null,"sourceCode":"/**\n * S8-08/09 定向测试：隔离验证执行器与边界核对。\n *\n * 覆盖：\n * - runValidationCase：baseline/candidate 各建独立 home/cwd/sessionDir，\n *   同一 initialFiles 复制；命令用例经 runCardProcess + 安检门；回执落盘\n *   evolution/validations/<testPlanId>/runs/（不在候选可写目录）。\n * - 取消/超时收尾：AbortSignal 取消结果保留取消原因；scratch 收尾删除。\n * - boundary：resolveValidationToolSet 交集外工具记入 rejected；\n *   verifyManagedInputsIntact 检测 plan.json 被改/被删；\n *   checkRunFileChangesWithinSandbox 检测越出工作目录的写入；\n *   auditCandidateForPublish 范围越界候选被拒（改策略/改验收）；\n *   auditResourceCapabilityCoverage 对 extension/command 列出未覆盖缺口。\n * - 嵌套工具调用经受控入口：限定工具集之外的调用只能走 executeTool，\n *   由受控入口统一验证（本测试以工具集核对断言入口约束存在）。\n *\n * 模型/进程一律假（agentSessionFactory 与 processRunner 注入假实现），\n * 不发起真实请求或子进程。\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-boundary.test.ts --maxWorkers=2\n */\nimport { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fauxAssistantMessage, registerFauxProvider } from \"@pao/ai/compat\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport type { CardProcessResult } from \"../../src/pao/cards/process.ts\";\nimport { AuthStorage } from \"../../src/core/auth-storage.ts\";\nimport {\n\tauditCandidateForPublish,\n\tauditResourceCapabilityCoverage,\n\tcheckRunFileChangesWithinSandbox,\n\tresolveValidationToolSet,\n\tsnapshotManagedFile,\n\tverifyManagedInputsIntact,\n} from \"../../src/pao/evolution/boundary.ts\";\nimport { registerResource, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { createValidationAgentSession, runValidationCase } from \"../../src/pao/evolution/runner.ts\";\nimport type { ValidationCase } from \"../../src/pao/evolution/types.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { openMemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { createInMemoryModelRegistry, getModelRuntime } from \"../model-runtime-test-utils.ts\";\n\nconst tempDirs: string[] = [];\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-boundary-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\n\nafterEach(async () => {\n\t// Windows 上 SQLite 的 -wal/-shm 句柄在 close 后有释放延迟；多等几拍避开 EPERM，\n\t// 不削弱断言（目录残留只影响临时空间）。\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 10; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 9) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t\t}\n\t\t}\n\t}\n});\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\n/** 造一个已登记 skill 资源 + baseVersion 快照。 */\nfunction seedSkill(home: string, name = \"code-review\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(join(skillDir, \"examples\"), { recursive: true });\n\twriteFileSync(\n\t\tjoin(skillDir, \"SKILL.md\"),\n\t\t\"---\\nname: code-review\\ndescription: 代码评审技能\\n---\\n# code-review\\n步骤一\\n\",\n\t\t\"utf8\",\n\t);\n\twriteFileSync(join(skillDir, \"examples\", \"a.md\"), \"示例 A\\n\", \"utf8\");\n\tconst store = openMemoryStore(home, \"readwrite\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { store, resourceId: `skill:${name}`, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tover: {\n\t\tresourceId?: string;\n\t\tbaseVersion?: string;\n\t} = {},\n) {\n\tconst problemId = \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"技能步骤一错误\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"src-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"pending_classification\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\treturn problemId;\n}\n\nfunction freezePlan(\n\tstore: ReturnType<typeof openMemoryStore>,\n\thome: string,\n\tover: {\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t},\n) {\n\tconst result = freezeValidationPlan(store, {\n\t\tproblemId: over.problemId,\n\t\tresourceId: over.resourceId,\n\t\tbaseVersion: over.baseVersion,\n\t\tpaoHome: home,\n\t\treproduction: [\n\t\t\t{\n\t\t\t\tinput: \"复现输入\",\n\t\t\t\tinitialFiles: { \"input.txt\": \"x\" },\n\t\t\t\tallowedTools: [\"read\"],\n\t\t\t\tacceptance: \"输出 A\",\n\t\t\t},\n\t\t],\n\t\tnormal: [],\n\t\tholdout: [],\n\t\tcreatedAt: AT,\n\t});\n\tif (!result.ok) throw new Error(\"freeze failed\");\n\treturn result;\n}\n\nconst COMMAND_CASE: ValidationCase = {\n\tcaseId: \"reproduction-0\",\n\tgroup: \"reproduction\",\n\tinput: \"复现输入\",\n\tinitialFiles: { \"input.txt\": \"x\" },\n\tallowedTools: [\"read\"],\n\tacceptance: \"exit 0\",\n};\n\n/** 种候选目录文件（O11/E07：candidate 侧从 candidates/ 物化版本副本）。 */\nfunction seedCandidateDir(home: string, resourceId: string, candidateId: string, content = \"# cand\\n\") {\n\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\tconst dir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(dir, { recursive: true });\n\twriteFileSync(join(dir, \"SKILL.md\"), content, \"utf8\");\n\treturn dir;\n}\n\n// ── runValidationCase ───────────────────────────────────────────────────\n\ndescribe(\"runValidationCase\", () => {\n\tit(\"baseline/candidate 各建独立 home/cwd/sessionDir，同一 initialFiles 复制\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst captured: Array<{ cwd: string; env: NodeJS.ProcessEnv }> = [];\n\t\tconst fakeRunner = (_cmd: string, _args: string[], cwd: string, _t: number, env?: NodeJS.ProcessEnv) => {\n\t\t\tcaptured.push({ cwd, env: env ?? {} });\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"ok\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst base = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"baseline\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(base.ok).toBe(true);\n\t\tif (!base.ok) return;\n\t\texpect(base.result.passed).toBe(true);\n\t\texpect(base.result.exitCode).toBe(0);\n\t\texpect(captured).toHaveLength(1);\n\t\t// cwd 是独立 scratch work 目录，且 PAO_HOME 指向隔离 home（不是正式 home）。\n\t\texpect(captured[0]!.cwd).toContain(\"work\");\n\t\texpect(captured[0]!.env.PAO_HOME).toBeDefined();\n\t\texpect(captured[0]!.env.PAO_HOME).not.toBe(home);\n\t\t// initialFiles 已复制进 workDir（通过 fileChanges 反推：input.txt 应无变化）。\n\t\texpect(base.result.fileChanges?.[\"input.txt\"]).toBeUndefined();\n\t\tstore.close();\n\t});\n\n\tit(\"运行回执落盘在 evolution/validations/<testPlanId>/runs/，不在候选可写目录\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst fakeRunner = () => Promise.resolve({ code: 0, stdout: \"out\", stderr: \"\" } as CardProcessResult);\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.receiptPath).toContain(join(\"validations\", plan.testPlanId, \"runs\"));\n\t\texpect(result.receiptPath).not.toContain(\"candidates\");\n\t\tconst receipt = JSON.parse(readFileSync(result.receiptPath, \"utf8\"));\n\t\texpect(receipt.caseId).toBe(\"reproduction-0\");\n\t\texpect(receipt.side).toBe(\"candidate\");\n\t\texpect(receipt.candidateId).toBe(\"cand-x\");\n\t\texpect(receipt.result.exitCode).toBe(0);\n\t\tstore.close();\n\t});\n\n\tit(\"fileChanges 记录候选在工作目录内的实际写动作\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\t// 假进程：在 workDir 里写一个文件。\n\t\tconst fakeRunner = (_c: string, _a: string[], cwd: string) => {\n\t\t\twriteFileSync(join(cwd, \"out.txt\"), \"written\", \"utf8\");\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"ok\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"node\", args: [\"-e\", \"1\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.fileChanges?.[\"out.txt\"]).toMatch(/^new:/);\n\t\tstore.close();\n\t});\n\n\tit(\"取消信号传给进程，结果保留取消原因且 scratch 收尾\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tconst controller = new AbortController();\n\t\tlet sawAbort = false;\n\t\t// 运行中取消：进程执行期间触发 abort，进程以 AbortError 收尾。\n\t\tconst fakeRunner = (\n\t\t\t_c: string,\n\t\t\t_a: string[],\n\t\t\t_cwd: string,\n\t\t\t_t: number,\n\t\t\t_e: NodeJS.ProcessEnv | undefined,\n\t\t\tsignal?: AbortSignal,\n\t\t) => {\n\t\t\tcontroller.abort(\"用户取消\");\n\t\t\tsawAbort = signal?.aborted === true;\n\t\t\tconst err = new Error(\"aborted\");\n\t\t\terr.name = \"AbortError\";\n\t\t\treturn Promise.reject(err);\n\t\t};\n\t\ttry {\n\t\t\tconst result = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ processRunner: fakeRunner },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"baseline\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"command\",\n\t\t\t\t\tverifier: { cmd: \"node\", args: [\"--version\"] },\n\t\t\t\t\tsignal: controller.signal,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\texpect(result.ok).toBe(true);\n\t\t\tif (result.ok) {\n\t\t\t\texpect(sawAbort).toBe(true);\n\t\t\t\texpect(result.cancelReason).toBeDefined();\n\t\t\t\texpect(result.result.failureReason).toContain(\"已取消\");\n\t\t\t\t// scratch 已删除（keepScratch 缺省 false）。\n\t\t\t\texpect(result.scratchDir).toBeUndefined();\n\t\t\t}\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n\n\tit(\"验证器命令未过安检门即拒（候选无法注入新命令）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\n\t\tlet ran = false;\n\t\tconst fakeRunner = () => {\n\t\t\tran = true;\n\t\t\treturn Promise.resolve({ code: 0, stdout: \"\", stderr: \"\" } as CardProcessResult);\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ processRunner: fakeRunner },\n\t\t\t{\n\t\t\t\tvalidationCase: COMMAND_CASE,\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"baseline\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"command\",\n\t\t\t\tverifier: { cmd: \"cmd\", args: [\"/c\", \"echo\", \"hi\"] },\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(ran).toBe(false);\n\t\texpect(result.result.failureReason).toContain(\"未过安检\");\n\t\texpect(result.result.passed).toBe(false);\n\t\tstore.close();\n\t});\n\n\tit(\"agent 用例经 agentSessionFactory 隔离入口，显式传 agentDir/sessionDir/cwd/版本副本路径\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst captured: Array<{ agentDir: string; sessionDir: string; cwd: string; homeDir: string; resourceCopyDir?: string; timeoutMs?: number }> = [];\n\t\tconst fakeFactory = (input: { agentDir: string; sessionDir: string; cwd: string; homeDir: string; resourceCopyDir?: string; timeoutMs?: number }) => {\n\t\t\tcaptured.push(input);\n\t\t\treturn Promise.resolve({ output: \"assistant output\", completed: true, requestId: \"req-1\" });\n\t\t};\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [\"read\"], modelConfig: { tier: \"fast\" } },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\ttimeoutMs: 60000,\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(captured).toHaveLength(1);\n\t\texpect(captured[0]!.agentDir).toContain(\"agent\");\n\t\texpect(captured[0]!.sessionDir).toContain(\"session\");\n\t\texpect(captured[0]!.cwd).toContain(\"work\");\n\t\t// O11/E07：resourceCopyDir 自动解析为物化副本目录（workDir/resource/），\n\t\t// 源目录是 candidates/<dirSafe>/<candidateId>；timeoutMs 透传工厂。\n\t\texpect(captured[0]!.resourceCopyDir).toContain(join(\"work\", \"resource\"));\n\t\texpect(captured[0]!.timeoutMs).toBe(60000);\n\t\t// 回执带 requestId。\n\t\tconst receipt = JSON.parse(readFileSync(result.receiptPath, \"utf8\"));\n\t\texpect(receipt.requestId).toBe(\"req-1\");\n\t\texpect(receipt.modelConfig?.tier).toBe(\"fast\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：command 双侧各自物化版本副本产生真实差异（baseline 旧版失败，candidate 新版通过）\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// baseline 源（versions/<baseVersion>/SKILL.md）= seedSkill 写的旧版「# code-review\\n步骤一\\n」；\n\t\t// candidate 源（candidates/<cand-x>/SKILL.md）= 修复版含「步骤三」。\n\t\tseedCandidateDir(home, resourceId, \"cand-x\", \"# code-review\\n步骤一\\n步骤三\\n\");\n\n\t\t// 验证器读 resource/SKILL.md 查「步骤三」：真实进程跑 node -e（写进 initialFiles 的 check.js）。\n\t\tconst needle = \"步骤三\";\n\t\tconst checkJs = `const fs=require(\"fs\");process.exit(fs.readFileSync(\"resource/SKILL.md\",\"utf8\").includes(${JSON.stringify(needle)})?0:1);`;\n\t\tconst kase: ValidationCase = { ...COMMAND_CASE, initialFiles: { \"check.js\": checkJs }, allowedTools: [] };\n\n\t\tconst base = await runValidationCase(store, {}, {\n\t\t\tvalidationCase: kase,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tside: \"baseline\",\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tkind: \"command\",\n\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\trunAt: AT,\n\t\t});\n\t\tconst cand = await runValidationCase(store, {}, {\n\t\t\tvalidationCase: kase,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\tside: \"candidate\",\n\t\t\tcandidateId: \"cand-x\",\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tpaoHome: home,\n\t\t\tkind: \"command\",\n\t\t\tverifier: { cmd: \"node\", args: [\"check.js\"] },\n\t\t\trunAt: AT,\n\t\t});\n\t\texpect(base.ok && cand.ok).toBe(true);\n\t\tif (!base.ok || !cand.ok) return;\n\t\t// baseline 旧版（无步骤三）failed；candidate 新版（有步骤三）passed——\n\t\t// 差异来自物化的版本副本，不是 initialFiles 逐侧替换。\n\t\texpect(base.result.passed).toBe(false);\n\t\texpect(cand.result.passed).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：candidate 侧 abortReason → passed:false + executionFailure=cancel\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\t// 假工厂返回 abortReason：会话被中止——执行故障，不可通过。\n\t\tconst fakeFactory = () =>\n\t\t\tPromise.resolve({ output: \"半截输出\", abortReason: \"timeout 120000ms\" });\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [] },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.passed).toBe(false);\n\t\texpect(result.result.executionFailure).toBe(\"cancel\");\n\t\texpect(result.result.failureReason).toContain(\"中止\");\n\t\tstore.close();\n\t});\n\n\tit(\"O11/E07：真机制假模型——baseline/candidate 物化副本经同一假 provider 产出不同输出\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// baseline 版本快照（seedSkill 写入的旧版 SKILL.md 只有「步骤一」）；\n\t\t// candidate 目录写入修复版（含「步骤三」）。\n\t\tseedCandidateDir(home, resourceId, \"cand-x\", \"---\\nname: code-review\\ndescription: 代码评审技能\\n---\\n# code-review\\n步骤一\\n步骤三\\n\");\n\n\t\t// 装配假 provider + ModelRuntime（机制=真实 createValidationAgentSession，\n\t\t// 模型=faux；本用例验证「双侧副本差异经同一 provider 产生不同输出」这一\n\t\t// 链路的真实机制，真实 provider 闭环归 O15）。\n\t\tconst faux = registerFauxProvider();\n\t\ttry {\n\t\t\tconst authStorage = AuthStorage.inMemory();\n\t\t\tawait authStorage.modify(faux.getModel().provider, async () => ({ type: \"api_key\", key: \"faux-key\" }));\n\t\t\tconst modelRegistry = await createInMemoryModelRegistry(authStorage);\n\t\t\tmodelRegistry.registerProvider(faux.getModel().provider, {\n\t\t\t\tbaseUrl: faux.getModel().baseUrl,\n\t\t\t\tapiKey: \"faux-key\",\n\t\t\t\tapi: faux.api,\n\t\t\t\tmodels: faux.models.map((registeredModel) => ({\n\t\t\t\t\tid: registeredModel.id,\n\t\t\t\t\tname: registeredModel.name,\n\t\t\t\t\tapi: registeredModel.api,\n\t\t\t\t\treasoning: registeredModel.reasoning,\n\t\t\t\t\tinput: registeredModel.input,\n\t\t\t\t\tinputLimits: registeredModel.inputLimits,\n\t\t\t\t\tcost: registeredModel.cost,\n\t\t\t\t\tcontextWindow: registeredModel.contextWindow,\n\t\t\t\t\tmaxTokens: registeredModel.maxTokens,\n\t\t\t\t\tbaseUrl: registeredModel.baseUrl,\n\t\t\t\t})),\n\t\t\t});\n\t\t\tconst modelRuntime = getModelRuntime(modelRegistry);\n\n\t\t\t// 假 provider 逐调用回读模型上下文（/skill:code-review 展开把该侧\n\t\t\t// resource/SKILL.md 正文灌进 user 消息），回报正文中是否含「步骤三」。\n\t\t\tconst needle = \"步骤三\";\n\t\t\tconst contextHasNeedle = (context: { messages: Array<{ role: string; content: unknown }> }) =>\n\t\t\t\tcontext.messages.some((m) => {\n\t\t\t\t\tif (m.role !== \"user\") return false;\n\t\t\t\t\tif (typeof m.content === \"string\") return m.content.includes(needle);\n\t\t\t\t\tif (Array.isArray(m.content)) {\n\t\t\t\t\t\treturn m.content.some(\n\t\t\t\t\t\t\t(block) =>\n\t\t\t\t\t\t\t\ttypeof block === \"object\" &&\n\t\t\t\t\t\t\t\tblock !== null &&\n\t\t\t\t\t\t\t\t(block as { type?: string; text?: string }).type === \"text\" &&\n\t\t\t\t\t\t\t\t((block as { text?: string }).text ?? \"\").includes(needle),\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t\treturn false;\n\t\t\t\t});\n\t\t\tfaux.setResponses([\n\t\t\t\t(context) => fauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t\t(context) => fauxAssistantMessage(contextHasNeedle(context) ? `skill-has-${needle}` : `skill-missing-${needle}`),\n\t\t\t]);\n\n\t\t\t// 用例 input=/skill:code-review —— 会话内技能展开把该侧 resource/ 副本的\n\t\t\t// SKILL.md 正文注入模型上下文；baseline 副本无步骤三、candidate 副本有。\n\t\t\tconst kase: ValidationCase = {\n\t\t\t\t...COMMAND_CASE,\n\t\t\t\tinput: \"/skill:code-review\",\n\t\t\t\tinitialFiles: {},\n\t\t\t\tallowedTools: [],\n\t\t\t\t// 冻结样例固定模型（modelConfig.model=\"provider/id\"）——验证可复现，\n\t\t\t\t// 不把「可用清单首个」的偶然选择当验收依据。\n\t\t\t\tmodelConfig: { model: `${faux.getModel().provider}/${faux.getModel().id}` },\n\t\t\t};\n\t\t\tconst base = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ agentSessionFactory: (input) => createValidationAgentSession(input, { modelRuntime }) },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: kase,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"baseline\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"agent\",\n\t\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\t\ttimeoutMs: 120000,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\tconst cand = await runValidationCase(\n\t\t\t\tstore,\n\t\t\t\t{ agentSessionFactory: (input) => createValidationAgentSession(input, { modelRuntime }) },\n\t\t\t\t{\n\t\t\t\t\tvalidationCase: kase,\n\t\t\t\t\tresourceId,\n\t\t\t\t\tbaseVersion,\n\t\t\t\t\tside: \"candidate\",\n\t\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\t\tpaoHome: home,\n\t\t\t\t\tkind: \"agent\",\n\t\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\t\ttimeoutMs: 120000,\n\t\t\t\t\trunAt: AT,\n\t\t\t\t},\n\t\t\t);\n\t\t\texpect(base.ok && cand.ok).toBe(true);\n\t\t\tif (!base.ok || !cand.ok) return;\n\t\t\t// 双侧会话均完整跑完（passed=会话完成语义），输出差异来自物化版本副本。\n\t\t\texpect(base.result.passed).toBe(true);\n\t\t\texpect(cand.result.passed).toBe(true);\n\t\t\texpect(base.result.output).toContain(\"skill-missing-步骤三\");\n\t\t\texpect(cand.result.output).toContain(\"skill-has-步骤三\");\n\t\t\t// 同一假 provider 共处理两次调用（baseline 一次、candidate 一次）。\n\t\t\texpect(faux.state.callCount).toBe(2);\n\t\t\tstore.close();\n\t\t} finally {\n\t\t\tfaux.unregister();\n\t\t}\n\t});\n\n\tit(\"O11/E07：agent 会话未完整收尾（completed=false）→ executionFailure=start 不当业务通过\", async () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tseedCandidateDir(home, resourceId, \"cand-x\");\n\n\t\tconst fakeFactory = () => Promise.resolve({ output: \"\", completed: false });\n\t\tconst result = await runValidationCase(\n\t\t\tstore,\n\t\t\t{ agentSessionFactory: fakeFactory },\n\t\t\t{\n\t\t\t\tvalidationCase: { ...COMMAND_CASE, allowedTools: [] },\n\t\t\t\tresourceId,\n\t\t\t\tbaseVersion,\n\t\t\t\tside: \"candidate\",\n\t\t\t\tcandidateId: \"cand-x\",\n\t\t\t\ttestPlanId: plan.testPlanId,\n\t\t\t\tpaoHome: home,\n\t\t\t\tkind: \"agent\",\n\t\t\t\tloadMethod: \"skill-path\",\n\t\t\t\trunAt: AT,\n\t\t\t},\n\t\t);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(result.result.passed).toBe(false);\n\t\texpect(result.result.executionFailure).toBe(\"start\");\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: 工具集限定 ────────────────────────────────────────────────\n\ndescribe(\"resolveValidationToolSet\", () => {\n\tit(\"限定工具集取交集；交集外工具记入 rejected\", () => {\n\t\tconst toolset = resolveValidationToolSet({\n\t\t\t...COMMAND_CASE,\n\t\t\tallowedTools: [\"read\", \"bash\", \"pao_verify_card\", \"grep\"],\n\t\t});\n\t\texpect(toolset.allowed).toEqual(expect.arrayContaining([\"read\", \"grep\"]));\n\t\texpect(toolset.allowed).not.toContain(\"bash\");\n\t\texpect(toolset.rejected).toEqual(expect.arrayContaining([\"bash\", \"pao_verify_card\"]));\n\t});\n\n\tit(\"嵌套工具调用经受控入口：只有交集内工具可激活\", () => {\n\t\t// 交集外的工具名（如未授权扩展工具）不进入允许清单；\n\t\t// 嵌套调用经 ExtensionToolContext.executeTool 统一验证/钩子/权限，\n\t\t// 只能命中已激活的工具集。本测试断言「未授权工具不在可激活清单」这一入口约束。\n\t\tconst toolset = resolveValidationToolSet({\n\t\t\t...COMMAND_CASE,\n\t\t\tallowedTools: [\"read\", \"malicious_tool\"],\n\t\t});\n\t\texpect(toolset.allowed).toEqual([\"read\"]);\n\t\texpect(toolset.rejected).toEqual([\"malicious_tool\"]);\n\t});\n});\n\n// ── boundary: 受管输入核对 ─────────────────────────────────────────────\n\ndescribe(\"verifyManagedInputsIntact\", () => {\n\tit(\"plan.json 未被修改时 intact\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(true);\n\t\texpect(check.violations).toHaveLength(0);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 被修改时检出违约\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\twriteFileSync(planPath, JSON.stringify({ tampered: true }), \"utf8\");\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(false);\n\t\texpect(check.violations.some((v) => v.path === \"plan.json\" && v.reason.includes(\"被修改\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 被删除时检出违约\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\trmSync(planPath);\n\n\t\tconst check = verifyManagedInputsIntact({\n\t\t\tpaoHome: home,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tbeforePlan: before,\n\t\t});\n\t\texpect(check.intact).toBe(false);\n\t\texpect(check.violations.some((v) => v.reason.includes(\"被删除\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: run 文件变化越区核对 ─────────────────────────────────────\n\ndescribe(\"checkRunFileChangesWithinSandbox\", () => {\n\tit(\"工作目录内的变化通过\", () => {\n\t\tconst check = checkRunFileChangesWithinSandbox({\n\t\t\t\"out.txt\": \"new:abc\",\n\t\t\t\"sub/dir/f.md\": \"changed:def\",\n\t\t});\n\t\texpect(check.withinSandbox).toBe(true);\n\t});\n\n\tit(\"越出工作目录的写入（.. 前缀）检出\", () => {\n\t\tconst check = checkRunFileChangesWithinSandbox({\n\t\t\t\"../outside.txt\": \"new:abc\",\n\t\t\t\"/abs/path\": \"new:def\",\n\t\t});\n\t\texpect(check.withinSandbox).toBe(false);\n\t\texpect(check.violations).toHaveLength(2);\n\t});\n});\n\n// ── boundary: 发布前核对 ───────────────────────────────────────────────\n\ndescribe(\"auditCandidateForPublish\", () => {\n\tfunction seedCandidate(\n\t\tstore: ReturnType<typeof openMemoryStore>,\n\t\tover: {\n\t\t\tproblemId: string;\n\t\t\tresourceId: string;\n\t\t\tbaseVersion: string;\n\t\t\ttestPlanId: string;\n\t\t\tdiffs: Array<{ path: string; kind: \"edit\" | \"create\" | \"delete\"; newContent?: string }>;\n\t\t},\n\t) {\n\t\tconst candidateId = \"cand-audit\";\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\tcandidateId,\n\t\t\t\tover.problemId,\n\t\t\t\tover.resourceId,\n\t\t\t\tover.baseVersion,\n\t\t\t\tover.testPlanId,\n\t\t\t\tJSON.stringify(over.diffs),\n\t\t\t\t\"理由\",\n\t\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\t\t\"passed\",\n\t\t\t\tAT,\n\t\t\t\tAT,\n\t\t\t);\n\t\treturn {\n\t\t\tcandidateId,\n\t\t\tproblemId: over.problemId,\n\t\t\tresourceId: over.resourceId,\n\t\t\tbaseVersion: over.baseVersion,\n\t\t\ttestPlanId: over.testPlanId,\n\t\t\tdiffs: over.diffs,\n\t\t\trationale: \"理由\",\n\t\t\tusageRefs: [\"req-1\"],\n\t\t\tstatus: \"passed\" as const,\n\t\t\tcreatedAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t}\n\n\tit(\"范围内候选 eligible\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"已修正\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, { candidate, paoHome: home });\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(true);\n\t\texpect(audit.violations).toHaveLength(0);\n\t\tstore.close();\n\t});\n\n\tit(\"候选改资源根外文件被拒（范围越界）\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"../escape.md\", kind: \"create\", newContent: \"x\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, { candidate, paoHome: home });\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"路径逃逸\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"候选改固定禁止对象被拒（改策略/改验收）\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\t// 候选试图改 pao配置/档位.json（预算数值，固定禁止对象）。\n\t\t// diff.path 相对资源根 pao配置/skills/code-review；越界写到 pao配置/档位.json\n\t\t// 会被「超出资源根」先拦，这里改为直接构造完整相对路径验证固定禁止对象。\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\t\t// 手动构造一份「改验收」候选：diff.path 指向 validations 受管区（经资源根逃逸）。\n\t\t// assertCandidateWithinScope 用「资源根前缀」核对，escape 到 pao配置/ 仍会被拦。\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate: {\n\t\t\t\t...candidate,\n\t\t\t\tdiffs: [{ path: \"../../档位.json\", kind: \"edit\", newContent: \"{}\" }],\n\t\t\t},\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.length).toBeGreaterThan(0);\n\t\tstore.close();\n\t});\n\n\tit(\"plan.json 在验证期间被修改时 eligible=false\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst planPath = join(evolutionPaths(home).validations, plan.testPlanId, \"plan.json\");\n\t\tconst before = snapshotManagedFile(planPath);\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\t\twriteFileSync(planPath, JSON.stringify({ tampered: true }), \"utf8\");\n\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate,\n\t\t\tpaoHome: home,\n\t\t\tplanSnapshotBefore: before,\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"plan.json\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"run 文件变化越出工作目录时检出\", () => {\n\t\tconst home = tempHome();\n\t\tconst { store, resourceId, baseVersion } = seedSkill(home);\n\t\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t\tconst plan = freezePlan(store, home, { problemId, resourceId, baseVersion });\n\t\tconst candidate = seedCandidate(store, {\n\t\t\tproblemId,\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t\ttestPlanId: plan.testPlanId,\n\t\t\tdiffs: [{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }],\n\t\t});\n\n\t\tconst audit = auditCandidateForPublish(store, {\n\t\t\tcandidate,\n\t\t\tpaoHome: home,\n\t\t\trunFileChanges: [{ \"../outside.txt\": \"new:abc\" }],\n\t\t});\n\t\texpect(audit.ok).toBe(true);\n\t\tif (!audit.ok) return;\n\t\texpect(audit.eligible).toBe(false);\n\t\texpect(audit.violations.some((v) => v.includes(\"越出工作目录\"))).toBe(true);\n\t\tstore.close();\n\t});\n});\n\n// ── boundary: 能力缺口核对 ─────────────────────────────────────────────\n\ndescribe(\"auditResourceCapabilityCoverage\", () => {\n\tit(\"extension 资源列出直接文件/子进程能力缺口（明确不可自动发布）\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openMemoryStore(home, \"readwrite\");\n\t\tregisterResource(store, { kind: \"extension\", name: \"pao_x\", paoHome: home });\n\t\tconst resource = {\n\t\t\tresourceId: \"extension:pao_x\",\n\t\t\tkind: \"extension\" as const,\n\t\t\trelativeRoot: \"pao配置/extensions/pao_x\",\n\t\t\tallowedOps: [\"edit-content\", \"adjust-params\"] as const,\n\t\t\tcapabilityScope: [\"工具实现\", \"参数组织\"],\n\t\t\tloadMethod: \"extension-path\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(false);\n\t\texpect(report.gaps.length).toBeGreaterThan(0);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"子进程\"))).toBe(true);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"文件\"))).toBe(true);\n\t\tstore.close();\n\t});\n\n\tit(\"command 资源：参数组织可覆盖，直接文件/子进程能力列缺口\", () => {\n\t\tconst resource = {\n\t\t\tresourceId: \"command:mycmd\",\n\t\t\tkind: \"command\" as const,\n\t\t\trelativeRoot: \"pao配置/commands/mycmd\",\n\t\t\tallowedOps: [\"adjust-params\"] as const,\n\t\t\tcapabilityScope: [\"参数组织\"],\n\t\t\tloadMethod: \"command-registry\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(false);\n\t\texpect(report.covered.some((c) => c.capability.includes(\"参数组织\"))).toBe(true);\n\t\texpect(report.gaps.some((g) => g.capability.includes(\"文件\") || g.capability.includes(\"子进程\"))).toBe(true);\n\t});\n\n\tit(\"skill 资源：文本生效验证已覆盖，publishable\", () => {\n\t\tconst resource = {\n\t\t\tresourceId: \"skill:code-review\",\n\t\t\tkind: \"skill\" as const,\n\t\t\trelativeRoot: \"pao配置/skills/code-review\",\n\t\t\tallowedOps: [\"edit-content\"] as const,\n\t\t\tcapabilityScope: [\"SKILL.md 正文\"],\n\t\t\tloadMethod: \"skill-path\" as const,\n\t\t\tautoEvolutionEnabled: true,\n\t\t\tregisteredAt: AT,\n\t\t\tupdatedAt: AT,\n\t\t};\n\t\tconst report = auditResourceCapabilityCoverage(resource as never);\n\t\texpect(report.publishable).toBe(true);\n\t\texpect(report.gaps).toHaveLength(0);\n\t});\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。\n\t\t// 坏版 publish 凭据被标停用（disabled=true）。\n\t\tconst pubCred = result.items.find(\n\t\t\t(i) => i.kind === \"publish\" && i.toVersion === newVersionId && !i.effective,\n\t\t);\n\t\texpect(pubCred).toBeDefined();\n\t\texpect(pubCred!.disabled).toBe(true);\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,125]}}},{"equalLines":{"line_count":497}},{"diffOp":{"equal":{"range":[125,223]}}},{"diffOp":{"delete":{"range":[223,227]}}},{"diffOp":{"equal":{"range":[227,302]}}},{"diffOp":{"delete":{"range":[302,306]}}},{"diffOp":{"equal":{"range":[306,381]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[381,390]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-control.test.ts"},"span":null,"sourceCode":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。\n *\n * 覆盖：\n * - restoreResourceVersion 全部判据分支：成功 / 目录缺失或指纹不匹配 /\n *   无可用发布凭据（曾失败标停用）/ 来源依据失效 / expectedEffectiveVersion 冲突；\n * - 恢复事务：UPDATE effective_version + INSERT kind='restore' activation；\n * - setResourceAutoEvolution：停用/恢复本资源，不影响其他资源；\n * - listActivationHistory：publish/restore/rollback 全量时间线 + disabled/effective 标记。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-control.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../../src/pao/evolution/control.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ctl-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（非 src- 前缀，作有效来源；activation/restore\n\t// 前置核对要求 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string; status?: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string; verdict?: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`val-${over.candidateId}`,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"[]\",\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId, skillDir };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── setResourceAutoEvolution ──────────────────────────────────────────────\n\ndescribe(\"setResourceAutoEvolution\", () => {\n\tit(\"停用本资源不影响其他资源；恢复只动本资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store, \"skill-a\");\n\t\tconst { resourceId: otherId } = seedSkill(home, store, \"skill-b\");\n\n\t\t// 停用 A。\n\t\tconst off = setResourceAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\t\texpect(off.ok).toBe(true);\n\t\tif (!off.ok) return;\n\t\texpect(off.autoEvolutionEnabled).toBe(false);\n\n\t\t// B 不受影响。\n\t\tconst other = store.db\n\t\t\t.prepare(`SELECT auto_evolution_enabled FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(otherId) as { auto_evolution_enabled: number };\n\t\texpect(other.auto_evolution_enabled).toBe(1);\n\n\t\t// 恢复 A。\n\t\tconst on = setResourceAutoEvolution(store, { resourceId, enabled: true, updatedAt: AT4 });\n\t\texpect(on.ok).toBe(true);\n\t\tif (!on.ok) return;\n\t\texpect(on.autoEvolutionEnabled).toBe(true);\n\t});\n});\n\n// ── restoreResourceVersion ───────────────────────────────────────────────\n\ndescribe(\"restoreResourceVersion\", () => {\n\tit(\"成功：UPDATE effective_version + INSERT kind='restore' activation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion 之外再造第二版：把 baseVersion 目录指纹与 publish\n\t\t// 凭据补齐——baseVersion 是快照版（无 publish 凭据），恢复它走不通判据 b。\n\t\t// 改为恢复「另一个已发布但未停用的版本」：先回退到 baseVersion，再恢复 newVersionId。\n\t\t// 但 newVersionId 已被停用……所以换个场景：把 newVersionId 当历史版，再造一个\n\t\t// 第三版当坏版，当前指向第三版时恢复 newVersionId（未停用 → 可恢复）。\n\t\t// 简单做法：直接给 baseVersion 补一条 publish 凭据（模拟它也曾被发布过）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-basepub\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbaseVersion,\n\t\t\t\t\"基础版发布凭据（夹具补）\",\n\t\t\t\tJSON.stringify({ candidateId: \"cand-base\" }),\n\t\t\t\tAT,\n\t\t\t);\n\t\t// cand-base 对应候选行（判据 c 查 candidate source_links；不存在则如实报）。\n\t\t// 这里不种候选 → checkRestoreSourceLinksIntact 会返回候选不存在 → needs_reevaluation。\n\t\t// 所以种一个候选行。\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-base\",\n\t\t\tproblemId: seedProblem(store, { problemId: \"prob-base\", resourceId, baseVersion }),\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\t\t// cand-base 的 test_plan_id=\"tp-1\"：restore 核对「凭据候选的 testPlan\n\t\t// 来源关联非空」——补 tp-1 级 link（原由 seedValidation 顺带写入）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'validation', 'tp-1', 'evidence:probe-1', ?)`,\n\t\t\t)\n\t\t\t.run(\"link-tp-1-restore\", AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t\treason: \"人工恢复基础版\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"restored\" in result && result.restored).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// restore activation 落库。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'restore'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string };\n\t\texpect(row.from_version).toBe(newVersionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(row.reason).toContain(\"人工恢复基础版\");\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: \"v-stale-old000\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(newVersionId);\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"目标版本目录缺失 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: \"v-notexist0000\",\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"目标版本曾失败被停用（publish 凭据标「停用:」）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion：rollbackResource 会给 newVersionId 的 publish 凭据标停用。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\tconst rb = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-x\"],\n\t\t\treason: \"退步\",\n\t\t});\n\t\texpect(rb.ok && rb.status === \"rolled_back\").toBe(true);\n\n\t\t// 现在尝试恢复已停用的 newVersionId → needs_reevaluation。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"目标版本来源依据失效（凭据候选引用已删记忆）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\t// 给 newVersionId 的凭据候选加一条引用已删记忆的 source link。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-ghost-${candidateId}`, candidateId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId === readEffective(store, resourceId) ? baseVersion : newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\t// 当前指向是 newVersionId；targetVersionId 也是 newVersionId → 先撞\n\t\t// 「已是当前生效版」分支。改为先切到别的再恢复。\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\n\t\t// 先把指向切到 baseVersion，再恢复 newVersionId → 应 needs_reevaluation。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, AT4, resourceId);\n\t\tconst result2 = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result2.ok).toBe(true);\n\t\tif (!result2.ok) return;\n\t\texpect(\"status\" in result2 && result2.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result2) || result2.status !== \"needs_reevaluation\") return;\n\t\texpect(result2.reason).toContain(\"mem-ghost\");\n\t});\n\n\tit(\"目标版本无任何 publish 凭据 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// baseVersion 是快照版，盘上目录在但无 publish 凭据。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"目标版本已是当前生效版 → conflict 无需恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n});\n\n// ── listActivationHistory ────────────────────────────────────────────────\n\ndescribe(\"listActivationHistory\", () => {\n\tit(\"返回 publish/restore/rollback 全量按时间序，含 disabled/effective 标记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 手动回退一次（多一条 rollback 行 + 坏版 publish 凭据标停用）。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\trollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-r\"],\n\t\t\treason: \"退步回退\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\n\t\tconst result = listActivationHistory(store, resourceId);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// 落盘凭据(publish) + 生效凭据(publish/effective) + rollback = 3 行。\n\t\texpect(result.items.length).toBe(3);\n\t\tconst kinds = result.items.map((i) => i.kind);\n\t\texpect(kinds).toEqual([\"publish\", \"publish\", \"rollback\"]);\n\n\t\t// 生效凭据行：effective=true。\n\t\tconst effectiveRow = result.items.find((i) => i.effective);\n\t\texpect(effectiveRow).toBeDefined();\n\t\texpect(effectiveRow!.toVersion).toBe(newVersionId);\n\t\texpect(effectiveRow!.kind).toBe(\"publish\");\n\n\t\t// 坏版 publish 凭据被标停用（disabled=true）。\n\t\tconst pubCred = result.items.find(\n\t\t\t(i) => i.kind === \"publish\" && i.toVersion === newVersionId && !i.effective,\n\t\t);\n\t\texpect(pubCred).toBeDefined();\n\t\texpect(pubCred!.disabled).toBe(true);\n\n\t\t// rollback 行 from/to 正确。\n\t\tconst rbRow = result.items.find((i) => i.kind === \"rollback\");\n\t\texpect(rbRow!.fromVersion).toBe(newVersionId);\n\t\texpect(rbRow!.toVersion).toBe(baseVersion);\n\t});\n});\n"},"tags":[],"source":null},{"category":"assist/source/organizeImports","severity":"error","description":"The imports and exports are not sorted.","message":[{"elements":[],"content":"The imports and exports are not sorted."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Safe fix: Organize Imports (Biome)"}]]},{"diff":{"dictionary":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。import { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStoreactivateCandidate } from \"../../src/pao/memoryevolutionstore.tsactivation.ts\"; evolutionPaths \n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../../src/pao/paths.tscontrol.ts\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";evolutionPaths type MemoryStore, openMemoryStore \nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\t});\n});\n","ops":[{"diffOp":{"equal":{"range":[0,125]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[125,250]}}},{"diffOp":{"equal":{"range":[250,260]}}},{"diffOp":{"delete":{"range":[260,293]}}},{"diffOp":{"insert":{"range":[293,310]}}},{"diffOp":{"equal":{"range":[310,333]}}},{"diffOp":{"delete":{"range":[333,339]}}},{"diffOp":{"insert":{"range":[339,348]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[348,356]}}},{"diffOp":{"insert":{"range":[356,369]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[250,259]}}},{"diffOp":{"delete":{"range":[371,387]}}},{"diffOp":{"insert":{"range":[387,464]}}},{"diffOp":{"equal":{"range":[464,486]}}},{"diffOp":{"delete":{"range":[333,339]}}},{"diffOp":{"insert":{"range":[339,348]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[486,494]}}},{"diffOp":{"insert":{"range":[494,504]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[504,690]}}},{"diffOp":{"equal":{"range":[504,514]}}},{"diffOp":{"delete":{"range":[293,310]}}},{"diffOp":{"insert":{"range":[690,704]}}},{"diffOp":{"equal":{"range":[310,333]}}},{"diffOp":{"delete":{"range":[690,699]}}},{"diffOp":{"insert":{"range":[333,339]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[356,369]}}},{"diffOp":{"insert":{"range":[486,494]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[504,513]}}},{"diffOp":{"delete":{"range":[387,462]}}},{"diffOp":{"insert":{"range":[704,721]}}},{"diffOp":{"equal":{"range":[721,722]}}},{"diffOp":{"delete":{"range":[504,505]}}},{"diffOp":{"insert":{"range":[722,739]}}},{"diffOp":{"equal":{"range":[464,486]}}},{"diffOp":{"delete":{"range":[690,699]}}},{"diffOp":{"insert":{"range":[333,339]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[494,504]}}},{"diffOp":{"insert":{"range":[348,356]}}},{"diffOp":{"equal":{"range":[369,371]}}},{"diffOp":{"equal":{"range":[739,812]}}},{"equalLines":{"line_count":483}},{"diffOp":{"equal":{"range":[812,821]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\test\\pao\\evolution-control.test.ts"},"span":[750,822],"sourceCode":"/**\n * S9-10 定向测试：用户控制（setResourceAutoEvolution / restoreResourceVersion /\n * listActivationHistory）。\n *\n * 覆盖：\n * - restoreResourceVersion 全部判据分支：成功 / 目录缺失或指纹不匹配 /\n *   无可用发布凭据（曾失败标停用）/ 来源依据失效 / expectedEffectiveVersion 冲突；\n * - 恢复事务：UPDATE effective_version + INSERT kind='restore' activation；\n * - setResourceAutoEvolution：停用/恢复本资源，不影响其他资源；\n * - listActivationHistory：publish/restore/rollback 全量时间线 + disabled/effective 标记。\n *\n * 运行：cd packages/coding-agent && node ../../node_modules/vitest/vitest.mjs run test/pao/evolution-control.test.ts --maxWorkers=2\n */\nimport { mkdtempSync, mkdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { openMemoryStore, type MemoryStore } from \"../../src/pao/memory/store.ts\";\nimport { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport { registerResource, setAutoEvolution, snapshotResourceFiles } from \"../../src/pao/evolution/resources.ts\";\nimport { publishCandidate } from \"../../src/pao/evolution/versions.ts\";\nimport { activateCandidate } from \"../../src/pao/evolution/activation.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n} from \"../../src/pao/evolution/control.ts\";\nimport { legalPassedChain } from \"./fixtures/evolution-legal-chain.ts\";\n\nconst tempDirs: string[] = [];\nconst openStores: MemoryStore[] = [];\n\nfunction tempHome(): string {\n\tconst dir = mkdtempSync(join(tmpdir(), \"pao-evolution-ctl-\"));\n\ttempDirs.push(dir);\n\treturn dir;\n}\nfunction openStore(home: string): MemoryStore {\n\tconst store = openMemoryStore(home, \"readwrite\");\n\topenStores.push(store);\n\treturn store;\n}\n\nafterEach(async () => {\n\tfor (const store of openStores.splice(0)) {\n\t\ttry {\n\t\t\tstore.close();\n\t\t} catch {\n\t\t\t// 已关\n\t\t}\n\t}\n\tfor (const dir of tempDirs.splice(0)) {\n\t\tfor (let attempt = 0; attempt < 5; attempt++) {\n\t\t\ttry {\n\t\t\t\trmSync(dir, { recursive: true, force: true });\n\t\t\t\tbreak;\n\t\t\t} catch (error) {\n\t\t\t\tif (attempt === 4) throw error;\n\t\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\t}\n\t\t}\n\t}\n});\n\nconst AT = \"2026-11-11T10:00:00.000Z\";\nconst AT2 = \"2026-11-11T10:01:00.000Z\";\nconst AT3 = \"2026-11-11T10:02:00.000Z\";\nconst AT4 = \"2026-11-11T10:03:00.000Z\";\n\n// ── 夹具 ────────────────────────────────────────────────────────────────\n\nfunction seedSkill(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst skillDir = join(home, \"pao配置\", \"skills\", name);\n\tmkdirSync(skillDir, { recursive: true });\n\twriteFileSync(join(skillDir, \"SKILL.md\"), `# ${name}\\n\\n步骤一: 输入\\n`, \"utf8\");\n\tregisterResource(store, { kind: \"skill\", name, paoHome: home });\n\tconst snap = snapshotResourceFiles(store, { resourceId: `skill:${name}`, paoHome: home, createdAt: AT });\n\tif (!snap.ok) throw new Error(\"snapshot failed\");\n\treturn { resourceId: `skill:${name}` as string, baseVersion: snap.versionId, skillDir };\n}\n\nfunction seedProblem(store: MemoryStore, over: { problemId?: string; resourceId?: string; baseVersion?: string } = {}) {\n\tconst problemId = over.problemId ?? \"prob-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_problems (\n\t\t\t\tproblem_id, kind, action, summary, expected_behavior, actual_behavior,\n\t\t\t\tevidence_refs_json, occurrence_count, resource_id, base_version,\n\t\t\t\tstatus, disposition, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tproblemId,\n\t\t\t\"implementation_defect\",\n\t\t\t\"modify\",\n\t\t\t\"测试问题\",\n\t\t\t\"应输出 A\",\n\t\t\t\"实际输出 B\",\n\t\t\tJSON.stringify([\"evidence:probe-1\"]),\n\t\t\t1,\n\t\t\tover.resourceId ?? null,\n\t\t\tover.baseVersion ?? null,\n\t\t\t\"classified\",\n\t\t\t\"candidate\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：problem 级来源关联（非 src- 前缀，作有效来源；activation/restore\n\t// 前置核对要求 problem→candidate→testPlan→validation 四级非空 links）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'problem', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${problemId}-e1`, problemId, \"evidence:probe-1\", AT);\n\treturn problemId;\n}\n\nfunction seedCandidate(\n\tstore: MemoryStore,\n\thome: string,\n\tover: { candidateId?: string; problemId: string; resourceId: string; baseVersion: string; status?: string },\n) {\n\tconst candidateId = over.candidateId ?? \"cand-1\";\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_candidates (\n\t\t\t\tcandidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\tdiffs_json, rationale, usage_refs_json, status, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\tcandidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"tp-1\",\n\t\t\tJSON.stringify([{ path: \"SKILL.md\", kind: \"edit\", newContent: \"x\" }]),\n\t\t\t\"修正\",\n\t\t\tJSON.stringify([\"req-1\"]),\n\t\t\tover.status ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：candidate 级来源关联（继承 problem 口径）。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'candidate', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-${candidateId}-e1`, candidateId, \"evidence:probe-1\", AT);\n\tconst dirSafe = over.resourceId.replace(/:/g, \"_\");\n\tconst candidateDir = join(evolutionPaths(home).candidates, dirSafe, candidateId);\n\tmkdirSync(candidateDir, { recursive: true });\n\twriteFileSync(join(candidateDir, \"SKILL.md\"), `# patched ${candidateId}\\n`, \"utf8\");\n\treturn { candidateId };\n}\n\nfunction seedValidation(\n\tstore: MemoryStore,\n\tover: { candidateId: string; problemId: string; resourceId: string; baseVersion: string; verdict?: string },\n) {\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_validations (\n\t\t\t\tvalidation_id, test_plan_id, candidate_id, problem_id, resource_id, base_version,\n\t\t\t\tcase_results_json, verdict, created_at, updated_at\n\t\t\t) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t)\n\t\t.run(\n\t\t\t`val-${over.candidateId}`,\n\t\t\t\"tp-1\",\n\t\t\tover.candidateId,\n\t\t\tover.problemId,\n\t\t\tover.resourceId,\n\t\t\tover.baseVersion,\n\t\t\t\"[]\",\n\t\t\tover.verdict ?? \"passed\",\n\t\t\tAT,\n\t\t\tAT,\n\t\t);\n\t// O12/E11：validation（运行验证）与冻结计划（tp-1）级来源关联。\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-val-${over.candidateId}-e1`, `val-${over.candidateId}`, \"evidence:probe-1\", AT);\n\tstore.db\n\t\t.prepare(\n\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t VALUES (?, 'validation', ?, ?, NULL, NULL, ?)`,\n\t\t)\n\t\t.run(`link-tp-1-e1`, \"tp-1\", \"evidence:probe-1\", AT);\n}\n\nasync function seedActivated(home: string, store: MemoryStore, name = \"test-skill\") {\n\tconst { resourceId, baseVersion, skillDir } = seedSkill(home, store, name);\n\tconst problemId = seedProblem(store, { resourceId, baseVersion });\n\t// O11/E08：publish 门核对来源关联与回执指纹，种 passed 行过不了——跑合法链。\n\tconst { candidateId } = await legalPassedChain(store, home, { problemId, resourceId, baseVersion });\n\tconst pub = await publishCandidate(store, { candidateId, paoHome: home, createdAt: AT2 });\n\tif (!pub.ok || !(\"versionId\" in pub)) throw new Error(\"publish failed\");\n\tconst act = await activateCandidate(store, {\n\t\tcandidateId,\n\t\texpectedEffectiveVersion: baseVersion,\n\t\tpaoHome: home,\n\t\tcreatedAt: AT3,\n\t});\n\tif (!act.ok || !(\"versionId\" in act)) throw new Error(\"activate failed\");\n\treturn { resourceId, baseVersion, newVersionId: act.versionId, problemId, candidateId, skillDir };\n}\n\nfunction readEffective(store: MemoryStore, resourceId: string): string | null {\n\tconst row = store.db\n\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t.get(resourceId) as { effective_version: string | null };\n\treturn row.effective_version;\n}\n\n// ── setResourceAutoEvolution ──────────────────────────────────────────────\n\ndescribe(\"setResourceAutoEvolution\", () => {\n\tit(\"停用本资源不影响其他资源；恢复只动本资源\", () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId } = seedSkill(home, store, \"skill-a\");\n\t\tconst { resourceId: otherId } = seedSkill(home, store, \"skill-b\");\n\n\t\t// 停用 A。\n\t\tconst off = setResourceAutoEvolution(store, { resourceId, enabled: false, updatedAt: AT3 });\n\t\texpect(off.ok).toBe(true);\n\t\tif (!off.ok) return;\n\t\texpect(off.autoEvolutionEnabled).toBe(false);\n\n\t\t// B 不受影响。\n\t\tconst other = store.db\n\t\t\t.prepare(`SELECT auto_evolution_enabled FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t.get(otherId) as { auto_evolution_enabled: number };\n\t\texpect(other.auto_evolution_enabled).toBe(1);\n\n\t\t// 恢复 A。\n\t\tconst on = setResourceAutoEvolution(store, { resourceId, enabled: true, updatedAt: AT4 });\n\t\texpect(on.ok).toBe(true);\n\t\tif (!on.ok) return;\n\t\texpect(on.autoEvolutionEnabled).toBe(true);\n\t});\n});\n\n// ── restoreResourceVersion ───────────────────────────────────────────────\n\ndescribe(\"restoreResourceVersion\", () => {\n\tit(\"成功：UPDATE effective_version + INSERT kind='restore' activation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion 之外再造第二版：把 baseVersion 目录指纹与 publish\n\t\t// 凭据补齐——baseVersion 是快照版（无 publish 凭据），恢复它走不通判据 b。\n\t\t// 改为恢复「另一个已发布但未停用的版本」：先回退到 baseVersion，再恢复 newVersionId。\n\t\t// 但 newVersionId 已被停用……所以换个场景：把 newVersionId 当历史版，再造一个\n\t\t// 第三版当坏版，当前指向第三版时恢复 newVersionId（未停用 → 可恢复）。\n\t\t// 简单做法：直接给 baseVersion 补一条 publish 凭据（模拟它也曾被发布过）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_activations (\n\t\t\t\t\tactivation_id, resource_id, from_version, to_version, kind, reason, source_links_json, created_at\n\t\t\t\t) VALUES (?, ?, ?, ?, 'publish', ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(\n\t\t\t\t\"act-basepub\",\n\t\t\t\tresourceId,\n\t\t\t\tnull,\n\t\t\t\tbaseVersion,\n\t\t\t\t\"基础版发布凭据（夹具补）\",\n\t\t\t\tJSON.stringify({ candidateId: \"cand-base\" }),\n\t\t\t\tAT,\n\t\t\t);\n\t\t// cand-base 对应候选行（判据 c 查 candidate source_links；不存在则如实报）。\n\t\t// 这里不种候选 → checkRestoreSourceLinksIntact 会返回候选不存在 → needs_reevaluation。\n\t\t// 所以种一个候选行。\n\t\tseedCandidate(store, home, {\n\t\t\tcandidateId: \"cand-base\",\n\t\t\tproblemId: seedProblem(store, { problemId: \"prob-base\", resourceId, baseVersion }),\n\t\t\tresourceId,\n\t\t\tbaseVersion,\n\t\t});\n\t\t// cand-base 的 test_plan_id=\"tp-1\"：restore 核对「凭据候选的 testPlan\n\t\t// 来源关联非空」——补 tp-1 级 link（原由 seedValidation 顺带写入）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT OR IGNORE INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, created_at)\n\t\t\t\t VALUES (?, 'validation', 'tp-1', 'evidence:probe-1', ?)`,\n\t\t\t)\n\t\t\t.run(\"link-tp-1-restore\", AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t\treason: \"人工恢复基础版\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"restored\" in result && result.restored).toBe(true);\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\n\t\t// restore activation 落库。\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT kind, from_version, to_version, reason FROM evolution_activations\n\t\t\t\t WHERE resource_id = ? AND kind = 'restore'`,\n\t\t\t)\n\t\t\t.get(resourceId) as { kind: string; from_version: string; to_version: string; reason: string };\n\t\texpect(row.from_version).toBe(newVersionId);\n\t\texpect(row.to_version).toBe(baseVersion);\n\t\texpect(row.reason).toContain(\"人工恢复基础版\");\n\t});\n\n\tit(\"expectedEffectiveVersion 与当前指向不一致 → conflict 不覆盖\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: \"v-stale-old000\",\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"conflict\") return;\n\t\texpect(result.currentEffectiveVersion).toBe(newVersionId);\n\t\texpect(readEffective(store, resourceId)).toBe(newVersionId);\n\t});\n\n\tit(\"目标版本目录缺失 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: \"v-notexist0000\",\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"指纹\");\n\t});\n\n\tit(\"目标版本曾失败被停用（publish 凭据标「停用:」）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 先回退到 baseVersion：rollbackResource 会给 newVersionId 的 publish 凭据标停用。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\tconst rb = rollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-x\"],\n\t\t\treason: \"退步\",\n\t\t});\n\t\texpect(rb.ok && rb.status === \"rolled_back\").toBe(true);\n\n\t\t// 现在尝试恢复已停用的 newVersionId → needs_reevaluation。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"停用\");\n\t\texpect(readEffective(store, resourceId)).toBe(baseVersion);\n\t});\n\n\tit(\"目标版本来源依据失效（凭据候选引用已删记忆）→ needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId, candidateId } = await seedActivated(home, store);\n\n\t\t// 给 newVersionId 的凭据候选加一条引用已删记忆的 source link。\n\t\t// source_id 用非 src- 前缀（src- 会先命中「sources 行已删」而非记忆失效）。\n\t\tstore.db\n\t\t\t.prepare(\n\t\t\t\t`INSERT INTO evolution_source_links (link_id, owner_kind, owner_id, source_id, memory_id, revision, created_at)\n\t\t\t\t VALUES (?, 'candidate', ?, ?, ?, ?, ?)`,\n\t\t\t)\n\t\t\t.run(`link-ghost-${candidateId}`, candidateId, \"evidence:deleted\", \"mem-ghost\", 1, AT);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId === readEffective(store, resourceId) ? baseVersion : newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\t// 当前指向是 newVersionId；targetVersionId 也是 newVersionId → 先撞\n\t\t// 「已是当前生效版」分支。改为先切到别的再恢复。\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\n\t\t// 先把指向切到 baseVersion，再恢复 newVersionId → 应 needs_reevaluation。\n\t\tstore.db\n\t\t\t.prepare(`UPDATE evolution_resources SET effective_version = ?, updated_at = ? WHERE resource_id = ?`)\n\t\t\t.run(baseVersion, AT4, resourceId);\n\t\tconst result2 = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: baseVersion,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result2.ok).toBe(true);\n\t\tif (!result2.ok) return;\n\t\texpect(\"status\" in result2 && result2.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result2) || result2.status !== \"needs_reevaluation\") return;\n\t\texpect(result2.reason).toContain(\"mem-ghost\");\n\t});\n\n\tit(\"目标版本无任何 publish 凭据 → needs_reevaluation\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// baseVersion 是快照版，盘上目录在但无 publish 凭据。\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: baseVersion,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"needs_reevaluation\").toBe(true);\n\t\tif (!(\"status\" in result) || result.status !== \"needs_reevaluation\") return;\n\t\texpect(result.reason).toContain(\"发布凭据\");\n\t});\n\n\tit(\"目标版本已是当前生效版 → conflict 无需恢复\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, newVersionId } = await seedActivated(home, store);\n\n\t\tconst result = restoreResourceVersion(store, {\n\t\t\tresourceId,\n\t\t\ttargetVersionId: newVersionId,\n\t\t\texpectedEffectiveVersion: newVersionId,\n\t\t\tpaoHome: home,\n\t\t});\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\texpect(\"status\" in result && result.status === \"conflict\").toBe(true);\n\t});\n});\n\n// ── listActivationHistory ────────────────────────────────────────────────\n\ndescribe(\"listActivationHistory\", () => {\n\tit(\"返回 publish/restore/rollback 全量按时间序，含 disabled/effective 标记\", async () => {\n\t\tconst home = tempHome();\n\t\tconst store = openStore(home);\n\t\tconst { resourceId, baseVersion, newVersionId } = await seedActivated(home, store);\n\n\t\t// 手动回退一次（多一条 rollback 行 + 坏版 publish 凭据标停用）。\n\t\tconst { rollbackResource } = await import(\"../../src/pao/evolution/activation.ts\");\n\t\trollbackResource(store, {\n\t\t\tresourceId,\n\t\t\tbadVersion: newVersionId,\n\t\t\tpreviousVersion: baseVersion,\n\t\t\tsourceIds: [\"src-r\"],\n\t\t\treason: \"退步回退\",\n\t\t\tcreatedAt: AT4,\n\t\t});\n\n\t\tconst result = listActivationHistory(store, resourceId);\n\t\texpect(result.ok).toBe(true);\n\t\tif (!result.ok) return;\n\t\t// 落盘凭据(publish) + 生效凭据(publish/effective) + rollback = 3 行。\n\t\texpect(result.items.length).toBe(3);\n\t\tconst kinds = result.items.map((i) => i.kind);\n\t\texpect(kinds).toEqual([\"publish\", \"publish\", \"rollback\"]);\n\n\t\t// 生效凭据行：effective=true。\n\t\tconst effectiveRow = result.items.find((i) => i.effective);\n\t\texpect(effectiveRow).toBeDefined();\n\t\texpect(effectiveRow!.toVersion).toBe(newVersionId);\n\t\texpect(effectiveRow!.kind).toBe(\"publish\");\n\n\t\t// 坏版 publish 凭据被标停用（disabled=true）。\n\t\tconst pubCred = result.items.find(\n\t\t\t(i) => i.kind === \"publish\" && i.toVersion === newVersionId && !i.effective,\n\t\t);\n\t\texpect(pubCred).toBeDefined();\n\t\texpect(pubCred!.disabled).toBe(true);\n\n\t\t// rollback 行 from/to 正确。\n\t\tconst rbRow = result.items.find((i) => i.kind === \"rollback\");\n\t\texpect(rbRow!.fromVersion).toBe(newVersionId);\n\t\texpect(rbRow!.toVersion).toBe(baseVersion);\n\t});\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * S8-13 全链机制验证（E2E 集成测试）。\n *import { evolutionPaths } from \"../../src/pao/memory/paths.ts\";\nimport type { TierConfig } from \"../../src/pao/routing/config.ts\";\nimport { \n\tgetResource,listResources,registerResource,setAutoEvolution,snapshotResourceFiles,\n} from \"../../src/pao/evolution/resources.ts\";\nimport {classifyProblem,collectEvolutionProblem,declareImprovementIntent,getEvolutionProblem} from \"../../src/pao/evolution/problems.ts\";\nimport { selectImprovement } from \"../../src/pao/evolution/select.ts\";\nimport { freezeValidationPlan } from \"../../src/pao/evolution/validation.ts\";\tmkdirSync(join(home, \"pao配置\"), { recursive: true });\n\twriteFileSync(join(home, \"pao配置\", \"记忆后台预算.json\"), JSON.stringify({ 每日上限: 1.0, 允许嵌入: true }));\n\twriteFileSync(\n\t\tjoin(home, \"总预算账.json\"),JSON.stringify({\n\t\tversion: 1,\n\t\tgrants: [{ version: 1, 总预算: 10.0, 授权时间: AT, 余额依据: { 已花: 0, 授权前总预算: 0 }, 授权人: \"test\"