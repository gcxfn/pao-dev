Op":{"equal":{"range":[1726,1727]}}},{"diffOp":{"delete":{"range":[925,933]}}},{"diffOp":{"insert":{"range":[759,769]}}},{"diffOp":{"equal":{"range":[427,429]}}},{"diffOp":{"equal":{"range":[3035,3143]}}},{"diffOp":{"equal":{"range":[3035,3049]}}},{"diffOp":{"delete":{"range":[2993,3017]}}},{"diffOp":{"insert":{"range":[3143,3204]}}},{"diffOp":{"equal":{"range":[1199,1210]}}},{"diffOp":{"delete":{"range":[1110,1119]}}},{"diffOp":{"insert":{"range":[1187,1193]}}},{"diffOp":{"equal":{"range":[1726,1727]}}},{"diffOp":{"delete":{"range":[671,681]}}},{"diffOp":{"insert":{"range":[2050,2075]}}},{"diffOp":{"equal":{"range":[427,429]}}},{"diffOp":{"equal":{"range":[3035,3049]}}},{"diffOp":{"delete":{"range":[2031,2043]}}},{"diffOp":{"insert":{"range":[2089,2118]}}},{"diffOp":{"equal":{"range":[710,711]}}},{"diffOp":{"delete":{"range":[2031,2050]}}},{"diffOp":{"insert":{"range":[3204,4078]}}},{"diffOp":{"equal":{"range":[1199,1210]}}},{"diffOp":{"delete":{"range":[1110,1119]}}},{"diffOp":{"insert":{"range":[1187,1193]}}},{"diffOp":{"equal":{"range":[1726,1727]}}},{"diffOp":{"delete":{"range":[505,515]}}},{"diffOp":{"insert":{"range":[925,933]}}},{"diffOp":{"equal":{"range":[427,429]}}},{"diffOp":{"equal":{"range":[3035,3043]}}},{"diffOp":{"delete":{"range":[338,343]}}},{"diffOp":{"equal":{"range":[343,345]}}},{"diffOp":{"delete":{"range":[717,737]}}},{"diffOp":{"insert":{"range":[3017,3035]}}},{"diffOp":{"equal":{"range":[1136,1148]}}},{"diffOp":{"delete":{"range":[1110,1119]}}},{"diffOp":{"insert":{"range":[1187,1193]}}},{"diffOp":{"equal":{"range":[1726,1727]}}},{"diffOp":{"delete":{"range":[759,769]}}},{"diffOp":{"insert":{"range":[925,933]}}},{"diffOp":{"equal":{"range":[427,429]}}},{"diffOp":{"equal":{"range":[4078,4191]}}},{"equalLines":{"line_count":3171}},{"diffOp":{"equal":{"range":[4191,4196]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":"packages\\coding-agent\\src\\pao\\desktop\\memory.ts"},"span":[1066,1107],"sourceCode":"/**\n * 内置记忆的桌面公开入口（S4-01）：列表/详情/使用记录/变更/来源回读五函数，\n * 全部只依赖 `openMemoryService(home)`——不需要活动 session owner，\n * 后台直接按 PAO_HOME 查库（任务书 §子任务一；调用链见 S4 任务书 §调用链）。\n *\n * 纪律：\n * - 返回纯结构化 DTO（可 JSON 序列化）：不返回 store/数据库句柄、函数、\n *   Map/Set、AbortSignal；字符串时间一律原样透传（ISO 字符串，不转 Date）。\n * - scope 由调用方传入已解析的 DesktopMemoryScope（{projectId, deptId?, taskId?}）；\n *   内核不替桌面猜项目身份——desktop 桥经解析后传入，本项目内不推断 cwd。\n * - 各 mutate 操作走 service 既有入口（correctMemory/setMemoryUsage/mergeMemories/\n *   previewMemoryDeletion/deleteMemory）；revision 冲突如实返回不自动重试。\n * - 每次调用 openMemoryService 后在 finally close——连接按 PAO_HOME 引用计数共享，\n *   本层每次调用借一次，不长期占库。\n */\nimport { randomUUID } from \"node:crypto\";\nimport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { Usage } from \"@pao/ai\";\nimport { SessionManager } from \"../../core/session-manager.ts\";\nimport type { ArchivedEvent } from \"../memory/archive.ts\";\nimport type { ContextUsageSnapshot } from \"../memory/context-usage.ts\";\nimport { getEffectiveVersion } from \"../evolution/activation.ts\";\nimport { listTaskBindings, type TaskBinding } from \"../evolution/binding.ts\";\nimport {\n\tlistActivationHistory,\n\trestoreResourceVersion,\n\tsetResourceAutoEvolution,\n\ttype ActivationHistoryEntry,\n} from \"../evolution/control.ts\";\nimport { countUsageByVersion, type UsageByVersionCounts } from \"../evolution/observe.ts\";\nimport { readResourceVersion } from \"../evolution/versions.ts\";\nimport type {\n\tEvolutionFileDiff,\n\tEvolutionResource,\n\tValidationRunResult,\n} from \"../evolution/types.ts\";\nimport { evolutionPaths, memoryPaths } from \"../memory/paths.ts\";\nimport { decodeArtifactReceiptRef } from \"../memory/artifacts.ts\";\nimport { readProjectContext, recordProjectGoalChange } from \"../memory/project-context.ts\";\nimport { archiveProjectOperationSource } from \"../memory/project-operation-source.ts\";\nimport { historyScopeFilter } from \"../memory/scope.ts\";\nimport { openMemoryService } from \"../memory/service.ts\";\nimport { sourcesForRevision } from \"../memory/sources.ts\";\nimport { openMemoryStore } from \"../memory/store.ts\";\nimport {\n\tlistTaskContinuationsForProject,\n\treadTaskContinuationForPage,\n\ttype TaskContinuationPageListResult,\n} from \"../memory/task-continuation-page.ts\";\nimport type {\n\tArtifact,\n\tArtifactLocation,\n\tArtifactRefKind,\n\tConfirmationState,\n\tCorrectMemoryResult,\n\tDeleteMemoryResult,\n\tDeletionOperationDto,\n\tDeletionSessionCoordinator,\n\tEvidenceKind,\n\tGetMemoryResult,\n\tMemoryDto,\n\tMemoryError,\n\tMemoryKind,\n\tMemoryResult,\n\tMemoryRevision,\n\tMemoryScope,\n\tMemoryService,\n\tMemoryUsageAction,\n\tMemoryUsageState,\n\tMergeMemoriesResult,\n\tPreviewMemoryDeletionResult,\n\tProjectContextBrief,\n\tProjectSourceRef,\n\tReadTaskContinuationOutput,\n\tRecordProjectGoalChangeResult,\n\tSearchMemoryResult,\n\tSetMemoryUsageResult,\n\tSharedSourcePolicy,\n} from \"../memory/types.ts\";\nimport { readMemoryUsage } from \"../memory/usage-query.ts\";\n\n// ════════════════════════════════════════════════════════════════════════\n// 0. 错误与统一返回\n// ════════════════════════════════════════════════════════════════════════\n\nexport type {\n\tTaskContinuationPageItem,\n\tTaskContinuationPageListResult,\n} from \"../memory/task-continuation-page.ts\";\nexport type {\n\tArtifact,\n\tArtifactLocation,\n\tArtifactRefKind,\n\tArtifactUse,\n\tArtifactVersion,\n\tConfirmationState,\n\tDeleteMemoryInput,\n\tDeleteMemoryResult,\n\tDeletionOperationDto,\n\tDeletionPendingObject,\n\tDeletionSessionCoordinator,\n\tDeletionSessionImpact,\n\tDeletionSourceImpact,\n\tDeletionStatus,\n\tEvidenceKind,\n\tMemoryDto,\n\tMemoryError,\n\tMemoryErrorCode,\n\tMemoryKind,\n\tMemoryResult,\n\tMemoryRevision,\n\tMemoryRevisionContent,\n\tMemorySource,\n\tMemoryUsageAction,\n\tMemoryUsageState,\n\tPreviewMemoryDeletionInput,\n\tPreviewMemoryDeletionResult,\n\tProjectCardSnapshot,\n\tProjectContextBinding,\n\tProjectContextBrief,\n\tProjectGoalHistoryEntry,\n\tProjectGoalSnapshot,\n\tProjectSourceRef,\n\tReadDeletionOperationInput,\n\tReadTaskContinuationOutput,\n\tRecordProjectGoalChangeResult,\n\tResumeDeletionInput,\n\tSharedSourcePolicy,\n\tTaskContinuationCurrentState,\n\tTaskContinuationDifference,\n\tTaskContinuationRecord,\n\tTaskContinuationStatement,\n} from \"../memory/types.ts\";\nexport { MEMORY_ERROR_CODES } from \"../memory/types.ts\";\nexport type {\n\tEvolutionFileDiff,\n\tEvolutionResource,\n\tValidationRunResult,\n} from \"../evolution/types.ts\";\nexport type { ActivationHistoryEntry } from \"../evolution/control.ts\";\nexport type { TaskBinding, TaskBindingSwitch } from \"../evolution/binding.ts\";\nexport type { UsageByVersionCounts } from \"../evolution/observe.ts\";\n\n/** 本层抛出的环境级错误（PAO_HOME 缺、库打不开）；业务拒绝走 MemoryResult 不抛。 */\nexport class DesktopMemoryError extends Error {\n\toverride name = \"DesktopMemoryError\";\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 1. 入参形状（调用方传入已解析身份）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 桌面侧的已解析范围：只带桌面能合法确定的身份。\n * projectId 必填（dept 桥同源：不在这里猜项目）；taskId/sessionId/department 可选。\n * 内核映射成 MemoryScope 使用；deptId 与内核字段名 department 对齐。\n */\nexport interface DesktopMemoryScope {\n\t/** 稳定项目 ID（projects 表主键；调用方按宿主项目解析传入）。 */\n\tprojectId: string;\n\t/** 任务 ID（卡号/工作流实例等；通用记忆不传）。 */\n\ttaskId?: string;\n\t/** 会话 ID（页面侧通常不传——读不依赖活动会话；mutate source 另行给）。 */\n\tsessionId?: string;\n\t/** 所属部门（部门库归属；字段名与内核 MemoryScope.department 对应）。 */\n\tdeptId?: string;\n}\n\nfunction toMemoryScope(scope: DesktopMemoryScope): MemoryScope {\n\treturn {\n\t\tprojectId: scope.projectId,\n\t\t...(scope.taskId === undefined ? {} : { taskId: scope.taskId }),\n\t\t...(scope.sessionId === undefined ? {} : { sessionId: scope.sessionId }),\n\t\t...(scope.deptId === undefined ? {} : { department: scope.deptId }),\n\t};\n}\n\n/** 列表/详情/来源回读的公共入参。 */\nexport interface DesktopMemoryHomeInput {\n\t/** PAO_HOME 根路径（必填——不在这里猜）。 */\n\thome: string;\n}\n\n// ── readDesktopMemoryList ────────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryListInput extends DesktopMemoryHomeInput {\n\tscope: DesktopMemoryScope;\n\t/** 查询词（可空串——空串按「全部」词法列举，不触发语义路）。 */\n\tquery: string;\n\t/** 使用状态过滤；缺省按当前召回口径（active、未合并、来源未排除）。 */\n\tstatus?: MemoryUsageState;\n\t/** 类型过滤；缺省全部类型。 */\n\tkind?: MemoryKind;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n\t/** current=只查当前有效修订（默认）；history=含被替代修订与归档段。 */\n\tmode?: \"current\" | \"history\";\n}\n\n/** 列表项：单条记忆的页面展示摘要（详情走 readDesktopMemoryDetail）。 */\nexport interface MemoryListItem {\n\tmemoryId: string;\n\trevision: number;\n\tkind: MemoryKind;\n\tscope: MemoryScope;\n\t/** 当前修订结论正文（页面列表主文本）。 */\n\tconclusion: string;\n\t/** 适用条件（可空）。 */\n\tconditions?: string;\n\t/** 理由（可空；模型未给出时不补造）。 */\n\trationale?: string;\n\tevidenceKind: EvidenceKind;\n\tconfirmation: ConfirmationState;\n\tusageState: MemoryUsageState;\n\t/** 相关度（0-1；query 为空时为 1——按当前修订时间倒序而非召回分）。 */\n\trelevance: number;\n\tmatchKind: \"lexical\" | \"semantic\" | \"both\";\n\t/** 跨项目命中标记（referenceOnly：不可作为当前项目约束）。 */\n\treferenceOnly?: boolean;\n\t/** 命中修订引用的来源 ID 列表。 */\n\tsourceIds?: string[];\n\t/** 合并指向（本记忆是副本时为 canonical ID）。 */\n\tmergedInto?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\nexport interface ReadDesktopMemoryListResult {\n\titems: MemoryListItem[];\n\t/** 空查询时的精确总条数；关键词召回无法证明全量时省略。 */\n\ttotal?: number;\n\t/** total 是否覆盖同一范围与筛选条件下的全部记录。 */\n\ttotalKnown: boolean;\n\t/** 关键词召回窗内、应用 status/kind 后的候选数。 */\n\tcandidateCount?: number;\n\t/** 关键词查询的候选窗上限。 */\n\tcandidateLimit?: number;\n\t/** 是否还有下一页。 */\n\thasMore: boolean;\n\t/** 是否降级（语义路未参与）。 */\n\tdegraded?: boolean;\n\t/** 降级原因（degraded 时）。 */\n\tdegradeReason?: string;\n\t/** 空态说明（items 为空时）。 */\n\temptyReason?: string;\n}\n\n// ── readDesktopMemoryDetail ──────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryDetailInput extends DesktopMemoryHomeInput {\n\tid: string;\n\t/** 所选修订号；缺省读当前版。 */\n\trevision?: number;\n}\n\n/** 详情：所选修订决定 + 修订时间线 + 同修订来源摘要 + 使用计数（memory_usage 聚合）。 */\nexport interface DesktopMemoryDetailResult {\n\t/** 所选修订内容；memory.currentRevision 仍是库内真实当前修订。 */\n\tmemory: MemoryDto;\n\t/** 当前修订号。 */\n\tcurrentRevision: number;\n\t/** 实际展示的修订号。 */\n\tselectedRevision: number;\n\t/** 所选修订早于当前修订时 true。 */\n\tisHistorical: boolean;\n\t/** 历史修订只读；查看当前版后可继续执行变更。 */\n\treadOnly: boolean;\n\t/** 全部修订时间线（includeHistory）。 */\n\trevisions: MemoryRevision[];\n\t/** 所选修订的来源摘要（含已删除/未封存的来源标记）。 */\n\tsources: GetMemoryResult[\"sourceSummaries\"];\n\t/** 替代关系链（当前修订→被替代修订→更早…）。 */\n\tsupersessionChain: GetMemoryResult[\"supersessionChain\"];\n\t/** 使用计数：按 memory_usage.action 聚合的注入/展开/明确引用次数。 */\n\tusageSummary: {\n\t\tsearch: number;\n\t\tinject: number;\n\t\texpand: number;\n\t\tused: number;\n\t};\n}\n\n// ── readDesktopMemoryUsage ───────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryUsageInput extends DesktopMemoryHomeInput {\n\t/** 已由宿主解析的可信范围；task/session 可选，用于收窄事件归因。 */\n\tscope: DesktopMemoryScope;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n}\n\nexport interface DesktopMemoryUsageCounts {\n\tsearch: number;\n\tinject: number;\n\texpand: number;\n\tused: number;\n}\n\nexport interface DesktopMemoryUsageEvent {\n\tid: number;\n\t/** 保留原始动作：search/inject/expand/used。 */\n\taction: MemoryUsageAction;\n\tmemoryId: string;\n\trevision: number;\n\tcreatedAt: string;\n\trequestId?: string;\n\tusageRef?: string;\n\ttaskId?: string;\n\tsessionId?: string;\n}\n\nexport interface ReadDesktopMemoryUsageResult {\n\titems: DesktopMemoryUsageEvent[];\n\t/** 同一可信范围和事件筛选条件下的精确事件总数。 */\n\ttotal: number;\n\tpage: number;\n\tpageSize: number;\n\thasMore: boolean;\n\t/** 同一筛选条件下按动作聚合的计数，不受当前页限制。 */\n\tcounts: DesktopMemoryUsageCounts;\n\t/** 是否实际记录了明确采用；inject/search/expand 不推导成 used。 */\n\tusedRecorded: boolean;\n}\n\n// ── 项目背景 ─────────────────────────────────────────────────────────────\n\n/** 只读项目背景；身份由可信宿主解析后传入，不在内核层猜 cwd。 */\nexport interface ReadDesktopProjectContextInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n\tprojectRoot: string;\n\t/** 指定一份临时计划详情；缺省读取项目内全部计划。 */\n\tplanId?: string;\n}\n\n/**\n * 用户从记忆页明确修改项目目标。只收文本；正式文档、阶段来源、项目身份、\n * 来源 ID、确认态和捕获时间都由宿主或内核按当前正本解析。\n */\nexport interface RecordDesktopProjectGoalChangeInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n\tprojectRoot: string;\n\tuserId: string;\n\tconclusion: string;\n\tconditions?: string;\n\trationale?: string;\n}\n\n/** 任务接续只按可信项目身份列举；具体任务差异由既有读取入口逐项回查。 */\nexport interface ReadDesktopTaskContinuationsInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n}\n\nexport interface ReadDesktopTaskContinuationInput extends ReadDesktopTaskContinuationsInput {\n\ttaskId: string;\n}\n\nexport type ReadDesktopTaskContinuationsResult = TaskContinuationPageListResult;\nexport type ReadDesktopTaskContinuationResult = MemoryResult<ReadTaskContinuationOutput>;\n\n// ── 成果（S6-09 记忆页成果区） ───────────────────────────────────────────\n\n/** 成果列表只按可信项目身份列举；身份由宿主解析后传入。 */\nexport interface ReadDesktopArtifactsInput extends DesktopMemoryHomeInput {\n\tprojectId: string;\n}\n\nexport interface ReadDesktopArtifactDetailInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n}\n\nexport interface ReadDesktopArtifactVersionInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n\tversionId: string;\n\t/** 文本片段起点（字符偏移；缺省 0）。 */\n\toffset?: number;\n\t/** 单页字符数（缺省 4000，上限 20000）。 */\n\tlimit?: number;\n}\n\nexport interface ReadDesktopArtifactUsesInput extends DesktopMemoryHomeInput {\n\tartifactId: string;\n\t/** 页码（1 起；缺省 1）。 */\n\tpage?: number;\n\t/** 每页条数（缺省 50，上限 200）。 */\n\tpageSize?: number;\n}\n\n/** 版本选择器条目：列表只给定位与预判，不回读内容。 */\nexport interface DesktopArtifactVersionItem {\n\tversionId: string;\n\tseq: number;\n\tcreatedAt: string;\n\toriginTaskId?: string;\n\t/** 登记定位；页面不展开路径细节，只区分 git/managed 形态。 */\n\tlocationKind: ArtifactLocation[\"kind\"];\n\t/** Git 版本给出仓内相对路径（「打开当前文件」用）；受管版本省略——受管副本不属于工作区。 */\n\tlocationPath?: string;\n\tsizeBytes: number;\n\treceiptRef?: string;\n\t/**\n\t * F13（O08）：receipt_ref 前缀 `<verdict>:` 解码后的验证状态\n\t * （pass|fail|not_run|pending_review）；存量无前推行 undefined——页面如实「结果待核」。\n\t */\n\tverificationStatus?: string;\n\t/** 产生来源的会话（有则带上，供页面定位来源会话）。 */\n\tsourceSessionId?: string;\n\t/** 本次登记关联的账本/请求引用（usage_refs）。 */\n\tusageRefs?: string[];\n\t/** 登记来源 ID 列表（生成来源段可跳 sourceEntryId 定位）。 */\n\tsourceIds: string[];\n\t/** 产生来源的会话条目（有则带上，供页面定位来源）。 */\n\tsourceEntryId?: string;\n\t/** 预判是否可回读（受管副本存在/Git 仓可达）；仅提示，实际以 version 回读为准。 */\n\tavailable: boolean;\n\t/** 引用计数（memory/task/use 分类聚合）。 */\n\trefs: Record<ArtifactRefKind, number>;\n}\n\nexport interface DesktopArtifactDetailResult {\n\tartifact: Artifact;\n\tversions: DesktopArtifactVersionItem[];\n}\n\nexport interface DesktopArtifactVersionResult {\n\tartifact: Artifact;\n\tversion: DesktopArtifactVersionItem;\n\t/** 文本化片段；available=false 时为空串。 */\n\tcontent: string;\n\tavailable: boolean;\n\t/** 不可预览原因（二进制/不可解码/定位缺失），不拿工作树文件顶替。 */\n\tunavailableReason?: string;\n\t/** 片段后是否还有内容。 */\n\thasMore: boolean;\n\t/** 下一页原样作为 offset；仅 hasMore=true 时返回。 */\n\tnextOffset?: number;\n}\n\nexport interface DesktopArtifactUseItem {\n\tuseId: string;\n\tversionId: string;\n\ttaskId: string;\n\taction: string;\n\treceiptRef?: string;\n\tcreatedAt: string;\n}\n\nexport interface ReadDesktopArtifactUsesResult {\n\titems: DesktopArtifactUseItem[];\n\ttotal: number;\n\tpage: number;\n\tpageSize: number;\n\thasMore: boolean;\n}\n\n/** 成果列表项：名称/用途/版本可用性/最近验证状态。 */\nexport interface DesktopArtifactListItem {\n\tartifact: Artifact;\n\tversionCount: number;\n\t/** 最新版本的预判可用性与验证回执；无版本时省略。 */\n\tlatestVersion?: DesktopArtifactVersionItem;\n\t/** 全部版本累计使用记录数。 */\n\tuseCount: number;\n}\n\nexport interface ReadDesktopArtifactsResult {\n\titems: DesktopArtifactListItem[];\n}\n\n// ── mutateDesktopMemory ──────────────────────────────────────────────────\n\n/**\n * 页面提交附带的用户标识。聊天 session/entry 字段仅为旧调用兼容；页面操作本身\n * 由 mutateDesktopMemory 生成独立归档来源，不借用旧对话充当本次结论证据。\n */\nexport interface DesktopMemoryOperationSource {\n\tsessionId?: string;\n\tentryId?: string;\n\tuserId?: string;\n}\n\n/** 纠正（页面纠正表单；expectedRevision 冲突返回最新修订不自动重试）。 */\nexport interface DesktopMemoryCorrectOp {\n\top: \"correct\";\n\tid: string;\n\texpectedRevision: number;\n\treplacement: {\n\t\tconclusion: string;\n\t\tconditions?: string;\n\t\trationale?: string;\n\t\tevidenceKind: EvidenceKind;\n\t\tconfirmation: ConfirmationState;\n\t};\n\t/** 页面提交的用户标识；可省略，修正来源由内核按本次页面动作归档。 */\n\tsource?: DesktopMemoryOperationSource;\n\t/** 旧调用兼容字段；纠正修订只关联本次页面操作来源。 */\n\tsourceIds?: string[];\n}\n\n/** 停用/恢复（target=stopped 停用、active 恢复；恢复只切使用状态不复活已纠正内容）。 */\nexport interface DesktopMemorySetUsageOp {\n\top: \"setUsage\";\n\tid: string;\n\texpectedRevision: number;\n\ttarget: MemoryUsageState;\n\tsource?: DesktopMemoryOperationSource;\n}\n\n/** 合并（多选合并；keepId 保留、mergeId 并入；rationale 必填）。 */\nexport interface DesktopMemoryMergeOp {\n\top: \"merge\";\n\tkeepId: string;\n\tkeepExpectedRevision: number;\n\tmergeId: string;\n\tmergeExpectedRevision: number;\n\trationale: string;\n\tsource?: DesktopMemoryOperationSource;\n}\n\n/** 删除预览（不删数据；memoryId 或来源范围至少一项）。 */\nexport interface DesktopMemoryDeletePreviewOp {\n\top: \"deletePreview\";\n\tmemoryId?: string;\n\tsourceId?: string;\n\tsessionId?: string;\n\tentryId?: string;\n\t/** 缺省 retain；include-referencing-memories 只在预览明确展示扩展范围后使用。 */\n\tsharedSourcePolicy?: SharedSourcePolicy;\n}\n\n/** 删除确认（按 preview 返回的对象列表+修订号执行）。 */\nexport interface DesktopMemoryDeleteConfirmOp {\n\top: \"deleteConfirm\";\n\tmemoryIds: string[];\n\trevisions: Record<string, number>;\n\tsource?: DesktopMemoryOperationSource;\n\tsharedSourcePolicy?: SharedSourcePolicy;\n}\n\nexport type DesktopMemoryOp =\n\t| DesktopMemoryCorrectOp\n\t| DesktopMemorySetUsageOp\n\t| DesktopMemoryMergeOp\n\t| DesktopMemoryDeletePreviewOp\n\t| DesktopMemoryDeleteConfirmOp;\n\nexport interface MutateDesktopMemoryInput extends DesktopMemoryHomeInput {\n\top: DesktopMemoryOp;\n}\n\n/** 各 op 的结构化结果（含 revision 冲突信息——error.currentRevision 如实带）。 */\nexport type MutateDesktopMemoryResult =\n\t| ({ op: \"correct\" } & MemoryResult<CorrectMemoryResult>)\n\t| ({ op: \"setUsage\" } & MemoryResult<SetMemoryUsageResult>)\n\t| ({ op: \"merge\" } & MemoryResult<MergeMemoriesResult>)\n\t| ({ op: \"deletePreview\" } & MemoryResult<PreviewMemoryDeletionResult>)\n\t| ({ op: \"deleteConfirm\" } & MemoryResult<DeleteMemoryResult>);\n\n// ── 删除作业读取与续作 ──────────────────────────────────────────────────\n\nexport interface ReadDesktopMemoryDeletionOperationInput extends DesktopMemoryHomeInput {\n\toperationId: string;\n}\n\nexport interface ResumeDesktopMemoryDeletionInput extends DesktopMemoryHomeInput {\n\toperationId: string;\n}\n\n// ── readDesktopMemorySource ──────────────────────────────────────────────\n\nexport interface ReadDesktopMemorySourceInput extends DesktopMemoryHomeInput {\n\tsourceId: string;\n\t/** 当前展开的 memoryId；与 revision 同时提供时，成功回读后记 expand。 */\n\tmemoryId?: string;\n\t/** 当前展开所依据的修订；修订变化后仍保留原修订，不追到新修订。 */\n\trevision?: number;\n\t/** 发起原文展开的真实会话；页面无活动会话时省略。 */\n\tsessionId?: string;\n\t/** 发起原文展开的真实任务；通用浏览或未知时省略。 */\n\ttaskId?: string;\n\t/** 事件锚点；缺省用来源行自身 entryId。 */\n\tentryId?: string;\n\t/** 相对锚点的整数偏移；缺省 0，首次上下文可取负数。 */\n\toffset?: number;\n\t/** 单页事件数；缺省 50，最大 200。 */\n\tlimit?: number;\n}\n\nexport interface ReadDesktopMemorySourceResult {\n\t/** 回读到的事件（结构化数组——页面逐条渲染，不是 JSONL 文本）。 */\n\tevents: ArchivedEvent[];\n\t/** 来源元数据。 */\n\tmetadata: {\n\t\tsourceId: string;\n\t\tsessionId: string;\n\t\tentryId: string;\n\t\teventType: string;\n\t\tsegmentId: string;\n\t\t/** 锚定事件在段内行号（1 起；缺失时不带）。 */\n\t\tlineNo?: number;\n\t\t/** 本次实际窗口首事件行号（1 起；空窗口不带）。 */\n\t\tstartLine?: number;\n\t\t/** 本次实际窗口末事件行号（1 起；空窗口不带）。 */\n\t\tendLine?: number;\n\t\teventCount: number;\n\t};\n\t/** 来源行、锚点与段文件均可读取。 */\n\tavailable: boolean;\n\t/** 来源行/段行/段文件缺失时 true——页面按「已失效」渲染不拿空内容冒充。 */\n\tmissing: boolean;\n\t/** 段是否已封存（gzip 压缩路）。 */\n\tarchived?: boolean;\n\t/** 归档段 ID（archived 时也带回顶层，便于展示）。 */\n\tsegmentId?: string;\n\t/** 当前来源窗口后是否还有事件。 */\n\thasMore: boolean;\n\t/** 下一页原样作为 offset；仅 hasMore=true 时返回。 */\n\tnextOffset?: number;\n}\n\n// ── 成果表只读投影（desktop 层直读，不复制 artifacts.ts 私有映射） ────────\ninterface DesktopArtifactRow {\n\tartifact_id: string;\n\tproject_id: string;\n\tname: string;\n\tpurpose: string;\n\tinputs: string;\n\toutputs: string;\n\tconditions: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface DesktopVersionRow {\n\tversion_id: string;\n\tartifact_id: string;\n\tseq: number;\n\tlocation_json: string;\n\tsize_bytes: number;\n\torigin_task_id: string | null;\n\tsource_ids_json: string;\n\tsource_session_id: string | null;\n\tsource_entry_id: string | null;\n\treceipt_ref: string | null;\n\tusage_refs_json: string;\n\tcreated_at: string;\n}\n\ninterface DesktopRefRow {\n\tversion_id: string;\n\tref_kind: string;\n\towner_id: string;\n}\n\ninterface DesktopUseRow {\n\tuse_id: string;\n\tversion_id: string;\n\ttask_id: string;\n\taction: string;\n\treceipt_ref: string | null;\n\tcreated_at: string;\n}\n\nconst ARTIFACT_VERSION_COLUMNS =\n\t\"version_id, artifact_id, seq, location_json, size_bytes, origin_task_id, source_ids_json, source_session_id, source_entry_id, receipt_ref, usage_refs_json, created_at\";\n\nfunction mapArtifactRow(row: DesktopArtifactRow): Artifact {\n\treturn {\n\t\tartifactId: row.artifact_id,\n\t\tprojectId: row.project_id,\n\t\tname: row.name,\n\t\tpurpose: row.purpose,\n\t\tinputs: row.inputs,\n\t\toutputs: row.outputs,\n\t\tconditions: row.conditions,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\n/** 预判版本可回读性：受管副本存在/Git 仓根可达。仅提示，实际以 resolveArtifactVersion 为准。 */\nfunction artifactVersionAvailable(location: ArtifactLocation): boolean {\n\tif (location.kind === \"managed\") {\n\t\treturn existsSync(join(location.dir, location.file));\n\t}\n\treturn existsSync(location.repoRoot);\n}\n\nfunction mapVersionItem(row: DesktopVersionRow, refs: DesktopRefRow[]): DesktopArtifactVersionItem {\n\tconst location = JSON.parse(row.location_json) as ArtifactLocation;\n\tconst counts: Record<ArtifactRefKind, number> = { memory: 0, task: 0, use: 0 };\n\tfor (const ref of refs) {\n\t\tif (ref.ref_kind === \"memory\" || ref.ref_kind === \"task\" || ref.ref_kind === \"use\") {\n\t\t\tcounts[ref.ref_kind] += 1;\n\t\t}\n\t}\n\tconst decoded = decodeArtifactReceiptRef(row.receipt_ref);\n\tconst usageRefs = JSON.parse(row.usage_refs_json) as string[];\n\treturn {\n\t\tversionId: row.version_id,\n\t\tseq: row.seq,\n\t\tcreatedAt: row.created_at,\n\t\t...(row.origin_task_id === null ? {} : { originTaskId: row.origin_task_id }),\n\t\tlocationKind: location.kind,\n\t\t...(location.kind === \"git\" ? { locationPath: location.path } : {}),\n\t\tsizeBytes: row.size_bytes,\n\t\t// F13：receiptRef 剥离 verdict 前缀（页面拿到的就是干净回执引用）；\n\t\t// verificationStatus 单独透传，无前推行 undefined → 页面显示「有回执/结果待核」。\n\t\t...(decoded.receiptRef === undefined || decoded.receiptRef === \"\"\n\t\t\t? {}\n\t\t\t: { receiptRef: decoded.receiptRef }),\n\t\t...(decoded.verdict === undefined ? {} : { verificationStatus: decoded.verdict }),\n\t\tsourceIds: JSON.parse(row.source_ids_json) as string[],\n\t\t...(row.source_session_id === null ? {} : { sourceSessionId: row.source_session_id }),\n\t\t...(row.source_entry_id === null ? {} : { sourceEntryId: row.source_entry_id }),\n\t\t...(usageRefs.length === 0 ? {} : { usageRefs }),\n\t\tavailable: artifactVersionAvailable(location),\n\t\trefs: counts,\n\t};\n}\n\nfunction readArtifactRow(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tartifactId: string,\n): DesktopArtifactRow | undefined {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at\n\t\t\t FROM artifacts WHERE artifact_id = ?`,\n\t\t)\n\t\t.get(artifactId) as DesktopArtifactRow | undefined;\n}\n\nfunction readVersionRows(store: ReturnType<typeof openMemoryStore>, artifactId: string): DesktopVersionRow[] {\n\treturn store.db\n\t\t.prepare(`SELECT ${ARTIFACT_VERSION_COLUMNS} FROM artifact_versions WHERE artifact_id = ? ORDER BY seq`)\n\t\t.all(artifactId) as unknown as DesktopVersionRow[];\n}\n\nfunction readRefs(store: ReturnType<typeof openMemoryStore>, artifactId: string): DesktopRefRow[] {\n\treturn store.db\n\t\t.prepare(\n\t\t\t`SELECT version_id, ref_kind, owner_id FROM artifact_refs WHERE artifact_id = ? ORDER BY ref_kind, owner_id`,\n\t\t)\n\t\t.all(artifactId) as unknown as DesktopRefRow[];\n}\n\nfunction readVersionRowById(\n\tstore: ReturnType<typeof openMemoryStore>,\n\tversionId: string,\n): DesktopVersionRow | undefined {\n\treturn store.db\n\t\t.prepare(`SELECT ${ARTIFACT_VERSION_COLUMNS} FROM artifact_versions WHERE version_id = ?`)\n\t\t.get(versionId) as DesktopVersionRow | undefined;\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 2. 服务借用与装配\n// ════════════════════════════════════════════════════════════════════════\n\nfunction openService(\n\thome: string,\n\tmode: \"readonly\" | \"readwrite\",\n\tdeletionCoordinator?: DeletionSessionCoordinator,\n): MemoryService {\n\tif (typeof home !== \"string\" || home.length === 0) {\n\t\tthrow new DesktopMemoryError(\"PAO_HOME 不能为空\");\n\t}\n\t// 生产检索依赖由 service 从 scope.executionRoot/projectId 与 PAO_HOME 统一解析。\n\treturn openMemoryService({\n\t\tpaoHome: home,\n\t\tmode,\n\t\t...(deletionCoordinator === undefined ? {} : { deletionCoordinator }),\n\t});\n}\n\n/** 库未建（memory.sqlite 不存在）时 openMemoryStore readonly 抛 SQLite 错；\n *  判一下路径存在性，把「库还没建」转成可控分支，不拿裸 SQLite 错当业务结果。 */\nfunction databaseExists(home: string): boolean {\n\treturn existsSync(memoryPaths(home).database);\n}\n\nasync function withService<T>(\n\thome: string,\n\tmode: \"readonly\" | \"readwrite\",\n\trun: (service: MemoryService) => Promise<T>,\n\tdeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<T> {\n\tconst service = openService(home, mode, deletionCoordinator);\n\ttry {\n\t\treturn await run(service);\n\t} finally {\n\t\tawait service.close();\n\t}\n}\n\nconst PAGE_OPERATION_SESSION_ID = \"desktop-page-operations\";\n\ninterface PageOperationIdentity {\n\tsessionId: string;\n\tentryId: string;\n\tuserId?: string;\n\tcapturedAt: string;\n}\n\nfunction createPageOperationIdentity(source?: DesktopMemoryOperationSource): PageOperationIdentity {\n\treturn {\n\t\tsessionId: PAGE_OPERATION_SESSION_ID,\n\t\tentryId: `page-operation-${randomUUID()}`,\n\t\t...(source?.userId === undefined ? {} : { userId: source.userId }),\n\t\tcapturedAt: new Date().toISOString(),\n\t};\n}\n\n/**\n * 把一次已到达公开变更入口的页面动作写成可回读来源。入口本身由宿主用户动作建立，\n * 这里不创建 SessionManager 或聊天，只借用归档段与 sources 表保存本次操作正文。\n */\nfunction archivePageOperation(\n\thome: string,\n\toperation: DesktopMemoryOp[\"op\"] | \"setProjectGoal\",\n\tdetails: Record<string, unknown>,\n\tsource?: DesktopMemoryOperationSource,\n): { sourceId: string; source: PageOperationIdentity } {\n\tconst identity = createPageOperationIdentity(source);\n\tconst archived = archiveProjectOperationSource({\n\t\tpaoHome: home,\n\t\toperation,\n\t\tdetails,\n\t\tsessionId: identity.sessionId,\n\t\tentryId: identity.entryId,\n\t\tcapturedAt: identity.capturedAt,\n\t\t...(identity.userId === undefined ? {} : { userId: identity.userId }),\n\t});\n\treturn { sourceId: archived.sourceId, source: identity };\n}\n\nfunction unavailable(message: string): MemoryError {\n\treturn { code: \"unavailable\", message };\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 3. 四个公开函数\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 列表：query+scope+status+kind 过滤 + 分页。\n * - query 非空走 service.searchMemory（双路召回；status/kind 在命中后过滤）。\n * - query 为空按 updatedAt 倒序列举（不经召回——搜索页空态即全部）。\n * - status 过滤缺省时列表仍回全部（页面自己区分显示）；传值才过滤。\n *   注意：service.searchMemory 的 current 模式已滤 stopped/merged/来源排除——\n *   要列 stopped 请传 mode:\"history\" 或走空 query 列举。\n */\nexport async function readDesktopMemoryList(\n\tinput: ReadDesktopMemoryListInput,\n): Promise<MemoryResult<ReadDesktopMemoryListResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Math.max(1, input.page ?? 1);\n\tconst pageSize = Math.min(200, Math.max(1, input.pageSize ?? 50));\n\tconst mode = input.mode ?? \"current\";\n\tconst scope = toMemoryScope(input.scope);\n\t// 库未建 = 还没有任何记忆：返回空列表而非错误（新装桌面没有库也应显示空态）。\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, items: [], total: 0, totalKnown: true, hasMore: false };\n\t}\n\n\tconst query = typeof input.query === \"string\" ? input.query.trim() : \"\";\n\tif (query.length === 0) {\n\t\tconst pageResult = listScopedMemoriesPage(input.home, scope, mode, {\n\t\t\tstatus: input.status,\n\t\t\tkind: input.kind,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\t...pageResult,\n\t\t\ttotalKnown: true,\n\t\t\thasMore: page * pageSize < pageResult.total,\n\t\t};\n\t}\n\n\treturn withService(input.home, \"readonly\", async (service) => {\n\t\t// 召回路只能声明候选窗。过滤后取得下一页探测项即停止；最多扫描 200 条候选。\n\t\tconst required = page * pageSize + 1;\n\t\tlet candidateLimit = Math.min(200, Math.max(page * pageSize, 50));\n\t\tlet search = await service.searchMemory({\n\t\t\tscope,\n\t\t\tquery,\n\t\t\tmode,\n\t\t\tlimit: candidateLimit,\n\t\t\t...(input.status === undefined ? {} : { usageState: input.status }),\n\t\t\t...(input.kind === undefined ? {} : { kind: input.kind }),\n\t\t});\n\t\tif (!search.ok) return search as MemoryResult<ReadDesktopMemoryListResult>;\n\t\tlet filtered = (await hydrateListItems(input.home, search.hits)).filter(\n\t\t\t(item) =>\n\t\t\t\t(input.status === undefined || item.usageState === input.status) &&\n\t\t\t\t(input.kind === undefined || item.kind === input.kind),\n\t\t);\n\t\twhile (filtered.length < required && search.hits.length >= candidateLimit && candidateLimit < 200) {\n\t\t\tconst nextLimit = Math.min(200, Math.max(required, candidateLimit * 2));\n\t\t\tif (nextLimit <= candidateLimit) break;\n\t\t\tcandidateLimit = nextLimit;\n\t\t\tsearch = await service.searchMemory({\n\t\t\t\tscope,\n\t\t\t\tquery,\n\t\t\t\tmode,\n\t\t\t\tlimit: candidateLimit,\n\t\t\t\t...(input.status === undefined ? {} : { usageState: input.status }),\n\t\t\t\t...(input.kind === undefined ? {} : { kind: input.kind }),\n\t\t\t});\n\t\t\tif (!search.ok) return search as MemoryResult<ReadDesktopMemoryListResult>;\n\t\t\tfiltered = (await hydrateListItems(input.home, search.hits)).filter(\n\t\t\t\t(item) =>\n\t\t\t\t\t(input.status === undefined || item.usageState === input.status) &&\n\t\t\t\t\t(input.kind === undefined || item.kind === input.kind),\n\t\t\t);\n\t\t}\n\t\tconst start = (page - 1) * pageSize;\n\t\tconst items = filtered.slice(start, start + pageSize);\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems,\n\t\t\ttotalKnown: false,\n\t\t\tcandidateCount: filtered.length,\n\t\t\tcandidateLimit,\n\t\t\thasMore: filtered.length > page * pageSize,\n\t\t\t...(search.degraded === undefined ? {} : { degraded: search.degraded }),\n\t\t\t...(search.degradeReason === undefined ? {} : { degradeReason: search.degradeReason }),\n\t\t\t...(items.length === 0 && search.emptyReason !== undefined ? { emptyReason: search.emptyReason } : {}),\n\t\t};\n\t});\n}\n\n/** 详情：当前决定 + 修订时间线 + 来源摘要 + 使用计数（memory_usage 聚合）。 */\nexport async function readDesktopMemoryDetail(\n\tinput: ReadDesktopMemoryDetailInput,\n): Promise<MemoryResult<DesktopMemoryDetailResult>> {\n\tif (typeof input.id !== \"string\" || input.id.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"id 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.revision !== undefined && (!Number.isInteger(input.revision) || input.revision < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"revision 必须是正整数\",\n\t\t\t\trefId: input.id,\n\t\t\t} satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(input.home, \"readonly\", async (service) => {\n\t\tconst got = await service.getMemory({\n\t\t\tid: input.id,\n\t\t\tincludeHistory: true,\n\t\t\t...(input.revision === undefined ? {} : { revision: input.revision }),\n\t\t});\n\t\tif (!got.ok) return got as MemoryResult<DesktopMemoryDetailResult>;\n\t\tconst currentRevision = got.memory.currentRevision;\n\t\tconst selectedRevision = input.revision ?? currentRevision;\n\t\tconst isHistorical = selectedRevision !== currentRevision;\n\t\t// 使用计数：detail 需要「这条记忆被参考过几次」；usage 行在库内，\n\t\t// 服务公开接口没有 usage 聚合——本层经 openMemoryStore 的平行引用读\n\t\t// （与 tools.ts 捕获侧同口径，按 PAO_HOME 引用计数共享同一连接）。\n\t\tconst usageSummary = countMemoryUsage(input.home, input.id);\n\t\treturn {\n\t\t\tok: true,\n\t\t\tmemory: got.memory,\n\t\t\tcurrentRevision,\n\t\t\tselectedRevision,\n\t\t\tisHistorical,\n\t\t\treadOnly: isHistorical,\n\t\t\trevisions: got.revisions ?? [],\n\t\t\tsources: got.sourceSummaries,\n\t\t\tsupersessionChain: got.supersessionChain,\n\t\t\tusageSummary,\n\t\t};\n\t});\n}\n\n/** 本任务参考：按可信项目范围及可选 task/session 读取 memory_usage。 */\nexport async function readDesktopMemoryUsage(\n\tinput: ReadDesktopMemoryUsageInput,\n): Promise<MemoryResult<ReadDesktopMemoryUsageResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Number.isInteger(input.page) && (input.page as number) > 0 ? (input.page as number) : 1;\n\tconst pageSize =\n\t\tNumber.isInteger(input.pageSize) && (input.pageSize as number) > 0 ? Math.min(200, input.pageSize as number) : 50;\n\tconst emptyCounts = (): DesktopMemoryUsageCounts => ({ search: 0, inject: 0, expand: 0, used: 0 });\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: [],\n\t\t\ttotal: 0,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t\thasMore: false,\n\t\t\tcounts: emptyCounts(),\n\t\t\tusedRecorded: false,\n\t\t};\n\t}\n\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions = [\n\t\t\t\"json_extract(m.scope_json, '$.projectId') = ?\",\n\t\t\t\"u.action IN ('search', 'inject', 'expand', 'used')\",\n\t\t];\n\t\tconst params: Array<string> = [input.scope.projectId];\n\t\tif (input.scope.taskId !== undefined) {\n\t\t\tconditions.push(\"u.task_id = ?\");\n\t\t\tparams.push(input.scope.taskId);\n\t\t}\n\t\tif (input.scope.sessionId !== undefined) {\n\t\t\tconditions.push(\"u.session_id = ?\");\n\t\t\tparams.push(input.scope.sessionId);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS total\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}`,\n\t\t\t)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT u.id, u.action, u.memory_id, u.revision, u.created_at,\n\t\t\t\t        u.request_id, u.usage_ref, u.task_id, u.session_id\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY u.created_at DESC, u.id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, pageSize, (page - 1) * pageSize) as unknown as Array<{\n\t\t\tid: number;\n\t\t\taction: MemoryUsageAction;\n\t\t\tmemory_id: string;\n\t\t\trevision: number;\n\t\t\tcreated_at: string;\n\t\t\trequest_id: string | null;\n\t\t\tusage_ref: string | null;\n\t\t\ttask_id: string | null;\n\t\t\tsession_id: string | null;\n\t\t}>;\n\t\tconst counts = emptyCounts();\n\t\tconst countRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT u.action, COUNT(*) AS n\n\t\t\t\t FROM memory_usage u\n\t\t\t\t JOIN memories m ON m.id = u.memory_id\n\t\t\t\t WHERE ${where}\n\t\t\t\t GROUP BY u.action`,\n\t\t\t)\n\t\t\t.all(...params) as unknown as Array<{ action: MemoryUsageAction; n: number }>;\n\t\tfor (const row of countRows) counts[row.action] = row.n;\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: rows.map((row) => ({\n\t\t\t\tid: row.id,\n\t\t\t\taction: row.action,\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\t...(row.request_id === null ? {} : { requestId: row.request_id }),\n\t\t\t\t...(row.usage_ref === null ? {} : { usageRef: row.usage_ref }),\n\t\t\t\t...(row.task_id === null ? {} : { taskId: row.task_id }),\n\t\t\t\t...(row.session_id === null ? {} : { sessionId: row.session_id }),\n\t\t\t})),\n\t\t\ttotal: totalRow.total,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t\thasMore: page * pageSize < totalRow.total,\n\t\t\tcounts,\n\t\t\tusedRecorded: counts.used > 0,\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 变更：correct/setUsage/merge/deletePreview/deleteConfirm 五操作走 service 既有入口。\n * revision 冲突如实返回（error.currentRevision 带最新），不自动重试。\n * deletePreview 用 readonly 借用（纯读）；其余写操作用 readwrite。\n * correct/setUsage/merge 先通过既有 archive+sources 入口保存本次用户页面动作；\n * deleteConfirm 只使用本次操作身份，不把被删除正文另写一份操作日志。\n */\nexport async function mutateDesktopMemory(\n\tinput: MutateDesktopMemoryInput,\n\ttrustedDeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<MutateDesktopMemoryResult> {\n\tconst op = input.op;\n\tif (!op || typeof op !== \"object\" || typeof op.op !== \"string\") {\n\t\treturn {\n\t\t\top: \"correct\",\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"op 不能为空\" },\n\t\t} as MutateDesktopMemoryResult;\n\t}\n\t// mutate 走 readwrite：库未建时 createMemory 会建库，但 mutate 只改不建——\n\t// 库不存在即「还没有记忆可改」，返回 unavailable 而非让 SQLite 报裸错。\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\top: op.op,\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t} as MutateDesktopMemoryResult;\n\t}\n\n\tswitch (op.op) {\n\t\tcase \"correct\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"correct\",\n\t\t\t\t{\n\t\t\t\t\tmemoryId: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\treplacement: op.replacement,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.correctMemory({\n\t\t\t\t\tid: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\treplacement: op.replacement,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\t});\n\t\t\t\treturn { op: \"correct\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"setUsage\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"setUsage\",\n\t\t\t\t{\n\t\t\t\t\tmemoryId: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\ttarget: op.target,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.setMemoryUsage({\n\t\t\t\t\tid: op.id,\n\t\t\t\t\texpectedRevision: op.expectedRevision,\n\t\t\t\t\ttarget: op.target,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\t});\n\t\t\t\treturn { op: \"setUsage\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"merge\": {\n\t\t\tconst pageSource = archivePageOperation(\n\t\t\t\tinput.home,\n\t\t\t\t\"merge\",\n\t\t\t\t{\n\t\t\t\t\tkeepId: op.keepId,\n\t\t\t\t\tkeepExpectedRevision: op.keepExpectedRevision,\n\t\t\t\t\tmergeId: op.mergeId,\n\t\t\t\t\tmergeExpectedRevision: op.mergeExpectedRevision,\n\t\t\t\t\trationale: op.rationale,\n\t\t\t\t},\n\t\t\t\top.source,\n\t\t\t);\n\t\t\treturn withService(input.home, \"readwrite\", async (service) => {\n\t\t\t\tconst result = await service.mergeMemories({\n\t\t\t\t\tkeepId: op.keepId,\n\t\t\t\t\tkeepExpectedRevision: op.keepExpectedRevision,\n\t\t\t\t\tmergeId: op.mergeId,\n\t\t\t\t\tmergeExpectedRevision: op.mergeExpectedRevision,\n\t\t\t\t\trationale: op.rationale,\n\t\t\t\t\tsource: pageSource.source,\n\t\t\t\t});\n\t\t\t\treturn { op: \"merge\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"deletePreview\": {\n\t\t\treturn withService(input.home, \"readonly\", async (service) => {\n\t\t\t\tconst result = await service.previewMemoryDeletion({\n\t\t\t\t\t...(op.memoryId === undefined ? {} : { memoryId: op.memoryId }),\n\t\t\t\t\t...(op.sourceId === undefined ? {} : { sourceId: op.sourceId }),\n\t\t\t\t\t...(op.sessionId === undefined ? {} : { sessionId: op.sessionId }),\n\t\t\t\t\t...(op.entryId === undefined ? {} : { entryId: op.entryId }),\n\t\t\t\t\t...(op.sharedSourcePolicy === undefined ? {} : { sharedSourcePolicy: op.sharedSourcePolicy }),\n\t\t\t\t});\n\t\t\t\treturn { op: \"deletePreview\", ...result } as MutateDesktopMemoryResult;\n\t\t\t});\n\t\t}\n\t\tcase \"deleteConfirm\": {\n\t\t\tconst pageSource = createPageOperationIdentity(op.source);\n\t\t\treturn withService(\n\t\t\t\tinput.home,\n\t\t\t\t\"readwrite\",\n\t\t\t\tasync (service) => {\n\t\t\t\t\tconst result = await service.deleteMemory({\n\t\t\t\t\t\tmemoryIds: op.memoryIds,\n\t\t\t\t\t\trevisions: op.revisions,\n\t\t\t\t\t\tsource: {\n\t\t\t\t\t\t\tsessionId: pageSource.sessionId,\n\t\t\t\t\t\t\tentryId: pageSource.entryId,\n\t\t\t\t\t\t\t...(pageSource.userId === undefined ? {} : { userId: pageSource.userId }),\n\t\t\t\t\t\t},\n\t\t\t\t\t\t...(op.sharedSourcePolicy === undefined ? {} : { sharedSourcePolicy: op.sharedSourcePolicy }),\n\t\t\t\t\t});\n\t\t\t\t\treturn { op: \"deleteConfirm\", ...result } as MutateDesktopMemoryResult;\n\t\t\t\t},\n\t\t\t\ttrustedDeletionCoordinator,\n\t\t\t);\n\t\t}\n\t\tdefault: {\n\t\t\treturn {\n\t\t\t\top: \"correct\",\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `未知变更操作:${String((op as { op?: unknown }).op)}`,\n\t\t\t\t},\n\t\t\t} as MutateDesktopMemoryResult;\n\t\t}\n\t}\n}\n\n/** 只读聚合当前目标、正式引用、计划、卡与工作流实例。 */\nexport async function readDesktopProjectContext(\n\tinput: ReadDesktopProjectContextInput,\n): Promise<MemoryResult<ProjectContextBrief>> {\n\tif (!databaseExists(input.home)) {\n\t\treturn readProjectContext({\n\t\t\tpaoHome: input.home,\n\t\t\tprojectId: input.projectId,\n\t\t\tprojectRoot: input.projectRoot,\n\t\t\t...(input.planId === undefined ? {} : { planId: input.planId }),\n\t\t});\n\t}\n\treturn withService(input.home, \"readonly\", (service) =>\n\t\treadProjectContext({\n\t\t\tpaoHome: input.home,\n\t\t\tprojectId: input.projectId,\n\t\t\tprojectRoot: input.projectRoot,\n\t\t\t...(input.planId === undefined ? {} : { planId: input.planId }),\n\t\t\tmemoryService: service,\n\t\t}),\n\t);\n}\n\n/**\n * 列当前项目的任务接续。项目内 taskId 来自接续表，正文和现场差异由既有\n * readTaskContinuation 逐项回查；单个任务失败仍保留在 items 中。\n */\nexport async function readDesktopTaskContinuations(\n\tinput: ReadDesktopTaskContinuationsInput,\n): Promise<MemoryResult<ReadDesktopTaskContinuationsResult>> {\n\treturn listTaskContinuationsForProject({\n\t\tpaoHome: input.home,\n\t\tprojectId: input.projectId,\n\t});\n}\n\n/** 按当前项目读取一条任务接续详情；只读，不迁移或改写历史路径。 */\nexport async function readDesktopTaskContinuation(\n\tinput: ReadDesktopTaskContinuationInput,\n): Promise<ReadDesktopTaskContinuationResult> {\n\treturn readTaskContinuationForPage({\n\t\tpaoHome: input.home,\n\t\tprojectId: input.projectId,\n\t\ttaskId: input.taskId,\n\t});\n}\n\n/**\n * 成果列表（S6-09）：按可信项目身份列举成果条目。\n * 库未建返回空列表；列表只给版本可用性预判与计数，不回读内容。\n */\nexport async function readDesktopArtifacts(\n\tinput: ReadDesktopArtifactsInput,\n): Promise<MemoryResult<ReadDesktopArtifactsResult>> {\n\tif (typeof input.projectId !== \"string\" || input.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, items: [] };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT artifact_id, project_id, name, purpose, inputs, outputs, conditions, created_at, updated_at\n\t\t\t\t FROM artifacts WHERE project_id = ? ORDER BY updated_at DESC, artifact_id`,\n\t\t\t)\n\t\t\t.all(input.projectId) as unknown as DesktopArtifactRow[];\n\t\tconst items = rows.map((row) => {\n\t\t\tconst versions = readVersionRows(store, row.artifact_id);\n\t\t\tconst refs = readRefs(store, row.artifact_id);\n\t\t\tconst latest = versions.length > 0 ? versions[versions.length - 1] : undefined;\n\t\t\tconst useCountRow = store.db\n\t\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_uses WHERE artifact_id = ?\")\n\t\t\t\t.get(row.artifact_id) as { n: number };\n\t\t\treturn {\n\t\t\t\tartifact: mapArtifactRow(row),\n\t\t\t\tversionCount: versions.length,\n\t\t\t\t...(latest === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: {\n\t\t\t\t\t\t\tlatestVersion: mapVersionItem(\n\t\t\t\t\t\t\t\tlatest,\n\t\t\t\t\t\t\t\trefs.filter((r) => r.version_id === latest.version_id),\n\t\t\t\t\t\t\t),\n\t\t\t\t\t\t}),\n\t\t\t\tuseCount: useCountRow.n,\n\t\t\t};\n\t\t});\n\t\treturn { ok: true, items };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/** 成果详情：成果行 + 版本列表（含各版本 refs 与最近验证回执引用）。 */\nexport async function readDesktopArtifactDetail(\n\tinput: ReadDesktopArtifactDetailInput,\n): Promise<MemoryResult<DesktopArtifactDetailResult>> {\n\tif (typeof input.artifactId !== \"string\" || input.artifactId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"artifactId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst row = readArtifactRow(store, input.artifactId);\n\t\tif (!row) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `成果不存在:${input.artifactId}`,\n\t\t\t\t\trefId: input.artifactId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst refs = readRefs(store, input.artifactId);\n\t\tconst versions = readVersionRows(store, input.artifactId).map((version) =>\n\t\t\tmapVersionItem(\n\t\t\t\tversion,\n\t\t\t\trefs.filter((ref) => ref.version_id === version.version_id),\n\t\t\t),\n\t\t);\n\t\treturn { ok: true, artifact: mapArtifactRow(row), versions };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 成果版本预览：按确切版本回读内容并文本化分页。\n * resolveArtifactVersion 给 Buffer，本层转 string 按 offset/limit 分段；\n * 二进制或不可解码返回 unavailableReason，绝不拿当前工作树文件顶替。\n */\nexport async function readDesktopArtifactVersion(\n\tinput: ReadDesktopArtifactVersionInput,\n): Promise<MemoryResult<DesktopArtifactVersionResult>> {\n\tif (typeof input.artifactId !== \"string\" || input.artifactId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"artifactId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (typeof input.versionId !== \"string\" || input.versionId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"versionId 不能为空\",\n\t\t\t\trefId: input.artifactId,\n\t\t\t} satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.offset !== undefined && (!Number.isInteger(input.offset) || input.offset < 0)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"offset 必须是非负整数\",\n\t\t\t\trefId: input.versionId,\n\t\t\t} satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.limit !== undefined && (!Number.isInteger(input.limit) || input.limit < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: {\n\t\t\t\tcode: \"invalid_input\",\n\t\t\t\tmessage: \"limit 必须是正整数\",\n\t\t\t\trefId: input.versionId,\n\t\t\t} satisfies MemoryError,\n\t\t};\n\t}\n\tconst offset = input.offset ?? 0;\n\tconst limit = Math.min(20000, input.limit ?? 4000);\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(input.home, \"readonly\", async (service) => {\n\t\tconst store = openMemoryStore(input.home, \"readonly\");\n\t\ttry {\n\t\t\tconst artifactRow = readArtifactRow(store, input.artifactId);\n\t\t\tconst versionRow = readVersionRowById(store, input.versionId);\n\t\t\tif (!artifactRow || !versionRow || versionRow.artifact_id !== input.artifactId) {\n\t\t\t\treturn {\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: `成果版本不属于该成果或不存在:${input.artifactId}/${input.versionId}`,\n\t\t\t\t\t\trefId: input.versionId,\n\t\t\t\t\t} satisfies MemoryError,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst artifact = mapArtifactRow(artifactRow);\n\t\t\tconst refs = readRefs(store, input.artifactId).filter((ref) => ref.version_id === versionRow.version_id);\n\t\t\tconst version = mapVersionItem(versionRow, refs);\n\t\t\tconst resolved = await service.resolveArtifactVersion({ versionId: input.versionId });\n\t\t\tif (!resolved.ok) {\n\t\t\t\treturn resolved as MemoryResult<DesktopArtifactVersionResult>;\n\t\t\t}\n\t\t\tif (!resolved.available) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tartifact,\n\t\t\t\t\tversion,\n\t\t\t\t\tcontent: \"\",\n\t\t\t\t\tavailable: false,\n\t\t\t\t\tunavailableReason: resolved.reason,\n\t\t\t\t\thasMore: false,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst text = decodeArtifactContent(resolved.content);\n\t\t\tif (text === undefined) {\n\t\t\t\treturn {\n\t\t\t\t\tok: true,\n\t\t\t\t\tartifact,\n\t\t\t\t\tversion,\n\t\t\t\t\tcontent: \"\",\n\t\t\t\t\tavailable: false,\n\t\t\t\t\tunavailableReason: `版本内容不是可解码文本（${resolved.content.length} 字节），不提供预览`,\n\t\t\t\t\thasMore: false,\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst content = text.slice(offset, offset + limit);\n\t\t\tconst hasMore = offset + limit < text.length;\n\t\t\treturn {\n\t\t\t\tok: true,\n\t\t\t\tartifact,\n\t\t\t\tversion,\n\t\t\t\tcontent,\n\t\t\t\tavailable: true,\n\t\t\t\thasMore,\n\t\t\t\t...(hasMore ? { nextOffset: offset + limit } : {}),\n\t\t\t};\n\t\t} finally {\n\t\t\tstore.close();\n\t\t}\n\t});\n}\n\n/** 文本化：UTF-8 严格解码失败或含 NUL 视为不可预览（不拿乱码冒充）。 */\nfunction decodeArtifactContent(content: Buffer): string | undefined {\n\tif (content.includes(0)) return undefined;\n\ttry {\n\t\treturn new TextDecoder(\"utf-8\", { fatal: true }).decode(content);\n\t} catch {\n\t\treturn undefined;\n\t}\n}\n\n/** 复用记录：按 artifact 分页列 artifact_uses（最新在前）。 */\nexport async function readDesktopArtifactUses(\n\tinput: ReadDesktopArtifactUsesInput,\n): Promise<MemoryResult<ReadDesktopArtifactUsesResult>> {\n\tif (typeof input.artifactId !== \"string\" || input.artifactId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"artifactId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Number.isInteger(input.page) && (input.page as number) > 0 ? (input.page as number) : 1;\n\tconst pageSize =\n\t\tNumber.isInteger(input.pageSize) && (input.pageSize as number) > 0 ? Math.min(200, input.pageSize as number) : 50;\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, items: [], total: 0, page, pageSize, hasMore: false };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tif (!readArtifactRow(store, input.artifactId)) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `成果不存在:${input.artifactId}`,\n\t\t\t\t\trefId: input.artifactId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst totalRow = store.db\n\t\t\t.prepare(\"SELECT COUNT(*) AS n FROM artifact_uses WHERE artifact_id = ?\")\n\t\t\t.get(input.artifactId) as { n: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT use_id, version_id, task_id, action, receipt_ref, created_at\n\t\t\t\t FROM artifact_uses WHERE artifact_id = ?\n\t\t\t\t ORDER BY created_at DESC, use_id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(input.artifactId, pageSize, (page - 1) * pageSize) as unknown as DesktopUseRow[];\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: rows.map((row) => ({\n\t\t\t\tuseId: row.use_id,\n\t\t\t\tversionId: row.version_id,\n\t\t\t\ttaskId: row.task_id,\n\t\t\t\taction: row.action,\n\t\t\t\t...(row.receipt_ref === null ? {} : { receiptRef: row.receipt_ref }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t})),\n\t\t\ttotal: totalRow.n,\n\t\t\tpage,\n\t\t\tpageSize,\n\t\t\thasMore: page * pageSize < totalRow.n,\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 把一次明确页面保存归档为本次用户决定来源，再调用同一目标变更入口。\n * 当前正式文档和阶段来源从正本回读；没有绑定时不补造引用。\n */\nexport async function recordDesktopProjectGoalChange(\n\tinput: RecordDesktopProjectGoalChangeInput,\n): Promise<MemoryResult<RecordProjectGoalChangeResult>> {\n\tconst conclusion = typeof input.conclusion === \"string\" ? input.conclusion.trim() : \"\";\n\tif (conclusion.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"项目目标不能为空\" },\n\t\t};\n\t}\n\tif (typeof input.userId !== \"string\" || input.userId.trim().length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"页面用户身份不能为空\" },\n\t\t};\n\t}\n\n\tlet formalDocuments: ProjectSourceRef[] = [];\n\tlet stageDescriptionSource: ProjectSourceRef | undefined;\n\tif (databaseExists(input.home)) {\n\t\tconst current = await readDesktopProjectContext(input);\n\t\tif (!current.ok) return current;\n\t\tformalDocuments = current.binding?.formalDocuments ?? [];\n\t\tstageDescriptionSource = current.binding?.stageDescriptionSource;\n\t}\n\n\tconst pageSource = archivePageOperation(\n\t\tinput.home,\n\t\t\"setProjectGoal\",\n\t\t{\n\t\t\tprojectId: input.projectId,\n\t\t\tconclusion,\n\t\t\t...(input.conditions === undefined ? {} : { conditions: input.conditions }),\n\t\t\t...(input.rationale === undefined ? {} : { rationale: input.rationale }),\n\t\t},\n\t\t{ userId: input.userId.trim() },\n\t);\n\n\treturn withService(input.home, \"readwrite\", (service) =>\n\t\trecordProjectGoalChange({\n\t\t\tpaoHome: input.home,\n\t\t\tprojectId: input.projectId,\n\t\t\tprojectRoot: input.projectRoot,\n\t\t\tmemoryService: service,\n\t\t\tdecision: {\n\t\t\t\tsourceKind: \"explicit_user_decision\",\n\t\t\t\tuserId: input.userId.trim(),\n\t\t\t\tsourceIds: [pageSource.sourceId],\n\t\t\t\tconclusion,\n\t\t\t\t...(input.conditions === undefined ? {} : { conditions: input.conditions }),\n\t\t\t\t...(input.rationale === undefined ? {} : { rationale: input.rationale }),\n\t\t\t\tdecidedAt: pageSource.source.capturedAt,\n\t\t\t},\n\t\t\tformalDocuments,\n\t\t\t...(stageDescriptionSource === undefined ? {} : { stageDescriptionSource }),\n\t\t}),\n\t);\n}\n\n/** 按 operationId 读取持久删除计划；目标记忆已删除后仍可校验 projectIds。 */\nexport async function readDesktopMemoryDeletionOperation(\n\tinput: ReadDesktopMemoryDeletionOperationInput,\n): Promise<MemoryResult<DeletionOperationDto>> {\n\tif (typeof input.operationId !== \"string\" || input.operationId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"operationId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(input.home, \"readonly\", (service) =>\n\t\tservice.readDeletionOperation({ operationId: input.operationId }),\n\t);\n}\n\n/** 按 operationId 续作删除；仅宿主可信层可传入会话生命周期协调器。 */\nexport async function resumeDesktopMemoryDeletion(\n\tinput: ResumeDesktopMemoryDeletionInput,\n\ttrustedDeletionCoordinator?: DeletionSessionCoordinator,\n): Promise<MemoryResult<DeleteMemoryResult>> {\n\tif (typeof input.operationId !== \"string\" || input.operationId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"operationId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\treturn withService(\n\t\tinput.home,\n\t\t\"readwrite\",\n\t\t(service) => service.resumeDeletion({ operationId: input.operationId }),\n\t\ttrustedDeletionCoordinator,\n\t);\n}\n\n/**\n * 来源回读：按 sourceId 回读原文事件。\n * 返回结构化事件数组（页面逐条渲染）；来源行/段缺失时 missing=true 不伪造内容。\n */\nexport async function readDesktopMemorySource(\n\tinput: ReadDesktopMemorySourceInput,\n): Promise<MemoryResult<ReadDesktopMemorySourceResult>> {\n\tif (typeof input.sourceId !== \"string\" || input.sourceId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"sourceId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (input.entryId !== undefined && input.entryId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"entryId 不能为空\", refId: input.sourceId },\n\t\t};\n\t}\n\tif ((input.memoryId === undefined) !== (input.revision === undefined)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"memoryId 与 revision 必须同时提供\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.memoryId !== undefined && input.memoryId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"memoryId 不能为空\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.revision !== undefined && (!Number.isInteger(input.revision) || input.revision < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"revision 必须是正整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.offset !== undefined && !Number.isInteger(input.offset)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"offset 必须是整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tif (input.limit !== undefined && (!Number.isInteger(input.limit) || input.limit < 1)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"limit 必须是正整数\", refId: input.sourceId },\n\t\t};\n\t}\n\tconst offset = input.offset ?? 0;\n\tconst limit = Math.min(200, input.limit ?? 50);\n\tconst missingResult = (): MemoryResult<ReadDesktopMemorySourceResult> => ({\n\t\tok: true,\n\t\tevents: [],\n\t\tmetadata: {\n\t\t\tsourceId: input.sourceId,\n\t\t\tsessionId: \"\",\n\t\t\tentryId: input.entryId ?? \"\",\n\t\t\teventType: \"\",\n\t\t\tsegmentId: \"\",\n\t\t\teventCount: 0,\n\t\t},\n\t\tavailable: false,\n\t\tmissing: true,\n\t\thasMore: false,\n\t});\n\tif (!databaseExists(input.home)) {\n\t\t// 库未建：来源必然不存在，按 missing 如实渲染（不伪造内容）。\n\t\treturn missingResult();\n\t}\n\tconst recordExpand = input.memoryId !== undefined && input.revision !== undefined;\n\treturn withService(input.home, recordExpand ? \"readwrite\" : \"readonly\", async (service) => {\n\t\tconst result = await service.readMemorySource({\n\t\t\tsourceId: input.sourceId,\n\t\t\t...(input.entryId === undefined ? {} : { entryId: input.entryId }),\n\t\t\toffset,\n\t\t\tlimit,\n\t\t});\n\t\tif (!result.ok) {\n\t\t\t// source_missing 走业务错误通道；页面按 missing 渲染不拿空内容冒充。\n\t\t\tif (result.error.code === \"source_missing\") {\n\t\t\t\treturn missingResult();\n\t\t\t}\n\t\t\treturn result as MemoryResult<ReadDesktopMemorySourceResult>;\n\t\t}\n\t\t// content 是 service 侧 JSONL 字符串（一行一事件）；解析回结构化数组给页面。\n\t\tconst events = result.content\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((line) => line.length > 0)\n\t\t\t.map((line) => JSON.parse(line) as ArchivedEvent);\n\t\tconst response: MemoryResult<ReadDesktopMemorySourceResult> = {\n\t\t\tok: true,\n\t\t\tevents,\n\t\t\tmetadata: {\n\t\t\t\tsourceId: result.sourceId,\n\t\t\t\tsessionId: result.sessionId,\n\t\t\t\tentryId: result.entryId,\n\t\t\t\teventType: result.eventType,\n\t\t\t\tsegmentId: result.segmentId ?? \"\",\n\t\t\t\tlineNo: (result.metadata.lineNo as number | undefined) ?? undefined,\n\t\t\t\tstartLine: result.startLine,\n\t\t\t\tendLine: result.endLine,\n\t\t\t\teventCount: events.length,\n\t\t\t},\n\t\t\tavailable: true,\n\t\t\tmissing: false,\n\t\t\tarchived: result.archived,\n\t\t\t...(result.segmentId === undefined ? {} : { segmentId: result.segmentId }),\n\t\t\thasMore: result.hasMore,\n\t\t\t...(result.nextOffset === undefined ? {} : { nextOffset: result.nextOffset }),\n\t\t};\n\t\tif (recordExpand && events.length > 0) {\n\t\t\ttry {\n\t\t\t\tconst memory = await service.getMemory({\n\t\t\t\t\tid: input.memoryId!,\n\t\t\t\t\trevision: input.revision!,\n\t\t\t\t});\n\t\t\t\tif (memory.ok && memory.sourceSummaries.some((source) => source.sourceId === input.sourceId)) {\n\t\t\t\t\tawait service.recordMemoryUsage({\n\t\t\t\t\t\taction: \"expand\",\n\t\t\t\t\t\tmemoryId: input.memoryId!,\n\t\t\t\t\t\trevision: input.revision!,\n\t\t\t\t\t\trequestId: randomUUID(),\n\t\t\t\t\t\t...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),\n\t\t\t\t\t\t...(input.taskId === undefined ? {} : { taskId: input.taskId }),\n\t\t\t\t\t\tusageRef: input.sourceId,\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t} catch {\n\t\t\t\t// 使用计数是增益；原文已经成功回读，不因记账故障把页面回读判失败。\n\t\t\t}\n\t\t}\n\t\treturn response;\n\t});\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 4. S7-10：运行与用量三读桥（纯 DTO，不返回句柄/函数/Map）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 整理状态（memory-activity）：列出本 home 全部记忆作业，\n * 状态直接来自 extraction_jobs 队列，含失败原因与关联会话/任务。\n */\nexport interface ReadDesktopMemoryMaintenanceInput extends DesktopMemoryHomeInput {\n\t/** 限定类别；缺省全部（extract/embed/organize/archive）。 */\n\tkind?: string;\n}\n\nexport interface DesktopMemoryMaintenanceJob {\n\tjobId: string;\n\tjobKind: string;\n\tstatus: string;\n\tscopeKey: string;\n\tsourceScope: string;\n\tcursor?: string;\n\tattemptCount: number;\n\tlastError?: string;\n\townerProcess?: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n\t/** 来源会话（source_scope JSON 里的 sessionId，能解析到时）。 */\n\tsourceSessionId?: string;\n\t/** 来源任务（source_scope JSON 里的 taskId，能解析到时）。 */\n\ttaskId?: string;\n}\n\nexport interface ReadDesktopMemoryMaintenanceResult {\n\titems: DesktopMemoryMaintenanceJob[];\n\t/** 队列摘要计数。 */\n\tcounts: { pending: number; running: number; done: number; failed: number };\n}\n\n/**\n * 读取本 home 的记忆维护作业队列。\n * 库未建返回空队列（新装桌面没有库也应显示空态）。\n */\nexport async function readDesktopMemoryMaintenance(\n\tinput: ReadDesktopMemoryMaintenanceInput,\n): Promise<MemoryResult<ReadDesktopMemoryMaintenanceResult>> {\n\tconst empty: ReadDesktopMemoryMaintenanceResult = {\n\t\titems: [],\n\t\tcounts: { pending: 0, running: 0, done: 0, failed: 0 },\n\t};\n\tif (!databaseExists(input.home)) {\n\t\treturn { ok: true, ...empty };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions: string[] = [];\n\t\tconst params: string[] = [];\n\t\tif (input.kind !== undefined) {\n\t\t\tconditions.push(\"job_kind = ?\");\n\t\t\tparams.push(input.kind);\n\t\t}\n\t\tconst where = conditions.length > 0 ? `WHERE ${conditions.join(\" AND \")}` : \"\";\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT job_id, job_kind, source_scope, scope_key, status, cursor, attempt_count,\n\t\t\t\t\t\tlast_error, owner_process, created_at, updated_at\n\t\t\t\t FROM extraction_jobs ${where}\n\t\t\t\t ORDER BY updated_at DESC, job_id`,\n\t\t\t)\n\t\t\t.all(...params) as unknown as Array<{\n\t\t\tjob_id: string;\n\t\t\tjob_kind: string;\n\t\t\tsource_scope: string;\n\t\t\tscope_key: string;\n\t\t\tstatus: string;\n\t\t\tcursor: string | null;\n\t\t\tattempt_count: number;\n\t\t\tlast_error: string | null;\n\t\t\towner_process: string | null;\n\t\t\tcreated_at: string;\n\t\t\tupdated_at: string;\n\t\t}>;\n\t\tconst counts = { pending: 0, running: 0, done: 0, failed: 0 };\n\t\tconst items = rows.map((row) => {\n\t\t\tif (row.status in counts) counts[row.status as keyof typeof counts] += 1;\n\t\t\tlet sourceSessionId: string | undefined;\n\t\t\tlet taskId: string | undefined;\n\t\t\ttry {\n\t\t\t\tconst parsed = JSON.parse(row.source_scope) as Record<string, unknown>;\n\t\t\t\tif (typeof parsed.sessionId === \"string\") sourceSessionId = parsed.sessionId;\n\t\t\t\tif (typeof parsed.taskId === \"string\") taskId = parsed.taskId;\n\t\t\t} catch {\n\t\t\t\t// source_scope 非 JSON（自定义 scopeKey）：不带会话/任务关联。\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tjobId: row.job_id,\n\t\t\t\tjobKind: row.job_kind,\n\t\t\t\tstatus: row.status,\n\t\t\t\tscopeKey: row.scope_key,\n\t\t\t\tsourceScope: row.source_scope,\n\t\t\t\t...(row.cursor === null ? {} : { cursor: row.cursor }),\n\t\t\t\tattemptCount: row.attempt_count,\n\t\t\t\t...(row.last_error === null ? {} : { lastError: row.last_error }),\n\t\t\t\t...(row.owner_process === null ? {} : { ownerProcess: row.owner_process }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tupdatedAt: row.updated_at,\n\t\t\t\t...(sourceSessionId === undefined ? {} : { sourceSessionId }),\n\t\t\t\t...(taskId === undefined ? {} : { taskId }),\n\t\t\t};\n\t\t});\n\t\treturn { ok: true, items, counts };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ── readDesktopTaskMemoryCost ─────────────────────────────────────────────\n\nexport interface ReadDesktopTaskMemoryCostInput extends DesktopMemoryHomeInput {\n\t/** 限定来源任务；缺省该 home 全部后台用量。 */\n\ttaskId?: string;\n\t/** 限定来源会话。 */\n\tsourceSessionId?: string;\n\t/** 限定后台 jobId。 */\n\tjobId?: string;\n}\n\nexport interface ReadDesktopTaskMemoryCostResult {\n\t/** 按用途（kind）分组的合计：提炼/嵌入/规整/归档。 */\n\tbyPurpose: Array<{\n\t\tpurpose: string;\n\t\trequestCount: number;\n\t\tknownTokens: number;\n\t\tknownCost?: number;\n\t\tunknownCount: number;\n\t}>;\n\t/** 去重后的逐请求明细。 */\n\tentries: Array<{\n\t\tjobId: string;\n\t\tpurpose: string;\n\t\trequestId?: string;\n\t\tsourceSessionId?: string;\n\t\ttaskId?: string;\n\t\tprovider: string;\n\t\tmodel: string;\n\t\tinputTokens: number;\n\t\toutputTokens: number;\n\t\tcacheReadTokens: number;\n\t\tcacheWriteTokens: number;\n\t\ttotalTokens: number;\n\t\tcost?: number;\n\t\ttimestamp: string;\n\t}>;\n\t/** 全量合计；unknownCount 计 usage.totalTokens=0 或 cost 未返回的条目。 */\n\ttotal: {\n\t\trequestCount: number;\n\t\tknownTokens: number;\n\t\tknownCost?: number;\n\t\tunknownCount: number;\n\t};\n}\n\n/**\n * 任务用量（memory-task-usage）：按用途分组 + 去重请求明细 + 已知/未知费用。\n * 不返回 store/ledger 句柄，只给可 JSON 序列化的合计与明细。\n */\nexport async function readDesktopTaskMemoryCost(\n\tinput: ReadDesktopTaskMemoryCostInput,\n): Promise<MemoryResult<ReadDesktopTaskMemoryCostResult>> {\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\tbyPurpose: [],\n\t\t\tentries: [],\n\t\t\ttotal: { requestCount: 0, knownTokens: 0, unknownCount: 0 },\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst result = readMemoryUsage(store, {\n\t\t\tpaoHome: input.home,\n\t\t\t...(input.taskId === undefined ? {} : { taskId: input.taskId }),\n\t\t\t...(input.sourceSessionId === undefined ? {} : { sourceSessionId: input.sourceSessionId }),\n\t\t\t...(input.jobId === undefined ? {} : { jobId: input.jobId }),\n\t\t});\n\t\t// O14：用途分组在内核聚合一次返回——本层只做 DTO 映射，不再重复\n\t\t// known/unknown 判定（与 byJob 同一聚合点，F09 单一口径）。\n\t\tconst entries = result.entries.map((entry) => ({\n\t\t\tjobId: entry.jobId,\n\t\t\tpurpose: entry.kind,\n\t\t\t...(entry.requestId === undefined ? {} : { requestId: entry.requestId }),\n\t\t\t...(entry.sourceSessionId === undefined ? {} : { sourceSessionId: entry.sourceSessionId }),\n\t\t\t...(entry.taskId === undefined ? {} : { taskId: entry.taskId }),\n\t\t\tprovider: entry.provider,\n\t\t\tmodel: entry.model,\n\t\t\tinputTokens: entry.usage.input,\n\t\t\toutputTokens: entry.usage.output,\n\t\t\tcacheReadTokens: entry.usage.cacheRead,\n\t\t\tcacheWriteTokens: entry.usage.cacheWrite,\n\t\t\ttotalTokens: entry.usage.totalTokens,\n\t\t\t...(entry.usage.cost?.total === undefined ? {} : { cost: entry.usage.cost.total }),\n\t\t\ttimestamp: entry.timestamp,\n\t\t}));\n\t\treturn {\n\t\t\tok: true,\n\t\t\tbyPurpose: result.byPurpose.map((bucket) => ({\n\t\t\t\tpurpose: bucket.purpose,\n\t\t\t\trequestCount: bucket.requestCount,\n\t\t\t\tknownTokens: bucket.knownTokens,\n\t\t\t\t...(bucket.knownCost === undefined ? {} : { knownCost: bucket.knownCost }),\n\t\t\t\tunknownCount: bucket.unknownCount,\n\t\t\t})),\n\t\t\tentries,\n\t\t\ttotal: {\n\t\t\t\trequestCount: result.entries.length,\n\t\t\t\tknownTokens: result.total.totalTokens,\n\t\t\t\t...(result.total.cost === undefined ? {} : { knownCost: result.total.cost }),\n\t\t\t\tunknownCount: result.total.unknownCount,\n\t\t\t},\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ── readDesktopContextUsage ───────────────────────────────────────────────\n\nexport interface ReadDesktopContextUsageInput extends DesktopMemoryHomeInput {\n\t/** 必给：按 requestId 回读单条快照。 */\n\trequestId?: string;\n\t/** 限定会话（配合 requestId 缩小扫描；单 requestId 时可省略）。 */\n\tsessionId?: string;\n\t/** 列最近 N 条快照（requestId 缺省时；缺省 20，上限 100）。 */\n\tlimit?: number;\n}\n\nexport interface DesktopContextUsageItem {\n\trequestId: string;\n\tsessionId: string;\n\ttaskId?: string;\n\tsampledAt: string;\n\testimateMethod: string;\n\tbyCategory: Record<string, number>;\n\testimatedTotal: number;\n\tmessageCount: number;\n\tunestimated: Array<{ kind: string; note: string; messageIndexes: number[] }>;\n\tnotes: string[];\n\t/** 旁列：同会话里该请求相邻的真实供应商 usage（能找到时）。 */\n\tactual?: {\n\t\tinputTokens: number;\n\t\toutputTokens: number;\n\t\tcacheReadTokens: number;\n\t\tcacheWriteTokens: number;\n\t\ttotalTokens: number;\n\t\tcost?: number;\n\t};\n}\n\nexport interface ReadDesktopContextUsageResult {\n\titems: DesktopContextUsageItem[];\n\t/** 按 requestId 单查且未命中时 true——页面显示「尚无该请求记录」。 */\n\tnotFound?: boolean;\n}\n\n/**\n * 上下文用量（memory-context-usage）：按 requestId 或最近若干条读会话\n * `pao-context-usage` custom entry；旁列同会话相邻真实 usage 条目。\n *\n * 会话文件扫描：遍历 `<home>/agent/sessions/<cwd-encoded>/*.jsonl`，\n * 逐会话读 entries 找 customType===\"pao-context-usage\" 的条目。\n * 正常请求不为生成统计额外调用模型——本函数只读已落库的会话文件。\n */\nexport async function readDesktopContextUsage(\n\tinput: ReadDesktopContextUsageInput,\n): Promise<MemoryResult<ReadDesktopContextUsageResult>> {\n\tconst sessionsRoot = join(input.home, \"agent\", \"sessions\");\n\tconst limit = Math.min(100, Math.max(1, input.limit ?? 20));\n\tconst items: DesktopContextUsageItem[] = [];\n\tif (!existsSync(sessionsRoot)) {\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: [],\n\t\t\t...(input.requestId === undefined ? {} : { notFound: true }),\n\t\t};\n\t}\n\n\t// 收集全部会话文件（每个 cwd-encoded 子目录下的 *.jsonl），并按文件\n\t// mtime 降序先选候选：O14 修复——原按目录枚举顺序扫到 limit 即停，目录序\n\t// 靠后的较新会话可能被整批跳过；现在「先取 mtime 最近的候选再逐文件读」，\n\t// limit 名单按文件新鲜度排定，不把较新会话漏在窗口外。\n\tconst sessionFiles: Array<{ path: string; mtimeMs: number }> = [];\n\tfor (const dir of readdirSync(sessionsRoot, { withFileTypes: true })) {\n\t\tif (!dir.isDirectory()) continue;\n\t\tconst sub = join(sessionsRoot, dir.name);\n\t\tfor (const file of readdirSync(sub)) {\n\t\t\tif (!file.endsWith(\".jsonl\")) continue;\n\t\t\tconst full = join(sub, file);\n\t\t\tlet mtimeMs = 0;\n\t\t\ttry {\n\t\t\t\tmtimeMs = statSync(full).mtimeMs;\n\t\t\t} catch {\n\t\t\t\t// 读不到时间的文件按最旧处理——不阻止其余文件进候选。\n\t\t\t}\n\t\t\tsessionFiles.push({ path: full, mtimeMs });\n\t\t}\n\t}\n\tsessionFiles.sort((a, b) => b.mtimeMs - a.mtimeMs);\n\t// requestId 单查不受 limit 候选窗口约束（须全量找），否则只读最近文件\n\t// 候选再逐条解析——文件内 sampledAt 排序在收集后统一截断。\n\tconst candidates =\n\t\tinput.requestId === undefined ? sessionFiles.slice(0, Math.max(limit, 1)) : sessionFiles;\n\n\tfor (const { path: filePath } of candidates) {\n\t\tif (items.length >= limit && input.requestId === undefined) break;\n\t\tlet ledger: SessionManager;\n\t\ttry {\n\t\t\tledger = SessionManager.open(filePath);\n\t\t} catch {\n\t\t\tcontinue; // 坏文件跳过，不炸整个查询。\n\t\t}\n\t\tconst entries = ledger.getEntries();\n\t\t// 同会话的真实 usage 条目（type===\"usage\"），按时间序用于旁列匹配。\n\t\tconst usageEntries = entries.filter((e) => e.type === \"usage\");\n\t\t// requestId → assistant 实际用量（turn_end 由 context-usage 扩展落库；\n\t\t// 普通前台请求没有 usage entry 可兜底，靠这条关联命中）。\n\t\tconst actualByRequest = new Map<string, Usage>();\n\t\tfor (const entry of entries) {\n\t\t\tif (entry.type !== \"custom\") continue;\n\t\t\tconst custom = entry as { customType?: string; data?: unknown };\n\t\t\tif (custom.customType !== \"pao-request-usage\") continue;\n\t\t\tconst data = custom.data as { requestId?: unknown; usage?: Usage } | undefined;\n\t\t\tif (typeof data?.requestId === \"string\" && data.usage !== undefined) {\n\t\t\t\tactualByRequest.set(data.requestId, data.usage);\n\t\t\t}\n\t\t}\n\t\tfor (const entry of entries) {\n\t\t\tif (entry.type !== \"custom\") continue;\n\t\t\tconst custom = entry as { customType?: string; data?: unknown };\n\t\t\tif (custom.customType !== \"pao-context-usage\") continue;\n\t\t\tconst snapshot = custom.data as ContextUsageSnapshot | undefined;\n\t\t\tif (snapshot === undefined || typeof snapshot.requestId !== \"string\") continue;\n\t\t\tif (input.requestId !== undefined && snapshot.requestId !== input.requestId) continue;\n\t\t\tif (input.sessionId !== undefined && snapshot.sessionId !== input.sessionId) continue;\n\t\t\t// 旁列真实 usage：优先 requestId 直接关联（pao-request-usage，\n\t\t\t// turn_end 落库的 assistant 实际用量）；查不到回退 note 子串匹配\n\t\t\t// （后台任务把 requestId 写进 usage note 的既有路径）。\n\t\t\tconst actualUsage =\n\t\t\t\tactualByRequest.get(snapshot.requestId) ??\n\t\t\t\t(usageEntries.find((u) => {\n\t\t\t\t\tconst note = (u as { note?: string }).note ?? \"\";\n\t\t\t\t\treturn note.includes(snapshot.requestId);\n\t\t\t\t}) as { usage?: Usage } | undefined)?.usage;\n\t\t\titems.push({\n\t\t\t\trequestId: snapshot.requestId,\n\t\t\t\tsessionId: snapshot.sessionId,\n\t\t\t\t...(snapshot.taskId === undefined ? {} : { taskId: snapshot.taskId }),\n\t\t\t\tsampledAt: snapshot.sampledAt,\n\t\t\t\testimateMethod: snapshot.estimateMethod,\n\t\t\t\tbyCategory: snapshot.byCategory as Record<string, number>,\n\t\t\t\testimatedTotal: snapshot.estimatedTotal,\n\t\t\t\tmessageCount: snapshot.messageCount,\n\t\t\t\tunestimated: (snapshot.unestimated ?? []).map((u) => ({\n\t\t\t\t\tkind: u.kind,\n\t\t\t\t\tnote: u.note,\n\t\t\t\t\tmessageIndexes: u.messageIndexes,\n\t\t\t\t})),\n\t\t\t\tnotes: snapshot.notes ?? [],\n\t\t\t\t...(actualUsage === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: {\n\t\t\t\t\t\t\tactual: {\n\t\t\t\t\t\t\t\tinputTokens: actualUsage.input ?? 0,\n\t\t\t\t\t\t\t\toutputTokens: actualUsage.output ?? 0,\n\t\t\t\t\t\t\t\tcacheReadTokens: actualUsage.cacheRead ?? 0,\n\t\t\t\t\t\t\t\tcacheWriteTokens: actualUsage.cacheWrite ?? 0,\n\t\t\t\t\t\t\t\ttotalTokens: actualUsage.totalTokens ?? 0,\n\t\t\t\t\t\t\t\t...(actualUsage.cost?.total === undefined ? {} : { cost: actualUsage.cost.total }),\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t}),\n\t\t\t});\n\t\t}\n\t}\n\n\t// 按采样时间倒序。\n\titems.sort((a, b) => (a.sampledAt < b.sampledAt ? 1 : a.sampledAt > b.sampledAt ? -1 : 0));\n\treturn {\n\t\tok: true,\n\t\titems: items.slice(0, limit),\n\t\t...(input.requestId !== undefined && items.length === 0 ? { notFound: true } : {}),\n\t};\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 5. usageSummary 聚合（detail 用；服务不暴露 db，本层经既有内部接口读库）\n// ════════════════════════════════════════════════════════════════════════\n\n/**\n * 按 memory_usage 表聚合某记忆的 search/inject/expand/used 计数。\n * 库内读只在本层做——桌面详情页要「这条被参考过几次」，\n * service 现有接口没有 usage 聚合，故在桌面桥层读（不经 SQL 字符串拼接，参数化）。\n */\nfunction countMemoryUsage(\n\thome: string,\n\tmemoryId: string,\n): { search: number; inject: number; expand: number; used: number } {\n\tconst counts = { search: 0, inject: 0, expand: 0, used: 0 };\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT action, COUNT(*) AS n FROM memory_usage\n\t\t\t\t WHERE memory_id = ? GROUP BY action`,\n\t\t\t)\n\t\t\t.all(memoryId) as unknown as Array<{ action: string; n: number }>;\n\t\tfor (const row of rows) {\n\t\t\tif (row.action === \"search\") counts.search = row.n;\n\t\t\telse if (row.action === \"inject\") counts.inject = row.n;\n\t\t\telse if (row.action === \"expand\") counts.expand = row.n;\n\t\t\telse if (row.action === \"used\") counts.used = row.n;\n\t\t}\n\t} finally {\n\t\tstore.close();\n\t}\n\treturn counts;\n}\n\n/**\n * 召回命中 → MemoryListItem：批量取 createdAt/updatedAt/mergedInto。\n * 一次 SQL 查全部命中（不逐条 getMemory）。\n */\nasync function hydrateListItems(home: string, hits: SearchMemoryResult[\"hits\"]): Promise<MemoryListItem[]> {\n\tif (hits.length === 0) return [];\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst meta = new Map<string, { created_at: string; updated_at: string; merged_into: string | null }>();\n\t\tconst stmt = store.db.prepare(\"SELECT created_at, updated_at, merged_into FROM memories WHERE id = ?\");\n\t\tfor (const hit of hits) {\n\t\t\tconst row = stmt.get(hit.memoryId) as\n\t\t\t\t| { created_at: string; updated_at: string; merged_into: string | null }\n\t\t\t\t| undefined;\n\t\t\tif (row) meta.set(hit.memoryId, row);\n\t\t}\n\t\treturn hits.map((hit) => {\n\t\t\tconst row = meta.get(hit.memoryId);\n\t\t\treturn {\n\t\t\t\tmemoryId: hit.memoryId,\n\t\t\t\trevision: hit.revision,\n\t\t\t\tkind: hit.kind,\n\t\t\t\tscope: hit.scope,\n\t\t\t\tconclusion: hit.content.conclusion,\n\t\t\t\t...(hit.content.conditions === undefined ? {} : { conditions: hit.content.conditions }),\n\t\t\t\t...(hit.content.rationale === undefined ? {} : { rationale: hit.content.rationale }),\n\t\t\t\tevidenceKind: hit.content.evidenceKind,\n\t\t\t\tconfirmation: hit.content.confirmation,\n\t\t\t\tusageState: hit.usageState,\n\t\t\t\trelevance: hit.relevance,\n\t\t\t\tmatchKind: hit.matchKind,\n\t\t\t\t...(hit.referenceOnly === undefined ? {} : { referenceOnly: hit.referenceOnly }),\n\t\t\t\t...(hit.sourceIds === undefined ? {} : { sourceIds: hit.sourceIds }),\n\t\t\t\t...(row?.merged_into ? { mergedInto: row.merged_into } : {}),\n\t\t\t\tcreatedAt: row?.created_at ?? \"\",\n\t\t\t\tupdatedAt: row?.updated_at ?? \"\",\n\t\t\t};\n\t\t});\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 空 query 列举：scope/usage/kind 过滤 + updatedAt 倒序。\n * scope 过滤复用 scope.ts 的 currentScopeFilter/historyScopeFilter（与召回同口径：\n * 同 projectId；任务粒度规则一致）。status 过滤显式传入时叠加（库内 AND）。\n */\nfunction listScopedMemoriesPage(\n\thome: string,\n\tscope: MemoryScope,\n\tmode: \"current\" | \"history\",\n\tfilter: { status?: MemoryUsageState; kind?: MemoryKind; page: number; pageSize: number },\n): { items: MemoryListItem[]; total: number } {\n\tconst store = openMemoryStore(home, \"readonly\");\n\ttry {\n\t\tconst scopeFilter = historyScopeFilter(scope);\n\t\tconst conditions: string[] = [scopeFilter.where];\n\t\tconst params = [...scopeFilter.params];\n\t\tif (mode === \"current\") {\n\t\t\tconditions.push(\"m.merged_into IS NULL\");\n\t\t\tconditions.push(\"m.usage_state = ?\");\n\t\t\tparams.push(filter.status ?? \"active\");\n\t\t} else if (filter.status !== undefined) {\n\t\t\tconditions.push(\"m.usage_state = ?\");\n\t\t\tparams.push(filter.status);\n\t\t}\n\t\tif (filter.kind !== undefined) {\n\t\t\tconditions.push(\"m.kind = ?\");\n\t\t\tparams.push(filter.kind);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT COUNT(*) AS total\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE ${where}`,\n\t\t\t)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT m.id, m.kind, m.scope_json, m.current_revision, m.usage_state,\n\t\t\t\t        m.merged_into, m.created_at, m.updated_at, r.content_json\n\t\t\t\t FROM memories m\n\t\t\t\t JOIN memory_revisions r ON r.memory_id = m.id AND r.revision = m.current_revision\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY m.updated_at DESC, m.id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, filter.pageSize, (filter.page - 1) * filter.pageSize) as unknown as Array<{\n\t\t\tid: string;\n\t\t\tkind: string;\n\t\t\tscope_json: string;\n\t\t\tcurrent_revision: number;\n\t\t\tusage_state: string;\n\t\t\tmerged_into: string | null;\n\t\t\tcreated_at: string;\n\t\t\tupdated_at: string;\n\t\t\tcontent_json: string;\n\t\t}>;\n\t\tconst items = rows.map((row) => {\n\t\t\tconst content = JSON.parse(row.content_json) as import(\"../memory/types.ts\").MemoryRevisionContent;\n\t\t\tconst hitScope = JSON.parse(row.scope_json) as MemoryScope;\n\t\t\treturn {\n\t\t\t\tmemoryId: row.id,\n\t\t\t\trevision: row.current_revision,\n\t\t\t\tkind: row.kind as MemoryKind,\n\t\t\t\tscope: hitScope,\n\t\t\t\tconclusion: content.conclusion,\n\t\t\t\t...(content.conditions === undefined ? {} : { conditions: content.conditions }),\n\t\t\t\t...(content.rationale === undefined ? {} : { rationale: content.rationale }),\n\t\t\t\tevidenceKind: content.evidenceKind,\n\t\t\t\tconfirmation: content.confirmation,\n\t\t\t\tusageState: row.usage_state as MemoryUsageState,\n\t\t\t\trelevance: 1,\n\t\t\t\tmatchKind: \"lexical\" as const,\n\t\t\t\tsourceIds: sourcesForRevision(store.db, row.id, row.current_revision).map((s) => s.sourceId),\n\t\t\t\t...(row.merged_into === null ? {} : { mergedInto: row.merged_into }),\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t\tupdatedAt: row.updated_at,\n\t\t\t};\n\t\t});\n\t\treturn { items, total: totalRow.total };\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 6. S8-12：进化详情三读桥（只读 DTO；不返回句柄，不重复内核类型）\n// ════════════════════════════════════════════════════════════════════════\n\n// ── readDesktopEvolutionProblems ─────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionProblemsInput extends DesktopMemoryHomeInput {\n\tscope: DesktopMemoryScope;\n\t/** 资源类别过滤；缺省全部。 */\n\tkind?: string;\n\t/** 状态过滤；缺省全部。 */\n\tstatus?: \"observed\" | \"classified\" | \"candidate\" | \"no_change\" | \"development_suggestion\";\n\tpage?: number;\n\tpageSize?: number;\n}\n\nexport interface DesktopEvolutionProblemItem {\n\tproblemId: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpectedBehavior: string;\n\tactualBehavior: string;\n\t/** 证据引用（evidence_refs_json 解析结果；界面逐条展示 sourceId）。 */\n\tevidenceRefs: string[];\n\toccurrenceCount: number;\n\tresourceId: string | null;\n\tbaseVersion: string | null;\n\tprojectId: string | null;\n\ttaskId: string | null;\n\tsessionId: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreatedAt: string;\n\tupdatedAt: string;\n}\n\nexport interface ReadDesktopEvolutionProblemsResult {\n\titems: DesktopEvolutionProblemItem[];\n\ttotal: number;\n\thasMore: boolean;\n}\n\n// ── readDesktopEvolutionDetail ───────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionDetailInput extends DesktopMemoryHomeInput {\n\tproblemId: string;\n}\n\nexport interface DesktopEvolutionCandidateItem {\n\tcandidateId: string;\n\tproblemId: string;\n\tresourceId: string;\n\tbaseVersion: string;\n\ttestPlanId: string;\n\tdiffs: EvolutionFileDiff[];\n\trationale: string;\n\tusageRefs: string[];\n\tstatus: string;\n\tfailureReason: string | null;\n\tcreatedAt: string;\n\tupdatedAt: string;\n\t/**\n\t * O12/E13：baseVersion 文件正文（路径 → 内容），供详情页对 edit/delete\n\t * 差异做基线对照；版本目录不可读时为空对象。\n\t */\n\tbaseFiles: Record<string, string>;\n}\n\nexport interface DesktopEvolutionDetailResult {\n\tproblem: DesktopEvolutionProblemItem;\n\t/** 该问题的全部候选（含 diffs、rationale、usageRefs、status、failureReason、baseFiles）。 */\n\tcandidates: DesktopEvolutionCandidateItem[];\n\t/** 来源链接（evolution_source_links → sourceId/memoryId/revision）。 */\n\tsourceLinks: Array<{\n\t\tlinkId: string;\n\t\tsourceId: string;\n\t\tmemoryId: string | null;\n\t\trevision: number | null;\n\t}>;\n}\n\n// ── readDesktopEvolutionValidation ───────────────────────────────────────\n\nexport interface ReadDesktopEvolutionValidationInput extends DesktopMemoryHomeInput {\n\tcandidateId: string;\n}\n\nexport interface DesktopEvolutionValidationResult {\n\tvalidation: {\n\t\tvalidationId: string;\n\t\ttestPlanId: string;\n\t\tcandidateId: string;\n\t\tproblemId: string;\n\t\tresourceId: string;\n\t\tbaseVersion: string;\n\t\tcaseResults: Array<{\n\t\t\tcaseId: string;\n\t\t\tgroup: string;\n\t\t\tbaseline: ValidationRunResult | null;\n\t\t\tcandidate: ValidationRunResult | null;\n\t\t\tverdict: string;\n\t\t\t/** O12/E13：该用例的完成判据（从冻结 plan.json 取；缺失时为空）。 */\n\t\t\tacceptance?: string;\n\t\t\t/**\n\t\t\t * O12/E13：该用例的运行回执文件路径（`<home>/evolution/validations/<tp>/runs/`\n\t\t\t * 下 `<caseId>-<side>-*.json`；两侧各取最新一个）。无回执时为空。\n\t\t\t */\n\t\t\treceipts?: { baseline?: string; candidate?: string };\n\t\t}>;\n\t\tverdict: string;\n\t\ttotalUsageRef: string | null;\n\t\tcreatedAt: string;\n\t} | null;\n}\n\n// ── 行映射 ────────────────────────────────────────────────────────────────\n\ninterface EvolutionProblemDbRow {\n\tproblem_id: string;\n\tkind: string;\n\taction: string | null;\n\tsummary: string;\n\treason: string | null;\n\texpected_behavior: string;\n\tactual_behavior: string;\n\tevidence_refs_json: string;\n\toccurrence_count: number;\n\tresource_id: string | null;\n\tbase_version: string | null;\n\tproject_id: string | null;\n\ttask_id: string | null;\n\tsession_id: string | null;\n\tstatus: string;\n\tdisposition: string;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface EvolutionCandidateDbRow {\n\tcandidate_id: string;\n\tproblem_id: string;\n\tresource_id: string;\n\tbase_version: string;\n\ttest_plan_id: string;\n\tdiffs_json: string;\n\trationale: string;\n\tusage_refs_json: string;\n\tstatus: string;\n\tfailure_reason: string | null;\n\tcreated_at: string;\n\tupdated_at: string;\n}\n\ninterface EvolutionValidationDbRow {\n\tvalidation_id: string;\n\ttest_plan_id: string;\n\tcandidate_id: string;\n\tproblem_id: string;\n\tresource_id: string;\n\tbase_version: string;\n\tcase_results_json: string;\n\tverdict: string;\n\ttotal_usage_ref: string | null;\n\tcreated_at: string;\n}\n\ninterface EvolutionSourceLinkDbRow {\n\tlink_id: string;\n\tsource_id: string;\n\tmemory_id: string | null;\n\trevision: number | null;\n}\n\nfunction mapEvolutionProblemRow(row: EvolutionProblemDbRow): DesktopEvolutionProblemItem {\n\treturn {\n\t\tproblemId: row.problem_id,\n\t\tkind: row.kind,\n\t\taction: row.action,\n\t\tsummary: row.summary,\n\t\treason: row.reason,\n\t\texpectedBehavior: row.expected_behavior,\n\t\tactualBehavior: row.actual_behavior,\n\t\tevidenceRefs: JSON.parse(row.evidence_refs_json) as string[],\n\t\toccurrenceCount: row.occurrence_count,\n\t\tresourceId: row.resource_id,\n\t\tbaseVersion: row.base_version,\n\t\tprojectId: row.project_id,\n\t\ttaskId: row.task_id,\n\t\tsessionId: row.session_id,\n\t\tstatus: row.status,\n\t\tdisposition: row.disposition,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t};\n}\n\nfunction mapEvolutionCandidateRow(\n\tstore: ReturnType<typeof openMemoryStore>,\n\trow: EvolutionCandidateDbRow,\n\tpaoHome: string,\n): DesktopEvolutionCandidateItem {\n\t// O12/E13：读 baseVersion 文件正文供详情页 diff/delete 对照；版本目录\n\t// 缺失或不可读时为空对象（详情页退回只显示 diff/newContent）。\n\tconst baseVersionContent = readResourceVersion(store, {\n\t\tresourceId: row.resource_id,\n\t\tversionId: row.base_version,\n\t\tpaoHome,\n\t});\n\tconst baseFiles: Record<string, string> = {};\n\tif (baseVersionContent.ok) {\n\t\tfor (const file of baseVersionContent.files) baseFiles[file.path] = file.content;\n\t}\n\treturn {\n\t\tcandidateId: row.candidate_id,\n\t\tproblemId: row.problem_id,\n\t\tresourceId: row.resource_id,\n\t\tbaseVersion: row.base_version,\n\t\ttestPlanId: row.test_plan_id,\n\t\tdiffs: JSON.parse(row.diffs_json) as EvolutionFileDiff[],\n\t\trationale: row.rationale,\n\t\tusageRefs: JSON.parse(row.usage_refs_json) as string[],\n\t\tstatus: row.status,\n\t\tfailureReason: row.failure_reason,\n\t\tcreatedAt: row.created_at,\n\t\tupdatedAt: row.updated_at,\n\t\tbaseFiles,\n\t};\n}\n\n/** 库未建 = 还没有进化登记：返回空态，不拿裸 SQLite 错当业务结果。 */\nfunction evolutionDatabaseReady(home: string): boolean {\n\treturn databaseExists(home);\n}\n\n/**\n * 问题列表：scope.projectId + 可选 kind/status 过滤 + createdAt 倒序分页。\n * 只读；evidenceRefs 不在列表项展开（详情走 readDesktopEvolutionDetail）。\n */\nexport async function readDesktopEvolutionProblems(\n\tinput: ReadDesktopEvolutionProblemsInput,\n): Promise<MemoryResult<ReadDesktopEvolutionProblemsResult>> {\n\tif (!input.scope || typeof input.scope.projectId !== \"string\" || input.scope.projectId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"scope.projectId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tconst page = Math.max(1, input.page ?? 1);\n\tconst pageSize = Math.min(200, Math.max(1, input.pageSize ?? 50));\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn { ok: true, items: [], total: 0, hasMore: false };\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst conditions = [\"p.project_id = ?\"];\n\t\tconst params: Array<string | number> = [input.scope.projectId];\n\t\tif (input.kind !== undefined) {\n\t\t\tconditions.push(\"p.kind = ?\");\n\t\t\tparams.push(input.kind);\n\t\t}\n\t\tif (input.status !== undefined) {\n\t\t\tconditions.push(\"p.status = ?\");\n\t\t\tparams.push(input.status);\n\t\t}\n\t\tconst where = conditions.join(\" AND \");\n\t\tconst totalRow = store.db\n\t\t\t.prepare(`SELECT COUNT(*) AS total FROM evolution_problems p WHERE ${where}`)\n\t\t\t.get(...params) as { total: number };\n\t\tconst rows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT p.problem_id, p.kind, p.action, p.summary, p.reason,\n\t\t\t\t        p.expected_behavior, p.actual_behavior, p.evidence_refs_json,\n\t\t\t\t        p.occurrence_count, p.resource_id, p.base_version,\n\t\t\t\t        p.project_id, p.task_id, p.session_id,\n\t\t\t\t        p.status, p.disposition, p.created_at, p.updated_at\n\t\t\t\t FROM evolution_problems p\n\t\t\t\t WHERE ${where}\n\t\t\t\t ORDER BY p.created_at DESC, p.problem_id DESC\n\t\t\t\t LIMIT ? OFFSET ?`,\n\t\t\t)\n\t\t\t.all(...params, pageSize, (page - 1) * pageSize) as unknown as EvolutionProblemDbRow[];\n\t\treturn {\n\t\t\tok: true,\n\t\t\titems: rows.map(mapEvolutionProblemRow),\n\t\t\ttotal: totalRow.total,\n\t\t\thasMore: page * pageSize < totalRow.total,\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 问题详情：problem 行 + 全部候选 + 来源链接。\n * problem 不存在返回 invalid_input；其余空集合如实为空。\n */\nexport async function readDesktopEvolutionDetail(\n\tinput: ReadDesktopEvolutionDetailInput,\n): Promise<MemoryResult<DesktopEvolutionDetailResult>> {\n\tif (typeof input.problemId !== \"string\" || input.problemId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"problemId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst problemRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT problem_id, kind, action, summary, reason,\n\t\t\t\t        expected_behavior, actual_behavior, evidence_refs_json,\n\t\t\t\t        occurrence_count, resource_id, base_version,\n\t\t\t\t        project_id, task_id, session_id,\n\t\t\t\t        status, disposition, created_at, updated_at\n\t\t\t\t FROM evolution_problems WHERE problem_id = ?`,\n\t\t\t)\n\t\t\t.get(input.problemId) as EvolutionProblemDbRow | undefined;\n\t\tif (!problemRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化问题不存在:${input.problemId}`,\n\t\t\t\t\trefId: input.problemId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst candidateRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT candidate_id, problem_id, resource_id, base_version, test_plan_id,\n\t\t\t\t        diffs_json, rationale, usage_refs_json, status, failure_reason,\n\t\t\t\t        created_at, updated_at\n\t\t\t\t FROM evolution_candidates WHERE problem_id = ?\n\t\t\t\t ORDER BY created_at, candidate_id`,\n\t\t\t)\n\t\t\t.all(input.problemId) as unknown as EvolutionCandidateDbRow[];\n\t\tconst linkRows = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT link_id, source_id, memory_id, revision\n\t\t\t\t FROM evolution_source_links\n\t\t\t\t WHERE owner_kind = 'problem' AND owner_id = ?\n\t\t\t\t ORDER BY created_at, link_id`,\n\t\t\t)\n\t\t\t.all(input.problemId) as unknown as EvolutionSourceLinkDbRow[];\n\t\treturn {\n\t\t\tok: true,\n\t\t\tproblem: mapEvolutionProblemRow(problemRow),\n\t\t\tcandidates: candidateRows.map((row) => mapEvolutionCandidateRow(store, row, input.home)),\n\t\t\tsourceLinks: linkRows.map((row) => ({\n\t\t\t\tlinkId: row.link_id,\n\t\t\t\tsourceId: row.source_id,\n\t\t\t\tmemoryId: row.memory_id,\n\t\t\t\trevision: row.revision,\n\t\t\t})),\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 候选验证：按 candidateId 读最新一条 validation（同候选多次验证取最新）。\n * 候选存在但尚无验证时 validation=null；候选不存在返回 invalid_input。\n */\nexport async function readDesktopEvolutionValidation(\n\tinput: ReadDesktopEvolutionValidationInput,\n): Promise<MemoryResult<DesktopEvolutionValidationResult>> {\n\tif (typeof input.candidateId !== \"string\" || input.candidateId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"candidateId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!evolutionDatabaseReady(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst candidateRow = store.db\n\t\t\t.prepare(`SELECT candidate_id FROM evolution_candidates WHERE candidate_id = ?`)\n\t\t\t.get(input.candidateId) as { candidate_id: string } | undefined;\n\t\tif (!candidateRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化候选不存在:${input.candidateId}`,\n\t\t\t\t\trefId: input.candidateId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst row = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT validation_id, test_plan_id, candidate_id, problem_id, resource_id,\n\t\t\t\t        base_version, case_results_json, verdict, total_usage_ref, created_at\n\t\t\t\t FROM evolution_validations WHERE candidate_id = ?\n\t\t\t\t ORDER BY created_at DESC, validation_id DESC\n\t\t\t\t LIMIT 1`,\n\t\t\t)\n\t\t\t.get(input.candidateId) as EvolutionValidationDbRow | undefined;\n\t\tif (!row) {\n\t\t\treturn { ok: true, validation: null };\n\t\t}\n\t\t// O12/E13：补每项 case 的 acceptance（冻结 plan.json）与运行回执路径\n\t\t// （runs/<caseId>-<side>-*.json 取最新）。plan.json/runs 缺失时如实为空，\n\t\t// 不挡主结果。\n\t\tconst acceptanceByCase = new Map<string, string>();\n\t\ttry {\n\t\t\tconst planPath = join(evolutionPaths(input.home).validations, row.test_plan_id, \"plan.json\");\n\t\t\tif (existsSync(planPath)) {\n\t\t\t\tconst plan = JSON.parse(readFileSync(planPath, \"utf8\")) as {\n\t\t\t\t\treproduction?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t\tnormal?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t\tholdout?: Array<{ caseId: string; acceptance?: string }>;\n\t\t\t\t};\n\t\t\t\tfor (const group of [plan.reproduction, plan.normal, plan.holdout]) {\n\t\t\t\t\tfor (const item of group ?? []) {\n\t\t\t\t\t\tif (typeof item.caseId === \"string\" && typeof item.acceptance === \"string\") {\n\t\t\t\t\t\t\tacceptanceByCase.set(item.caseId, item.acceptance);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// plan.json 缺失/损坏：acceptance 留空。\n\t\t}\n\t\tconst receiptsByCase = new Map<string, { baseline?: string; candidate?: string }>();\n\t\ttry {\n\t\t\tconst runsDir = join(evolutionPaths(input.home).validations, row.test_plan_id, \"runs\");\n\t\t\tif (existsSync(runsDir)) {\n\t\t\t\tfor (const entry of readdirSync(runsDir)) {\n\t\t\t\t\t// 命名约定：<caseId>-<baseline|candidate>-<uuid8>.json\n\t\t\t\t\tconst m = /^(.+)-(baseline|candidate)-[0-9a-f]{8}\\.json$/.exec(entry);\n\t\t\t\t\tif (!m) continue;\n\t\t\t\t\tconst bucket = receiptsByCase.get(m[1]!) ?? {};\n\t\t\t\t\tconst side = m[2] as \"baseline\" | \"candidate\";\n\t\t\t\t\tbucket[side] = join(runsDir, entry);\n\t\t\t\t\treceiptsByCase.set(m[1]!, bucket);\n\t\t\t\t}\n\t\t\t}\n\t\t} catch {\n\t\t\t// runs 目录缺失/不可读：receipts 留空。\n\t\t}\n\t\tconst caseResults = (\n\t\t\tJSON.parse(row.case_results_json) as Array<{\n\t\t\t\tcaseId: string;\n\t\t\t\tgroup: string;\n\t\t\t\tbaseline: ValidationRunResult | null;\n\t\t\t\tcandidate: ValidationRunResult | null;\n\t\t\t\tverdict: string;\n\t\t\t}>\n\t\t).map((caseResult) => {\n\t\t\tconst receipts = receiptsByCase.get(caseResult.caseId);\n\t\t\treturn {\n\t\t\t\t...caseResult,\n\t\t\t\t...(acceptanceByCase.has(caseResult.caseId)\n\t\t\t\t\t? { acceptance: acceptanceByCase.get(caseResult.caseId) }\n\t\t\t\t\t: {}),\n\t\t\t\t...(receipts !== undefined ? { receipts } : {}),\n\t\t\t};\n\t\t});\n\t\treturn {\n\t\t\tok: true,\n\t\t\tvalidation: {\n\t\t\t\tvalidationId: row.validation_id,\n\t\t\t\ttestPlanId: row.test_plan_id,\n\t\t\t\tcandidateId: row.candidate_id,\n\t\t\t\tproblemId: row.problem_id,\n\t\t\t\tresourceId: row.resource_id,\n\t\t\t\tbaseVersion: row.base_version,\n\t\t\t\tcaseResults,\n\t\t\t\tverdict: row.verdict,\n\t\t\t\ttotalUsageRef: row.total_usage_ref,\n\t\t\t\tcreatedAt: row.created_at,\n\t\t\t},\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════\n// 7. S9-12：单资源「生效与观察」读取 + 受控写通道\n// ════════════════════════════════════════════════════════════════════════\n//\n// 边界：\n// - readDesktopEvolutionResource 只读装配：effectiveVersion/开关/activation\n//   历史/active 绑定/按版本观察计数，全部走既有内核入口，本层不新造语义。\n// - mutateDesktopEvolution 只暴露 setAutoEvolution 与 restoreVersion 两个动作；\n//   恢复版本内部仍走 restoreResourceVersion 的完整发布判据（页面不能绕过判据\n//   直接改指向；冲突返回当前版本不自动覆盖）。\n// - 资源本身无项目维度：evolution_resources 无 project_id 列，资源与激活历史\n//   是 PAO_HOME 级。归属核对由桌面桥在调用前按 problem/绑定行完成；本层只做\n//   资源存在性校验（内核 getResource 同口径）。\n\n// ── readDesktopEvolutionResource ─────────────────────────────────────────\n\nexport interface ReadDesktopEvolutionResourceInput extends DesktopMemoryHomeInput {\n\tresourceId: string;\n}\n\n/** 一个待恢复目标版本的预判（publish 凭据 + 停用标记）。 */\nexport interface DesktopEvolutionVersionOption {\n\tversionId: string;\n\t/** 有未停用 publish 凭据且版本目录在（restore 判据 b 的页面预判口径）。 */\n\trestorable: boolean;\n\t/** 不可恢复原因（凭据缺失/已被停用/目录缺失），供界面置灰提示。 */\n\tblockReason?: string;\n\t/** 该版本当前是否即生效版。 */\n\tcurrent: boolean;\n}\n\nexport interface ReadDesktopEvolutionResourceResult {\n\t/** 资源登记行（kind/relativeRoot/effectiveVersion/autoEvolutionEnabled 等）。 */\n\tresource: EvolutionResource;\n\t/** 当前生效版本 + 目录可用性（目录缺失/指纹不符时 available=false）。 */\n\teffective: {\n\t\tversionId?: string;\n\t\tavailable: boolean;\n\t\tversionDir?: string;\n\t};\n\t/** publish/restore/rollback 全量时间线（含 effective/disabled 标记）。 */\n\tactivationHistory: ActivationHistoryEntry[];\n\t/** 当前 active 任务绑定（versionId 是任务实际固定版本，不是 effectiveVersion）。 */\n\ttaskBindings: TaskBinding[];\n\t/** 最近回退记录（kind='rollback' 最新一条；界面「回退通知」区）。 */\n\tlastRollback?: ActivationHistoryEntry;\n\t/** 观察计数：对当前生效版和最近一个不同版本各一份。 */\n\tusageByVersion: Array<{ versionId: string } & UsageByVersionCounts>;\n\t/** 版本清单（activationHistory 中出现的版本去重，含可恢复预判）。 */\n\tversions: DesktopEvolutionVersionOption[];\n}\n\n// ── mutateDesktopEvolution ───────────────────────────────────────────────\n\n/** 停用/恢复单资源自动进化。 */\nexport interface DesktopEvolutionSetAutoEvolutionAction {\n\taction: \"setAutoEvolution\";\n\tresourceId: string;\n\tenabled: boolean;\n\treason?: string;\n}\n\n/** 恢复历史版本为当前生效版（CAS + 重过发布判据）。 */\nexport interface DesktopEvolutionRestoreVersionAction {\n\taction: \"restoreVersion\";\n\tresourceId: string;\n\ttargetVersionId: string;\n\t/** 调用方持有的当前生效版本；不一致即 conflict，不自动覆盖。 */\n\texpectedEffectiveVersion: string;\n\treason?: string;\n}\n\nexport type DesktopEvolutionAction =\n\t| DesktopEvolutionSetAutoEvolutionAction\n\t| DesktopEvolutionRestoreVersionAction;\n\nexport interface MutateDesktopEvolutionInput extends DesktopMemoryHomeInput {\n\taction: DesktopEvolutionAction;\n}\n\nexport interface DesktopEvolutionSetAutoEvolutionResult {\n\taction: \"setAutoEvolution\";\n\t/** 写后最新资源行（autoEvolutionEnabled 已更新）。 */\n\tresource: EvolutionResource;\n}\n\nexport interface DesktopEvolutionRestoreVersionResult {\n\taction: \"restoreVersion\";\n\t/** 已切指向（restored=true；业务拒绝为 false）。 */\n\trestored: boolean;\n\t/** 业务拒绝形态；restored=false 时给出。 */\n\tstatus?: \"needs_reevaluation\" | \"conflict\";\n\t/** 拒绝原因（判据逐条说明）。 */\n\treason?: string;\n\t/** 当前实际生效版本（供页面重取；restored 后为 targetVersionId）。 */\n\tcurrentEffectiveVersion?: string;\n\t/** 受影响 active 任务绑定（切版后仍绑旧版的任务；宿主决定安全点换版）。 */\n\taffectedTasks: TaskBinding[];\n}\n\nexport type MutateDesktopEvolutionResult =\n\t| ({ action: \"setAutoEvolution\" } & MemoryResult<DesktopEvolutionSetAutoEvolutionResult>)\n\t| ({ action: \"restoreVersion\" } & MemoryResult<DesktopEvolutionRestoreVersionResult>);\n\n// ── 行读取辅助 ────────────────────────────────────────────────────────────\n\n/**\n * 可恢复版本清单：activationHistory 中出现过的全部版本去重，逐版标注\n * 「有未停用 publish 凭据且目录在」与否。指纹级完整性核对归\n * restoreResourceVersion 服务内判据，页面预判只查凭据与目录存在性。\n */\nfunction listVersionOptions(\n\tstore: ReturnType<typeof openMemoryStore>,\n\thome: string,\n\tresourceId: string,\n\teffectiveVersion: string | undefined,\n\thistory: ActivationHistoryEntry[],\n): DesktopEvolutionVersionOption[] {\n\tconst dirSafe = resourceId.replace(/:/g, \"_\");\n\t// 每个版本取最新一条 publish 凭据判停用：kind='publish' 的落盘凭据与\n\t// activation='effective' 的生效行都算「发布过」；只看最新一条的 reason\n\t// 前缀（旧行停用标记若被后来有效凭据覆盖，以最新为准）。\n\tconst credRows = store.db\n\t\t.prepare(\n\t\t\t`SELECT to_version, reason\n\t\t\t FROM evolution_activations\n\t\t\t WHERE resource_id = ? AND kind = 'publish'\n\t\t\t ORDER BY created_at DESC, activation_id DESC`,\n\t\t)\n\t\t.all(resourceId) as unknown as Array<{ to_version: string; reason: string | null }>;\n\tconst latestPublishReason = new Map<string, string | null>();\n\tfor (const row of credRows) {\n\t\tif (!latestPublishReason.has(row.to_version)) {\n\t\t\tlatestPublishReason.set(row.to_version, row.reason);\n\t\t}\n\t}\n\tconst seen = new Set<string>();\n\tconst options: DesktopEvolutionVersionOption[] = [];\n\tfor (const entry of history) {\n\t\tconst ids = [entry.toVersion];\n\t\tif (entry.fromVersion !== undefined) ids.push(entry.fromVersion);\n\t\tfor (const versionId of ids) {\n\t\t\tif (seen.has(versionId)) continue;\n\t\t\tseen.add(versionId);\n\t\t\tconst versionDir = join(evolutionPaths(home).versions, dirSafe, versionId);\n\t\t\tconst dirExists = existsSync(versionDir);\n\t\t\tconst hasCred = latestPublishReason.has(versionId);\n\t\t\tconst credDisabled =\n\t\t\t\thasCred && (latestPublishReason.get(versionId) ?? \"\").startsWith(\"停用:\");\n\t\t\tlet restorable = true;\n\t\t\tlet blockReason: string | undefined;\n\t\t\tif (!hasCred) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"该版本没有发布凭据（未曾完整发布过）\";\n\t\t\t} else if (credDisabled) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"该版本的发布凭据已被停用（曾失败或被回退），不能直接恢复\";\n\t\t\t} else if (!dirExists) {\n\t\t\t\trestorable = false;\n\t\t\t\tblockReason = \"版本目录缺失，不能直接恢复\";\n\t\t\t}\n\t\t\toptions.push({\n\t\t\t\tversionId,\n\t\t\t\trestorable,\n\t\t\t\t...(blockReason === undefined ? {} : { blockReason }),\n\t\t\t\tcurrent: versionId === effectiveVersion,\n\t\t\t});\n\t\t}\n\t}\n\treturn options;\n}\n\n/**\n * 单资源「生效与观察」读取（只读）。\n * 资源无项目维度：归属核对由调用方（桌面桥）完成；本层只做存在性校验。\n * 库未建返回 unavailable（无资源可读），与 readDesktopEvolutionDetail 同口径。\n */\nexport async function readDesktopEvolutionResource(\n\tinput: ReadDesktopEvolutionResourceInput,\n): Promise<MemoryResult<ReadDesktopEvolutionResourceResult>> {\n\tif (typeof input.resourceId !== \"string\" || input.resourceId.length === 0) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" } satisfies MemoryError,\n\t\t};\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t};\n\t}\n\tconst store = openMemoryStore(input.home, \"readonly\");\n\ttry {\n\t\tconst resourceRow = store.db\n\t\t\t.prepare(\n\t\t\t\t`SELECT resource_id, kind, relative_root, allowed_ops_json, capability_scope_json,\n\t\t\t\t        load_method, effective_version, auto_evolution_enabled, registered_at, updated_at\n\t\t\t\t FROM evolution_resources WHERE resource_id = ?`,\n\t\t\t)\n\t\t\t.get(input.resourceId) as\n\t\t\t| {\n\t\t\t\t\tresource_id: string;\n\t\t\t\t\tkind: string;\n\t\t\t\t\trelative_root: string;\n\t\t\t\t\tallowed_ops_json: string;\n\t\t\t\t\tcapability_scope_json: string;\n\t\t\t\t\tload_method: string;\n\t\t\t\t\teffective_version: string | null;\n\t\t\t\t\tauto_evolution_enabled: number;\n\t\t\t\t\tregistered_at: string;\n\t\t\t\t\tupdated_at: string;\n\t\t\t  }\n\t\t\t| undefined;\n\t\tif (!resourceRow) {\n\t\t\treturn {\n\t\t\t\tok: false,\n\t\t\t\terror: {\n\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\tmessage: `进化资源未登记:${input.resourceId}`,\n\t\t\t\t\trefId: input.resourceId,\n\t\t\t\t} satisfies MemoryError,\n\t\t\t};\n\t\t}\n\t\tconst resource: EvolutionResource = {\n\t\t\tresourceId: resourceRow.resource_id,\n\t\t\tkind: resourceRow.kind as EvolutionResource[\"kind\"],\n\t\t\trelativeRoot: resourceRow.relative_root,\n\t\t\tallowedOps: JSON.parse(resourceRow.allowed_ops_json) as EvolutionResource[\"allowedOps\"],\n\t\t\tcapabilityScope: JSON.parse(resourceRow.capability_scope_json) as string[],\n\t\t\tloadMethod: resourceRow.load_method as EvolutionResource[\"loadMethod\"],\n\t\t\t...(resourceRow.effective_version === null\n\t\t\t\t? {}\n\t\t\t\t: { effectiveVersion: resourceRow.effective_version }),\n\t\t\tautoEvolutionEnabled: resourceRow.auto_evolution_enabled === 1,\n\t\t\tregisteredAt: resourceRow.registered_at,\n\t\t\tupdatedAt: resourceRow.updated_at,\n\t\t};\n\n\t\tconst effectiveResult = getEffectiveVersion(store, input.resourceId, input.home);\n\t\tif (!effectiveResult.ok) {\n\t\t\treturn effectiveResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\t\tconst historyResult = listActivationHistory(store, input.resourceId);\n\t\tif (!historyResult.ok) {\n\t\t\treturn historyResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\t\tconst bindingsResult = listTaskBindings(store, {\n\t\t\tresourceId: input.resourceId,\n\t\t\tactiveOnly: true,\n\t\t});\n\t\tif (!bindingsResult.ok) {\n\t\t\treturn bindingsResult as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t}\n\n\t\tconst history = historyResult.items;\n\t\tconst lastRollback = [...history].reverse().find((entry) => entry.kind === \"rollback\");\n\n\t\t// 观察计数：当前生效版 + 最近一个不同版本（时间线上最新非当前版）。\n\t\tconst usageByVersion: Array<{ versionId: string } & UsageByVersionCounts> = [];\n\t\tconst observedVersions: string[] = [];\n\t\tif (effectiveResult.versionId !== undefined) observedVersions.push(effectiveResult.versionId);\n\t\tconst latestOther = [...history]\n\t\t\t.reverse()\n\t\t\t.find((entry) => entry.toVersion !== effectiveResult.versionId);\n\t\tif (latestOther !== undefined) observedVersions.push(latestOther.toVersion);\n\t\tfor (const versionId of observedVersions) {\n\t\t\tconst counts = countUsageByVersion(store, { resourceId: input.resourceId, versionId });\n\t\t\tif (!counts.ok) return counts as MemoryResult<ReadDesktopEvolutionResourceResult>;\n\t\t\tusageByVersion.push({ versionId, ...counts });\n\t\t}\n\n\t\treturn {\n\t\t\tok: true,\n\t\t\tresource,\n\t\t\teffective: {\n\t\t\t\t...(effectiveResult.versionId === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: { versionId: effectiveResult.versionId }),\n\t\t\t\tavailable: effectiveResult.available,\n\t\t\t\t...(effectiveResult.versionDir === undefined\n\t\t\t\t\t? {}\n\t\t\t\t\t: { versionDir: effectiveResult.versionDir }),\n\t\t\t},\n\t\t\tactivationHistory: history,\n\t\t\ttaskBindings: bindingsResult.items,\n\t\t\t...(lastRollback === undefined ? {} : { lastRollback }),\n\t\t\tusageByVersion,\n\t\t\tversions: listVersionOptions(\n\t\t\t\tstore,\n\t\t\t\tinput.home,\n\t\t\t\tinput.resourceId,\n\t\t\t\teffectiveResult.versionId,\n\t\t\t\thistory,\n\t\t\t),\n\t\t};\n\t} finally {\n\t\tstore.close();\n\t}\n}\n\n/**\n * 受控写通道：setAutoEvolution / restoreVersion。\n * readwrite 借用；restoreVersion 完整走 restoreResourceVersion 判据\n * （目录指纹、publish 凭据、来源依据、CAS），冲突/待重评估如实返回\n * 当前版本，不自动覆盖。\n */\nexport async function mutateDesktopEvolution(\n\tinput: MutateDesktopEvolutionInput,\n): Promise<MutateDesktopEvolutionResult> {\n\tconst action = input.action;\n\tif (!action || typeof action !== \"object\" || typeof action.action !== \"string\") {\n\t\treturn {\n\t\t\taction: \"setAutoEvolution\",\n\t\t\tok: false,\n\t\t\terror: { code: \"invalid_input\", message: \"action 不能为空\" },\n\t\t} as MutateDesktopEvolutionResult;\n\t}\n\tif (!databaseExists(input.home)) {\n\t\treturn {\n\t\t\taction: action.action,\n\t\t\tok: false,\n\t\t\terror: unavailable(`记忆库尚未建立：${memoryPaths(input.home).database}`),\n\t\t} as MutateDesktopEvolutionResult;\n\t}\n\n\tswitch (action.action) {\n\t\tcase \"setAutoEvolution\": {\n\t\t\tif (typeof action.resourceId !== \"string\" || action.resourceId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"setAutoEvolution\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (typeof action.enabled !== \"boolean\") {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"setAutoEvolution\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"enabled 必须是布尔值\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst store = openMemoryStore(input.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst result = setResourceAutoEvolution(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\tenabled: action.enabled,\n\t\t\t\t\t...(action.reason === undefined ? {} : { reason: action.reason }),\n\t\t\t\t});\n\t\t\t\tif (!result.ok) return { action: \"setAutoEvolution\", ok: false, error: result.error };\n\t\t\t\treturn { action: \"setAutoEvolution\", ok: true, resource: result };\n\t\t\t} finally {\n\t\t\t\tstore.close();\n\t\t\t}\n\t\t}\n\t\tcase \"restoreVersion\": {\n\t\t\tif (typeof action.resourceId !== \"string\" || action.resourceId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: { code: \"invalid_input\", message: \"resourceId 不能为空\" },\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (typeof action.targetVersionId !== \"string\" || action.targetVersionId.length === 0) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: \"targetVersionId 不能为空\",\n\t\t\t\t\t\trefId: action.resourceId,\n\t\t\t\t\t},\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (\n\t\t\t\ttypeof action.expectedEffectiveVersion !== \"string\" ||\n\t\t\t\taction.expectedEffectiveVersion.length === 0\n\t\t\t) {\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\tok: false,\n\t\t\t\t\terror: {\n\t\t\t\t\t\tcode: \"invalid_input\",\n\t\t\t\t\t\tmessage: \"expectedEffectiveVersion 不能为空\",\n\t\t\t\t\t\trefId: action.resourceId,\n\t\t\t\t\t},\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst store = openMemoryStore(input.home, \"readwrite\");\n\t\t\ttry {\n\t\t\t\tconst result = restoreResourceVersion(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\ttargetVersionId: action.targetVersionId,\n\t\t\t\t\texpectedEffectiveVersion: action.expectedEffectiveVersion,\n\t\t\t\t\tpaoHome: input.home,\n\t\t\t\t\t...(action.reason === undefined ? {} : { reason: action.reason }),\n\t\t\t\t});\n\t\t\t\tif (!result.ok) {\n\t\t\t\t\treturn { action: \"restoreVersion\", ok: false, error: result.error };\n\t\t\t\t}\n\t\t\t\t// 受影响任务：切版后仍绑旧版（与当前指向不同）的 active 绑定。\n\t\t\t\tconst currentRow = store.db\n\t\t\t\t\t.prepare(`SELECT effective_version FROM evolution_resources WHERE resource_id = ?`)\n\t\t\t\t\t.get(action.resourceId) as { effective_version: string | null } | undefined;\n\t\t\t\tconst currentEffective = currentRow?.effective_version ?? undefined;\n\t\t\t\tconst bindingsResult = listTaskBindings(store, {\n\t\t\t\t\tresourceId: action.resourceId,\n\t\t\t\t\tactiveOnly: true,\n\t\t\t\t});\n\t\t\t\tif (!bindingsResult.ok) {\n\t\t\t\t\treturn { action: \"restoreVersion\", ok: false, error: bindingsResult.error };\n\t\t\t\t}\n\t\t\t\tconst affectedTasks = bindingsResult.items.filter(\n\t\t\t\t\t(binding) => binding.versionId !== currentEffective,\n\t\t\t\t);\n\t\t\t\tif (\"restored\" in result && result.restored === true) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\taction: \"restoreVersion\",\n\t\t\t\t\t\tok: true,\n\t\t\t\t\t\trestored: true,\n\t\t\t\t\t\tcurrentEffectiveVersion: result.versionId,\n\t\t\t\t\t\taffectedTasks,\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\t// 业务拒绝：restoreResourceVersion 返回 RestoreRejected（status/reason）。\n\t\t\t\tconst rejected = result as { status: \"needs_reevaluation\" | \"conflict\"; reason: string; currentEffectiveVersion?: string };\n\t\t\t\treturn {\n\t\t\t\t\taction: \"restoreVersion\",\n\t\t\