+			);
+			if (full) {
+				lines.push("    正文最后回执摘要(可能来自历史尝试):");
+				for (const line of card.最后回执摘要.split("\n")) lines.push(`    ${line}`);
+			} else {
+				lines.push(`    最近回执摘要:${oneLine(card.最后回执摘要)}`);
+			}
+			lines.push(`    原卡:${card.文件}${full ? "" : "(需要完整目标和回执时按此路径读取)"}`);
+		}
+	}
